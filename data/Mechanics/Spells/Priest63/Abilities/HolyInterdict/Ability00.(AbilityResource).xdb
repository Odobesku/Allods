<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739921015</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>cast</name>
            <value var="factor" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>heal</name>
            <value var="heal" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Priest/PriestCureWoundsUpgrade.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellPrepareDurationModifier">
                    <spell href="/Mechanics/Spells/Priest63/Spells/CureWound/Spell01.(SpellSingleTarget).xdb" />
                    <factor var="factor" />
                </Item>
                <Item type="gameMechanics.elements.effects.SpellPrepareDurationModifier">
                    <spell href="/Mechanics/Spells/Priest63/Spells/CureWoundUpgrade/Spell01.(SpellSingleTarget).xdb" />
                    <factor var="factor" />
                </Item>
                <Item type="gameMechanics.elements.effects.SpellsModifier">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Priest63/Spells/CureWound/Spell01.(SpellSingleTarget).xdb" />
                                <Item href="/Mechanics/Spells/Priest63/Spells/CureWoundUpgrade/Spell01.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </predicates>
                    <modifiers>
                        <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                            <effects>
                                <Item type="gameMechanics.elements.effects.OutgoingHealModifier">
                                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                        <coeff var="heal" />
                                    </scaler>
                                </Item>
                            </effects>
                            <onBehalfOfHolder>true</onBehalfOfHolder>
                        </Item>
                    </modifiers>
                </Item>
                <Item type="gameMechanics.elements.effects.SpellCastTrigger">
                    <conditionalImpacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                                    <spell href="/Mechanics/Spells/Priest63/Spells/CureWound/Spell01.(SpellSingleTarget).xdb" />
                                    <duration>3000</duration>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                                    <spell href="/Mechanics/Spells/Priest63/Spells/CureWoundUpgrade/Spell01.(SpellSingleTarget).xdb" />
                                    <duration>3000</duration>
                                </Item>
                            </impacts>
                            <conditions>
                                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                    <spells>
                                        <Item href="/Mechanics/Spells/Priest63/Spells/CureWound/Spell01.(SpellSingleTarget).xdb" />
                                        <Item href="/Mechanics/Spells/Priest63/Spells/CureWoundUpgrade/Spell01.(SpellSingleTarget).xdb" />
                                    </spells>
                                </Item>
                            </conditions>
                        </Item>
                    </conditionalImpacts>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
