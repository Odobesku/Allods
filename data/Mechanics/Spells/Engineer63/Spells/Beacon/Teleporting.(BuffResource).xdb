<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739932772</resourceId>
	</Header>
	<Name href="Teleporting.(BuffResource).Name.txt" />
	<Description href="Teleporting.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Itemmall/PortalsDesc.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
						<Item type="gameMechanics.elements.predicates.PredicateCanMove" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="/Mechanics/Spells/Engineer63/Spells/Strategies/TeleportVisual.(ClientData).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactTeleport">
							<destination type="gameMechanics.map.destination.SelfPosDestination" />
							<finishImpacts>
								<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
									<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
											<impacts>
												<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
													<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
													<impacts>
														<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
															<impacts>
																<Item type="gameMechanics.elements.impacts.MarkedImpact">
																	<mark href="/Mechanics/Spells/Engineer63/Abilities/SupportBeaconBuff/BeaconTeleportTarget.(MarkResource).xdb" />
																</Item>
															</impacts>
														</Item>
													</impacts>
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
							</finishImpacts>
						</Item>
					</impactsIf>
				</Item>
			</impacts>
		</Item>
	</effects>
	<duration>4000</duration>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
