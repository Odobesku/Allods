	</groups>
	<Name href="RangedAttack.(SpellSingleTarget).Name.txt" />
	<Description href="RangedAttack.(SpellSingleTarget).Description.txt" />
	<image href="/Interface/Icons/Equipment/Ranged/BowVendor.(UISingleTexture).xdb" />
	<autoAppendToActionPanel>false</autoAppendToActionPanel>
	<visualScripts href="/Spells/VisScripts/Stalker/RangedAttack.(SpellVisScripts).xdb" />
	<sysName>RangedAttack</sysName>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<prepareDuration>1500</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<stage>Start</stage>
			<duration>1500</duration>
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							<Item type="gameMechanics.elements.predicates.PredicateEquipped">
								<dressType>RANGED</dressType>
								<weaponRequired>true</weaponRequired>
							</Item>
							<Item type="gameMechanics.elements.predicates.PredicateRemote">
								<range>5</range>
							</Item>
						</predicates>
					</Item>
					<Item type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</Item>
				</predicates>
			</Item>
		</casterConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
						</predicates>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
								<scalerTarget type="gameMechanics.elements.scalers.TrivialScaler" />
								<scaler type="gameMechanics.elements.scalers.WeaponScaler">
									<source>Ranged</source>
								</scaler>
								<avgDamage>8.75</avgDamage>
								<source>Ranged</source>
							</Item>
						</impacts>
						<elseImpacts>
							<Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
								<scalerTarget type="gameMechanics.elements.scalers.TrivialScaler" />
								<scaler type="gameMechanics.elements.scalers.WeaponScaler">
									<source>Ranged</source>
								</scaler>
								<avgDamage>25</avgDamage>
								<source>Ranged</source>
							</Item>
						</elseImpacts>
					</Item>
				</impacts>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
