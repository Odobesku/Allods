<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>223184</resourceId>
    </Header>
    <Name href="RandomPlague.(BuffResource).Name.txt" />
    <Description href="RandomPlague.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/TepPlague.(UISingleTexture).xdb" />
    <visScript href="RandomPlague.(BuffVisScripts).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledImpacts">
                    <scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                        <buff href="RandomPlague.(BuffResource).xdb" />
                        <anyRank>true</anyRank>
                        <onlyFromMaster>false</onlyFromMaster>
                        <mul>1</mul>
                        <sum>1</sum>
                    </scalerTarget>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>5</radius>
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>DISEASE</element>
                                    <damage>5</damage>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.StackBuff">
                    <buff href="RandomPlague.(BuffResource).xdb" />
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>1</value>
                    </delta>
                </Item>
            </impacts>
            <initialDelay>2000</initialDelay>
        </Item>
    </effects>
    <duration>6000</duration>
    <stackLimit>100</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Diseases.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>