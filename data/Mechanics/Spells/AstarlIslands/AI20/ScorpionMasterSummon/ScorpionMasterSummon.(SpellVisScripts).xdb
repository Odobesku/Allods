			<FxOnCaster>/Spells/FX/Spells/CallAny_Loop.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnCaster>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
