<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>196914</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Buff00.(BuffResource).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/Onslaught.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                    <spells>
                        <Item href="/Mechanics/Spells/Stalker63/Spells/MeleeCombo/Spell01.(SpellSingleTarget).xdb" />
                        <Item href="/Mechanics/Spells/Stalker63/Spells/MeleeComboUpg/Spell01.(SpellSingleTarget).xdb" />
                    </spells>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                <coeff>0.01</coeff>
                                <calcer type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                            <buff href="Buff01.(BuffResource).xdb" />
                                            <forAllRanks>true</forAllRanks>
                                        </Item>
                                        <Item type="constructor.elements.CalcerFloatExternal">
                                            <externalCalcer hrefvar="externalCalcer" />
                                        </Item>
                                    </calcers>
                                </calcer>
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
    </effects>
    <duration>10000</duration>
    <stackLimit>1</stackLimit>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>