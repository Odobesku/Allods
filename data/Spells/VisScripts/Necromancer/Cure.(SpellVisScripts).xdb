<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureRunVisActionResource">
				<resource href="/Spells/VisScripts/Prototypes/PreCastFXDiseaseWand.(CreatureVisActionResource).xdb" />
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmniWand</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
				</advanced>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastOmniWand</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideScript />
			</Item>
		</elements>
	</actionBarStart>
	<launch type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/ReadySpellDirectDiseaseWand_Cast.(VisObjectTemplate).xdb" />
				<fixPoint>true</fixPoint>
				<locator>Wand_Slot_FX</locator>
			</Item>
		</visualEffects>
	</launch>
</SpellVisScripts>
