                                <Item type="gameMechanics.elements.scenarios.predicates.PredicateIsOnEventScenarioMap" />
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="MercsForFree.(BuffResource).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                    <hideText>true</hideText>
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateMobNear">
                                                <radius>35</radius>
                                                <mobs>
                                                    <Item href="/Characters/Kania_male/Instances/ZoneLeague1/MercNPC_Leader.(MobWorld).xdb" />
                                                </mobs>
                                            </predicate>
                                        </Item>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateMobNear">
                                                <radius>35</radius>
                                                <mobs>
                                                    <Item href="/Characters/Hadagan_male/Instances/ZoneHadagan1/MercNPC_Leader.(MobWorld).xdb" />
                                                </mobs>
                                            </predicate>
                                        </Item>
                                    </predicates>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                                    <hideText>true</hideText>
                                    <key href="/System/ContentKeys/Mercenaries.(ContentKey).xdb" />
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsGroupLeader" />
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateInGroup" />
                                        </Item>
                                    </predicates>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Mercenaries/SummonLeader/DisintegrateLeader.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="/Mechanics/Spells/Mercenaries/SummonLeader/DisintegrateLeader.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                            <faction href="/World/Factions/League.xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                            <destination type="gameMechanics.map.destination.RelativeTrailPos">
                                                <center type="gameMechanics.map.destination.RelativeRotatePos">
                                                    <base type="gameMechanics.map.destination.RelativePos" />
                                                    <offset>3</offset>
                                                    <turn>ToTarget</turn>
                                                </center>
                                            </destination>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="/Mechanics/Spells/Mercenaries/SummonLeader/DisintegrateLeader.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/Mercenaries/SummonLeader/DisintegrateLeader.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
