<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739924782</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Quest/AC8_S7_item.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/DD/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <targetImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                <buff href="Breach.(BuffResource).xdb" />
                                <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>ASTRAL</element>
                                            <scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                                <buff href="Breach.(BuffResource).xdb" />
                                                <anyRank>true</anyRank>
                                                <onlyFromMaster>true</onlyFromMaster>
                                                <mul>1</mul>
                                            </scalerTarget>
                                            <damage var="damage" />
                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                        </Item>
                                    </impacts>
                                    <groupRepeaters>true</groupRepeaters>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Breach.(BuffResource).xdb" />
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </targetImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                        <spells>
                            <Item href="/Mechanics/Spells/Psionic63/Spells/MentalStrike/Spell01.(SpellSingleTarget).xdb" />
                            <Item href="/Mechanics/Spells/Psionic63/Spells/PsychicAttack/Spell01.(SpellSingleTarget).xdb" />
                        </spells>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.effects.BuffExtraEffects">
                    <buffs>
                        <Item href="/Mechanics/Spells/Psionic63/Spells/Projection/Projection01.(BuffResource).xdb" />
                    </buffs>
                    <effects>
                        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                            <targetImpacts>
                                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                        <value>0.3</value>
                                    </chanceCalcer>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="Breach.(BuffResource).xdb" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </targetImpacts>
                            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                                <spells>
                                    <Item href="/Mechanics/Spells/Psionic63/Spells/Projection/MobAttack01.(SpellSingleTarget).xdb" />
                                    <Item href="/Mechanics/Spells/Psionic63/Spells/Projection/MobAttack02.(SpellSingleTarget).xdb" />
                                    <Item href="/Mechanics/Spells/Psionic63/Spells/Projection/MobAttack03.(SpellSingleTarget).xdb" />
                                </spells>
                            </destination>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.BuffExtraEffects">
                    <buffs>
                        <Item href="/Mechanics/Spells/Psionic63/Spells/PhantasmalKiller/Killer01.(BuffResource).xdb" />
                    </buffs>
                    <effects>
                        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                            <targetImpacts>
                                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                        <value>0.3</value>
                                    </chanceCalcer>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="Breach.(BuffResource).xdb" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </targetImpacts>
                            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                                <spells>
                                    <Item href="/Mechanics/Spells/Psionic63/Spells/PhantasmalKiller/KillerAttack01.(SpellSingleTarget).xdb" />
                                    <Item href="/Mechanics/Spells/Psionic63/Spells/PhantasmalKiller/KillerAttack02.(SpellSingleTarget).xdb" />
                                    <Item href="/Mechanics/Spells/Psionic63/Spells/PhantasmalKiller/KillerAttack03.(SpellSingleTarget).xdb" />
                                </spells>
                            </destination>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
                    <mark href="DotTick.(MarkResource).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value>0.3</value>
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Breach.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
