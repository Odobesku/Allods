								<resetTimer>false</resetTimer>
								<casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
								<delta type="gameMechanics.elements.calcers.FloatData">
									<value>1</value>
								</delta>
							</Item>
						</impactsPerTick>
						<affectedByDoubleAttack>true</affectedByDoubleAttack>
					</parameters>
					<element>POISON</element>
					<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
						<additionalMultiplier>
							<scaler type="gameMechanics.elements.scalers.MagicScaler" />
						</additionalMultiplier>
					</scaler>
				</Item>
			</effects>
		</Item>
