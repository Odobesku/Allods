<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/RangedAttack.(SpellVisScripts).xdb" />
		<Variables>
			<LocatorNameOnArrow>Slot_FX</LocatorNameOnArrow>
		</Variables>
	</Header>
	<precastType>PRECAST_NONE</precastType>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item skiped="" />
			<Item skiped="" />
			<Item skiped="" />
			<Item skiped="" />
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>BonusDmgAll</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureThrowArrowAction">
						<arrow href="" />
						<enchantedArrowIndex>1</enchantedArrowIndex>
						<arrowInTargetTime>0</arrowInTargetTime>
						<theGe>8</theGe>
						<additionalEffectFx href="/Spells/FX/Spells/War63_BuffRage_Hand.(VisObjectTemplate).xdb" />
						<effectBone var="LocatorNameOnArrow" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="Sound3DAction">
					<sound>
						<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
						<name>spells/Stalker/StalkerArrowHit</name>
					</sound>
					<alias href="" />
				</Item>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/WarriorTauntAbility.(VisObjectTemplate).xdb" />
							<locator>Slot_BodyFX</locator>
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
