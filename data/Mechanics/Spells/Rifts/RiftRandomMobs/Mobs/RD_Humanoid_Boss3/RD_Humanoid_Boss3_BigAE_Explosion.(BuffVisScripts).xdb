<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionLoopAction">
                <actionToLoop type="VisActionList">
                    <playWhile type="VisActionDelay">
                        <time>600</time>
                    </playWhile>
                    <elements>
                        <Item type="VisActionDelay">
                            <time>300</time>
                        </Item>
                        <Item type="CreatureEffectsAction">
                            <visualEffects>
                                <Item>
                                    <effectFx href="RD_Humanoid_Boss3_FireShield.(VisObjectTemplate).xdb" />
                                    <lockScale>true</lockScale>
                                    <scale>1</scale>
                                    <ignoreParentRotation>true</ignoreParentRotation>
                                </Item>
                            </visualEffects>
                        </Item>
                    </elements>
                </actionToLoop>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>special</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
            </Item>
        </elements>
    </action>
    <postAction type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/HitFireball2.(VisObjectTemplate).xdb" />
                        <fixPoint>true</fixPoint>
                        <lockScale>true</lockScale>
                        <scale>1.5</scale>
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
        </elements>
    </postAction>
</BuffVisScripts>