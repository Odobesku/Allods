<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739920774</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>cd</name>
            <value var="cd" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent1MinusAbs</formula>
            </scaler>
        </Item>
        <Item>
            <name>dmg</name>
            <value var="dmg" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Warrior/WarriorInnerRage.chn.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/DD/Buff01.(BuffResource).xdb" />
            </buffs>
            <groups />
            <effects>
                <Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
                    <spell href="/Mechanics/Spells/Priest63/Spells/Ecstasy/Spell01.(SpellSingleTarget).xdb" />
                    <factor var="cd" />
                </Item>
                <Item type="gameMechanics.elements.effects.BuffExtraEffects">
                    <buffs>
                        <Item href="/Mechanics/Spells/Priest63/Spells/Ecstasy/Buff00.(BuffResource).xdb" />
                    </buffs>
                    <effects>
                        <Item type="gameMechanics.elements.effects.SpellsModifier">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                    <spells>
                                        <Item href="/Mechanics/Spells/Priest63/Spells/RetributionUpgrade/Spell01.(SpellSingleTarget).xdb" />
                                        <Item href="/Mechanics/Spells/Priest63/Spells/Retribution/Spell01.(SpellSingleTarget).xdb" />
                                    </spells>
                                </Item>
                            </predicates>
                            <modifiers>
                                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                                    <effects>
                                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                                <coeff>0.01</coeff>
                                                <calcer type="gameMechanics.elements.calcers.FloatData">
                                                    <value var="dmg" />
                                                </calcer>
                                            </scaler>
                                        </Item>
                                    </effects>
                                    <onBehalfOfHolder>true</onBehalfOfHolder>
                                </Item>
                            </modifiers>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>