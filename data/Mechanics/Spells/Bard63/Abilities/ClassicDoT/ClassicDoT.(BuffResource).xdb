<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739947823</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="ClassicDoT.(BuffResource).Name.txt" />
	<Description href="ClassicDoT.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Special/Talents/Stalker/CritImpr.(UISingleTexture).xdb" />
	<visScript href="/Spells/BuffVisScripts/DOT_Disease.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.PhysicalDoT">
			<parameters>
				<scaleOnTick>false</scaleOnTick>
				<tickLength>1000</tickLength>
				<damagePerTick>1</damagePerTick>
				<affectedByDoubleAttack>true</affectedByDoubleAttack>
			</parameters>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.WeaponScaler" />
				</scalers>
			</scaler>
		</Item>
	</effects>
	<duration>4000</duration>
	<isStackable>false</isStackable>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<ranks>
		<Item href="ClassicDoT01.(BuffResource).xdb" />
		<Item href="ClassicDoT02.(BuffResource).xdb" />
		<Item href="ClassicDoT03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/Diseases.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>