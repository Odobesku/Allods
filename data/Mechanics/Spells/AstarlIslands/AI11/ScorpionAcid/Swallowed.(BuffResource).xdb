<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739869830</resourceId>
	</Header>
	<Name href="Swallowed.(BuffResource).Name.txt" />
	<Description href="Swallowed.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Food/MeatSmoked.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.MagicDoT">
			<parameters>
				<damagePerTick>20</damagePerTick>
				<affectOnStartTick>true</affectOnStartTick>
			</parameters>
			<element>POISON</element>
		</Item>
		<Item type="gameMechanics.elements.effects.Enlarge">
			<factor>0.5</factor>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectUnworthyOfAttention" />
		<Item type="gameMechanics.elements.effects.EffectDisableAllSpells" />
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<eventClasses>
				<Item>gameMechanics.elements.events.EventDeath</Item>
			</eventClasses>
			<impacts>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Swallowed.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impacts>
			<eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>100</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
									<time>1000</time>
									<destination type="gameMechanics.map.destination.RelativeRotatePos">
										<base type="gameMechanics.map.destination.SelfPosDestination" />
										<offset>10</offset>
										<yaw type="constructor.basicElements.AngleDegrees">
											<value>1</value>
										</yaw>
										<turn>ToTarget</turn>
									</destination>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Satiety.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="SpeedUP.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
