                        <data href="ClientData/Visual_DemonProjectilesDeflected.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="AstralFlurryHit.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
