<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739845603</resourceId>
    </Header>
    <visualScripts href="/Spells/VisScripts/Paladin/LightNova.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>10</value>
    </range>
    <prepareDuration>1000</prepareDuration>
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/Characters/Kania_female/UI06_Companion_Death.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="/World/Quests/UmoirIsland06/UI06_Quest4/UI06_Quest4_Win.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>20</radius>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="/Spells/ClientData/GreaterHealing.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.DirectHeal">
                        <heal>1</heal>
                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                        </scalerTarget>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactsToMaster">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                                <id href="/World/Quests/UmoirIsland06/UI06_Quest4/CountId_3.xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="/World/Quests/UmoirIsland06/UI06_Quest4/UI06_Quest4_Win.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactSetFaction">
                        <faction href="/World/Factions/AllFriends.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>10000</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        </impacts>
                    </Item>
                </impacts>
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/World/Quests/UmoirIsland06/UI06_Quest4/UI06_Quest4_Win.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                </filter>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                <data href="/World/Quests/UmoirIsland06/UI06_Quest4/UI06_Quest4_Win3.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/World/Quests/UmoirIsland06/UI06_Quest4/UI06_Quest4_Immobile.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>