<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="VisActionLoopAction">
				<actionToLoop type="VisActionList">
					<playWhile />
					<elements>
						<Item type="VisActionList">
							<play>Simultaneously</play>
							<playWhile type="VisActionDelay">
								<time>1000</time>
							</playWhile>
							<elements>
								<Item type="ProceduralEffectVisAction">
									<timeOff>1</timeOff>
									<proceduralEffect href="/Spells/FX/InterfaceFX/Disease.(ProceduralEffect).xdb#xpointer(/ProceduralEffect)" />
								</Item>
							</elements>
						</Item>
						<Item type="VisActionDelay">
							<time>2000</time>
						</Item>
					</elements>
				</actionToLoop>
			</Item>
			<Item type="VisActionLoopAction">
				<actionToLoop type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/DotAstral_NoLoop.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<effectAlias href="" />
							<locator>FROM_LOCATOR_NAME</locator>
							<locatorName>Slot_BodyFX</locatorName>
							<offendTime />
						</Item>
					</visualEffects>
				</actionToLoop>
				<totalTime>0</totalTime>
				<repeat>0</repeat>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
