<?xml version="1.0" encoding="UTF-8"?>
<VisObjectTemplate>
	<defaultState>
		<sound>
			<creationRadius>-1</creationRadius>
		</sound>
		<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
		<playSoundOnKeys>true</playSoundOnKeys>
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>0</fadeInMS>
	<fadeOutMS>0</fadeOutMS>
	<geometry href="Umoir_Oak_Big.(Geometry).xdb#xpointer(/Geometry)" />
	<replaceDistance>-1</replaceDistance>
	<scale>1</scale>
	<sound>
		<creationRadius>-1</creationRadius>
	</sound>
	<states>
		<Item>
			<sound>
				<creationRadius>-1</creationRadius>
			</sound>
			<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
			<playSoundOnKeys>true</playSoundOnKeys>
			<animation href="Umoir_Oak_Big.(SkeletalAnimation).xdb#xpointer(/SkeletalAnimation)" />
			<isNecessaryAnim>false</isNecessaryAnim>
		</Item>
	</states>
	<visObjComponents>
		<Item type="client.Scene.VisualSettingsComponent">
			<fogFactor>-1</fogFactor>
			<lods>
				<Item>
					<autoLevel>0</autoLevel>
					<maxDistance>500</maxDistance>
					<minDistance>500</minDistance>
					<visObject href="Umoir_Oak_Big_lowpoly.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				</Item>
			</lods>
			<maxSettings>
				<fadeDistanceEnd>700</fadeDistanceEnd>
				<fadeDistanceStart>600</fadeDistanceStart>
			</maxSettings>
			<minSettings>
				<fadeDistanceEnd>700</fadeDistanceEnd>
				<fadeDistanceStart>600</fadeDistanceStart>
			</minSettings>
			<lodsUniformScaling>false</lodsUniformScaling>
			<sizeIndependentFade>false</sizeIndependentFade>
		</Item>
	</visObjComponents>
	<drawBehindCamera>false</drawBehindCamera>
	<softReplace>false</softReplace>
</VisObjectTemplate>