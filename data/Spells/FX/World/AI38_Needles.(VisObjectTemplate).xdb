<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>0</fadeOutMS>
    <particle href="/Spells/FX/World/AI38_Needles.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)" />
    <scale>1</scale>
    <sound />
    <visObjComponents>
        <Item type="DelayComponent">
            <timeMax>60</timeMax>
            <timeMin>15</timeMin>
            <skipLoading>true</skipLoading>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>