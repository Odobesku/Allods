<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739895933</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="ChainFrost.(AbilityResource).Name.txt" />
    <description href="ChainFrost.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>jump</name>
            <value var="jump" />
        </Item>
        <Item>
            <name>damage</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
        <Item>
            <name>perc</name>
            <value var="perc" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Event/TrinketIceSculpture.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="ChainFrost.(MarkResource).xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>10</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff hrefvar="buff" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AliveFilter" />
                    <targetsLimit>1</targetsLimit>
                    <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.ClosestAutotarget">
                        <group>Enemies</group>
                    </autotarget>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="NoFrost.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <ranks>
        <Item href="ChainFrost01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="ChainFrost02.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="ChainFrost03.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>