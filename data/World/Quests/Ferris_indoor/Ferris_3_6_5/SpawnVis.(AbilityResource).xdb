<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>309459</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>700</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="/Mechanics/Spells/AstarlIslands/AI20/MindFlayerCasterBlink/TeleportEnd.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                            <zone href="/Maps/Ferris_indoor/ScriptZones/Ferris_3_6_5_Final_area.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                            <spawnResource href="/Maps/Ferris_indoor/SpawnTables/Gerbert_Ferris_3_6_5_script.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.5</coeff>
            </scaler>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>