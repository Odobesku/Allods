<?xml version="1.0" encoding="UTF-8" ?>
<VisualMountClass>
	<animationSettings>
		<playOnRiderTopOnly href="Horse/PlayOnRiderTopOnly.(AnimationsGroup).xdb#xpointer(/AnimationsGroup)" />
		<playOnRider href="" />
		<playOnMount href="Horse/PlayOnMountOnly.(AnimationsGroup).xdb#xpointer(/AnimationsGroup)" />
		<visualDismount>
			<Item>sitGround</Item>
			<Item>sitGroundUp</Item>
			<Item>emoteKneel</Item>
			<Item>sleep</Item>
			<Item>sleepDown</Item>
			<Item>sleepUp</Item>
			<Item>emoteMuscle</Item>
			<Item>emoteRasp</Item>
			<Item>emoteBeg</Item>
			<Item>emoteCheer</Item>
			<Item>emoteTriumph</Item>
			<Item>danceAnniversary</Item>
			<Item>emotePlayMusic</Item>
			<Item>specialSitGround</Item>
			<Item>emoteDance</Item>
			<Item>emoteDance01</Item>
			<Item>emoteDance02</Item>
			<Item>emoteDance03</Item>
			<Item>emoteDance04</Item>
			<Item>emoteDance05</Item>
			<Item>emoteDance06</Item>
			<Item>emoteDance07</Item>
			<Item>emoteDance08</Item>
			<Item>emoteDance09</Item>
			<Item>emoteDance10</Item>
			<Item>channelCastDirectedEngineer</Item>
			<Item>spellCastDirectedEngineer</Item>
			<Item>spellCastOmniEngineer</Item>
			<Item>idleEngineer</Item>
		</visualDismount>
		<complexAnimations>
			<Item>
				<animation>attack</animation>
				<playOnRiderTop>mountBearAttack</playOnRiderTop>
				<playOnRiderBottom>mountBearAttack</playOnRiderBottom>
				<playOnMount>attack</playOnMount>
			</Item>
			<Item>
				<animation>loot</animation>
				<playOnRiderTop>mountBearIdle</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>lootLoop</animation>
				<playOnRiderTop>mountBearIdle</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>sitGroundDown</animation>
				<playOnRiderTop>mountBearIdle</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>sitGroundDown</playOnMount>
			</Item>
			<Item>
				<animation>emoteAFK</animation>
				<playOnRiderTop>mountBearEmoteAFK</playOnRiderTop>
				<playOnRiderBottom>mountBearEmoteAFK</playOnRiderBottom>
				<playOnMount>emoteAFK</playOnMount>
			</Item>
			<Item>
				<animation>hit</animation>
				<playOnRiderTop>mountBearHitCritical</playOnRiderTop>
				<playOnRiderBottom>mountBearHitCritical</playOnRiderBottom>
				<playOnMount>hitCritical</playOnMount>
			</Item>
			<Item>
				<animation>idle</animation>
				<playOnRiderTop>mountBearIdle</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>idle01</animation>
				<playOnRiderTop>mountBearIdle</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>idle01</playOnMount>
			</Item>
			<Item>
				<animation>idle02</animation>
				<playOnRiderTop>mountBearIdle</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>idle02</playOnMount>
			</Item>
			<Item>
				<animation>idle03</animation>
				<playOnRiderTop>mountBearIdle</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>idle03</playOnMount>
			</Item>
			<Item>
				<animation>jump</animation>
				<playOnRiderTop>mountBearJumpEnd</playOnRiderTop>
				<playOnRiderBottom>mountBearJumpEnd</playOnRiderBottom>
				<playOnMount>jump</playOnMount>
			</Item>
			<Item>
				<animation>jumpEnd</animation>
				<playOnRiderTop>mountBearHitCritical</playOnRiderTop>
				<playOnRiderBottom>mountBearHitCritical</playOnRiderBottom>
				<playOnMount>jumpEnd</playOnMount>
			</Item>
			<Item>
				<animation>jumpLandRun</animation>
				<playOnRiderTop>mountBearHitCritical</playOnRiderTop>
				<playOnRiderBottom>mountBearHitCritical</playOnRiderBottom>
				<playOnMount>jumpLandRun</playOnMount>
			</Item>
			<Item>
				<animation>jumpStart</animation>
				<playOnRiderTop>mountBearHitCritical</playOnRiderTop>
				<playOnRiderBottom>mountBearHitCritical</playOnRiderBottom>
				<playOnMount>jumpStart</playOnMount>
			</Item>
			<Item>
				<animation>mountRideSit</animation>
				<playOnRiderTop>mountBearIdle</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>invalid</playOnMount>
			</Item>
			<Item>
				<animation>levelUp</animation>
				<playOnRiderTop>mountBearJumpEnd</playOnRiderTop>
				<playOnRiderBottom>mountBearJumpEnd</playOnRiderBottom>
				<playOnMount>levelUp</playOnMount>
			</Item>
			<Item>
				<animation>run</animation>
				<playOnRiderTop>mountBearRun</playOnRiderTop>
				<playOnRiderBottom>mountBearRun</playOnRiderBottom>
				<playOnMount>run</playOnMount>
			</Item>
			<Item>
				<animation>specialJump</animation>
				<playOnRiderTop>mountBearJumpEnd</playOnRiderTop>
				<playOnRiderBottom>mountBearJumpEnd</playOnRiderBottom>
				<playOnMount>specialJump</playOnMount>
			</Item>
			<Item>
				<animation>walk</animation>
				<playOnRiderTop>mountBearIdle</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>walk</playOnMount>
			</Item>
			<Item>
				<animation>walkBackwards</animation>
				<playOnRiderTop>mountBearRun</playOnRiderTop>
				<playOnRiderBottom>mountBearRun</playOnRiderBottom>
				<playOnMount>walkBackwards</playOnMount>
			</Item>
			<Item>
				<animation>useStandingStart</animation>
				<playOnRiderTop>useStandingStart</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>useStandingLoop</animation>
				<playOnRiderTop>useStandingLoop</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>useStandingEnd</animation>
				<playOnRiderTop>useStandingEnd</playOnRiderTop>
				<playOnRiderBottom>mountBearIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
		</complexAnimations>
	</animationSettings>
	<fxSettings>
		<mountLocators>
			<Item>Slot_FX</Item>
			<Item>Slot_Global</Item>
			<Item>Global</Item>
		</mountLocators>
	</fxSettings>
	<controlParameters>
		<speedFactorForward>
			<startVelocity>12</startVelocity>
			<stopVelocity>2</stopVelocity>
			<startTime>200</startTime>
			<stopTime>150</stopTime>
		</speedFactorForward>
		<speedFactorBackward>
			<startVelocity>3</startVelocity>
			<stopVelocity>0</stopVelocity>
			<startTime>0</startTime>
			<stopTime>0</stopTime>
		</speedFactorBackward>
	</controlParameters>
	<pitchParameters>
		<minVelocity>6</minVelocity>
		<minVelocityPitch>1</minVelocityPitch>
		<topVelocity>15</topVelocity>
		<topVelocityPitch>15</topVelocityPitch>
		<minStepDeltaTMainAvatar>20</minStepDeltaTMainAvatar>
		<minStepDeltaT>150</minStepDeltaT>
		<minTurnRadius>5</minTurnRadius>
		<pitchMaxVelocity>40</pitchMaxVelocity>
		<maxPitch>20</maxPitch>
	</pitchParameters>
	<jumpSettings>
		<specialJumpPause>3500</specialJumpPause>
		<specialJump href="SpecialJump.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
	</jumpSettings>
	<reinsSettings>
		<use>true</use>
		<reinsBone>Slot_Reins01</reinsBone>
		<handBone>Slot_Hand_R</handBone>
		<reinsBone01>Slot_Reins01</reinsBone01>
		<member>Assaulter</member>
		<disablingAnimations href="Horse/DisableReins.(CharacterAnimationsGroup).xdb#xpointer(/CharacterAnimationsGroup)" />
	</reinsSettings>
	<skinChangedScript href="/Spells/VisScripts/Commands/ChangeSkin.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<levelChangedScript href="/Spells/VisScripts/Commands/LevelUp_Mount.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<summonVisualScript href="/Spells/VisScripts/Mount/SummonCommonHorse.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<riderOrientation>All_FromMountSlot</riderOrientation>
	<useRiderSpineTurn>false</useRiderSpineTurn>
	<hiddenDressSlots>
		<Item>CLOAK</Item>
	</hiddenDressSlots>
</VisualMountClass>
