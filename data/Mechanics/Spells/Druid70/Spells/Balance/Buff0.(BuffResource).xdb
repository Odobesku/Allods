<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>214319</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Spell0.(SpellSingleTarget).Name.txt" />
    <Description href="Buff0.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidBalance.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Druid/Balance.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.ImpactsOverTime">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>15</radius>
                                <affectGroup>Enemies</affectGroup>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                <element>LIGHTNING</element>
                                                <damage>1</damage>
                                                <impactsOnHitTarget>
                                                    <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                                                        <impacts>
                                                            <Item type="gameMechanics.elements.impacts.StackBuff">
                                                                <buff href="/Mechanics/Spells/Druid70/Abilities/LightningRod/Buff01.(BuffResource).xdb" />
                                                                <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                                                <delta type="gameMechanics.elements.calcers.FloatData">
                                                                    <value>-1</value>
                                                                </delta>
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                </impactsOnHitTarget>
                                                <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                        <externalCalcer hrefvar="externalCalcer_damage" />
                                                    </mulCalcer>
                                                    <additionalMultiplier>
                                                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                    </additionalMultiplier>
                                                </scaler>
                                            </Item>
                                        </impacts>
                                        <groupRepeaters>true</groupRepeaters>
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                        <radius>15</radius>
                                        <affectPets>true</affectPets>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactHeal">
                                                <heal>1</heal>
                                                <scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                        <externalCalcer hrefvar="externalCalcer_heal" />
                                                    </mulCalcer>
                                                    <additionalMultiplier>
                                                        <scaler type="gameMechanics.elements.scalers.HealScaler" />
                                                    </additionalMultiplier>
                                                </scalerCaster>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <tick>1000</tick>
                <initialDelay>0</initialDelay>
            </effect>
            <ticksCount>6</ticksCount>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Interrupt.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>