<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739903117</resourceId>
    </Header>
    <name href="PhyroBolt_Projectile.(ProjectileResource).Name.txt" />
    <visObject href="/Mechanics/Spells/HuntingGrounds/HG2_Boss_FlamingHydra/FlamingZone.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0.1</altitude>
    <lifeLengthCap>17000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>5</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>FIRE</element>
                            <threatMultiplier>16</threatMultiplier>
                            <damage>20</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="DoT.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="DoT.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <targetsLimit>6</targetsLimit>
                </Item>
            </impacts>
            <tick>3000</tick>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>