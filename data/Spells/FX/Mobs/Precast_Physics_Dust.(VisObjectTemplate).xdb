<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>800</fadeOutMS>
    <particle href="/Spells/FX/Mobs/Precast_Physics_Dust.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)" />
    <scale>1</scale>
    <sound>
        <name>spells/FX/Spells/WarriorStatue/Dust</name>
        <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
