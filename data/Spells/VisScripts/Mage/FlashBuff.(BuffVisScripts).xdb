				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<playWhile />
				<elements>
					<Item type="VisActionDelay">
						<time>1050</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Mage_Hend_Stacking.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>0.8</scale>
								<locator>Slot_Hand_L</locator>
								<offendTime />
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/Mage_Hend_Stacking.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>0.8</scale>
								<locator>Slot_Hand_R</locator>
								<offendTime />
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/Mage_Body_StackingRunelEmpty.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>1.15</scale>
								<locator>Slot_Global</locator>
								<locatorName>Hips</locatorName>
