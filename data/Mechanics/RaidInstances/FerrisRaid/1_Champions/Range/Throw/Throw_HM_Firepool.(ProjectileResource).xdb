<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739885697</resourceId>
	</Header>
	<name href="Throw_HM_Firepool.(ProjectileResource).Name.txt" />
	<visObject href="/Spells/FX/Spells/MiniFirepool.(VisObjectTemplate).xdb" />
	<altitude>0</altitude>
	<lifeLengthCap>30000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
					<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
					<radius>1.8</radius>
					<affectHolder>false</affectHolder>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>FIRE</element>
									<damage>7.5</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
											<mobs>
												<Item href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Shaman/SummonWolfs/GhostWolf.(MobWorld).xdb" />
												<Item href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Shaman/SummonWolfs/SnowWolf.(MobWorld).xdb" />
											</mobs>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="Wolfs_Burning.(BuffResource).xdb" />
										</Item>
									</impactsIf>
								</Item>
							</impactsElse>
						</Item>
					</impacts>
					<filter type="gameMechanics.world.creature.AliveFilter" />
				</Item>
			</impacts>
			<tick>1000</tick>
			<initialDelay>2000</initialDelay>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
