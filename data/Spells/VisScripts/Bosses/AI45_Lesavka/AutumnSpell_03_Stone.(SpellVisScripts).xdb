<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<theGe>3</theGe>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>200</time>
					</Item>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Spells/Lesavka_EarthExplosion.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<offset x="-0.5" y="-2" />
								<locatorName>Slot_Global</locatorName>
								<hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastDirected</Item>
						</animations>
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
						</advanced>
					</Item>
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Lesavka_StoneProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="/Spells/FX/Spells/HitLesavka.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<theGe var="theGe" />
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_BodyFX</locator>
						</pointOnTarget>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<elements>
					<Item type="VisActionDelay">
						<visActionID />
						<time>300</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visActionID>st01</visActionID>
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Lesavka_Stone.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<lockScale>true</lockScale>
								<scale>1.5</scale>
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
						<stopOnDeath>false</stopOnDeath>
						<category>EFFECT_DEFAULT</category>
					</Item>
					<Item type="VisActionDelay">
						<time>885</time>
					</Item>
					<Item type="VisActionStopAction">
						<visActionID />
						<stoppedActionID>st01</stoppedActionID>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>350</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visActionID>hnd01</visActionID>
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Lesavka_HandDirect01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fadeInTime>800</fadeInTime>
								<fadeOutTime>200</fadeOutTime>
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
					<Item type="VisActionDelay">
						<time>850</time>
					</Item>
					<Item shortCut="SpellHandDirect" type="VisActionStopAction">
						<stoppedActionID>hnd01</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
