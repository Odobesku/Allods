<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>186407</resourceId>
    </Header>
    <Name href="PerfectFreeze.(BuffResource).Name.txt" />
    <Description href="PerfectFreeze.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/ElectrostaticChargeTank.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/AOEAura_Red_R3.(VisObjectTemplate).xdb" />
            <lockScale>true</lockScale>
            <fadeInTime>300</fadeInTime>
            <fadeOutTime>300</fadeOutTime>
            <locator>Slot_Global</locator>
        </Item>
    </visualEffects>
    <visScript href="/Spells/BuffVisScripts/Prototypes/Paralyze.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <affectsPureHeal>true</affectsPureHeal>
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.99</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                <resource href="LightningHitR5.(ProjectileResource).xdb" />
                            </projectileData>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>5</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>LIGHTNING</element>
                                    <damage>100</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                        </predicates>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </filter>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                            <damage>1</damage>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                            </scalerTarget>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>2500</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/AstralIslandSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>