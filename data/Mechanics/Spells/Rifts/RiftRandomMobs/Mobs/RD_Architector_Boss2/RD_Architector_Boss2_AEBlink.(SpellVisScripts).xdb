<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmni</Item>
					<Item>readySpell</Item>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ArchitectDestroyer_ReadySpellAoe.(VisObjectTemplate).xdb" />
						<scale>1.2</scale>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Architect_Swarm_Avatar_Instable.(VisObjectTemplate).xdb" />
						<locator>Head</locator>
						<offendTime />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/AOEAura_Red_R8.(VisObjectTemplate).xdb" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<animationKeysAction />
					<animationKeysSound />
					<animationKeysActionPeriod />
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Mobs/ArchitectDestroyer_SpellCastAoe.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<offendTime />
					</Item>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Spells/HitLightning_big_ShakeCamera.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>