<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureChangeVisItemsAction">
				<items>
					<Item>
						<slot>LIFESTYLEBACK</slot>
						<newItem href="/Items/VisualItems/Cloak/Bag_Cloth_A_74Flamethrower.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
					</Item>
					<Item>
						<slot>TWOHANDED</slot>
					</Item>
					<Item>
						<slot>RANGED</slot>
						<newItem href="/Items/VisualItems/Weapon/2HCrossbow/Crossbow_2H_A_01_Flamethrower.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
					</Item>
				</items>
			</Item>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>readyCrossbow</play>
							<forAnimations>
								<Item>walk</Item>
								<Item>run</Item>
								<Item>walkBackwards</Item>
								<Item>idle</Item>
								<Item>idle01</Item>
								<Item>idle02</Item>
								<Item>idle03</Item>
								<Item>idle1H</Item>
								<Item>idle2HL</Item>
								<Item>idle2H</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
