<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739873131</resourceId>
    </Header>
    <name href="Projectile_01.(ProjectileResource).Name.txt" />
    <visObject href="Projectile_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0</altitude>
    <lifeLengthCap>10000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Aura">
            <checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
            <affectGroup>Friends</affectGroup>
            <radius>4</radius>
            <delayIn>1500</delayIn>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/UmoirRaid/MobPack/RabbitSpell/Buff_03.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impactsIf>
                </Item>
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <tick>1000</tick>
            <affectGroup>Enemies</affectGroup>
            <radius>3</radius>
            <delayIn>1000</delayIn>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="FireDot.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="FireDot.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>