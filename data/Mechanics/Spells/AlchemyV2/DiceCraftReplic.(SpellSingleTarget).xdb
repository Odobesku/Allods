<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739895362</resourceId>
	</Header>
	<Name href="DiceCraftReplic.(SpellSingleTarget).Name.txt" />
	<Description href="DiceCraftReplic.(SpellSingleTarget).Description.txt" />
	<targetType>STTSelf</targetType>
	<isAggro>false</isAggro>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>1000</duration>
		</cooldown>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceActiveItem" />
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="DiceCraftReplic.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</predicates>
				<impacts>
					<Item type="gameMechanics.elements.impacts.StackBuff">
						<buff href="DiceCraftReplic.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						<delta type="gameMechanics.elements.calcers.FloatData">
							<value>1</value>
						</delta>
					</Item>
				</impacts>
				<elseImpacts>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="DiceCraftReplic.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</elseImpacts>
			</Item>
