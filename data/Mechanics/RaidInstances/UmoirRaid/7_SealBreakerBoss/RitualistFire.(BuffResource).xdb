	<visScript href="RitualistFire.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectAllowNoVisibleTargets" />
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>12000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
							<table href="NPC.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>5000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
									<impacts>
										<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
											<table href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Ritual.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
										</Item>
										<Item type="gameMechanics.elements.impacts.PostponedImpacts">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
													<impacts>
														<Item type="gameMechanics.elements.impacts.Disintegrate" />
													</impacts>
													<spawnResource href="RitualPhase.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
