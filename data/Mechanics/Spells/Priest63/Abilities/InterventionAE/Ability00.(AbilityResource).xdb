	<name href="Ability00.(AbilityResource).Name.txt" />
	<description href="Ability00.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="value" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Priest/PriestAspectControl.(UISingleTexture).xdb" />
	<effects>
