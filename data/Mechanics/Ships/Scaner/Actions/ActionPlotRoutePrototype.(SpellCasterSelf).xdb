<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>243769</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <cost />
        </Variables>
    </Header>
    <prepareDuration>0</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <mechanics>
        <cooldown>
            <duration>3000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.world.ship.elements.PredicateScanerHasPOI" />
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.world.ship.elements.ResourceInsight">
                <amount type="gameMechanics.elements.calcers.CalcerMul">
                    <calcers>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value var="cost" />
                        </Item>
                        <Item type="gameMechanics.elements.calcers.CalcerExp">
                            <base>2</base>
                            <powCalc type="gameMechanics.world.device.CalcerTechLevelDelta" />
                        </Item>
                    </calcers>
                </amount>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.world.ship.elements.ImpactShowTargetPath" />
            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                <data href="ActionPlotRouteButtonSpell.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>0</speed>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>