<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739967605</resourceId>
	</Header>
	<Name href="/World/Quests/Ferris4/Ferris_4_2_4/WatchingDialog.(BuffResource).Name.txt" />
	<Description href="/World/Quests/Ferris4/Ferris_4_2_4/WatchingDialog.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/TepSoulSteal.(UISingleTexture).xdb" />
	<visScript href="CS_Sand_Strom.(BuffVisScripts).xdb" />
	<needVisualizeDuration>false</needVisualizeDuration>
	<sysUIScriptName>cutScene</sysUIScriptName>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>CS_End</scriptID>
							<map href="/Maps/Inst_ZoneContested12_Start/MapResource.xdb" />
						</locator>
					</destination>
					<finishImpacts>
						<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
							<table href="CS_Sand_Strom.(SpawnTable).xdb" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
									<delay>1000</delay>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="CS_Leader_animation.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="CS_Sand_Storm_1.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</finishImpacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Maps/Inst_ZoneContested12_Start/CutScene/CS_Sand_storm_watched.(BuffResource).xdb" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>ZC12_Coast_start</scriptID>
							<map href="/Maps/ZC12/MapResource.xdb" />
						</locator>
					</destination>
					<finishImpacts>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="/World/Quests/ZC12/WW_1_3/Counter3.(QuestCountId).xdb" />
						</Item>
					</finishImpacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
					<spawnResource href="CS_Sand_Strom.(SpawnTable).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
					<spawnResource href="CS_Sand_Storm_AssaultBoard.(SpawnTable).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
					<spawnResource href="CS_Sand_Storm_Crash_Board.(SpawnTable).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
					<spawnResource href="CS_Sand_Storm_Safe_Board.(SpawnTable).xdb" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDoesNotAggro" />
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
	</effects>
	<duration>49000</duration>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
