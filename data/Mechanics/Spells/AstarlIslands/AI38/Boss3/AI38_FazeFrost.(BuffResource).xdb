    <image href="/Interface/Icons/Spells/Mage/MageGlazedFrost.(UISingleTexture).xdb" />
    <visScript href="AI38_FazeFrost.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                    <spell href="AI38_FrostComet.(SpellSingleTarget).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="SummonPool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="AI38_FazeFire.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
                                                <alternatives>
                                                    <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                        <verticalRange min="0" max="0" />
                                                        <horizontalRange min="10" max="18" />
                                                    </Item>
                                                </alternatives>
                                                <safetyRadius>0.05</safetyRadius>
                                            </Item>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTraceNear" />
                                        </modifiers>
                                    </destination>
                                </moveType>
                                <resource href="AI38_FrostAoE.(ProjectileResource).xdb" />
                            </projectileData>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
                                                <alternatives>
                                                    <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                        <verticalRange min="0" max="0" />
                                                        <horizontalRange min="4" max="18" />
                                                    </Item>
                                                </alternatives>
                                                <safetyRadius>0.05</safetyRadius>
                                            </Item>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTraceNear" />
                                        </modifiers>
                                    </destination>
                                </moveType>
                                <resource href="AI38_FrostAoE.(ProjectileResource).xdb" />
                            </projectileData>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <initialDelay>500</initialDelay>
        </Item>
    </effects>
    <duration>23000</duration>
    <isGradual>true</isGradual>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>