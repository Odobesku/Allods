<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>220739</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Mobparts/EyeAnimal.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/Camera_CutScene.(VisObjectTemplate).xdb" />
        </Item>
    </visualEffects>
    <visScript href="LastEnd_CutScene_Main.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Portal_CutScene_Plane.(Plane).xdb" />
            <personalPlane>true</personalPlane>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="InterfaceActive.(ClientData).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>Last_Die_Rysina_Run_1</scriptID>
                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                        </locator>
                    </destination>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="LastEnd_CutScene.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>cutscene_boom</scriptID>
                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                        </locator>
                        <yaw type="constructor.basicElements.AngleDegrees">
                            <value>87</value>
                        </yaw>
                    </destination>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="LastDie_Animation.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <object href="/Mechanics/RaidInstances/FerrisRaid/16_Carrier/Phase4/CutScene_BossLast.(MobWorld).xdb" />
                    <pool href="CutScenePool.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="InterfaceDeactive.(ClientData).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_1.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_1.5.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_2.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_3.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_4.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_5.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_6.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_7.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_8.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LastEnd_CutScene_9.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>CutSCene_LAst</scriptID>
                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                        </locator>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="CutScenePool.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="InvisibleInCutscenes.(Plane).xdb" />
                <action>DENY</action>
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="InvisibleInCutscenes.(Plane).xdb" />
                <action>DENY</action>
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="InvisibleInCutscenes.(Plane).xdb" />
                <action>DENY</action>
            </visibilityRule>
        </Item>
    </effects>
    <duration>122500</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>