    <image href="/Interface/Icons/Equipment/Ships/LightGun.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>LIGHTNING</element>
                    <damage>10</damage>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>1500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
                    <impactsIn>
                        <impactsFromCaster>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="AI60_ChannelingDamageLine.(BuffResource).xdb" />
                            </Item>
                        </impactsFromCaster>
                    </impactsIn>
                    <impactsOut>
                        <impactsFromCaster>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="AI60_ChannelingDamageLine.(BuffResource).xdb" />
                            </Item>
                        </impactsFromCaster>
                    </impactsOut>
                    <minLength>1</minLength>
                    <maxLength>80</maxLength>
                    <reconnect>true</reconnect>
                    <width>1</width>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
