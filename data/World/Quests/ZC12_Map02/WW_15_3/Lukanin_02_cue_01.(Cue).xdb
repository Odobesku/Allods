			</predicate>
		</Item>
	</conditions>
	<impacts>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="Counter1.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactSummon">
			<destination type="gameMechanics.map.destination.DestinationLocator">
				<locator>
					<scriptID>WW_15_3_Cannon2</scriptID>
					<map href="/Maps/ZC12_Map02/MapResource.xdb" />
				</locator>
			</destination>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>600000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/World/Quests/ZC12_Map02/WW_15_1/Escort_visibility.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>3000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.GoThroughLocatorsList">
							<path href="BigGun_03.(LocatorsList).xdb" />
						</Item>
					</impacts>
				</Item>
			</impacts>
			<object href="/Creatures/NotCreatures/ZC12_BigGun/ZC12_BigGun.(MobWorld).xdb" />
			<pool href="/World/Quests/ZC12_Map02/WW_15_1/Cannons.(SummonPool).xdb" />
			<isPersonalPool>true</isPersonalPool>
		</Item>
		<Item type="gameMechanics.elements.impacts.BuffDetacher">
			<buff href="/Mechanics/QuestSchemes/Maintenance/SeeQuestGiver.(BuffResource).xdb" />
		</Item>
		<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
			<buff href="/Mechanics/QuestSchemes/Maintenance/SeeMobs.(BuffResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
			<delay>2000</delay>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInZone">
							<zone href="/Maps/ZC12_Map02/Zones/ZC12_Map02/ZC12_Map02.(ZoneResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
							<destination type="gameMechanics.map.destination.RelativePos" />
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Mechanics/QuestSchemes/Maintenance/SeeMobs.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/World/Quests/ZC12/WW_1_5/Assistant_visibility.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
							</impacts>
							<assistantResource href="/World/Quests/ZC12/WW_1_9/Soldier3.(AssistantResource).xdb" />
							<mobResource href="/Characters/Hadagan_male/Instances/ZC12_Map02/Lukanin02_assistant.(MobWorld).xdb" />
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/World/Quests/ZC12/WW_1_9/AssistantControl.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="/Mechanics/QuestSchemes/Maintenance/SeeQuestGiver.(BuffResource).xdb" />
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
							<quest href="WW_15_3.xdb" />
						</Item>
					</impactsElse>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.impacts.BuffDetacher">
			<buff href="/World/Quests/ZC12_Map02/WW_15_2/Staying_assists_vis.(BuffResource).xdb" />
		</Item>
	</impacts>
</gameMechanics.world.mob.interaction.Cue>
