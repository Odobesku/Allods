                                <totalCount>1</totalCount>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ReturningSuspicionBuff.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="AvatarAggroBuff.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="KultistEnemy.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>7000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectIncreaseHealth">
