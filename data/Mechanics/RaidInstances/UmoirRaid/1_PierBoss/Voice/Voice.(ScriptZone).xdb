<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>739863438</resourceId>
    </Header>
    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
        <filters>
            <Item type="gameMechanics.world.creature.AvatarFilter" />
            <Item type="gameMechanics.world.creature.AliveFilter" />
            <Item type="gameMechanics.constructor.basicElements.FilterNot">
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Voice.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                </filter>
            </Item>
        </filters>
    </filter>
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.map.variables.PredicateMapVariableLess">
                    <variableResource href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/PierBoss.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <maxValue type="gameMechanics.elements.calcers.FloatData">
                        <value>1</value>
                    </maxValue>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Voice.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Voice.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsElse>
        </Item>
    </impactsIn>
    <considerAsWhole>true</considerAsWhole>
</gameMechanics.map.scriptZone.ScriptZone>