    <targetType>STTPoint</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>3000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="RedTeam_SpellDisable.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="FootballGameplayV2/YourMoveBuff.(BuffResource).xdb" />
                <consumeStacks>1</consumeStacks>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                <data href="StrikeBallStrong.(ClientData).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>2.5</radius>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="MoveBall2.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="StrikeAndGoalCounterBuff.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="FootballGameplayV2/ForgetStickyAbility.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Creatures/Slime/Instances/ArchipelagoEmpire2/SlimeBall.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                        </filter>
                        <targetsLimit>1</targetsLimit>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="RedTeam.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>2.5</radius>
                                <affectHolder>false</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                        <buff href="BlueTeam_hit.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="RedTeam_hit.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Creatures/Slime/Instances/ArchipelagoEmpire2/SlimeBall.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                </filter>
                                <targetsLimit>1</targetsLimit>
                            </Item>
                        </impacts>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>2.5</radius>
                                <affectHolder>false</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                        <buff href="RedTeam_hit.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="BlueTeam_hit.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Creatures/Slime/Instances/ArchipelagoEmpire2/SlimeBall.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                </filter>
                                <targetsLimit>1</targetsLimit>
                            </Item>
                        </impacts>
                    </Item>
                </impactsElse>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="hit_ball.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>