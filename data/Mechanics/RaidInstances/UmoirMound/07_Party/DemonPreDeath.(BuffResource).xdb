<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739885365</resourceId>
    </Header>
    <visScript href="DemonPreDeath.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllSpells" />
        <Item type="gameMechanics.elements.effects.ImmunityToHarmfulSpells" />
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                    <data href="/Mechanics/RaidInstances/UmoirMound/Voice/Heroes/Combat/Demon/60_Death.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                    <spawnResource href="/Maps/UmoirMound/SpawnTables/07_Party.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>10000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="DemonPreDeath.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Knockdowned.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
    </effects>
    <duration>20000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>