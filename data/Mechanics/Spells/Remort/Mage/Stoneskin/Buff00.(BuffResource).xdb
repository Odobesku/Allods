	<image href="/Interface/Icons/Spells/Mage/Gust.(UISingleTexture).xdb" />
	<visualEffects />
	<visScript href="/Spells/BuffVisScripts/DotIce.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
			<effect type="gameMechanics.elements.effects.ImpactsOverTime">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<radius>15</radius>
						<affectGroup>Enemies</affectGroup>
						<impacts>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Slowness/Slowness.(BuffResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
								<impacts>
									<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
										<element>COLD</element>
										<damage>10</damage>
										<scaler type="gameMechanics.elements.scalers.ScalerMax">
											<scaler1 type="gameMechanics.constructor.basicElements.ScalerMultiple">
												<scalers>
													<Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
													<Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
												</scalers>
											</scaler1>
											<scaler2 type="gameMechanics.elements.scalers.MagicScaler" />
										</scaler>
									</Item>
								</impacts>
								<groupRepeaters>true</groupRepeaters>
							</Item>
						</impacts>
						<filter type="gameMechanics.world.creature.AliveFilter" />
					</Item>
				</impacts>
				<tick>1000</tick>
			</effect>
			<ticksCount>4</ticksCount>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<isAE>true</isAE>
	<groups>
