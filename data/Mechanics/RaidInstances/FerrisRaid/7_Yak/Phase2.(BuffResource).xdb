                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                </Item>
            </impacts>
            <tick>12000</tick>
            <initialDelay>3000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.tools.SelectorRandomNotLess">
                        <minIndex>1</minIndex>
                    </selector>
                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
