<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>313634</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
            <impactsOnLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                            <rule href="/Mechanics/Rules/Ferris/Ferris_event_1/Ferris_event_1.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="Ferris_1_event_daily.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOnLeave>
            <activeZone href="/Maps/Ferris/Zones/Ferris01/Ferris01.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                            <rule href="/Mechanics/Rules/Ferris/Ferris_event_1/Ferris_event_1.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/Ferris/Zones/Ferris01/Ferris01.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="Ferris_1_event_daily.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>