<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<Header>
		<Variables>
			<Delay>6000</Delay>
		</Variables>
	</Header>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureVisCharacterAction">
					<visCharList>
						<Item href="/Characters/Kania_female/KaniaFemale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
						<Item href="/Characters/Kania_male/KaniaMale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
					</visCharList>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureMountVisAction">
						<visualMount href="/Client/VisualMounts/EngineerPlatform/EngineerPlatform.(VisualMount).xdb#xpointer(/VisualMount)" />
					</Item>
					<Item type="VisActionList">
						<elements>
							<Item type="VisActionDelay">
								<time var="Delay" />
							</Item>
							<Item type="CreatureAnimationAction">
								<mode>CLAMP</mode>
								<animations>
									<Item>special01</Item>
								</animations>
								<channel>CHANNEL_DEATH</channel>
								<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureVisCharacterAction">
					<visCharList>
						<Item href="/Characters/Hadagan_female/HadaganFemale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
						<Item href="/Characters/Hadagan_male/HadaganMale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
					</visCharList>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureMountVisAction">
						<visualMount href="/Client/VisualMounts/EngineerPlatform/EngineerPlatformHadagan.(VisualMount).xdb#xpointer(/VisualMount)" />
					</Item>
					<Item type="VisActionList">
						<elements>
							<Item type="VisActionDelay">
								<time var="Delay" />
							</Item>
							<Item type="CreatureAnimationAction">
								<mode>CLAMP</mode>
								<animations>
									<Item>special01</Item>
								</animations>
								<channel>CHANNEL_DEATH</channel>
								<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="" />
					<name />
				</sound>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
