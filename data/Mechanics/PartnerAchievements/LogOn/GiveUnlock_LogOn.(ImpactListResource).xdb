    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                        <unlock href="LogOn.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </predicate>
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                            <rule href="/Mechanics/Rules/PartnerAchievements/MiniGames_MailRu.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
