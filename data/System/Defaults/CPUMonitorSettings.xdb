<?xml version="1.0" encoding="UTF-8" ?>
<shardstarter.modules.CPUMonitorSettings>
	<Header>
		<resourceId>739902341</resourceId>
	</Header>
	<rules>
		<Item>
			<regex>Job_Executor.*</regex>
			<name>JobExecutors</name>
		</Item>
		<Item>
			<regex>C3P0.*</regex>
			<name>c3p0</name>
		</Item>
		<Item>
			<regex>.*qtp-.*</regex>
			<name>qtp</name>
		</Item>
		<Item>
			<regex>JMX server connection timeout.*</regex>
			<name>JMXConnectionTimeouts</name>
		</Item>
		<Item>
			<regex>btpool.*</regex>
			<name>btpool</name>
		</Item>
		<Item>
			<regex>time-check.*</regex>
			<name>TimeCheck</name>
		</Item>
		<Item>
			<regex>.*ChannelDataTextWriter.*</regex>
			<name>ChannelWriters</name>
		</Item>
		<Item>
			<regex>.*RMI.*</regex>
			<name>RMI</name>
		</Item>
	</rules>
</shardstarter.modules.CPUMonitorSettings>
