<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>202224</resourceId>
    </Header>
    <Name href="Spell_Name.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/PetCommandAttack.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="/Spells/VisScripts/Bosses/GhostlyKnight/ShadowStrike.xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="Spell_Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>7</value>
    </range>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>2000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceBaseMana">
                <baseMana>0.05</baseMana>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Maps/2ndCircle/ScriptZones/Mud_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ASTRAL</element>
                        <damage>3.625</damage>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ASTRAL</element>
                        <threatMultiplier>0</threatMultiplier>
                        <damage>14.5</damage>
                    </Item>
                </impactsElse>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>50</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>