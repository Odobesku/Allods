    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>30000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                <pool href="SoloHealer_Wisp.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="WispBurst.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                        <radius>5</radius>
                                        <affectGroup>Enemies</affectGroup>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                <element>HOLY</element>
                                                <damage>30</damage>
                                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                            </Item>
                                        </impacts>
                                        <finishImpacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                        </finishImpacts>
                                        <filter type="gameMechanics.world.creature.CreatureFilter" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="SoloHealer_ready.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
