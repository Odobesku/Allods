    <needVisualizeDuration>false</needVisualizeDuration>
    <nameTemplate href="Buff07_AddActivity.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="UI04_Boss02_AddWarrior.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                <Item href="UI04_Boss02_AddShooter.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/AstarlIslands/AI56_UI04/Trash05/Buff03_Enrage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                            <group href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>6000</duration>
    <stackLimit>3</stackLimit>
    <isGradual>true</isGradual>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>