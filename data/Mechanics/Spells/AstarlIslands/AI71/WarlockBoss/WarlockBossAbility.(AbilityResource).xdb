<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>188336</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="PhaseRefresh.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSpawnTableGroup">
                            <group href="/Mechanics/Spells/AstarlIslands/BossCallForHelp/BeforeBoss04.(SpawnTableGroup).xdb" />
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="WarlockBossCFHTeleport.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/Spells/AstarlIslands/AI71/Common/AI71Pool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                    <group href="/Mechanics/Spells/Groups/AstralIslandSpells.xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                    <affectPets>false</affectPets>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                            <group href="/Mechanics/Spells/Groups/AstralIslandSpells.xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSpawnTableGroup">
                                    <group href="/Mechanics/Spells/AstarlIslands/BossCallForHelp/BeforeBoss04.(SpawnTableGroup).xdb" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="WarlockBossCFHTeleport.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                            <delay>2000</delay>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                            <predicates>
                                                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                                    <mobs>
                                                                        <Item href="/Mechanics/Spells/AstarlIslands/AI71/Exterminator/Exterminator.(MobWorld).xdb" />
                                                                    </mobs>
                                                                </Item>
                                                            </predicates>
                                                            <impactsIf>
                                                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                                                    <radius>25</radius>
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                                            <delay>1000</delay>
                                                                            <impacts>
                                                                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                                                    <value>1</value>
                                                                                </Item>
                                                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                                                    <impacts>
                                                                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                                                            <value>1</value>
                                                                                        </Item>
                                                                                    </impacts>
                                                                                </Item>
                                                                            </impacts>
                                                                        </Item>
                                                                    </impacts>
                                                                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                                        <predicates>
                                                                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                                                <mobs>
                                                                                    <Item href="/Mechanics/Spells/AstarlIslands/AI71/Warlock/Warlock.(MobWorld).xdb" />
                                                                                </mobs>
                                                                            </Item>
                                                                        </predicates>
                                                                    </filter>
                                                                </Item>
                                                            </impactsIf>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>AI71FinalPortal</scriptID>
                        <map href="/Maps/AstralIsle71/MapResource.xdb" />
                    </device>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>