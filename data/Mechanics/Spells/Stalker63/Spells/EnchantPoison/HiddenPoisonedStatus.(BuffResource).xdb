<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739948602</resourceId>
	</Header>
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsIf">
					<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
						<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
									<buff href="PoisonStrong01.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
									<buff href="PoisonNormal01.(BuffResource).xdb" />
								</Item>
							</predicates>
						</predicate>
					</predicate>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="HiddenPoisonedStatus.(BuffResource).xdb" />
						</Item>
					</impactsIf>
				</Item>
			</impacts>
			<initialDelay>1000</initialDelay>
		</Item>
	</effects>
	<duration>1000</duration>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<isClientReplicated>false</isClientReplicated>
	<groups>
