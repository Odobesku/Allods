<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>194364</resourceId>
    </Header>
    <Name href="SummonTurret.(SpellSingleTarget).Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>16000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                            <verticalRange min="1" max="1" />
                            <horizontalRange min="1" max="2" />
                        </Item>
                    </modifiers>
                </destination>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/AstarlIslands/AI23/SummonDelay/Delay.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                <value>1</value>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterOr">
                                    <filters>
                                        <Item type="gameMechanics.world.creature.AvatarFilter" />
                                        <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </filters>
                                </filter>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <traceDown>true</traceDown>
                <object href="/Mechanics/Spells/AstarlIslands/AI23/AI23_Engineer/TurretAdd/TurretAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                <pool href="TurretPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>