<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>special03</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>800</time>
				</playWhile>
				<elements>
					<Item type="VisActionList">
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Mobs/Cyclop_Gold.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<effectAlias href="" />
										<lockScale>true</lockScale>
										<fadeInTime>500</fadeInTime>
										<fadeOutTime>500</fadeOutTime>
										<locator>Head</locator>
										<offendTime />
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
