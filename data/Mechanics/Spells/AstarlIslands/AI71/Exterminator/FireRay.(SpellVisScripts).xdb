<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>3500</time>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFireWand.(VisObjectTemplate).xdb" />
						<scale>1.5</scale>
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFireWand.(VisObjectTemplate).xdb" />
						<scale>1.5</scale>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirected</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<advanced>
					<speed>1.5</speed>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Mobs/MountWasp_Channel.(VisObjectTemplate).xdb" />
						<fxLength>20</fxLength>
						<startPoint type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</startPoint>
						<endPoint type="VisPointLocator">
							<locator>Slot_FX</locator>
						</endPoint>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectFireWand_Cast.(VisObjectTemplate).xdb" />
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureEffectsOnTarget">
						<visualEffects>
							<Item>
								<delay>333</delay>
								<effectFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb" />
								<scale>0.333</scale>
								<locator>Slot_FX</locator>
								<offendTime type="EffectOffendConstDelay" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
