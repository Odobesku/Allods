<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>300</fadeInMS>
    <fadeOutMS>300</fadeOutMS>
    <particle href="/Spells/FX/Mobs/WormGlacial_Tremors.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)" />
    <scale>1</scale>
    <sound>
        <name>spells/FX/Spells/LesavkaAbilities/EarthExplosion</name>
        <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
    </sound>
    <visObjComponents>
        <Item type="CameraShakerComponent">
            <params href="/Spells/FX/InterfaceFX/CameraShakeWormGlacial_Tremors.(CameraShakeParameters).xdb#xpointer(/client.VisualConstructor.CameraShakeParameters)" />
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>