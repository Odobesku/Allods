<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739921443</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
        </Item>
        <Item>
            <name>dur</name>
            <value var="dur" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/ChampionsSpells/ChampionsVengeance.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectVariableTrigger">
            <resource href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
            <valueTriggers>
                <Item>
                    <value type="gameMechanics.elements.calcers.FloatData">
                        <value>0</value>
                    </value>
                    <effects>
                        <Item type="gameMechanics.elements.effects.OutgoingHealModifier">
                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                <coeff>0.01</coeff>
                                <calcer type="gameMechanics.elements.calcers.FloatData">
                                    <value var="value" />
                                </calcer>
                            </scaler>
                        </Item>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                        <buff href="CD.(BuffResource).xdb" />
                                                    </predicate>
                                                </Item>
                                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                        <buff href="HealWithoutZeal.(BuffResource).xdb" />
                                                    </predicate>
                                                </Item>
                                                <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="CD.(BuffResource).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="HealWithoutZeal.(BuffResource).xdb" />
                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier var="dur" />
                                                    </durationScaler>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOn>
                            <rerunOnLoad>true</rerunOnLoad>
                        </Item>
                    </effects>
                </Item>
            </valueTriggers>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>