								<value>-1</value>
							</delta>
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss02/RD_Humanoid_Boss2_cooldownFire.(BuffResource).xdb" />
									</predicate>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>FIRE</element>
									<scalerTarget type="gameMechanics.elements.scalers.ScalerBuff">
										<buff href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss02/RD_Humanoid_Boss1_ReflectStacks.(BuffResource).xdb" />
										<summand>0</summand>
										<stackCountSummand>1</stackCountSummand>
									</scalerTarget>
									<damage>1</damage>
									<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
										<scalers>
											<Item type="gameMechanics.elements.scalers.MagicScaler" />
											<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="constructor.elements.CalcerFloatExternal">
													<externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/IncreasingDamageBoss.(CalcerFloatResource).xdb" />
												</mulCalcer>
											</Item>
										</scalers>
									</scaler>
								</Item>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss02/RD_Humanoid_Boss1_ReflectStacks.(BuffResource).xdb" />
								</Item>
							</impactsIf>
						</Item>
					</impactsElse>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss02/RD_Humanoid_Boss1_ReflectStacks.(BuffResource).xdb" />
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
