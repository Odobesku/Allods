<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
					<animationKeysAction>
						<Item>
							<action type="CreatureTrailAction">
								<mainHandTrail href="/Spells/FX/InterfaceFX/TrailBlood.(TrailTemplate).xdb#xpointer(/TrailTemplate)" />
								<offHandTrail href="" />
								<creatureTrail href="" />
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/MountBear_AtackTrail.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<delay>600</delay>
						<effectFx href="/Spells/FX/Spells/HitBlood.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<locator>Slot_FX</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>spells/Mount/MountBear/MountBearBump</name>
				</sound>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction />
	</playOnTargets>
</SpellVisScripts>
