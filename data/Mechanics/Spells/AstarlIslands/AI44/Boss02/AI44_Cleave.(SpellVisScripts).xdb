<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="CreatureLockRotationAction" />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack2HL</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<advanced>
					<speed>0.4</speed>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Ready_HowlingStrike.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.2</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="Sound3DAction">
		<sound>
			<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
			<name>spells/FX/Spells/HowlingStrike/HowlingStrikeReady</name>
		</sound>
	</wholeCasting>
	<launch type="Sound3DAction">
		<sound>
			<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
			<name>spells/FX/Spells/HowlingStrike/HowlingStrikeMaze</name>
		</sound>
	</launch>
</SpellVisScripts>
