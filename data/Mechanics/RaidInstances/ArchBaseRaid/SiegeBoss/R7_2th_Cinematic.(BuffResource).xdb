<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739976084</resourceId>
	</Header>
	<visScript href="R7_2th_Cinematic.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.Disintegrate" />
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="1th_CinematicResource.(Plane).xdb" />
			<personalPlane>true</personalPlane>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>6000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactClientData">
							<data href="/Mechanics/RaidInstances/ArchBaseRaid/Other/R7_2ndBoss_Introduction.(ClientData).xdb" />
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
	</effects>
	<duration>11000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="R7_ArchBase_Raid.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
