<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739833867</resourceId>
    </Header>
    <Name href="BuffName.txt" />
    <Description href="BuffDesc.txt" />
    <visScript href="UI02_Charge.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <nameTemplate href="BuffName.txt" />
    <descTemplate href="BuffDesc.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>2</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>All</affectGroup>
            <radius>6</radius>
            <filter type="gameMechanics.world.device.filters.DeviceFilter" />
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateDevice">
                    <deviceResources>
                        <Item href="/Items/InteractiveObjects/UmoirIsland02/UI02_DungDoor.(DoorResource).xdb#xpointer(/gameMechanics.world.device.DoorResource)" />
                    </deviceResources>
                </Item>
            </predicates>
            <impactsIn>
                <Item type="gameMechanics.elements.device.DoorSwitch">
                    <switchType>Open</switchType>
                </Item>
                <Item type="gameMechanics.elements.device.DeviceDie" />
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectForcePull">
                    <destination type="gameMechanics.map.destination.RelativeRotatePos">
                        <base type="gameMechanics.map.destination.SelfPosDestination" />
                        <offset>30</offset>
                        <yaw type="constructor.basicElements.AngleDegrees" />
                        <turn>ToBase</turn>
                    </destination>
                    <impactsOnArrived>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="UI02_Charge.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsOnArrived>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>4000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>