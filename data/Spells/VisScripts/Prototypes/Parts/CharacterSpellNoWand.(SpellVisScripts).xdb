<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<isPrototype>true</isPrototype>
		<Prototype href="Base.(SpellVisScripts).xdb" />
		<Variables>
			<FixPointCaster />
			<PreCastAnimation />
			<FXWand />
			<FXPocket />
			<PreCastFX />
			<WholeCastFX />
			<CastAnimation>spellCastDirected</CastAnimation>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureRunVisActionResource">
				<resource hrefvar="PreCastAnimation" />
			</Item>
			<Item type="CreatureRunVisActionResource">
				<resource hrefvar="PreCastFX" />
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureRunVisActionResource">
				<resource hrefvar="WholeCastFX" />
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item skiped="" />
							<Item>
								<effectFx hrefvar="FXWand" />
								<fixPoint>true</fixPoint>
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<charged type="CreatureChargedSpellAction">
		<effectFx hrefvar="FXPocket" />
		<effectLocator>Slot_Hand_R</effectLocator>
	</charged>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
