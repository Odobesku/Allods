<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739905202</resourceId>
	</Header>
	<Name href="AE_Shot.(SpellArea).Name.txt" />
	<visualScripts href="AE_Shot.(SpellVisScripts).xdb" />
	<prepareDuration>1000</prepareDuration>
	<targetType>STTSelf</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>10000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="PortalKiller_Permission.(BuffResource).xdb" />
				</predicate>
			</Item>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="PortalDispell_Permission.(BuffResource).xdb" />
				</predicate>
			</Item>
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
				<spell href="LaserShot.(SpellSingleTarget).xdb" />
				<duration>1000</duration>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
				<element>LIGHTNING</element>
				<damage>17</damage>
				<scaler type="gameMechanics.elements.scalers.MagicScaler" />
			</Item>
		</targetImpacts>
	</mechanics>
	<speed>25</speed>
	<maxTargets>5</maxTargets>
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>60</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
