<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>188241</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.DeathTrigger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                            <impact type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>10</radius>
                                <affectHolder>false</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="RatStrengthen.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.DirectHeal">
                                        <heal>1</heal>
                                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                <multiplier>0.2</multiplier>
                                            </mulCalcer>
                                        </scalerTarget>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Mechanics/Spells/AstarlIslands/AI71/RatPlague/RatPlague.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    </predicates>
                                </filter>
                            </impact>
                            <count type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                <buff href="RatFood.(BuffResource).xdb" />
                            </count>
                        </Item>
                    </impacts>
                </Item>
            </effects>
        </Item>
    </effects>
    <stackLimit>3</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>