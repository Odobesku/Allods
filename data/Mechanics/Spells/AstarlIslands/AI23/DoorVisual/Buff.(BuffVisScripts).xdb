<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>hit</play>
							<forAnimations>
								<Item>hit</Item>
								<Item>hitCritical</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>hit</play>
							<forAnimations>
								<Item>hit</Item>
								<Item>hitCritical</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
			</Item>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>idle</play>
							<forAnimations>
								<Item>ready</Item>
								<Item>readySpellDirected</Item>
								<Item>readySpellOmni</Item>
								<Item>readyUnarmed</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>idle</play>
							<forAnimations>
								<Item>ready</Item>
								<Item>readySpellDirected</Item>
								<Item>readySpellOmni</Item>
								<Item>readyUnarmed</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
			</Item>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>attack</play>
							<forAnimations>
								<Item>attack</Item>
								<Item>attack01</Item>
								<Item>attack02</Item>
								<Item>attack03</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>attack</play>
							<forAnimations>
								<Item>attack</Item>
								<Item>attack01</Item>
								<Item>attack02</Item>
								<Item>attack03</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
