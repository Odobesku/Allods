<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739951761</resourceId>
    </Header>
    <Name href="Buff00.(BuffResource).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/AstralBarrier.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Priest/Kania.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateDistance">
                    <maxDistToOffender>40</maxDistToOffender>
                </Item>
            </predicates>
            <impacts>
                <targetToOffender>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.PureDamage">
                                <damage>0.35</damage>
                            </Item>
                        </impactsIf>
                    </Item>
                </targetToOffender>
            </impacts>
            <scaleImpactsByDamage>true</scaleImpactsByDamage>
        </Item>
    </effects>
    <duration>6000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>