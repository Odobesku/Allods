<?xml version="1.0" encoding="UTF-8" ?>
<avatarPopulation.service.impl.matchMakingImpl.eventType.stronghold.Pillage>
    <Header>
        <resourceId>239661</resourceId>
    </Header>
    <name href="Pillage.txt" />
    <description href="PillageDescription.txt" />
    <minAvatarLevel type="gameMechanics.formulas.MaxLevelConstant" />
    <minAvatarsCount>0</minAvatarsCount>
    <capacity>6</capacity>
    <keepGroupAfterFinish>false</keepGroupAfterFinish>
    <immediatelyStartFactor>1</immediatelyStartFactor>
    <mark href="Pillagers.xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
    <maps>
        <Item href="BattleEventMapMechanics.xdb#xpointer(/gameMechanics.battleground.BattleEventMapMechanics)" />
    </maps>
    <activeEventJoinPeriod>0</activeEventJoinPeriod>
    <maxVisitsPerDay>0</maxVisitsPerDay>
    <maxVisitsPerWeek>3</maxVisitsPerWeek>
    <joinConditions>
        <Item type="gameMechanics.elements.predicates.PredicateGroupHasNoOfflineMembers" />
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateInRaid" />
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/League.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/Empire.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="StrongholdPunishment.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </predicate>
        </Item>
    </joinConditions>
    <leaderOnly>true</leaderOnly>
    <exclusive>true</exclusive>
    <inviteTimeout>
        <second>30</second>
    </inviteTimeout>
    <delayedInvite>false</delayedInvite>
    <increaseVisitsOnFreeWin>true</increaseVisitsOnFreeWin>
    <acceptStage>Queue</acceptStage>
</avatarPopulation.service.impl.matchMakingImpl.eventType.stronghold.Pillage>