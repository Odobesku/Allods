<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Architect_Swarm_CastImpulsAoe.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<locator>Slot_Global</locator>
						<offset z="1" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionDelay">
				<time>250</time>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureChangeVisItemsAction">
						<removeAllItems>true</removeAllItems>
						<items>
							<Item>
								<slot>BOOTS</slot>
								<newItem href="/Items/VisualItems/Boots/Foot_Plate_E_73BossArchitector.(VisualItem).xdb" />
							</Item>
							<Item>
								<slot>GLOVES</slot>
								<newItem href="/Items/VisualItems/Gloves/Gloves_Plate_E_73BossArchitector.(VisualItem).xdb" />
							</Item>
							<Item>
								<slot>HELM</slot>
								<newItem href="/Items/VisualItems/Helm/Helm_Plate_E_73BossArchitector.(VisualItem).xdb" />
							</Item>
							<Item>
								<slot>MANTLE</slot>
								<newItem href="/Items/VisualItems/Mantle/Shoulder_Plate_E_73BossArchitector.(VisualItem).xdb" />
							</Item>
							<Item>
								<slot>SHIRT</slot>
								<newItem href="/Items/VisualItems/Shirt/Plate_E_73BossArchitectorArmor.(VisualItem).xdb" />
							</Item>
						</items>
					</Item>
					<Item type="CreatureParalyzeAction" />
				</elements>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Architect_Swarm_CastImpulsAoe.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<locator>Slot_Global</locator>
						<offset z="1" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
