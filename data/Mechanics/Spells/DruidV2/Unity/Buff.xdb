<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739873877</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Spells/Mage/MageMeditation.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/BuffVisScripts/InnerRage.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                <coeff>0.05</coeff>
                <calcer type="gameMechanics.elements.calcers.CalcerSum">
                    <summands>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value var="value" />
                        </Item>
                        <Item type="gameMechanics.elements.calcers.ItemQualityCalcer">
                            <dressSlot>AMMO</dressSlot>
                        </Item>
                    </summands>
                </calcer>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.OutgoingHealModifier">
            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                <coeff>0.05</coeff>
                <calcer type="gameMechanics.elements.calcers.CalcerSum">
                    <summands>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value var="value" />
                        </Item>
                        <Item type="gameMechanics.elements.calcers.ItemQualityCalcer">
                            <dressSlot>AMMO</dressSlot>
                        </Item>
                    </summands>
                </calcer>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/DruidV2/Pet/InactiveBuff/Buff_PetPlane.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DirectHeal">
                            <heal>1</heal>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                            </scalerTarget>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.IncrementManaBase">
                            <manaType>Energy</manaType>
                            <factor>1</factor>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/Spells/DruidV2/Pet/InactiveBuff/Buff_PetPlane.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
            <predicate type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                <group href="/Mechanics/Spells/Groups/DruidPetCommand.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            </predicate>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.3</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsToPet">
            <effects>
                <Item type="gameMechanics.elements.effects.AddPlane">
                    <plane href="/Mechanics/Planes/InvisibilityPet.xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
                    <personalPlane>true</personalPlane>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>15000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <ranks>
        <Item href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff03.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
    </ranks>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>