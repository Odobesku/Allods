<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739920289</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/LightningSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
    </groups>
    <element>LIGHTNING</element>
    <Name href="Spell.(SpellSingleTarget).Name.txt" />
    <Description href="Spell.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>MagicScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Mage/MageLightningBallsUpgrade.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mage/LightningBallsUpgrade63.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <level>5</level>
    <prepareDuration>4000</prepareDuration>
    <isWorkOnDead>true</isWorkOnDead>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Mage63/Abilities/ElementalPower/LightningVar.(VariableResource).xdb" />
                <sub>2</sub>
            </Item>
        </casterResources>
        <channelingMechanics>
            <channelingBuff hrefvar="channelingBuff" />
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.EffectsIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                        <ability href="/Mechanics/Spells/Mage63/Abilities/CastChannelOnMove/Ability.(AbilityResource).xdb" />
                    </Item>
                </predicates>
                <effectsIf>
                    <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
                        <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                            <coeff>-0.35</coeff>
                        </effectScaler>
                    </Item>
                </effectsIf>
            </Item>
            <Item type="gameMechanics.elements.effects.EffectsIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                        <ability href="/Mechanics/Spells/Mage63/Abilities/LightningBallsStun/Ability01.(AbilityResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Mage63/Abilities/LightningBallsStun/StunCD.(BuffResource).xdb" />
                        </predicate>
                    </Item>
                </predicates>
                <effectsIf>
                    <Item type="gameMechanics.elements.effects.Switch">
                        <impactsOff>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/Mage63/Abilities/LightningBallsStun/StunCD.(BuffResource).xdb" />
                            </Item>
                        </impactsOff>
                    </Item>
                </effectsIf>
            </Item>
        </casterChannelingEffects>
    </mechanics>
    <speed>20</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>