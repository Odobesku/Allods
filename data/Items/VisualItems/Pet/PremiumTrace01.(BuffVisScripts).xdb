<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.SLON.CreatureVisObjectComponentsAction">
				<member>Default_Member</member>
				<visObjComponents>
					<Item type="client.VisualConstructor.StateComponent">
						<animations>
							<Item>run</Item>
						</animations>
						<component type="client.Scene.AttachedVisObjectComponent">
							<locatorName>Global</locatorName>
							<offset x="0" y="0" z="0.08" />
							<priority>0</priority>
							<rotation x="0" y="0" z="0" w="1" />
							<scale>1</scale>
							<visObject href="/Spells/FX/Spells/PremiumTrace_Step_01All.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
							<isPortraitEnabled>true</isPortraitEnabled>
							<lockScale>false</lockScale>
							<scaleFromGlobal>true</scaleFromGlobal>
							<skipSound>false</skipSound>
						</component>
						<inheritParentAnimationIfHaveNoOwn>false</inheritParentAnimationIfHaveNoOwn>
						<stopForOtherAnimation>true</stopForOtherAnimation>
						<synchronizeAnimationPosition>false</synchronizeAnimationPosition>
						<updateOnlyByFeedBacks>false</updateOnlyByFeedBacks>
					</Item>
				</visObjComponents>
				<stopOnDeath>true</stopOnDeath>
			</Item>
			<Item type="client.SLON.CreatureVisObjectComponentsAction">
				<member>Default_Member</member>
				<visObjComponents>
					<Item type="client.VisualConstructor.StateComponent">
						<animations>
							<Item>walk</Item>
						</animations>
						<component type="client.Scene.AttachedVisObjectComponent">
							<locatorName>Global</locatorName>
							<offset x="0" y="-0.4" z="0.2" />
							<priority>0</priority>
							<rotation x="0" y="0" z="0" w="1" />
							<scale>1</scale>
							<visObject href="/Spells/FX/Spells/PremiumTrace_Step_01All.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
							<isPortraitEnabled>true</isPortraitEnabled>
							<lockScale>false</lockScale>
							<scaleFromGlobal>false</scaleFromGlobal>
							<skipSound>false</skipSound>
						</component>
						<inheritParentAnimationIfHaveNoOwn>false</inheritParentAnimationIfHaveNoOwn>
						<stopForOtherAnimation>true</stopForOtherAnimation>
						<synchronizeAnimationPosition>false</synchronizeAnimationPosition>
						<updateOnlyByFeedBacks>false</updateOnlyByFeedBacks>
					</Item>
				</visObjComponents>
				<stopOnDeath>true</stopOnDeath>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>