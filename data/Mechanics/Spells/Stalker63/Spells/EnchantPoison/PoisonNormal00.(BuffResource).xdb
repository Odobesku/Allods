<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739931719</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="PoisonNormal00.(BuffResource).Name.txt" />
    <Description href="PoisonNormal00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Potions/Poison04.chn.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <tickLength>1000</tickLength>
                <damagePerTick>1</damagePerTick>
                <impactsPerTick>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="/Mechanics/Spells/Stalker63/Abilities/PoisonDmgTargetingCD/PoisonHit.(MarkResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impactsPerTick>
                <affectedByDoubleAttack>true</affectedByDoubleAttack>
            </parameters>
            <element>POISON</element>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="calcerDamage" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.WeaponScaler">
                        <source>Ranged</source>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectStackChangeTrigger">
            <impactsOnIncrease>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="HiddenPoisonedStatus.(BuffResource).xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer href="CalcerDurationNormal.(CalcerFloatResource).xdb" />
                        </mulCalcer>
                    </durationScaler>
                </Item>
            </impactsOnIncrease>
        </Item>
    </effects>
    <duration>1000</duration>
    <stackLimit>6</stackLimit>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="PoisonNormal01.(BuffResource).xdb" />
        <Item href="PoisonNormal02.(BuffResource).xdb" />
        <Item href="PoisonNormal03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Poisons.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>