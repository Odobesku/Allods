<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.CreatureAttachSelfAction">
		<attachTo>Caster</attachTo>
		<locatorName>Slot_Belt</locatorName>
		<playAttachTo type="client.Replica.VisActionList">
			<elements>
				<Item type="client.Replica.CreatureDisableSpecialIdlesAction" />
				<Item type="client.Replica.CreatureReplaceAnimationsAction">
					<member>Default_Member</member>
					<onBottom>
						<animationsReplacements>
							<Item>
								<forAnimations>
									<Item>run</Item>
									<Item>drinkIdle01</Item>
								</forAnimations>
								<play>emoteHoldRun</play>
							</Item>
							<Item>
								<forAnimations>
									<Item>idle</Item>
									<Item>drinkIdle01</Item>
									<Item>hit</Item>
									<Item>hitCritical</Item>
									<Item>emoteGreeting</Item>
									<Item>emoteSpeech</Item>
									<Item>emoteCurtsey</Item>
								</forAnimations>
								<play>special04</play>
							</Item>
						</animationsReplacements>
						<notReplacedanimations>
							<Item>emoteHoldEnd</Item>
							<Item>emoteHoldStart</Item>
							<Item>walk</Item>
							<Item>walkBackwards</Item>
							<Item>shuffleLeft</Item>
							<Item>shuffleRight</Item>
							<Item>jump</Item>
							<Item>jumpStart</Item>
							<Item>jumpEnd</Item>
							<Item>jumpLandRun</Item>
						</notReplacedanimations>
						<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
					</onBottom>
					<onMount>
						<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
					</onMount>
					<onTop>
						<animationsReplacements>
							<Item>
								<forAnimations>
									<Item>idle</Item>
									<Item>walk</Item>
									<Item>walkBackwards</Item>
									<Item>shuffleLeft</Item>
									<Item>shuffleRight</Item>
									<Item>mountRideIdle</Item>
									<Item>mountRideSpecialJump</Item>
									<Item>mountSitIdle</Item>
									<Item>mountSitSpecialJump</Item>
									<Item>mountBikeLevelUp</Item>
									<Item>mountBikeLevelUp01</Item>
									<Item>mountBikeLevelUp02</Item>
									<Item>mountBikeIdle01</Item>
									<Item>mountBikeIdle</Item>
									<Item>mountBikeIdle02</Item>
									<Item>mountJetIdle</Item>
									<Item>mountJetIdle01</Item>
									<Item>mountJetIdle02</Item>
									<Item>mountJetSpecialJump</Item>
									<Item>mountJetLevelUp</Item>
									<Item>mountJetWalkBackwards</Item>
									<Item>mountCarpetIdle</Item>
									<Item>mountCarpetIdle01</Item>
									<Item>mountCarpetIdle02</Item>
									<Item>mountCarpetSpecialJump</Item>
									<Item>mountCarpetLevelUp</Item>
									<Item>mountCarpetWalkBackwards</Item>
									<Item>drinkIdle01</Item>
									<Item>mountRideLevelUp</Item>
									<Item>jumpEnd</Item>
									<Item>hit</Item>
									<Item>hitCritical</Item>
									<Item>emoteGreeting</Item>
									<Item>emoteSpeech</Item>
									<Item>emoteCurtsey</Item>
								</forAnimations>
								<play>special04</play>
							</Item>
							<Item>
								<forAnimations>
									<Item>mountJetRun</Item>
									<Item>mountJetRun01</Item>
									<Item>mountJetRun02</Item>
									<Item>mountCarpetRun</Item>
									<Item>mountCarpetRun01</Item>
									<Item>mountCarpetRun02</Item>
									<Item>run</Item>
									<Item>runSpellCharged</Item>
									<Item>drinkIdle01</Item>
									<Item>mountRideLevelUp</Item>
									<Item>jumpEnd</Item>
								</forAnimations>
								<play>emoteHoldRun</play>
							</Item>
						</animationsReplacements>
						<notReplacedanimations>
							<Item>emoteHoldEnd</Item>
							<Item>emoteHoldStart</Item>
						</notReplacedanimations>
						<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
					</onTop>
					<priority href="/Client/Priorieties/CreatureReplaceAnimationsAction/TakeOnHands.(PriorityResource).xdb#xpointer(/PriorityResource)" />
					<replaceWhen>ReplaceAlways</replaceWhen>
					<restartOnVisualChange>false</restartOnVisualChange>
				</Item>
				<Item type="client.Replica.CreatureAnimationAction">
					<advanced>
						<autoHasten>
							<mode>AUTOHASTEN_NONE</mode>
							<timeToBeLeft>0</timeToBeLeft>
						</autoHasten>
						<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
						<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
						<offendType>NO_OFFEND</offendType>
						<speed>0</speed>
						<turnToTarget>TURN_DEFAULT</turnToTarget>
						<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
						<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
						<denyAutoHasten>false</denyAutoHasten>
						<disableRandomFirstFrame>true</disableRandomFirstFrame>
						<eventPlaybackEnd>false</eventPlaybackEnd>
						<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
						<stopIfMoved>false</stopIfMoved>
						<stopIfRotated>false</stopIfRotated>
					</advanced>
					<animations>
						<Item>emoteHoldStart</Item>
					</animations>
					<channel>CHANNEL_BUFF</channel>
					<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
					<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
					<mode>DIE</mode>
					<use>USE_ANIMATIONS</use>
					<dontFreezePrecast>false</dontFreezePrecast>
				</Item>
				<Item type="client.SLON.CreatureDisableEmotesAction" />
				<Item type="client.Replica.CreatureSetAnimationPropertiesAction">
					<animationProperties href="/Spells/BuffVisScripts/HoldedMountNoTurn.(AnimationProperties).xdb#xpointer(/AnimationProperties)" />
					<useOn>Mount</useOn>
				</Item>
			</elements>
			<play>Simultaneously</play>
			<preconditional>false</preconditional>
			<restartOnVisualChange>false</restartOnVisualChange>
			<stopOnDeath>false</stopOnDeath>
			<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
		</playAttachTo>
		<playAttachToWhenStopped type="client.Replica.VisActionList">
			<elements>
				<Item type="client.Replica.CreatureAnimationAction">
					<advanced>
						<autoHasten>
							<mode>AUTOHASTEN_NONE</mode>
							<timeToBeLeft>0</timeToBeLeft>
						</autoHasten>
						<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
						<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
						<offendType>NO_OFFEND</offendType>
						<speed>0</speed>
						<turnToTarget>TURN_DEFAULT</turnToTarget>
						<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
						<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
						<denyAutoHasten>false</denyAutoHasten>
						<disableRandomFirstFrame>true</disableRandomFirstFrame>
						<eventPlaybackEnd>false</eventPlaybackEnd>
						<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
						<stopIfMoved>false</stopIfMoved>
						<stopIfRotated>false</stopIfRotated>
					</advanced>
					<animations>
						<Item>emoteHoldEnd</Item>
					</animations>
					<channel>CHANNEL_EMOTE</channel>
					<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
					<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
					<mode>DIE</mode>
					<use>USE_ANIMATIONS</use>
					<dontFreezePrecast>false</dontFreezePrecast>
				</Item>
			</elements>
			<play>InSequence</play>
			<preconditional>false</preconditional>
			<restartOnVisualChange>false</restartOnVisualChange>
			<stopOnDeath>false</stopOnDeath>
			<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
		</playAttachToWhenStopped>
		<playOnSelf type="client.Replica.VisActionList">
			<elements>
				<Item type="client.Replica.CreatureDisableSpecialIdlesAction" />
				<Item type="client.Replica.CreatureAnimationAction">
					<advanced>
						<autoHasten>
							<mode>AUTOHASTEN_NONE</mode>
							<timeToBeLeft>0</timeToBeLeft>
						</autoHasten>
						<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
						<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
						<offendType>NO_OFFEND</offendType>
						<speed>0</speed>
						<turnToTarget>TURN_DEFAULT</turnToTarget>
						<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
						<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
						<denyAutoHasten>false</denyAutoHasten>
						<disableRandomFirstFrame>true</disableRandomFirstFrame>
						<eventPlaybackEnd>false</eventPlaybackEnd>
						<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
						<stopIfMoved>false</stopIfMoved>
						<stopIfRotated>false</stopIfRotated>
					</advanced>
					<animations>
						<Item>special04</Item>
					</animations>
					<channel>CHANNEL_KNOCKDOWN</channel>
					<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
					<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
					<mode>LOOP</mode>
					<use>USE_ANIMATIONS</use>
					<dontFreezePrecast>false</dontFreezePrecast>
				</Item>
				<Item type="client.SLON.CreatureDisableEmotesAction" />
			</elements>
			<play>Simultaneously</play>
			<preconditional>false</preconditional>
			<restartOnVisualChange>false</restartOnVisualChange>
			<stopOnDeath>false</stopOnDeath>
			<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
		</playOnSelf>
		<playOnSelfWhenStopped type="client.Replica.VisActionList">
			<elements>
				<Item type="client.Replica.CreatureAnimationAction">
					<advanced>
						<autoHasten>
							<mode>AUTOHASTEN_NONE</mode>
							<timeToBeLeft>0</timeToBeLeft>
						</autoHasten>
						<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
						<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
						<offendType>NO_OFFEND</offendType>
						<speed>0</speed>
						<turnToTarget>TURN_DEFAULT</turnToTarget>
						<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
						<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
						<denyAutoHasten>false</denyAutoHasten>
						<disableRandomFirstFrame>true</disableRandomFirstFrame>
						<eventPlaybackEnd>false</eventPlaybackEnd>
						<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
						<stopIfMoved>false</stopIfMoved>
						<stopIfRotated>false</stopIfRotated>
					</advanced>
					<animations>
						<Item>emoteHoldedEnd</Item>
					</animations>
					<channel>CHANNEL_EMOTE</channel>
					<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
					<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
					<mode>DIE</mode>
					<use>USE_ANIMATIONS</use>
					<dontFreezePrecast>false</dontFreezePrecast>
				</Item>
			</elements>
			<play>InSequence</play>
			<preconditional>false</preconditional>
			<restartOnVisualChange>false</restartOnVisualChange>
			<stopOnDeath>false</stopOnDeath>
			<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
		</playOnSelfWhenStopped>
		<notifyCamera>true</notifyCamera>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>