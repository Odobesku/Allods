<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>490369</resourceId>
    </Header>
    <Name href="UI02_Mushroom.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateDeviceNear">
                <radius>5</radius>
                <devices>
                    <Item href="Kettle.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
                </devices>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateHasItemsCount">
                <items>
                    <Item href="/Items/InteractiveObjects/UmoirIsland02/UI02_Mushroom.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                </items>
                <totalCount>15</totalCount>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <status>Active</status>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                <quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <counterResource href="/World/Quests/UmoirIsland02/UI02_Q04/Counter02.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                <spawn>
                    <scriptID>Koschey</scriptID>
                    <map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                </spawn>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="UI02_Mushroom.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
                                        <item href="/Items/InteractiveObjects/UmoirIsland02/UI02_Mushroom.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                        <count>15</count>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                                        <quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                        <counterResource href="/Items/InteractiveObjects/UmoirIsland02/UI02_Mushroom.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                        <id href="/World/Quests/UmoirIsland02/UI02_Q04/Bones.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="UI02_Mushroom.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="Mushroom_Success.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                <spawn>
                                    <scriptID>Kettle</scriptID>
                                    <map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                </spawn>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                                        <visualState>4</visualState>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="Mushroom_Fail.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                        </impactsElse>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>