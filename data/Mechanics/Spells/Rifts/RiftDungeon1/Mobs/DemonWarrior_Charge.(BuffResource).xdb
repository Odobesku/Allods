<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>208198</resourceId>
    </Header>
    <Name href="DemonWarrior_Charge.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorCharge.(UISingleTexture).xdb" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectForcePull">
            <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
            <impactsOnArrived>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="DemonWarrior_Charge.(BuffResource).xdb" />
                </Item>
            </impactsOnArrived>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>All</affectGroup>
            <radius>4</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                    <time>500</time>
                    <impactsOnLand>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                        </Item>
                    </impactsOnLand>
                    <distance>6</distance>
                </Item>
                <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                    <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                    <minDamage>30</minDamage>
                    <maxDamage>30</maxDamage>
                </Item>
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>2</coeff>
            </effectScaler>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>