<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/Engineer_Flamethrower.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                        <scale>2</scale>
                        <fadeInTime>200</fadeInTime>
                        <fadeOutTime>400</fadeOutTime>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>specialCast</Item>
                </animations>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>