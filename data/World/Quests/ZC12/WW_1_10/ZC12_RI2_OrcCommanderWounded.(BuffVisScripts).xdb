<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>DIE</mode>
						<animations>
							<Item>knockdownStart</Item>
						</animations>
						<channel>CHANNEL_HIT</channel>
						<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
						<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>knockdownLoop</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
						<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
						<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Stun.(VisObjectTemplate).xdb" />
						<locator>Head</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
</BuffVisScripts>