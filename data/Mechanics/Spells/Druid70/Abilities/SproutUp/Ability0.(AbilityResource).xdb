<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>214451</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="buff_duration" />
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>FormulaSeconds</formula>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>-1</multiplier>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value var="coeff" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>crit</name>
            <value var="crit" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Special/Alchemy/Nature.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffDurationModifier">
            <buffs>
                <Item href="/Mechanics/Spells/Druid70/Spells/Sprout/WaitBuff01.(BuffResource).xdb" />
            </buffs>
            <summand type="gameMechanics.elements.calcers.FloatData">
                <value var="buff_duration" />
            </summand>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Druid70/Spells/Sprout/WaitBuff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellsModifier">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Druid70/Spells/Sprout/Spell01.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </predicates>
                    <modifiers>
                        <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                            <effects>
                                <Item type="gameMechanics.elements.effects.OutgoingHealModifier">
                                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                        <coeff var="coeff" />
                                    </scaler>
                                </Item>
                            </effects>
                            <onBehalfOfHolder>true</onBehalfOfHolder>
                        </Item>
                    </modifiers>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.OutgoingCritChanceSummand">
            <impactProducer href="/Mechanics/Spells/Druid70/Spells/Sprout/Spell01.(SpellSingleTarget).xdb" />
            <summand var="crit" />
        </Item>
        <Item type="gameMechanics.elements.effects.OutgoingCritChanceSummand">
            <impactProducer href="/Mechanics/Spells/Druid70/Spells/Sprout/WaitBuff01.(BuffResource).xdb" />
            <summand var="crit" />
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>