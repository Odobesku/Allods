<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
	<Header>
		<resourceId>739904700</resourceId>
	</Header>
	<persistentParts>
		<Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.TickableEntityAura">
					<affectGroup>All</affectGroup>
					<radius>2.5</radius>
					<filter type="gameMechanics.constructor.basicElements.FilterAnd">
						<filters>
							<Item type="gameMechanics.world.creature.AvatarFilter" />
							<Item type="gameMechanics.world.creature.AliveFilter" />
						</filters>
					</filter>
					<impactsIn>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Obj_Candle_ContextAction.(BuffResource).xdb" />
						</Item>
					</impactsIn>
					<impactsOut>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Obj_Candle_ContextAction.(BuffResource).xdb" />
						</Item>
					</impactsOut>
				</Item>
			</effects>
			<reattachOnTeleport>false</reattachOnTeleport>
		</Item>
	</persistentParts>
	<name href="Obj_Candle.(SteleResource).Name.txt" />
	<visObj href="/World/Races/Kania/Furniture/Models/VillageHall_Furniture/Kania_Candle_Table_01.(VisObjectTemplate).xdb" />
	<collision href="/World/Races/Kania/Furniture/Models/VillageHall_Furniture/Kania_Candle_Table_01.(Collision).xdb" />
	<corpseDuration>3000</corpseDuration>
	<corpseEmptyDuration>1200</corpseEmptyDuration>
</gameMechanics.world.device.SteleResource>
