<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739924009</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Ability0.(AbilityResource).Name.txt" />
    <Description href="Buff0.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/ChainLightning.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectStackChangeTrigger">
            <impactsOnDecrease>
                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>LIGHTNING</element>
                            <damage>1</damage>
                            <impactsOnHitCaster>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="/Mechanics/Spells/Druid70/Abilities/ElementRage/ElementalRage.(MarkResource).xdb" />
                                </Item>
                            </impactsOnHitCaster>
                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                            <externalCalcer hrefvar="externalCalcer" />
                                        </mulCalcer>
                                        <additionalMultiplier>
                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                        </additionalMultiplier>
                                    </Item>
                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mul>0.002</mul>
                                        <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                            <stat type="gameMechanics.elements.stat.SpecialStat">
                                                <stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
                                            </stat>
                                            <valueType>ShortTerm</valueType>
                                        </mulCalcer>
                                        <sum>1.5</sum>
                                    </Item>
                                </scalers>
                            </scaler>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnDecrease>
        </Item>
    </effects>
    <duration>20000</duration>
    <stackLimit>2</stackLimit>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>