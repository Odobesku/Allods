<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>222865</resourceId>
    </Header>
    <visObject href="/Spells/FX/Mobs/General_HealerGlobe_End.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>3000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>250</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.EntityImpactEntitiesAround">
                            <radius>0.5</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
