<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureReplaceAnimationAction">
				<action>RUN</action>
				<newAnimation>walk</newAnimation>
			</Item>
			<Item type="CreatureReplaceAnimationAction">
				<action>RUN_SPECIAL</action>
				<newAnimation>walk</newAnimation>
			</Item>
			<Item type="CreatureAnimationSetSpeedAction">
				<channel>CHANNEL_MOVE</channel>
				<speed>3</speed>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
