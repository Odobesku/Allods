<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739975651</resourceId>
	</Header>
	<visScript href="Cinematic_for_Avatar.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="/Maps/ZC12/GlobalObjects/GameViewScenes/Guerrila_Plane.(Plane).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="R7_invansion_Boss_Animation.(BuffResource).xdb" />
						</Item>
					</impacts>
					<spawnResource href="/Mechanics/RaidInstances/ArchBaseRaid/InvasionBoss/R7_invansion_Boss.(SpawnTable).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="R7_invansion_Boss_Animation.(BuffResource).xdb" />
						</Item>
					</impacts>
					<spawnResource href="/Mechanics/RaidInstances/ArchBaseRaid/InvasionBoss/R7_invansion_Boss_HM.(SpawnTable).xdb" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>10000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactClientData">
							<data href="R7_Veronica_Animation.(ClientData).xdb" />
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
	</effects>
	<duration>15000</duration>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/RaidInstances/ArchBaseRaid/SiegeBoss/R7_ArchBase_Raid.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
