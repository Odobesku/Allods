<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739921919</resourceId>
    </Header>
    <visScript href="DemonBoss02_Vanish.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="DemonBoss02_Vanish.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                            <spell href="DemonBoss02_Appear.(SpellArea).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                            <spell href="DemonBoss02_AE.(SpellArea).xdb" />
                            <duration>4000</duration>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="DemonBoss02_Vanish.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="DemonBoss02_Appear.(SpellArea).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Start</Item>
            </stages>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftAutoattack.(ActionGroup).xdb" />
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>