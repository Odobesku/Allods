			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
				<quest href="/World/Quests/ElementalPlateu/Snow/Spider_Nest.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
				<status>Started</status>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
				<zone href="/Maps/ElementalPlateu/ScriptZones/Spider_Nest_Rule.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
				<projectileData>
					<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
						<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
					</moveType>
					<resource href="/World/Quests/ElementalPlateu/Snow/Arcane_Sphere.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
				</projectileData>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
						<predicates>
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="/Items/InteractiveObjects/ElementalPlateu/Spider_Nest/Spider_Nest_Succes.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</predicates>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactSummon">
								<destination type="gameMechanics.map.destination.RelativeRotatePos">
									<base type="gameMechanics.map.destination.SelfPosDestination" />
									<offset>1</offset>
								</destination>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
										<delay>30000</delay>
										<impacts>
											<Item type="gameMechanics.elements.impacts.Disintegrate" />
										</impacts>
									</Item>
								</impacts>
								<object href="/Items/InteractiveObjects/ElementalPlateu/Shining_Shard/Shining_Shard.(ChestResource).xdb#xpointer(/gameMechanics.world.device.ChestResource)" />
							</Item>
						</impacts>
						<elseImpacts>
							<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
								<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
									<value>0.3</value>
								</chanceCalcer>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactSummon">
										<destination type="gameMechanics.map.destination.RelativeRotatePos">
											<base type="gameMechanics.map.destination.SelfPosDestination" />
											<offset>1</offset>
										</destination>
										<object href="/Creatures/BlackWidow/Instances/ElementalPlateu/BlackWidow_EP_quest.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									</Item>
								</impacts>
							</Item>
						</elseImpacts>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
		<targetImpacts>
