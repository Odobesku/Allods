<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>186175</resourceId>
    </Header>
    <Name href="ReflectDamage.(BuffResource).Name.txt" />
    <Description href="ReflectDamage.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/ReflectDemedzh.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="ReflectDamage.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <nameTemplate href="ReflectDamage.(BuffResource).Name.txt" />
    <descTemplate href="ReflectDamage.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>1500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                            <spell href="StrengthenSelf.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateDistance">
                    <maxDistToOffender>85</maxDistToOffender>
                </Item>
                <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.offender.PredicateOffenderIsOwner" />
                </Item>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
            </predicates>
            <impacts>
                <targetToOffender>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ACID</element>
                        <damage>15</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="/Spells/ClientData/HitAstral.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </targetToOffender>
            </impacts>
        </Item>
    </effects>
    <duration>6000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ProtectionBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>