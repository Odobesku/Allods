<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>186964</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <conditionsIn>
        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
    </conditionsIn>
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
            <spawn>
                <scriptID>PoisonTrap</scriptID>
                <map href="/Maps/AstralIsle19/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
            </spawn>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                    <visualState>2</visualState>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactDisableScriptZoneTemporarily">
            <zone href="PoisonTrap.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
            <period>10000</period>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
            <phantom href="/Characters/Undead_male/Instances/AstralIsle19/ZemPoisonMaster.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/AstarlIslands/AI19/SpecialBuffs/Poisoning.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impacts>
        </Item>
    </impactsIn>
</gameMechanics.map.scriptZone.ScriptZone>