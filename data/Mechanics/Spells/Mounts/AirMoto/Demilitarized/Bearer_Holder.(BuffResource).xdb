<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739965843</resourceId>
    </Header>
    <image href="/Interface/Icons/Spells/WornHands.(UISingleTexture).xdb" />
    <visualEffects />
    <visualPostEffects />
    <visualEffectsIncCount />
    <visualEffectsDecCount />
    <needVisualize>false</needVisualize>
    <uiComponents />
    <descVars />
    <gainSpells />
    <effects>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/Transformation.(ActionGroup).xdb" />
                    </groups>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectBearer" />
        <Item type="gameMechanics.elements.effects.DamageThreshold">
            <healthScalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>0.5</mul>
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer href="/Mechanics/GameRoot/Mount/MountHealthCalcer.(CalcerFloatResource).xdb" />
                </mulCalcer>
            </healthScalerTarget>
            <outOfCombatPolicy>Nothing</outOfCombatPolicy>
            <ownerDamageFactor type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </ownerDamageFactor>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateOnAddressee">
                            <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateTrue" />
                            </predicates>
                            <assertOnCantFind>false</assertOnCantFind>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                    <data href="/Mechanics/Spells/Mounts/AirMoto/Repair/NeedRepair.(ClientData).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                    <impactsElse />
                </Item>
            </impacts>
            <resource href="/Mechanics/GameRoot/Mount/MountDamageThreshold.xdb" />
            <damageType>Damage</damageType>
            <priority>HarmfulLimitedDamageAbsorber</priority>
            <damagePredicates />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn />
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateOnAddressee">
                            <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateTrue" />
                            </predicates>
                            <assertOnCantFind>false</assertOnCantFind>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Burden_Passenger.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Burden_PassengerTemp.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                    <impactsElse />
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks />
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/BearingBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>