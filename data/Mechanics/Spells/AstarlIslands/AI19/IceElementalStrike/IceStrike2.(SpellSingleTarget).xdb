<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739880632</resourceId>
	</Header>
	<Name href="IceStrike2.(SpellSingleTarget).Name.txt" />
	<visualScripts href="StrikeVis.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>20</value>
	</range>
	<prepareDuration>5000</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>20000</duration>
		</cooldown>
		<channelingMechanics>
			<channelingBuff href="StrikeTarget.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			<finishImpacts>
				<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
					<element>COLD</element>
					<damage>40</damage>
					<scaler type="gameMechanics.elements.scalers.MagicScaler" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>6</radius>
					<affectGroup>Enemies</affectGroup>
					<affectHolder>false</affectHolder>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>COLD</element>
							<damage>100</damage>
							<scaler type="gameMechanics.elements.scalers.MagicScaler" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
									<buff href="/Mechanics/Spells/AstarlIslands/AI19/IceBlizzard/BlizzardDebuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									<range>
										<min>5</min>
										<max>5</max>
									</range>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactKill" />
							</impactsIf>
						</Item>
					</impacts>
					<filter type="gameMechanics.constructor.basicElements.FilterOr">
						<filters>
							<Item type="gameMechanics.world.creature.AvatarFilter" />
							<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									</Item>
								</predicates>
							</Item>
						</filters>
					</filter>
				</Item>
			</finishImpacts>
		</channelingMechanics>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
				<delay>5000</delay>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
						<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
						<data href="HitEffect.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					</Item>
				</impacts>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
