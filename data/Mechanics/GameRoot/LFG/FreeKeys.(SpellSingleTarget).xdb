    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <needInFront>false</needInFront>
    <mechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateGreater">
                                <lhs type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
                                    <currency href="/Items/HighEnd7/Boxes/FreeKeys.(AlternativeCurrency).xdb" />
                                </lhs>
                                <rhs type="gameMechanics.elements.calcers.FloatData">
                                    <value>0</value>
                                </rhs>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/BestFriends/SelfdenyingHelp_Buff01.xdb" />
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                        <buff href="/Mechanics/Spells/BestFriends/SelfdenyingHelp_Buff01.xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                                        <currency href="/Items/HighEnd7/Boxes/FreeKeys.(AlternativeCurrency).xdb" />
                                        <sumCalcer type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
                                            <currency href="/Items/HighEnd7/Boxes/FreeKeys.(AlternativeCurrency).xdb" />
                                        </sumCalcer>
                                        <multiplier>-1</multiplier>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                                <currency href="/Items/HighEnd7/Boxes/FreeKeys.(AlternativeCurrency).xdb" />
                                <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                                    <value>1</value>
                                </sumCalcer>
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/BestFriends/SelfdenyingHelp_Buff01.xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/ItemMall/AstralLootMultiplier/AstralLootMultiplier_v7_x2.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/ItemMall/AstralLootMultiplier/AstralLootMultiplier_v7_x3.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/ItemMall/AstralLootMultiplier/AstralLootMultiplier_v7_x4.(BuffResource).xdb" />
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                        <data href="FreeKeysMult.(ClientData).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
