<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.UsableDeviceResource>
    <Header>
        <resourceId>488491</resourceId>
    </Header>
    <parts>
        <Item type="InteractionAnimationPart">
            <interactionStartAction type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>useStandingStart</Item>
                    <Item>useStandingLoop</Item>
                </animations>
            </interactionStartAction>
            <interactionEndAction type="CreatureAnimationAction">
                <animations>
                    <Item>useStandingEnd</Item>
                </animations>
            </interactionEndAction>
        </Item>
    </parts>
    <persistentParts>
        <Item type="gameMechanics.world.cellReplication.MapWideReplicated" />
        <Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
            <effects>
                <Item type="gameMechanics.world.device.parts.ImpactsOnUserGeneric">
                    <userImpactsOnStartUse>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="MWRaid_Cannon01.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.world.device.AddresseeFinderUsingDevice" />
                            <impacts>
                                <Item type="gameMechanics.elements.bunchImpacts.ImpactCopyIFF" />
                            </impacts>
                        </Item>
                    </userImpactsOnStartUse>
                    <userImpactsOnFinishUse>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="MWRaid_Cannon01.(BuffResource).xdb" />
                            <anyRank>false</anyRank>
                        </Item>
                    </userImpactsOnFinishUse>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.world.entity.EntityZoneTrackerResource">
            <trackData href="/Interface/TrackData/MWCannon.(TrackDataResource).xdb" />
        </Item>
    </persistentParts>
    <name href="MWRaid_Cannon01.(UsableDeviceResource).Name.txt" />
    <corpulence>2</corpulence>
    <visObj href="/World/Races/Hadagan/Environment/Models/Hadagan_Ballista/Hadagan_Ballista_BG2.(VisObjectTemplate).xdb" />
    <collisionObject>true</collisionObject>
    <interactiveObject>true</interactiveObject>
    <exploitingText href="MWRaid_Cannon01.(UsableDeviceResource).ExploitingText.txt" />
    <spell href="MWRaid_Cannon01.(Exploit).xdb" />
    <viewSight>
        <isBinding>true</isBinding>
        <position y="-50" z="30" />
        <rotation y="0.35" />
        <distance>0.1</distance>
        <camera href="/Items/InteractiveObjects/Domination/BG_Cannon01/ObjectCameraSettings01.(ObjectCameraSettings).xdb" />
    </viewSight>
    <deviceSpells>
        <Item href="MWRaid_Cannon01.(SpellArea).xdb" />
    </deviceSpells>
    <castFromAvatar>true</castFromAvatar>
</gameMechanics.world.device.UsableDeviceResource>