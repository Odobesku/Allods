<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739940335</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="DoT.(BuffResource).Name.txt" />
    <Description href="DoT.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Bard/ExtraAttackOnDancingSword.(UISingleTexture).xdb" />
    <visScript href="/Spells/BuffVisScripts/DotBlood.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.NotStackableEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.PhysicalDoT">
                    <parameters>
                        <scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                            <buff href="DoT03.(BuffResource).xdb" />
                            <anyRank>true</anyRank>
                            <onlyFromMaster>true</onlyFromMaster>
                            <mul>0.1</mul>
                            <sum>1</sum>
                        </scalerTarget>
                        <scaleOnTick>true</scaleOnTick>
                        <tickLength>1000</tickLength>
                        <damagePerTick>1</damagePerTick>
                        <affectOnStartTick>true</affectOnStartTick>
                        <affectedByDoubleAttack>true</affectedByDoubleAttack>
                    </parameters>
                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                        <scalers>
                            <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                            <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="externalCalcer" />
                                </mulCalcer>
                            </Item>
                        </scalers>
                    </scaler>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>3000</duration>
    <stackLimit>4</stackLimit>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="DoT01.(BuffResource).xdb" />
        <Item href="DoT02.(BuffResource).xdb" />
        <Item href="DoT03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/BardEtude.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>