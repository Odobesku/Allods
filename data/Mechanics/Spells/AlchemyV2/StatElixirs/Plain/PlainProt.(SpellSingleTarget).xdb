	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/BuffConsumables.xdb" />
		<Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
	</groups>
	<visualScripts href="/Spells/VisScripts/Items/PotionLesserStrength.(SpellVisScripts).xdb" />
	<nameTemplate href="PlainProt.(SpellSingleTarget).NameTemplate.txt" />
	<descTemplate href="PlainProt.(SpellSingleTarget).DescTemplate.txt" />
	<targetType>STTSelf</targetType>
	<isAggro>false</isAggro>
	<ranks>
		<Item href="Plain1.(SpellSingleTarget).xdb" />
		<Item href="Plain2.(SpellSingleTarget).xdb" />
		<Item href="Plain3.(SpellSingleTarget).xdb" />
		<Item href="Plain4.(SpellSingleTarget).xdb" />
		<Item href="Plain5.(SpellSingleTarget).xdb" />
		<Item href="Plain6.(SpellSingleTarget).xdb" />
		<Item href="Plain7.(SpellSingleTarget).xdb" />
		<Item href="Plain8.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<mechanics>
		<conditions>
			<Item type="gameMechanics.elements.predicates.PredicateCanAttachBuff">
				<buff hrefvar="buff" />
			</Item>
		</conditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceActiveItem" />
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
						<hideText>true</hideText>
						<minLevel type="gameMechanics.formulas.IntConstantValue">
							<value var="value2" />
						</minLevel>
					</Item>
				</predicates>
				<impacts>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="/Mechanics/Spells/AlchemyV2/StatElixirs/ToHighLvl.(BuffResource).xdb" />
					</Item>
				</impacts>
				<elseImpacts>
					<Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
						<group href="/Mechanics/Spells/Groups/BuffConsumables.xdb" />
					</Item>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff hrefvar="buff" />
					</Item>
				</elseImpacts>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
