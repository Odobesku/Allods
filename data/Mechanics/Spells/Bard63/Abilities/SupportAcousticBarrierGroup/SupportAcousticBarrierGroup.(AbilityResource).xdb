<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739948087</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="SupportAcousticBarrierGroup.(AbilityResource).Name.txt" />
	<description href="SupportAcousticBarrierGroup.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>FormulaPercent</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
		<Item>
			<name>cd</name>
			<value var="cd" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercentAbsMinus1</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Modifiers/ResistanceAstral.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.BuffExtraEffects">
					<buffs>
						<Item href="/Mechanics/Spells/Bard63/Spells/DefensiveBarrier/DefensiveBarrier01.(BuffResource).xdb" />
						<Item href="/Mechanics/Spells/Bard63/Spells/AcousticBarrier/AcousticBarrier01.(BuffResource).xdb" />
					</buffs>
					<effects>
						<Item type="gameMechanics.elements.effects.Switch">
							<impactsOn>
								<Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
									<radius>40</radius>
									<affectPets>false</affectPets>
									<excludeCaster>true</excludeCaster>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff hrefvar="buff" />
										</Item>
									</impacts>
								</Item>
							</impactsOn>
						</Item>
					</effects>
				</Item>
				<Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
					<spell href="/Mechanics/Spells/Bard63/Spells/DefensiveBarrier/DefensiveBarrier03.(SpellSingleTarget).xdb" />
					<factor var="cd" />
				</Item>
				<Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
					<spell href="/Mechanics/Spells/Bard63/Spells/AcousticBarrier/AcousticBarrier03.(SpellSingleTarget).xdb" />
					<factor var="cd" />
