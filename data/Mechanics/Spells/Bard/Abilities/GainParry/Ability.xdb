<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>197530</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Spells/Bard/GainParry.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Ability_Name.txt.template" />
    <descTemplate href="Ability_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffInterceptor">
            <impactsOnAttach>
                <Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
                    <spell href="/Mechanics/Spells/Bard/MassDissonance/Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                    <factor type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>1</multiplier>
                    </factor>
                    <sum type="gameMechanics.elements.calcers.LongData">
                        <value var="value" />
                    </sum>
                    <canStartCooldown>false</canStartCooldown>
                </Item>
            </impactsOnAttach>
            <forceAttachBuff>true</forceAttachBuff>
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                    </groups>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.EffectNull"></Item>
    </effects>
    <majorEffect>-1</majorEffect>
    <level>1</level>
    <ranks>
        <Item href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability02.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability03.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
    <disableWhileDead>false</disableWhileDead>
    <saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>