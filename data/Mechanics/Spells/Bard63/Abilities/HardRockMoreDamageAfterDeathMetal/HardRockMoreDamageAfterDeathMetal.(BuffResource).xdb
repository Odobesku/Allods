<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>215009</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="HardRockMoreDamageAfterDeathMetal.(BuffResource).Name.txt" />
    <Description href="HardRockMoreDamageAfterDeathMetal.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Bard/LessDancingSwordCD.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                    <spells>
                        <Item href="/Mechanics/Spells/Bard63/Spells/HardRock/HardRock01.(SpellSingleTarget).xdb" />
                    </spells>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                <coeff>1</coeff>
                                <calcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="externalCalcer" />
                                </calcer>
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>400</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="HardRockMoreDamageAfterDeathMetal01.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Bard63/Spells/HardRock/HardRock01.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Launch</Item>
            </stages>
        </Item>
    </effects>
    <duration>20000</duration>
    <isHelpful>true</isHelpful>
    <ranks>
        <Item href="HardRockMoreDamageAfterDeathMetal03.(BuffResource).xdb" />
        <Item href="HardRockMoreDamageAfterDeathMetal02.(BuffResource).xdb" />
        <Item href="HardRockMoreDamageAfterDeathMetal01.(BuffResource).xdb" />
        <Item href="HardRockMoreDamageAfterDeathMetal04.(BuffResource).xdb" />
