<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221365</resourceId>
    </Header>
    <Name href="FearWarning.(BuffResource).Name.txt" />
    <Description href="FearWarning.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Event/Psionic_02Event.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="FearDispelable.(BuffResource).xdb" />
                    <impactsOnFail>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="FearVisual.(BuffResource).xdb" />
                        </Item>
                    </impactsOnFail>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.5</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="FearVisual.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>3000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/StopSing.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>