<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>attack</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
						</advanced>
					</Item>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Engineer_PoisonProjectile_Turr.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb" />
						<theGe>1</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>FROM_LOCATOR_NAME</locator>
							<member>Mount</member>
							<locatorName>Slot_Special01</locatorName>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnTarget>
						<offendTime type="EffectOffendConstDelay" />
					</Item>
					<Item type="CreatureVisObjectComponentsAction">
						<member>Mount</member>
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Spells/Engineer_BarrelShot_Main01.(VisObjectTemplate).xdb" />
								<scale>1</scale>
								<locatorName>Slot_Special01</locatorName>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastDirectedEngineer</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
						</advanced>
					</Item>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Engineer_PoisonProjectile.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb" />
						<theGe>1</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_L</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnTarget>
						<offendTime type="EffectOffendConstDelay" />
					</Item>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Spells/Engineer_BarrelShot_Main01.(VisObjectTemplate).xdb" />
								<scale>0.6</scale>
								<locatorName>Slot_Hand_L</locatorName>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
