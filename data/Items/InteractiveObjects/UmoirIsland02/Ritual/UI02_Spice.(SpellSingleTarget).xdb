<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739856368</resourceId>
	</Header>
	<Name href="UI02_Spice.(SpellSingleTarget).Name.txt" />
	<visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>2000</prepareDuration>
	<targetType>STTSelf</targetType>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateDeviceNear">
				<radius>5</radius>
				<devices>
					<Item href="Kettle.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
				</devices>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
				<quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
				<status>Active</status>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
				<quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
				<counterResource href="/World/Quests/UmoirIsland02/UI02_Q04/Counter02.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
			</Item>
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceActiveItem" />
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
				<spawn>
					<scriptID>Koschey</scriptID>
					<map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
				</spawn>
				<impacts>
					<Item type="gameMechanics.elements.impacts.BuffDetacher">
						<buff href="Spice.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
						<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
						<data href="Spice.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
						<spawn>
							<scriptID>Kettle</scriptID>
							<map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
						</spawn>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
								<visualState>6</visualState>
							</Item>
						</impacts>
					</Item>
				</impacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
				<delay>2000</delay>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactGiveItem">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="/Items/InteractiveObjects/UmoirIsland02/WrongElixir.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
						</item>
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
						<quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
						<counterResource href="/World/Quests/UmoirIsland02/UI02_Q04/WrongElixir.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
					</Item>
				</impacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
				<quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
				<counterResource href="/Items/InteractiveObjects/UmoirIsland02/Spice.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
