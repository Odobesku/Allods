<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>739925114</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="WW_start_9.xdb" />
            <counterId href="Counter2.(QuestCountId).xdb" />
            <condition type="constructor.elements.LongEquals">
                <value>3</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="Bandits.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.RelativePos" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Bandit_vis.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>300000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impacts>
                    <object href="/Characters/Orc_male/Instances/ZC12/Orc_Bandit_WW_start_9_defeated.(MobWorld).xdb" />
                    <pool href="DefeatedOrc.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                            <zone href="/Maps/2ndCircle/ScriptZones/ZoneContested2/WW_start_9_fail.(ScriptZone).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="WW_start_9.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="Bandits.(SummonPool).xdb" />
                            <isPersonalPool>true</isPersonalPool>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                            <quest href="WW_start_9.xdb" />
                            <counterResource href="Counter1.(QuestCountId).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="WW_start_9.xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>