                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactChannelingStop" />
                        </impacts>
                    </Item>
                </impactsOff>
            </Item>
            <Item type="gameMechanics.world.ship.elements.DeviceUseTrigger">
                <userImpactsOnFinishUse>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="/Mechanics/Ships/BeamCannon/FireUsageBuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </userImpactsOnFinishUse>
                <deviceImpactsOnFinishUse>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
                        <delay>0</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactChannelingStop" />
                        </impacts>
                    </Item>
                </deviceImpactsOnFinishUse>
            </Item>
        </casterChannelingEffects>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                <data href="/Mechanics/Ships/BeamCannon/CannonAttack_ClientData.xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellGroupDeactivate">
                <group href="/Mechanics/Ships/BeamCannon/BeamCannonSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellActivate" />
        </casterImpacts>
    </mechanics>
    <speed>500</speed>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <objectsProvider>CollisionScene</objectsProvider>
        <angle type="constructor.basicElements.AngleRadians">
            <value>0.2618</value>
        </angle>
    </shape>
    <radius var="radius" />
</gameMechanics.constructor.schemes.spell.area.SpellArea>