    <image href="/Interface/Icons/Spells/Psionic/PsionicTimeLapse.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Mobs/General_Timelapse_Main.(VisObjectTemplate).xdb" />
            <locator>Slot_Global</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.RelativeRotatePos">
                        <base type="gameMechanics.map.destination.SelfPosDestination" />
