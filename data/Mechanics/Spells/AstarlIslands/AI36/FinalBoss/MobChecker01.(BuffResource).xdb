    <nameTemplate href="MobChecker01.(BuffResource)_Name.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobNear">
                                    <radius>50</radius>
                                    <mobs>
                                        <Item href="/Creatures/CritterRabbit/Instances/AstralIsle36/BossAddRabbit.(MobWorld).xdb" />
