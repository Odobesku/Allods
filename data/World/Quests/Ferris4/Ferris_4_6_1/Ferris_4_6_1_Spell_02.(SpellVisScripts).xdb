<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Omni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationOmniWand.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastAnimation>
			<LocatorNameOnTargets />
			<FXOnTargets>/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<FixPointTarget>true</FixPointTarget>
			<FXOnCaster>/Spells/FX/Spells/PsionicTelekineticTrustAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorNameOnCaster />
			<PreCastFX>/Spells/VisScripts/Prototypes2/PreCastFX.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastFX>
			<FXWand />
			<FixPointCaster>false</FixPointCaster>
			<FXPocket>/Spells/FX/Spells/PocketSpellAstral01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXPocket>
			<HitPostFXOnTargets />
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction" />
					<Item type="ShakeAction">
						<params href="/Spells/FX/InterfaceFX/CameraShakeVert1.(CameraShakeParameters).xdb#xpointer(/CameraShakeParameters)" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
