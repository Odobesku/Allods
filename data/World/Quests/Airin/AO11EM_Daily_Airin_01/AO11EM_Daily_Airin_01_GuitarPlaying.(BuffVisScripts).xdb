          </visCharList>
          <checkIsInTheList>true</checkIsInTheList>
          <checkOnStartOnly>true</checkOnStartOnly>
        </condition>
        <elseAction type="client.SLON.IfAction">
          <condition type="client.SLON.IfCreatureVisCharacter">
