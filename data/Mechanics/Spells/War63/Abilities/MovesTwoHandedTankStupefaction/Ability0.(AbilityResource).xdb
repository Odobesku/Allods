<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>216410</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="duration" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Equipment/Mace/MaceOgr.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <targetImpacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Cowardice/Cowardice.(BuffResource).xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.ScalerIf">
                        <condition type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
                        </condition>
                        <scalerIf type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier var="duration" />
                                </Item>
                                <Item type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier>2</multiplier>
                                </Item>
                            </scalers>
                        </scalerIf>
                        <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier var="duration" />
                        </scalerElse>
                    </durationScaler>
                </Item>
            </targetImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationGroups">
                <groups>
                    <Item href="/Mechanics/Spells/Groups/Moves.(ActionGroup).xdb" />
                </groups>
            </destination>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>