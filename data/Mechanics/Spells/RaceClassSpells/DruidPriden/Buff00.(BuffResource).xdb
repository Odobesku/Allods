<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739951455</resourceId>
    </Header>
    <Name href="Buff00.(BuffResource).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidPetLockJaw.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Druid/PetGetIt.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <targetImpacts>
                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                        <value>0.5</value>
                    </chanceCalcer>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>2</multiplier>
                            </durationScaler>
                        </Item>
                    </impacts>
                    <impactsLose>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                        </Item>
                    </impactsLose>
                </Item>
            </targetImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/AutoAttack/MeleeDamage.xdb" />
                </spells>
            </destination>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>