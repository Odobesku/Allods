<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<Arrow>/Spells/VisScripts/RangedAttack/Arrows/NairaArrow.(VisProjectile).xdb#xpointer(/VisProjectile)</Arrow>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<use>USE_ANIMATIONS</use>
				<animations>
					<Item>cheapShotBowStart</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<animationKeysAction>
						<Item>
							<action type="CreatureTakeArrowAction">
								<arrow hrefvar="Arrow" />
							</action>
						</Item>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<playWhile />
								<elements>
									<Item type="CreatureItemAnimationAction">
										<itemsSlot>RANGED</itemsSlot>
										<mode>CLAMP</mode>
										<animation>special</animation>
									</Item>
									<Item type="CreatureTakeBowStringAction">
										<visActionID>AttachString</visActionID>
										<itemsSlot>RANGED</itemsSlot>
										<itemLocatorName>Slot_String</itemLocatorName>
										<creatureLocator>Slot_Hand_R</creatureLocator>
									</Item>
								</elements>
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Spells/NairaBowPrecast_Green.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>0.7</scale>
						<locator>Slot_Hand_L</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>spells/FX/Spells/NairaFX/bowPrecastGreen</name>
				</sound>
				<forcedSoundStop>true</forcedSoundStop>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="VisActionStopAction">
				<stoppedActionID>AttachString</stoppedActionID>
			</Item>
			<Item type="CreatureItemAnimationAction">
				<itemsSlot>RANGED</itemsSlot>
				<animation>attack</animation>
			</Item>
			<Item type="CreatureAnimationAction">
				<use>USE_ANIMATIONS</use>
				<animations>
					<Item>cheapShotBow</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureThrowArrowAction">
				<arrow hrefvar="Arrow" />
				<arrowInTargetTime>10000</arrowInTargetTime>
				<theGe>8</theGe>
				<additionalEffectFx href="/Spells/FX/Spells/NairaArrow_GlowGreen.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<effectBone>Slot_FX</effectBone>
				<offendTime type="EffectOffendConstDelay" />
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>spells/FX/Spells/NairaFX/acidShot</name>
				</sound>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
