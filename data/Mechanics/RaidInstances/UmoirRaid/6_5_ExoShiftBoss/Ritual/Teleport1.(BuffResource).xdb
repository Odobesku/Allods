<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739866215</resourceId>
	</Header>
	<Name href="Teleport1.(BuffResource).Name.txt" />
	<image href="/Interface/Icons/Spells/Priest/ChainSmite.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Mobs/ExoShift_Boss_Slow.(VisObjectTemplate).xdb" />
			<locator>Slot_FX</locator>
		</Item>
	</visualEffects>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
									<radius>160</radius>
									<affectGroup>Enemies</affectGroup>
									<affectHolder>false</affectHolder>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="Teleport2.(BuffResource).xdb" />
										</Item>
									</impacts>
									<filter type="gameMechanics.constructor.basicElements.FilterAnd">
										<filters>
											<Item type="gameMechanics.world.creature.AvatarFilter" />
											<Item type="gameMechanics.world.creature.AliveFilter" />
											<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
												<predicates>
													<Item type="gameMechanics.constructor.basicElements.PredicateNot">
														<predicate type="gameMechanics.elements.resources.ResourceBuff">
															<buff href="/Mechanics/RaidInstances/UmoirRaid/6_5_ExoShiftBoss/Pulse/Pulse.(BuffResource).xdb" />
														</predicate>
													</Item>
													<Item type="gameMechanics.constructor.basicElements.PredicateNot">
														<predicate type="gameMechanics.elements.resources.ResourceBuff">
															<buff href="Teleport1.(BuffResource).xdb" />
														</predicate>
													</Item>
												</predicates>
											</Item>
										</filters>
									</filter>
									<targetsLimit>1</targetsLimit>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>65L7</scriptID>
							<map href="/Maps/UmoirRaid/MapResource.xdb" />
						</locator>
					</destination>
					<finishImpacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactSummon">
									<destination type="gameMechanics.map.destination.DestinationModified">
										<destination type="gameMechanics.map.destination.SelfPosDestination" />
										<modifiers>
											<Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
												<radius type="gameMechanics.elements.calcers.FloatData">
													<value>4</value>
												</radius>
											</Item>
										</modifiers>
									</destination>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ForceAggro" />
									</impacts>
									<object href="Generator.(MobWorld).xdb" />
									<pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
								</Item>
							</impacts>
						</Item>
					</finishImpacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.DirectDamage">
					<damage>1</damage>
					<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
							<multiplier>0.04</multiplier>
						</mulCalcer>
					</scalerTarget>
				</Item>
			</impacts>
			<tick>1000</tick>
			<initialDelay>3000</initialDelay>
		</Item>
		<Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
		<Item type="gameMechanics.elements.effects.IncomingHealModifier">
			<priority>Multiplier</priority>
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-1</coeff>
			</scaler>
		</Item>
	</effects>
	<duration>120000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
