<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/ProjectileAOE.(SpellVisScripts).xdb" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationDirectedBall.(CreatureVisActionResource).xdb</PreCastAnimation>
			<FXProjectile>/Spells/FX/Spells/MageFireballAbilityBig.(VisObjectTemplate).xdb</FXProjectile>
			<FXProjectileHit>/Spells/FX/Spells/HitFireball2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
			<PreCastFX>/Spells/VisScripts/Prototypes/PreCastFXFireWand.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastFX>
			<FXWand>/Spells/FX/Spells/ReadySpellDirectFireWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXWand>
			<FXPocket>/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXPocket>
			<Ge>3</Ge>
			<HitPostFXOnTargets>/Spells/VisScripts/HitPostFxOnTarget/HitFireShader.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</HitPostFXOnTargets>
			<LocatorOnCaster>Wand_Slot_FX</LocatorOnCaster>
			<LocatorNameOnTargets />
			<FXOnTargets />
			<CastAnimation>spellCastDirectedBall</CastAnimation>
			<FixPointTarget>true</FixPointTarget>
			<FXOnCaster />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorNameOnCaster />
			<FixPointCaster>false</FixPointCaster>
			<MulyProjectile>false</MulyProjectile>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item type="VisActionList">
						<elements>
							<Item skiped="" />
							<Item type="CreatureProjectileAction">
								<projectileFx hrefvar="FXProjectile" />
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
