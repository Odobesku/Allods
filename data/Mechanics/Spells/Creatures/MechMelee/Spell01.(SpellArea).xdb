	<range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
	<replaceLowRanks>false</replaceLowRanks>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<needInFront>false</needInFront>
	<mechanics>
		<cooldown>
			<duration>15000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.elements.predicates.PredicateIsPet" />
				</predicates>
			</Item>
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateOr">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							<Item type="gameMechanics.elements.predicates.PredicateIsPet" />
						</predicates>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
						<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
						<minDamage>5</minDamage>
						<maxDamage>5</maxDamage>
					</Item>
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Cone">
		<angle type="constructor.basicElements.AngleRadians">
			<value>2</value>
		</angle>
	</shape>
	<radius>8</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
