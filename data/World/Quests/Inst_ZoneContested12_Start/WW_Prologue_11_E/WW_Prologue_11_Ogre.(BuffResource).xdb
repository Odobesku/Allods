<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>317028</resourceId>
    </Header>
    <Name href="WW_Prologue_11_Ogre.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Misc/Quest/ArtifactCannon.(UISingleTexture).xdb" />
    <visScript href="Ogre_visual.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                    <id href="Counter1.(QuestCountId).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/Inst_ZoneContested12_Start/Zones/Inst_ZoneContested12_04.(ZoneResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_Prologue_11_Ogre.(SpawnTable).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                <quest href="WW_Prologue_11_E.xdb" />
                                <status>Completed</status>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="Counter1.(QuestCountId).xdb" />
                            <value>-1</value>
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactHealAll" />
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.1</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactHealAll" />
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="WW_Prologue_11_Ogre.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                    <quest href="WW_Prologue_11_E.xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactStopSpawn">
                    <table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_Prologue_11_ArchitectExecutors.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Counter3.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>0.05</level>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.EffectList">
            <effectsResource href="/Mechanics/GameRoot/Mount/HidePetMountAbility.(EffectListResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="Ogre_spell_01.(SpellArea).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.DisableAllActionsExceptGroupGeneric">
            <group href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="/Creatures/ArchitectMele/Instances/ZC12/WW_Prologue_11_ArchitectMeleeExecutor.(MobWorld).xdb" />
                                    <Item href="/Creatures/ArchitectRanger/Instances/ZC12/WW_Prologue_11_ArchitectRangerExecutor.(MobWorld).xdb" />
                                </mobs>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                            </Item>
                        </predicates>
                    </filter>
                    <targetsLimit>2</targetsLimit>
                </Item>
            </impacts>
            <tick>3000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="Ogre_spell_02.(SpellArea).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="Ogre_spell_03.(SpellSingleTarget).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectStatSetter">
            <stat type="gameMechanics.elements.stat.StatFullHealth" />
            <valueCalcer type="gameMechanics.elements.calcers.FloatData">
                <value>1.5e+006</value>
            </valueCalcer>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.DirectHeal">
                    <heal>45000</heal>
                </Item>
            </impacts>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>