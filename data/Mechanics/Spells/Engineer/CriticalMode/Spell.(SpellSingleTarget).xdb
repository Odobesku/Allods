        <Item href="/Mechanics/Spells/Groups/EngineerLevitatingSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/EngineerArtillerySpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="Spell.(SpellSingleTarget).Name.txt" />
    <Description href="Spell.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/Overload.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <useVisScipt />
    <visualScripts href="/Spells/VisScripts/Engineer/CriticalMode.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <targetType>STTSelf</targetType>
