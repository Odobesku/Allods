<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/Entrapment_Warrior_Channel.(VisObjectTemplate).xdb" />
				<startPoint type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>1000</time>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>attack</Item>
						</animations>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
