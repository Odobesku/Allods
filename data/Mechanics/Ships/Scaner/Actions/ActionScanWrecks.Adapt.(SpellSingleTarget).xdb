    <image href="/Interface/Icons/Misc/Chests/ChestCostumesTP.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.world.ship.elements.ResourceInsight">
                <amount type="gameMechanics.elements.calcers.CalcerMul">
                    <calcers>
                        <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                <name>ability01</name>
