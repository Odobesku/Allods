<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739924847</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Quest/SwordWildOrc.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="TestPowerModStacks.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.NotStackableEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>0.01</coeff>
                        <calcer type="gameMechanics.elements.calcers.CalcerSum">
                            <summands>
                                <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                    <buff href="TestPowerModStacks.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.calcers.FloatData">
                                    <value>-100</value>
                                </Item>
                            </summands>
                        </calcer>
                    </scaler>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>100</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.StackBuff">
                            <buff href="TestPowerModStacks.(BuffResource).xdb" />
                            <delta type="gameMechanics.elements.calcers.CalcerDiff">
                                <minuend type="gameMechanics.map.variables.MapVariableValueCalcer">
                                    <resource href="PowerMod.(MapVariableResource).xdb" />
                                </minuend>
                                <subtrahend type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                    <buff href="TestPowerModStacks.(BuffResource).xdb" />
                                </subtrahend>
                            </delta>
                        </Item>
                    </impactsOn>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>100</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectStackChangeTrigger">
                            <impactsOnIncrease>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                            <buff href="TestPowerModStacks.(BuffResource).xdb" />
                                            <range>
                                                <min>100</min>
                                                <max>100</max>
                                            </range>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="TestPowerModStacks.(BuffResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impactsOnIncrease>
                            <impactsOnDecrease>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                            <buff href="TestPowerModStacks.(BuffResource).xdb" />
                                            <range>
                                                <min>100</min>
                                                <max>100</max>
                                            </range>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="TestPowerModStacks.(BuffResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impactsOnDecrease>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <stackLimit>500</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>