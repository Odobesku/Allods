<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>246140</resourceId>
    </Header>
    <Name href="UI06_HealChannel.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/Healing.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.common.HealOverTime">
            <healPerTick type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </healPerTick>
            <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                    <multiplier>0.05</multiplier>
                </mulCalcer>
            </scalerTarget>
            <considerOutgoingModifiers>false</considerOutgoingModifiers>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <groups>
        <Item href="/Mechanics/Spells/Groups/LesserHeals.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>