<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739872974</resourceId>
    </Header>
    <Name href="ChainLight.(BuffResource).Name.txt" />
    <Description href="ChainLight.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/ChainSmite.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/Mage_LitShield.(VisObjectTemplate).xdb" />
            <scale>1.3</scale>
        </Item>
        <Item>
            <effectFx href="/Mechanics/InstanceModifiers/Addon5/ChainLight/ChainLight.(VisObjectTemplate).xdb" />
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectJumpOnDetach">
            <jumps type="gameMechanics.elements.calcers.LongData">
                <value>99</value>
            </jumps>
            <buff href="ChainLight.(BuffResource).xdb" />
            <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.FilteringAutotarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                </predicates>
                <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.RandomAutotarget">
                    <group>Enemies</group>
                    <radius>10</radius>
                </autotarget>
            </autotarget>
            <onBehalfOfCaster>true</onBehalfOfCaster>
            <radius>5</radius>
            <inCasterRange>false</inCasterRange>
            <keepTrack>false</keepTrack>
            <renewingEffects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="/Mechanics/InstanceModifiers/Addon5/ChainLight/Normal/ChainLight.(ClientData).xdb" />
                            <calcers>
                                <addressEntries>
                                    <Item>
                                        <name>caster</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    </Item>
                                    <Item>
                                        <name>target</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                    </Item>
                                </addressEntries>
                            </calcers>
                        </Item>
                    </impactsOff>
                </Item>
            </renewingEffects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>HOLY</element>
                    <scalerTarget type="gameMechanics.elements.scalers.ScalerBuff">
                        <buff href="ChainLight_Damage.(BuffResource).xdb" />
                        <summand>0</summand>
                    </scalerTarget>
                    <damage>75</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>500</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ChainLight_Damage.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ChainLight.(BuffResource).xdb" />
                </Item>
            </onLeave>
        </Item>
    </effects>
    <duration>2000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isForthright>true</isForthright>
    <groups>
        <Item href="/Mechanics/InstanceModifiers/Addon5/Astral_Modifiers.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>