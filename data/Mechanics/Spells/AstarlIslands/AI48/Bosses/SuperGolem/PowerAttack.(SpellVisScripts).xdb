<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>ready</Item>
        </animations>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialAttack01</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
            </Item>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <delay>200</delay>
                        <effectFx href="/Spells/FX/Spells/HitMeleeCrit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>2</scale>
                        <locator>Slot_BodyFX</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>