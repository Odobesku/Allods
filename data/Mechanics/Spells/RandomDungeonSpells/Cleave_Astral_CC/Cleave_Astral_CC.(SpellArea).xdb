<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739903387</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/ProceduralDungeon/Groups/Astra.(ActionGroupElement).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroupElement)" />
	</groups>
	<element>ASTRAL</element>
	<Name href="Cleave_Astral_CC.(SpellArea).Name.txt" />
	<visualScripts href="Cleave_Astral_CC.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>19000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
				</predicates>
			</Item>
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateOr">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
							<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
						</predicates>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
						<element>ASTRAL</element>
						<damage>22</damage>
						<scaler type="gameMechanics.elements.scalers.MagicScaler" />
					</Item>
				</impactsIf>
			</Item>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
					<multiplier>3</multiplier>
				</durationScaler>
			</Item>
		</targetImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Cone">
		<angle type="constructor.basicElements.AngleDegrees">
			<value>90</value>
		</angle>
	</shape>
	<radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
