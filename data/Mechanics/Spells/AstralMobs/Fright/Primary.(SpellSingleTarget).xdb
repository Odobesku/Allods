<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>198311</resourceId>
    </Header>
    <Name href="PrimaryMelee.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/AstralMobs/Mage/Primary.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>1000</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <needLos>false</needLos>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.world.device.cannon.ImpactCannonDamage">
                <damage type="gameMechanics.elements.calcers.CalcerMul">
                    <calcers>
                        <Item type="gameMechanics.elements.calcers.AstralMobImpactDamageCalcer">
                            <damage>1600</damage>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.AstralTLCalcer">
                            <value type="gameMechanics.elements.calcers.FloatData">
                                <value>1.33</value>
                            </value>
                        </Item>
                    </calcers>
                </damage>
                <hitCalcType type="gameMechanics.world.projectile.AstralMobCalcType" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsIf">
                <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateDistance">
                            <range min="500" max="1000" />
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                            <onMaster type="gameMechanics.elements.predicates.PredicateHealthLower">
                                <level>0.2</level>
                            </onMaster>
                        </Item>
                    </predicates>
                </predicate>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="PrimaryAttackBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>200</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>