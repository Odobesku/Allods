<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>212608</resourceId>
    </Header>
    <Name href="Worm_Healing.(SpellSingleTarget).Name.txt" />
    <visualScripts href="Worm_Healing_vis.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>5000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>40000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Worm_Healing_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                    <range min="0" max="16" />
                    <withinRange>true</withinRange>
                    <minCandidatesCount>0</minCandidatesCount>
                    <targetCount>0</targetCount>
                </selector>
                <filter type="gameMechanics.constructor.basicElements.FilterOr">
                    <filters>
                        <Item type="gameMechanics.world.creature.AvatarFilter">
                            <withPet>true</withPet>
                        </Item>
                    </filters>
                </filter>
                <impacts>
                    <Item>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                                <time>1000</time>
                                <distance>15</distance>
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Worm_Sticky_buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                <spell href="Worm_StickyBomb.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <duration>2000</duration>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>