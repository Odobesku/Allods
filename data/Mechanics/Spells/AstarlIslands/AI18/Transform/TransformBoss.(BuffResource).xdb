<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>194275</resourceId>
    </Header>
    <Name href="TransformBoss.(BuffResource).Name.txt" />
    <Description href="TransformBoss.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/StrongPantsirGhostCrab.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Mechanics/Spells/AstarlIslands/AI18/AI18_Boss02/TransformBoss.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableSpellsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                    <spell href="Transform.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                    <duration>40000</duration>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                    <spell href="/Mechanics/Spells/AstarlIslands/AI18/AI18_Boss02/Boss02_Charge.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                    <duration>15000</duration>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.5</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>15000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                            </impacts>
                            <object href="Mod_Crab.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>1</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Martyr/Hard/Martyr.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Martyr/Normal/Martyr.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Astral_Defence/Normal/Astral_Defence.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Astral_Defence/Hard/Astral_Defence.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Astral_Sphere/Normal/Astral_Sphere.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Astral_Sphere/Hard/Astral_Sphere.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Creeping_Death/Normal/Creeping_Death.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Creeping_Death/Hard/Creeping_Death.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/FreedomRage/Hard/FreedomRage_Big.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/FreedomRage/Normal/FreedomRage_Big.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/FreedomRage/Normal/FreedomRage_Small.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/FreedomRage/Hard/FreedomRage_Small.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Shadows/Normal/Shadow.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/InstanceModifiers/Addon5/Shadows/Hard/Shadow.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                </mobs>
                            </Item>
                        </predicates>
                    </filter>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                        <range min="0" max="60" />
                        <withinRange>false</withinRange>
                        <minCandidatesCount>0</minCandidatesCount>
                        <targetCount>0</targetCount>
                    </selector>
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Transform.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>