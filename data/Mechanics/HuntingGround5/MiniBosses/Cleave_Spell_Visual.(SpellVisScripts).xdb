<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes2/Mob.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	</Header>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/VampCleaveFX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/HitBloodViolet.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<useVisObjectSettings>FROM_TARGET</useVisObjectSettings>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
