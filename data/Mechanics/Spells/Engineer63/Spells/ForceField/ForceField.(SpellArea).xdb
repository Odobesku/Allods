<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739932107</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/EngineerDefenceDevices.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
	</groups>
	<Name href="ForceField.(SpellArea).Name.txt" />
	<Description href="ForceField.(SpellArea).Description.txt" />
	<descVars>
		<Item>
			<name>dmg</name>
			<value var="multiplier" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Mounts/SpellsMounts/AreaShuntAirMoto.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Engineer/Engineer_MeleeBotSpell.(SpellVisScripts).xdb" />
	<durationBuff href="ForceFieldLifetime.(BuffResource).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>30</value>
	</range>
	<targetType>STTPoint</targetType>
	<ranks>
		<Item href="ForceField01.(SpellArea).xdb" />
		<Item href="ForceField02.(SpellArea).xdb" />
		<Item href="ForceField03.(SpellArea).xdb" />
	</ranks>
	<iffPolicy>Everyone</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<needInFront>false</needInFront>
	<mechanics>
		<cooldown>
			<duration var="duration" />
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateHasPath">
				<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
				<maxLength>85</maxLength>
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateFaction">
						<faction href="/World/Factions/League.xdb" />
					</Item>
				</predicates>
				<impacts>
					<Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
						<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
						<impacts>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="ForceFieldKick.(BuffResource).xdb" />
								<durationScaler type="gameMechanics.elements.scalers.ScalerIf">
									<condition type="gameMechanics.elements.predicates.PredicateHasAbility">
										<ability href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/FallingDevices01.(AbilityResource).xdb" />
									</condition>
									<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mul var="multiplier" />
										<sum>2</sum>
									</scalerIf>
									<scalerElse type="gameMechanics.elements.scalers.LinearScaler">
										<multiplier var="multiplier" />
									</scalerElse>
								</durationScaler>
							</Item>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.MarkedImpact">
								<mark href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/DeviceFall.(MarkResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
										<delay>100</delay>
										<impacts>
											<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
												<buff href="ForceFieldLifetime.(BuffResource).xdb" />
												<durationScaler type="gameMechanics.elements.scalers.BuffTicksScaler">
													<buff href="ForceFieldKick.(BuffResource).xdb" />
													<tickLength>1000</tickLength>
												</durationScaler>
											</Item>
										</impacts>
									</Item>
								</impacts>
							</Item>
						</impacts>
						<assistantResource href="ForceField.(AssistantResource).xdb" />
						<mobResource href="ForceFieldLeague.(MobWorld).xdb" />
						<level type="gameMechanics.elements.calcers.CalcerLevel" />
						<linkMode>ModifiedHealth</linkMode>
						<planeSyncStrategy>Sync</planeSyncStrategy>
					</Item>
				</impacts>
				<elseImpacts>
					<Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
						<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
						<impacts>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="ForceFieldKick.(BuffResource).xdb" />
								<durationScaler type="gameMechanics.elements.scalers.ScalerIf">
									<condition type="gameMechanics.elements.predicates.PredicateHasAbility">
										<ability href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/FallingDevices01.(AbilityResource).xdb" />
									</condition>
									<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mul var="multiplier" />
										<sum>2</sum>
									</scalerIf>
									<scalerElse type="gameMechanics.elements.scalers.LinearScaler">
										<multiplier var="multiplier" />
									</scalerElse>
								</durationScaler>
							</Item>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.MarkedImpact">
								<mark href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/DeviceFall.(MarkResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
										<delay>100</delay>
										<impacts>
											<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
												<buff href="ForceFieldLifetime.(BuffResource).xdb" />
												<durationScaler type="gameMechanics.elements.scalers.BuffTicksScaler">
													<buff href="ForceFieldKick.(BuffResource).xdb" />
													<tickLength>1000</tickLength>
												</durationScaler>
											</Item>
										</impacts>
									</Item>
								</impacts>
							</Item>
						</impacts>
						<assistantResource href="ForceField.(AssistantResource).xdb" />
						<mobResource href="ForceFieldEmpire.(MobWorld).xdb" />
						<level type="gameMechanics.elements.calcers.CalcerLevel" />
						<linkMode>ModifiedHealth</linkMode>
						<planeSyncStrategy>Sync</planeSyncStrategy>
					</Item>
				</elseImpacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
				<spell href="/Mechanics/Spells/Engineer63/Spells/HealStation/HealStation03.(SpellArea).xdb" />
				<duration var="duration" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactSpellGroupCooldown">
				<group href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
				<duration>1000</duration>
			</Item>
		</casterImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
