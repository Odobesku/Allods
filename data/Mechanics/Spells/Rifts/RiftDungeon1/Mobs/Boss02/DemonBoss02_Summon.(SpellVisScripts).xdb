<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellSimple.(VisObjectTemplate).xdb" />
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellSimple.(VisObjectTemplate).xdb" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>1500</time>
					</Item>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Mobs/Demon_Summon.(VisObjectTemplate).xdb" />
						<useCastPoint>true</useCastPoint>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="CreatureAnimationAction">
		<animations>
			<Item>spellCastDirected</Item>
		</animations>
		<channel>CHANNEL_KNOCKDOWN</channel>
	</launch>
</SpellVisScripts>
