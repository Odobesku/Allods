<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.elements.scenarios.EventScenario>
    <Header>
        <resourceId>739908022</resourceId>
    </Header>
    <name href="Siege_1.(EventScenario).Name.txt" />
    <rootElement type="gameMechanics.elements.scenarios.SequenceElement">
        <elements>
            <Item type="gameMechanics.elements.scenarios.TimerElement">
                <delay>
                    <minute>15</minute>
                </delay>
                <failOnTimeout>true</failOnTimeout>
                <controlChildElement type="gameMechanics.elements.scenarios.spawn.SpawnElement">
                    <spawnEntries>
                        <Item type="gameMechanics.elements.scenarios.spawn.SpawnElement$SpawnEntry">
                            <spawnFactory type="gameMechanics.elements.scenarios.spawn.MobPoolSpawnFactory">
                                <mobPool href="/Mechanics/ProceduralDungeon/Pool/Siege_Target_Forest.(MobPool).xdb" />
                            </spawnFactory>
                            <place type="gameMechanics.elements.scenarios.destinationFinders.DestinationFinderTag">
                                <tag href="TestScenario/Siege_Target_Spawn_1.(IdentifiableTagResource).xdb" />
                            </place>
                            <spawnAllInOnePlace>false</spawnAllInOnePlace>
                        </Item>
                    </spawnEntries>
                    <optionalChildElement type="gameMechanics.elements.scenarios.SequenceElement">
                        <elements>
                            <Item type="gameMechanics.elements.scenarios.StartEventGoalElement">
                                <eventGoal href="/Mechanics/ProceduralDungeon/Goal/Siege_1.(KillMobsEventGoal).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.scenarios.ParallelElement">
                                <elements>
                                    <Item type="gameMechanics.elements.scenarios.spawn.SpawnElement">
                                        <spawnEntries>
                                            <Item type="gameMechanics.elements.scenarios.spawn.SpawnElement$SpawnEntry">
                                                <spawnFactory type="gameMechanics.elements.scenarios.spawn.MobPoolSpawnFactory">
                                                    <mobPool href="/Mechanics/ProceduralDungeon/Pool/Siege_Boss_Add_forest.(MobPool).xdb" />
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="Disorient.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </spawnFactory>
                                                <place type="gameMechanics.elements.scenarios.destinationFinders.DestinationFinderTag">
                                                    <tag href="TestScenario/Siege_Boss_Add_2.(IdentifiableTagResource).xdb" />
                                                </place>
                                                <spawnAllInOnePlace>false</spawnAllInOnePlace>
                                                <count>3</count>
                                            </Item>
                                        </spawnEntries>
                                    </Item>
                                    <Item type="gameMechanics.elements.scenarios.spawn.SpawnElement">
                                        <spawnEntries>
                                            <Item type="gameMechanics.elements.scenarios.spawn.SpawnElement$SpawnEntry">
                                                <spawnFactory type="gameMechanics.elements.scenarios.spawn.MobPoolSpawnFactory">
                                                    <mobPool href="/Mechanics/ProceduralDungeon/Pool/Siege_2_Floor_Forest.(MobPool).xdb" />
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="Disorient.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </spawnFactory>
                                                <place type="gameMechanics.elements.scenarios.destinationFinders.DestinationFinderTag">
                                                    <tag href="TestScenario/Siege_2Floor2.(IdentifiableTagResource).xdb" />
                                                </place>
                                                <spawnAllInOnePlace>false</spawnAllInOnePlace>
                                                <count>7</count>
                                            </Item>
                                        </spawnEntries>
                                    </Item>
                                    <Item type="gameMechanics.elements.scenarios.spawn.SpawnElement">
                                        <spawnEntries>
                                            <Item type="gameMechanics.elements.scenarios.spawn.SpawnElement$SpawnEntry">
                                                <spawnFactory type="gameMechanics.elements.scenarios.spawn.MobPoolSpawnFactory">
                                                    <mobPool href="/Mechanics/ProceduralDungeon/Pool/Siege_1Floor_Forest.(MobPool).xdb" />
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="Disorient.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </spawnFactory>
                                                <place type="gameMechanics.elements.scenarios.destinationFinders.DestinationFinderTag">
                                                    <tag href="TestScenario/Siege_1_Floor_2.(IdentifiableTagResource).xdb" />
                                                </place>
                                                <spawnAllInOnePlace>false</spawnAllInOnePlace>
                                                <count>15</count>
                                            </Item>
                                        </spawnEntries>
                                    </Item>
                                </elements>
                            </Item>
                        </elements>
                    </optionalChildElement>
                </controlChildElement>
            </Item>
            <Item type="gameMechanics.elements.scenarios.CompleteEventGoalElement">
                <eventGoal href="/Mechanics/ProceduralDungeon/Goal/Siege_1.(KillMobsEventGoal).xdb" />
