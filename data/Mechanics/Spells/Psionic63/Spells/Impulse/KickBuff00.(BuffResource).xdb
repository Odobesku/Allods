<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739939600</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                    <time>400</time>
                    <impactsOnLand>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.5</mul>
                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="externalCalcer" />
                                </mulCalcer>
                            </durationScaler>
                        </Item>
                    </impactsOnLand>
                    <distance>10</distance>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>500</duration>
    <isHelpful>false</isHelpful>
    <ranks>
        <Item href="KickBuff01.(BuffResource).xdb" />
        <Item href="KickBuff02.(BuffResource).xdb" />
        <Item href="KickBuff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>