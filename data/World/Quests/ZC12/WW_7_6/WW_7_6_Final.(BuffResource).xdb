<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739967758</resourceId>
	</Header>
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Spells/Camera_CutScene.(VisObjectTemplate).xdb" />
		</Item>
	</visualEffects>
	<visScript href="WW_7_6_Final.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Rotate</Item>
				<Item>Jump</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
			</predicates>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="WW_7_6_Mounted.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>ZC12_RI5_Exit</scriptID>
							<map href="/Maps/ZC12/MapResource.xdb" />
						</locator>
					</destination>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<duration>6000</duration>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
