<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739921855</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Buff0.(BuffResource).Name.txt" />
    <Description href="Buff0.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorUncannyParry.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>FormulaPercent</formula>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="Calcer.(CalcerFloatResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                    <buff href="Buff01.(BuffResource).xdb" />
                                    <forAllRanks>true</forAllRanks>
                                </Item>
                            </calcers>
                        </mulCalcer>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                    <group href="/Mechanics/Spells/Groups/Moves.(ActionGroup).xdb" />
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                <coeff>1</coeff>
                                <calcer type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="constructor.elements.CalcerFloatExternal">
                                            <externalCalcer href="Calcer.(CalcerFloatResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                            <buff href="Buff01.(BuffResource).xdb" />
                                            <forAllRanks>true</forAllRanks>
                                        </Item>
                                    </calcers>
                                </calcer>
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <casterImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="Buff01.(BuffResource).xdb" />
                                    <resetTimer>false</resetTimer>
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </casterImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationGroups">
                <groups>
                    <Item href="/Mechanics/Spells/Groups/Moves.(ActionGroup).xdb" />
                </groups>
            </destination>
        </Item>
    </effects>
    <duration>10000</duration>
    <stackLimit var="stackLimit" />
    <isGradual>true</isGradual>
    <isHelpful>true</isHelpful>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
        <Item href="Buff04.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>