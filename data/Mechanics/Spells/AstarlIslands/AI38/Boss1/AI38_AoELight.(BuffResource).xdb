<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>193600</resourceId>
    </Header>
    <Name href="AI38_AoELight.(BuffResource).Name.txt" />
    <Description href="AI38_AoELight.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Ships/LightGun.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectStackChangeTrigger">
            <impactsOnIncrease>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>LIGHTNING</element>
                                    <damage>35</damage>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                    <data href="AI38_AoELight.(ClientData).xdb" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnIncrease>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.HighStackEffect">
            <effect type="gameMechanics.elements.effects.Switch">
                <impactsOff>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="AI38_TankDamage.(BuffResource).xdb" />
                        <stacks type="gameMechanics.elements.calcers.CalcerDiff">
                            <minuend type="gameMechanics.elements.calcers.FloatData">
                                <value>10</value>
                            </minuend>
                            <subtrahend type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                <buff href="AI38_StackCheck.(BuffResource).xdb" />
                            </subtrahend>
                        </stacks>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="AI38_AoELight.(BuffResource).xdb" />
                    </Item>
                </impactsOff>
            </effect>
            <stackCountTrigger>10</stackCountTrigger>
        </Item>
    </effects>
    <stackLimit>10</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>