<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Mobs/Cyclop_PearlBuff.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<lockScale>false</lockScale>
				<scale>0.5</scale>
				<fadeInTime>300</fadeInTime>
				<fadeOutTime>300</fadeOutTime>
				<locator>FROM_LOCATOR_NAME</locator>
				<locatorName>Slot_Back_LC</locatorName>
			</Item>
		</visualEffects>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Cyclop_PearlBuff_End.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.7</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Back_LC</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
