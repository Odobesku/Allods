<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <playWhile type="CreatureAnimationAction">
            <mode>LOOP</mode>
            <animations>
                <Item>instantSpellCastDirected</Item>
            </animations>
            <channel>CHANNEL_KNOCKDOWN</channel>
        </playWhile>
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visActionID>st01</visActionID>
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/BattleStation_FireRay.(VisObjectTemplate).xdb" />
                                <lockScale>true</lockScale>
                                <scale>1.5</scale>
                                <locator>Slot_Hand_R</locator>
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Spells/Fireball_AOE_projectile.(VisObjectTemplate).xdb" />
                <explosionFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb" />
                <theGe>1</theGe>
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_Hand_R</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </pointOnTarget>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>