<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739885221</resourceId>
	</Header>
	<Name href="Ritual.(BuffResource).Name.txt" />
	<Description href="Ritual.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/BloodLust01.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<interfaceHighPriority>true</interfaceHighPriority>
	<effects>
		<Item type="gameMechanics.elements.effects.NotStackableEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.HealthTrigger">
					<healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
						<multiplier>0.35</multiplier>
					</healthOn>
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Ritual.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsOn>
				</Item>
				<Item type="gameMechanics.elements.effects.PureDamageDoT">
					<parameters>
						<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
							<mul>0.051</mul>
							<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
								<stat type="gameMechanics.elements.stat.StatFullHealth" />
								<valueType>LongTerm</valueType>
							</mulCalcer>
						</scalerTarget>
						<scaleOnTick>true</scaleOnTick>
						<tickLength>3000</tickLength>
						<damagePerTick>1</damagePerTick>
					</parameters>
					<scaler type="gameMechanics.elements.scalers.TrivialScaler" />
				</Item>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
									<variable href="/Mechanics/Spells/Necromancer/BloodPool/BloodPool.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
									<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mulCalcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
											<ability href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
											<mul>1</mul>
										</mulCalcer>
									</scaler>
								</Item>
							</impacts>
						</Item>
					</impacts>
					<tick>4000</tick>
					<initialDelay>4000</initialDelay>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
					<spell href="Ritual.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.BuffInterceptor">
			<impactsOnAttach>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Ritual.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOnAttach>
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
					<groups>
						<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
					</groups>
				</Item>
			</predicates>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
