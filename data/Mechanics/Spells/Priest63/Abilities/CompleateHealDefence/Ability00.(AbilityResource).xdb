<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>207530</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
        </Item>
        <Item>
            <name>var1</name>
            <value var="value2" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Paladin/PaladinBlessedShield.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Heal/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                            <targetImpacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateHasSpell">
                                            <hideText>true</hideText>
                                            <spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Defence/Defence1.(SpellSingleTarget).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="CD.(BuffResource).xdb" />
                                            </predicate>
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                    </predicates>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                            <chanceCalcer type="gameMechanics.elements.calcers.LinearCalcer">
                                                <mul>0.01</mul>
                                                <mulCalcer type="gameMechanics.elements.calcers.FloatData">
                                                    <value var="value" />
                                                </mulCalcer>
                                                <sum>0</sum>
                                            </chanceCalcer>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Defence/Defence.(BuffResource).xdb" />
                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier var="value2" />
                                                    </durationScaler>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="CD.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </targetImpacts>
                            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                                <spells>
                                    <Item href="/Mechanics/Spells/Priest63/Spells/CompleteHealUpgrade/Spell01.(SpellSingleTarget).xdb" />
                                    <Item href="/Mechanics/Spells/Priest63/Spells/CompleteHeal/Spell01.(SpellSingleTarget).xdb" />
                                </spells>
                            </destination>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>