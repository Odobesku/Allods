<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.VisActionDelay">
            <time>2000</time>
          </Item>
          <Item type="client.Replica.VisActionList">
            <elements>
              <Item type="client.Replica.PostEffectVisAction">
                <userPostEffect href="/Spells/FX/InterfaceFX/Black.(UserPostEffect).xdb#xpointer(/client.VisualConstructor.UserPostEffect)" />
              </Item>
            </elements>
            <play>InSequence</play>
            <playWhile type="client.Replica.VisActionDelay">
              <time>2000</time>
            </playWhile>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
          </Item>
          <Item type="client.Replica.VisActionList">
            <elements>
              <Item type="client.Replica.CreatureAnimationAction">
                <advanced>
                  <autoHasten>
                    <mode>AUTOHASTEN_NONE</mode>
                    <timeToBeLeft>0</timeToBeLeft>
                  </autoHasten>
                  <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                  <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                  <offendType>NO_OFFEND</offendType>
                  <speed>0</speed>
                  <turnToTarget>TURN_DEFAULT</turnToTarget>
                  <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                  <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
                  <denyAutoHasten>false</denyAutoHasten>
                  <disableRandomFirstFrame>true</disableRandomFirstFrame>
                  <eventPlaybackEnd>false</eventPlaybackEnd>
                  <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                  <stopIfMoved>false</stopIfMoved>
                  <stopIfRotated>false</stopIfRotated>
                </advanced>
                <channel>CHANNEL_DEFAULT</channel>
                <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                <mode>DIE</mode>
                <use>USE_ANIMATIONS</use>
                <dontFreezePrecast>false</dontFreezePrecast>
              </Item>
              <Item type="client.Replica.CreatureEffectsAction">
                <category>EFFECT_DEFAULT</category>
                <visualEffects>
                  <Item>
                    <delay>0</delay>
                    <effectAnimations>
                      <mode>DIE</mode>
                    </effectAnimations>
                    <effectFx href="/World/Generic/World_Ships/KaniaShip01/KaniaWorldShip_02.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                    <fadeInTime>500</fadeInTime>
                    <fadeOutTime>500</fadeOutTime>
                    <scale>1</scale>
                    <fixPoint>false</fixPoint>
                    <lockScale>true</lockScale>
                    <muteFxSounds>false</muteFxSounds>
                    <ignoreParentRotation>false</ignoreParentRotation>
                    <locator>Global</locator>
                    <member>Default_Member</member>
                    <offset x="1.401298E-45" y="0" z="0" />
                    <rotation x="0" y="0" z="0" w="0" />
                    <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                  </Item>
                </visualEffects>
                <dontFade>false</dontFade>
                <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                <stopOnDeath>false</stopOnDeath>
              </Item>
              <Item type="client.Replica.CreatureIfMainAvatarRunAction">
                <action type="client.Replica.CameraParametersAction">
                  <parameters>
                    <fov>95</fov>
                    <maxDistance>120</maxDistance>
                    <minDistance>120</minDistance>
                  </parameters>
                </action>
                <checkCreature>Current</checkCreature>
              </Item>
            </elements>
            <play>Simultaneously</play>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
          </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.Sound2DAction">
        <visActionID>music</visActionID>
        <actionType>Music</actionType>
        <musicSourceMaxRadius>0</musicSourceMaxRadius>
        <reverbPreset />
        <sound>
          <name>Music/ZonesMusic/AC7_Siege</name>
          <project href="/SFX/Music/Music.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
        </sound>
        <forcedSoundStop>false</forcedSoundStop>
        <onlyForMainAvatar>true</onlyForMainAvatar>
        <resetGlobalParamsOnStop>true</resetGlobalParamsOnStop>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <postAction type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.PostEffectVisAction">
            <userPostEffect href="/Spells/FX/InterfaceFX/Black.(UserPostEffect).xdb#xpointer(/client.VisualConstructor.UserPostEffect)" />
          </Item>
        </elements>
        <play>InSequence</play>
        <playWhile type="client.Replica.VisActionDelay">
          <time>3000</time>
        </playWhile>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionStopAction">
        <stoppedActionID>music</stoppedActionID>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </postAction>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>