<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739921597</resourceId>
	</Header>
	<name href="Ability0.(AbilityResource).Name.txt" />
	<description href="Ability0.(AbilityResource).Description.txt" />
	<image href="/Interface/Icons/Special/Reputation/ReputationEnemy.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.SpellExtraImpacts">
			<targetImpacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Buff0.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Buff0.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.PostponedImpacts">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Buff0.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Buff0.(BuffResource).xdb" />
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ReturningImpact">
							<impacts>
								<Item type="gameMechanics.elements.impacts.PostponedImpacts">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
											<spell href="/Mechanics/Spells/War63/Abilities/Taunt/Spell0.(SpellSingleTarget).xdb" />
											<factor type="gameMechanics.elements.scalers.LinearScaler">
												<multiplier>1</multiplier>
											</factor>
											<sum type="gameMechanics.elements.calcers.LongData">
												<value>45000</value>
											</sum>
											<canStartCooldown>true</canStartCooldown>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</targetImpacts>
			<destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
				<spells>
					<Item href="/Mechanics/Spells/War63/Abilities/Taunt/Spell0.(SpellSingleTarget).xdb" />
				</spells>
			</destination>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
