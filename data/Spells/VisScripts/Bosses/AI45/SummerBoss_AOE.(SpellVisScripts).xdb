<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FixPointCaster>true</FixPointCaster>
			<FixPointTarget>true</FixPointTarget>
			<LocatorOnCaster>Global</LocatorOnCaster>
			<FXOnCaster>/Spells/FX/Mobs/DC_2BossDraconid_FireCharge.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<preconditional>false</preconditional>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<fixPoint var="FixPointCaster" />
								<scale>4</scale>
							</Item>
						</visualEffects>
						<stopOnDeath>false</stopOnDeath>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
