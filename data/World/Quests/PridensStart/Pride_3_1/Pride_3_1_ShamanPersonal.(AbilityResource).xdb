    <visualScript type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>emoteHoldIdle</Item>
                </animations>
                <channel>CHANNEL_BUFF</channel>
