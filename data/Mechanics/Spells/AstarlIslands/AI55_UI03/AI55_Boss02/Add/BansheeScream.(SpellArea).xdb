<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739864385</resourceId>
    </Header>
    <Name href="BansheeScream.(SpellArea).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Creatures/Pets/Banshee/Scream.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="BansheeScream.(SpellArea)_Name.txt.template" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Fleeing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>10</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>ASTRAL</element>
                                <damage>20</damage>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterOr">
                            <filters>
                                <Item type="gameMechanics.world.creature.AvatarFilter">
                                    <withPet>true</withPet>
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </predicates>
                                </Item>
                            </filters>
                        </filter>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>50</speed>
    <shape type="gameMechanics.constructor.schemes.spell.area.Hemisphere" />
    <radius>8</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>