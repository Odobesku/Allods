                                                    <ability href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/FallingDevices01.(AbilityResource).xdb" />
                                                </predicate>
                                                <calcerIf type="gameMechanics.elements.calcers.FloatData">
                                                    <value>2.5</value>
                                                </calcerIf>
                                                <calcerElse type="gameMechanics.elements.calcers.FloatData">
                                                    <value>0.5</value>
                                                </calcerElse>
                                            </Item>
                                        </summands>
                                    </mulCalcer>
                                </durationScaler>
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/DeviceFall.(MarkResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                        <ability href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/FallingDevices01.(AbilityResource).xdb" />
                                    </Item>
                                </predicates>
                                <elseImpacts>
                                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                        <impacts>
