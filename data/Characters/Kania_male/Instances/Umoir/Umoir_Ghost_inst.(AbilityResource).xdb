<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>77531</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/World/Quests/Umoir/U_5_03/U_5_03_mob_plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDeferredEffects">
            <delay type="gameMechanics.elements.calcers.LongData">
                <value>7000</value>
            </delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="/Maps/Umoir/SpawnTables/Umoir/Umoir_Inst_Guard.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                    </impactsOn>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectDeferredEffects">
                    <delay type="gameMechanics.elements.calcers.LongData">
                        <value>120000</value>
                    </delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactMobChat">
                                    <msg href="/World/Quests/Umoir/U_5_03/MobChat_07.(TextMessage).xdb#xpointer(/gameMechanics.world.TextMessage)" />
                                    <defaultSpeaker href="Umoir_Ghost_inst.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactStopSpawn">
                                    <table href="/Maps/Umoir/SpawnTables/Umoir/Umoir_Inst_Guard.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>U_inst_ghost_exit</scriptID>
                                            <map href="/Maps/Umoir/Inst_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </locator>
                                    </destination>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="/World/Quests/Umoir/U_5_03/U_5_03_chat_07.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </Item>
                            </impactsOn>
                        </Item>
                        <Item type="gameMechanics.elements.effects.EffectDeferredEffects">
                            <delay type="gameMechanics.elements.calcers.LongData">
                                <value>3000</value>
                            </delay>
                            <effects>
                                <Item type="gameMechanics.elements.effects.Switch">
                                    <impactsOn>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impactsOn>
                                </Item>
                            </effects>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDeferredEffects">
            <delay type="gameMechanics.elements.calcers.LongData">
                <value>3000</value>
            </delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="/World/Quests/Umoir/U_5_03/U_5_03_chat.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>