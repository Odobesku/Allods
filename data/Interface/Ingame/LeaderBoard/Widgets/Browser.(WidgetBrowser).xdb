<?xml version="1.0" encoding="UTF-8" ?>
<WidgetBrowser>
	<Name>Browser</Name>
	<FrontLayer href="/Interface/Ingame/LeaderBoard/Textures/BrowserFrontLayer.(WidgetLayerSimpleTexture).xdb#xpointer(/WidgetLayerSimpleTexture)" />
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>20</Pos>
			<HighPos>16</HighPos>
			<Size>50</Size>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>36</Pos>
			<HighPos>56</HighPos>
			<Size>50</Size>
		</Y>
	</Placement>
	<wheelScrollJsStep>50</wheelScrollJsStep>
	<helperScriptLoadOnStart>true</helperScriptLoadOnStart>
	<respawnNotifier>true</respawnNotifier>
	<analyzeHttpCodes>true</analyzeHttpCodes>
	<allowSpecialEvents>true</allowSpecialEvents>
</WidgetBrowser>
