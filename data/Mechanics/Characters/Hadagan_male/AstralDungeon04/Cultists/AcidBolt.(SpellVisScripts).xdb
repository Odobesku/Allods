<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirectedDispell</Item>
				</animations>
				<advanced>
					<speed>1.2</speed>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectPoison.(VisObjectTemplate).xdb" />
						<scale>1.25</scale>
						<fadeInTime>400</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectPoison.(VisObjectTemplate).xdb" />
						<scale>1.25</scale>
						<fadeInTime>400</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2000</time>
		</playWhile>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedBall</Item>
				</animations>
				<advanced>
					<animationKeysAction>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureEffectsAction">
										<visualEffects>
											<Item>
												<effectFx href="/Spells/FX/Spells/ReadySpellDirectPoisonWand_Cast.(VisObjectTemplate).xdb" />
												<fixPoint>true</fixPoint>
												<fadeInTime>400</fadeInTime>
												<fadeOutTime>300</fadeOutTime>
												<locator>Slot_Hand_R</locator>
											</Item>
										</visualEffects>
									</Item>
									<Item type="CreatureProjectileAction">
										<projectileFx href="/Spells/FX/Spells/NecromancerAcidBoltAbility.(VisObjectTemplate).xdb" />
										<explosionFx href="/Spells/FX/Spells/HitPoisonBig.(VisObjectTemplate).xdb" />
										<theGe>10</theGe>
										<pointOnCaster type="VisPointLocator">
											<locator>Slot_Hand_R</locator>
										</pointOnCaster>
										<pointOnTarget type="VisPointLocator">
											<locator>Slot_FX</locator>
										</pointOnTarget>
										<offendTime type="EffectOffendConstVelocity">
											<velocity>20</velocity>
										</offendTime>
									</Item>
								</elements>
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
