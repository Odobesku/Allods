                  <Item>
                    <parameter href="/Client/SlashCommands/MusicalInstruments/Gibberlings.(SoundParameter).xdb#xpointer(/client.Sound.SoundParameter)" />
                    <value>1</value>
                  </Item>
                </musicSourceParameters>
                <reverbPreset />
                <sound>
                  <name>Music/Ingame/RacesMusicInstrumrnts</name>
                  <project href="/SFX/Music/Music.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
                </sound>
                <forcedSoundStop>false</forcedSoundStop>
                <onlyForMainAvatar>false</onlyForMainAvatar>
                <resetGlobalParamsOnStop>true</resetGlobalParamsOnStop>
              </Item>
            </elements>
            <play>Simultaneously</play>
            <preconditional>false</preconditional>
