<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739965851</resourceId>
    </Header>
    <contextActionInfo>
        <priority>4</priority>
    </contextActionInfo>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/TwoSeaterMount.(ActionGroup).xdb" />
    </groups>
    <Name href="DismountPassenger.(SpellSingleTarget).Name.txt" />
    <Description href="DismountPassenger.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/IMMarkArrow.(UISingleTexture).xdb" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBearer" />
                <impacts>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="DropPassenger.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMounted">
                                <specificMount href="/Mechanics/Mounts/7thGrade/Mounts/ChopperDemilitarized.(MountResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="FriendMode.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="TakePassenger.(BuffResource).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="TakePassenger.(BuffResource).xdb" />
                            </Item>
                        </impactsIf>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="Burden_Passenger.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>