    <name href="Spell_Plante_Projectile.(ProjectileResource).Name.txt" />
    <visObject href="Spell_Plate_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>15000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
