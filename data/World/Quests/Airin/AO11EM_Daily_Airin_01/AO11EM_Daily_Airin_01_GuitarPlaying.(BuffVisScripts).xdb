<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.IfAction">
        <condition type="client.SLON.IfCreatureVisCharacter">
          <visCharList>
            <Item href="/Characters/Kania_female/KaniaFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Kania_male/KaniaMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Hadagan_female/HadaganFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
