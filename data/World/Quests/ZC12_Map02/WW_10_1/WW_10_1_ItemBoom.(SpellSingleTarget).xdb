<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739952176</resourceId>
	</Header>
	<Name href="WW_10_1_ItemBoom.(SpellSingleTarget).Name.txt" />
	<Description href="WW_10_1_ItemBoom.(SpellSingleTarget).Description.txt" />
	<visualScripts href="/Spells/VisScripts/Exploits/UseStanding.(ExploitVisScripts).xdb" />
	<prepareDuration>3000</prepareDuration>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
				<quest href="WW_10_1.xdb" />
				<status>Active</status>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
				<zone href="/Maps/ZC12_Map02/ScriptZones/WW_10_1_Obelisk4.(ScriptZone).xdb" />
			</Item>
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceActiveItem" />
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
				<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
				<data href="WW_10_1_Boom.(ClientData).xdb" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
				<quest href="WW_10_1.xdb" />
				<counterResource href="/Items/QuestItems/ZC12/WW_10_1_Artifact/WW_10_1_Artifact.(ItemResource).xdb" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
				<id href="Counter1.(QuestCountId).xdb" />
			</Item>
			<Item type="gameMechanics.elements.impacts.PostponedImpacts">
				<impacts>
					<Item type="gameMechanics.elements.impacts.RepeatedImpact">
						<impact type="gameMechanics.elements.impacts.ImpactSummon">
							<destination type="gameMechanics.map.destination.RelativePos" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="WW_10_1_ElementalBuff.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
									<delay>300000</delay>
									<impacts>
										<Item type="gameMechanics.elements.impacts.Disintegrate" />
									</impacts>
								</Item>
							</impacts>
							<object href="/Creatures/FireElemental/Instances/ZC12/WW_10_1_FireElemental.(MobWorld).xdb" />
							<pool href="/World/Quests/ZC12/WW_6_15/WW_6_15.(SummonPool).xdb" />
							<isPersonalPool>true</isPersonalPool>
						</impact>
						<count type="gameMechanics.elements.calcers.FloatData">
							<value>3</value>
						</count>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
