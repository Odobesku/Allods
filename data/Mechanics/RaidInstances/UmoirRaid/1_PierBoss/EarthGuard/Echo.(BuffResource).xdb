<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>225424</resourceId>
    </Header>
    <Name href="Echo.(BuffResource).Name.txt" />
    <Description href="Echo.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Psionic/SoundWave.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <nameTemplate href="Echo.(BuffResource).Name.txt" />
    <descTemplate href="Echo.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.15</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Echo.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsToPet">
            <effects>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>0.15</coeff>
                    </scaler>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>300000</duration>
    <stackLimit>100</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>