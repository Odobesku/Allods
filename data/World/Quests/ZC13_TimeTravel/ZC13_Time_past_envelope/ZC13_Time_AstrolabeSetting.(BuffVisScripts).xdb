<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.SLON.CreatureHangInAirAction">
				<hangHeight>13</hangHeight>
				<verticalSpeed>5</verticalSpeed>
			</Item>
			<Item type="client.Replica.CreatureReplaceAnimationsAction">
				<member>Default_Member</member>
				<onBottom>
					<animationsReplacements>
						<Item>
							<forAnimations>
								<Item>jump</Item>
								<Item>useControlStart</Item>
								<Item>useControlEnd</Item>
								<Item>useControlLoop</Item>
								<Item>useControlShuffleLeft</Item>
								<Item>useControlShuffleRight</Item>
							</forAnimations>
							<play>specialSitGround</play>
						</Item>
					</animationsReplacements>
					<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
				</onBottom>
				<onMount>
					<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
				</onMount>
				<onTop>
					<animationsReplacements>
						<Item>
							<forAnimations>
								<Item>jump</Item>
							</forAnimations>
							<play>useControlIdle</play>
						</Item>
					</animationsReplacements>
					<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
				</onTop>
				<replaceWhen>ReplaceAlways</replaceWhen>
				<restartOnVisualChange>false</restartOnVisualChange>
			</Item>
			<Item type="client.Replica.CreatureEffectsAction">
				<category>EFFECT_DEFAULT</category>
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectIce.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<scale>0.5</scale>
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<muteFxSounds>false</muteFxSounds>
						<ignoreParentRotation>false</ignoreParentRotation>
						<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
						<locator>Slot_Hand_L</locator>
						<member>Default_Member</member>
						<offset x="0" y="0" z="0" />
						<rotation x="0" y="0" z="0" />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
					<Item>
						<delay>0</delay>
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectIce.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<scale>0.5</scale>
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<muteFxSounds>false</muteFxSounds>
						<ignoreParentRotation>false</ignoreParentRotation>
						<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
						<locator>Slot_Hand_R</locator>
						<member>Default_Member</member>
						<offset x="0" y="0" z="0" />
						<rotation x="0" y="0" z="0" />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
					<Item>
						<delay>0</delay>
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<effectFx href="/Spells/FX/Spells/MageMeditationAbility_Loop.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<scale>0.5</scale>
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<muteFxSounds>false</muteFxSounds>
						<ignoreParentRotation>false</ignoreParentRotation>
						<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
						<locator>Global</locator>
						<member>Default_Member</member>
						<offset x="0" y="0" z="0" />
						<rotation x="0" y="0" z="0" />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
				</visualEffects>
				<dontFade>false</dontFade>
				<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
				<stopOnDeath>false</stopOnDeath>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>