<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739851891</resourceId>
	</Header>
	<name href="Summoner.(AbilityResource).Name.txt" />
	<visualScript type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>channelCastDirected</Item>
		</animations>
		<channel>CHANNEL_DEATH</channel>
	</visualScript>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectAllowNoVisibleTargets" />
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
									<mobs>
										<Item href="Summoner1.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									</mobs>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
									<projectileData>
										<moveType type="gameMechanics.world.projectile.MoveTypeDestination">
											<to type="gameMechanics.map.destination.DestinationModified">
												<destination type="gameMechanics.map.destination.DestinationLocator">
													<locator>
														<scriptID>End1</scriptID>
														<map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
													</locator>
												</destination>
												<modifiers>
													<Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
												</modifiers>
											</to>
										</moveType>
										<resource href="Bomb.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
									</projectileData>
									<pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
									<delay>7000</delay>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
											<projectileData>
												<moveType type="gameMechanics.world.projectile.MoveTypeDestination">
													<to type="gameMechanics.map.destination.DestinationModified">
														<destination type="gameMechanics.map.destination.DestinationLocator">
															<locator>
																<scriptID>End2</scriptID>
																<map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
															</locator>
														</destination>
														<modifiers>
															<Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
														</modifiers>
													</to>
												</moveType>
												<resource href="Bomb.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
											</projectileData>
											<pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
										</Item>
									</impacts>
								</Item>
							</impactsElse>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>14000</tick>
			<initialDelay>3000</initialDelay>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectNoAggro" />
		<Item type="gameMechanics.elements.effects.ImmunityToHarmfulSpells" />
	</effects>
	<disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>
