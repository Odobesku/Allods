                        </mulCalcer>
                    </durationScaler>
                </Item>
            </impactsOnIncrease>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="PoisonStrong01.(BuffResource).xdb" />
