<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739891806</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
								</moveType>
								<resource href="AI65_RandomDamage.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
							</projectileData>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="AI65_RandomDamage.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
			<stages>
				<Item>Start</Item>
			</stages>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
									<mobs>
										<Item href="AI65_FinalBoss04_DemonAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									</mobs>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="AI65_BalanceDamage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<spawnResource href="/Maps/AstralIsle65/SpawnTables/AI65_FinalBoss.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="AI65_1HpBabble.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</onEnter>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
								</moveType>
								<resource href="AI65_RandomDamageRage.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
							</projectileData>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="AI65_RandomDamageRage.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
			<stages>
				<Item>Start</Item>
			</stages>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
					<device>
						<scriptID>TeleportFinal</scriptID>
						<map href="/Maps/AstralIsle65/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</device>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="AoESummonPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
