    <visScript href="KtulhuScene.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactStopTalk" />
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>3000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.RandomDestination">
                                    <destinations>
                                        <Item type="gameMechanics.map.destination.DestinationLocator">
                                            <locator>
                                                <scriptID>CSP1</scriptID>
                                                <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                            </locator>
                                        </Item>
                                        <Item type="gameMechanics.map.destination.DestinationLocator">
                                            <locator>
                                                <scriptID>CSP2</scriptID>
                                                <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                            </locator>
                                        </Item>
                                        <Item type="gameMechanics.map.destination.DestinationLocator">
                                            <locator>
                                                <scriptID>CSP3</scriptID>
                                                <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                            </locator>
                                        </Item>
                                        <Item type="gameMechanics.map.destination.DestinationLocator">
                                            <locator>
                                                <scriptID>CSP4</scriptID>
                                                <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                            </locator>
                                        </Item>
                                    </destinations>
                                </destination>
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                                    <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                        <verticalRange min="0" max="0" />
                                        <horizontalRange min="0" max="4" />
                                    </Item>
                                    <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                        <radius type="gameMechanics.elements.calcers.FloatData">
                                            <value>4</value>
                                        </radius>
                                    </Item>
                                </modifiers>
                            </destination>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
