<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739884248</resourceId>
    </Header>
    <name href="FireSteps.(ProjectileResource).Name.txt" />
    <corpulence>2</corpulence>
    <visObject href="/Spells/FX/World/FirePuddle.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0</altitude>
    <lifeLengthCap>5000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>2</radius>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Elementals/AI66_FireElemental/AI66_FireElemental_add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Elementals/AI66_IceElemental/AI66_IceElemental_add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                            </mobs>
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    </predicates>
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="IceChains.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>FIRE</element>
                                    <damage>30</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>1000</initialDelay>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>