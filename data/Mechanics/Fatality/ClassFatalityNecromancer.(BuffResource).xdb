        <Prototype href="ClassFatality.Prototype.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Variables>
            <Buff_Name>ClassFatalityNecromancer.(BuffResource).Name.txt</Buff_Name>
