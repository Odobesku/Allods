<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>225389</resourceId>
    </Header>
    <Name href="FireElementalTarget.(BuffResource).Name.txt" />
    <Description href="FireElementalTarget.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/TepTarget.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/VisScripts/Bosses/TepPyramid/Spark_Buff.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <nameTemplate href="FireElementalTarget.(BuffResource).Name.txt" />
    <descTemplate href="FireElementalTarget.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="FireElementalMainBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                                    <radius>150</radius>
                                                    <affectHolder>false</affectHolder>
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="FireElementalTarget.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                        </Item>
                                                    </impacts>
                                                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                                        <filters>
                                                            <Item type="gameMechanics.world.creature.AliveFilter" />
                                                            <Item type="gameMechanics.world.creature.AvatarFilter" />
                                                        </filters>
                                                    </filter>
                                                    <targetsLimit>1</targetsLimit>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="FireElementalMainBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="FireElementalMainBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                                            <radius>150</radius>
                                                            <affectHolder>false</affectHolder>
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="FireElementalTarget.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                </Item>
                                                            </impacts>
                                                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                                                <filters>
                                                                    <Item type="gameMechanics.world.creature.AliveFilter" />
                                                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                                                </filters>
                                                            </filter>
                                                            <targetsLimit>1</targetsLimit>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="FireElementalTarget.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
