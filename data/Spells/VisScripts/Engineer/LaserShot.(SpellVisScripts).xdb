<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>channelCastDirected</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureEffectsAction" />
							<Item type="CreatureEffectsAction" />
						</elements>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile />
						<elements>
							<Item type="CreatureVisObjectComponentsAction">
								<member>Mount</member>
								<visObjComponents>
									<Item type="AttachedVisObjectComponent">
										<visObject href="/Spells/FX/Spells/Engineer_BarrelShot_ReadySpell.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<scale>0.8</scale>
										<offset x="0" y="0.6" z="0" />
										<locatorName>Slot_Special01</locatorName>
									</Item>
								</visObjComponents>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>channelCastDirectedEngineer</Item>
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
						</advanced>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureVisObjectComponentsAction">
								<member>Caster</member>
								<visObjComponents>
									<Item type="AttachedVisObjectComponent">
										<visObject href="/Spells/FX/Spells/Engineer_BarrelShot_ReadySpell.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<scale>0.6</scale>
										<offset x="0" y="0.6" z="0" />
										<locatorName>Slot_Hand_L</locatorName>
									</Item>
								</visObjComponents>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>DIE</mode>
						<animations>
							<Item>attack</Item>
						</animations>
						<channelOverrideScript />
						<advanced>
							<offendType>ONEOFFEND_ONETARGET</offendType>
						</advanced>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile />
						<elements>
							<Item type="CreatureChannelDirectAction">
								<channelingFx href="/Spells/FX/Spells/Engineer_LaserShot_Channe.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fxLength>20</fxLength>
								<startPoint type="VisPointLocator">
									<locator>FROM_LOCATOR_NAME</locator>
									<member>Mount</member>
									<locatorName>Slot_Special01</locatorName>
								</startPoint>
								<endPoint type="VisPointLocator">
									<locator>Head</locator>
								</endPoint>
								<offendTime />
								<secondaryTargetParams>
									<channelingFx href="" />
									<offendTime />
								</secondaryTargetParams>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>DIE</mode>
						<animations>
							<Item>spellCastDirectedEngineer</Item>
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
							<offendType>ONEOFFEND_ONETARGET</offendType>
						</advanced>
					</Item>
					<Item type="VisActionList">
						<playWhile />
						<elements>
							<Item type="CreatureChannelDirectAction">
								<channelingFx href="/Spells/FX/Spells/Engineer_LaserShot_Channe.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fxLength>20</fxLength>
								<startPoint type="VisPointLocator">
									<locator>Slot_Hand_L</locator>
								</startPoint>
								<endPoint type="VisPointLocator">
									<locator>Head</locator>
								</endPoint>
								<offendTime />
								<secondaryTargetParams>
									<channelingFx href="" />
									<offendTime />
								</secondaryTargetParams>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="VisActionDelay">
						<time>200</time>
					</Item>
					<Item type="CreatureEffectsOnTarget">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Engineer_LaserShot_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<fadeOutTime>1000</fadeOutTime>
								<locator>Head</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
