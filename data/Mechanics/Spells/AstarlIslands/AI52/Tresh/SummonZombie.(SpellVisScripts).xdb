<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Variables>
            <HitPostFxOnTarget />
            <FixPointTarget>true</FixPointTarget>
            <LocatorNameOnTarget />
            <LocatorOnTarget />
        </Variables>
    </Header>
    <Description href="/Spells/VisScripts/Prototypes2/Direct.txt" />
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>2000</delay>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
