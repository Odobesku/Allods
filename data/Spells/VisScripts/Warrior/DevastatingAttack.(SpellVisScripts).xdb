<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MeleeAttack.(SpellVisScripts).xdb" />
		<Variables>
			<Trail>/Spells/FX/InterfaceFX/TrailBlue.(TrailTemplate).xdb#xpointer(/TrailTemplate)</Trail>
			<LocatorOnTargets>Slot_Global</LocatorOnTargets>
			<FxOnTargets>/Spells/FX/Spells/WarriorDevastatingAttack.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTargets>
			<UseAnimation>USE_ANIMATIONS</UseAnimation>
			<Animation>stunStrike</Animation>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="Animation" />
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
