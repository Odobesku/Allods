<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>237108</resourceId>
    </Header>
    <Name href="" />
    <Description href="" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="ColdArmor.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                            <damage>1</damage>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier>0.3</multiplier>
                                </mulCalcer>
                            </scalerTarget>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                            <damage>1</damage>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier>0.1</multiplier>
                                </mulCalcer>
                            </scalerTarget>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.WorldDistributor" />
                            <data href="AddDot.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>