<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Mobs/ArchitectBossCaster_SuffocateChannel.(VisObjectTemplate).xdb" />
                <fxLength>2</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </endPoint>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>