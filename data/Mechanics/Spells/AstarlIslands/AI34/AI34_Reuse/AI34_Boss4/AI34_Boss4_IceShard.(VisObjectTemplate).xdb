<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>250</fadeInMS>
    <fadeOutMS>250</fadeOutMS>
    <geometry href="/Spells/FX/Spells/Parts/Dummy.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <scale>1</scale>
    <sound />
    <visObjComponents>
        <Item type="AttachedVisObjectComponent">
            <VisualObjectComponentID>precast</VisualObjectComponentID>
            <locatorName></locatorName>
            <offset x="0" y="0" z="0" />
            <priority>0</priority>
            <rotation x="0" y="0" z="0" w="1" />
            <scale>1</scale>
            <visObject href="/Mechanics/Spells/AstarlIslands/AI34/AI34_Reuse/AI34_Boss4/AI34_Boss4_IceShardDecal.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
            <isPortraitEnabled>true</isPortraitEnabled>
            <lockScale>false</lockScale>
            <scaleFromGlobal>false</scaleFromGlobal>
            <skipSound>false</skipSound>
        </Item>
        <Item type="DelayComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <component type="AlignCollisionComponent">
                <VisualObjectComponentID></VisualObjectComponentID>
                <endHeight>-5</endHeight>
                <locatorName></locatorName>
                <offset x="0" y="0" z="0" />
                <scale>1</scale>
                <startHeight>5</startHeight>
                <visObject href="/Mechanics/Spells/AstarlIslands/AI34/AI34_Reuse/AI34_Boss4/AI34_Boss4_IceShardHit.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                <alignNormal>true</alignNormal>
                <checkNormal>true</checkNormal>
                <fixedPosition>false</fixedPosition>
                <getPrevObjectHeight>false</getPrevObjectHeight>
                <lockScale>false</lockScale>
                <placeAlways>false</placeAlways>
            </component>
            <timeMax>1.2</timeMax>
            <timeMin>1.2</timeMin>
            <skipLoading>true</skipLoading>
        </Item>
        <Item type="DelayComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <component type="StopVisObjectComponents">
                <VisualObjectComponentID></VisualObjectComponentID>
                <stopedComponentIDs>
                    <Item>precast</Item>
                </stopedComponentIDs>
            </component>
            <timeMax>2</timeMax>
            <timeMin>2</timeMin>
            <skipLoading>true</skipLoading>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>