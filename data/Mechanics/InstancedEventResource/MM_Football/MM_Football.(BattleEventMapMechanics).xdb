		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/LoginEventNew/LoginEventNew02_A1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/LoginEventNew/LoginEventNew03_A1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
