                    <stat type="gameMechanics.elements.stat.SpecialStat">
                        <stat href="/Mechanics/SpecialStats/ColldownDecreaser.(SpecialStatResource).xdb" />
                    </stat>
                    <value>150</value>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Bard.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
                            <summand>2</summand>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Mage.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Mage63/Abilities/ElementalPower/FireVar.(VariableResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Mage63/Abilities/ElementalPower/IceVar.(VariableResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Mage63/Abilities/ElementalPower/LightningVar.(VariableResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Paladin.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Paladin63/Abilities/Canons/LightCanon.(VariableResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Paladin63/Abilities/Canons/PurityCanon.(VariableResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>5000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>