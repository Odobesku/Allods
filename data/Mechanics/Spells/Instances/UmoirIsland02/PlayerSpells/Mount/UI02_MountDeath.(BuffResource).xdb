	</Header>
	<visScript href="UI02_MountDeath.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>2000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactSummon">
									<destination type="gameMechanics.map.destination.RelativeRotatePos">
										<base type="gameMechanics.map.destination.SelfPosDestination" />
										<offset>30</offset>
										<yaw type="constructor.basicElements.AngleDegrees">
											<value>1</value>
										</yaw>
										<turn>ToBase</turn>
									</destination>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
											<delay>2000</delay>
											<impacts>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="IgorGoTo.(BuffResource).xdb" />
												</Item>
											</impacts>
										</Item>
									</impacts>
									<object href="/Creatures/ZombieWarrior/Instances/UmoirIsland02/UI02_Igor.(MobWorld).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="IgorStop.(BuffResource).xdb" />
