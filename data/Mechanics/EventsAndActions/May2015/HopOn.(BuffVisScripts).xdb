<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<Header>
		<isPrototype>true</isPrototype>
	</Header>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureMountVisAction">
				<visualMount hrefvar="visualMount" />
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>mountRideWalk</Item>
					<Item>walk</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
				<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
			</Item>
			<Item type="CreatureDisableEmotesAction" />
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>mountRideIdle</play>
							<forAnimations>
								<Item>specialJump</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>mountRideIdle</play>
							<forAnimations>
								<Item>specialJump</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
