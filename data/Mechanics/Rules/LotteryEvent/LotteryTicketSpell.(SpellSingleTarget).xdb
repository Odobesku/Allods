                </predicate>
                <clientData href="LotteryNotActive.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="itemService.elements.lottery.ImpactAddLotteryTicket" />
        </casterImpacts>
    </mechanics>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>