<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>Skip</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>80</HighPos>
            <Size>128</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>48</HighPos>
            <Size>40</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>20</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing></reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag>label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ClientImageShowcase/ButtonHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="1" y="2"/>
            <Reaction>skip_pressed</Reaction>
            <ReactionRightClick>skip_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted>
                <FormatFileRef href="/Interface/Ingame/ClientImageShowcase/SkipHighlighted.txt"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ClientImageShowcase/Skip.txt"/>
                <LayerMain href="/Interface/Ingame/ClientImageShowcase/ButtonNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ClientImageShowcase/ButtonPressed.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ClientImageShowcase/SkipLabel.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
