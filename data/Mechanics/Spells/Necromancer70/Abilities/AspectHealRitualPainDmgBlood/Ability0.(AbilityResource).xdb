<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>198634</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>cd</name>
            <value var="cd" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercentAbsMinus1</formula>
            </scaler>
        </Item>
        <Item>
            <name>dur</name>
            <value var="dur" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/PhysDmg.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <casterImpacts>
                <Item type="gameMechanics.elements.impacts.ExecuteImpactsUnderEffects">
                    <effects>
                        <Item type="gameMechanics.elements.abilities.DieHardObserver">
                            <dieHardBuff href="/Mechanics/Spells/Necromancer70/Abilities/SafeBuff/Safebuff.(BuffResource).xdb" />
                            <impactsOnAttach>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="/Mechanics/Spells/Necromancer70/Abilities/SafeBuff/Safebuff.(BuffResource).xdb" />
                                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOnAttach>
                            <suppressDamage>true</suppressDamage>
                        </Item>
                    </effects>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.PureDamage">
                            <damage var="damage" />
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                            </scaler>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="BloodRegen.(BuffResource).xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier var="dur" />
                    </durationScaler>
                </Item>
            </casterImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/Necromancer70/Abilities/RitualPain/Spell01.(SpellSingleTarget).xdb" />
                </spells>
            </destination>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
            <spell href="/Mechanics/Spells/Necromancer70/Abilities/RitualPain/Spell01.(SpellSingleTarget).xdb" />
            <factor var="cd" />
        </Item>
    </effects>
    <ranks>
        <Item href="Ability001.xdb" />
        <Item href="Ability002.xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>