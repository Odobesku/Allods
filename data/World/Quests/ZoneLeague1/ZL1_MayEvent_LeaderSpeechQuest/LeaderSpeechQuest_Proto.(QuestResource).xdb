<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.QuestResource>
    <Header>
        <resourceId>739870282</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <finisher type="gameMechanics.elements.quest.QuestFinisherMob">
        <mobWorld hrefvar="QuestFinisherMob" />
    </finisher>
    <startConditions>
        <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
            <rule href="/Mechanics/Rules/MayEvent/Rule.xdb" />
        </Item>
    </startConditions>
    <counters>
        <Item type="gameMechanics.elements.quest.QuestCountAltCurrency">
            <limit>400</limit>
            <currency href="/Mechanics/AlternativeCurrencies/Events/MayEventCoupon.(AlternativeCurrency).xdb" />
        </Item>
        <Item type="gameMechanics.elements.quest.QuestCountItem">
            <autoRelatedItems>
                <Item href="/Items/QuestItems/EventMay/LeaderSpeechQuest/LeaderSpeechQuestStart.(ItemResource).xdb" />
            </autoRelatedItems>
            <limit>1</limit>
            <items>
                <Item href="/Items/QuestItems/EventMay/LeaderSpeechQuest/LeaderSpeechQuestStart.(ItemResource).xdb" />
            </items>
            <removeOnAbandon>false</removeOnAbandon>
        </Item>
    </counters>
    <reward>
        <currencies>
            <Item>
                <currency href="/Mechanics/AlternativeCurrencies/Events/MayEventMedal.(AlternativeCurrency).xdb" />
                <value>1</value>
            </Item>
        </currencies>
    </reward>
    <sharing>
        <onRequest>false</onRequest>
    </sharing>
    <groups>
        <Item href="/Mechanics/QuestGroups/Events/MayEvent.(QuestGroup).xdb" />
        <Item href="/Mechanics/QuestGroups/Events/AllEvents.(QuestGroup).xdb" />
        <Item href="/Mechanics/QuestGroups/Events/Repitable.(QuestGroup).xdb" />
    </groups>
    <repeatPolicy type="gameMechanics.constructor.schemes.quest.RepeatPolicyInstant" />
    <canBeSkipped>false</canBeSkipped>
    <requiredLevel type="gameMechanics.formulas.IntConstantValue">
        <value>20</value>
    </requiredLevel>
    <level type="gameMechanics.formulas.IntConstantValue">
        <value>20</value>
    </level>
</gameMechanics.constructor.schemes.quest.QuestResource>