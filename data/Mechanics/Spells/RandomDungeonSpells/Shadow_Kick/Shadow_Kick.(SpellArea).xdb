<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739907537</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/ProceduralDungeon/Groups/Shadow.(ActionGroupElement).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroupElement)" />
    </groups>
    <element>ASTRAL</element>
    <Name href="Shadow_Kick.(SpellArea).Name.txt" />
    <visualScripts href="Shadow_Kick.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <prepareDuration>1000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                </predicates>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                <minDamage>10</minDamage>
                <maxDamage>10</maxDamage>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                <time>500</time>
                <distance>20</distance>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>