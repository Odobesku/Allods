<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>sweepingSlam</Item>
				</animations>
				<channel>CHANNEL_HITCRITICAL</channel>
			</Item>
			<Item type="CreatureTrailAction">
				<mainHandTrail href="/Spells/FX/InterfaceFX/TrailCleave.(TrailTemplate).xdb#xpointer(/TrailTemplate)" />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/WarriorSweepingSlamAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.6</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<playOnTargets>
		<specialAction type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/HitMeleeCrit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<locator>Slot_FX</locator>
				</Item>
			</visualEffects>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
