<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739932788</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="GroupPoisonBuff.(BuffResource).Name.txt" />
    <Description href="GroupPoisonBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/ThePoisonousCloud.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Engineer/AcidHands.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <targetImpacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>ACID</element>
                    <damage>1</damage>
                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                        <scalers>
                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="externalCalcer" />
                                </mulCalcer>
                            </Item>
                            <Item type="gameMechanics.elements.scalers.MagicScaler" />
                        </scalers>
                    </scaler>
                </Item>
            </targetImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationGroups">
                <groups>
                    <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
                </groups>
            </destination>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Groups/EngBardNatureDamageBuff.(ActionGroup).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <ranks>
        <Item href="GroupPoisonBuff01.(BuffResource).xdb" />
        <Item href="GroupPoisonBuff02.(BuffResource).xdb" />
        <Item href="GroupPoisonBuff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ClassesGroupBuffs.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/EngBardNatureDamageBuff.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>