    <spellEntries>
        <Item>
            <spell href="BossAvatar_teleport.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
        </Item>
        <Item>
            <spell href="BossAvatar_Ray.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort">
                    <avatarsFirst>true</avatarsFirst>
                </sortTargets>
                <targetConditionChecks>
                    <Item>
                        <binaryPredicates>
                            <Item type="gameMechanics.elements.predicates.PredicateDistance">
                                <range min="8" max="80" />
                            </Item>
                        </binaryPredicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
        </Item>
        <Item>
            <spell href="BossAvatar_Smite.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByAggro">
                    <startFrom>1</startFrom>
                    <shuffle>true</shuffle>
                </sortTargets>
                <helpfulRadius>60</helpfulRadius>
                <targetConditionChecks>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
        </Item>
        <Item>
            <spell href="BossAvatar_Cleave.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
        </Item>
    </spellEntries>
</gameMechanics.world.mob.MobAbilityKit>