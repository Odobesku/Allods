<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>189218828</resourceId>
    </Header>
    <visualScripts href="/Spells/VisScripts/Creatures/Melee/StrongAttack.xdb#xpointer(/SpellVisScripts)" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics type="gameMechanics.constructor.schemes.spell.SpellMechanics">
        <cooldown>
            <duration>20000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>2000</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>50</radius>
                                <affectGroup>Enemies</affectGroup>
                                <affectHolder>true</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>3</multiplier>
                                        </durationScaler>
                                        <allowOverrideCaster>false</allowOverrideCaster>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterOr">
                                    <filters>
                                        <Item type="gameMechanics.world.creature.AvatarFilter" />
                                        <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </filters>
                                </filter>
                                <targetsLimit>0</targetsLimit>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>