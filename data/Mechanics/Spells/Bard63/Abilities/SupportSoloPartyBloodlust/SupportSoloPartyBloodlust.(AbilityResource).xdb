	</effects>
	<ranks>
		<Item href="SupportSoloPartyBloodlust01.(AbilityResource).xdb" />
		<Item href="SupportSoloPartyBloodlust02.(AbilityResource).xdb" />
		<Item href="SupportSoloPartyBloodlust03.(AbilityResource).xdb" />
