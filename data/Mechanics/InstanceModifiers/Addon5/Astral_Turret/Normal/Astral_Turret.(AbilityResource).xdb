<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>251879</resourceId>
    </Header>
    <isHidden>true</isHidden>
    <visualScript type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Spells/EngineerHive_Aura.(VisObjectTemplate).xdb" />
                <lockScale>true</lockScale>
                <scale>1.5</scale>
                <locator>Slot_Global</locator>
            </Item>
        </visualEffects>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/Mechanics/InstanceModifiers/Addon5/Link/Normal/Astral_Turret.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>18000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>