        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>1000</duration>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.CalcerIf">
                    <predicate type="gameMechanics.elements.predicates.PredicateEquipped">
                        <dressType>AMMO</dressType>
                    </predicate>
                    <calcerIf type="gameMechanics.elements.calcers.LinearCalcer">
                        <mul>-20</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                            <dressSlot>AMMO</dressSlot>
                        </mulCalcer>
                        <sum>0</sum>
                    </calcerIf>
                    <calcerElse type="gameMechanics.elements.calcers.FloatData">
                        <value>0</value>
                    </calcerElse>
                </mulCalcer>
                <sum>300</sum>
            </scaler>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateEquipped">
                        <dressType>AMMO</dressType>
                        <itemClass href="/Mechanics/ItemClasses/Other_InfiniteTeardrop.(ItemClass).xdb" />
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.constructor.basicElements.ResourceUniversal" />
                <resourceElse type="gameMechanics.elements.resources.ResourceDressItem">
                    <slot>AMMO</slot>
                    <count>4</count>
                </resourceElse>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff hrefvar="buff" />
                <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mul>0.5</mul>
                    <mulCalcer type="gameMechanics.elements.calcers.CalcerIf">
                        <predicate type="gameMechanics.elements.predicates.PredicateEquipped">
                            <dressType>AMMO</dressType>
                        </predicate>
                        <calcerIf type="gameMechanics.elements.calcers.ItemQualityCalcer">
                            <dressSlot>AMMO</dressSlot>
                        </calcerIf>
                        <calcerElse type="gameMechanics.elements.calcers.FloatData">
                            <value>0</value>
                        </calcerElse>
                    </mulCalcer>
                    <sum var="baseDuration" />
                </durationScaler>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>