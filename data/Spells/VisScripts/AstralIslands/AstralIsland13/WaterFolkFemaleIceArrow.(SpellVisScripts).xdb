<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes2/Mob_Projectile.(SpellVisScripts).xdb" />
		<Variables>
			<PreCastAnimation>readySpell</PreCastAnimation>
			<FxProjectile>/Spells/FX/Spells/MageIceArrowAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxProjectile>
			<PreCastAnimationMode>LOOP</PreCastAnimationMode>
			<FxOnTarget>/Spells/FX/Spells/HitIce.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTarget>
			<LocatorNameOnCaster />
			<LocatorOnTarget>Slot_BodyFX</LocatorOnTarget>
			<PreCastFX>/Spells/VisScripts/Prototypes2/PreCastFX.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastFX>
			<DelayCasterFX>0</DelayCasterFX>
			<HitDelay>0</HitDelay>
			<FixPointCaster>false</FixPointCaster>
			<Ge>0</Ge>
			<FxOnHands>ReadySpellDirectIceBig.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<LocatorNameOnTarget />
			<FxOnCaster />
			<HitPostFxOnTarget />
			<Animation>spellCastDirected</Animation>
			<LocatorOnCaster>Slot_BodyFX</LocatorOnCaster>
		</Variables>
	</Header>
	<actionBarStart type="CreatureAnimationAction">
		<animations>
			<Item var="PreCastAnimation" />
		</animations>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="Animation" />
				</animations>
			</Item>
			<Item skiped="" />
		</elements>
	</launch>
</SpellVisScripts>
