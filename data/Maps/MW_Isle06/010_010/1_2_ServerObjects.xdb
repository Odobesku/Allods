		<Item type="gameMechanics.map.spawn.recaptureable.RecaptureablePlayerSpawnPlace">
			<scriptID>Start_blue</scriptID>
			<place>
				<coord x="94.7121" y="67.087" z="30.221" />
				<yaw>1.57492</yaw>
				<faction href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
			</place>
			<device href="/Items/InteractiveObjects/MW_Isle06/Resp_Blue_01.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
			<respawnLocator>
				<scriptID>Blue_enter_01</scriptID>
				<map href="/Maps/MW_Isle06/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
			</respawnLocator>
			<autoCapturePeriodSec>80</autoCapturePeriodSec>
		</Item>
		<Item type="gameMechanics.map.spawn.recaptureable.RecapturablePlace">
			<scriptID>MW01_Flag02</scriptID>
			<place>
				<coord x="248.266" y="249.432" z="-8.61015" />
				<yaw>1.57492</yaw>
				<faction href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
			</place>
			<device href="/Items/InteractiveObjects/MW_Isle06/Point_02.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
			<autoCapturePeriodSec>80</autoCapturePeriodSec>
			<steleImpactsOnOwnerChange>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="/Items/InteractiveObjects/MW_Isle01/PointCapture_Impacts.(ImpactListGenericResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
				</Item>
			</steleImpactsOnOwnerChange>
			<stopAssaultPredicates>
				<Item type="gameMechanics.constructor.basicElements.PredicateOr">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
							<predicates>
								<Item type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventRound">
									<round>1</round>
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateRecapturableOwner">
									<owner href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
								</Item>
							</predicates>
						</Item>
						<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
							<predicates>
								<Item type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventRound">
									<round>2</round>
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateRecapturableOwner">
									<owner href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
								</Item>
							</predicates>
						</Item>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.predicates.PredicateGreater">
								<lhs type="gameMechanics.elements.calcers.CheckPointAttackersCalcer" />
								<rhs type="gameMechanics.elements.calcers.CheckPointDefendersCalcer" />
							</predicate>
						</Item>
					</predicates>
				</Item>
			</stopAssaultPredicates>
			<strategy>Constant</strategy>
			<defendCalcer type="gameMechanics.elements.calcers.FloatData">
				<value>1</value>
			</defendCalcer>
			<attackCalcer type="gameMechanics.elements.calcers.FloatData">
				<value>1</value>
			</attackCalcer>
			<achievementResource href="/Mechanics/InstancedEventResource/MW_01/MegaWar_01.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
			<achievementCount type="gameMechanics.elements.calcers.LongData">
				<value>10</value>
			</achievementCount>
			<periodicUpdateTick>1000</periodicUpdateTick>
		</Item>
	</objects>
</gameMechanics.map.PatchObjects>
