<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>280771587</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/RemortSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/Dispels.xdb" />
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
	<Name href="Spell_Name.txt" />
	<Description href="Spell_Desc.txt" />
	<image href="/Interface/Icons/Spells/Bard/ConsumeMagic.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Bard/RemortBard_Dispel.(SpellVisScripts).xdb" />
	<sysName>CategoryRemort</sysName>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<level>1</level>
	<prepareDuration>1500</prepareDuration>
	<modifiers>
		<Item type="gameMechanics.elements.spell.RaiseRepelType">
			<repelType>IGNORE</repelType>
		</Item>
	</modifiers>
	<iffPolicy>Enemies</iffPolicy>
	<launchWhenReady>true</launchWhenReady>
	<mechanics>
		<cooldown>
			<duration>1000</duration>
			<scaler type="gameMechanics.elements.scalers.ScalerExternal">
				<scalerResource href="ConsumeMagic.(ScalerResource).xdb" />
			</scaler>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
				<groups>
					<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
				</groups>
				<checkHarmful>false</checkHarmful>
			</Item>
		</targetConditions>
		<channelingMechanics>
			<channelingBuff href="ChannelBuff.(BuffResource).xdb" />
			<finishImpacts>
				<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
					<impacts>
						<Item type="gameMechanics.elements.impacts.DispelMagic">
							<magics href="/Mechanics/Spells/Groups/Magics.xdb" />
						</Item>
					</impacts>
				</Item>
			</finishImpacts>
		</channelingMechanics>
		<casterImpacts>
			<Item type="gameMechanics.constructor.basicElements.ImpactList">
				<impactsResource href="/Mechanics/Spells/Remort/RemortSpellsCD.(ImpactListResource).xdb" />
			</Item>
		</casterImpacts>
	</mechanics>
	<speed>0</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
