<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.world.ClientData>
	<Header>
		<resourceId>740154066</resourceId>
	</Header>
	<customData type="client.Replica.CreatureVisActionData">
		<action type="client.Replica.VisActionList">
			<elements>
				<Item type="client.SLON.CreatureSetOvertipAction">
					<overtip href="/Interface/Ingame/ContextRelatedTextures/Emoticons/Shy.(UITexture).xdb#xpointer(/UITexture)" />
					<showOnMainAvatar>false</showOnMainAvatar>
				</Item>
				<Item type="client.Replica.CreatureTurnToMainAvatarAction" />
				<Item type="client.SLON.IfAction">
					<condition type="client.SLON.IfCreatureVisCharacter">
						<visCharList>
							<Item href="/Creatures/TropicalPet/TropicalPet.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
							<Item href="/Creatures/TropicalPet/TropicalPetTeen.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
						</visCharList>
						<checkIsInTheList>true</checkIsInTheList>
						<checkOnStartOnly>true</checkOnStartOnly>
					</condition>
					<elseAction type="client.Replica.VisActionList">
						<elements>
							<Item type="client.Replica.CreatureAnimationAction">
								<advanced>
									<autoHasten>
										<mode>AUTOHASTEN_NONE</mode>
										<timeToBeLeft>0</timeToBeLeft>
									</autoHasten>
									<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
									<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
									<offendType>NO_OFFEND</offendType>
									<speed>0</speed>
									<turnToTarget>TURN_DEFAULT</turnToTarget>
									<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
									<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
									<denyAutoHasten>false</denyAutoHasten>
									<disableRandomFirstFrame>true</disableRandomFirstFrame>
									<eventPlaybackEnd>false</eventPlaybackEnd>
									<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
									<stopIfMoved>false</stopIfMoved>
									<stopIfRotated>false</stopIfRotated>
								</advanced>
								<animations>
									<Item>specialJump</Item>
								</animations>
								<channel>CHANNEL_DEFAULT</channel>
								<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
								<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
								<mode>DIE</mode>
								<use>USE_ANIMATIONS</use>
								<dontFreezePrecast>false</dontFreezePrecast>
							</Item>
							<Item type="client.Replica.Sound2DAction">
								<actionType>Simple</actionType>
								<musicSourceMaxRadius>0</musicSourceMaxRadius>
								<sound>
									<name>World/Zones/TropicalAtoll/KletunSong</name>
									<project href="/SFX/World/World.(FMODProject).xdb#xpointer(/FMODProject)" />
								</sound>
								<forcedSoundStop>false</forcedSoundStop>
								<onlyForMainAvatar>false</onlyForMainAvatar>
								<resetGlobalParamsOnStop>true</resetGlobalParamsOnStop>
							</Item>
						</elements>
						<play>Simultaneously</play>
						<playWhile type="client.Replica.VisActionDelay">
							<time>3000</time>
						</playWhile>
						<preconditional>false</preconditional>
						<restartOnVisualChange>false</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
					</elseAction>
					<onBreak>
						<breakEnabled>false</breakEnabled>
					</onBreak>
					<thenAction type="client.Replica.CreatureAnimationAction">
						<advanced>
							<autoHasten>
								<mode>AUTOHASTEN_NONE</mode>
								<timeToBeLeft>0</timeToBeLeft>
							</autoHasten>
							<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
							<offendType>NO_OFFEND</offendType>
							<speed>0</speed>
							<turnToTarget>TURN_DEFAULT</turnToTarget>
							<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
							<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
							<denyAutoHasten>false</denyAutoHasten>
							<disableRandomFirstFrame>true</disableRandomFirstFrame>
							<eventPlaybackEnd>false</eventPlaybackEnd>
							<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
							<stopIfMoved>false</stopIfMoved>
							<stopIfRotated>false</stopIfRotated>
						</advanced>
						<animations>
							<Item>emoteDance</Item>
						</animations>
						<channel>CHANNEL_DEFAULT</channel>
						<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
						<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
						<mode>DIE</mode>
						<use>USE_ANIMATIONS</use>
						<dontFreezePrecast>false</dontFreezePrecast>
