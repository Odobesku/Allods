<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>jumpStart</Item>
					<Item>jump</Item>
				</animations>
				<channel>CHANNEL_BUFF</channel>
				<channelOverrideMode>OVERRIDE_STOP</channelOverrideMode>
				<channelOverrideControllers>TOP_ONLY</channelOverrideControllers>
				<advanced>
					<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/Exoskeleton_Equip_FX01.(VisObjectTemplate).xdb" />
				<scale>2.25</scale>
				<fadeInTime>750</fadeInTime>
				<fadeOutTime>1000</fadeOutTime>
				<locator>Slot_Belt</locator>
				<locatorName />
			</Item>
			<Item>
				<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownIce.(VisObjectTemplate).xdb" />
				<effectAlias href="" />
				<scale>1</scale>
				<fadeInTime>750</fadeInTime>
				<fadeOutTime>1000</fadeOutTime>
				<locator>Slot_Global</locator>
				<offendTime />
			</Item>
			<Item>
				<effectFx href="/Spells/FX/Spells/Exoskeleton_Equip_FX01_Items01.(VisObjectTemplate).xdb" />
				<lockScale>false</lockScale>
				<scale>0.8</scale>
				<fadeInTime>250</fadeInTime>
				<fadeOutTime>500</fadeOutTime>
				<locator>Slot_Global</locator>
				<offset z="0.2" />
			</Item>
		</visualEffects>
	</wholeCasting>
	<actionBarComplite type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Exoskeleton_Equip_FX02.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<scale>0.8</scale>
						<locator>Slot_Global</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>50</time>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>jump</Item>
						</animations>
						<channel>CHANNEL_BUFF</channel>
						<channelOverrideMode>OVERRIDE_STOP</channelOverrideMode>
						<channelOverrideScript />
						<channelOverrideControllers>TOP_ONLY</channelOverrideControllers>
					</Item>
					<Item type="CreatureAnimationStopAction">
						<channel>CHANNEL_BUFF</channel>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>jumpEnd</Item>
						</animations>
						<channel>CHANNEL_ACTIONBAR</channel>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
						</advanced>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarComplite>
	<launch />
</SpellVisScripts>
