<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739919967</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
    </groups>
    <element>HOLY</element>
    <Name href="Spell00.(SpellArea).Name.txt" />
    <Description href="Spell00.(SpellArea).Description.txt" />
    <image href="/Interface/Icons/Spells/Paladin/LightInfusionUpgrade.(UISingleTexture).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <targetType>STTPoint</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Spell01.(SpellArea).xdb" />
        <Item href="Spell02.(SpellArea).xdb" />
        <Item href="Spell03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint">
                        <yawDelta type="constructor.basicElements.AngleDegrees">
                            <value>180</value>
                        </yawDelta>
                    </destination>
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierTrailFrom">
                            <from type="gameMechanics.map.destination.SelfPosDestination" />
                        </Item>
                    </modifiers>
                </destination>
                <finishImpacts>
                    <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                        <mark href="InterventionAfterTP.(MarkResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>5</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier>4</multiplier>
                                </durationScaler>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                <data href="BuffCD.(ClientData).xdb" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                            </predicates>
                        </filter>
                        <targetsLimit>1</targetsLimit>
                        <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
                            <order>Ascending</order>
                        </sorting>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientData">
                        <data href="TeleportCD.(ClientData).xdb" />
                    </Item>
                </finishImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>5</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>