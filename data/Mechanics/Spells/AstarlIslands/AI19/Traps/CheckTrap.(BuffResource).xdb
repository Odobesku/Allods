<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>186974</resourceId>
    </Header>
    <Name href="CheckTrap.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Spells/Mage/IcyRay.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                            <zone href="IceTrapDamage.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.PureDamage">
                            <damage>0.5</damage>
                            <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>3500</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>