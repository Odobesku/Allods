<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>252136</resourceId>
    </Header>
    <Name href="Link.(BuffResource).Name.txt" />
    <Description href="Link.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/TriumphOfSpirit.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/World/SkullFire.chn.(VisObjectTemplate).xdb" />
            <scale>1.4</scale>
            <locator>Slot_TopFX</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <tick>1000</tick>
            <affectGroup>All</affectGroup>
            <radius>4</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Link.(BuffResource).xdb" />
                </Item>
            </predicates>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Link.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Mechanics/InstanceModifiers/Addon5/Link/Normal/Link_Dispel.(ClientData).xdb" />
                </Item>
            </impactsIn>
            <holderImpactsIn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Link.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Mechanics/InstanceModifiers/Addon5/Link/Normal/Link_Dispel.(ClientData).xdb" />
                </Item>
            </holderImpactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>HOLY</element>
                    <damage>16</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>HOLY</element>
                    <damage>120</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Mechanics/InstanceModifiers/Addon5/Link/Normal/Link.(ClientData).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="/Mechanics/InstanceModifiers/Addon5/Link/Normal/Link_Chain.(ClientData).xdb" />
                                    <calcers>
                                        <addressEntries>
                                            <Item>
                                                <name>caster</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                            </Item>
                                            <Item>
                                                <name>target</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                            </Item>
                                        </addressEntries>
                                    </calcers>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="Link.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>500</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Link.(BuffResource).xdb" />
                </Item>
            </onLeave>
        </Item>
    </effects>
    <duration>8000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/InstanceModifiers/Addon5/Astral_Modifiers.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>