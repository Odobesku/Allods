<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>23436</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <conditionsIn>
        <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
            <quest href="/World/Quests/UmoirMound/UM_Q01/UM_Q01.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/UmoirMound.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
        </Item>
    </conditionsIn>
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateQuestStatus">
                        <quest href="/World/Quests/UmoirMound/UM_Q06/UM_Q06.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                        <status>Finished</status>
                    </predicate>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>1000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>UM_Start</scriptID>
                                    <map href="/Maps/UmoirMound/plot_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                </locator>
                                <yaw type="constructor.basicElements.AngleDegrees">
                                    <value>160</value>
                                </yaw>
                            </destination>
                        </Item>
                    </impacts>
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInRaid">
                            <policy>Small</policy>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>UM_Start</scriptID>
                                    <map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                </locator>
                                <yaw type="constructor.basicElements.AngleDegrees">
                                    <value>160</value>
                                </yaw>
                            </destination>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                            <data href="/Mechanics/RaidInstances/UmoirMound/GoIN_Raid.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impactsElse>
                </Item>
            </impactsElse>
        </Item>
    </impactsIn>
</gameMechanics.map.scriptZone.ScriptZone>