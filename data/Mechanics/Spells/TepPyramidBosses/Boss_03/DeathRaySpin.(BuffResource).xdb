<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>200104</resourceId>
    </Header>
    <Name href="DeathRaySpin.(BuffResource).Name.txt" />
    <Description href="DeathRaySpin.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Mobparts/BoneSpine.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectRay">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateCreature" />
                                <Item type="gameMechanics.elements.predicates.PredicateIsEnemy">
                                    <factions>
                                        <Item href="/World/Factions/TepCult.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                                    </factions>
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                            <damage>1</damage>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier>3</multiplier>
                                </mulCalcer>
                            </scalerTarget>
                            <offends>true</offends>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <length>85</length>
            <width>3</width>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpin">
            <rotation type="gameMechanics.elements.calcers.AngleCalcerRelative">
                <delta type="constructor.basicElements.AngleDegrees">
                    <value>200</value>
                </delta>
            </rotation>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>100</radius>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                            <value>1</value>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                <filters>
                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                    <Item type="gameMechanics.world.creature.AliveFilter" />
                                </filters>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>240000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>