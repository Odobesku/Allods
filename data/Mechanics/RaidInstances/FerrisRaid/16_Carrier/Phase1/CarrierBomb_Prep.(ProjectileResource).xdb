<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739917492</resourceId>
    </Header>
    <name href="CarrierBomb_Prep.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/Architect_Platform_ExplosionMain.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>8000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>4000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                            <radius>10</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="Proec_Player_Shield.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>LIGHTNING</element>
                                            <damage>25</damage>
                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>LIGHTNING</element>
                                            <damage>400</damage>
                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                <filters>
                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                    <Item type="gameMechanics.world.creature.AliveFilter" />
                                </filters>
                            </filter>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>