<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739921552</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability0.(AbilityResource).Name.txt" />
	<description href="Ability0.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer href="Calcer.(CalcerFloatResource).xdb" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>FormulaPercent</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
		<Item>
			<name>var1</name>
			<value var="stacks" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Warrior/WarriorUncannyParry.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/DD/Buff01.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectInstantiating">
					<effects>
						<Item type="gameMechanics.elements.effects.SpellExtraImpacts">
							<casterImpacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff hrefvar="buff" />
								</Item>
							</casterImpacts>
							<destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationGroups">
								<groups>
									<Item href="/Mechanics/Spells/Groups/Thrusts.(ActionGroup).xdb" />
								</groups>
							</destination>
						</Item>
					</effects>
				</Item>
				<Item type="gameMechanics.elements.effects.CombatStateTrigger">
					<onEnter>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff hrefvar="buff" />
							<stacks type="gameMechanics.elements.calcers.FloatData">
								<value var="stacks" />
							</stacks>
						</Item>
					</onEnter>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
		<Item href="Ability04.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
