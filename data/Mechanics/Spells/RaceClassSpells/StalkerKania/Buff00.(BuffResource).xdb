    <image href="/Interface/Icons/Misc/Quest/Bomb.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.WeaponScaler">
                                        <source>Ranged</source>
                                    </Item>
                                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>1.66667</multiplier>
                                    </Item>
                                </scalers>
                            </scaler>
                            <avgDamage>50</avgDamage>
                            <source>Ranged</source>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                    <variable href="/Mechanics/Spells/Stalker63/Abilities/MaterielResource/MaterielResource.(VariableResource).xdb" />
                                    <summand>6</summand>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="BombExplode.(ClientData).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>3000</duration>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
