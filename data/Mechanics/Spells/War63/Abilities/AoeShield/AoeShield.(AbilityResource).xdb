<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739950657</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="AoeShield.(AbilityResource).Name.txt" />
	<description href="AoeShield.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>dmg</name>
			<value>5</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>1.66667</multiplier>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>WeaponScaler</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
		<Item>
			<name>stack</name>
			<value var="stack" />
		</Item>
		<Item>
			<name>life</name>
			<value var="life" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Warrior/SweepingSlamUpgrade.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EquipTrigger">
			<slot>OFFHAND</slot>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectInstantiating">
					<effects>
						<Item type="gameMechanics.elements.effects.SpellsModifier">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
									<spells>
										<Item href="/Mechanics/Spells/War63/Spells/ThunderStrike/Spell02.(SpellArea).xdb" />
										<Item href="/Mechanics/Spells/War63/Spells/Whirlwind/Spell02.(SpellSingleTarget).xdb" />
									</spells>
								</Item>
							</predicates>
							<modifiers>
								<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
									<effects>
										<Item type="gameMechanics.elements.effects.EffectStatModifier">
											<statSelector type="gameMechanics.elements.stat.SpecialStat">
												<stat href="/Mechanics/SpecialStats/Lifesteal.(SpecialStatResource).xdb" />
											</statSelector>
											<value type="gameMechanics.constructor.basicElements.ScalerCalcer">
												<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
													<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
														<stat type="gameMechanics.elements.stat.SpecialStat">
															<stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
														</stat>
														<valueType>ShortTerm</valueType>
													</mulCalcer>
													<additionalMultiplier>
														<scaler type="gameMechanics.elements.scalers.LinearScaler">
															<multiplier var="life" />
														</scaler>
													</additionalMultiplier>
												</scaler>
												<value>1</value>
											</value>
										</Item>
									</effects>
									<onBehalfOfHolder>true</onBehalfOfHolder>
								</Item>
							</modifiers>
						</Item>
						<Item type="gameMechanics.elements.effects.SpellCastTrigger">
							<conditionalImpacts>
								<Item>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="AoeShield.(BuffResource).xdb" />
											<stacks type="gameMechanics.elements.calcers.FloatData">
												<value var="stack" />
											</stacks>
										</Item>
									</impacts>
									<conditions>
										<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
											<spells>
												<Item href="/Mechanics/Spells/War63/Spells/ThunderStrike/Spell02.(SpellArea).xdb" />
												<Item href="/Mechanics/Spells/War63/Spells/Whirlwind/Spell02.(SpellSingleTarget).xdb" />
											</spells>
										</Item>
									</conditions>
								</Item>
							</conditionalImpacts>
							<stages>
								<Item>Start</Item>
							</stages>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="AoeShield01.(AbilityResource).xdb" />
		<Item href="AoeShield02.(AbilityResource).xdb" />
		<Item href="AoeShield03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
