    <visObject href="/Spells/FX/Spells/AOEAura_Electric_R20.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>0</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.CylinderWithHeight">
                        <topPlane>12</topPlane>
                        <bottomPlane>-6</bottomPlane>
                    </shape>
                    <radius>20</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceAnyBuff">
                                        <buffs>
                                            <Item href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakMount/MountRider_A.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <Item href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakMount/MountRider_B.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <Item href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakMount/MountRider_C.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <Item href="HitCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </buffs>
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakBoss/LightningSphere/LightningHit.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>LIGHTNING</element>
                                    <damage>8</damage>
                                    <impactsOnHitTarget>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="HitCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsOnHitTarget>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                        <filters>
                            <Item type="gameMechanics.world.creature.AliveFilter" />
                            <Item type="gameMechanics.world.creature.AvatarFilter" />
                        </filters>
                    </filter>
