<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739854204</resourceId>
    </Header>
    <name href="BossAvatar_Smite.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/PriestHolySmiteUpgrade_New01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>10000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <radius>4</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>HOLY</element>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            <damage>30</damage>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/AstarlIslands/AI58_UI06/UI06_SoloBars/Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>2</multiplier>
                            </durationScaler>
                        </Item>
                    </impacts>
                    <finalImpactsOnHolder>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>2000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </finalImpactsOnHolder>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </filter>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>