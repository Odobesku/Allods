<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>192852</resourceId>
    </Header>
    <isExploit>true</isExploit>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>5</value>
    </range>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Everyone</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                        <variableResource href="UpEntranceBuff.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                        <expectedValue type="gameMechanics.elements.calcers.LinearCalcer">
                            <mul>1</mul>
                            <sum>0</sum>
                        </expectedValue>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                        <buff href="UpEntranceBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <range>
                            <min>20</min>
                            <max>20</max>
                        </range>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                <destination type="gameMechanics.map.destination.DestinationLocator">
                    <locator>
                        <scriptID>UpStart</scriptID>
                        <map href="/Maps/AstralIsle67/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </locator>
                </destination>
            </Item>
        </casterImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>