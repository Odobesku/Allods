<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureTrailAction">
				<mainHandTrail href="/Spells/FX/InterfaceFX/War63_Slaughter.(TrailTemplate).xdb" />
				<offHandTrail href="/Spells/FX/InterfaceFX/War63_Slaughter.(TrailTemplate).xdb" />
				<creatureTrail href="" />
				<lengthMSec>6000</lengthMSec>
			</Item>
			<Item type="VisActionLoopAction">
				<actionToLoop type="VisActionList">
					<playWhile />
					<elements>
						<Item type="CreatureAnimationAction">
							<use>USE_CURRENT_BASE_ATTACK</use>
							<animations>
								<Item>headSlam</Item>
							</animations>
							<channel>CHANNEL_ABILITY</channel>
							<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
							<channelOverrideScript />
							<advanced>
								<speed>1</speed>
								<offendType>ONEOFFEND_ONETARGET</offendType>
								<animationKeysAction />
							</advanced>
						</Item>
						<Item type="CreatureAnimationAction">
							<animations>
								<Item>flurryOfBlows</Item>
							</animations>
							<channel>CHANNEL_ABILITY</channel>
							<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
							<channelOverrideScript />
							<advanced>
								<speed>1</speed>
								<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
								<offendType>EVERYKEY_OFFEND</offendType>
								<eventPlaybackEnd>true</eventPlaybackEnd>
								<animationKeysAction />
							</advanced>
						</Item>
						<Item type="CreatureAnimationAction">
							<animations>
								<Item>flurryOfBlows</Item>
							</animations>
							<channel>CHANNEL_ABILITY</channel>
							<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
							<channelOverrideScript />
							<advanced>
								<speed>1</speed>
								<offendType>EVERYKEY_OFFEND</offendType>
								<eventPlaybackEnd>true</eventPlaybackEnd>
								<animationKeysAction />
							</advanced>
						</Item>
					</elements>
					<stopOnDeath>true</stopOnDeath>
				</actionToLoop>
				<totalTime>0</totalTime>
				<repeat>5</repeat>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
