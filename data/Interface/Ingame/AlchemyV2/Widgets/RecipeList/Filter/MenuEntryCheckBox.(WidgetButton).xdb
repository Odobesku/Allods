<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>Checkbox</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Pos>5</Pos>
            <Size>20</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Size>20</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>10</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>msgbox_check_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_DEFAULT</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag></TextTag>
    <Variants>
        <Item>
            <PushedOffset x="0" y="0"/>
            <Reaction>msgbox_check_pressed</Reaction>
            <ReactionRightClick>msgbox_check_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxCheckBoxHollowHighlighted.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateHighlighted>
            <StateNormal>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxCheckBoxHollowNormal.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxCheckBoxHollowPressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <PushedOffset x="0" y="0"/>
            <Reaction>msgbox_check_pressed</Reaction>
            <ReactionRightClick>msgbox_check_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxCheckBoxCheckedHighlighted.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateHighlighted>
            <StateNormal>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxCheckBoxCheckedNormal.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxCheckBoxCheckedPressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <PushedOffset x="0" y="0"/>
            <Reaction>msgbox_check_pressed</Reaction>
            <ReactionRightClick>msgbox_check_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxCheckBoxDisabledHighlighted.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateHighlighted>
            <StateNormal>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxCheckBoxDisabledNormal.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxCheckBoxDisabledPressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
