	</groups>
	<element>SHADOW</element>
	<Name href="Spell0_Name.txt" />
	<Description href="Spell0_Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>HealScaler</formula>
					</Item>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mul>0.5</mul>
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Necromancer/NecromancerDarkEmpathy.(UISingleTexture).xdb" />
