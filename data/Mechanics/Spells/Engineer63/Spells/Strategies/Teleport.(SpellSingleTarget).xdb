                    </Item>
                </impacts>
                <impactsOnNoTargets>
                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                        <spell href="Teleport.(SpellSingleTarget).xdb" />
                    </Item>
                </impactsOnNoTargets>
                <impactsOnTargetsFound>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="/Mechanics/Spells/Engineer63/Abilities/EscapeStrategyParty/TeleportGroup.(MarkResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impactsOnTargetsFound>
                <targetsLimit>1</targetsLimit>
                <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance" />
