<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222928</resourceId>
    </Header>
    <Name href="WingsSpell.(BuffResource).Name.txt" />
    <Description href="WingsSpell.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/SparksDemon.(UISingleTexture).xdb" />
    <visScript href="WingsAOE_ReadyBuff.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/Bombs/BombsCastCount.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>15_DiArder</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                            <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                            <data href="/Mechanics/RaidInstances/FerrisRaid/Voice/15_General/30_Wings_DiAr.(ClientData).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                    <spell href="WingsAOE.(SpellSingleTarget).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>4000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>15_Kitty</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/Portals/MobRed.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/Portals/MobGreen.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/Portals/MobBlue.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>5000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/RaidInstances/Phase1.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>