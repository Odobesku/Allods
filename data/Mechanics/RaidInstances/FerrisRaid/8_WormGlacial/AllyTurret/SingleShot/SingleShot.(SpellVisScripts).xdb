<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Turret01_Ready.(VisObjectTemplate).xdb" />
						<scale>1.7</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special06</locatorName>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Turret01_Ready.(VisObjectTemplate).xdb" />
						<scale>1.7</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special05</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="VisActionList">
						<playWhile />
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="VisActionRandom">
								<elements>
									<Item>
										<probability>0.5</probability>
										<action type="VisActionList">
											<play>Simultaneously</play>
											<playWhile />
											<elements>
												<Item type="CreatureProjectileAction">
													<projectileFx href="/Spells/FX/Mobs/Turret02_Projectile.(VisObjectTemplate).xdb" />
													<explosionFx href="/Spells/FX/Mobs/WormGlacial_Projectile_SingleShot.(VisObjectTemplate).xdb" />
													<theGe>15</theGe>
													<pointOnCaster type="VisPointLocator">
														<locator>FROM_LOCATOR_NAME</locator>
														<locatorName>Slot_Special06</locatorName>
													</pointOnCaster>
													<pointOnTarget type="VisPointLocator">
														<locator>Slot_Global</locator>
													</pointOnTarget>
													<offendTime />
												</Item>
												<Item type="CreatureEffectsAction">
													<visualEffects>
														<Item>
															<effectFx href="/Spells/FX/Mobs/Turret01_Attack.(VisObjectTemplate).xdb" />
															<effectAlias href="" />
															<locator>FROM_LOCATOR_NAME</locator>
															<locatorName>Slot_Special06</locatorName>
															<offendTime />
														</Item>
													</visualEffects>
												</Item>
											</elements>
										</action>
									</Item>
									<Item>
										<probability>0.5</probability>
										<action type="VisActionList">
											<play>Simultaneously</play>
											<elements>
												<Item type="CreatureProjectileAction">
													<projectileFx href="/Spells/FX/Mobs/Turret02_Projectile.(VisObjectTemplate).xdb" />
													<explosionFx href="/Spells/FX/Mobs/WormGlacial_Projectile_SingleShot.(VisObjectTemplate).xdb" />
													<theGe>15</theGe>
													<pointOnCaster type="VisPointLocator">
														<locator>FROM_LOCATOR_NAME</locator>
														<locatorName>Slot_Special05</locatorName>
													</pointOnCaster>
													<pointOnTarget type="VisPointLocator">
														<locator>Slot_Global</locator>
													</pointOnTarget>
													<offendTime />
												</Item>
												<Item type="CreatureEffectsAction">
													<visualEffects>
														<Item>
															<effectFx href="/Spells/FX/Mobs/Turret01_Attack.(VisObjectTemplate).xdb" />
															<locator>FROM_LOCATOR_NAME</locator>
															<locatorName>Slot_Special05</locatorName>
														</Item>
													</visualEffects>
												</Item>
											</elements>
										</action>
									</Item>
