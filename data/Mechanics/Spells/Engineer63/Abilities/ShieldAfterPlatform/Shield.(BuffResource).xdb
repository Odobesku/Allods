<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739933843</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Shield.(BuffResource).Name.txt" />
	<Description href="Shield.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Event/ShieldCarrier.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Engineer/ProtectShield.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.DamageAbsorber">
			<elements>
				<Item>PHYSICAL</Item>
				<Item>SHADOW</Item>
				<Item>FIRE</Item>
				<Item>COLD</Item>
				<Item>LIGHTNING</Item>
				<Item>HOLY</Item>
				<Item>ASTRAL</Item>
				<Item>POISON</Item>
				<Item>DISEASE</Item>
				<Item>ACID</Item>
			</elements>
			<absorb>1</absorb>
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
					<calcers>
						<Item type="gameMechanics.elements.calcers.FullHealthCalcer" />
						<Item type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</Item>
					</calcers>
				</mulCalcer>
			</scaler>
			<buff hrefvar="buff" />
			<absorbNotForthrightDamage>true</absorbNotForthrightDamage>
		</Item>
	</effects>
	<duration>6000</duration>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<ranks>
		<Item href="Shield01.(BuffResource).xdb" />
		<Item href="Shield02.(BuffResource).xdb" />
		<Item href="Shield03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
