<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739936515</resourceId>
    </Header>
    <visualScript type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/ArchitectMiniboss_Shield.(VisObjectTemplate).xdb" />
                        <fadeInTime>300</fadeInTime>
                        <fadeOutTime>300</fadeOutTime>
                        <locator>FROM_LOCATOR_NAME</locator>
                        <locatorName>Slot_Special01</locatorName>
                        <offset x="0" z="0" />
                        <rotation z="0" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>1</level>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/World/Quests/ZC12/WW_2_5/WW_2_5_plan.(Plane).xdb" />
