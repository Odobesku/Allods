<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>225684</resourceId>
    </Header>
    <Name href="PlasmaCannon.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Bosses/UmoirRaid/ExoBoss_PlasmaCannon.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>0</value>
    </range>
    <prepareDuration>7000</prepareDuration>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>40000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <channelingMechanics>
            <channelingBuff href="PlasmaCannon.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        </channelingMechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/UmoirRaid/Voice/VoiceNotice.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <elseImpacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/RaidInstances/UmoirRaid/Voice/VoiceNotice.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>4</multiplier>
                        </durationScaler>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                        <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                        <data href="/Mechanics/RaidInstances/UmoirRaid/Voice/Exo4.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>