                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="DDTreant.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="HealTreant.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="SupportTreant.(BuffResource).xdb" />
                                </Item>
                            </impactsOn>
                            <impactsOff>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="DDTreant.(BuffResource).xdb" />
                                </Item>
                            </impactsOff>
                        </Item>
                    </effects>
                    <assistantResources>
                        <Item href="Assistant.(AssistantResource).xdb" />
                    </assistantResources>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Heal/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsToAssistant">
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="HealTreant.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="DDTreant.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="SupportTreant.(BuffResource).xdb" />
                                </Item>
                            </impactsOn>
                            <impactsOff>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="HealTreant.(BuffResource).xdb" />
                                </Item>
                            </impactsOff>
                        </Item>
                    </effects>
                    <assistantResources>
                        <Item href="Assistant.(AssistantResource).xdb" />
                    </assistantResources>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsToAssistant">
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="SupportTreant.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="DDTreant.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="HealTreant.(BuffResource).xdb" />
                                </Item>
                            </impactsOn>
                            <impactsOff>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="SupportTreant.(BuffResource).xdb" />
                                </Item>
                            </impactsOff>
                        </Item>
                    </effects>
                    <assistantResources>
                        <Item href="Assistant.(AssistantResource).xdb" />
