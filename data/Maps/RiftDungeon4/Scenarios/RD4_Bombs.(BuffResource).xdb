<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739939199</resourceId>
    </Header>
    <Name href="/Maps/RiftDungeon4/Scenarios/RD4_Bombs.(BuffResource).Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectIfOverTime">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Maps/RiftDungeon4/Scenarios/RD4_ShieldDefence.(BuffResource).xdb" />
                    </predicate>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Rifts/Death/ReviveBuff.(BuffResource).xdb" />
                    </predicate>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/GameRoot/AvatarReviveBuff.xdb" />
                    </predicate>
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.RelativePos" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                <radius type="gameMechanics.elements.calcers.FloatData">
                                                    <value>2</value>
                                                </radius>
                                            </Item>
                                        </modifiers>
                                    </destination>
                                </moveType>
                                <resource href="/Maps/RiftDungeon4/Scenarios/RD4_Bomb1.(ProjectileResource).xdb" />
                            </projectileData>
                        </Item>
                    </impacts>
                </Item>
            </impactsIf>
            <runImpactsOnEachTick>true</runImpactsOnEachTick>
            <tick type="gameMechanics.elements.calcers.FloatData">
                <value>4000</value>
            </tick>
        </Item>
        <Item type="gameMechanics.elements.effects.CasterLostWatcherGeneric">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Maps/RiftDungeon4/Scenarios/RD4_Bombs.(BuffResource).xdb" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>