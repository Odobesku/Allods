<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.QuestResource>
    <Header>
        <resourceId>243455</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <hideLevel>true</hideLevel>
    <itemMall>true</itemMall>
    <isLocationProgress>false</isLocationProgress>
    <finisher type="gameMechanics.elements.quest.QuestFinisherMob">
        <mobWorld hrefvar="finisher" />
    </finisher>
    <rewardImpacts>
        <Item type="gameMechanics.world.ship.elements.ImpactAddShipInUpgrade">
            <constructionTime var="Time" />
            <item hrefvar="item" />
            <modification type="gameMechanics.world.ship.elements.ImpactAddShipInUpgrade$ShipModificationResource">
                <shipResource hrefvar="newShipResource" />
            </modification>
        </Item>
    </rewardImpacts>
    <startConditions>
        <Item type="gameMechanics.world.ship.elements.PredicateHasUpgradableShip">
            <newShipResource hrefvar="newShipResource" />
        </Item>
    </startConditions>
    <counters>
        <Item type="gameMechanics.elements.quest.QuestCountItem">
            <showCounterValue>true</showCounterValue>
            <autoRelatedItems>
                <Item href="" />
            </autoRelatedItems>
            <limit>1</limit>
            <items>
                <Item hrefvar="item" />
            </items>
            <removeOnAbandon>false</removeOnAbandon>
            <removeOnComplete>false</removeOnComplete>
        </Item>
        <Item type="gameMechanics.elements.quest.QuestCountUpgradableShip">
            <limit>1</limit>
            <newShipResource hrefvar="newShipResource" />
        </Item>
    </counters>
    <sharing>
        <onRequest>false</onRequest>
    </sharing>
    <repeatPolicy type="gameMechanics.constructor.schemes.quest.RepeatPolicyNone" />
    <canBeSkipped>false</canBeSkipped>
</gameMechanics.constructor.schemes.quest.QuestResource>