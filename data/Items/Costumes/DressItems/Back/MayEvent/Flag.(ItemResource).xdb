<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>238415882</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Event/FlagLeague.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <source>Vendor</source>
    <visualElement href="/Items/Costumes/VisItems/Fixed/Back/MayEvent/Flag.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
    <lifestyleCollection href="/Client/GMUIHelper/Lifestyle/LoreEvent/LoreMayEvent.(LifestyleCollection).xdb#xpointer(/LifestyleCollection)" />
    <slot>LIFESTYLEBACK</slot>
    <itemClass href="/Mechanics/ItemClasses/LifeStyle.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                    <rule href="/Mechanics/Rules/MayEvent/Rule.xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust_League_LS.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </predicate>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                    <faction href="/World/Factions/League.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust_League_LS.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust_Empire_LS.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust_Empire.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOn>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust_League_LS.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust_League_LS.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOn>
                </Item>
            </effectsElse>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectRuleFinishedImpacts">
            <rule href="/Mechanics/Rules/MayEvent/Rule.xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust_League_LS.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust_League_LS.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust_League_LS.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <prices type="gameMechanics.constructor.schemes.item.prices.AltCurrenciesItem">
        <currencies>
            <Item>
                <currency href="/Mechanics/AlternativeCurrencies/Events/MayEventCoupon.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                <value>800</value>
            </Item>
        </currencies>
    </prices>
    <binding>BindOnPickup</binding>
    <name href="Flag.txt" />
    <description href="Flag.(ItemResource).Description.txt" />
    <requiredReputation>Hostility</requiredReputation>
    <category href="/Mechanics/ItemCategories/LifeStyle/LSBack.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
</gameMechanics.constructor.schemes.item.ItemResource>