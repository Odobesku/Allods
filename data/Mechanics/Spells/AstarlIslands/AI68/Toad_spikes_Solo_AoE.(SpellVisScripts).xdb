<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>rangedAttack</Item>
        </animations>
        <channel>CHANNEL_KNOCKDOWN</channel>
    </actionBarStart>
    <wholeCasting type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="AI68_Packs/Toad_spikes_Solo_AoE_decal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            </Item>
        </visualEffects>
    </wholeCasting>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Spells/NecromancerAcidBoltAbilityBig.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <explosionFx href="/Spells/FX/Spells/HitPoisonAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <theGe>6</theGe>
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_Global</locator>
                    <from>FROM_SELF</from>
                </pointOnTarget>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>