                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsFromTarget>
                    <object href="RD_Elemental_Boss3_MovingShard.(MobWorld).xdb" />
                    <pool href="/Mechanics/Spells/Rifts/Abilities/RD_BossSummonPool.(SummonPool).xdb" />
