<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXProjectile>/Spells/FX/Mobs/Turret02_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<CastAnimation>specialCast</CastAnimation>
			<FXOnTargets />
			<FXOnCaster />
			<FXProjectileHit>/Spells/FX/Spells/HitAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
			<HitPostFXOnTargets />
			<LocatorOnCaster>Slot_FX</LocatorOnCaster>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item type="VisActionList">
						<elements>
							<Item skiped="" />
							<Item type="CreatureProjectileAction">
								<pointOnCaster type="VisPointLocator">
									<locator var="LocatorOnCaster" />
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator var="ProjectileLocatorOnTarget" />
								</pointOnTarget>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
