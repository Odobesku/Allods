<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>213125120</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/FairySpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/FearBreakers.xdb" />
        <Item href="/Mechanics/Spells/Groups/HoldBreakers.xdb" />
        <Item href="/Mechanics/Spells/Groups/MindControlBreakers.xdb" />
        <Item href="/Mechanics/Spells/Groups/StunBreakers.xdb" />
        <Item href="/Mechanics/Spells/Groups/KnockdownBreakers.xdb" />
    </groups>
    <element>ASTRAL</element>
    <image href="/Interface/Icons/Spells/Halo/Willpower.(UISingleTexture).xdb" />
    <visualScripts href="WillPower.(SpellVisScripts).xdb" />
    <level>1</level>
    <prepareDuration>0</prepareDuration>
    <immutablePrepareDuration>false</immutablePrepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>true</replaceLowRanks>
    <isWorkOnDead>false</isWorkOnDead>
    <ranks>
        <Item href="Spell01.xdb" />
        <Item href="Spell02.xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <launchWhenReady>false</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <stage>Launch</stage>
            <duration var="duration" />
            <group href="" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsFairyActive" />
            <Item type="gameMechanics.elements.predicates.PredicateFairyRankGreater">
                <rank>3</rank>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                        <groups>
                            <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                            <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                            <Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
                            <Item href="/Mechanics/Spells/Groups/Fears.xdb" />
                        </groups>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateToPet">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                                <groups>
                                    <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                    <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                                    <Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
                                    <Item href="/Mechanics/Spells/Groups/Fears.xdb" />
                                </groups>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceAltCurrency">
                <currency href="/Mechanics/AlternativeCurrencies/Myrrh.xdb" />
                <count>0</count>
                <countCalcer type="gameMechanics.elements.calcers.CalcerMul">
                    <calcers>
                        <Item type="gameMechanics.elements.calcers.CalcerIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                                <unlock href="/Mechanics/Unlocks/VeteranRewards/VeteranRankMaster.xdb" />
                            </predicate>
                            <calcerIf type="gameMechanics.elements.calcers.FloatData">
                                <value>0.7</value>
                            </calcerIf>
                            <calcerElse type="gameMechanics.elements.calcers.FloatData">
                                <value>1</value>
                            </calcerElse>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.CalcerIf">
                            <predicate type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                                        <key href="/System/ContentKeys/WeakFactionMyrrhBonus.(ContentKey).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateWeakFaction" />
                                            <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                                <buff href="/Mechanics/Spells/ItemSpells/ChangeFaction/BuffWeakFaction.(BuffResource).xdb" />
                                                <range>
                                                    <min>1</min>
                                                    <max>1</max>
                                                </range>
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                            </predicate>
                            <calcerIf type="gameMechanics.elements.calcers.FairySpellCostCalcer">
                                <mul>0.5</mul>
                            </calcerIf>
                            <calcerElse type="gameMechanics.elements.calcers.FairySpellCostCalcer">
                                <mul>5</mul>
                            </calcerElse>
                        </Item>
                    </calcers>
                </countCalcer>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAddFairyExperience">
                <experience>30</experience>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Fairies/AbilityUseBuff.xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <affectGroup>Group</affectGroup>
                <affectHolder>false</affectHolder>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                        <currency href="/Mechanics/AlternativeCurrencies/Myrrh.xdb" />
                        <sumCalcer type="gameMechanics.elements.calcers.CalcerIf">
                            <predicate type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                                        <key href="/System/ContentKeys/WeakFactionMyrrhBonus.(ContentKey).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateWeakFaction" />
                                            <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                                <buff href="/Mechanics/Spells/ItemSpells/ChangeFaction/BuffWeakFaction.(BuffResource).xdb" />
                                                <range>
                                                    <min>1</min>
                                                    <max>1</max>
                                                </range>
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                            </predicate>
                            <calcerIf type="gameMechanics.constructor.basicElements.FloatZero" />
                            <calcerElse type="gameMechanics.elements.calcers.FairySpellCostCalcer">
                                <mul var="mul" />
                            </calcerElse>
                        </sumCalcer>
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasSpell">
                        <spell href="Spell03.(SpellSingleTarget).xdb" />
                        <anyRank>false</anyRank>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.world.pet.PredicateHasPet" />
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.MassBuffDetacher">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                                                <groups>
                                                    <Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
                                                    <Item href="/Mechanics/Spells/Groups/Fears.xdb" />
                                                    <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                                    <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                                                </groups>
                                            </Item>
                                        </predicates>
                                        <impactsOnBuffCaster>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier>3</multiplier>
                                                </durationScaler>
                                            </Item>
                                        </impactsOnBuffCaster>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.MassBuffDetacher">
                        <predicates>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                                <groups>
                                    <Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
                                    <Item href="/Mechanics/Spells/Groups/Fears.xdb" />
                                    <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                </groups>
                            </Item>
                        </predicates>
                        <impactsOnBuffCaster>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier>3</multiplier>
                                </durationScaler>
                            </Item>
                        </impactsOnBuffCaster>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                <group href="/Mechanics/Spells/Groups/Fears.xdb" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                <group href="/Mechanics/Spells/Groups/Stuns.xdb" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                        <group href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.world.pet.PredicateHasPet" />
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                        <group href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                        <group href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                                <group href="/Mechanics/Spells/Groups/Stuns.xdb" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                                <group href="/Mechanics/Spells/Groups/Fears.xdb" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Fairies/AbilityUseBuff.xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                <group href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>0</speed>
    <isAE>false</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>