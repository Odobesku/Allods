<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>192368</resourceId>
    </Header>
    <Name href="WardShield.(BuffResource).Name.txt" />
    <Description href="WardShield.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Event/ShieldEvent.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Mobs/Shield_Immunity.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
        </Item>
    </visualEffects>
    <visScript href="ToadWait.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="AI68_Boss_Toad_Necromancer.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                            <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="AI68_Boss_Toad_Necromancer.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.AttachAbility">
                                    <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Rotate</Item>
            </actions>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>