                    <Item href="/Mechanics/RaidInstances/UmoirRaid/6_ExoBoss/Boss/ExoBoss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </mobs>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="KnockdownImmune.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
