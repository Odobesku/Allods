<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
	<Header>
		<resourceId>739934591</resourceId>
	</Header>
	<impacts>
		<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
			<radius>15</radius>
			<affectGroup>Enemies</affectGroup>
			<affectHolder>false</affectHolder>
			<impacts>
				<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>ASTRAL</element>
							<forceAE>true</forceAE>
							<damage>1</damage>
							<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
								<scalers>
									<Item type="gameMechanics.elements.scalers.MagicScaler" />
									<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mulCalcer type="constructor.elements.CalcerFloatExternal">
											<externalCalcer href="ExplodeDamage.(CalcerFloatResource).xdb" />
										</mulCalcer>
									</Item>
								</scalers>
							</scaler>
						</Item>
					</impacts>
					<groupRepeaters>true</groupRepeaters>
				</Item>
				<Item type="gameMechanics.elements.impacts.MarkedImpact">
					<mark href="ExplodeDamage.(MarkResource).xdb" />
				</Item>
			</impacts>
			<finishImpacts>
				<Item type="gameMechanics.elements.impacts.Disintegrate" />
			</finishImpacts>
			<filter type="gameMechanics.world.creature.AliveFilter" />
		</Item>
		<Item type="gameMechanics.elements.impacts.MarkedImpact">
			<mark href="ExplodeFlash.(MarkResource).xdb" />
		</Item>
	</impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>
