<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739913658</resourceId>
	</Header>
	<Name href="BombMechanics.(BuffResource).Name.txt" />
	<Description href="BombMechanics.(BuffResource).Description.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
							<zone href="/Mechanics/RaidInstances/FerrisRaid/15_General/BossFightZone.(ScriptZone).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
							<spawn>
								<scriptID>15_GeneralBoss</scriptID>
								<map href="/Maps/FerrisRaid/MapResource.xdb" />
							</spawn>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
													<impacts>
														<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
															<predicates>
																<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
																	<zone href="/Mechanics/RaidInstances/FerrisRaid/15_General/BossFightZone.(ScriptZone).xdb" />
																</Item>
																<Item type="gameMechanics.constructor.basicElements.PredicateNot">
																	<predicate type="gameMechanics.elements.resources.ResourceBuff">
																		<buff href="BombImmunity.(BuffResource).xdb" />
																	</predicate>
																</Item>
															</predicates>
															<impactsIf>
																<Item type="gameMechanics.elements.impacts.DirectDamage">
																	<damage>1</damage>
																	<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
																		<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
																	</scalerTarget>
																</Item>
															</impactsIf>
														</Item>
													</impacts>
												</Item>
											</impacts>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
											<spawn>
												<scriptID>15_DiArder</scriptID>
												<map href="/Maps/FerrisRaid/MapResource.xdb" />
											</spawn>
											<impacts>
												<Item type="gameMechanics.elements.impacts.DirectDamage">
													<damage>1</damage>
													<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
														<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
													</scalerTarget>
												</Item>
											</impacts>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
											<spawn>
												<scriptID>15_Rysina</scriptID>
												<map href="/Maps/FerrisRaid/MapResource.xdb" />
											</spawn>
											<impacts>
												<Item type="gameMechanics.elements.impacts.DirectDamage">
													<damage>1</damage>
													<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
														<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
													</scalerTarget>
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="BombRedCarrier.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="BombGreenCarrier.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="BombBlueCarrier.(BuffResource).xdb" />
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactCaseGeneric">
					<cases>
						<Item>
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="BombRedCarrierMark.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
									<projectileData>
										<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
											<destination type="gameMechanics.map.destination.SelfPosDestination" />
										</moveType>
										<resource href="BombRedExplosion.(ProjectileResource).xdb" />
									</projectileData>
								</Item>
							</impacts>
						</Item>
						<Item>
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="BombGreenCarrierMark.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
									<projectileData>
										<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
											<destination type="gameMechanics.map.destination.SelfPosDestination" />
										</moveType>
										<resource href="BombGreenExplosion.(ProjectileResource).xdb" />
									</projectileData>
								</Item>
							</impacts>
						</Item>
						<Item>
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="BombBlueCarrierMark.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
									<projectileData>
										<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
											<destination type="gameMechanics.map.destination.SelfPosDestination" />
										</moveType>
										<resource href="BombBlueExplosion.(ProjectileResource).xdb" />
									</projectileData>
								</Item>
							</impacts>
						</Item>
					</cases>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="BombImmunity.(BuffResource).xdb" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
			<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>0.8</coeff>
			</effectScaler>
		</Item>
	</effects>
	<duration>12000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
