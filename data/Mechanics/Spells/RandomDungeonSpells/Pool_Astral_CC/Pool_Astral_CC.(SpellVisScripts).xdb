<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes2/Channeling_Instant.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FixPointTarget>true</FixPointTarget>
			<ShakeParams />
			<FxOnTarget />
			<LocatorNameOnCaster>Neck</LocatorNameOnCaster>
			<FxChannel>/Spells/FX/Mobs/TrinketGTTank.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxChannel>
			<DelayCasterFX>0</DelayCasterFX>
			<HitDelay>0</HitDelay>
			<FixPointCaster>false</FixPointCaster>
			<FxOnHands />
			<FadeInTimeChannel>0</FadeInTimeChannel>
			<FadeOutTimeChannel>0</FadeOutTimeChannel>
			<RayVelocity>0</RayVelocity>
			<LocatorNameOnTarget />
			<FxOnCaster>/Spells/FX/Spells/Dragon_Wings_Wear.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnCaster>
			<HitPostFxOnTarget />
			<Animation>readySpell</Animation>
			<LocatorOnCaster>FROM_LOCATOR_NAME</LocatorOnCaster>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="Animation" />
				</animations>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay var="DelayCasterFX" />
								<effectFx hrefvar="FxOnCaster" />
								<fixPoint var="FixPointCaster" />
								<scale>0.7</scale>
								<fadeInTime>1500</fadeInTime>
								<locator var="LocatorOnCaster" />
								<locatorName var="LocatorNameOnCaster" />
							</Item>
						</visualEffects>
					</Item>
					<Item type="ShakeAction">
						<params hrefvar="ShakeParams" />
					</Item>
					<Item type="VisActionList" />
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
