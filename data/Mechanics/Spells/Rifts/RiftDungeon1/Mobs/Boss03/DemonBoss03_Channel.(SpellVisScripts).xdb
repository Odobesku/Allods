<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Mobs/HG_HunterNetChannel.(VisObjectTemplate).xdb" />
                <fxLength>15</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>Slot_Mouth</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </endPoint>
                <velocity>40</velocity>
            </Item>
        </elements>
    </actionBarStart>
</SpellVisScripts>