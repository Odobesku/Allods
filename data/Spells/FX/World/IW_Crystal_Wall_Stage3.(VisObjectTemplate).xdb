<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound/>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>300</fadeInMS>
    <fadeOutMS>500</fadeOutMS>
    <geometry href="/Spells/FX/World/IW_Crystal_Wall_Stage3.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)"/>
    <scale>0.7</scale>
    <sound>
        <name>World/Zones/ZC8/IW_CrystalWall_Stage3</name>
