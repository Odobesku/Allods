<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>42137</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.MobFilter" />
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                    <mobs>
                        <Item href="/Characters/Hadagan_female/Instances/Ferris/Zimina_corrupted.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    </mobs>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>4000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="/Maps/Ferris_indoor/SpawnTables/Zimina_clones.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>lift_doors</scriptID>
                        <map href="/Maps/Ferris_indoor/1stWing_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                            <visualState>2</visualState>
                        </Item>
                    </impacts>
                </Item>
            </impactsIf>
        </Item>
    </impactsIn>
</gameMechanics.map.scriptZone.ScriptZone>