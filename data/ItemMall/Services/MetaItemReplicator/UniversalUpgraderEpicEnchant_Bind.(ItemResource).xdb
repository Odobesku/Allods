<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739864771</resourceId>
    </Header>
    <description href="UniversalUpgraderEpicEnchant_Bind.(ItemResource).Description.txt"/>
    <image href="/Interface/Icons/Misc/Itemmall/IMRareEnchant.(UISingleTexture).xdb#xpointer(/UISingleTexture)"/>
    <itemMallDescription href="UniversalUpgraderEpicEnchant_Bind.(ItemResource).ItemMallDescription.txt"/>
    <source>FixedDrop</source>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)"/>
    <functionalPart type="gameMechanics.constructor.schemes.item.meta.UltimateMetaUpgrader">
        <upgradeCondition type="gameMechanics.elements.item.ItemPredicateAnd">
            <predicates>
                <Item type="gameMechanics.elements.item.ItemPredicateEnchant"/>
                <Item type="gameMechanics.elements.item.ItemPredicateLevel">
                    <range>
                        <max>55</max>
                    </range>
                </Item>
                <Item type="gameMechanics.elements.item.ItemPredicateNot">
                    <predicate type="gameMechanics.elements.item.ItemPredicateQualityGreaterOrEqual">
                        <quality href="/Mechanics/ItemQualities/Legendary.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)"/>
                    </predicate>
                </Item>
            </predicates>
        </upgradeCondition>
    </functionalPart>
    <level>55</level>
    <requiredLevel>10</requiredLevel>
    <stackLimit>30</stackLimit>
    <quality href="/Mechanics/ItemQualities/Epic.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)"/>
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
    </prices>
    <binding>BindOnPickup</binding>
    <lifeLengthCap>2592000000</lifeLengthCap>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="UniversalUpgraderEpicEnchant_Bind.(ItemResource).Name.txt"/>
    <category href="/Mechanics/ItemCategories/ItemMall.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)"/>
</gameMechanics.constructor.schemes.item.ItemResource>
