<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>256913423</resourceId>
    </Header>
    <Name href="TimerBuffName.txt" />
    <Description href="TimerBuffDescription.txt" />
    <image href="/Interface/Icons/Spells/Psionic/PsionicTimeLapse.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="TimeBuffVisScript.xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                    <impact type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.map.destination.RelativeRotatePos">
                            <base type="gameMechanics.map.destination.RelativePos" />
                            <offset>1</offset>
                        </destination>
                        <object href="/Creatures/BlackWidow/Instances/AstralIsle21/SpiderQueenAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <pool href="AddPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    </impact>
                    <count type="gameMechanics.elements.calcers.FloatData">
                        <value>4</value>
                    </count>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Creatures/BlackWidow/Instances/AstralIsle21/AstralSpiderQueenBoss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/AstarlIslands/AI21/QueenSpiderAddDeath/AddCount.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <spawnResource href="/Maps/AstralIsle21/SpawnTables/AstralIsle21/AstralSpiderQueenBoss.(MobSpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.5</factor>
        </Item>
    </effects>
    <duration>16000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>