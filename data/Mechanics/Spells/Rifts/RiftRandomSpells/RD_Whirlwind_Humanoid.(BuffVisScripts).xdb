<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>whirlwind</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
                <channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/WarriorWhirlwind.(VisObjectTemplate).xdb" />
                        <lockScale>true</lockScale>
                        <scale>1.8</scale>
                        <locator>Slot_BodyFX</locator>
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Red.(VisObjectTemplate).xdb" />
                        <lockScale>true</lockScale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </action>
</BuffVisScripts>