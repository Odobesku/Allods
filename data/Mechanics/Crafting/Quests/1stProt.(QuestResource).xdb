<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.QuestResource>
    <Header>
        <resourceId>739879213</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="" />
    <goal href="" />
    <startText href="" />
    <checkText href="" />
    <finishText href="" />
    <kickText href="" />
    <finisher type="gameMechanics.elements.quest.QuestFinisherMob">
        <mobWorld hrefvar="mobWorld" />
    </finisher>
    <startImpacts>
        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
            <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
            <data hrefvar="data" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                <item hrefvar="TrainingKit" />
            </item>
            <binding>ForceBind</binding>
            <count var="count" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
            <impacts>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateHasSkill">
                                    <skill hrefvar="skill" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                    <id hrefvar="id" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </startImpacts>
    <startConditions>
        <Item type="gameMechanics.elements.predicates.PredicateCanTake">
            <item hrefvar="TrainingKit" />
            <stackCount>20</stackCount>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateCanLearnSkill">
                    <skill hrefvar="skill" />
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateHasSkill">
                    <skill hrefvar="skill" />
                </Item>
            </predicates>
        </Item>
    </startConditions>
    <reward>
        <experience>2</experience>
        <money>34</money>
        <mandatoryItems>
            <Item>
                <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                        <item href="/Items/CraftingObjects/AlchemyV2/Potions/DiceCraftReplic.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                    </item>
                </item>
                <number>20</number>
            </Item>
        </mandatoryItems>
    </reward>
    <tutorial>true</tutorial>
    <lowPriority>true</lowPriority>
    <zone href="" />
    <canBeSkipped>false</canBeSkipped>
    <level type="gameMechanics.formulas.IntConstantValue">
        <value>5</value>
    </level>
</gameMechanics.constructor.schemes.quest.QuestResource>