<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound>
            <name></name>
        </sound>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>500</fadeInMS>
    <fadeOutMS>1000</fadeOutMS>
    <geometry href="/Spells/FX/Spells/AcidMist.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)"/>
    <particle href="/Spells/FX/Spells/AcidMist.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)"/>
    <scale>0.4</scale>
    <sound>
        <name></name>
    </sound>
    <states>
        <Item>
            <sound>
                <name></name>
            </sound>
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/Spells/AcidMist.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)"/>
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>
