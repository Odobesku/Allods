<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/Cone_Decal_10_60_Red.(VisObjectTemplate).xdb" />
				<lockScale>true</lockScale>
				<scale>1.5</scale>
			</Item>
		</visualEffects>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>idle01</Item>
				</animations>
				<advanced>
					<speed>2.5</speed>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>1500</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="VisActionDelay">
							<time>5000</time>
						</playWhile>
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<delay>1500</delay>
										<effectFx href="/Spells/FX/Mobs/Gargoyle_Cleave.(VisObjectTemplate).xdb" />
										<lockScale>true</lockScale>
										<scale>1.5</scale>
										<fadeInTime>300</fadeInTime>
										<fadeOutTime>400</fadeOutTime>
									</Item>
								</visualEffects>
							</Item>
							<Item type="VisActionList">
								<elements>
									<Item type="VisActionDelay">
										<time>150</time>
									</Item>
									<Item type="CreatureAnimationAction">
										<animations>
											<Item>specialAttack</Item>
										</animations>
										<channel>CHANNEL_ATTACK</channel>
									</Item>
								</elements>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>3500</time>
				</playWhile>
				<elements>
					<Item type="CreatureLockRotationAction" />
				</elements>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
					<name>spells/FX/Spells/GamajunUM/Gamajun_Aoe_WingBeat</name>
				</sound>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2250</time>
		</playWhile>
		<elements>
			<Item type="CreatureLockRotationAction" />
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
