<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.zone.ZoneResource>
    <Header>
        <resourceId>38468</resourceId>
    </Header>
    <name href="UI04_Dungeon.(ZoneResource).Name.txt" />
    <color>0xffff8040</color>
    <zoneLights href="/Maps/UmoirIsland04/ZoneLights/UmoirIsland04.(ZoneLights).xdb#xpointer(/ZoneLights)" />
    <parentZone href="UI04_Dungeon.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
    <pvpType href="/Mechanics/ZonePvpTypes/SanctuaryNoGroup.xdb#xpointer(/gameMechanics.map.zone.Sanctuary)" />
    <mountsProhibited>true</mountsProhibited>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                    <quest href="/World/Quests/UmoirIsland04/UI04_Q03/UI04_Q03_01.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                    <counterResource href="/World/Quests/UmoirIsland04/UI04_Q03/Give_JumpBoots.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                    <value>1</value>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/World/Quests/UmoirIsland04/UI04_Q03/JumpBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                    <data href="/World/Quests/UmoirIsland04/UI04_Q03/MiloslavinGiveBoots.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                                </Item>
                                            </impacts>
                                            <assistantResource href="/Mechanics/Characters/Hadagan_male/UmoirIsland04/Miloslavin.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>3000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                                    <zone href="UI04_Dungeon_JumpGameplay.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/World/Quests/UmoirIsland04/UI04_Q03/JumpBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                                    <quest href="/World/Quests/UmoirIsland04/UI04_Q03/UI04_Q03_01.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                    <counterResource href="/World/Quests/UmoirIsland04/UI04_Q03/Give_JumpBoots.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/World/Quests/UmoirIsland04/UI04_Q03/JumpBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
    </effects>
</gameMechanics.map.zone.ZoneResource>