<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>188941</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/AstralSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="AstralElem_Projectiles.(SpellSingleTarget).Name.txt" />
    <visualScripts href="AstralElem_Projectiles.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>1000</prepareDuration>
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>12000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="AstralElem_Trail.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>60</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                <projectileData>
                                    <moveType type="gameMechanics.world.projectile.MoveTypeDestination" />
                                    <resource href="AstralElem_Projectiles.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                </projectileData>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                            <filters>
                                <Item type="gameMechanics.world.creature.AliveFilter" />
                                <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="Boss02_ProjectileImmunity.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </predicate>
                                        </Item>
                                    </predicates>
                                </Item>
                            </filters>
                        </filter>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>4000</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                        <radius>60</radius>
                                        <affectGroup>Enemies</affectGroup>
                                        <affectHolder>false</affectHolder>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                <projectileData>
                                                    <moveType type="gameMechanics.world.projectile.MoveTypeDestination" />
                                                    <resource href="AstralElem_Projectiles.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                                </projectileData>
                                            </Item>
                                        </impacts>
                                        <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                            <filters>
                                                <Item type="gameMechanics.world.creature.AliveFilter" />
                                                <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                    <predicates>
                                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                                            <predicates>
                                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                </Item>
                                                            </predicates>
                                                        </Item>
                                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                                <buff href="Boss02_ProjectileImmunity.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                            </predicate>
                                                        </Item>
                                                    </predicates>
                                                </Item>
                                            </filters>
                                        </filter>
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>5</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>