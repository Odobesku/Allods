<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739922757</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
    </groups>
    <Name href="Spell0.(SpellArea).Name.txt" />
    <Description href="Spell0.(SpellArea).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/ScorpioStun.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mount/MountScorpion_Stun.(SpellVisScripts).xdb" />
    <prepareDuration>4000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>300000</duration>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>-0.04</mul>
                <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                    <group href="/Mechanics/Mounts/Groups/Scorpion11Grade.(MountGroupResource).xdb" />
                </mulCalcer>
                <sum>1</sum>
            </scaler>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMountFromGroupFeeded">
                <group href="/Mechanics/Mounts/Groups/Scorpion11Grade.(MountGroupResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateMounted">
                <specificGroup href="/Mechanics/Mounts/Groups/Scorpion11Grade.(MountGroupResource).xdb" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/Mounts/Prototypes/AntiNormalMountCC.(BuffResource).xdb" />
                </predicate>
            </Item>
        </targetConditions>
        <channelingMechanics>
            <channelingBuff href="Stun.(BuffResource).xdb" />
        </channelingMechanics>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>90</value>
        </angle>
    </shape>
    <radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>