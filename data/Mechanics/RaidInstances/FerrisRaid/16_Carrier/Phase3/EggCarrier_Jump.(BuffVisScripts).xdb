<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>loot</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>lootLoop</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
