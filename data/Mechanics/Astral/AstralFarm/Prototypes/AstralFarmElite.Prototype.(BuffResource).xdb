<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>236738</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="AstralFarmElite.Prototype.(BuffResource).Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impactsToKiller>
                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderBoundShip" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Ships/AstralTrap/Spells/AstralFarm.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacherStackRange">
                                    <buff hrefvar="StackBuff" />
                                    <range>
                                        <min>90</min>
                                        <max>180</max>
                                    </range>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impactsToKiller>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>