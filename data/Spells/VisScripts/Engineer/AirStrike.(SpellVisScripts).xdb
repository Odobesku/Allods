<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
					<checkIsSet>true</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>channelCastDirected</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
						</advanced>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>channelCastDirectedEngineer</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
						</advanced>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>InSequence</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>attack</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
							<offendType>EVERYKEY_ALLOFFENDS</offendType>
						</advanced>
					</Item>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="VisActionRandom">
								<elements>
									<Item>
										<action type="VisActionList">
											<play>Simultaneously</play>
											<elements>
												<Item type="CreatureProjectileAction">
													<projectileFx href="/Spells/FX/Spells/Engineer_AirStrikeProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
													<explosionFx href="/Spells/FX/Spells/Engineer_AirStrike_HitMain.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
													<theGe>10</theGe>
													<pointOnCaster type="VisPointLocator">
														<locator>FROM_LOCATOR_NAME</locator>
														<member>Mount</member>
														<locatorName>Slot_Special02</locatorName>
													</pointOnCaster>
													<pointOnTarget type="VisPointLocator">
														<locator>Slot_Global</locator>
														<member>Assaulter</member>
													</pointOnTarget>
													<offendTime />
												</Item>
												<Item type="CreatureEffectsAction">
													<visualEffects>
														<Item>
															<effectFx href="/Spells/FX/Spells/Engineer_AirStrike_CastTurr.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
															<effectAlias href="" />
															<locator>FROM_LOCATOR_NAME</locator>
															<member>Mount</member>
															<locatorName>Slot_Special02</locatorName>
															<offendTime />
														</Item>
													</visualEffects>
												</Item>
											</elements>
										</action>
									</Item>
									<Item>
										<action type="VisActionList">
											<play>Simultaneously</play>
											<playWhile />
											<elements>
												<Item type="CreatureProjectileAction">
													<projectileFx href="/Spells/FX/Spells/Engineer_AirStrikeProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
													<explosionFx href="/Spells/FX/Spells/Engineer_AirStrike_HitMain.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
													<theGe>10</theGe>
													<pointOnCaster type="VisPointLocator">
														<locator>FROM_LOCATOR_NAME</locator>
														<member>Mount</member>
														<locatorName>Slot_Special03</locatorName>
													</pointOnCaster>
													<pointOnTarget type="VisPointLocator">
														<locator>Slot_Global</locator>
														<member>Assaulter</member>
													</pointOnTarget>
													<offendTime />
												</Item>
												<Item type="CreatureEffectsAction">
													<visualEffects>
														<Item>
															<effectFx href="/Spells/FX/Spells/Engineer_AirStrike_CastTurr.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
															<effectAlias href="" />
															<locator>FROM_LOCATOR_NAME</locator>
															<member>Mount</member>
															<locatorName>Slot_Special03</locatorName>
															<offendTime />
														</Item>
													</visualEffects>
												</Item>
											</elements>
										</action>
									</Item>
								</elements>
							</Item>
						</elements>
					</Item>
				</elements>
				<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>readySpellOmniEngineer</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
							<offendType>EVERYKEY_ALLOFFENDS</offendType>
						</advanced>
					</Item>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Engineer_AirStrikeProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="/Spells/FX/Spells/Engineer_AirStrike_HitMain.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<theGe>10</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_Global</locator>
							<member>All_Members</member>
						</pointOnTarget>
					</Item>
				</elements>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Foley/Foley.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>Weapons/Generic/Generic_Whoosh</name>
				</sound>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
