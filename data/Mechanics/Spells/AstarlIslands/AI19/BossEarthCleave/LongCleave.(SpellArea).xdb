<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739887696</resourceId>
    </Header>
    <Name href="LongCleave.(SpellArea).Name.txt" />
    <visualScripts href="LongCleave.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>25</value>
    </range>
    <prepareDuration>3000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>20000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/AstarlIslands/AI19/BossEarthStun/DebuffStun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
                        <spell href="/Mechanics/Spells/AstarlIslands/AI19/BossEarthSoftEnrage/SoftEnrage.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                        <factor type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>1.1</multiplier>
                        </factor>
                        <sum type="gameMechanics.elements.calcers.LongData">
                            <value>1000</value>
                        </sum>
                        <canStartCooldown>true</canStartCooldown>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>PHYSICAL</element>
                <damage>70</damage>
                <impactsOnHitTarget>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>500</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                                <time>900</time>
                                <distance>15</distance>
                            </Item>
                        </impacts>
                    </Item>
                </impactsOnHitTarget>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>10</value>
        </angle>
    </shape>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>25</radius>
    <needLosToTarget>true</needLosToTarget>
</gameMechanics.constructor.schemes.spell.area.SpellArea>