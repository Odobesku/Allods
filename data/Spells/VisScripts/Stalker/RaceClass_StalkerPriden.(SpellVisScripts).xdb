		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureRunVisActionResource">
				<resource hrefvar="PreCastAnimation" />
			</Item>
			<Item type="CreatureRunVisActionResource">
				<resource hrefvar="PreCastFX" />
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
