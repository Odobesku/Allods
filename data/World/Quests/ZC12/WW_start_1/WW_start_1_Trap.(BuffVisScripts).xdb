						<SelfIllumColor>2018737862</SelfIllumColor>
						<DiffuseColor>2016959353</DiffuseColor>
						<PointLightColor>2020907964</PointLightColor>
						<FogColor>2181483</FogColor>
						<SpecularColor>7968966</SpecularColor>
						<ContourColor>5404301</ContourColor>
