<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect01Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2</scale>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectLightningWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Wand_Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirectedWand</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedWand</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectLightningWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Wand_Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
