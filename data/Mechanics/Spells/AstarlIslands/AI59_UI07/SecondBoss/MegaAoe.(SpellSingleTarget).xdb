<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>187992</resourceId>
    </Header>
    <Name href="MegaAoe.txt" />
    <visualScripts href="MegaAoe.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="MegaAoe.txt" />
    <descTemplate href="MegaAoe.Description.txt" />
    <prepareDuration>4000</prepareDuration>
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>30000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>10</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>PHYSICAL</element>
                                <damage>40</damage>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                <minDamage>60</minDamage>
                                <maxDamage>60</maxDamage>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                                <time>1000</time>
                                <impactsOnLand>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/AstarlIslands/AI59_UI07/FirstBoss/ChargeBuff02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impactsOnLand>
                                <distance>5</distance>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                            <filters>
                                <Item type="gameMechanics.world.creature.AliveFilter" />
                                <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </predicates>
                                </Item>
                            </filters>
                        </filter>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>