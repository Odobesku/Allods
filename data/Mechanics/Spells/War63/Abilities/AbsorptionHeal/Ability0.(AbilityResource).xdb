<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739921622</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="multiplier" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Quest/BodyOfStone.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <casterPreImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactHeal">
                    <heal>1</heal>
                    <scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.LongToFloatCalcer">
                            <calcer type="gameMechanics.elements.calcers.CalcerLongMulFloat">
                                <calcerLong type="gameMechanics.elements.calcers.CalcerDamagePoolBarrier" />
                                <calcerFloat type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="/Mechanics/Spells/War63/Spells/Absorption/Absorb.(CalcerFloatResource).xdb" />
                                </calcerFloat>
                            </calcer>
                        </mulCalcer>
                        <additionalMultiplier>
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.0003</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
                                    </stat>
                                    <valueType>ShortTerm</valueType>
                                </mulCalcer>
                                <sum>1</sum>
                            </scaler>
                            <value var="multiplier" />
                        </additionalMultiplier>
                    </scalerCaster>
                </Item>
            </casterPreImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/War63/Spells/Absorption/Spell01.(SpellSingleTarget).xdb" />
                </spells>
            </destination>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>