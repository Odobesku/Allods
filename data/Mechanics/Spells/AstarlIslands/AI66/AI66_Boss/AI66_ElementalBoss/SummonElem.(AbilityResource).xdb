<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739884256</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="ElementalBossPool.(SummonPool).xdb" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsToMapHeads">
					<map href="/Maps/AstralIsle66/MapResource.xdb" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="RoadToInferno.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</onLeave>
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.constructor.basicElements.ImpactList">
							<impactsResource href="Summon03.(ImpactListResource).xdb" />
						</Item>
					</impacts>
					<tick>40000</tick>
					<initialDelay>10000</initialDelay>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Visibility</channel>
				<vector>Outgoing</vector>
				<direction>Outgoing</direction>
				<plane href="/Mechanics/Spells/AstarlIslands/Dummy/DummyPlane.(Plane).xdb" />
			</visibilityRule>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
