<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>219450</resourceId>
    </Header>
    <Name href="Healing.(BuffResource).Name.txt" />
    <Description href="Healing.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Crafting/Component40Heal.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>8</radius>
                    <affectGroup>Friends</affectGroup>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
                            <affectGroup>Group</affectGroup>
                        </Item>
                    </conditions>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactHeal">
                            <heal>28.13</heal>
                            <scalerCaster type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.ScalerMax">
                                        <scaler1 type="gameMechanics.elements.scalers.HealScaler" />
                                        <scaler2 type="gameMechanics.elements.scalers.HealSlotScaler">
                                            <slot>MAINHAND</slot>
                                        </scaler2>
                                    </Item>
                                    <Item type="gameMechanics.elements.scalers.AbilityRankScaler">
                                        <ability href="/Mechanics/Spells/Engineer/Abilities/ExtraMechDmg/Ability01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                        <mul>0.04</mul>
                                    </Item>
                                </scalers>
                            </scalerCaster>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AliveFilter" />
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>