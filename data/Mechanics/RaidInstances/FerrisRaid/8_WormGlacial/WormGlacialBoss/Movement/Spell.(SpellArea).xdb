<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>221608</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/RaidInstances/Phase5.(ActionGroup).xdb" />
    </groups>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormGlacialBoss/WormGlacialBossFake.(MobWorld).xdb" />
                </mobs>
            </Item>
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="Visual.(BuffResource).xdb" />
                <consumeStacks>1</consumeStacks>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                <spell href="Spell.(SpellArea).xdb" />
                <duration>
                    <hour>1</hour>
                </duration>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormGlacialBoss/WormGlacialBossFake.(MobWorld).xdb" />
                                </mobs>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormGlacialBoss/MovementBuff.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                </impacts>
                            </Item>
                        </impactsIf>
                    </Item>
                </impacts>
                <spawnResource href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormBoss.(SpawnTable).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>0</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>