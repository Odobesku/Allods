<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <elements>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <elements>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>knockdownEnd</Item>
                        </animations>
                        <channel>CHANNEL_KNOCKDOWN</channel>
                        <advanced>
                            <speed>0.5</speed>
                        </advanced>
                    </Item>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/SummonUndead.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
        <restartOnVisualChange>true</restartOnVisualChange>
    </action>
</BuffVisScripts>