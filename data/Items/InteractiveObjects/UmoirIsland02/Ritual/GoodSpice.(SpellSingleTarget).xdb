<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>490389</resourceId>
    </Header>
    <Name href="GoodSpice.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateDeviceNear">
                <radius>5</radius>
                <devices>
                    <Item href="Kettle.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
                </devices>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <status>Active</status>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                <quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <counterResource href="/World/Quests/UmoirIsland02/UI02_Q04/Counter02.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                <quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <counterResource href="/Items/InteractiveObjects/UmoirIsland02/GoodSpice.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="/World/Quests/UmoirIsland02/UI02_Q04/GoodSpice.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>2000</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/Items/InteractiveObjects/UmoirIsland02/UI02_ShadowPotion.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </item>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>