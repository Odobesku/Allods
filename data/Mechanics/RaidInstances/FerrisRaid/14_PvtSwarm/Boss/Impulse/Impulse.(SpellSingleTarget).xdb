<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739912800</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/RaidInstances/Phase.(ActionGroup).xdb" />
	</groups>
	<Name href="Impulse.(SpellSingleTarget).Name.txt" />
	<visualScripts href="Impulse.(SpellVisScripts).xdb" />
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<isAggro>false</isAggro>
	<replaceLowRanks>false</replaceLowRanks>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<needInFront>false</needInFront>
	<mechanics>
		<cooldown>
			<duration>15000</duration>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
				<selector type="gameMechanics.tools.SelectorShuffle" />
				<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
				</filter>
				<impacts>
					<Item>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
								<element>ASTRAL</element>
								<damage>25</damage>
								<scaler type="gameMechanics.elements.scalers.MagicScaler" />
							</Item>
						</impacts>
					</Item>
				</impacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
				<selector type="gameMechanics.elements.calcers.RangeSelectorResource">
					<range min="0" max="1" />
					<withinRange>false</withinRange>
					<minCandidatesCount>1</minCandidatesCount>
					<targetCount>1</targetCount>
				</selector>
				<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
				</filter>
				<impacts>
					<Item>
						<impacts>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Boss/ChargeTheAvatar/ChargedAvatar_Instable.(BuffResource).xdb" />
							</Item>
