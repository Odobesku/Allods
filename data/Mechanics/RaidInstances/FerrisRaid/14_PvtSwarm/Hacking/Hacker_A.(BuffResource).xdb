<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739910639</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="HackIndicatorPlane_A.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="HackIndicatorPlane_A.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="HackIndicatorPlane_A.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="HackIndicatorPlane_A.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="HackIndicatorPlane_A.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="HackIndicatorPlane_A.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateDeviceNear">
                    <radius>25</radius>
                    <devices>
                        <Item href="HackIndicator_A.(SteleResource).xdb" />
                    </devices>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectAddContextActions">
                            <actions>
                                <Item href="Hack_Red.(SpellSingleTarget).xdb" />
                                <Item href="Hack_Green.(SpellSingleTarget).xdb" />
                                <Item href="Hack_Blue.(SpellSingleTarget).xdb" />
                                <Item href="Hack_Yellow.(SpellSingleTarget).xdb" />
                            </actions>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>500</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Combination/Difficulty.(BuffResource).xdb" />
                                    <impactsOnAttach>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Combination/CombinationCount.(BuffResource).xdb" />
                                            <impactsOnAttach>
                                                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                                    <impactsResource href="Combination/GetCombinationNumber1.(ImpactListResource).xdb" />
                                                </Item>
                                            </impactsOnAttach>
                                            <stacks type="gameMechanics.elements.calcers.FloatData">
                                                <value>2</value>
                                            </stacks>
                                        </Item>
                                    </impactsOnAttach>
                                    <stacks type="gameMechanics.elements.calcers.FloatData">
                                        <value>2</value>
                                    </stacks>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Hacker_A_Succeeded.(BuffResource).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
