<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739936149</resourceId>
	</Header>
	<Name href="ChargeBuff.(BuffResource).Name.txt" />
	<visScript href="ChargeRunningVisual.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectNoAggro" />
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>2000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectForceMove">
					<destinations>
						<Item type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
					</destinations>
					<impactsOnArrived>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ChargeBuff.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>8</radius>
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
									<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
									<minDamage>100</minDamage>
									<maxDamage>100</maxDamage>
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateOr">
										<predicates>
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
											</Item>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
										</predicates>
									</Item>
									<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
								</predicates>
							</filter>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChieftainBoss/Charge/ChargeHitFX.(ClientData).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
							<radius>5</radius>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
											<resources>
												<Item href="ChargeDecale.(ProjectileResource).xdb" />
											</resources>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.Disintegrate" />
									</impactsIf>
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
						</Item>
					</impactsOnArrived>
				</Item>
				<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
					<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
						<coeff>2</coeff>
					</effectScaler>
				</Item>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.RunImpactsInShape">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateOr">
											<predicates>
												<Item type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
												</Item>
												<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											</predicates>
										</Item>
										<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
											<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
											<minDamage>50</minDamage>
											<maxDamage>50</maxDamage>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
							<shape type="gameMechanics.constructor.schemes.spell.area.RectangularRay">
								<width>2</width>
							</shape>
							<affectGroup>Enemies</affectGroup>
							<radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
								<value>10</value>
							</radius>
							<affectMainTarget>false</affectMainTarget>
						</Item>
					</impacts>
					<tick>500</tick>
					<initialDelay>1000</initialDelay>
				</Item>
			</effects>
		</Item>
	</effects>
	<duration>10000</duration>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
