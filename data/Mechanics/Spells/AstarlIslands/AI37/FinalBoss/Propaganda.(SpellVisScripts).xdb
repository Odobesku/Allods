<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellDirected</Item>
                </animations>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Spells/PsionicSuffocateAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <startPoint type="VisPointLocator">
                    <locator>Slot_Hand_L</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Head</locator>
                </endPoint>
                <fadeInTime>200</fadeInTime>
                <fadeOutTime>100</fadeOutTime>
                <offendTime type="EffectOffendConstDelay" />
            </Item>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PsionicSuffocateAbilityHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Head</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectAstralWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_Hand_L</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
</SpellVisScripts>