<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<animations>
			<Item>channelCastDirected</Item>
		</animations>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/FerrisRaid_Wave_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<scale>1</scale>
						<locator>Global</locator>
						<offset x="0.3" y="-1" z="0.5" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
