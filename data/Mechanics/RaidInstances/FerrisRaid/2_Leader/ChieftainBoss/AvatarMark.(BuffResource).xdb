<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739896205</resourceId>
    </Header>
    <image href="/Interface/Icons/Spells/Necromancer/SummonSkeleton.chn.(UISingleTexture).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.DeathTrigger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="AvatarMark.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>2_ChieftainBoss</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="AvatarMark.(BuffResource).xdb" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="RespawnZeeChampions.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOff>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <stackLimit>60</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>