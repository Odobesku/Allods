<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739924939</resourceId>
    </Header>
    <Name href="R7_InfPsyker_Anomaly.(BuffResource).Name.txt" />
    <Description href="R7_InfPsyker_Anomaly.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Trinket/AstralBomb_01.(UISingleTexture).xdb" />
    <visScript href="/Mechanics/Spells/HuntingGrounds7/HG7Dragon/HG7_Dragon_BombBuff.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>25000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisorient">
            <radius>60</radius>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.4</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>6</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>LIGHTNING</element>
                            <damage>65</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>1000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Inf_Plane_ForProjectile.(Plane).xdb" />
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/RaidInstances/ArchBaseRaid/SiegeBoss/R7_ArchBase_Raid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>