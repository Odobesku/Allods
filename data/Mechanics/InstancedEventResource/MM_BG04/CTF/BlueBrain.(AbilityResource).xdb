<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739910751</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactSummon">
							<destination type="gameMechanics.map.destination.DestinationModified">
								<destination type="gameMechanics.map.destination.DestinationLocator">
									<locator>
										<scriptID>StartBlue_04</scriptID>
										<map href="/Maps/Domination04/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
									</locator>
								</destination>
								<modifiers>
									<Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
										<alternatives>
											<Item type="gameMechanics.map.destination.modifier.SpreadModifier">
												<verticalRange min="0" max="0" />
												<horizontalRange min="1" max="6" />
											</Item>
										</alternatives>
										<safetyRadius>0.05</safetyRadius>
									</Item>
								</modifiers>
							</destination>
							<object href="SummonBlueBots.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
							<pool href="/Mechanics/InstancedEventResource/MM_BG04/Mobs/Blue.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="avatarPopulation.service.impl.matchMakingImpl.event.EffectInstancedEventMember">
			<mark href="/Maps/Domination04/Marks/BlueMark.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactSetFaction">
					<faction href="/Mechanics/InstancedEventResource/MM_BG04/Mobs/BlueBoots.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
				</Item>
			</impactsOn>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
