<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739925123</resourceId>
	</Header>
	<name href="RD3_Boss02_Bomb.(ProjectileResource).Name.txt" />
	<visObject href="RD3_Boss02_Bomb.(VisObjectTemplate).xdb" />
	<altitude>1.4</altitude>
	<speed>0.002</speed>
	<lifeLengthCap>6000</lifeLengthCap>
	<impactsOnDeath>
		<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
			<projectileData>
				<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
				<resource href="RD3_Boss02_BombExplosion.(ProjectileResource).xdb" />
			</projectileData>
		</Item>
	</impactsOnDeath>
	<impactsOnStart>
		<Item type="gameMechanics.elements.impacts.RepeatedImpact">
			<impact type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
				<projectileData>
					<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
						<destination type="gameMechanics.map.destination.DestinationModified">
							<destination type="gameMechanics.map.destination.RelativePos" />
							<modifiers>
								<Item type="gameMechanics.map.destination.modifier.ModifierTrail">
									<modifier type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
										<radius type="gameMechanics.elements.calcers.FloatData">
											<value>12</value>
										</radius>
									</modifier>
								</Item>
							</modifiers>
						</destination>
					</moveType>
					<resource href="RD3_Boss02_Bomb2.(ProjectileResource).xdb" />
				</projectileData>
			</impact>
			<count type="gameMechanics.elements.calcers.FloatData">
				<value>2</value>
			</count>
		</Item>
	</impactsOnStart>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>2000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.TickableEntityAura">
					<affectGroup>All</affectGroup>
					<radius>6</radius>
					<filter type="gameMechanics.constructor.basicElements.FilterAnd">
						<filters>
							<Item type="gameMechanics.world.creature.AvatarFilter" />
							<Item type="gameMechanics.world.creature.AliveFilter" />
						</filters>
					</filter>
					<holderImpactsIn>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
								<resource href="RD3_Boss02_BombExplosion.(ProjectileResource).xdb" />
							</projectileData>
						</Item>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</holderImpactsIn>
				</Item>
			</effects>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
