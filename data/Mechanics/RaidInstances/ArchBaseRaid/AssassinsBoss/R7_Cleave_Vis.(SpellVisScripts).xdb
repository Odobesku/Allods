<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ColossusCleave_Decal.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<locator>Global</locator>
						<offset y="-32" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Colossus_Ready_CleaveRes.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<scale>1.2</scale>
						<locator>Global</locator>
						<locatorName />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Colossus_Ready_CleaveRes_01.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<scale>1.8</scale>
						<locator>Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="AttachedVisObjectComponent">
						<visObject href="/Spells/FX/Mobs/Colossus_Ready_CleaveRes.(VisObjectTemplate).xdb" />
						<rotation x="-1" w="0" />
						<scale>1.2</scale>
						<locatorName>Global</locatorName>
					</Item>
				</visObjComponents>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>2000</delay>
						<effectFx href="/Spells/FX/Mobs/Architect_Swarm_CleaveResCast.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<scale>0.6</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>