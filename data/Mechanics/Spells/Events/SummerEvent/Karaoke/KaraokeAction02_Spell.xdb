<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>209312</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ActionBarChange.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/Events/EventSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="KaraokeAction02_Spell_Name.txt" />
    <Description href="KaraokeAction02_Spell_Desc.txt" />
    <image href="/Interface/Icons/Misc/Event/SummerEventKaraoke02.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <sysName>B2</sysName>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>3500</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                <zone href="/Maps/Tropical_Atoll/ScriptZones/Karaoke.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                    <buff href="SongNumber_Buff_ForOfflineDecay.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <range>
                        <min>5</min>
                        <max>5</max>
                    </range>
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                <spawn>
                    <scriptID>KaraokeFolk</scriptID>
                    <map href="/Maps/Tropical_Atoll/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                </spawn>
                <onBehalfOfTarget>true</onBehalfOfTarget>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="Karaoke02_Buff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                <impactsResource href="ActionSuccess02.xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                        <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                        <data href="Chat/SongPart02_Fail.xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsElse>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>