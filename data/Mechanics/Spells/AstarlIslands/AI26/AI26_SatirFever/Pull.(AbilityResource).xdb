<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>192133</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>50</radius>
                                    <affectGroup>Enemies</affectGroup>
                                    <conditions>
                                        <Item type="gameMechanics.elements.predicates.PredicateDistance">
                                            <range min="10" max="40" />
                                        </Item>
                                    </conditions>
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                                    <targetsLimit>1</targetsLimit>
                                    <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="Spell01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Start</Item>
            </stages>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>