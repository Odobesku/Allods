            <Item>
                <animation>emoteHoldIdle</animation>
                <playOnMount>idle</playOnMount>
                <playOnRiderBottom>mountStoveIdle</playOnRiderBottom>
                <playOnRiderTop>emoteHoldIdle</playOnRiderTop>
