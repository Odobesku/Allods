<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739866150</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Spell.(SpellArea).Name.txt" />
	<visScript href="/Spells/VisScripts/Engineer/FlamethroweBuffV2.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellActivate">
					<spell hrefvar="spell" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="FlameThrowerCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
					<spell hrefvar="spell" />
				</Item>
				<Item type="gameMechanics.elements.impacts.PostponedImpacts">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="7tics.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="FlameThrowerCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactModifySpellGroupCooldown">
					<group href="/Mechanics/Spells/Groups/EngineerFlamethrowerSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
					<factor>1</factor>
					<sum type="gameMechanics.elements.calcers.FloatToLongCalcer">
						<calcer type="gameMechanics.elements.calcers.CalcerBuffDuration">
							<buff href="FlameThrowerCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							<multiplier>1</multiplier>
						</calcer>
					</sum>
					<canStartCooldown>true</canStartCooldown>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectModifyManaRegen">
			<manaType>Energy</manaType>
			<multiplier type="gameMechanics.elements.calcers.FloatData">
				<value>0.5</value>
			</multiplier>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
					<variable href="/Mechanics/Spells/Engineer/Overheating/Overheating.(VariableResource).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
					<summand>30</summand>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.RunImpactsInShape">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>FIRE</element>
									<damage var="damage" />
									<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
										<scalers>
											<Item type="gameMechanics.elements.scalers.MagicScaler" />
											<Item type="gameMechanics.elements.scalers.AbilityRankScaler">
												<ability href="/Mechanics/Spells/Engineer/Abilities/FlamethrowerUpg/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
												<mul>0.05</mul>
											</Item>
										</scalers>
									</scaler>
								</Item>
							</impacts>
							<shape type="gameMechanics.constructor.schemes.spell.area.Cone">
								<angle type="constructor.basicElements.AngleDegrees">
									<value>15</value>
								</angle>
							</shape>
							<affectGroup>Enemies</affectGroup>
							<radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
								<value>15</value>
							</radius>
							<targetsNum>1</targetsNum>
							<workOnDead>false</workOnDead>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateGreater">
									<lhs type="gameMechanics.elements.calcers.VariableValueCalcer">
										<variable href="/Mechanics/Spells/Engineer/Overheating/Overheating.(VariableResource).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
									</lhs>
									<rhs type="gameMechanics.elements.calcers.FloatData">
										<value>185</value>
									</rhs>
								</Item>
							</predicates>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
									<data href="Overheating.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="BurnEmR1.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.PostponedImpacts">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="7tics.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>1200</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
			<predicate type="gameMechanics.constructor.basicElements.PredicateGenericNot">
				<predicate type="gameMechanics.constructor.basicElements.PredicateGenericOr">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="FlamethrowerV2R1.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
							</spells>
						</Item>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="/Mechanics/Spells/Fairy/Willpower/Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
							</spells>
						</Item>
					</predicates>
				</predicate>
			</predicate>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<ranks>
		<Item href="BurnEmR1.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
		<Item href="BurnEmR2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
		<Item href="BurnEmR3.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<isForthright>true</isForthright>
</gameMechanics.constructor.schemes.buff.BuffResource>
