<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>ButtonStart</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Size>128</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Size>38</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>250</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>button_start_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>false</Visible>
    <clipContent>false</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag>button_label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/Contextructor/GreenButtonRegular2/GreenButtonRegularHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="-2" y="2"/>
            <Reaction>start_scenario_pressed</Reaction>
            <ReactionRightClick>start_scenario_pressed</ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Ingame/Contextructor/GreenButtonRegular2/ButtonFormatDisabled.txt"/>
                <LayerMain href="/Interface/Ingame/Contextructor/GreenButtonRegular2/GreenButtonRegularDisabled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateDisabled>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/Contextructor/GreenButtonRegular2/ButtonFormatNormal.txt"/>
                <LayerMain href="/Interface/Ingame/Contextructor/GreenButtonRegular2/GreenButtonRegularNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/Contextructor/GreenButtonRegular2/GreenButtonRegularPressed.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/QuestTracker/Toolbar/texts/ButtonStartLabel.txt"/>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <LayerHighlight href="/Interface/Ingame/Contextructor/RedButtonRegular2/RedButtonRegularHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="-2" y="2"/>
            <Reaction>stop_scenario_pressed</Reaction>
            <ReactionRightClick>stop_scenario_pressed</ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Ingame/Contextructor/GreenButtonRegular2/ButtonFormatDisabled.txt"/>
                <LayerMain href="/Interface/Ingame/Contextructor/RedButtonRegular2/RedButtonRegularDisabled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateDisabled>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/Contextructor/GreenButtonRegular2/ButtonFormatNormal.txt"/>
                <LayerMain href="/Interface/Ingame/Contextructor/RedButtonRegular2/RedButtonRegularNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/Contextructor/RedButtonRegular2/RedButtonRegularPressed.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/QuestTracker/Toolbar/texts/ButtonStopLabel.txt"/>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
