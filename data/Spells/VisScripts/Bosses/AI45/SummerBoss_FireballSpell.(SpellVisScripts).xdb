<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>readySpell</PreCastAnimation>
			<FXOnTargets />
			<LocatorNameOnTargets />
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<FixPointTarget>true</FixPointTarget>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<HitPostFXOnTargets />
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/DC_2BossMindflayer_ReadySpellDirectDown_Fire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="CreatureProjectileAction">
		<projectileFx href="/Spells/FX/Spells/MageFireballAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
		<explosionFx href="/Spells/FX/Spells/HitFireball.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
		<pointOnTarget type="VisPointLocator">
			<locator>Slot_FX</locator>
		</pointOnTarget>
	</launch>
</SpellVisScripts>
