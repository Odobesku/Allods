<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>200140</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impactsToKiller>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>Boss_01</scriptID>
                        <map href="/Maps/Inst_TepPyramid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <onBehalfOfTarget>true</onBehalfOfTarget>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Boss_01_Turret_03.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsToKiller>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>500</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>