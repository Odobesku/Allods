    <prepareDuration>1000</prepareDuration>
    <targetType>STTSelf</targetType>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceItem">
                <item href="UI07_Rum2.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                <zone href="/Maps/UmoirIsland07/ScriptZones/UI07_Gate_02.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                <quest href="/World/Quests/UmoirIsland07/UI07_Quest1/UI07_Quest1.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <counterResource href="UI07_Rum2.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="/World/Quests/UmoirIsland07/UI07_Quest1/CountId_8.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                <spawn>
                    <scriptID>Gate_02</scriptID>
                    <map href="/Maps/UmoirIsland07/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                </spawn>
                <impacts>
                    <Item type="gameMechanics.elements.device.DoorSwitch">
                        <switchType>Open</switchType>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
                        <item href="UI07_Rum2.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactStopSpawn">
                <table href="/Maps/UmoirIsland07/SpawnTables/UI07_AcademyHyenes2.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.Disintegrate" />
                </impacts>
                <spawnResource href="/Maps/UmoirIsland07/SpawnTables/UI07_AcademyHyenes2.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
