                        </Item>
                        <Item type="gameMechanics.elements.calcers.CalcerMax">
                            <calcers>
                                <Item type="gameMechanics.world.device.CalcerTechLevelDelta" />
                                <Item type="gameMechanics.elements.calcers.FloatData">
