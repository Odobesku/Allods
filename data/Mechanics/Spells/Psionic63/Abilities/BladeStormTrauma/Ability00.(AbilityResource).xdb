                                            <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                                <onMaster type="gameMechanics.elements.predicates.PredicateHasSpell">
                                                    <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionTrauma/Spell01.(SpellSingleTarget).xdb" />
                                                    <anyRank>false</anyRank>
                                                </onMaster>
                                            </predicate>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactsUnderEnvelope">
                                                    <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionTrauma/Spell01.(SpellSingleTarget).xdb" />
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="/Mechanics/Spells/Psionic63/Spells/SuggestionTrauma/Buff01.(BuffResource).xdb" />
                                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                <multiplier>0.33</multiplier>
                                                            </durationScaler>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsIf>
                                            <impactsElse>
                                                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                                                    <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                                        <onMaster type="gameMechanics.elements.predicates.PredicateHasSpell">
                                                            <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionTrauma/Spell02.(SpellSingleTarget).xdb" />
                                                            <anyRank>false</anyRank>
                                                        </onMaster>
                                                    </predicate>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.elements.impacts.ImpactsUnderEnvelope">
                                                            <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionTrauma/Spell01.(SpellSingleTarget).xdb" />
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="/Mechanics/Spells/Psionic63/Spells/SuggestionTrauma/Buff02.(BuffResource).xdb" />
                                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                        <multiplier>0.33</multiplier>
                                                                    </durationScaler>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impactsIf>
                                                    <impactsElse>
                                                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                                                            <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                                                <onMaster type="gameMechanics.elements.predicates.PredicateHasSpell">
                                                                    <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionTrauma/Spell03.(SpellSingleTarget).xdb" />
                                                                    <anyRank>false</anyRank>
                                                                </onMaster>
                                                            </predicate>
                                                            <impactsIf>
                                                                <Item type="gameMechanics.elements.impacts.ImpactsUnderEnvelope">
                                                                    <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionTrauma/Spell01.(SpellSingleTarget).xdb" />
                                                                    <impacts>
                                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                            <buff href="/Mechanics/Spells/Psionic63/Spells/SuggestionTrauma/Buff03.(BuffResource).xdb" />
                                                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                                <multiplier>0.33</multiplier>
                                                                            </durationScaler>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impactsIf>
                                                        </Item>
                                                    </impactsElse>
                                                </Item>
                                            </impactsElse>
