<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Description href="/Spells/VisScripts/Prototypes/Parts/Base.Description.txt" />
    <actionBarStart type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.CreatureAnimationAction">
                <advanced>
                    <autoHasten>
                        <mode>AUTOHASTEN_NONE</mode>
                        <timeToBeLeft>0</timeToBeLeft>
                    </autoHasten>
                    <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                    <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                    <offendType>NO_OFFEND</offendType>
                    <speed>0</speed>
                    <turnToTarget>TURN_DEFAULT</turnToTarget>
                    <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                    <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
                    <denyAutoHasten>false</denyAutoHasten>
                    <disableRandomFirstFrame>true</disableRandomFirstFrame>
                    <eventPlaybackEnd>false</eventPlaybackEnd>
                    <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                    <stopIfMoved>false</stopIfMoved>
                    <stopIfRotated>false</stopIfRotated>
                </advanced>
                <channel>CHANNEL_DEFAULT</channel>
                <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                <mode>DIE</mode>
                <use>USE_ANIMATIONS</use>
                <dontFreezePrecast>false</dontFreezePrecast>
            </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </actionBarStart>
    <precastType>PRECAST_DEFAULT</precastType>
    <wholeCasting type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.CreatureEffectsAction">
                <category>EFFECT_DEFAULT</category>
                <visualEffects>
                    <Item>
                        <delay>0</delay>
                        <effectAnimations>
                            <mode>DIE</mode>
                        </effectAnimations>
                        <fadeInTime>0</fadeInTime>
                        <fadeOutTime>0</fadeOutTime>
                        <scale>1</scale>
                        <fixPoint>false</fixPoint>
                        <lockScale>false</lockScale>
                        <muteFxSounds>false</muteFxSounds>
                        <ignoreParentRotation>true</ignoreParentRotation>
                        <locator>Global</locator>
                        <member>Default_Member</member>
                        <offset x="0" y="0" z="0" />
                        <rotation x="0" y="0" z="0" w="0" />
                        <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                    </Item>
                    <Item>
                        <delay>0</delay>
                        <effectAnimations>
                            <mode>DIE</mode>
                        </effectAnimations>
                        <fadeInTime>0</fadeInTime>
                        <fadeOutTime>0</fadeOutTime>
                        <scale>1</scale>
                        <fixPoint>false</fixPoint>
                        <lockScale>false</lockScale>
                        <muteFxSounds>false</muteFxSounds>
                        <ignoreParentRotation>false</ignoreParentRotation>
                        <locator>Global</locator>
                        <member>Default_Member</member>
                        <offset x="0" y="0" z="0" />
                        <rotation x="0" y="0" z="0" w="0" />
                        <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                    </Item>
                </visualEffects>
                <dontFade>false</dontFade>
                <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                <stopOnDeath>false</stopOnDeath>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </wholeCasting>
    <launch type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.CreatureAnimationAction">
                <advanced>
                    <autoHasten>
                        <mode>AUTOHASTEN_NONE</mode>
                        <timeToBeLeft>0</timeToBeLeft>
                    </autoHasten>
                    <changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
                    <channelAfterFirstKey>CHANNEL_ABILITY</channelAfterFirstKey>
                    <offendType>NO_OFFEND</offendType>
                    <speed>0</speed>
                    <turnToTarget>TURN_DEFAULT</turnToTarget>
                    <waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                    <denyAutoHasten>false</denyAutoHasten>
                    <disableRandomFirstFrame>true</disableRandomFirstFrame>
                    <eventPlaybackEnd>true</eventPlaybackEnd>
                    <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                    <stopIfMoved>false</stopIfMoved>
                    <stopIfRotated>false</stopIfRotated>
                </advanced>
                <channel>CHANNEL_DEFAULT</channel>
                <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                <mode>DIE</mode>
                <use>USE_ANIMATIONS</use>
                <dontFreezePrecast>false</dontFreezePrecast>
            </Item>
            <Item type="client.Replica.VisActionList">
                <elements>
                    <Item type="client.Replica.CreatureEffectsAction">
                        <category>EFFECT_DEFAULT</category>
                        <visualEffects>
                            <Item>
                                <delay>0</delay>
                                <effectAnimations>
                                    <mode>DIE</mode>
                                </effectAnimations>
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <scale>1</scale>
                                <fixPoint>false</fixPoint>
                                <lockScale>false</lockScale>
                                <muteFxSounds>false</muteFxSounds>
                                <ignoreParentRotation>true</ignoreParentRotation>
                                <locator>Global</locator>
                                <member>Default_Member</member>
                                <offset x="0" y="0" z="0" />
                                <rotation x="0" y="0" z="0" w="0" />
                                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                            </Item>
                        </visualEffects>
                        <dontFade>false</dontFade>
                        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                        <stopOnDeath>false</stopOnDeath>
                    </Item>
                    <Item type="client.Replica.VisActionList">
                        <elements>
                            <Item type="client.Replica.CreatureVisActionStartThrow" />
                            <Item type="client.Replica.CreatureProjectileAction">
                                <explosionFx href="/Spells/FX/Spells/HitBlood.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                                <optionalSpeed>0</optionalSpeed>
                                <pointOnCaster type="client.Replica.VisPointLocator">
                                    <shift x="0" y="0" z="0" />
                                    <from>FROM_DEFALUT</from>
                                    <locator>Slot_Hand_L</locator>
                                    <member>Default_Member</member>
                                </pointOnCaster>
                                <pointOnTarget type="client.Replica.VisPointLocator">
                                    <shift x="0" y="0" z="0" />
                                    <from>FROM_DEFALUT</from>
                                    <locator>Slot_FX</locator>
                                    <member>Default_Member</member>
                                </pointOnTarget>
                                <projectileFx href="/Spells/FX/Mobs/SnowFolkRanger_Boss_Axe_Big.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                                <theGe>4</theGe>
                                <dontFade>false</dontFade>
                                <isInverted>false</isInverted>
                                <isMultyProjectile>false</isMultyProjectile>
                            </Item>
                        </elements>
                        <play>InSequence</play>
                        <preconditional>false</preconditional>
                        <restartOnVisualChange>false</restartOnVisualChange>
                        <stopOnDeath>false</stopOnDeath>
                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                    </Item>
                </elements>
                <play>Simultaneously</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </launch>
    <ownKillingParams>
        <probabilityNoOverkill>0.2</probabilityNoOverkill>
        <probabilityWithOverkill>1</probabilityWithOverkill>
    </ownKillingParams>
    <playOnTargets>
        <specialAction type="client.Replica.VisActionList">
            <elements>
                <Item type="client.Replica.CreatureEffectsAction">
                    <category>EFFECT_DEFAULT</category>
                    <visualEffects>
                        <Item>
                            <delay>0</delay>
                            <effectAnimations>
                                <mode>DIE</mode>
                            </effectAnimations>
                            <fadeInTime>0</fadeInTime>
                            <fadeOutTime>0</fadeOutTime>
                            <scale>1</scale>
                            <fixPoint>true</fixPoint>
                            <lockScale>true</lockScale>
                            <muteFxSounds>false</muteFxSounds>
                            <ignoreParentRotation>false</ignoreParentRotation>
                            <locator>Global</locator>
                            <member>Default_Member</member>
                            <offset x="0" y="0" z="0" />
                            <rotation x="0" y="0" z="0" w="0" />
                            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                        </Item>
                    </visualEffects>
                    <dontFade>false</dontFade>
                    <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                    <stopOnDeath>false</stopOnDeath>
                </Item>
                <Item type="client.Replica.CreatureRunVisActionResource" />
            </elements>
            <play>Simultaneously</play>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
        </specialAction>
        <skipBloodFx>false</skipBloodFx>
        <skipHitAnimations>false</skipHitAnimations>
    </playOnTargets>
    <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>