<?xml version ="1.0" encoding="UTF-8" ?>
<VisualObjectComponents>
    <components>
        <Item type="AnimationFromParentComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <animationsReplacements>
                <Item>
                    <forAnimations>
                        <Item>idle</Item>
                        <Item>idle01</Item>
                        <Item>idle02</Item>
                    </forAnimations>
                    <play>idle</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>jump</Item>
                        <Item>specialJump</Item>
                    </forAnimations>
                    <play>jump</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>jumpEnd</Item>
                    </forAnimations>
                    <play>jumpEnd</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>jumpLandRun</Item>
                    </forAnimations>
                    <play>jumpLandRun</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>jumpStart</Item>
                    </forAnimations>
                    <play>jumpStart</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>run</Item>
                        <Item>runStart</Item>
                        <Item>special</Item>
                    </forAnimations>
                    <play>run</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>spellCastOmni</Item>
                    </forAnimations>
                    <play>spellCastOmni</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>walk</Item>
                    </forAnimations>
                    <play>walk</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>walkBackwards</Item>
                    </forAnimations>
                    <play>walkBackwards</play>
                </Item>
            </animationsReplacements>
            <ifAnimationNotExistsRun>idle</ifAnimationNotExistsRun>
            <skipBlendOptimization>false</skipBlendOptimization>
            <synchronizeAnimationPosition>false</synchronizeAnimationPosition>
        </Item>
    </components>
</VisualObjectComponents>
