<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>216055</resourceId>
    </Header>
    <Name href="BeaconStuff.(BuffResource).Name.txt" />
    <Description href="BeaconStuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/Beacon.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Engineer63/Spells/Titan/TitanInvisPlane.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                            <addresseeFinder type="gameMechanics.elements.abilities.FinderPsionicContactAddress">
                                                <contactType>Normal</contactType>
                                            </addresseeFinder>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateCanMove" />
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                            <predicates>
                                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                            </predicates>
                                                            <impactsIf>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="TeleportingFriend.(BuffResource).xdb" />
                                                                </Item>
                                                            </impactsIf>
                                                            <impactsElse>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="Teleporting.(BuffResource).xdb" />
                                                                </Item>
                                                            </impactsElse>
                                                        </Item>
                                                    </impactsIf>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.elements.abilities.FinderPsionicContactAddress">
                                <contactType>Normal</contactType>
                            </addresseeFinder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Teleporting.(BuffResource).xdb" />
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="BeaconLifetime.(BuffResource).xdb" />
                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactKill" />
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
            <predicate type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
            </predicate>
        </Item>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <affectsPureHeal>true</affectsPureHeal>
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatFullHealth" />
            <multiplier>0.25</multiplier>
        </Item>
    </effects>
    <duration>5000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/EngineerSpecialDevices.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>