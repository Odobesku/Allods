                                                            </destination>
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                                                            <device>
                                                                <scriptID>Dome_2</scriptID>
                                                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                            </device>
                                                        </Item>
                                                    </impactsIf>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                                            <zone href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Dome_2.(ScriptZone).xdb" />
                                                        </Item>
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                                                <locator>
                                                                    <scriptID>Dome_3_Loc</scriptID>
                                                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                                </locator>
                                                            </destination>
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                                                            <device>
                                                                <scriptID>Dome_3</scriptID>
                                                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                            </device>
                                                        </Item>
                                                    </impactsIf>
                                                </Item>
                                            </impacts>
                                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                <predicates>
                                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                        <mobs>
                                                            <Item href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Allies/DiArder.(MobWorld).xdb" />
                                                        </mobs>
                                                    </Item>
