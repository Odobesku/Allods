<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>223022</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Boss/HideMe.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>RoboGuards_doorR</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Close</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>RoboGuards_doorL</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Close</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>RoboGuards_door</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Close</switchType>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                                    <zone href="/Maps/FerrisRaid/ScriptZones/FR12.(ScriptZone).xdb" />
                                                </Item>
                                            </predicates>
                                            <impactsElse>
                                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                                    <destination type="gameMechanics.map.destination.DestinationLocatorSpread">
                                                        <locator>
                                                            <scriptID>FR_12</scriptID>
                                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                        </locator>
                                                        <horizontalSpread>6</horizontalSpread>
                                                    </destination>
                                                </Item>
                                            </impactsElse>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impacts>
                                            <spawnResource href="Decoy.(SpawnTable).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impacts>
                                            <spawnResource href="Decoy/Fake_Chest.(SpawnTable).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.map.variables.PredicateMapVariableLess">
                                                    <variableResource href="12_Saw.(MapVariableResource).xdb" />
                                                    <maxValue type="gameMechanics.elements.calcers.FloatData">
                                                        <value>1</value>
                                                    </maxValue>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                                                    <table href="Levers.(SpawnTable).xdb" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                                            <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impacts>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                            <spawn>
                                                <scriptID>12_Speaker_1</scriptID>
                                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                            </spawn>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                    <delay>2500</delay>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                                                            <impacts>
                                                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                                                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                                                    <data href="/Mechanics/RaidInstances/FerrisRaid/Voice/12_Saw/50_RaidWiped.(ClientData).xdb" />
                                                                                </Item>
                                                                            </impacts>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>RoboGuards_doorR</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.device.DoorSwitch">
                                    <switchType>Open</switchType>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>RoboGuards_doorL</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.device.DoorSwitch">
                                    <switchType>Open</switchType>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>RoboGuards_door</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.device.DoorSwitch">
                                    <switchType>Open</switchType>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                    <group href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                    <group href="/Mechanics/Spells/Groups/FerrisRaid_Worm.(ActionGroup).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.75</coeff>
            </scaler>
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>12_Chest</scriptID>
                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                    <object href="/Mechanics/RaidInstances/FerrisRaid/Other/Loot/12_Chest_HM.(ChestResource).xdb" />
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>12_Chest</scriptID>
                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                    <object href="/Mechanics/RaidInstances/FerrisRaid/Other/Loot/12_Chest.(ChestResource).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                        <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                            <variable href="12_Saw.(MapVariableResource).xdb" />
                            <summand>1</summand>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                            <group href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                            <data href="/Mechanics/RaidInstances/FerrisRaid/Voice/12_Saw/60_BossDeath.(ClientData).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
            <impactsToTarget>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/RaidInstances/Tank.(BuffResource).xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>3</multiplier>
                    </durationScaler>
                </Item>
            </impactsToTarget>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
            <quality href="/Mechanics/RaidInstances/FerrisRaid/Other/Part3_Stats.(MobStatQuality).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.005</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/RaidInstances/FerrisRaid/Voice/VoiceCooldown.(BuffResource).xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>1.2e+006</multiplier>
                    </durationScaler>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>