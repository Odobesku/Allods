<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureMountVisAction">
                <visualMount href="Boss02_Carpet.(VisualMount).xdb#xpointer(/VisualMount)" />
            </Item>
            <Item type="CreatureChangeVisItemsAction">
                <items>
                    <Item>
                        <slot>LIFESTYLEBACK</slot>
                        <newItem href="/Mechanics/Spells/Mounts/HideShield/HideShield.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                    </Item>
                </items>
            </Item>
        </elements>
    </action>
</BuffVisScripts>