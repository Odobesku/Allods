<?xml version="1.0" encoding="UTF-8"?>
<VisObjectTemplate>
	<defaultState>
		<sound>
			<creationRadius>-1</creationRadius>
		</sound>
		<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
		<playSoundOnKeys>true</playSoundOnKeys>
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>400</fadeInMS>
	<fadeOutMS>0</fadeOutMS>
	<geometry href="AC9_Generator_Broken.(Geometry).xdb#xpointer(/Geometry)" />
	<replaceDistance>-1</replaceDistance>
	<scale>2</scale>
	<sound>
		<creationRadius>-1</creationRadius>
	</sound>
	<states>
		<Item>
			<keySounds>
				<Item>
					<tunedSounds>
						<Item>
							<pitch>0</pitch>
							<sound>
								<creationRadius>-1</creationRadius>
								<name>spells/Hits/StoneHit</name>
								<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
							</sound>
							<volume>0.3</volume>
							<overrideMoveSFX>false</overrideMoveSFX>
						</Item>
						<Item>
							<pitch>0</pitch>
							<sound>
								<creationRadius>-1</creationRadius>
								<name>spells/Hits/RocketHit</name>
								<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
							</sound>
							<volume>1</volume>
							<overrideMoveSFX>false</overrideMoveSFX>
						</Item>
					</tunedSounds>
				</Item>
			</keySounds>
			<sound>
				<creationRadius>-1</creationRadius>
			</sound>
			<allowMultipleSoundInstances>true</allowMultipleSoundInstances>
			<playSoundOnKeys>false</playSoundOnKeys>
			<animation href="AC9_Generator_Broken.(SkeletalAnimation).xdb#xpointer(/SkeletalAnimation)" />
			<isNecessaryAnim>false</isNecessaryAnim>
		</Item>
	</states>
	<drawBehindCamera>false</drawBehindCamera>
	<softReplace>false</softReplace>
</VisObjectTemplate>