                                <quest href="Pride_2_5.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                <counterResource href="CountId_4.xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
