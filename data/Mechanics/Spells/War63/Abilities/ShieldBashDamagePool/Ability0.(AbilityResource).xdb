<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739921607</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability0.(AbilityResource).Name.txt" />
	<description href="Ability0.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mulCalcer type="gameMechanics.elements.calcers.LongToFloatCalcer">
					<calcer type="gameMechanics.elements.calcers.CalcerLongMulFloat">
						<calcerLong type="gameMechanics.elements.calcers.LongData">
							<value var="valueRetrive" />
						</calcerLong>
						<calcerFloat type="gameMechanics.constructor.basicElements.ScalerCalcer">
							<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
								<formula>HealScaler</formula>
							</scaler>
							<value>1</value>
						</calcerFloat>
					</calcer>
				</mulCalcer>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Equipment/Shield/ShieldKnight.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.constructor.schemes.spell.spellstate.TriggerSpellActivate">
			<spell href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Spell01.(SpellSingleTarget).xdb" />
			<effectsOn>
				<Item type="gameMechanics.elements.effects.SpellExtraImpacts">
					<casterImpacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
									<lhs type="gameMechanics.elements.calcers.CalcerDamagePoolBarrier" />
									<rhs type="gameMechanics.elements.calcers.LongData">
										<value>0</value>
									</rhs>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactHeal">
									<heal>1</heal>
									<scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mulCalcer type="gameMechanics.elements.calcers.CalcerMin">
											<calcers>
												<Item type="gameMechanics.elements.calcers.LongToFloatCalcer">
													<calcer type="gameMechanics.elements.calcers.CalcerLongMulFloat">
														<calcerLong type="gameMechanics.elements.calcers.LongData">
															<value var="valueRetrive" />
														</calcerLong>
														<calcerFloat type="gameMechanics.constructor.basicElements.ScalerCalcer">
															<scaler type="gameMechanics.elements.scalers.HealScaler" />
															<value>1</value>
														</calcerFloat>
													</calcer>
												</Item>
												<Item type="gameMechanics.elements.calcers.LongToFloatCalcer">
													<calcer type="gameMechanics.elements.calcers.CalcerDamagePoolBarrier" />
												</Item>
											</calcers>
										</mulCalcer>
										<additionalMultiplier>
											<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mul>0.001</mul>
												<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
													<stat type="gameMechanics.elements.stat.SpecialStat">
														<stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
													</stat>
													<valueType>ShortTerm</valueType>
												</mulCalcer>
												<sum>1</sum>
											</scaler>
										</additionalMultiplier>
									</scalerCaster>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactRetriveDamageFromPoolBarrier">
									<damage type="gameMechanics.elements.calcers.CalcerLongMulFloat">
										<calcerLong type="gameMechanics.elements.calcers.LongData">
											<value var="valueRetrive" />
										</calcerLong>
										<calcerFloat type="gameMechanics.constructor.basicElements.ScalerCalcer">
											<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
												<scalers>
													<Item type="gameMechanics.elements.scalers.HealScaler" />
													<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
														<mul>0.001</mul>
														<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
															<stat type="gameMechanics.elements.stat.SpecialStat">
																<stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
															</stat>
															<valueType>ShortTerm</valueType>
														</mulCalcer>
														<sum>1</sum>
													</Item>
												</scalers>
											</scaler>
											<value>1</value>
										</calcerFloat>
									</damage>
								</Item>
							</impactsIf>
						</Item>
					</casterImpacts>
					<destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
						<spells>
							<Item href="/Mechanics/Spells/War63/Spells/ShieldBash/Spell01.(SpellSingleTarget).xdb" />
						</spells>
					</destination>
				</Item>
			</effectsOn>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
