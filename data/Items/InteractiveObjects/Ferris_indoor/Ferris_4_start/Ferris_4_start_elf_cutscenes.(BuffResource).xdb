                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/World/Quests/Ferris4/Ferris_4_start/HideFromCutscenePlane.(BuffResource).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/World/Quests/Ferris4/Ferris_4_start/Ferris_4_start.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                    <impacts>
