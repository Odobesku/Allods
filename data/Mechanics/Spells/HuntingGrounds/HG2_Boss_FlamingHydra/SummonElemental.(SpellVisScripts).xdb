<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <AnimationPreCastMode>LOOP</AnimationPreCastMode>
            <FixPointCaster>false</FixPointCaster>
            <FixPointTarget>true</FixPointTarget>
            <LocatorNameOnCaster />
            <LocatorNameOnTargets />
            <LocatorOnCaster>Slot_Global</LocatorOnCaster>
            <PreCastAnimation>specialCast</PreCastAnimation>
            <LocatorOnTargets>Slot_FX</LocatorOnTargets>
            <FXOnCaster />
            <HitPostFXOnTargets />
            <FxOnHands />
            <CastAnimation>spellCastDirected</CastAnimation>
            <FXOnTargets />
        </Variables>
    </Header>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/DC_2BossMindflayer_ReadySpellDirectDown_Fire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                        <scale>4</scale>
                        <fadeInTime>200</fadeInTime>
                        <fadeOutTime>400</fadeOutTime>
                        <locator>Slot_Global</locator>
                    </Item>
                    <Item skiped="" />
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>specialCast</Item>
                </animations>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>