<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.IfAction">
        <condition type="client.SLON.IfCreatureVisCharacter">
          <visCharList>
            <Item href="/Creatures/DemonWarrior/DemonWarrior.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
          </visCharList>
          <checkIsInTheList>true</checkIsInTheList>
          <checkOnStartOnly>true</checkOnStartOnly>
        </condition>
        <onBreak>
          <breakEnabled>false</breakEnabled>
        </onBreak>
        <thenAction type="client.Replica.VisActionList">
          <elements>
            <Item type="client.SLON.CreatureRenameAction">
              <name href="/World/Quests/HuntingGround3/AO11_Prologue06_2/AO11_Prologue06_2_Corrupted.(BuffVisScripts).Name.txt" />
            </Item>
            <Item type="client.Replica.VisActionChangeVisObject">
              <newVisMob href="/Creatures/DemonWarrior/DemonWarriorDark.(VisualMob).xdb#xpointer(/client.VisualConstructor.VisualMob)" />
              <getBody>true</getBody>
              <getDress>true</getDress>
            </Item>
          </elements>
          <play>Simultaneously</play>
          <preconditional>false</preconditional>
          <restartOnVisualChange>false</restartOnVisualChange>
          <stopOnDeath>false</stopOnDeath>
          <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
        </thenAction>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>