<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <preconditional>true</preconditional>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>battleRoar</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/Undead_Battle_Roar.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.75</scale>
                        <locator>Slot_Global</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>