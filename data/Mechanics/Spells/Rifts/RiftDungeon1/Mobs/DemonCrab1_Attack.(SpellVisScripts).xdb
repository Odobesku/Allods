<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<use>USE_CURRENT_ATTACK</use>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/NecromancerCorrosiveAcid_Projectile.(VisObjectTemplate).xdb" />
				<explosionFx href="/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb" />
				<theGe>6</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Head</locator>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</pointOnTarget>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
