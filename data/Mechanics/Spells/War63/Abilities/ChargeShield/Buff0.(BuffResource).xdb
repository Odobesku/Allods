<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739922058</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Buff0.(BuffResource).Name.txt" />
	<Description href="Buff0.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Warrior/WarriorCharge.(UISingleTexture).xdb" />
	<interfaceHighPriority>true</interfaceHighPriority>
	<effects>
		<Item type="gameMechanics.elements.effects.DamageAbsorber">
			<elements>
				<Item>PHYSICAL</Item>
				<Item>FIRE</Item>
				<Item>COLD</Item>
				<Item>LIGHTNING</Item>
				<Item>HOLY</Item>
				<Item>SHADOW</Item>
				<Item>ASTRAL</Item>
				<Item>POISON</Item>
				<Item>DISEASE</Item>
				<Item>ACID</Item>
			</elements>
			<absorb>1</absorb>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
							<summands>
								<Item type="gameMechanics.constructor.basicElements.ScalerCalcer">
									<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mul>0.0001</mul>
										<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
											<stat type="gameMechanics.elements.stat.SpecialStat">
												<stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
											</stat>
											<valueType>ShortTerm</valueType>
										</mulCalcer>
									</scaler>
									<value>1</value>
								</Item>
								<Item type="constructor.elements.CalcerFloatExternal">
									<externalCalcer hrefvar="externalCalcer" />
								</Item>
							</summands>
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
					</Item>
				</scalers>
			</scaler>
		</Item>
	</effects>
	<duration>4000</duration>
	<isHelpful>true</isHelpful>
	<ranks>
		<Item href="Buff01.(BuffResource).xdb" />
		<Item href="Buff02.(BuffResource).xdb" />
		<Item href="Buff03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>