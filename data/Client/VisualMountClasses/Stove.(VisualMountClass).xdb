            <Item>
                <animation>idle</animation>
                <playOnMount>idle</playOnMount>
                <playOnRiderBottom>mountStoveIdle</playOnRiderBottom>
                <playOnRiderTop>mountStoveIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>idle01</animation>
                <playOnMount>idle01</playOnMount>
                <playOnRiderBottom>mountStoveIdle</playOnRiderBottom>
                <playOnRiderTop>mountStoveIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>idle02</animation>
                <playOnMount>idle02</playOnMount>
                <playOnRiderBottom>mountStoveIdle</playOnRiderBottom>
                <playOnRiderTop>mountStoveIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>idleSwim</animation>
                <playOnMount>idle</playOnMount>
                <playOnRiderBottom>mountStoveIdle</playOnRiderBottom>
                <playOnRiderTop>mountStoveIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>jump</animation>
                <playOnMount>jump</playOnMount>
                <playOnRiderBottom>mountStoveRun</playOnRiderBottom>
                <playOnRiderTop>mountStoveRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>jumpEnd</animation>
                <playOnMount>jumpEnd</playOnMount>
                <playOnRiderBottom>mountStoveJumpEnd</playOnRiderBottom>
                <playOnRiderTop>mountStoveJumpEnd</playOnRiderTop>
            </Item>
            <Item>
                <animation>jumpLandRun</animation>
                <playOnMount>jumpLandRun</playOnMount>
                <playOnRiderBottom>mountStoveJumpEnd</playOnRiderBottom>
                <playOnRiderTop>mountStoveJumpEnd</playOnRiderTop>
            </Item>
            <Item>
                <animation>jumpStart</animation>
                <playOnMount>jumpStart</playOnMount>
                <playOnRiderBottom>mountStoveJumpStart</playOnRiderBottom>
                <playOnRiderTop>mountStoveJumpStart</playOnRiderTop>
            </Item>
            <Item>
                <animation>levelUp</animation>
