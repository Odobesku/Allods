	</Header>
	<element>ASTRAL</element>
	<Name href="Ice_Destruction.(SpellArea).Name.txt" />
	<visualScripts href="Ice_Destruction_Vis.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>6000</prepareDuration>
	<targetType>STTSelf</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>30000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
				<mobs>
					<Item href="Ice_Queen.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
				</mobs>
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
				<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
