<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>208903</resourceId>
    </Header>
    <Name href="RD2_Boss02_cleave.(SpellArea).Name.txt" />
    <visualScripts href="RD2_Boss02_cleave.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>8000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/Rifts/RiftDungeon2/Mobs/StopBuff.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
                        <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageBoss.(CalcerFloatResource).xdb" />
                            </mulCalcer>
                        </Item>
                    </scalers>
                </scaler>
                <minDamage>1</minDamage>
                <maxDamage>1</maxDamage>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.RectangularRay">
        <width>2</width>
    </shape>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>7</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>