        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>varAspect</name>
            <value var="buff_duration" />
            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                <multiplier>3</multiplier>
            </scaler>
        </Item>
        <Item>
            <name>var0</name>
            <value var="buff_duration" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Quest/PhantomEssence.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectOnDamageDoneTrigger">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                        <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.offender.PredicateActionGroup">
                                <groups>
                                    <Item href="/Mechanics/Spells/Groups/HealDamage.(ActionGroup).xdb" />
                                </groups>
                            </predicate>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateIsCrit" />
                    </predicates>
                    <impactsOnDamageDone>
                        <Item type="gameMechanics.constructor.basicElements.ImpactNull" />
                    </impactsOnDamageDone>
                    <impactsToVictim>
                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Vulnerability/Vulnerability.(BuffResource).xdb" />
                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier var="buff_duration" />
                                                    </durationScaler>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsToVictim>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectOnHealDoneTrigger">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                        <Item type="gameMechanics.elements.predicates.offender.PredicateIsCrit" />
                    </predicates>
                    <impactsOnHealDone>
                        <Item type="gameMechanics.constructor.basicElements.ImpactNull" />
                    </impactsOnHealDone>
                    <impactsToVictim>
                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Defence/Defence.(BuffResource).xdb" />
                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier var="buff_duration" />
                                                    </durationScaler>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsToVictim>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>