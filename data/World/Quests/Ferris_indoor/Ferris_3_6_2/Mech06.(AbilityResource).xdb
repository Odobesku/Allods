<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>309439</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Mech06.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="Mech07.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Mech07.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <spawnResource href="/Maps/Ferris_indoor/SpawnTables/Mechs_3_6_2.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="/Maps/Ferris_indoor/SpawnTables/Ferris_3_6_2_plaform_06.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateDevice">
                                    <deviceResources>
                                        <Item href="/Items/InteractiveObjects/Ferris/Ferris03/Rainbow_lamps/Lamp06.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
                                    </deviceResources>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                                    <visualState>2</visualState>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <spawnResource href="/Maps/Ferris_indoor/SpawnTables/Ferris_3_6_2_lamps.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>