                        </predicates>
                    </Item>
                </predicates>
            </predicates>
        </Item>
    </conditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactsToInterlocutor">
            <impacts>
                <Item type="itemService.avatar.stronghold.production.elements.ImpactStopProduction" />
