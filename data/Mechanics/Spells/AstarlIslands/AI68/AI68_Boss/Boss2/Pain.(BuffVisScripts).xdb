<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/BloodFeast_HM.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_Global</locator>
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/OpFirework_TargetSkull.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_TopFX</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <playWhile type="VisActionDelay">
                    <time>250</time>
                </playWhile>
                <elements>
                    <Item type="ProceduralEffectVisAction">
                        <timeOff>0.4</timeOff>
                        <timeOn>0.05</timeOn>
                        <proceduralEffect href="/Spells/FX/InterfaceFX/Blood.(ProceduralEffect).xdb#xpointer(/ProceduralEffect)" />
                    </Item>
                </elements>
            </Item>
        </elements>
    </action>
</BuffVisScripts>