<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739931108</resourceId>
    </Header>
    <Name href="Assaul_boat_tour.(BuffResource).Name.txt" />
    <Description href="Assaul_boat_tour.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/JetPackGoblinBall.(UISingleTexture).xdb" />
    <visScript href="Assaut_tour.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectMoveByTour">
            <route href="/Maps/Inst_ZoneContested12_Start/GlobalObjects/Tours/Assault_boat.(Tour).xdb" />
            <impactsOnArrive>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Assaul_boat_tour.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Maps/Inst_ZoneContested12_Start/CutScene/CS_Sand_storm_watched.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>ZC12_Coast_start</scriptID>
                                    <map href="/Maps/ZC12/MapResource.xdb" />
                                </locator>
                            </destination>
                            <finishImpacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                    <id href="Counter3.(QuestCountId).xdb" />
                                </Item>
                            </finishImpacts>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Maps/Inst_ZoneContested12_Start/GlobalObjects/GameViewScenes/GameScenes/CS_Sand_Storm.(BuffResource).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOnArrive>
            <impactsOnCancel>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>WW_1_1_start</scriptID>
                            <map href="/Maps/Inst_ZoneContested12_Start/Astral_MapResource.(MapResource).xdb" />
                        </locator>
                    </destination>
                </Item>
            </impactsOnCancel>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>