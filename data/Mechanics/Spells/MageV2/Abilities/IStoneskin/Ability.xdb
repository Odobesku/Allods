<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>217837</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Special/Talents/Mage/IStoneskin.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Ability_Name.txt.template" />
    <descTemplate href="Ability_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateGreater">
                    <lhs type="gameMechanics.elements.calcers.FloatData">
                        <value>42</value>
                    </lhs>
                    <rhs type="gameMechanics.elements.calcers.FloatData">
                        <value>42</value>
                    </rhs>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.ScalerOutputDamageChannel">
                    <element>PHYSICAL</element>
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff var="coeff" />
                    </scaler>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatResistance">
                <element>EPHYSICAL</element>
            </stat>
            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                <multiplier var="multiplier" />
            </scaler>
        </Item>
    </effects>
    <majorEffect>-1</majorEffect>
    <level>1</level>
    <ranks>
        <Item href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability02.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability03.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
    <disableWhileDead>false</disableWhileDead>
    <saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>