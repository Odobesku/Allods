<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739905551</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <source>FixedDrop</source>
    <showItemContextAction>Never</showItemContextAction>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                        <currency hrefvar="currency" />
                    </Item>
                </actions>
                <consumeItems>1</consumeItems>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                <lhs type="itemService.serverVariables.CalcerServerVariable">
                    <variableResource href="/Mechanics/ServerUnlock/ServerUnlock.(ServerVariableResource).xdb" />
                </lhs>
                <rhs type="gameMechanics.elements.calcers.LongData">
                    <value var="serverVar" />
                </rhs>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>63</value>
                </minLevel>
            </Item>
        </predicates>
        <useStack>true</useStack>
    </functionalPart>
    <level>65</level>
    <requiredLevel>63</requiredLevel>
    <stackLimit>1000</stackLimit>
    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <interactions />
    <binding>BindOnPickup</binding>
    <name href="Badge.(ItemResource).Name.txt" />
    <description href="Badge.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/Misc/Other.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>