<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739922360</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/AmmoSpells.(ActionGroup).xdb" />
    </groups>
    <element>COLD</element>
    <Name href="SpellSelf.(SpellSingleTarget).Name.txt" />
    <Description href="SpellSelf.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer href="CalcerDamage.(CalcerFloatResource).xdb" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>MagicScaler</formula>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>0.1</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                            <dressSlot>AMMO</dressSlot>
                        </mulCalcer>
                        <sum>1</sum>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Mage/Armageddon.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mage/Armageddon.(SpellVisScripts).xdb" />
    <prepareDuration var="prepareDuration" />
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>300000</duration>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateEquipped">
                        <dressType>AMMO</dressType>
                        <itemClass href="/Mechanics/ItemClasses/Other_InfiniteTeardrop.(ItemClass).xdb" />
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.elements.resources.ResourceVariable">
                    <hideText>true</hideText>
                    <variable href="/Mechanics/Spells/Mage63/Abilities/ElementalPower/IceVar.(VariableResource).xdb" />
                    <sub>0</sub>
                </resourceIf>
                <resourceElse type="gameMechanics.elements.resources.ResourceDressItem">
                    <slot>AMMO</slot>
                    <count>5</count>
                </resourceElse>
            </Item>
        </casterResources>
        <channelingMechanics>
            <channelingBuff hrefvar="channelingBuff" />
            <prepareDuration>3000</prepareDuration>
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.Switch">
                <impactsOff>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="Damage01.(BuffResource).xdb" />
                    </Item>
                </impactsOff>
            </Item>
        </casterChannelingEffects>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>