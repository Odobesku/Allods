<?xml version="1.0" encoding="UTF-8"?>
<VisObjectTemplate>
	<defaultState>
		<sound>
			<creationRadius>-1</creationRadius>
		</sound>
		<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
		<playSoundOnKeys>true</playSoundOnKeys>
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>500</fadeInMS>
	<fadeOutMS>500</fadeOutMS>
	<replaceDistance>-1</replaceDistance>
	<scale>1</scale>
	<sound>
		<creationRadius>-1</creationRadius>
	</sound>
	<visObjComponents>
		<Item type="client.Scene.LightComponent">
			<attenuationPower>0</attenuationPower>
			<direction x="0" y="0" z="0" />
			<facingValue>-1</facingValue>
			<intensity>-1</intensity>
			<intensityRandom>0</intensityRandom>
			<pivot x="0" y="0" z="0" />
			<radius>10</radius>
		</Item>
	</visObjComponents>
	<drawBehindCamera>false</drawBehindCamera>
	<softReplace>false</softReplace>
</VisObjectTemplate>