<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>194632</resourceId>
    </Header>
    <Name href="GolemAI20Boss_Artillery.(SpellArea).Name.txt" />
    <visualScripts href="/Mechanics/Spells/AstarlIslands/AI20/GolemAI20BossNapalm/NapalmVis.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>6000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="GolemAI20Boss_BombBuffSelf.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                        <level>0.6</level>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>60</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                <projectileData>
                                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                    <resource href="GolemAI20Boss_Artillery1.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                </projectileData>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </predicates>
                                </Item>
                            </predicates>
                        </filter>
                        <targetsLimit>2</targetsLimit>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                                <level>0.3</level>
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                                <level>0.6</level>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>60</radius>
                                <affectGroup>Enemies</affectGroup>
                                <affectHolder>false</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                        <projectileData>
                                            <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                            <resource href="GolemAI20Boss_Artillery1.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                        </projectileData>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </predicates>
                                </filter>
                                <targetsLimit>3</targetsLimit>
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                                        <level>0.3</level>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                        <radius>60</radius>
                                        <affectGroup>Enemies</affectGroup>
                                        <affectHolder>false</affectHolder>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                <projectileData>
                                                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                                    <resource href="GolemAI20Boss_Artillery1.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                                </projectileData>
                                            </Item>
                                        </impacts>
                                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                            <predicates>
                                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                            <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                        </Item>
                                                    </predicates>
                                                </Item>
                                            </predicates>
                                        </filter>
                                        <targetsLimit>4</targetsLimit>
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impactsElse>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>4</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>