<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739851172</resourceId>
    </Header>
    <name href="Controllable.(AbilityResource).Name.txt" />
    <description href="Controllable.(AbilityResource).Description.txt" />
    <nameTemplate href="Controllable.(AbilityResource).Name.txt" />
    <descTemplate href="Controllable.(AbilityResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Controllable.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Controllable.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffInterceptor">
            <durationScalerTarget type="gameMechanics.elements.scalers.LinearScaler">
                <multiplier>1.5</multiplier>
            </durationScalerTarget>
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                    </groups>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.SummandStat">
            <stat type="gameMechanics.elements.stat.InnateStat">
                <stat>Will</stat>
            </stat>
            <value>-40</value>
            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                <multiplier>10</multiplier>
            </scaler>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>