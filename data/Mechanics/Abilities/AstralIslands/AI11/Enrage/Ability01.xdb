<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>162674705</resourceId>
    </Header>
    <name href="Ability01name.txt" />
    <nameTemplate href="Ability01name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.2</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactMobChat">
                    <msg href="Message01.(TextMessage).xdb#xpointer(/gameMechanics.world.TextMessage)" />
                    <defaultSpeaker href="/Characters/Undead_male/Instances/AstralIsle11/UndeadCultistBoss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>3000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <affectGroup>Friends</affectGroup>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                    <mobs>
                                                        <Item href="/Characters/Undead_male/Instances/AstralIsle11/AstralUndeadCultistAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                    </mobs>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>Portal</scriptID>
                        <map href="/Maps/AstralIsle11/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </device>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.RandomImpact">
                                    <entries>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
