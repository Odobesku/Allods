<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>259892284</resourceId>
    </Header>
    <Name href="SpellName.txt" />
