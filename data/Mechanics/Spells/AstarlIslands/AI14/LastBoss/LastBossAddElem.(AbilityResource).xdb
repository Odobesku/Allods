<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739877351</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<affectGroup>Enemies</affectGroup>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="AddTargeter.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
						</Item>
					</impacts>
					<autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.ClosestAutotarget">
						<group>Enemies</group>
					</autotarget>
				</Item>
			</onEnter>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="AddFire.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					<stacks type="gameMechanics.elements.calcers.FloatData">
						<value>15</value>
					</stacks>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectUnworthyOfAttention" />
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
					<projectileData>
						<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
						<resource href="AI14_Cleave.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
					</projectileData>
					<pool href="SP.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
