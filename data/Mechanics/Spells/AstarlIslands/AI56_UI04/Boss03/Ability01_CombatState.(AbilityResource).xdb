				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="/Mechanics/Spells/AstarlIslands/AI56_UI04/Boss04/SummonPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
