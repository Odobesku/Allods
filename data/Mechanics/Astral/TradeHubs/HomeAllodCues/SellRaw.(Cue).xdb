    <name href="SellRaw.txt" />
    <text href="SellRaw.Text.txt" />
    <data>
        <Item type="CueDataMoney">
            <alias>Price</alias>
            <calcer type="gameMechanics.elements.calcers.CalcerLongMulFloat">
                <calcerLong type="constructor.elements.CalcerLongExternal">
