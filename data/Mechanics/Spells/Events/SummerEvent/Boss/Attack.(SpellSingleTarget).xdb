        <Item href="/Mechanics/Spells/Groups/Events/EventSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="Attack.(SpellSingleTarget).Name.txt" />
