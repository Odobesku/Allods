				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.SpellExtraImpacts">
					<casterPreImpacts>
						<Item type="gameMechanics.world.avatar.assistants.ImpactsToAllAssistants">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
											<mobs>
												<Item href="/Mechanics/Spells/Psionic63/Spells/Projection/Projection01.(MobWorld).xdb" />
												<Item href="/Mechanics/Spells/Psionic63/Spells/Projection/Projection02.(MobWorld).xdb" />
												<Item href="/Mechanics/Spells/Psionic63/Spells/Projection/Projection03.(MobWorld).xdb" />
											</mobs>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
											<radius>15</radius>
											<affectGroup>Enemies</affectGroup>
											<impacts>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
