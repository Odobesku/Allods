<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>517483</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Events/EventSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="DiagnosticSpell.(SpellSingleTarget).Name.txt" />
    <Description href="DiagnosticSpell.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>5</value>
    </range>
    <prepareDuration>3000</prepareDuration>
    <isAggro>false</isAggro>
    <isWorkOnDead>true</isWorkOnDead>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>300000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                    <rule href="/Mechanics/Rules/NoFunItems.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsDead" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="isDead.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="DiagnosticBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsElse>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>