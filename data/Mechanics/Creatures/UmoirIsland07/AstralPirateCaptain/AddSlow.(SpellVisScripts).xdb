<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect01Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="CreatureProjectileAction">
		<projectileFx href="/Spells/FX/Spells/StalkerFlourBagAbility_ProjectTail.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
		<explosionFx href="/Spells/FX/Spells/StalkerFlourBagAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	</launch>
</SpellVisScripts>
