<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739975888</resourceId>
    </Header>
    <visScript href="Fight01.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Fight02.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Cutscene2.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Jump</Item>
                <Item>Rotate</Item>
                <Item>Move</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Cutscene_01.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Cutscene2.(BuffResource).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>5000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>