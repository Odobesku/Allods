<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>readySpellOmni</PreCastAnimation>
			<CastAnimation>spellCastOmni</CastAnimation>
			<FixPointTarget>true</FixPointTarget>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="PreCastAnimation" />
				</animations>
				<advanced>
					<speed>1.33</speed>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>1000</delay>
						<effectFx href="/Spells/FX/Mobs/Gamayun_InFlight.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item skiped="" />
					<Item skiped="" />
					<Item>
						<delay>1500</delay>
						<effectFx href="/Spells/FX/Mobs/Gamayun_InFlight_Wings.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>1000</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>FeatherA1_L</locatorName>
					</Item>
					<Item>
						<delay>1400</delay>
						<effectFx href="/Spells/FX/Mobs/Gamayun_InFlight_Wings_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>1000</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>FeatherA1_R</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="" />
								<scale>1</scale>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Gamayun_InFlight_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<fadeOutTime>1000</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
