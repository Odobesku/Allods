<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.Sound2DAction">
    <actionType>Simple</actionType>
    <musicSourceMaxRadius>0</musicSourceMaxRadius>
    <reverbPreset />
    <sound>
      <name>/Music/AstralMusic/AstralBattle</name>
      <project href="/SFX/Music/Music.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
    </sound>
    <forcedSoundStop>false</forcedSoundStop>
    <onlyForMainAvatar>true</onlyForMainAvatar>
    <resetGlobalParamsOnStop>false</resetGlobalParamsOnStop>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>