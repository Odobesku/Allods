<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>317009</resourceId>
    </Header>
    <name href="Ilya_cue_02.(Cue).Name.txt" />
    <text href="Ilya_cue_02.(Cue).Text.txt" />
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
            <id href="Counter3.(QuestCountId).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
            <delay>1500</delay>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/Inst_ZoneContested12_Start/Zones/Inst_ZoneContested12_Start/Inst_ZoneContested12_Start.(ZoneResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                            <destination type="gameMechanics.map.destination.RelativePos" />
                            <assistantResource href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_4_E/Luka.(AssistantResource).xdb" />
                            <mobResource href="/Characters/Hadagan_male/Instances/ZC12/Ilya_assistant.(MobWorld).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsToInterlocutor">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>1500</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactStopTalk" />
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>