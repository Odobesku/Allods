    <image href="/Interface/Icons/Spells/ImmunityToControl.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Stacks.(BuffResource).xdb" />
                </Item>
            </impacts>
            <tick>4000</tick>
            <initialDelay>4000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMoveTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                                <groups>
                                    <Item href="/Mechanics/Spells/Groups/DRMesmerize.xdb" />
                                </groups>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Stacks.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <distDelta>0</distDelta>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Stacks.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>