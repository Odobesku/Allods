<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>195215</resourceId>
    </Header>
    <Name href="PaddockRed.(BuffResource).Name.txt" />
    <Description href="PaddockRed.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Crafting/LeatherHGUnicOffence.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Mechanics/Spells/Instances/InstNewTkaRika/Spells/DotCageShepherd.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                    <mobs>
                        <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Mobs/DemonDogRed.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    </mobs>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="CapturedTheRightDog.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsOn>
                </Item>
                <Item type="gameMechanics.elements.effects.PureDamageDoT">
                    <parameters>
                        <tickLength>1000</tickLength>
                        <damagePerTick>1</damagePerTick>
                    </parameters>
                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.1</multiplier>
                        </mulCalcer>
                    </scaler>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Mobs/DemonDogRed.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Mobs/DemonDogGreen.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Mobs/DemonDogBlue.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </mobs>
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.common.HealOverTime">
                            <healPerTick type="gameMechanics.elements.calcers.FloatData">
                                <value>1</value>
                            </healPerTick>
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier>0.08</multiplier>
                                </mulCalcer>
                            </scaler>
                            <tick>500</tick>
                            <considerOutgoingModifiers>false</considerOutgoingModifiers>
                        </Item>
                    </effectsIf>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>