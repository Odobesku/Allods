<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739936397</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="EtudeMoreDamage.(BuffResource).Name.txt" />
	<Description href="EtudeMoreDamage.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Bard/VampireChord.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.NotStackableEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
					<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
						<coeff>1</coeff>
						<calcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</calcer>
					</scaler>
					<group href="/Mechanics/Spells/Groups/BardEtude.(ActionGroup).xdb" />
				</Item>
				<Item type="gameMechanics.elements.effects.SpellCastTrigger">
					<conditionalImpacts>
						<Item>
							<impacts>
								<Item type="gameMechanics.elements.impacts.StackBuff">
									<buff href="EtudeMoreDamage01.(BuffResource).xdb" />
									<resetTimer>false</resetTimer>
									<delta type="gameMechanics.elements.calcers.FloatData">
										<value>-1</value>
									</delta>
								</Item>
							</impacts>
							<conditions>
								<Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
									<group href="/Mechanics/Spells/Groups/BardEtude.(ActionGroup).xdb" />
								</Item>
							</conditions>
						</Item>
					</conditionalImpacts>
					<stages>
						<Item>Launch</Item>
					</stages>
				</Item>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="/Mechanics/Spells/Bard63/Spells/Party/EtudeAoE01.(BuffResource).xdb" />
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
	</effects>
	<duration>30000</duration>
	<isHelpful>true</isHelpful>
	<ranks>
		<Item href="EtudeMoreDamage03.(BuffResource).xdb" />
		<Item href="EtudeMoreDamage02.(BuffResource).xdb" />
		<Item href="EtudeMoreDamage01.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<isForthright>true</isForthright>
</gameMechanics.constructor.schemes.buff.BuffResource>
