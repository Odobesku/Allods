<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>ready2H</Item>
        </animations>
        <channel>CHANNEL_TURNSPECIAL</channel>
    </actionBarStart>
    <wholeCasting type="VisActionList">
        <visActionID>weaponFX</visActionID>
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureTrailAction">
                <mainHandTrail href="/Spells/FX/InterfaceFX/TrailRedUpgrade.(TrailTemplate).xdb" />
                <lengthMSec>1000</lengthMSec>
            </Item>
            <Item type="CreatureEnchantWeaponAction">
                <enchant href="/Spells/FX/Weapon/PowerWeapon/Enchants/PowerHoly_R4.(EnchantTemplate).xdb" />
            </Item>
        </elements>
    </wholeCasting>
    <launch type="CreatureAnimationAction">
        <animations>
            <Item>specialAttack2H</Item>
        </animations>
        <channel>CHANNEL_TURNSPECIAL</channel>
        <advanced>
            <animationKeysAction>
                <Item>
                    <action type="CreatureEffectsOnTarget">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/HitMeleeHard.(VisObjectTemplate).xdb" />
                                <locator>Slot_FX</locator>
                                <offendTime type="EffectOffendConstDelay" />
                            </Item>
                        </visualEffects>
                    </action>
                </Item>
            </animationKeysAction>
        </advanced>
    </launch>
</SpellVisScripts>