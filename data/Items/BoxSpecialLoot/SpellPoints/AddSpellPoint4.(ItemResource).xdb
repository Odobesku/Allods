		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.GrantUnlockTakeAction">
						<unlock href="/Mechanics/Unlocks/AltCurrencies/IM_AddSpell_04_Unlock.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
					</Item>
				</actions>
				<consumeItems>1</consumeItems>
			</Item>
		</usages>
		<predicates>
			<Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
				<minLevel type="gameMechanics.formulas.IntConstantValue">
					<value>4</value>
				</minLevel>
			</Item>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
