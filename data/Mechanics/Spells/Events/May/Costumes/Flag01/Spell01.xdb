                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Events/May/Tag/Wanderlust.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
