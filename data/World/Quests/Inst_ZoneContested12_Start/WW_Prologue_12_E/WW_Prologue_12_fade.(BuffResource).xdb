<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739924433</resourceId>
    </Header>
    <visScript href="Fade_no_anima.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDoesNotAggro" />
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>3000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="Counter3.(QuestCountId).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_12_L/Counter3.(QuestCountId).xdb" />
                        </Item>
                        <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                            <assistantResource href="Seeress.(AssistantResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                            <assistantResource href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_4_E/Luka.(AssistantResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="Ship_Explosion_watched.(BuffResource).xdb" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                            <quest href="WW_Prologue_12_E.xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Maps/Inst_ZoneContested12_Start/CutScene/Ship_explosion_H.(BuffResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Maps/Inst_ZoneContested12_Start/CutScene/Ship_explosion_L.(BuffResource).xdb" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>WW_start_1</scriptID>
                                            <map href="/Maps/Inst_ZoneContested12_Start/AstralTrap_MapResource.(MapResource).xdb" />
                                        </locator>
                                    </destination>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>6000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>