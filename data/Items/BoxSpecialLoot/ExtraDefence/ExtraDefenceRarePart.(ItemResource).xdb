<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739870176</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Itemmall/IMPagePsalter_Part.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<source>Vendor</source>
	<showItemContextAction>Never</showItemContextAction>
	<forceShowQuality>true</forceShowQuality>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="ExtraDefenceRare.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
						</item>
						<binding>Transfer</binding>
					</Item>
				</actions>
				<consumeItems>100</consumeItems>
			</Item>
		</usages>
		<useStack>true</useStack>
	</functionalPart>
	<stackLimit>1000</stackLimit>
	<quality href="/Mechanics/ItemQualities/Rare.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
	<prices type="gameMechanics.constructor.schemes.item.prices.AuctionItem">
		<cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
			<money>2</money>
		</cost>
	</prices>
	<itemMallType>ITEMMALLABLE</itemMallType>
	<name href="ExtraDefenceRarePart.(ItemResource).Name.txt" />
	<description href="ExtraDefenceRarePart.(ItemResource).Description.txt" />
	<category href="/Mechanics/ItemCategories/ItemMall.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
</gameMechanics.constructor.schemes.item.ItemResource>
