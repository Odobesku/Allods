<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>walk</Item>
				</animations>
				<advanced>
					<speed>3</speed>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureHangInAirAction">
				<hangHeight>5</hangHeight>
				<verticalSpeed>8</verticalSpeed>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureEffectsOnTarget">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/AOEAura_Electric_R10.(VisObjectTemplate).xdb" />
										<effectAlias href="" />
										<locator>Slot_Global</locator>
										<offendTime />
									</Item>
								</visualEffects>
							</Item>
							<Item type="CreatureEffectsOnTarget">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Mobs/CannonArchitect_Target.(VisObjectTemplate).xdb" />
										<locator>Slot_TopFX</locator>
										<offset z="0.6" />
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>4000</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/CannonArchitect_RaedySpell.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>1.33</scale>
								<fadeInTime>400</fadeInTime>
								<fadeOutTime>500</fadeOutTime>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Slot_Special01</locatorName>
								<offendTime />
								<offset y="-1.5" z="0.1" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction" />
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>attack</Item>
						</animations>
						<advanced>
							<offendType>ONEOFFEND_ONETARGET</offendType>
						</advanced>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Mobs/PortalBoss_PanelBeam_CastSpellBomb.(VisObjectTemplate).xdb" />
								<explosionFx href="/Spells/FX/Mobs/PortalBoss_CastSpellWings_Aoe02.(VisObjectTemplate).xdb" />
								<theGe>15</theGe>
								<pointOnCaster type="VisPointLocator">
									<shift y="-0.5" z="0.1" />
									<locator>FROM_LOCATOR_NAME</locator>
									<locatorName>Slot_Special01</locatorName>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator>Slot_Global</locator>
								</pointOnTarget>
							</Item>
						</elements>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/CannonArchitect_RaedySpell_Out.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>0.6</scale>
								<fadeInTime>30</fadeInTime>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Slot_Special01</locatorName>
								<offendTime />
								<offset y="-1.5" z="0.1" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
