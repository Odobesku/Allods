<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>245912</resourceId>
    </Header>
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Mobs/TripodPortal_TransformingRay_Target.(VisObjectTemplate).xdb" />
            <scale>1.2</scale>
            <fadeInTime>500</fadeInTime>
            <locator>Slot_Global</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="KrigEnrage.(BuffResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectAddContextActionsGeneric">
                    <actions>
                        <Item href="KrigContextAction.(SpellSingleTarget).xdb" />
                    </actions>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                                    <spawn>
                                        <scriptID>Unn_10_9</scriptID>
                                        <map href="/Maps/ZC12_Map02/MapResource.xdb" />
                                    </spawn>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                            <data href="UnnAdvice1.(ClientData).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                            <spell href="KrigContextAction.(SpellSingleTarget).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effectsIf>
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>