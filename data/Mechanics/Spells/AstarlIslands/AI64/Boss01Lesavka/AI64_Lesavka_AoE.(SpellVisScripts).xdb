<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/ProjectileAOE.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<LocatorNameOnTargets />
			<FixPointTarget>true</FixPointTarget>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<FXOnTargets />
			<FXPocket />
			<HitPostFXOnTargets>/Spells/VisScripts/HitPostFxOnTarget/HitFireShader.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</HitPostFXOnTargets>
			<FXProjectile>/Spells/FX/Spells/MageFireballAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<CastAnimation>spellCastDirected</CastAnimation>
			<LocatorNameOnCaster />
			<FXOnCaster />
			<FXProjectileHit>/Spells/FX/Spells/HitFireball2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<FixPointCaster>false</FixPointCaster>
			<LocatorOnCaster>Slot_Hand_R</LocatorOnCaster>
			<Ge>6</Ge>
			<MulyProjectile>false</MulyProjectile>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Mouth</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
