<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>stun</Item>
                </animations>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>3000</time>
                    </Item>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/MageTeleportAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>4000</time>
                    </Item>
                    <Item type="PostEffectVisAction">
                        <userPostEffect href="/Spells/FX/InterfaceFX/Black_Long.(UserPostEffect).xdb#xpointer(/UserPostEffect)" />
                    </Item>
                </elements>
            </Item>
        </elements>
    </action>
</BuffVisScripts>