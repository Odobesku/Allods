<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739846523</resourceId>
    </Header>
    <Name href="Leader.(BuffResource).Name.txt" />
    <Description href="Leader.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffLeader01.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/AstralVirusBuff.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <scale>0.25</scale>
            <locator>Slot_TopFX</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                    <quality href="/Mechanics/MobQualities/BossAdd.xdb#xpointer(/gameMechanics.world.mob.MobQuality)" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>-0.5</coeff>
                    </scaler>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>-0.25</coeff>
                    </scaler>
                </Item>
            </effectsElse>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="IsThereALeaderOnMap.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <summand>-1</summand>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                    <variable href="/Mechanics/InstanceModifiers/CrossModifiers/ChosenOne.(VariableResource).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
                    <summand>-1</summand>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.constructor.basicElements.FloatZero" />
            <impactsOn>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="IsThereALeaderOnMap.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <summand>-1</summand>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.1</factor>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>