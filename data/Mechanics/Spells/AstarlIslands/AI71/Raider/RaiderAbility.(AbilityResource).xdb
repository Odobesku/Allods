                            <spell href="/Mechanics/Spells/AutoAttack/MeleeDamage.xdb" />
                            <duration>
                                <second>3</second>
                            </duration>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="PierceArmor.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>