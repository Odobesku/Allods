<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastOmni</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
						</advanced>
					</Item>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile />
						<elements>
							<Item type="CreatureEffectsOnTarget">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/Engineer_DoubleDamage_Main.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<locator>Slot_FX</locator>
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
				<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>idleEngineer</Item>
						</animations>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
						</advanced>
					</Item>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureEffectsOnTarget">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/Engineer_DoubleDamage_Main.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<locator>Slot_FX</locator>
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
