<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>215962</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="Drone.(SpellArea).Name.txt" />
    <Description href="Drone.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value var="radius" />
        </Item>
        <Item>
            <name>time</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer hrefvar="externalCalcer" />
                </mulCalcer>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Engineer/Drone.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Engineer/Turret.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <targetType>STTPoint</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Drone01.(SpellArea).xdb" />
        <Item href="Drone02.(SpellArea).xdb" />
        <Item href="Drone03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Everyone</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHasPath">
                <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                <maxLength>85</maxLength>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeDestination">
                        <from type="gameMechanics.map.destination.SelfPosDestination" />
                        <to type="gameMechanics.map.destination.RelativeTrailPos">
                            <center type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                        </to>
                    </moveType>
                    <resource hrefvar="resource" />
                </projectileData>
            </Item>
        </casterImpacts>
    </mechanics>
    <radius var="radius" />
</gameMechanics.constructor.schemes.spell.area.SpellArea>