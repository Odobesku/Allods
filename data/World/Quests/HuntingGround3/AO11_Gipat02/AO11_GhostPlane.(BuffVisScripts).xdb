<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.PostEffectVisAction">
        <userPostEffect href="/Spells/FX/InterfaceFX/Otherworld.(UserPostEffect).xdb#xpointer(/client.VisualConstructor.UserPostEffect)" />
      </Item>
      <Item type="client.Replica.CreatureSetTransparencyAction">
        <fadeMult>1</fadeMult>
        <priority>1</priority>
        <transparency>0.599999964</transparency>
      </Item>
      <Item type="client.SLON.WeatherCreatureVisAction">
        <params>
          <ambientSoundImpact>Nothing</ambientSoundImpact>
          <areaEffect href="/Maps/AstralIsle48/ZoneLights/AI48_Ghost.(AreaEffect).xdb#xpointer(/client.VisualConstructor.AreaEffect)" />
          <colorGradingSettings />
          <fadeTime>1</fadeTime>
          <light>
            <AmbientColor>-14602199</AmbientColor>
            <AmbientFactor>0.5</AmbientFactor>
            <ContourColor>-13145743</ContourColor>
            <DiffuseColor>-16554380</DiffuseColor>
            <FadeEnd>100</FadeEnd>
            <FadeStart>90</FadeStart>
            <FogColor>-15854540</FogColor>
            <FogEnd>100</FogEnd>
            <FogStart>50</FogStart>
            <GrassContourColorMultiplier>-1</GrassContourColorMultiplier>
            <PointLightColor>-7438769</PointLightColor>
            <SelfIllumColor>-14927565</SelfIllumColor>
            <SpecularColor>-16575193</SpecularColor>
            <SpecularWaterColor>0</SpecularWaterColor>
            <SunLightPitch>0</SunLightPitch>
            <SunLightYaw>70</SunLightYaw>
            <TerrainContourColor>-16446452</TerrainContourColor>
            <TerrainContourPower>4</TerrainContourPower>
            <TerrainSpecularColor>-13531759</TerrainSpecularColor>
            <WaterGradientEnd>-1</WaterGradientEnd>
            <WaterGradientStart>-1</WaterGradientStart>
            <desaturation>0.399999976</desaturation>
            <minAmbientOcclusionValue>0</minAmbientOcclusionValue>
            <objectsLightmapBias>0.0125</objectsLightmapBias>
            <terrainLightmapBias>0.01</terrainLightmapBias>
          </light>
          <posteffectFogSettings>
            <brightness>1</brightness>
            <color>-1</color>
            <colorUp>-1</colorUp>
            <densityDown>0</densityDown>
            <densityUp>0</densityUp>
            <distanceSettings>
              <falloff>0.5</falloff>
              <maxDistance>400</maxDistance>
              <minDistance>0</minDistance>
            </distanceSettings>
            <heightSettingsDown>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsDown>
            <heightSettingsUp>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsUp>
            <sunSettings>
              <brightness>0.2</brightness>
            </sunSettings>
            <use>false</use>
          </posteffectFogSettings>
          <priority>HIGH</priority>
          <skyMesh href="/World/Sky/AI48_Ghost.(SkyMesh).xdb#xpointer(/client.VisualConstructor.SkyMesh)" />
          <hasLight>false</hasLight>
          <playInBuildings>false</playInBuildings>
        </params>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
