<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/DotPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_BodyFX</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/OpTarget_Skull_Poison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.2</scale>
						<locator>Slot_FX</locator>
					</Item>
					<Item>
						<effectFx href="Boss04_PoisoningDecal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureRunVisActionResource">
				<resource href="/Spells/VisScripts/HitPostFxOnTarget/HitPoisonShader.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
			</Item>
		</elements>
	</action>
	<postAction type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/ThrowBottlePoison_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fixPoint>true</fixPoint>
				<locator>Slot_Global</locator>
			</Item>
		</visualEffects>
	</postAction>
</BuffVisScripts>
