<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221461</resourceId>
    </Header>
    <Name href="Knockdown.(BuffResource).Name.txt" />
    <Description href="Knockdown.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Stun.(UISingleTexture).xdb" />
    <visScript href="/Mechanics/Spells/CommonBuffs/KnockDown/KnockDown.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <tick>1000</tick>
                    <affectGroup>All</affectGroup>
                    <radius>5</radius>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ContextAction.(BuffResource).xdb" />
                        </Item>
                    </impactsOut>
                </Item>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>4.5</radius>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ContextAction.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="ContextAction.(BuffResource).xdb" />
                                        </predicate>
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="Knockdown.(BuffResource).xdb" />
                                        </predicate>
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                            <zone href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Nest1.(ScriptZone).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                    <value>100</value>
                                                </Item>
                                            </impacts>
                                            <spawnResource href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Chicks1.(SpawnTable).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                            <zone href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Nest2.(ScriptZone).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                    <value>100</value>
                                                </Item>
                                            </impacts>
                                            <spawnResource href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Chicks2.(SpawnTable).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                            <zone href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Nest3.(ScriptZone).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                    <value>100</value>
                                                </Item>
                                            </impacts>
                                            <spawnResource href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Chicks3.(SpawnTable).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                            <tick>1000</tick>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Chicken/ChicksPlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Chicken/ChicksPlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Chicken/ChicksPlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Chicken/ChicksPlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>