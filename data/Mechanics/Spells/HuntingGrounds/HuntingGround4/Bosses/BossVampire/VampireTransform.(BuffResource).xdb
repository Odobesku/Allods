<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739870902</resourceId>
	</Header>
	<Name href="VampireTransform.(BuffResource).Name.txt" />
	<Description href="VampireTransform.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Itemmall/Bat.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visScript href="VampireTransform.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
			<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.4</coeff>
			</effectScaler>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>4</radius>
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>SHADOW</element>
									<damage>15</damage>
									<impactsOnHitTarget>
										<Item type="gameMechanics.elements.impacts.ReturningImpact">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactHeal">
													<heal>30</heal>
													<scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
												</Item>
												<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
													<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
													<data href="VampireSelfheal.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
												</Item>
											</impacts>
										</Item>
									</impactsOnHitTarget>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>1000</tick>
			<initialDelay>2000</initialDelay>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
			</impactsOff>
		</Item>
	</effects>
	<duration>15000</duration>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
