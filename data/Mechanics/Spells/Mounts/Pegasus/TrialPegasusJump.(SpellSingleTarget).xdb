<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>204703</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/MountSpeedBoosts.(ActionGroup).xdb" />
    </groups>
    <Name href="TrialPegasusJump.(SpellSingleTarget).Name.txt" />
    <Description href="TrialPegasusJump.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Event/WingsReward.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mount/MountGryphon_Jump.(SpellVisScripts).xdb" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>180000</duration>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>-0.06666</mul>
                <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                    <group href="/Mechanics/Mounts/Groups/Pegasus6thGrade.(MountGroupResource).xdb" />
                </mulCalcer>
                <sum>1</sum>
            </scaler>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMounted" />
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAvatarJump">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.map.destination.RelativePos">
                        <faceSourcePos>false</faceSourcePos>
                    </destination>
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierRelativePolar">
                            <radius type="gameMechanics.elements.calcers.FloatData">
                                <value>60</value>
                            </radius>
                        </Item>
                        <Item type="gameMechanics.map.destination.modifier.ModifierIfCheckPath">
                            <pathChecker type="space.pathfinding.pathChecker.PathDeviationLimited">
                                <angle>1.57</angle>
                            </pathChecker>
                            <modifierElse type="gameMechanics.map.destination.modifier.ModifierTrailFrom" />
                        </Item>
                    </modifiers>
                </destination>
                <speed>30</speed>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>