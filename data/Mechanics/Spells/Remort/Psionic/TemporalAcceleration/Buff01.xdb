<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>218166</resourceId>
    </Header>
    <Name href="Buff_Name.txt" />
    <Description href="Buff_Desc.txt" />
    <image href="/Interface/Icons/Spells/Psionic/PsionicSuffocate.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/PsionicFascinateAbility_Debuff.(VisObjectTemplate).xdb" />
            <locator>Slot_Head</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.MagicDoT">
                <parameters>
                    <tickLength>1000</tickLength>
                    <damagePerTick>10</damagePerTick>
                    <impactsPerTick>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Slowness/Slowness.(BuffResource).xdb" />
                        </Item>
                    </impactsPerTick>
                    <affectedByDoubleAttack>true</affectedByDoubleAttack>
                </parameters>
                <element>ASTRAL</element>
                <scaler type="gameMechanics.elements.scalers.ScalerMax">
                    <scaler1 type="gameMechanics.constructor.basicElements.ScalerMultiple">
                        <scalers>
                            <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                            <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                        </scalers>
                    </scaler1>
                    <scaler2 type="gameMechanics.elements.scalers.MagicScaler" />
                </scaler>
            </effect>
            <ticksCount>5</ticksCount>
        </Item>
    </effects>
    <isStackable>true</isStackable>
    <isGradual>false</isGradual>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>