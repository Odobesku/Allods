<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>212478</resourceId>
    </Header>
    <Name href="Sea_Monster_Summon.(SpellSingleTarget).Name.txt" />
    <image href="/Interface/Icons/Misc/Mining/FishHead.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <needLos>false</needLos>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>60000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                <impact type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                        <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Sea_Monster_AddDeathChecker.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Sea_Monster_ChangeTargetChecker.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <stacks type="gameMechanics.elements.calcers.FloatData">
                                        <value>1</value>
                                    </stacks>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <impactsFromTarget>
                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Sea_Monster_AddAggro.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsFromTarget>
                    <object href="Sea_Monster_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    <pool href="Sea_Monster_Pool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    <isPersonalPool>true</isPersonalPool>
                </impact>
                <count type="gameMechanics.elements.calcers.FloatData">
                    <value>2</value>
                </count>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>