    <image href="/Interface/Icons/Mounts/MountMetamorph2.(UISingleTexture).xdb" />
    <sysUIScriptName>mount_metamorph</sysUIScriptName>
    <binding>Soul</binding>
    <unlockers>
        <Item type="itemService.avatar.mount.MountMechanicsMorphUnlocker">
            <grade>7</grade>
            <mechanics>
                <speed>1.66</speed>
                <speedDelta>0.01</speedDelta>
                <health>2.05</health>
                <healthDelta>0.03</healthDelta>
                <regen>0.2</regen>
                <prepareDuration>600</prepareDuration>
                <prepareDurationDelta>30</prepareDurationDelta>
            </mechanics>
            <effects>
                <Item type="gameMechanics.constructor.basicElements.EffectList">
                    <effectsResource href="/Mechanics/GameRoot/Mount/HidePetMountAbility.(EffectListResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/Mounts/AirMoto/Energize/EnergizeChek_Meta.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/Mounts/AirMoto/AirMetaSpells.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/Spells/Mounts/AirMoto/AirMetaSpells.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Mounts/AirMoto/StaticEnergy_Meta.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/Mounts/AirMoto/SpeedUp.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <durationScaler type="gameMechanics.elements.scalers.ScalerBuff">
                                                <buff href="/Mechanics/Spells/Mounts/AirMoto/StaticEnergy_Meta.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                <summand>0</summand>
                                            </durationScaler>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="/Mechanics/Spells/Mounts/AirMoto/StaticEnergy_Meta.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/Spells/Mounts/HideShield/Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/Spells/Mounts/AirMoto/Energize/EnergizeChek_Meta.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
