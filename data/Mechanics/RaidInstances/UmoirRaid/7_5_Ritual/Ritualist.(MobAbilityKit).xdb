<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.MobAbilityKit>
    <Header>
        <resourceId>739868393</resourceId>
    </Header>
    <spellEntries>
        <Item>
            <spell href="Ritualist/Attack.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort">
                    <avatarsFirst>true</avatarsFirst>
                </sortTargets>
                <targetConditionChecks>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>3000</min>
                <max>3000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="Ritualist/Firebreath.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
            <targetSelector>
                <destination type="gameMechanics.map.destination.DestinationIf">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Ritualist/FirebreathStartTop.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                    <destinationIf type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>75top</scriptID>
                            <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </locator>
                    </destinationIf>
                    <destinationElse type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>75bot</scriptID>
                            <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </locator>
                    </destinationElse>
                </destination>
            </targetSelector>
            <cooldowns>
                <min>20000</min>
                <max>20000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="Ritualist/Shadowbreath.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
            <targetSelector>
                <destination type="gameMechanics.map.destination.DestinationIf">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Ritualist/ShadowbreathLeft.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                    <destinationIf type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>75left</scriptID>
                            <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </locator>
                    </destinationIf>
                    <destinationElse type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>75right</scriptID>
                            <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </locator>
                    </destinationElse>
                </destination>
            </targetSelector>
            <cooldowns>
                <min>20000</min>
                <max>20000</max>
            </cooldowns>
        </Item>
    </spellEntries>
</gameMechanics.world.mob.MobAbilityKit>