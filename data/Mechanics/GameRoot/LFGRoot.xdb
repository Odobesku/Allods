    <impactsOnChangeRoles>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="avatarPopulation.service.impl.lookingForGroupImpl.elements.PredicateLFGRole">
                    <role>Tank</role>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/LFG/Buffs/PseudoBuffs/TankPseudoBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/LFG/Buffs/PseudoBuffs/TankPseudoBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsElse>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="avatarPopulation.service.impl.lookingForGroupImpl.elements.PredicateLFGRole">
                    <role>Healer</role>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/LFG/Buffs/PseudoBuffs/HealerPseudoBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/LFG/Buffs/PseudoBuffs/HealerPseudoBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsElse>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="avatarPopulation.service.impl.lookingForGroupImpl.elements.PredicateLFGRole">
                    <role>DamageDealer</role>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/LFG/Buffs/PseudoBuffs/DD_PseudoBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/LFG/Buffs/PseudoBuffs/DD_PseudoBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsElse>
        </Item>
    </impactsOnChangeRoles>
    <impactsOnEnterLFG>
        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
            <buff href="LFGQueue.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="LFG/LFGBuffs/MercsForFree_Queue2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        </Item>
        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                            <lhs type="avatarPopulation.service.impl.lookingForGroupImpl.elements.CalcerLFGJoinPremadeSize" />
                            <rhs type="gameMechanics.elements.calcers.LongData">
                                <value>1</value>
                            </rhs>
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="LFG/LFGBuffs/LFG_RandomBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="LFG/LFGBuffs/LFG_RandomBuff_timer.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
        </Item>
    </impactsOnEnterLFG>
    <impactsOnExitLFG>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="LFGQueue.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="LFG/LFGBuffs/LFG_RandomBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        </Item>
    </impactsOnExitLFG>
