<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>246193</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <radius>85</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="/Maps/UmoirIsland07/SpawnTables/UI07_ForestCompanion_InPortal.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impacts>
                                            <assistantResource href="/Characters/Hadagan_male/Instances/UmoirIsland07/UI07_CompanionQuest/UI07_CompanionQuest.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.GoThroughPath">
                                            <runningMode>true</runningMode>
                                            <path>
                                                <Item>
                                                    <scriptID>UI07_Last_Treasure</scriptID>
                                                    <map href="/Maps/UmoirIsland07/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                                </Item>
                                            </path>
                                        </Item>
                                    </impacts>
                                    <spawnResource href="/Maps/UmoirIsland07/SpawnTables/UI07_ForestCompanion_InPortal.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.9</coeff>
            </scaler>
            <attackerConditions>
                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                    <mobs>
                        <Item href="/Characters/Hadagan_male/Instances/UmoirIsland07/UI07_Companion/UI07_Companion.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <Item href="/Characters/Orc_male/Instances/UmoirIsland07/UI07_PirateAssault2/UI07_PirateAssault2.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <Item href="/Characters/Orc_male/Instances/UmoirIsland07/UI07_PirateAssault3/UI07_PirateAssault3.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <Item href="/Characters/Orc_male/Instances/UmoirIsland07/UI07_PirateAssault1/UI07_PirateAssault1.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    </mobs>
                </Item>
            </attackerConditions>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>