	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<level>1</level>
	<prepareDuration>60000</prepareDuration>
	<immutablePrepareDuration>true</immutablePrepareDuration>
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<isAggro>false</isAggro>
	<replaceLowRanks>false</replaceLowRanks>
	<isWorkOnDead>false</isWorkOnDead>
	<modifiers>
		<Item type="gameMechanics.elements.spell.RepelOnNuisance" />
	</modifiers>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.world.ship.elements.PredicateStandingOnBoundShip" />
			<Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
		</casterConditions>
		<channelingMechanics>
			<channelingBuff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			<finishImpacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
					<predicates>
						<Item type="gameMechanics.world.ship.elements.PredicateStandingOnBoundShip" />
						<Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
					</predicates>
					<impacts>
						<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
							<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderTransport" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactKill" />
							</impacts>
						</Item>
					</impacts>
				</Item>
			</finishImpacts>
		</channelingMechanics>
	</mechanics>
	<speed>50</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
