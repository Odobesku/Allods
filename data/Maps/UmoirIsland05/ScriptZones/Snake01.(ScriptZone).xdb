<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>12475</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <conditionsIn>
        <Item type="gameMechanics.elements.resources.ResourceBuff">
            <buff href="/World/Quests/UmoirIsland05/Quest_04/LeaveEscortTrigger.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateMobNear">
                <radius>50</radius>
                <mobs>
                    <Item href="/Creatures/Snake/Instances/UmoirIsland05/Snake.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </mobs>
            </predicate>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
        </Item>
    </conditionsIn>
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
            <table href="/Maps/UmoirIsland05/SpawnTables/Snake1.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
            <delay>500</delay>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                    </impacts>
                    <spawnResource href="/Maps/UmoirIsland05/SpawnTables/Snake1.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactDisableScriptZoneTemporarily">
            <zone href="Snake01.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
            <period>250000</period>
        </Item>
    </impactsIn>
</gameMechanics.map.scriptZone.ScriptZone>