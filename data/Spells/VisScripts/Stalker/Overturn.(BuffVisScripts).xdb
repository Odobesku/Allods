<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureTrailAction">
				<mainHandTrail href="/Spells/FX/InterfaceFX/TrailGreen.(TrailTemplate).xdb#xpointer(/TrailTemplate)" />
				<lengthMSec>1000</lengthMSec>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>spells/Stalker/StalkerSpellOverturn</name>
				</sound>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>overturn</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
