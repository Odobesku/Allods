<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739849562</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>0.01</level>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthLowerTrigger">
            <max type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.05</multiplier>
            </max>
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="AssistantKnockdown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Relaxing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Relaxing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="AssistantKnockdown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectIfOverTime">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                        </Item>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="AssistantKnockdown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="AssistantKnockdown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIf>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>