    <image href="/Interface/Icons/Special/Cues/IconTeleport.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Isle_leave.(BuffResource)_Name.txt.template" />
    <descTemplate href="Isle_leave.(BuffResource)_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ZoneDistributor">
                        <zone type="gameMechanics.elements.calcers.ZoneDistributor$OwnZone" />
                        <faction type="gameMechanics.elements.calcers.ZoneDistributor$AnyFaction" />
                    </distributor>
                    <data href="/World/Quests/UmoirIsland01/UI01_Q03/KickWarning.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/UmoirIsland08/Zones/UmoirIsland08.xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>U_V_gorod</scriptID>
                                    <map href="/Maps/Umoir/City_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                </locator>
                            </destination>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.Hover" />
    </effects>
    <duration>10000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>