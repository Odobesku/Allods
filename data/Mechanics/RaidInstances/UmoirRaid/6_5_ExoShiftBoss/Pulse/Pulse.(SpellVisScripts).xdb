<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart />
	<wholeCasting type="CreatureAnimationAction">
		<animations>
			<Item>attack</Item>
		</animations>
		<channelOverrideScript />
		<advanced>
			<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
		</advanced>
	</wholeCasting>
	<actionBarComplite />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Mobs/ExoShiftBoss_PulseProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Mobs/ExoShiftBoss_PulseHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<pointOnCaster type="VisPointLocator">
					<locator>FROM_LOCATOR_NAME</locator>
					<locatorName>Hips</locatorName>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_Global</locator>
				</pointOnTarget>
				<offendTime type="EffectOffendType" />
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction />
	</playOnTargets>
</SpellVisScripts>
