<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739853255</resourceId>
	</Header>
	<element>SHADOW</element>
	<Name href="VampAOE.(SpellArea).Name.txt" />
	<visualScripts href="/Spells/VisScripts/AstralIslands/UmoirIsland01/VampAOE.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<nameTemplate href="VampAOE.(SpellArea).Name.txt" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>50</value>
	</range>
	<prepareDuration>5000</prepareDuration>
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>666000</duration>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
				<spell href="SummonAdd.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
						<mobs>
							<Item href="BossAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
						</mobs>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
						<impacts>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="PrincesInnerRage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.PostponedImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactKill" />
						</impacts>
					</Item>
				</impactsIf>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
						<impacts>
							<Item type="gameMechanics.elements.impacts.DirectHeal">
								<heal>1</heal>
								<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
									<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
										<multiplier>0.1</multiplier>
									</mulCalcer>
								</scalerTarget>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
						<element>ASTRAL</element>
						<damage>60</damage>
						<scaler type="gameMechanics.elements.scalers.MagicScaler" />
					</Item>
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
	<speed>20</speed>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>30</radius>
	<needLosToTarget>true</needLosToTarget>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
