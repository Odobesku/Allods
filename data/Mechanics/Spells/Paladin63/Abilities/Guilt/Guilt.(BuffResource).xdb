                    <predicate type="gameMechanics.elements.predicates.offender.PredicateIsAE" />
                </Item>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
            </predicates>
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                        <element>FIRE</element>
                                        <scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                            <buff href="Guilt01.(BuffResource).xdb" />
                                            <anyRank>true</anyRank>
