<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Ray_InstantNoWand.(SpellVisScripts).xdb" />
		<Variables>
			<CastAnimation>spellCastDirectedEngineer</CastAnimation>
			<LocatorNameOnCaster>Slot_Hand_R</LocatorNameOnCaster>
			<RayLength>20</RayLength>
			<FXRay>/Spells/FX/Spells/Engineer_RailGun_ChannelPoison.(VisObjectTemplate).xdb</FXRay>
			<LocatorOnCaster>FROM_LOCATOR_NAME</LocatorOnCaster>
			<FXOnTargets>/Spells/FX/Spells/Engineer_HitPoison.(VisObjectTemplate).xdb</FXOnTargets>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationDirect.(CreatureVisActionResource).xdb</PreCastAnimation>
		</Variables>
	</Header>
	<precastType>PRECAST_LAUNCH</precastType>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item skiped="" />
					<Item type="Sound3DAction">
						<sound>
							<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
							<name>spells/Engineer63/RailGun_Acid</name>
						</sound>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx hrefvar="FXOnTargets" />
						</Item>
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
