<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/MageIceStormAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.4</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/WarriorCleave_Part.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>false</fixPoint>
						<lockScale>true</lockScale>
						<scale>10</scale>
						<locator>Slot_FX</locator>
						<offset z="0.1" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/TreantGreenSnow_NeedlesAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<lockScale>true</lockScale>
						<scale>2</scale>
						<locator>Slot_Global</locator>
						<offendTime />
						<offset z="0.7" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
