<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739888767</resourceId>
	</Header>
	<Name href="SwatInner.(SpellArea).Name.txt" />
	<visualScripts href="FlySwat.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>80</value>
	</range>
	<prepareDuration>2500</prepareDuration>
	<immutablePrepareDuration>true</immutablePrepareDuration>
	<needLos>false</needLos>
	<targetType>STTPoint</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<needInFront>false</needInFront>
	<mechanics>
		<cooldown>
			<duration>200000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</predicates>
			</Item>
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
				<radius>9</radius>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactKill" />
				</impacts>
				<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblin/AI66_WildGoblin_brave.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
								<Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblin/AI66_WildGoblin_brave_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							</mobs>
						</Item>
					</predicates>
				</filter>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
				<element>FIRE</element>
				<threatMultiplier>0</threatMultiplier>
				<damage>20</damage>
				<scaler type="gameMechanics.elements.scalers.MagicScaler" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
				</predicates>
				<impactsElse>
					<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
						<element>FIRE</element>
						<damage>60</damage>
						<scaler type="gameMechanics.elements.scalers.MagicScaler" />
					</Item>
				</impactsElse>
			</Item>
		</targetImpacts>
	</mechanics>
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>8</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
