<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<isPrototype>true</isPrototype>
		<Prototype href="Parts/CharacterSpellNoWand.(SpellVisScripts).xdb" />
		<Variables>
			<PreCastAnimation>PreCastAnimationOmni.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastAnimation>
			<CastAnimation>spellCastOmni</CastAnimation>
			<FixPointCaster />
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item skiped="" />
							<Item>
								<locator>Slot_Hand_L</locator>
							</Item>
							<Item>
								<effectFx hrefvar="FXWand" />
								<fixPoint>true</fixPoint>
								<locator>Slot_Hand_R</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<charged type="VisActionList">
		<elements>
			<Item type="CreatureChargedSpellAction">
				<effectFx hrefvar="FXPocket" />
				<effectLocator>Slot_Hand_L</effectLocator>
			</Item>
			<Item type="CreatureChargedSpellAction">
				<effectFx hrefvar="FXPocket" />
				<effectLocator>Slot_Hand_R</effectLocator>
			</Item>
		</elements>
	</charged>
</SpellVisScripts>
