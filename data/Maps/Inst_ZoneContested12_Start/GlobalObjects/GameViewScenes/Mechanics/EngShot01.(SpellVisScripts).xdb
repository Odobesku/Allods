<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/Engineer_LaserShot_Channe.(VisObjectTemplate).xdb" />
				<fxLength>20</fxLength>
				<startPoint type="VisPointLocator">
					<locator>Slot_Hand_L</locator>
				</startPoint>
				<alternativeStartPoint />
				<endPoint type="VisPointLocator">
					<locator>Head</locator>
				</endPoint>
				<alternativeEndPoint />
				<offendTime />
				<secondaryTargetParams>
					<channelingFx href="" />
					<offendTime />
				</secondaryTargetParams>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb" />
						<scale>3</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Head</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
