<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>194398</resourceId>
    </Header>
    <Name href="LightningDebuff.(BuffResource).Name.txt" />
    <Description href="LightningDebuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidCallLightningUpgrade.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/PocketSpellLightning01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <locator>Slot_TopFX</locator>
        </Item>
    </visualEffects>
    <nameTemplate href="" />
    <descTemplate href="" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="LightningHit.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
            </impacts>
            <initialDelay>1000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LightningDebuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <damagePerTick>10</damagePerTick>
            </parameters>
            <element>LIGHTNING</element>
            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            <progressiveMultiplier>0.125</progressiveMultiplier>
        </Item>
    </effects>
    <duration>45000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>