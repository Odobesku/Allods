<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>InSequence</play>
		<preconditional>true</preconditional>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>special</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideScript />
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<stopIfRotated>true</stopIfRotated>
					<stopIfMoved>true</stopIfMoved>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
			<Item type="VisActionDelay">
				<time>2000</time>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Mobs/ArchitectBossInvasion_Ray.(VisObjectTemplate).xdb" />
				<fxLength>0.9</fxLength>
				<startPoint type="VisPointLocator">
					<locator>FROM_LOCATOR_NAME</locator>
					<locatorName>Slot_Special01</locatorName>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_TopFX</locator>
				</endPoint>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ArchitectBossCaster_SuffocateHit.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<locator>Slot_BodyFX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<playOnTargets>
		<specialAction type="CreatureEffectsAction">
			<visualEffects />
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
