<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<LocatorOnCaster>FROM_LOCATOR_NAME</LocatorOnCaster>
			<FXOnCaster>/Spells/FX/Spells/ReadySpellDirectDiseaseWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<LocatorNameOnCaster>Mouth</LocatorNameOnCaster>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<offendTime type="EffectOffendConstDelay" />
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureProjectileAction">
						<pointOnCaster type="VisPointLocator" />
						<pointOnTarget type="VisPointLocator" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
