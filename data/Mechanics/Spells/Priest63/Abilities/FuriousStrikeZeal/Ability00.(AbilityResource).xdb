<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739920995</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>tick</name>
            <value var="value" />
        </Item>
        <Item>
            <name>dmg</name>
            <value var="dmg" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Equipment/Jewelry/NecklaceCross.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.CombatStateTrigger">
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectInstantiating">
                            <effects>
                                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
                                            <summand>1</summand>
                                        </Item>
                                    </impacts>
                                    <tick var="tick" />
                                    <initialDelay var="tick" />
                                </Item>
                            </effects>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>1</coeff>
                        <calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.001</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/DoubleHitChance.(SpecialStatResource).xdb" />
                                    </stat>
                                    <valueType>ShortTerm</valueType>
                                </mulCalcer>
                                <sum>0</sum>
                            </scaler>
                            <value var="dmg" />
                        </calcer>
                    </scaler>
                </Item>
                <Item type="gameMechanics.elements.effects.OutgoingHealModifier">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>1</coeff>
                        <calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.001</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/DoubleHitChance.(SpecialStatResource).xdb" />
                                    </stat>
                                    <valueType>ShortTerm</valueType>
                                </mulCalcer>
                                <sum>0</sum>
                            </scaler>
                            <value var="dmg" />
                        </calcer>
                    </scaler>
                </Item>
                <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>-1</coeff>
                        <calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.001</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/DoubleHitChance.(SpecialStatResource).xdb" />
                                    </stat>
                                    <valueType>ShortTerm</valueType>
                                </mulCalcer>
                                <sum>0</sum>
                            </scaler>
                            <value var="dmg" />
                        </calcer>
                    </scaler>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>