<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>Members</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <Size>114</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <Size>39</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>250</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing></reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>tab_label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/Contextructor/BottomTabs/TabHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="1" y="1"/>
            <Reaction>tab_pressed</Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Ingame/Contextructor/BottomTabs/TabLabelFormatDisabled.txt"/>
                <LayerMain href="/Interface/Ingame/Contextructor/BottomTabs/TabDisabled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateDisabled>
            <StateHighlighted>
                <FormatFileRef href="/Interface/Ingame/Contextructor/BottomTabs/TabLabelFormatSelected.txt"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/Contextructor/BottomTabs/TabLabelFormatNormal.txt"/>
                <LayerMain href="/Interface/Ingame/Contextructor/BottomTabs/TabNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/LFG/Texts/Widgets/TabMembers.txt"/>
            <reactionDblClick></reactionDblClick>
            <soundPress href="/Interface/Ingame/Contextructor/BottomTabs/SoundPressed.(UIWidgetSound).xdb#xpointer(/client.UIState.UIWidgetSound)"/>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <PushedOffset x="0" y="0"/>
            <Reaction></Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Ingame/Contextructor/BottomTabs/TabLabelFormatDisabled.txt"/>
                <LayerMain href="/Interface/Ingame/Contextructor/BottomTabs/TabSelectedDisabled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateDisabled>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/Contextructor/BottomTabs/TabLabelFormatSelected.txt"/>
                <LayerMain href="/Interface/Ingame/Contextructor/BottomTabs/TabSelected.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/LFG/Texts/Widgets/TabMembers.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>false</useDefaultSounds>
</WidgetButton>
