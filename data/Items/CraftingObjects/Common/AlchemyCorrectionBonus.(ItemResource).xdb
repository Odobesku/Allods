<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739976989</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Itemmall/InsightPotion.(UISingleTexture).xdb" />
	<itemMallDescription href="AlchemyCorrectionBonus.(ItemResource).ItemMallDescription.txt" />
	<source>FixedDrop</source>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<usages>
			<Item>
				<actions>
					<Item type="itemService.elements.components.ItemTakeActionImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
								<predicates>
									<Item type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="AlchemyCorrectionBonus.(BuffResource).xdb" />
									</Item>
								</predicates>
								<impacts>
									<Item type="gameMechanics.elements.impacts.StackBuff">
										<buff href="AlchemyCorrectionBonus.(BuffResource).xdb" />
										<delta type="gameMechanics.elements.calcers.FloatData">
											<value>10</value>
										</delta>
									</Item>
								</impacts>
								<elseImpacts>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="AlchemyCorrectionBonus.(BuffResource).xdb" />
										<stacks type="gameMechanics.elements.calcers.FloatData">
											<value>10</value>
										</stacks>
									</Item>
								</elseImpacts>
							</Item>
						</impacts>
					</Item>
				</actions>
				<consumeItems>1</consumeItems>
			</Item>
		</usages>
		<predicates>
			<Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
				<hideText>true</hideText>
				<predicate type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
					<buff href="AlchemyCorrectionBonus.(BuffResource).xdb" />
					<range>
						<max>90</max>
					</range>
				</predicate>
				<clientData href="AlchemyCorrectionBonusWarning.(ClientData).xdb" />
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateHasSkill">
				<skill href="/Mechanics/Skills/AlchemyV2/Alchemy.xdb" />
			</Item>
		</predicates>
	</functionalPart>
	<stackLimit>100</stackLimit>
	<quality href="/Mechanics/ItemQualities/Uncommon.xdb" />
	<prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
		<cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
			<money>2</money>
		</cost>
	</prices>
	<lifeLengthCap>2592000000</lifeLengthCap>
	<itemMallType>ITEMMALLABLE</itemMallType>
	<name href="AlchemyCorrectionBonus.(ItemResource).Name.txt" />
	<description href="AlchemyCorrectionBonus.(ItemResource).Description.txt" />
	<category href="/Mechanics/ItemCategories/ItemMall.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>
