<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmniBard</Item>
				</animations>
				<channel>CHANNEL_ACTIONBAR</channel>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect01DownMusic.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<fadeOutTime>500</fadeOutTime>
						<locator>Slot_Global</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmniBard</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Vampire_Chord.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<locator>Slot_Global</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureEffectsOnTarget">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Vampire_Chord_Targets.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>1</scale>
								<locator>Slot_FX</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
