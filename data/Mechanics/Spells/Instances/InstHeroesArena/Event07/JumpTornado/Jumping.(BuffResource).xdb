<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739918138</resourceId>
    </Header>
    <Name href="Jumping.(BuffResource).Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                    <time>2500</time>
                    <impactsOnLand>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="ImmuneToJump.(BuffResource).xdb" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>1000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                                            <damage>1</damage>
                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                    <multiplier>0.15</multiplier>
                                                </mulCalcer>
                                            </scalerTarget>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ImmuneToJump.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOnLand>
                    <destination type="gameMechanics.map.destination.RelativePos">
                        <coord x="1" z="18" />
                    </destination>
                    <keepOnGround>false</keepOnGround>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>