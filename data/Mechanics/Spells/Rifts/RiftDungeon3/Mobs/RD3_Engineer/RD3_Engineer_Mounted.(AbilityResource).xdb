<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739924862</resourceId>
    </Header>
    <visualScript type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureMountVisAction">
                <visualMount href="/Client/VisualMounts/EngineerTurret/EngineerTurretHadagan.(VisualMount).xdb" />
            </Item>
        </elements>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="RD3_Engineer_DamageRecieved.(BuffResource).xdb" />
                    </Item>
                </casterToTarget>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectModifyHealthRegen">
            <summand>-1</summand>
        </Item>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.constructor.basicElements.FloatZero" />
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="RD3_Engineer_Death.(ClientData).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftAutoattack.(ActionGroup).xdb" />
        </Item>
    </effects>
    <disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>