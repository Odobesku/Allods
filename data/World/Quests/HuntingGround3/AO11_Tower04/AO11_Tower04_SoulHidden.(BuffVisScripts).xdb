<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.IfAction">
        <condition type="client.SLON.IfCreatureVisCharacter">
          <visCharList>
            <Item href="/Creatures/Willowisp/Instances/HuntingGround3/AO11_Tower04_Soul_Red.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
          </visCharList>
          <checkIsInTheList>true</checkIsInTheList>
          <checkOnStartOnly>true</checkOnStartOnly>
