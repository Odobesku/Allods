<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>194580</resourceId>
    </Header>
    <Name href="MindFlayerDestoyer_Double.(SpellSingleTarget).Name.txt" />
    <visualScripts href="MindFlayerDestoyer_Double.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <minRange type="gameMechanics.elements.calcers.FloatData">
        <value>10</value>
    </minRange>
    <prepareDuration>3000</prepareDuration>
    <needLos>false</needLos>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>30000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/Spells/AstarlIslands/AI20/ScorpionAI20/Scorpion_stopEscape.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="MindFlayerDestoyer_fear.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                    <Item type="gameMechanics.elements.impacts.DirectDamage">
                        <damage>1</damage>
                        <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                            <additionalMultiplier>
                                <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="gameMechanics.elements.calcers.HealthInferiorityCalcer" />
                                </scaler>
                            </additionalMultiplier>
                        </scaler>
                        <scalerTarget type="gameMechanics.elements.scalers.TrivialScaler" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>60</radius>
                                <affectGroup>Enemies</affectGroup>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                </impacts>
                                <filter type="gameMechanics.world.creature.CreatureFilter" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                <delay>1000</delay>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                        <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                            <range min="0" max="1" />
                                            <withinRange>false</withinRange>
                                            <minCandidatesCount>0</minCandidatesCount>
                                            <targetCount>0</targetCount>
                                        </selector>
                                        <impacts>
                                            <Item>
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                        <predicates>
                                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                        </predicates>
                                                        <impactsIf>
                                                            <Item type="gameMechanics.elements.impacts.ImpactSetTarget">
                                                                <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                                            </Item>
                                                        </impactsIf>
                                                        <impactsElse>
                                                            <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                        </impactsElse>
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <object href="MindFlayerDestroyer_clone.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                <pool href="MindFlayerDestoyer_Double.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                <isPersonalPool>true</isPersonalPool>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
            <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                            <modifier type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                <radius type="gameMechanics.elements.calcers.FloatData">
                                    <value>2</value>
                                </radius>
                            </modifier>
                        </Item>
                    </modifiers>
                </destination>
                <finishImpacts>
                    <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                        <addresseeFinder type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="AI20_ForceAggro.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </finishImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>