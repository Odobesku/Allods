<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastOmniWand</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectNecromancerWand.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<locator>Wand_Slot_FX</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>4000</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownNecromancer.(VisObjectTemplate).xdb" />
								<locator>Slot_Global</locator>
							</Item>
						</visualEffects>
					</Item>
					<Item type="Sound3DAction">
						<sound>
							<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
							<name>spells/Necromancer/Necromancer70/ReadySpellDirect03DownNecromancer</name>
						</sound>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<actionBarComplite type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/Necromancer70_Restoration_Blood.(VisObjectTemplate).xdb" />
				<locator>Slot_Global</locator>
			</Item>
		</visualEffects>
	</actionBarComplite>
</SpellVisScripts>
