<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739950881</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
	</groups>
	<Name href="Cleave.(SpellSingleTarget).Name.txt" />
	<visualScripts href="Cleave.(SpellVisScripts).xdb" />
	<prepareDuration>3000</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>10000</duration>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.RunImpactsInShape">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
									<Item type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
									</Item>
								</predicates>
							</Item>
							<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
								<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
								<minDamage>100</minDamage>
								<maxDamage>100</maxDamage>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
								<time>1000</time>
								<distance>1</distance>
							</Item>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
							</Item>
						</impactsIf>
					</Item>
				</impacts>
				<shape type="gameMechanics.constructor.schemes.spell.area.Cone">
					<angle type="constructor.basicElements.AngleDegrees">
						<value>30</value>
					</angle>
				</shape>
				<affectGroup>Enemies</affectGroup>
				<radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
					<value>15</value>
				</radius>
				<affectMainTarget>false</affectMainTarget>
				<workOnDead>false</workOnDead>
				<shapeCenterPosition>Caster</shapeCenterPosition>
			</Item>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormGlacialBoss/DoNotMove.(BuffResource).xdb" />
				<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
					<multiplier>2.5</multiplier>
				</durationScaler>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
				<spell href="/Mechanics/Spells/AutoAttack/MeleeDamage.xdb" />
				<duration>
					<second>2</second>
					<ms>500</ms>
				</duration>
			</Item>
		</casterImpacts>
	</mechanics>
	<isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
