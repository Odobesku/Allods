<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739898308</resourceId>
    </Header>
    <Name href="LevelUpAndNewGear.(SpellSingleTarget).Name.txt" />
    <Description href="LevelUpAndNewGear.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>5000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>25</value>
                </minLevel>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                    <minLevel type="gameMechanics.formulas.IntConstantValue">
                        <value>61</value>
                    </minLevel>
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventMember" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItemCounter" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceActiveItemCounter">
                        <points>2</points>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                                    <minLevel type="gameMechanics.formulas.IntConstantValue">
                                        <value>60</value>
                                    </minLevel>
                                </predicate>
                            </Item>
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAddExperience">
                                <calcer type="gameMechanics.elements.calcers.CalcerRemainingExpirience">
                                    <level type="constructor.elements.CalcerLongExternal">
                                        <externalCalcer href="LevelForUp.(CalcerLongResource).xdb#xpointer(/constructor.elements.CalcerLongResource)" />
                                    </level>
                                </calcer>
                                <direct>true</direct>
                                <scaleByGlobal>false</scaleByGlobal>
                            </Item>
                        </impacts>
                        <elseImpacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                <data href="Level60OrMore.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                        </elseImpacts>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceActiveItemCounter" />
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                <impacts>
                                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                        <impactsResource href="Equip.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>