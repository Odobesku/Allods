<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739881481</resourceId>
    </Header>
    <visObject href="/Spells/FX/Spells/Green_projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>8000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>7000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                <resource href="AcidBomb_Explosion.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                            </projectileData>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>1</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ACID</element>
                            <damage>30</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter">
                        <withPet>true</withPet>
                    </filter>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <affectGroup>All</affectGroup>
            <radius>1</radius>
            <height>12</height>
            <delayIn>1000</delayIn>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="ContextActionBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </predicate>
                </Item>
            </predicates>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ContextActionBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <holderImpactsIn>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </holderImpactsIn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>