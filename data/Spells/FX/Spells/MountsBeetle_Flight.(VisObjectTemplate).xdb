<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>250</fadeInMS>
    <fadeOutMS>300</fadeOutMS>
    <geometry href="/Spells/FX/Spells/MountsBeetle_Flight.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <particle href="/Spells/FX/Spells/MountsBeetle_Flight.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)" />
    <scale>1</scale>
    <sound>
        <name>spells/Mount/MountCarpetPlane/WindOfHaste</name>
        <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
    </sound>
    <visObjComponents>
        <Item type="ChainAnimatorComponent">
            <chains>
                <Item>
                    <gravity x="0" y="0" z="0" />
                    <nodes>
                        <Item>joint1</Item>
                        <Item>Slot_Special01</Item>
                    </nodes>
                    <resistance>12</resistance>
                    <spring>10</spring>
                    <useDefaultGravity>true</useDefaultGravity>
                </Item>
            </chains>
            <ignoreVisObjMotion>false</ignoreVisObjMotion>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>