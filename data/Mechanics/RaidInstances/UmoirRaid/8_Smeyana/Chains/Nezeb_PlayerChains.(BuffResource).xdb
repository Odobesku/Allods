<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739873867</resourceId>
    </Header>
    <Name href="Nezeb_PlayerChains.(BuffResource).Name.txt" />
    <Description href="Nezeb_PlayerChains.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/LineUniversalViolet.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
            <impactsIn type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine$ImpactsPack">
                <impactsFromCaster>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="/Mechanics/RaidInstances/UmoirRaid/8_Smeyana/Sarn_AddSummoning/Skrakan_AddSummoning.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                </mobs>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactKill" />
                        </impactsIf>
                    </Item>
                </impactsFromCaster>
            </impactsIn>
            <maxLength>85</maxLength>
            <reconnect>true</reconnect>
            <height>5</height>
            <width>3</width>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
                                <radius>150</radius>
                            </distributor>
                            <data href="Nezeb_PlayerChains.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            <calcers>
                                <addressEntries>
                                    <Item>
                                        <name>caster</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    </Item>
                                    <Item>
                                        <name>target</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                    </Item>
                                </addressEntries>
                            </calcers>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <tick>1000</tick>
                    <affectGroup>All</affectGroup>
                    <radius>10</radius>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="Nezeb_PlayerChains.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="Nezeb_ChainStarter.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="Skrakan_PlayerChains.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="Skrakan_ChainStarter.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </predicates>
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Nezeb_PlayerChains.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsElse>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="PlayerDebuff_SkrakanChain.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                <buff href="Nezeb_PlayerChains.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Nezeb_PlayerChains.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOut>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.PureDamageDoT">
            <parameters>
                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                        <multiplier>0.1</multiplier>
                    </mulCalcer>
                </scalerTarget>
                <damagePerTick>1</damagePerTick>
            </parameters>
            <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>