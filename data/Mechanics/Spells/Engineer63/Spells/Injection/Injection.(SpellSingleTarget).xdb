<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739931824</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/RangedAttacks.xdb" />
	</groups>
	<element>DISEASE</element>
	<Name href="Injection.(SpellSingleTarget).Name.txt" />
	<Description href="Injection.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>dmg</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>MagicScaler</formula>
					</Item>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Engineer/GasGrenade.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Engineer/NeuroGas.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<ranks>
		<Item href="Injection01.(SpellSingleTarget).xdb" />
		<Item href="Injection02.(SpellSingleTarget).xdb" />
		<Item href="Injection03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<launchWhenReady>true</launchWhenReady>
	<mechanics>
		<cooldown>
			<duration>30000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateVariableLessThan">
				<resource href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateCreature" />
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="/Mechanics/Spells/Engineer63/Abilities/Reactor/AutoCoolingDisable.(BuffResource).xdb" />
			</Item>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.elements.impacts.PostponedImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
								<variable href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
								<summand>-80</summand>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.MarkedImpact">
						<mark href="/Mechanics/Spells/Engineer63/Spells/ExplosiveShot/BombOnCaster.(MarkResource).xdb" />
					</Item>
				</impacts>
				<groupRepeaters>true</groupRepeaters>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff hrefvar="buff" />
						<impactsOnAttach>
							<Item type="gameMechanics.elements.impacts.MarkedImpact">
								<mark href="/Mechanics/Spells/Engineer63/Spells/ExplosiveShot/BombOnTarget.(MarkResource).xdb" />
							</Item>
						</impactsOnAttach>
					</Item>
				</impacts>
				<groupRepeaters>true</groupRepeaters>
			</Item>
		</targetImpacts>
	</mechanics>
	<speed>20</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
