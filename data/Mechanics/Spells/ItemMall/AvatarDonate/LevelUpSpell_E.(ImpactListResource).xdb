<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
	<Header>
		<resourceId>739939435</resourceId>
	</Header>
	<impacts>
		<Item type="gameMechanics.constructor.basicElements.ImpactList">
			<impactsResource href="EmpireUnlocksList.(ImpactListResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactSetHearthstone">
			<locator>
				<scriptID>ZE1_Postman</scriptID>
				<map href="/Maps/Hadagan/tower_MapResource.xdb" />
			</locator>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactTeleport">
			<destination type="gameMechanics.map.destination.DestinationLocator">
				<scriptID>ZE1_Postman</scriptID>
				<map href="/Maps/Hadagan/tower_MapResource.xdb" />
			</destination>
			<finishImpacts>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>ZE1_Postman</scriptID>
							<map href="/Maps/Hadagan/tower_MapResource.xdb" />
						</locator>
					</destination>
					<finishImpacts>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.TargetDistributor" />
							<data href="InputClientData.(ClientData).xdb" />
						</Item>
					</finishImpacts>
				</Item>
			</finishImpacts>
		</Item>
		<!--<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
			<delay>3000</delay>
			<impacts>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="QuestCompleteList_E.(ImpactListResource).xdb" />
				</Item>
			</impacts>
		</Item>-->
	</impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>
