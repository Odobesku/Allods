<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FxOnHands>/Spells/FX/Mobs/MountHorseFire_04.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<FXOnCaster>/Spells/FX/Spells/HitFireball.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<scale>1</scale>
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>200</fadeOutTime>
					</Item>
					<Item>
						<scale>1</scale>
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>200</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>InSequence</play>
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<scale>0.5</scale>
								<fadeInTime>250</fadeInTime>
								<fadeOutTime>250</fadeOutTime>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
