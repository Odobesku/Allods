<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
  <precastType>PRECAST_DEFAULT</precastType>
  <wholeCasting type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.CreatureAnimationAction">
            <advanced>
              <autoHasten>
                <mode>AUTOHASTEN_NONE</mode>
                <timeToBeLeft>0</timeToBeLeft>
              </autoHasten>
              <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
              <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
              <offendType>NO_OFFEND</offendType>
              <speed>0</speed>
              <turnToTarget>TURN_DEFAULT</turnToTarget>
              <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
              <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
              <denyAutoHasten>false</denyAutoHasten>
              <disableRandomFirstFrame>true</disableRandomFirstFrame>
              <eventPlaybackEnd>false</eventPlaybackEnd>
              <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
              <stopIfMoved>false</stopIfMoved>
              <stopIfRotated>false</stopIfRotated>
            </advanced>
            <channel>CHANNEL_DEFAULT</channel>
            <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
            <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
            <mode>DIE</mode>
            <use>USE_ANIMATIONS</use>
            <dontFreezePrecast>false</dontFreezePrecast>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="client.SLON.PredicateCreatureVisCharacterAction">
          <visCharList>
            <Item href="/Characters/Aed_female/AedFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Aed_male/AedMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Elf_female/ElfFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Elf_male/ElfMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Hadagan_female/HadaganFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Hadagan_male/HadaganMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Kania_female/KaniaFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Kania_male/KaniaMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Orc_female/OrcFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Orc_male/OrcMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Undead_female/UndeadFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Undead_male/UndeadMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
          </visCharList>
          <checkIsInTheList>true</checkIsInTheList>
          <checkOnStartOnly>true</checkOnStartOnly>
        </playWhile>
        <preconditional>true</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.CreatureAnimationAction">
            <advanced>
              <autoHasten>
                <mode>AUTOHASTEN_NONE</mode>
                <timeToBeLeft>0</timeToBeLeft>
              </autoHasten>
              <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
              <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
              <offendType>NO_OFFEND</offendType>
              <speed>0</speed>
              <turnToTarget>TURN_DEFAULT</turnToTarget>
              <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
              <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
              <denyAutoHasten>false</denyAutoHasten>
              <disableRandomFirstFrame>true</disableRandomFirstFrame>
              <eventPlaybackEnd>false</eventPlaybackEnd>
              <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
              <stopIfMoved>false</stopIfMoved>
              <stopIfRotated>false</stopIfRotated>
            </advanced>
            <channel>CHANNEL_DEFAULT</channel>
            <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
            <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
            <mode>DIE</mode>
            <use>USE_ANIMATIONS</use>
            <dontFreezePrecast>false</dontFreezePrecast>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="client.SLON.PredicateCreatureVisCharacterAction">
          <visCharList>
            <Item href="/Characters/Praiden_female/PraidenFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Praiden_male/PraidenMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
          </visCharList>
          <checkIsInTheList>true</checkIsInTheList>
          <checkOnStartOnly>true</checkOnStartOnly>
        </playWhile>
        <preconditional>true</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.CreatureAnimationAction">
            <advanced>
              <autoHasten>
                <mode>AUTOHASTEN_NONE</mode>
                <timeToBeLeft>0</timeToBeLeft>
              </autoHasten>
              <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
              <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
              <offendType>NO_OFFEND</offendType>
              <speed>3</speed>
              <turnToTarget>TURN_DEFAULT</turnToTarget>
              <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
              <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
              <denyAutoHasten>false</denyAutoHasten>
              <disableRandomFirstFrame>true</disableRandomFirstFrame>
              <eventPlaybackEnd>false</eventPlaybackEnd>
              <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
              <stopIfMoved>false</stopIfMoved>
              <stopIfRotated>false</stopIfRotated>
            </advanced>
            <channel>CHANNEL_DEFAULT</channel>
            <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
            <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
            <mode>DIE</mode>
            <use>USE_ANIMATIONS</use>
            <dontFreezePrecast>false</dontFreezePrecast>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="client.SLON.PredicateCreatureVisCharacterAction">
          <visCharList>
            <Item href="/Characters/Giberling_Group/GiberlingGroup.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
          </visCharList>
          <checkIsInTheList>true</checkIsInTheList>
          <checkOnStartOnly>true</checkOnStartOnly>
        </playWhile>
        <preconditional>true</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </wholeCasting>
  <ownKillingParams>
    <probabilityNoOverkill>0.2</probabilityNoOverkill>
    <probabilityWithOverkill>1</probabilityWithOverkill>
  </ownKillingParams>
  <playOnTargets>
    <skipBloodFx>false</skipBloodFx>
    <skipHitAnimations>false</skipHitAnimations>
  </playOnTargets>
  <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>