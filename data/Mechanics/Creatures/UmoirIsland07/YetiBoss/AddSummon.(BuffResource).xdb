<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739859382</resourceId>
	</Header>
	<Name href="AddSummon.(BuffResource).Name.txt" />
	<image href="/Interface/Icons/Spells/Modifiers/AstralRage.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.95</coeff>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.RepeatedImpact">
					<impact type="gameMechanics.elements.impacts.ImpactInstantiating">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactSummon">
								<destination type="gameMechanics.map.destination.DestinationModified">
									<destination type="gameMechanics.map.destination.SelfPosDestination" />
									<modifiers>
										<Item type="gameMechanics.map.destination.modifier.SpreadModifier">
											<verticalRange min="0" max="0" />
											<horizontalRange min="2" max="4" />
										</Item>
									</modifiers>
								</destination>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
								</impacts>
								<object href="Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
								<pool href="AddSummon.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
							</Item>
						</impacts>
					</impact>
					<count type="gameMechanics.elements.calcers.FloatData">
						<value>3</value>
					</count>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="AddSummonAllow.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
