<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/StalkerCamouflageAbility.(VisObjectTemplate).xdb" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureSetTransparencyAction">
						<transparency>0.5</transparency>
					</Item>
					<Item type="CreatureReplaceAnimationsAction">
						<onTop>
							<animationsReplacements>
								<Item>
									<play>idleSneak</play>
									<forAnimations>
										<Item>idle</Item>
									</forAnimations>
								</Item>
								<Item>
									<play>idleSneak</play>
									<forAnimations>
										<Item>specialIdle</Item>
									</forAnimations>
								</Item>
								<Item>
									<play>sneak</play>
									<forAnimations>
										<Item>walk</Item>
										<Item>run</Item>
									</forAnimations>
								</Item>
							</animationsReplacements>
						</onTop>
						<onBottom>
							<animationsReplacements>
								<Item>
									<play>idleSneak</play>
									<forAnimations>
										<Item>idle</Item>
									</forAnimations>
								</Item>
								<Item>
									<play>idleSneak</play>
									<forAnimations>
										<Item>specialIdle</Item>
									</forAnimations>
								</Item>
								<Item>
									<play>sneak</play>
									<forAnimations>
										<Item>walk</Item>
										<Item>run</Item>
										<Item>specialWalk</Item>
										<Item>runBard</Item>
										<Item>run2HL</Item>
										<Item>runSpellCharged</Item>
										<Item>run1H</Item>
										<Item>runBow</Item>
										<Item>runEngineer</Item>
										<Item>walkEngineer</Item>
									</forAnimations>
								</Item>
							</animationsReplacements>
							<notReplacedanimations />
						</onBottom>
						<restartOnVisualChange>true</restartOnVisualChange>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>