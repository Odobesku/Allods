<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.zone.ZoneResource>
    <Header>
        <resourceId>15192</resourceId>
    </Header>
    <name href="Ship1.(ZoneResource).Name.txt" />
    <color>0xffefea2c</color>
    <parentZone href="Astral_fleet.(ZoneResource).xdb" />
    <pvpType href="/Mechanics/ZonePvpTypes/SanctuaryNoGroup.xdb" />
    <mountsProhibited>true</mountsProhibited>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_1_2_Ship1_Architects.(SpawnTable).xdb" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/World/Quests/ZC12/WW_1_2/Architect_fight.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/World/Quests/ZC12/WW_1_2/Sailors_fight.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="/World/Quests/ZC12/WW_1_2/Counter1.(QuestCountId).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_1_2_Ship1_sailors.(SpawnTable).xdb" />
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/World/Quests/ZC12/WW_1_2/Sailors_fight.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                            <spawnResource href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_1_2_Ship1_sailors.(SpawnTable).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
    </effects>
</gameMechanics.map.zone.ZoneResource>