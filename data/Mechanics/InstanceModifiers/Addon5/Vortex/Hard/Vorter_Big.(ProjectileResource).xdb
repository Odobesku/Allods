	<altitude>0.1</altitude>
	<speed>0.002</speed>
	<lifeLengthCap>35000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
					<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
					<radius>6</radius>
					<affectGroup>Enemies</affectGroup>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>ASTRAL</element>
							<damage>100</damage>
							<impactsOnHitTarget>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Mechanics/InstanceModifiers/Addon5/Vortex/Vortex_DamageCheck.(BuffResource).xdb" />
								</Item>
							</impactsOnHitTarget>
							<scaler type="gameMechanics.elements.scalers.MagicScaler" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
							<time>1000</time>
							<distance>8</distance>
						</Item>
					</impacts>
					<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
									<Item type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
									</Item>
								</predicates>
							</Item>
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Mechanics/InstanceModifiers/Addon5/Vortex/Vortex_DamageCheck.(BuffResource).xdb" />
								</predicate>
							</Item>
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
									<groups>
										<Item href="/Mechanics/InstanceModifiers/Addon5/Not_Astral_Modifiers.(ActionGroup).xdb" />
									</groups>
								</predicate>
							</Item>
						</predicates>
					</filter>
				</Item>
			</impacts>
			<tick>1000</tick>
			<initialDelay>1000</initialDelay>
