<?xml version="1.0" encoding="UTF-8" ?>
<VisualMountClass>
	<Header>
		<Prototype href="Bike.(VisualMountClass).xdb#xpointer(/VisualMountClass)" />
	</Header>
	<animationSettings>
		<complexAnimations>
			<Item>
				<animation>emoteAFK</animation>
				<playOnRiderTop>mountBikeEmoteAFK</playOnRiderTop>
				<playOnRiderBottom>mountBikeEmoteAFK</playOnRiderBottom>
				<playOnMount>emoteAFK</playOnMount>
			</Item>
			<Item>
				<animation>fall</animation>
				<playOnRiderTop>mountBikeJump</playOnRiderTop>
				<playOnRiderBottom>mountBikeJump</playOnRiderBottom>
				<playOnMount>jump</playOnMount>
			</Item>
			<Item>
				<animation>hit</animation>
				<playOnRiderTop>mountBikeJumpEnd</playOnRiderTop>
				<playOnRiderBottom>mountBikeJumpEnd</playOnRiderBottom>
				<playOnMount>hit</playOnMount>
