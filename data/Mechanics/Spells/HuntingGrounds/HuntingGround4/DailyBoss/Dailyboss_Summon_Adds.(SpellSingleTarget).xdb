<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739880298</resourceId>
	</Header>
	<Name href="Dailyboss_Summon_Adds.(SpellSingleTarget).Name.txt" />
	<visualScripts href="DayliBoss_Spell_vis.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>45000</duration>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
				<radius>45</radius>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.ImpactSummon">
								<destination type="gameMechanics.map.destination.DestinationModified">
									<destination type="gameMechanics.map.destination.SelfPosDestination" />
									<modifiers>
										<Item type="gameMechanics.map.destination.modifier.SpreadModifier">
											<verticalRange min="8" max="15" />
											<horizontalRange min="14" max="16" />
										</Item>
									</modifiers>
								</destination>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
									<Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
								</impacts>
								<impactsFromTarget>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="DailyBoss_Add_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									</Item>
								</impactsFromTarget>
								<object href="DailyBoss_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
								<pool href="DailyBoss_Pool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
								<isPersonalPool>true</isPersonalPool>
							</Item>
						</impactsIf>
					</Item>
				</impacts>
				<filter type="gameMechanics.world.creature.AvatarFilter" />
				<targetsLimit>6</targetsLimit>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
