<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
                <channel>CHANNEL_HITCRITICAL</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/World/AI68_Idol_Toad_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.2</scale>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="SmallChennel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <fxLength>5</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>Slot_Hand_R</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </endPoint>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>