                <level>0.4</level>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Mechanics/Spells/AstarlIslands/AI53_UI01/Dwarf03/AI53_Dwarf03.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    <Item href="/Mechanics/Spells/AstarlIslands/AI53_UI01/Dwarf04/AI53_Dwarf04.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
