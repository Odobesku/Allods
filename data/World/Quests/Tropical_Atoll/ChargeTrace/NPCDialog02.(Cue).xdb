<gameMechanics.world.mob.interaction.Cue>
	<Header>
		<resourceId>739826214</resourceId>
	</Header>
	<name href="NPCDialog02.(Cue).Name.txt" />
	<text href="NPCDialog02.(Cue).Text.txt" />
	<conditions>
		<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
			<quest href="ChargeTraceRepeatable.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
			<status>Started</status>
		</Item>
		<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
			<rule href="/Mechanics/Rules/SummerEvent/ChargeTrace.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
		</Item>
	</conditions>
	<impacts>
		<Item type="gameMechanics.elements.impacts.ImpactDismount" />
		<Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
			<group href="/Mechanics/Spells/Groups/Transformation.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
			<quest href="ChargeTraceRepeatable.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
			<counterResource href="ChargeTraceRepeatable.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
			<delay>1000</delay>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/World/Quests/Tropical_Atoll/SeaFly/StartFlying.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</impacts>
</gameMechanics.world.mob.interaction.Cue>
