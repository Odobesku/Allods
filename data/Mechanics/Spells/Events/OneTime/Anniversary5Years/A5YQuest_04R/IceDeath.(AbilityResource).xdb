<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>209816</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impactsToKiller>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceItem">
                            <item href="IceSummon.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                <item href="IceEssence.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                            </item>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
                            <item href="IceSummon.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="/World/Quests/LoreEvents/Anniversary5Years/Anniversary5Years_04R_E_qc1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="/World/Quests/LoreEvents/Anniversary5Years/Anniversary5Years_04R_L_qc1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="RayIce.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsToKiller>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>120000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectNoLoot" />
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>