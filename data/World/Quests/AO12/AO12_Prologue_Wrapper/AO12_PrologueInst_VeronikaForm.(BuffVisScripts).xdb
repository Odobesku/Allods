<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.VisActionChangeVisObject">
				<newVisMob href="/Creatures/Veronika/Veronika.(VisualMob).xdb#xpointer(/VisualMob)" />
				<getBody>true</getBody>
				<getDress>true</getDress>
			</Item>
			<Item type="client.SLON.CreatureRenameAction">
				<name href="/Creatures/Veronika/Instances/AO11_Citadel/AO11_Citadel_Veronika.(MobWorld).Name.txt" />
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>