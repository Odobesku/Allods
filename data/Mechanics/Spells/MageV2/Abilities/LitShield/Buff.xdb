<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>217984</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Special/Talents/Mage/ManaProtect.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>Enemies</affectGroup>
            <radius>5</radius>
            <onBehalfOfHolder>true</onBehalfOfHolder>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Spells/ClientData/Mage_HitLighning.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    <calcers>
                        <addressEntries>
                            <Item>
                                <name>caster</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </Item>
                            <Item>
                                <name>target</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderTarget" />
                            </Item>
                        </addressEntries>
                    </calcers>
                </Item>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>LIGHTNING</element>
                    <damage var="damage" />
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
            </impactsIn>
            <holderImpactsIn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </holderImpactsIn>
        </Item>
    </effects>
    <duration>120000</duration>
    <isStackable>true</isStackable>
    <stackLimit>5</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>false</isMultiple>
    <ranks>
        <Item href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff03.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
    </ranks>
    <canBeSaved>true</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ClassChangeBuffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>