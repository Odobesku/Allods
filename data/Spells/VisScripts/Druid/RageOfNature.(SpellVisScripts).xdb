<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Ray_Instant.(SpellVisScripts).xdb" />
		<Variables>
			<FXOnTargets>/Spells/FX/Spells/Druid70_Hit_RageOfNature.(VisObjectTemplate).xdb</FXOnTargets>
			<RayMaxTime>2500</RayMaxTime>
			<FXOnCaster />
			<RayLength>20</RayLength>
			<FXRay>/Spells/FX/Spells/Druid70_Ray_RageOfNature.(VisObjectTemplate).xdb</FXRay>
			<FXWand />
			<LocatorOnCaster>Slot_Hand_L</LocatorOnCaster>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectNatureWand.(VisObjectTemplate).xdb" />
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item skiped="" />
					<Item type="Sound3DAction">
						<sound>
							<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
							<name>spells/Druid70/Ray_RageOfNature</name>
						</sound>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
