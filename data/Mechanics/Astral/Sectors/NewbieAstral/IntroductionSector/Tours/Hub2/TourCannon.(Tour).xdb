<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.tour.Tour>
    <Header>
        <resourceId>234932</resourceId>
    </Header>
    <route href="RouteCannon.(Route).xdb#xpointer(/gameMechanics.map.tour.Route)" />
    <speed>0.001</speed>
    <impactPoints>
        <Item>
            <point>2</point>
            <impacts type="gameMechanics.world.transport.TransportImpacts">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="ControlBuffs/GoByTourCannon.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="ControlBuffs/GoByTourCannon.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impactsIf>
                                <impactsElse>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="ControlBuffs/GoByTourStopBeam.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </impacts>
        </Item>
    </impactPoints>
    <travelOnce>true</travelOnce>
    <destoyTravelerAtEnd>false</destoyTravelerAtEnd>
</gameMechanics.map.tour.Tour>