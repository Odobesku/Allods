<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739838798</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="GotoBar01_Buff_Proto.(BuffResource).Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane hrefvar="Plane" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="GreenDrunkPeople.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>2000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.GoThroughPath">
                                            <path>
                                                <Item>
                                                    <scriptID var="ScriptID" />
                                                    <map href="/Maps/Tropical_Atoll/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                                </Item>
                                            </path>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <plane hrefvar="Plane" />
                            <object href="GreenDrunkPeople.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>1200000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <ignoreLevelDelta>true</ignoreLevelDelta>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/Events/EventBuffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>