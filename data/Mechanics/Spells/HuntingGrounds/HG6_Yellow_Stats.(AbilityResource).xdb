<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739887638</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
					<key href="/System/ContentKeys/ItemmallService.(ContentKey).xdb" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
					<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
						<coeff>2</coeff>
					</scaler>
					<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
				</Item>
				<Item type="gameMechanics.elements.effects.EffectMobStatQuality">
					<quality href="/Mechanics/HuntingGround/Qualities/HG6_Yellow_Stats.(MobStatQuality).xdb" />
				</Item>
				<Item type="gameMechanics.elements.effects.SummandStat">
					<stat type="gameMechanics.elements.stat.InnateStat">
						<stat>Will</stat>
					</stat>
					<value>50</value>
					<scaler type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>10</multiplier>
					</scaler>
				</Item>
				<Item type="gameMechanics.elements.effects.SummandStat">
					<stat type="gameMechanics.elements.stat.InnateStat">
						<stat>Vitality</stat>
					</stat>
					<value>15</value>
					<scaler type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>10</multiplier>
					</scaler>
				</Item>
			</effectsIf>
			<effectsElse>
				<Item type="gameMechanics.elements.effects.EffectMobStatQuality">
					<quality href="/Mechanics/HuntingGround/Qualities/HG6_Yellow_Stats.(MobStatQuality).xdb" />
				</Item>
			</effectsElse>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
