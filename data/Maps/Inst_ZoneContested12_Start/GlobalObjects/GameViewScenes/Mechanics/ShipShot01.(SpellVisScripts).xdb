<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<playWhile />
		<elements>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/AstralDirectDamage_Channel_Blue.(VisObjectTemplate).xdb" />
