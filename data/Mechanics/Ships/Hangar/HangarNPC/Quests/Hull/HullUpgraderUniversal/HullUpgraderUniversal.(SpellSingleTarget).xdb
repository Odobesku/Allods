<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>243630</resourceId>
    </Header>
    <Name href="HullUpgraderUniversal.(SpellSingleTarget).Name.txt" />
    <Description href="HullUpgraderUniversal.(SpellSingleTarget).Description.txt" />
    <autoAppendToActionPanel>false</autoAppendToActionPanel>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.world.ship.elements.PredicateHasShipInProgress" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.constructor.basicElements.PredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.world.ship.elements.PredicateInHangar" />
                        <Item type="gameMechanics.world.ship.elements.PredicateHasSummonedShip" />
                    </predicates>
                </predicate>
                <clientData href="/Mechanics/Ships/Hangar/HangarNPC/Quests/Hull/Hangar.(ClientData).xdb" />
            </Item>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
            <Item type="gameMechanics.world.ship.elements.PredicateHasBoundShip" />
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.elements.predicates.PredicateHasNoBorrowedShip" />
                <clientData href="/Mechanics/Ships/Hangar/HangarNPC/Quests/Hull/HasBorrowedShip.(ClientData).xdb" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactStartQuiz">
                <question href="/Mechanics/Ships/Hangar/HangarNPC/Quests/Hull/Upgrade.(Question).xdb" />
                <participants type="gameMechanics.elements.addresseeFinders.AddressesFinderSelf" />
                <resultsHandler type="gameMechanics.elements.common.SingleResultHandler">
                    <impactsOnSuccess>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                    <lhs type="gameMechanics.elements.calcers.LongData">
                                        <value>1</value>
                                    </lhs>
                                    <rhs type="gameMechanics.elements.calcers.CalcerLongParam">
                                        <paramName>choice</paramName>
                                    </rhs>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                                    <predicate type="gameMechanics.elements.predicates.PredicateHasNoBorrowedShip" />
                                    <clientData href="/Mechanics/Ships/Hangar/HangarNPC/Quests/Hull/HasBorrowedShip.(ClientData).xdb" />
                                </Item>
                                <Item type="gameMechanics.world.ship.elements.PredicateHasBoundShip" />
                                <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                                    <predicate type="gameMechanics.constructor.basicElements.PredicateAnd">
                                        <predicates>
                                            <Item type="gameMechanics.world.ship.elements.PredicateInHangar" />
                                            <Item type="gameMechanics.world.ship.elements.PredicateHasSummonedShip" />
                                        </predicates>
                                    </predicate>
                                    <clientData href="/Mechanics/Ships/Hangar/HangarNPC/Quests/Hull/Hangar.(ClientData).xdb" />
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.world.ship.elements.PredicateHasShipInProgress" />
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateHasItemsCount">
                                    <items>
                                        <Item href="HullUpgraderUniversal.(ItemResource).xdb" />
                                    </items>
                                    <totalCount>1</totalCount>
                                    <checkDress>false</checkDress>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderShip" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                                                    <lhs type="gameMechanics.elements.calcers.LongData">
                                                        <value>1</value>
                                                    </lhs>
                                                    <rhs type="gameMechanics.world.ship.elements.calcers.CalcerShipQuality" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactDestroyItemsCount">
                                                            <item href="HullUpgraderUniversal.(ItemResource).xdb" />
                                                            <count type="gameMechanics.elements.calcers.LongData">
                                                                <value>1</value>
                                                            </count>
                                                        </Item>
                                                        <Item type="gameMechanics.world.ship.elements.ImpactAddShipInUpgrade">
                                                            <constructionTime>864000000</constructionTime>
                                                            <modification type="gameMechanics.world.ship.elements.ImpactAddShipInUpgrade$ShipModificationQuality">
                                                                <quality>1</quality>
                                                            </modification>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsIf>
                                            <impactsElse>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                            <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                            <data href="/Mechanics/Ships/Hangar/HangarNPC/Quests/Hull/TL.(ClientData).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsElse>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOnSuccess>
                </resultsHandler>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>