<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="CreatureAttachSelfAction">
		<attachTo>Caster_Mount</attachTo>
		<locatorName>Slot_Mount_04</locatorName>
		<memberLocatorName>
			<Item>Slot_Mount_05</Item>
			<Item>Slot_Mount_06</Item>
		</memberLocatorName>
		<playOnSelf type="VisActionList">
			<play>Simultaneously</play>
			<playWhile />
			<elements>
				<Item type="CreatureDisableSpecialIdlesAction" />
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Mobs/DisguisePathos.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<effectAlias href="" />
							<fixPoint>true</fixPoint>
							<offendTime />
						</Item>
					</visualEffects>
				</Item>
				<Item type="VisActionList">
					<playWhile />
					<elements>
						<Item type="CreatureAnimationAction">
							<animations>
								<Item>mountChopperSit01</Item>
							</animations>
							<channel>CHANNEL_CARRY</channel>
							<channelOverrideScript />
						</Item>
						<Item type="CreatureAnimationAction">
							<mode>LOOP</mode>
							<animations>
								<Item>mountChopperIdle01</Item>
							</animations>
							<channel>CHANNEL_CARRY</channel>
							<channelOverrideScript />
						</Item>
					</elements>
				</Item>
				<Item type="CreatureDisableEmotesAction" />
				<Item type="CreatureReplaceAnimationsAction">
					<onTop>
						<animationsReplacements>
							<Item>
								<play>mountChopperIdle01</play>
								<forAnimations>
									<Item>walk</Item>
									<Item>walk01</Item>
									<Item>walk02</Item>
									<Item>walk03</Item>
									<Item>walkBackwards</Item>
									<Item>walkBackwards01</Item>
									<Item>walkBackwards02</Item>
									<Item>walkBackwards03</Item>
									<Item>jump</Item>
									<Item>jumpEnd</Item>
									<Item>jumpLandBackwards</Item>
									<Item>jumpLandRun</Item>
									<Item>jumpStart</Item>
									<Item>run</Item>
									<Item>run01</Item>
									<Item>run02</Item>
								</forAnimations>
							</Item>
						</animationsReplacements>
					</onTop>
					<onBottom>
						<animationsReplacements>
							<Item>
								<play>mountChopperIdle01</play>
								<forAnimations>
									<Item>walk</Item>
									<Item>walk01</Item>
									<Item>walk02</Item>
									<Item>walk03</Item>
									<Item>walkBackwards</Item>
									<Item>walkBackwards01</Item>
									<Item>walkBackwards02</Item>
									<Item>walkBackwards03</Item>
									<Item>jump</Item>
									<Item>jumpEnd</Item>
									<Item>jumpLandBackwards</Item>
									<Item>jumpLandRun</Item>
									<Item>jumpStart</Item>
									<Item>run</Item>
									<Item>run01</Item>
									<Item>run02</Item>
								</forAnimations>
							</Item>
						</animationsReplacements>
					</onBottom>
					<member>Group</member>
					<priority href="" />
				</Item>
			</elements>
		</playOnSelf>
		<playAttachTo />
		<playOnSelfWhenStopped type="CreatureAnimationAction">
			<animations>
				<Item>jumpEnd</Item>
			</animations>
			<channel>CHANNEL_EMOTE</channel>
			<channelOverrideScript />
			<advanced>
				<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
			</advanced>
		</playOnSelfWhenStopped>
		<playAttachToWhenStoppedBackground type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Mobs/DisguisePathos.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<effectAlias href="" />
					<offendTime />
				</Item>
			</visualEffects>
		</playAttachToWhenStoppedBackground>
		<playAttachToWhenStopped />
		<notifyCamera>true</notifyCamera>
	</action>
</BuffVisScripts>
