<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<animations>
			<Item>specialCast</Item>
		</animations>
		<channel>CHANNEL_KNOCKDOWN</channel>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/NecromancerNeurotoxin_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<theGe>5</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Mouth</locator>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</pointOnTarget>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
