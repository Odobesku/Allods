<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>321387</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateInZone">
                                        <zone href="/Maps/ZC12/Zones/ZC12/ZC12.(ZoneResource).xdb" />
                                    </predicate>
                                </Item>
                                <Item type="gameMechanics.world.avatar.assistants.PredicateHasAssistant">
                                    <assistantResource href="WW_3_12_Assistant.(AssistantResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                                    <assistantResource href="WW_3_12_Assistant.(AssistantResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                                    <quest href="WW_3_12.xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                    <quest href="WW_3_12.xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>