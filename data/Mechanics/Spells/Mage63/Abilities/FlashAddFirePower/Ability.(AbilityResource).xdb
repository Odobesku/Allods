<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739922151</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>perc</name>
			<value var="tickBuff" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaSeconds</formula>
			</scaler>
		</Item>
		<Item>
			<name>perc2</name>
			<value var="tick" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaSeconds</formula>
			</scaler>
		</Item>
		<Item>
			<name>dmg</name>
			<value var="dmg" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Misc/Quest/ZC6_firebuff.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/Mage63/Abilities/Flash/Buff.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
									<variable href="/Mechanics/Spells/Mage63/Abilities/ElementalPower/FireVar.(VariableResource).xdb" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<tick var="tickVar" />
				</Item>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Mechanics/Spells/Mage63/Abilities/IcyRayHasteAfterCast/SpeedCast.(BuffResource).xdb" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<tick var="tickBuffVar" />
				</Item>
				<Item type="gameMechanics.elements.effects.EffectsIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
						</Item>
					</predicates>
					<effectsIf>
						<Item type="gameMechanics.elements.effects.ScalerOutputDamageChannel">
							<element>FIRE</element>
							<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
								<coeff var="dmg" />
							</scaler>
						</Item>
					</effectsIf>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
