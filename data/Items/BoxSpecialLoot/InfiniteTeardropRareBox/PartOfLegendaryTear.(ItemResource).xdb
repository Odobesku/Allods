<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>2180</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/IMShardOfFrozenTearsRed.(UISingleTexture).xdb" />
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/ItemMall/Services/InfiniteTearDropRare/TeardropLegendary_90_day.(ItemResource).xdb" />
                        </item>
                        <binding>Transfer</binding>
                        <modifiers>
                            <Item type="itemService.avatar.itemBag.ReplaceRemoveTimeModifier" />
                        </modifiers>
                    </Item>
                </actions>
                <consumeItems>200</consumeItems>
            </Item>
        </usages>
        <useStack>true</useStack>
    </functionalPart>
    <stackLimit>1000</stackLimit>
    <quality href="/Mechanics/ItemQualities/Legendary.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
    </prices>
    <lifeLengthCap>7776000000</lifeLengthCap>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="PartOfLegendaryTear.(ItemResource).Name.txt" />
    <description href="PartOfLegendaryTear.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/ItemMall.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>