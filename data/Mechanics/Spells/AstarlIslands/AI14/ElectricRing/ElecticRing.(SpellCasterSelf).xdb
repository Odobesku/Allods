<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>207439934</resourceId>
    </Header>
    <Name href="ElecticRing.txt" />
    <visualScripts href="ElectricRing.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="" />
    <prepareDuration>3000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>6000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                        <time>1000</time>
                        <impactsOnLand>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                                <radius>15</radius>
                                                <affectGroup>Enemies</affectGroup>
                                                <affectHolder>false</affectHolder>
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                        <element>LIGHTNING</element>
                                                        <damage>35</damage>
                                                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                    </Item>
                                                </impacts>
                                                <filter type="gameMechanics.constructor.basicElements.FilterOr">
                                                    <filters>
                                                        <Item type="gameMechanics.world.creature.AvatarFilter" />
                                                        <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                            <predicates>
                                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                </Item>
                                                            </predicates>
                                                        </Item>
                                                    </filters>
                                                </filter>
                                            </Item>
                                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                <data href="LightningHit.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnLand>
                        <destination type="gameMechanics.map.destination.RelativePos" />
                        <keepOnGround>false</keepOnGround>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>