<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739833266</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/RaidInstances/UmoirRaid/Disabler.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
								<Item type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
									<spawn>
										<scriptID>Ship</scriptID>
										<map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
									</spawn>
									<onBehalfOfTarget>true</onBehalfOfTarget>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.DirectDamage">
													<damage>1</damage>
													<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
														<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
															<multiplier>0.01</multiplier>
														</mulCalcer>
													</scalerTarget>
												</Item>
											</impactsIf>
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
									<data href="/Mechanics/Abilities/AstralIslands/AI08/Explosion/Explosion.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<tick>4000</tick>
					<initialDelay>8000</initialDelay>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="DemonShipDamage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</onEnter>
		</Item>
	</effects>
	<disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>
