<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>220063</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
    <element>ASTRAL</element>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Spell00.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Psionic/MergingMinds.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Psionic/EctoForm.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>15</value>
    </range>
    <targetType>STTPoint</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration var="cooldown" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIncVariable">
                <variable href="/Mechanics/Spells/Psionic63/Abilities/StressResource/StressResource.(VariableResource).xdb" />
                <inc>25</inc>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAllEnemies">
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="AllowNoVisTargets.(BuffResource).xdb" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.world.pet.ImpactSummonPet">
                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                <impacts>
                    <Item type="gameMechanics.world.changeappearance.ImpactCopyAppearance" />
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Illusion.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactCopyFaction" />
                </impacts>
                <traceDown>true</traceDown>
                <mobResource href="DummyIllusion.(MobWorld).xdb" />
                <petType href="Illusion.(PetTypeResource).xdb" />
                <linkMode>Health</linkMode>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Buff00.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierTrailFrom">
                            <from type="gameMechanics.map.destination.SelfPosDestination" />
                        </Item>
                    </modifiers>
                </destination>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>