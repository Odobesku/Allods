<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_PrecastHands.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_PrecastHands.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Spells/PierBoss_FireStrike.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<offset z="-1" />
				<scale>3</scale>
				<lifeTime>4</lifeTime>
			</Item>
		</elements>
	</actionBarStart>
	<actionBarComplite type="VisActionList">
		<visActionID>List</visActionID>
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_PrecastHands.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarComplite>
	<launch type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>1000</time>
			</Item>
			<Item type="VisActionStopAction">
				<stoppedActionID>List</stoppedActionID>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
