<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739856095</resourceId>
	</Header>
	<name href="HealProj.(ProjectileResource).Name.txt" />
	<corpulence>2</corpulence>
	<visObject href="/Spells/FX/Spells/HealPuddle.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<altitude>0</altitude>
	<lifeLengthCap>10000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
					<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
					<radius>5</radius>
					<affectGroup>Friends</affectGroup>
					<affectHolder>false</affectHolder>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
									<mobs>
										<Item href="AI53_Dwarf01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									</mobs>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
									<data href="HealData.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
								</Item>
								<Item type="gameMechanics.elements.impacts.DirectHeal">
									<heal>1</heal>
									<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
											<multiplier>0.05</multiplier>
										</mulCalcer>
									</scalerTarget>
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="Silence.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="CastReady.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<filter type="gameMechanics.world.creature.MobFilter" />
				</Item>
			</impacts>
			<initialDelay>3000</initialDelay>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
