<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<FixPointCaster>true</FixPointCaster>
			<FixPointTarget>true</FixPointTarget>
			<LocatorNameOnTargets />
			<LocatorOnCaster>Slot_Mouth</LocatorOnCaster>
			<PreCastAnimation>run</PreCastAnimation>
			<FXOnCaster>/Spells/FX/Mobs/Firebreath_Cleave_Particles.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<HitPostFXOnTargets />
			<FxOnHands />
			<CastAnimation>specialCast</CastAnimation>
			<FXOnTargets />
			<LocatorNameOnCaster>Slot_Special01</LocatorNameOnCaster>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item skiped="" />
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx hrefvar="FXOnCaster" />
								<fixPoint var="FixPointCaster" />
								<lockScale>true</lockScale>
								<scale>1.2</scale>
								<locator var="LocatorOnCaster" />
								<offset x="0" y="0" z="0" />
								<rotation x="0" y="0" z="0" />
								<ignoreParentRotation>true</ignoreParentRotation>
							</Item>
						</visualEffects>
						<stopOnDeath>false</stopOnDeath>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
