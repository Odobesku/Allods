            <stages>
                <Item>Start</Item>
                <Item>Launch</Item>
            </stages>
        </Item>
        <Item type="gameMechanics.elements.effects.EventTrigger">
            <eventClasses>
                <Item>gameMechanics.elements.events.EventMountStarted</Item>
