<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="VisActionChangeVisObject">
				<newVisMob href="/Creatures/Willowisp/Invis.(VisualMob).xdb" />
			</Item>
			<Item type="PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/WideScreen.(UserPostEffect).xdb" />
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb" />
					<name>Ambience/Cutscenes/Ferris_Raid/Last_Start</name>
				</sound>
				<reverbPreset>
					<project href="" />
					<name />
				</reverbPreset>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureCutSceneAction" />
					<Item type="CreatureMusicParamAction">
						<parameter href="FerrisRaidCutscene.(SoundParameter).xdb" />
						<creatureParameter type="CutSceneParameter" />
						<value>1</value>
					</Item>
					<Item type="Sound2DAction">
						<sound>
							<project href="/SFX/Music/Music.(FMODProject).xdb" />
							<name>Music/AdaptiveMusic/TepPyramidAdaptive</name>
						</sound>
						<actionType>Music</actionType>
						<reverbPreset>
							<project href="" />
							<name />
						</reverbPreset>
					</Item>
					<Item type="CreatureMusicParamAction">
						<parameter href="CombatState3.(SoundParameter).xdb" />
						<creatureParameter type="CutSceneParameter" />
						<value>2</value>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
	<postAction type="Sound2DAction">
		<sound>
			<project href="" />
			<name />
		</sound>
		<actionType>Music</actionType>
		<reverbPreset>
			<project href="" />
			<name />
		</reverbPreset>
	</postAction>
</BuffVisScripts>
