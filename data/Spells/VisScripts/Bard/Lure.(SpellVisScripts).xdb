<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Ray.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<RayLength>11</RayLength>
			<FXRay>/Spells/FX/Spells/Bard_Dirge_Channel_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXRay>
			<PreCastFX>PreCastFXSound.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastFX>
			<Animation>readySpellOmniBard</Animation>
			<LocatorOnCaster>Slot_BodyFX</LocatorOnCaster>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmniBard</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Vampire_Chord.(VisObjectTemplate).xdb" />
								<locator>Slot_Global</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
