	<mechanics>
		<cooldown>
			<stage>Launch</stage>
			<duration>999999</duration>
			<group href="" />
		</cooldown>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
						<time>800</time>
						<impactsOnLand>
							<Item type="gameMechanics.elements.impacts.ReturningImpact">
								<impacts>
									<Item type="gameMechanics.elements.impacts.BuffDetacher">
										<buff href="JumpTarget.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									</Item>
									<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
										<projectileData>
											<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
												<destination type="gameMechanics.map.destination.DestinationModified">
													<destination type="gameMechanics.map.destination.SelfPosDestination" />
													<modifiers>
														<Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
													</modifiers>
												</destination>
											</moveType>
											<resource href="AfterJumpAOE.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
										</projectileData>
										<pool href="SP.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
									</Item>
									<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
										<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
										<data href="/Mechanics/Spells/Mounts/Battlemount/Jump/BattleMountLand.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
									</Item>
								</impacts>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
								<radius>12</radius>
								<affectGroup>Enemies</affectGroup>
								<affectHolder>false</affectHolder>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
										<element>PHYSICAL</element>
										<damage>25</damage>
										<scaler type="gameMechanics.elements.scalers.MagicScaler" />
									</Item>
								</impacts>
								<filter type="gameMechanics.constructor.basicElements.FilterOr">
									<filters>
										<Item type="gameMechanics.world.creature.AvatarFilter" />
										<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
