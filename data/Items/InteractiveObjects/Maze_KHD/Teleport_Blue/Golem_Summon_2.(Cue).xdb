		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactsIf">
			<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
				<onMaster type="gameMechanics.map.variables.PredicateMapVariableEquals">
					<variableResource href="/Mechanics/Spells/Maze/Maze_v2/GolemBuff/CheckBuffs/1st_Round_End.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
					<expectedValue type="gameMechanics.elements.calcers.FloatData">
						<value>0</value>
					</expectedValue>
				</onMaster>
			</predicate>
			<impactsIf>
				<Item type="gameMechanics.elements.impacts.ImpactsIf">
					<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
						<onMaster type="gameMechanics.map.variables.PredicateMapVariableEquals">
							<variableResource href="/Mechanics/Spells/Maze/Maze_v2/GolemBuff/CheckBuffs/Golem_Alive.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
							<expectedValue type="gameMechanics.elements.calcers.FloatData">
								<value>0</value>
							</expectedValue>
						</onMaster>
					</predicate>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactsIf">
							<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
								<onMaster type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.map.variables.PredicateMapVariableEquals">
										<variableResource href="/Mechanics/Spells/Maze/Maze_v2/GolemBuff/CheckBuffs/Golem_Waves.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
										<expectedValue type="gameMechanics.elements.calcers.FloatData">
											<value>6</value>
										</expectedValue>
									</predicate>
								</onMaster>
							</predicate>
							<impactsIf>
								<Item type="gameMechanics.constructor.basicElements.ImpactList">
									<impactsResource href="/Mechanics/Spells/Maze/Maze_v2/GolemBuff/Golem_Spawn.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ImpactsIf">
									<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
										<onMaster type="gameMechanics.map.variables.PredicateMapVariableEquals">
											<variableResource href="/Mechanics/Spells/Maze/Maze_v2/GolemBuff/CheckBuffs/Golem_Waves.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
											<expectedValue type="gameMechanics.elements.calcers.FloatData">
												<value>6</value>
											</expectedValue>
										</onMaster>
									</predicate>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactsIf">
											<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
												<onMaster type="gameMechanics.map.variables.PredicateMapVariableEquals">
													<variableResource href="/Mechanics/Spells/Maze/Maze_v2/GolemBuff/CheckBuffs/Golem_Alive.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
													<expectedValue type="gameMechanics.elements.calcers.FloatData">
														<value>0</value>
													</expectedValue>
												</onMaster>
											</predicate>
											<impactsIf>
												<Item type="gameMechanics.constructor.basicElements.ImpactList">
													<impactsResource href="/Mechanics/Spells/Maze/Maze_v2/GolemBuff/Race_Start.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
												</Item>
											</impactsIf>
										</Item>
									</impactsIf>
								</Item>
							</impactsElse>
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
							<data href="/Mechanics/Spells/Maze/Maze_v2/GolemBuff/Stele_Warning_Golems_Alive.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
						</Item>
