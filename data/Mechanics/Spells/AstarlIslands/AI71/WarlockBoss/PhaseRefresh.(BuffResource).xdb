                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="CrowPhase.(BuffResource).xdb" />
                                                </Item>
                                            </impactsIf>
