<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.elements.skills.forge.ForgeCraftRecipe>
    <Header>
        <resourceId>262471</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <result type="gameMechanics.constructor.schemes.item.BoundItemProvider">
        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
            <item hrefvar="item" />
        </item>
    </result>
    <available>
        <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
            <minLevel type="gameMechanics.formulas.MaxLevelConstant">
                <summand>-3</summand>
            </minLevel>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateExternal">
            <predicateResource hrefvar="predicateResource" />
        </Item>
    </available>
    <craftComponents>
        <moneyRequired type="gameMechanics.elements.calcers.CalcerLongMulFloat">
            <calcerLong type="gameMechanics.elements.calcers.CalcerLongMul">
                <calcers>
                    <Item type="gameMechanics.elements.calcers.LongData">
                        <value var="Goldvalue" />
                    </Item>
                    <Item type="constructor.elements.CalcerLongExternal">
                        <externalCalcer href="GoldForCraftRate.(CalcerLongResource).xdb" />
                    </Item>
                </calcers>
            </calcerLong>
            <calcerFloat type="constructor.elements.CalcerFloatExternal">
                <externalCalcer href="CraftDiscountExternal.(CalcerFloatResource).xdb" />
            </calcerFloat>
        </moneyRequired>
        <components>
            <Item>
                <item hrefvar="CraftComponent" />
                <count var="CCcount" />
            </Item>
            <Item>
                <item hrefvar="UpQualityProxyComp" />
                <count var="UpProxyCC" />
            </Item>
        </components>
    </craftComponents>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
            <chanceCalcer type="constructor.elements.CalcerFloatExternal">
                <externalCalcer href="Forge_CritChanceExternal.(CalcerFloatResource).xdb" />
            </chanceCalcer>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactAddMoney">
                    <sumCalcer type="gameMechanics.elements.calcers.CalcerLongMulFloat">
                        <calcerLong type="gameMechanics.elements.calcers.CalcerLongMul">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.LongData">
                                    <value var="Goldvalue" />
                                </Item>
                                <Item type="constructor.elements.CalcerLongExternal">
                                    <externalCalcer href="GoldForCraftRate.(CalcerLongResource).xdb" />
                                </Item>
                            </calcers>
                        </calcerLong>
                        <calcerFloat type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="CraftDiscountExternal.(CalcerFloatResource).xdb" />
                                </Item>
                                <Item type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="Forge_CritChanceExternal.(CalcerFloatResource).xdb" />
                                </Item>
                            </calcers>
                        </calcerFloat>
                        <rounding>Ceil</rounding>
                    </sumCalcer>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                        <item hrefvar="CraftComponent" />
                    </item>
                    <binding>ForceBind</binding>
                    <count type="gameMechanics.elements.calcers.CalcerLongMulFloat">
                        <calcerLong type="gameMechanics.elements.calcers.LongData">
                            <value var="CCcount_long" />
                        </calcerLong>
                        <calcerFloat type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer href="Forge_CritChanceExternal.(CalcerFloatResource).xdb" />
                        </calcerFloat>
                        <rounding>Ceil</rounding>
                    </count>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                        <item hrefvar="UpQualityProxyComp" />
                    </item>
                    <binding>ForceBind</binding>
                    <count type="gameMechanics.elements.calcers.CalcerLongMulFloat">
                        <calcerLong type="gameMechanics.elements.calcers.LongData">
                            <value var="UpProxyCC_long" />
                        </calcerLong>
                        <calcerFloat type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer href="Forge_CritChanceExternal.(CalcerFloatResource).xdb" />
                        </calcerFloat>
                        <rounding>Ceil</rounding>
                    </count>
                </Item>
            </impacts>
        </Item>
    </impacts>
</gameMechanics.elements.skills.forge.ForgeCraftRecipe>