<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>249308</resourceId>
    </Header>
    <Name href="StormAvatar.(BuffResource).Name.txt" />
    <Description href="StormAvatar.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/LigthniningDot.(UISingleTexture).xdb" />
    <nameTemplate href="StormAvatar.(BuffResource).NameTemplate.txt" />
    <descTemplate href="StormAvatar.(BuffResource).DescTemplate.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                    <impact type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                <destination type="gameMechanics.map.destination.DestinationModified">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                    <modifiers>
                                        <Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
                                            <alternatives>
                                                <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="1" max="3" />
                                                    <horizontalRange min="15" max="30" />
                                                </Item>
                                                <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="1" max="3" />
                                                    <horizontalRange min="10" max="14" />
                                                </Item>
                                                <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="1" max="3" />
                                                    <horizontalRange min="0" max="9" />
                                                </Item>
                                            </alternatives>
                                        </Item>
                                        <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                                    </modifiers>
                                </destination>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="PlaneForStormlings.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                                <object href="Stormling.(MobWorld).xdb" />
                            </Item>
                        </impacts>
                    </impact>
                    <count type="gameMechanics.elements.calcers.FloatData">
                        <value>3</value>
                    </count>
                </Item>
            </impacts>
            <tick>1500</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>