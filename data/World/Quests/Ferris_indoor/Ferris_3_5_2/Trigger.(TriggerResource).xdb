<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>309205</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="Ferris_3_5_2.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
            <counterId href="/Items/InteractiveObjects/Ferris/Ferris03/Lever2/Lever2.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
            <condition type="constructor.elements.LongEquals">
                <value>3</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                    <spawnResource href="/Maps/Ferris_indoor/SpawnTables/Mech_guard.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="CameraTrack.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>barrier1</scriptID>
                                <map href="/Maps/Ferris_indoor/1stWing_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.device.DoorSwitch">
                                    <switchType>Open</switchType>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                            <data href="Forcefield_turn_off.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="Ferris_3_5_2.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
            <counterId href="/Characters/Hadagan_female/Instances/Ferris/Zimian_Clone.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
            <condition type="constructor.elements.LongEquals">
                <value>4</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="/Maps/Ferris_indoor/SpawnTables/Zimina_clones.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>lift_button</scriptID>
                        <map href="/Maps/Ferris_indoor/1stWing_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </device>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>valve1</scriptID>
                                <map href="/Maps/Ferris_indoor/1stWing_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                                    <visualState>2</visualState>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="Valve1.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Start</Item>
            </stages>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>valve2</scriptID>
                                <map href="/Maps/Ferris_indoor/1stWing_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                                    <visualState>2</visualState>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="Valve2.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Start</Item>
            </stages>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>