<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>0</fadeOutMS>
    <geometry href="/Creatures/MountExoskeletonV3/MEV3_Hand_HA_L.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <scale>1</scale>
    <sound>
        <name>Mounts/MountExoskeleton_V3/Idle</name>
        <project href="/SFX/Creatures/Mounts.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
    </sound>
    <visObjComponents>
        <Item type="BonesFromParentComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <bonesMode>LocalRotations</bonesMode>
            <ownRootBone>LeftArm</ownRootBone>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>