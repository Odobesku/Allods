<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
	<Header>
		<resourceId>739905120</resourceId>
	</Header>
	<persistentParts>
		<Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.TickableEntityAura">
					<affectGroup>All</affectGroup>
					<radius>3</radius>
					<filter type="gameMechanics.world.creature.AvatarFilter" />
					<impactsIn>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="PortalKiller_Permission.(BuffResource).xdb" />
									</predicate>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
									<data href="TeleportStart.(ClientData).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactTeleport">
									<destination type="gameMechanics.map.destination.DestinationModified">
										<destination type="gameMechanics.map.destination.DestinationLocator">
											<locator>
												<scriptID>FR_9_PKG</scriptID>
												<map href="/Maps/FerrisRaid/MapResource.xdb" />
											</locator>
										</destination>
										<modifiers>
											<Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
												<radius type="gameMechanics.elements.calcers.FloatData">
													<value>5</value>
												</radius>
											</Item>
										</modifiers>
									</destination>
									<finishImpacts>
										<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
											<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
											<data href="TeleportEnd.(ClientData).xdb" />
										</Item>
									</finishImpacts>
								</Item>
							</impactsIf>
						</Item>
					</impactsIn>
					<impactsOut>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="PortalKiller_Permission.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
									<data href="TeleportStart.(ClientData).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactTeleport">
									<destination type="gameMechanics.map.destination.DestinationLocator">
										<locator>
											<scriptID>FR_9_PKG</scriptID>
											<map href="/Maps/FerrisRaid/MapResource.xdb" />
										</locator>
									</destination>
									<finishImpacts>
										<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
											<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
											<data href="TeleportEnd.(ClientData).xdb" />
										</Item>
									</finishImpacts>
								</Item>
							</impactsIf>
						</Item>
					</impactsOut>
				</Item>
				<Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
					<delay>8000</delay>
					<effects>
						<Item type="gameMechanics.elements.effects.Switch">
							<impactsOn>
								<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
									<visualState>2</visualState>
								</Item>
							</impactsOn>
						</Item>
						<Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
							<delay>6000</delay>
							<effects>
								<Item type="gameMechanics.elements.effects.Switch">
									<impactsOn>
										<Item type="gameMechanics.elements.impacts.Disintegrate" />
									</impactsOn>
								</Item>
							</effects>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</persistentParts>
	<name href="PortalKiller_green.(SteleResource).Name.txt" />
	<visObj href="/Spells/FX/World/PortalKiller_green.(VisObjectTemplate).xdb" />
	<collision href="/Spells/FX/World/FerrisRaid_Portal_R3.(Collision).xdb" />
