<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>196385</resourceId>
    </Header>
    <visObject href="BossTrick.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>40000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Aura">
            <radius>5</radius>
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <delayIn>1500</delayIn>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="BossTrick.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="BossTrick.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <affectSelf>false</affectSelf>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>