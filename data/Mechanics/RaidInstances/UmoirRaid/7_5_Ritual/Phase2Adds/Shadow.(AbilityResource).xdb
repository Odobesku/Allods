<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>225241</resourceId>
    </Header>
    <name href="Shadow.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                        <resource href="Shadowbomb.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Aura">
            <radius>6</radius>
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Phase2Summons/Phase2Shadow.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </mobs>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Phase2Summons/Phase2Fire.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </mobs>
                                </Item>
                            </predicates>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/Mechanics/RaidInstances/UmoirRaid/2_KtulhuBoss/NoTargeting.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>0.8</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
            <quality href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Ritual.(MobStatQuality).xdb#xpointer(/gameMechanics.world.mob.MobStatQuality)" />
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>