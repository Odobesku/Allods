<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>224646</resourceId>
    </Header>
    <element>ASTRAL</element>
    <Name href="R7_FlyingDeath.(SpellSingleTarget).Name.txt" />
    <visualScripts href="R7_FlyingDeath.(SpellVisScripts).xdb" />
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>48000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="R7_Trap.(BuffResource).xdb" />
                        </predicate>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="R7_Trap2.(BuffResource).xdb" />
                        </predicate>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="R7_RayAttack_2.(BuffResource).xdb" />
                        </predicate>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="R7_Cleave.(BuffResource).xdb" />
                        </predicate>
                    </Item>
                </predicates>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                    <range min="0" max="85" />
                    <withinRange>true</withinRange>
                    <minCandidatesCount>1</minCandidatesCount>
                    <targetCount>1</targetCount>
                </selector>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
                <impacts>
                    <Item>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/RaidInstances/ArchBaseRaid/Other/TankBuff.(BuffResource).xdb" />
                                                </predicate>
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="R7_Trap.(BuffResource).xdb" />
                                                </predicate>
                                            </Item>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="R7_Trap2.(BuffResource).xdb" />
                                                </predicate>
                                            </Item>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="R7_RayAttack_2.(BuffResource).xdb" />
                                                </predicate>
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="R7_FlyingDeath.(BuffResource).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>