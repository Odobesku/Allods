<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739872292</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
	<Name href="AutoAttackNormalWorld.(SpellSingleTarget).Name.txt" />
	<image href="/Interface/Icons/Spells/AutoAttack.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualScripts href="/Spells/VisScripts/Common/AutoAttackMelee.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<sysName>MeeleeAttack</sysName>
	<range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
	<prepareDuration>1500</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>1</duration>
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="NormalWorld.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateCreature" />
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="GhostWorld.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
						<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
						<avgDamage>100</avgDamage>
					</Item>
				</impactsIf>
				<impactsElse>
					<Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
						<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
						<avgDamage>50</avgDamage>
					</Item>
				</impactsElse>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
