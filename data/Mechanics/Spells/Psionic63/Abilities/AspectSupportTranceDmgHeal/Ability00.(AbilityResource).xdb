    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="heal" />
        </Item>
        <Item>
            <name>var1</name>
            <value var="damage" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Psionic/PsionicMindFire.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Psionic63/Abilities/AspectSupportTrance/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.IncomingHealModifier">
                    <priority>Multiplier</priority>
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>0.01</coeff>
                        <calcer type="gameMechanics.elements.calcers.FloatData">
                            <value var="heal" />
                        </calcer>
                    </scaler>
                </Item>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>0.01</coeff>
                        <calcer type="gameMechanics.elements.calcers.FloatData">
                            <value var="damage" />
                        </calcer>
                    </scaler>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectsToAllAssistants">
                            <effects>
                                <Item type="gameMechanics.elements.effects.EffectsIf">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                                            <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                        </Item>
                                    </predicates>
                                    <effectsIf>
                                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                                <coeff>0.01</coeff>
                                                <calcer type="gameMechanics.elements.calcers.FloatData">
                                                    <value var="damage" />
                                                </calcer>
                                            </scaler>
                                        </Item>
                                    </effectsIf>
                                </Item>
                            </effects>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
