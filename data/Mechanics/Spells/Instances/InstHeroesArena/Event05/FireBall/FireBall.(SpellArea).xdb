<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>195724</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/LightningSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroupElement)" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <element>FIRE</element>
    <Name href="FireBall.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestHolySmite.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="/Spells/VisScripts/Bosses/HeroesArena/05FireBall.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="FireBall.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>85</value>
    </range>
    <prepareDuration>1000</prepareDuration>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>12000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>FIRE</element>
                <damage>47</damage>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.map.variables.PredicateMapVariableGreater">
                        <variableResource href="/Maps/Inst_HeroesArena/ScriptZones/WaveNumberNew.xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                        <minValue type="gameMechanics.elements.calcers.FloatData">
                            <value>12.5</value>
                        </minValue>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                            <rule href="/Mechanics/Spells/Instances/InstHeroesArena/DeactivateNewSpells.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                        </predicate>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/Instances/InstHeroesArena/Event05/FireWeakness/FireWeakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/Instances/InstHeroesArena/Event05/FireWeakness/StackCount.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>30</speed>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>