<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>instantSpellCastDirected</Item>
                        </animations>
                        <advanced>
                            <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                        </advanced>
                    </Item>
                    <Item type="CreatureProjectileAction">
                        <projectileFx href="/Spells/FX/Spells/PocketSpellIce01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <isMultyProjectile>true</isMultyProjectile>
                        <theGe>6</theGe>
                        <pointOnCaster type="VisPointLocator">
                            <locator>Slot_Hand_R</locator>
                        </pointOnCaster>
                    </Item>
                </elements>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/MageIceInstabilityProc.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_BodyFX</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>