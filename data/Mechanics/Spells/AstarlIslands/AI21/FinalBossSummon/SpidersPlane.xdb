<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>189161</resourceId>
    </Header>
    <visualScript type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Mobs/Demon_TargetMark.(VisObjectTemplate).xdb" />
                <scale>2</scale>
                <locator>Slot_TopFX</locator>
                <offset x="0.75" z="1" />
            </Item>
        </visualEffects>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Plane.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.4</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/AstarlIslands/AI21/FinalBossPoisonCleave/DontMoveWhileYouCast.(BuffResource).xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>4</multiplier>
                    </durationScaler>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/AstarlIslands/AI21/SpiderImmobilizingWeb/BuffWebR5.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/AstarlIslands/AI21/SpiderImmobilizingWeb/BuffWebR5.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <spawnResource href="/Maps/EpicIsle5/SpawnTables/EpicIsle5/AstralSpiderFinalBoss.(MobSpawnTable).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/AstarlIslands/AI21/SpiderImmobilizingWeb/BuffWebR5.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                            <destination type="gameMechanics.map.destination.DestinationModified">
                                                <destination type="gameMechanics.map.destination.DestinationModified">
                                                    <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                                        <base type="gameMechanics.map.destination.SelfPosDestination" />
                                                        <offset>2</offset>
                                                    </destination>
                                                    <modifiers>
                                                        <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                            <verticalRange min="0" max="1" />
                                                            <horizontalRange min="0" max="0.5" />
                                                        </Item>
                                                    </modifiers>
                                                </destination>
                                                <modifiers>
                                                    <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                                                </modifiers>
                                            </destination>
                                        </moveType>
                                        <resource href="/Mechanics/Spells/AstarlIslands/AI21/SpiderImmobilizingWeb/ImmobilizingWebProjectileR5.(ProjectileResource).xdb" />
                                    </projectileData>
                                    <pool href="/Mechanics/Spells/AstarlIslands/AI23/BootsmanWhirlwind/PuddlesPool.(SummonPool).xdb" />
                                </Item>
                            </impacts>
                            <tick>400</tick>
                        </Item>
                    </effectsIf>
                    <effectsElse>
                        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                            <destination type="gameMechanics.map.destination.DestinationModified">
                                                <destination type="gameMechanics.map.destination.DestinationModified">
                                                    <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                                        <base type="gameMechanics.map.destination.SelfPosDestination" />
                                                        <offset>2</offset>
                                                    </destination>
                                                    <modifiers>
                                                        <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                            <verticalRange min="0" max="1" />
                                                            <horizontalRange min="0" max="0.5" />
                                                        </Item>
                                                    </modifiers>
                                                </destination>
                                                <modifiers>
                                                    <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                                                </modifiers>
                                            </destination>
                                        </moveType>
                                        <resource href="/Mechanics/Spells/AstarlIslands/AI21/SpiderImmobilizingWeb/ImmobilizingWebProjectile.(ProjectileResource).xdb" />
                                    </projectileData>
                                    <pool href="/Mechanics/Spells/AstarlIslands/AI23/BootsmanWhirlwind/PuddlesPool.(SummonPool).xdb" />
                                </Item>
                            </impacts>
                            <tick>666</tick>
                        </Item>
                    </effectsElse>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.15</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.3</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMapWideReplicated" />
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>