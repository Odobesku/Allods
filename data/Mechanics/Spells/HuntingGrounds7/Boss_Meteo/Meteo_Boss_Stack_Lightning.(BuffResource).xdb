	</Header>
	<Name href="Meteo_Boss_Stack_Lightning.(BuffResource).Name.txt" />
	<Description href="Meteo_Boss_Stack_Lightning.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Mage/MageLightningArrow.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectStackTrigger">
			<count>30</count>
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>2</multiplier>
					</durationScaler>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>6</radius>
							<affectGroup>Friends</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="Meteo_Boss_Stack_Lightning.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
											<element>LIGHTNING</element>
											<offenderCalcer type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
											<damage>37</damage>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
											<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
											<data href="/Spells/ClientData/ChainLightning_Druid.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
											<calcers>
												<addressEntries>
													<Item>
														<name>caster</name>
														<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
													</Item>
													<Item>
														<name>target</name>
														<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
													</Item>
												</addressEntries>
											</calcers>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
						</Item>
					</impacts>
					<tick>1000</tick>
				</Item>
			</effects>
		</Item>
	</effects>
	<duration>3000</duration>
	<stackLimit>30</stackLimit>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
