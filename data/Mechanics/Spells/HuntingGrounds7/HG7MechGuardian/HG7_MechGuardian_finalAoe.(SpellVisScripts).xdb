<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="HG7_MechGuardian_FinalAoeDecal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="HG7_MechGuardian_FinalAoe.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>2</scale>
							</Item>
						</visualEffects>
					</Item>
					<Item type="ShakeAction">
						<params href="HG7_MechGuardian_shake.(CameraShakeParameters).xdb#xpointer(/CameraShakeParameters)" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
