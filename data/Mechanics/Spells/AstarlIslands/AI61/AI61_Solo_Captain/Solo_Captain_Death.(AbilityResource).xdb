<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>188831</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>AI61_BridgeGate1</scriptID>
                        <map href="/Maps/AstralIsle61/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Open</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="/Maps/AstralIsle61/AI61_CaptainDeath.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <summand>1</summand>
                </Item>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="/Maps/AstralIsle61/AI61_Boss01Death.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <summand>1</summand>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Mechanics/Spells/AstarlIslands/AI61/AI61_Commoners/AI61_Captain_Combat.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactMobChat">
                    <msg href="/Mechanics/Spells/AstarlIslands/AI61/AI61_Commoners/AI61_Captain_Combat.(TextMessage).xdb#xpointer(/gameMechanics.world.TextMessage)" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                            <variableResource href="/Maps/AstralIsle61/AI61_Boss1Pack_06.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                            <expectedValue type="gameMechanics.elements.calcers.FloatData">
                                <value>3</value>
                            </expectedValue>
                        </Item>
                        <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                            <variableResource href="/Maps/AstralIsle61/AI61_Boss1Pack_04.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                            <expectedValue type="gameMechanics.elements.calcers.FloatData">
                                <value>3</value>
                            </expectedValue>
                        </Item>
                        <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                            <variableResource href="/Maps/AstralIsle61/AI61_Boss1Pack_05.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                            <expectedValue type="gameMechanics.elements.calcers.FloatData">
                                <value>4</value>
                            </expectedValue>
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.AttachAbility">
                            <ability href="Captain_Bubble.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        </Item>
                    </impactsElse>
                </Item>
            </onLeave>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>