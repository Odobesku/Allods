			<instantiateOnUse>false</instantiateOnUse>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>5</radius>
					<affectGroup>Enemies</affectGroup>
					<affectHolder>false</affectHolder>
					<impacts>
						<Item type="gameMechanics.elements.impacts.PostponedImpacts">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateNot">
											<predicate type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
											</predicate>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
											<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
												<multiplier var="value" />
											</durationScaler>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactClientData">
											<data href="/Mechanics/Spells/Priest63/Spells/Intervention/BuffCD.(ClientData).xdb" />
										</Item>
									</impactsIf>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="InterventionAE.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
	<ranks>
