<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>227057</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="TrapWarningBuffProt.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/LethalTrap.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="TrapWarningBuffProt.(BuffResource).NameTemplate.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="AddPlane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                    <object hrefvar="object" />
                    <pool href="LihoSummons.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff hrefvar="buff" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Jump</Item>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Rooted</Item>
            </actions>
        </Item>
    </effects>
    <duration>3000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>