<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.CreatureChangeVisItemsAction">
    <items>
      <Item>
        <slot>MAINHAND</slot>
      </Item>
      <Item>
        <slot>OFFHAND</slot>
      </Item>
      <Item>
        <newItem href="/Items/VisualItems/Armor/Leather_A_18OrcWarriorArmor.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
        <slot>ARMOR</slot>
      </Item>
      <Item>
        <newItem href="/Items/VisualItems/Belt/Leather_A_18OrcWarriorBelt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
        <slot>BELT</slot>
      </Item>
      <Item>
        <newItem href="/Items/VisualItems/Boots/Leather_A_18OrcWarriorBoots.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
        <slot>BOOTS</slot>
      </Item>
      <Item>
        <slot>MANTLE</slot>
      </Item>
      <Item>
        <newItem href="/Items/VisualItems/Pants/Leather_A_18OrcWarriorPants.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
        <slot>PANTS</slot>
      </Item>
      <Item>
        <slot>RANGED</slot>
      </Item>
      <Item>
        <newItem href="/Items/VisualItems/Gloves/Leather_A_18OrcWarriorGloves.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
        <slot>GLOVES</slot>
      </Item>
    </items>
    <isGfxCondition>false</isGfxCondition>
    <leaveWeapons>true</leaveWeapons>
    <notForDolls>false</notForDolls>
    <removeAllItems>true</removeAllItems>
  </action>
  <restartOnIncStackCount>true</restartOnIncStackCount>
</BuffVisScripts>