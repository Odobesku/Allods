                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                <delay>1000</delay>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                                        <spell href="Boss03_SelfBurn.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </finishImpacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>