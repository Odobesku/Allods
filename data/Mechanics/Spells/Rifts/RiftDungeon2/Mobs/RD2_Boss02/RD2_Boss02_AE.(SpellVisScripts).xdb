<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Architect_Swarm_Avatar_Instable.(VisObjectTemplate).xdb" />
						<locator>Slot_Mouth</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/AOEAura_Red_R5.(VisObjectTemplate).xdb" />
						<useCastPoint>true</useCastPoint>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Mobs/ArchitectMinibossCombo_Projectile_01.(VisObjectTemplate).xdb" />
				<explosionFx href="/Spells/FX/Mobs/Architect_Explosion_R5.(VisObjectTemplate).xdb" />
				<theGe>6</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Mouth</locator>
				</pointOnCaster>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
