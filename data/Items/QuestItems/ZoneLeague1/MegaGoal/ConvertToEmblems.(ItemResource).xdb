<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>472708</resourceId>
    </Header>
    <image href="/Interface/Icons/Equipment/Mace/Mace08.chn.(UISingleTexture).xdb" />
    <canBeDeposited>false</canBeDeposited>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseOnItemAndTakeActions">
        <multipleUse>true</multipleUse>
        <highlightPredicate type="gameMechanics.elements.item.ItemPredicateOr">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.item.ItemPredicateOneOf">
                    <items>
                        <Item href="/Items/Agents/Ama_70.(ItemResource).xdb" />
                    </items>
                </Item>
                <Item type="gameMechanics.elements.item.ItemPredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.item.ItemPredicateLevel">
                            <range>
                                <min>65</min>
                                <max>65</max>
                            </range>
                        </Item>
                        <Item type="gameMechanics.elements.item.ItemPredicateEnchant" />
                        <Item type="gameMechanics.elements.item.ItemPredicateQualityGreaterOrEqual">
                            <quality href="/Mechanics/ItemQualities/Uncommon.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.item.ItemPredicateNot">
                            <predicate type="gameMechanics.elements.item.ItemPredicateQuality">
                                <quality href="/Mechanics/ItemQualities/Legendary.xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                </Item>
                <Item type="gameMechanics.elements.item.ItemPredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.item.ItemPredicateQuality">
                            <quality href="/Mechanics/ItemQualities/Relic.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.item.ItemPredicateLevel">
                            <range>
                                <min>65</min>
                                <max>65</max>
                            </range>
                        </Item>
                    </predicates>
                </Item>
            </predicates>
        </highlightPredicate>
        <usages>
            <Item>
                <itemPredicate type="gameMechanics.constructor.schemes.item.ItemPredicateOneOf">
                    <items>
                        <Item href="/Items/Agents/Ama_70.(ItemResource).xdb" />
                    </items>
                </itemPredicate>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="EmblemOfGreatness.(ItemResource).xdb" />
                        </item>
                    </Item>
                </actions>
                <consumeUsedItem>0</consumeUsedItem>
                <consumeTargetItem>1</consumeTargetItem>
            </Item>
        </usages>
        <useStack>true</useStack>
    </functionalPart>
    <quality href="/Mechanics/ItemQualities/Goods.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <ownershipLimit>1</ownershipLimit>
    <binding>BindOnPickup</binding>
    <name href="ConvertToEmblems.(ItemResource).Name.txt" />
    <description href="ConvertToEmblems.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/Quest.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>