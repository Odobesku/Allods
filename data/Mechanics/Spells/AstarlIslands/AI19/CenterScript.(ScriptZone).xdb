<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
	<Header>
		<resourceId>739890943</resourceId>
	</Header>
	<filter type="gameMechanics.world.creature.AvatarFilter" />
	<conditionsIn>
		<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
	</conditionsIn>
	<impactsIn>
		<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
			<predicates>
				<Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
					<variableResource href="MapVariables/EarthBoss.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
					<expectedValue type="gameMechanics.elements.calcers.FloatData">
						<value>0</value>
					</expectedValue>
				</Item>
			</predicates>
			<impactsIf>
				<Item type="gameMechanics.elements.impacts.ImpactIsolator">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
							<affectPets>false</affectPets>
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="SpecialBuffs/KillGuards.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsIf>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="MagicPoison/MagicPoisonBuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</predicates>
			<impactsIf>
				<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
					<spell href="MagicPoison/SnakeBlink.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
				</Item>
			</impactsIf>
		</Item>
	</impactsIn>
</gameMechanics.map.scriptZone.ScriptZone>
