<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739911180</resourceId>
	</Header>
	<Name href="Werewolf_jump.(SpellArea).Name.txt" />
	<visualScripts href="Werewolf_jump.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>30</value>
	</range>
	<prepareDuration>1000</prepareDuration>
	<targetType>STTPoint</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>12000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
				<mobs>
					<Item href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Boss01/AI63_Boss01_Werewolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
					<Item href="AI63_Pack_Werewolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
				</mobs>
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateFaction">
					<faction href="/World/Factions/Astral_Islands/AI63_Vampires.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
				</predicate>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
				<time>1000</time>
				<impactsOnLand>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<radius>6</radius>
						<affectGroup>Enemies</affectGroup>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
								<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
								<minDamage>30</minDamage>
								<maxDamage>30</maxDamage>
							</Item>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="Werewolf_jumpDoT.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</impacts>
						<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateOr">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</predicates>
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
							</predicates>
						</filter>
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
						<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
						<data href="Werewolf_jumpEnd.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					</Item>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="Werewolf_jump_stop.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</impactsOnLand>
				<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
			</Item>
		</casterImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
