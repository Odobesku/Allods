<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>207350</resourceId>
    </Header>
    <name href="HeavenlyDotProlong.(AbilityResource).Name.txt" />
    <description href="HeavenlyDotProlong.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/Exorcism.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <targetImpacts>
                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIncrementBuffDuration">
                            <buff href="/Mechanics/Spells/Priest63/Spells/HeavenlyStrike/HeavenlyStrike.(BuffResource).xdb" />
                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>1000</value>
                            </delta>
                        </Item>
                    </impacts>
                </Item>
            </targetImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/Priest63/Spells/HolyOrb/Spell01.(SpellSingleTarget).xdb" />
                    <Item href="/Mechanics/Spells/Priest63/Spells/Retribution/Spell01.(SpellSingleTarget).xdb" />
                    <Item href="/Mechanics/Spells/Priest63/Spells/RetributionUpgrade/Spell01.(SpellSingleTarget).xdb" />
                </spells>
            </destination>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                    <spells>
                        <Item href="/Mechanics/Spells/Priest63/Spells/HeavenlyStrike/Spell01.(SpellArea).xdb" />
                    </spells>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                <coeff>0.1</coeff>
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>