<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739858214</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <range>500</range>
            <cooldown />
            <damageType />
            <clientData />
        </Variables>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/AstralCannons.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value var="range" />
    </range>
    <prepareDuration>0</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <descVars>
        <Item>
            <name>damage</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.OnItemCalcer">
                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                        <name>damage_aoe</name>
                    </calcer>
                    <source type="gameMechanics.elements.item.ItemPart" />
                </mulCalcer>
            </scaler>
        </Item>
        <Item>
            <name>range</name>
            <value var="range" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaUndefined</formula>
            </scaler>
        </Item>
        <Item>
            <name>cooldown</name>
            <value var="cooldown" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaSeconds</formula>
            </scaler>
        </Item>
        <Item>
            <name>energy</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.OnItemCalcer">
                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                        <name>energy_aoe</name>
                    </calcer>
                    <source type="gameMechanics.elements.item.ItemPart" />
                </mulCalcer>
            </scaler>
        </Item>
        <Item>
            <name>damage2</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.OnItemCalcer">
                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                        <name>damage2</name>
                    </calcer>
                    <source type="gameMechanics.elements.item.ItemPart" />
                </mulCalcer>
            </scaler>
        </Item>
        <Item>
            <name>damage3</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.OnItemCalcer">
                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                        <name>damage3</name>
                    </calcer>
                    <source type="gameMechanics.elements.item.ItemPart" />
                </mulCalcer>
            </scaler>
        </Item>
        <Item>
            <name>energy2</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.OnItemCalcer">
                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                        <name>energy2</name>
                    </calcer>
                    <source type="gameMechanics.elements.item.ItemPart" />
                </mulCalcer>
            </scaler>
        </Item>
        <Item>
            <name>energy3</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.OnItemCalcer">
                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                        <name>energy3</name>
                    </calcer>
                    <source type="gameMechanics.elements.item.ItemPart" />
                </mulCalcer>
            </scaler>
        </Item>
    </descVars>
    <mechanics type="gameMechanics.constructor.schemes.spell.SpellMechanics">
        <cooldown>
            <duration>1</duration>
            <group href="/Mechanics/Spells/Groups/AstralCannons.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier var="cooldown" />
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.world.device.LinearMalfunctionCalcer">
                            <treshold>0.75</treshold>
                            <b>1</b>
                            <value>1</value>
                        </mulCalcer>
                    </Item>
                </scalers>
            </scaler>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.world.device.cannon.DeviceHasUser" />
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAstralMob" />
                    <Item type="gameMechanics.world.ship.elements.PredicateIsShip" />
                </predicates>
            </Item>
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.world.ship.elements.ResourceEnergy">
                <energy type="gameMechanics.elements.calcers.CalcerMul">
                    <calcers>
                        <Item type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </Item>
                        <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                <name>energy_aoe</name>
                            </calcer>
                            <source type="gameMechanics.elements.item.ItemPart" />
                        </Item>
                    </calcers>
                </energy>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                <data href="/Mechanics/Ships/Cannon/CannonAttack.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
            <Item type="gameMechanics.world.device.cannon.ImpactSendLaunchEvent">
                <clientData hrefvar="clientData" />
                <targetDestination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierShiftForward">
                            <radius type="gameMechanics.elements.calcers.FloatData">
                                <value var="range" />
                            </radius>
                        </Item>
                    </modifiers>
                </targetDestination>
            </Item>
            <Item type="gameMechanics.elements.impacts.ProbabilisticImpactGeneric">
                <chanceCalcer type="gameMechanics.elements.calcers.CalcerSum">
                    <summands>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value>-1</value>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="gameMechanics.elements.calcers.HealthInferiorityCalcer" />
                                        <Item type="gameMechanics.elements.calcers.FloatData">
                                            <value>0.5</value>
                                        </Item>
                                    </calcers>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.FloatData">
                                    <value>3</value>
                                </Item>
                            </calcers>
                        </Item>
                    </summands>
                </chanceCalcer>
                <impacts>
                    <Item type="gameMechanics.world.ship.elements.ImpactEnergyHit">
                        <amount type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="externalCalcer" />
                                </Item>
                                <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                        <name>energy_aoe</name>
                                    </calcer>
                                    <source type="gameMechanics.elements.item.ItemPart" />
                                </Item>
                            </calcers>
                        </amount>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                        <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceUser" />
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                <data href="/Mechanics/Ships/Cannon/CannonEnergyBurst.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactAvatarFinishUse" />
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                        <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceLinkedTo" />
                        <impacts>
                            <Item type="gameMechanics.world.device.cannon.ImpactCannonDamage">
                                <damage type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="gameMechanics.elements.calcers.FloatData">
                                            <value>0.5</value>
                                        </Item>
                                        <Item type="gameMechanics.elements.calcers.CalcerMul">
                                            <calcers>
                                                <Item type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer hrefvar="externalCalcer" />
                                                </Item>
                                                <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                                                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                                        <name>damage_aoe</name>
                                                    </calcer>
                                                    <source type="gameMechanics.elements.item.ItemPart" />
                                                </Item>
                                            </calcers>
                                        </Item>
                                    </calcers>
                                </damage>
                                <damageType var="damageType" />
                                <hitCalcType type="gameMechanics.world.projectile.StaticCalcType" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                <predicates>
                    <Item type="gameMechanics.world.ship.elements.PredicateIsShip" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.world.device.cannon.ImpactCannonDamage">
                        <damage type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="externalCalcer" />
                                </Item>
                                <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                        <name>damage_aoe</name>
                                    </calcer>
                                    <source type="gameMechanics.elements.item.ItemPart" />
                                </Item>
                            </calcers>
                        </damage>
                        <damageType var="damageType" />
                        <hitCalcType type="gameMechanics.world.projectile.CannonCalcType" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactBunchesAround">
                        <radius>120</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.world.device.cannon.ImpactCannonDamage">
                                <damage type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="constructor.elements.CalcerFloatExternal">
                                            <externalCalcer hrefvar="externalCalcer" />
                                        </Item>
                                        <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                                            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                                <name>damage_aoe</name>
                                            </calcer>
                                            <source type="gameMechanics.elements.item.ItemPart" />
                                        </Item>
                                    </calcers>
                                </damage>
                                <damageType var="damageType" />
                                <hitCalcType type="gameMechanics.world.projectile.CannonCalcType" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.astralMob.AstralMobFilter" />
                    </Item>
                </impactsElse>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>50</speed>
    <stopOnNoTargets>false</stopOnNoTargets>
    <autotargetSelector type="gameMechanics.constructor.schemes.spell.multiTarget.ClosestAutotarget">
        <group>Enemies</group>
    </autotargetSelector>
    <shape type="gameMechanics.constructor.schemes.spell.area.Ray">
        <objectsProvider>ClientSelected</objectsProvider>
    </shape>
    <shapeOrientation type="gameMechanics.elements.common.ShapeOrientationYawAndPitch" />
    <radius var="range" />
    <useAverageThrowDuration>true</useAverageThrowDuration>
</gameMechanics.constructor.schemes.spell.area.SpellArea>