<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>Expand</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <Size>50</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <Size>20</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing></reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_DEFAULT</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag>value</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/EventCalendar/textures/EventDetailedViewDescriptionExpandHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="1"/>
            <Reaction>expand_press</Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/EventCalendar/EventDetailedViewDescriptionExpandFormat.txt"/>
                <LayerMain href="/Interface/Ingame/EventCalendar/textures/ExpandBack.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/EventCalendar/EventDetailedViewDescriptionExpand.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <LayerHighlight href="/Interface/Ingame/EventCalendar/textures/EventDetailedViewDescriptionExpandHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="1"/>
            <Reaction>expand_press</Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/EventCalendar/EventDetailedViewDescriptionExpandFormat.txt"/>
                <LayerMain href="/Interface/Ingame/EventCalendar/textures/ExpandBack.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/EventCalendar/EventDetailedViewDescriptionRollUp.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
