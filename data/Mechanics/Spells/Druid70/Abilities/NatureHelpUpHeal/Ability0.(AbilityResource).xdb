<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739923264</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="coeff" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Special/Alchemy/Healing.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                    <spells>
                        <Item href="/Mechanics/Spells/Druid70/Spells/NaturalHelp/Spell01.(SpellSingleTarget).xdb" />
                    </spells>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.OutgoingHealModifier">
                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                <coeff var="coeff" />
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="/Mechanics/Spells/Druid70/Abilities/NatureHelpUpHeal/AddTargets.(MarkResource).xdb" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>20</radius>
                    <affectGroup>Group</affectGroup>
                    <conditions>
                        <Item type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                                <buff href="/Mechanics/Spells/Druid70/Spells/NaturalHelp/Checker.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                    </conditions>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactHeal">
                                    <heal>1</heal>
                                    <scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                            <externalCalcer hrefvar="externalCalcer" />
                                        </mulCalcer>
                                        <additionalMultiplier>
                                            <scaler type="gameMechanics.elements.scalers.HealScaler" />
                                        </additionalMultiplier>
                                    </scalerCaster>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/Druid70/Spells/NaturalHelp/Checker.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AliveFilter" />
                    <targetsLimit>2</targetsLimit>
                    <sorting type="gameMechanics.elements.targetSelector.sorts.SortByHealthInjury" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>