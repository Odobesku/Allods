<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <PreCastAnimation>channelCastDirectedEngineer</PreCastAnimation>
            <LocatorOnTargets>Slot_FX</LocatorOnTargets>
            <CastAnimation>spellCastOmniEngineer</CastAnimation>
            <FXOnTargets />
            <FixPointCaster>false</FixPointCaster>
            <FixPointTarget>true</FixPointTarget>
            <LocatorOnCaster>Slot_TopFX</LocatorOnCaster>
            <FXOnCaster />
            <AnimationPreCastMode>LOOP</AnimationPreCastMode>
            <LocatorNameOnCaster />
            <FxOnHands />
            <HitPostFXOnTargets />
            <LocatorNameOnTargets />
        </Variables>
    </Header>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <advanced>
                    <speed>1.16</speed>
                </advanced>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>200</delay>
                        <effectFx href="/Spells/FX/Spells/Engineer_BarrelShot_MainMini.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fadeInTime>333</fadeInTime>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <advanced>
                    <speed>1.16</speed>
                </advanced>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <delay>333</delay>
                                <effectFx hrefvar="FXOnCaster" />
                                <fixPoint var="FixPointCaster" />
                                <scale>1.6</scale>
                                <locator var="LocatorOnCaster" />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>