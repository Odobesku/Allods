                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/World/Quests/Ferris_indoor/Ferris_3_6_1/Gerbert_visiblity.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                    <id href="/World/Quests/Ferris4/Ferris_4_start/CountId_2.xdb" />
