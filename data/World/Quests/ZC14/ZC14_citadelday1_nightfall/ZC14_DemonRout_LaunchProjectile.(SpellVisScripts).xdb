<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
  <actionBarStart type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.VisActionDelay">
            <time>500</time>
          </Item>
          <Item type="client.Replica.VisActionLoopAction">
            <actionToLoop type="client.Replica.VisActionList">
              <elements>
                <Item type="client.Replica.CreatureFixedTimeProjectileAction">
                  <explosionFx href="/Spells/FX/Spells/HitAstral.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                  <offendTime type="client.Replica.EffectOffendConstDelay">
                    <delay>0</delay>
                  </offendTime>
                  <optionalSpeed>15</optionalSpeed>
                  <pointOnCaster type="client.Replica.VisPointLocator">
                    <shift x="0" y="0" z="0" />
                    <from>FROM_DEFALUT</from>
                    <locator>FROM_LOCATOR_NAME</locator>
                    <locatorName>RightHand</locatorName>
                    <member>Default_Member</member>
                  </pointOnCaster>
                  <pointOnTarget type="client.Replica.VisPointLocator">
                    <shift x="0" y="0" z="0" />
                    <from>FROM_DEFALUT</from>
                    <locator>Slot_Head</locator>
                    <member>Default_Member</member>
                  </pointOnTarget>
                  <projectileFx href="/Spells/FX/Spells/AstralToxin.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                  <theGe>1.5</theGe>
                  <dontFade>false</dontFade>
                  <isInverted>false</isInverted>
                  <isMultyProjectile>true</isMultyProjectile>
                  <count>0</count>
                  <throwDuration>1</throwDuration>
                  <waitDuration>500</waitDuration>
                </Item>
              </elements>
              <play>InSequence</play>
              <playWhile type="client.Replica.VisActionDelay">
                <time>500</time>
              </playWhile>
              <preconditional>false</preconditional>
              <restartOnVisualChange>false</restartOnVisualChange>
              <stopOnDeath>false</stopOnDeath>
              <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </actionToLoop>
            <repeat>20</repeat>
            <totalTime>0</totalTime>
          </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </actionBarStart>
  <precastType>PRECAST_DEFAULT</precastType>
  <ownKillingParams>
    <probabilityNoOverkill>0.2</probabilityNoOverkill>
    <probabilityWithOverkill>1</probabilityWithOverkill>
  </ownKillingParams>
  <playOnTargets>
    <skipBloodFx>false</skipBloodFx>
    <skipHitAnimations>false</skipHitAnimations>
  </playOnTargets>
  <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>