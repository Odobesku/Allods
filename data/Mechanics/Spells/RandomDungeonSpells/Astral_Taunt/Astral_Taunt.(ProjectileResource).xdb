<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>213313</resourceId>
    </Header>
    <name href="Astral_Taunt.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/PsionicTelekineticThrowAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <radius>10</radius>
            <affectGroup>Enemies</affectGroup>
            <affectHolder>false</affectHolder>
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.EntityImpactsDeferred">
                            <delay>2000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>ASTRAL</element>
                                    <damage>50</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                            <time>1500</time>
                            <destination type="gameMechanics.elements.calcers.DestinationCurrentTarget" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </filter>
        </Item>
    </impactsOnStart>
</gameMechanics.world.projectile.ProjectileResource>