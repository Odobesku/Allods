<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>201393</resourceId>
    </Header>
    <Name href="Buff.(BuffResource).Name.txt" />
    <Description href="Buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Halo/StrengthOfMind.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Druid.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.IncrementManaBase">
                            <manaType>Mana</manaType>
                            <factor>0.03</factor>
                            <threatMultiplier>0</threatMultiplier>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Psionic.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Psionic63/Abilities/StressResource/StressResource.(VariableResource).xdb" />
                            <summand>7</summand>
                            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>-1</multiplier>
                            </scaler>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Stalker.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Stalker63/Abilities/MaterielResource/MaterielResource.(VariableResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Warrior.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAddCombatAdvantage">
                            <value>7</value>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.IncrementMana">
                            <manaType>Energy</manaType>
                            <amount>7</amount>
                            <threatMultiplier>0</threatMultiplier>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Priest.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Priest63/Abilities/Zeal/Faith.(VariableResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Necromancer.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Necromancer70/Abilities/BloodDrops/BloodPool.(VariableResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                    <characterClass href="/Mechanics/Classes/Engineer.xdb" />
                </Item>
            </predicates>
            <effectsIf>
