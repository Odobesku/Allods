<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="CreatureAnimationAction">
            <animations>
                <Item>spellCastDirected</Item>
            </animations>
            <channel>CHANNEL_DEATH</channel>
            <advanced>
                <speed>0.3</speed>
            </advanced>
        </playWhile>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadyAstralSpellPlankton.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                        <scale>1.5</scale>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <actionBarComplite type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Mobs/Shadowbreath_Cleave.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <fixPoint>true</fixPoint>
                <scale>0.5</scale>
            </Item>
        </visualEffects>
    </actionBarComplite>
</SpellVisScripts>