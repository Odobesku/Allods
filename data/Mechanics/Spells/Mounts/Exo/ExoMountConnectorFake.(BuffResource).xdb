    <image href="/Interface/Icons/Mounts/SpellsMounts/Defense.(UISingleTexture).xdb" />
    <visScript href="ExoMountConnectorFake.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ExoMountConnector.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateDistance">
                            <range min="0" max="30" />
                        </predicate>
                    </predicate>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ExoMountConnectorFake.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>1000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.BalanceDamage">
            <casterPart>0.3</casterPart>
            <targetPart>0.7</targetPart>
        </Item>
    </effects>
    <duration>10000</duration>
    <isStackable>false</isStackable>
    <stackLimit>1</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
