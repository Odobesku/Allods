<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739888471</resourceId>
	</Header>
	<Name href="Jump.(SpellArea).Name.txt" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>85</value>
	</range>
	<prepareDuration>3000</prepareDuration>
	<needLos>false</needLos>
	<targetType>STTPoint</targetType>
	<isAggro>false</isAggro>
	<needInFront>false</needInFront>
	<mechanics>
		<cooldown>
			<duration>40000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.resources.ResourceIf">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
					</Item>
				</predicates>
				<resourceIf type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/Rage/Rage_Helper.(BuffResource).xdb" />
				</resourceIf>
				<resourceElse type="gameMechanics.constructor.basicElements.ResourceUniversal" />
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/BattleRoar/Stun.(BuffResource).xdb" />
			</Item>
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
				<time>2000</time>
				<impactsOnLand>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<radius>15</radius>
						<affectGroup>Enemies</affectGroup>
						<affectHolder>false</affectHolder>
						<impacts>
							<Item type="gameMechanics.elements.impacts.DirectDamage">
								<damage>1</damage>
								<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
									<mul>0.5</mul>
									<mulCalcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
										<buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/Rage_DmgBuff.(BuffResource).xdb" />
									</mulCalcer>
									<sum>1</sum>
								</scaler>
								<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
									<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
										<multiplier>0.65</multiplier>
									</mulCalcer>
								</scalerTarget>
							</Item>
							<Item type="gameMechanics.elements.impacts.BuffDetacher">
								<buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/BattleRoar/Stun.(BuffResource).xdb" />
							</Item>
						</impacts>
						<finishImpacts>
							<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
								<impacts>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="/Mechanics/RaidInstances/UmoirRaid/Disabler.(BuffResource).xdb" />
									</Item>
									<Item type="gameMechanics.elements.impacts.BuffDetacher">
										<buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/Rage_DmgBuff.(BuffResource).xdb" />
									</Item>
									<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
										<predicates>
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
											</Item>
										</predicates>
										<impacts>
											<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
												<spell href="Jump.(SpellArea).xdb" />
											</Item>
										</impacts>
									</Item>
									<Item type="gameMechanics.elements.impacts.BuffDetacher">
										<buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/Rage/Rage_Helper.(BuffResource).xdb" />
									</Item>
									<Item type="gameMechanics.elements.impacts.BuffDetacher">
										<buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/Rage_DmgBuff.(BuffResource).xdb" />
									</Item>
								</impacts>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
								<radius>10</radius>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
												<resources>
													<Item href="TargetArea.(ProjectileResource).xdb" />
												</resources>
											</Item>
										</predicates>
										<impactsIf>
											<Item type="gameMechanics.elements.impacts.Disintegrate" />
										</impactsIf>
									</Item>
								</impacts>
							</Item>
						</finishImpacts>
						<filter type="gameMechanics.world.creature.AvatarFilter" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactClientData">
						<data href="JumpAOE.(ClientData).xdb" />
					</Item>
				</impactsOnLand>
				<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
				<keepOnGround>false</keepOnGround>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
					</Item>
				</predicates>
				<elseImpacts>
					<Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
						<spell href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/BattleRoar/BattleRoar.(SpellArea).xdb" />
						<duration>8000</duration>
					</Item>
				</elseImpacts>
			</Item>
		</casterImpacts>
	</mechanics>
	<radius>0</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
