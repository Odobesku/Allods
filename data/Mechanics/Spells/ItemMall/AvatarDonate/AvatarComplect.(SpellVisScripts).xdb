<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<Animation>useStandingLoop</Animation>
			<FXEndUse>/Spells/FX/Spells/LevelUp_Guild.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXEndUse>
			<LocatorFXEndUse>Slot_Global</LocatorFXEndUse>
			<FxUse>/Spells/FX/Spells/AvatarComplect_LevelUp_FX_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxUse>
			<LocatorFXUse>Slot_Global</LocatorFXUse>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>useStandingStart</Item>
					<Item var="Animation" />
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FxUse" />
						<effectAlias href="" />
						<scale>0.7</scale>
						<locator var="LocatorFXUse" />
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FXEndUse" />
						<effectAlias href="" />
						<scale>1</scale>
						<locator var="LocatorFXEndUse" />
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>levelUp</Item>
				</animations>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
