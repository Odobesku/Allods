				<playOnRiderTop>readyEngineer</playOnRiderTop>
				<playOnRiderBottom>readyEngineer</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>channelCastDirectedEngineer</animation>
				<playOnRiderTop>channelCastDirectedEngineer</playOnRiderTop>
				<playOnRiderBottom>channelCastDirectedEngineer</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
