<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/OmniNoWand.(SpellVisScripts).xdb" />
		<Variables>
			<PreCastFX />
			<FXOnCaster />
			<PreCastAnimation />
			<CastAnimation>jumpAttack</CastAnimation>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>jumpAttackStart</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Ready_HowlingStrike.(VisObjectTemplate).xdb" />
						<scale>1.2</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
					<name>spells/FX/Spells/HowlingStrike/HowlingStrikeReady</name>
				</sound>
				<alias href="" />
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item />
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2500</time>
		</playWhile>
		<elements>
			<Item skiped="" />
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Maze_HowlingStrike.(VisObjectTemplate).xdb" />
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
					<name>spells/FX/Spells/HowlingStrike/HowlingStrikeMaze</name>
				</sound>
			</Item>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>jumpAttack</play>
							<forAnimations>
								<Item>jump</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpAttackStart</play>
							<forAnimations>
								<Item>jumpStart</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>groundStrike</play>
							<forAnimations>
								<Item>jumpEnd</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>jumpAttack</play>
							<forAnimations>
								<Item>jump</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpAttackStart</play>
							<forAnimations>
								<Item>jumpStart</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>groundStrike</play>
							<forAnimations>
								<Item>jumpEnd</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
				<priority href="" />
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item skiped="" />
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
