<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739876840</resourceId>
	</Header>
	<Name href="Pulled.(BuffResource).Name.txt" />
	<Description href="Pulled.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Necromancer/NecromancerDarkPower.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectPull">
			<puller type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
			<speedFactor type="gameMechanics.elements.calcers.FloatData">
				<value>1</value>
			</speedFactor>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobNear">
							<radius>14</radius>
							<mobs>
								<Item href="LihoTrap4.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							</mobs>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactTeleport">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>LihoBossTrap4</scriptID>
									<map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
								</locator>
							</destination>
							<finishImpacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Trap_01_Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</finishImpacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="/Mechanics/RaidInstances/UmoirRaid/5_ReactorBoss/ReactorBoss_Projectile_drags.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					<calcers>
						<addressEntries>
							<Item>
								<name>target</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
							</Item>
							<Item>
								<name>caster</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
							</Item>
						</addressEntries>
					</calcers>
				</Item>
			</impacts>
			<tick>1200</tick>
		</Item>
	</effects>
	<duration>300000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
