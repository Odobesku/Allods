            <predicates>
                <!-- <Item type="gameMechanics.elements.predicates.offender.PredicateNot"> -->
                <!-- <predicate type="gameMechanics.elements.predicates.offender.PredicateOffenderIsCaster" /> -->
                <!-- </Item> -->
            </predicates>
            <impacts>
                <casterToTarget />
                <casterToOffender>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <hideText>false</hideText>
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateInCombat">
                                        <hideText>false</hideText>
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <hideText>false</hideText>
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <hideText>false</hideText>
                                            <buff href="Exo6PassiveDamageCD.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <anyRank>true</anyRank>
                                            <consumeStacks>0</consumeStacks>
                                        </predicate>
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                            <value>0.25</value>
                                        </chanceCalcer>
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="Exo6PassiveDamage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="Exo6PassiveDamageCD.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsIf>
                    </Item>
                </casterToOffender>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Exo6PassiveDamageCD.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Exo6PassiveDamage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
