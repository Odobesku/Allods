<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739852073</resourceId>
	</Header>
	<Name href="Extinguisher.(BuffResource).Name.txt" />
	<Description href="Extinguisher.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Quest/ColdChains.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/World/Mega_War_Raid_Turel_Ice_BallBlue.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
			<scale>1.1</scale>
			<locator>Slot_FX</locator>
		</Item>
	</visualEffects>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>1000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Extinguisher.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacherStackRange">
					<buff href="NoCold.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					<range>
						<min>1</min>
						<max>2</max>
					</range>
				</Item>
			</impacts>
			<tick>1500</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectAddContextActions">
			<actions>
				<Item href="Extinguisher.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
				<Item href="ExtinguisherDetach.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ReturningImpact">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactSummon">
													<destination type="gameMechanics.map.destination.SelfPosDestination" />
													<traceDown>true</traceDown>
													<object href="Goblin/GoblinBomb.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
													<pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
												</Item>
												<Item type="gameMechanics.elements.impacts.BuffDetacher">
													<buff href="Extinguisher.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
												</Item>
											</impacts>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
							<spawnResource href="Smeyana_LandingBoss.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
	<duration>60000</duration>
	<isHelpful>true</isHelpful>
	<canBeSaved>true</canBeSaved>
	<groups>
		<Item href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
