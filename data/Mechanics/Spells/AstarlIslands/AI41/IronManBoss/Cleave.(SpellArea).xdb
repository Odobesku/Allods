<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739869800</resourceId>
	</Header>
	<Name href="Cleave.(SpellArea).Name.txt" />
	<visualScripts href="Cleave.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<nameTemplate href="Cleave.(SpellArea)_Name.txt.template" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>10</value>
	</range>
	<prepareDuration>2400</prepareDuration>
	<targetType>STTPoint</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>8000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</predicates>
			</Item>
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
				<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
				<data href="/Mechanics/Spells/AstarlIslands/AI19/EarthElementalGroundSlam/HitTarget.xdb#xpointer(/gameMechanics.world.ClientData)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
				<time>1000</time>
				<distance>1</distance>
			</Item>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="Cleave_Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
						<impactsOnHitTarget>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="Whirlwind2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								<stacks type="gameMechanics.elements.calcers.FloatData">
									<value>2</value>
								</stacks>
							</Item>
						</impactsOnHitTarget>
						<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
						<minDamage>75</minDamage>
						<maxDamage>75</maxDamage>
					</Item>
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Cone">
		<angle type="constructor.basicElements.AngleDegrees">
			<value>45</value>
		</angle>
	</shape>
	<radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
