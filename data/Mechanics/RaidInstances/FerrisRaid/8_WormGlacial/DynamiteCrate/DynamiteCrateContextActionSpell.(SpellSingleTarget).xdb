<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739900135</resourceId>
	</Header>
	<Name href="DynamiteCrateContextActionSpell.(SpellSingleTarget).Name.txt" />
	<Description href="DynamiteCrateContextActionSpell.(SpellSingleTarget).Description.txt" />
	<image href="/Interface/Icons/Misc/Quest/BlockOfDynamite.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Mage/ShockingGrasp.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>5</value>
	</range>
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<modifiers>
		<Item type="gameMechanics.elements.spell.RaiseRepelType" />
	</modifiers>
	<iffPolicy>Friends</iffPolicy>
	<needInFront>false</needInFront>
	<mechanics>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateMobNear">
						<radius>5</radius>
						<mobs>
							<Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormHole/WormHole.(MobWorld).xdb" />
						</mobs>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<radius>5</radius>
						<impacts>
							<Item type="gameMechanics.elements.impacts.DirectDamage">
								<damage>1</damage>
								<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
									<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
										<multiplier>0.201</multiplier>
									</mulCalcer>
								</scalerTarget>
							</Item>
							<Item type="gameMechanics.elements.impacts.ReturningImpact">
								<impacts>
									<Item type="gameMechanics.elements.impacts.BuffDetacher">
										<buff href="DynamiteCrateContextActionBuff.(BuffResource).xdb" />
									</Item>
								</impacts>
							</Item>
						</impacts>
						<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
									<mobs>
										<Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormHole/WormHole.(MobWorld).xdb" />
									</mobs>
								</Item>
							</predicates>
						</filter>
					</Item>
				</impactsIf>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
