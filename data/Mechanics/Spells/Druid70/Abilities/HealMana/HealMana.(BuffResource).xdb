<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>214772</resourceId>
    </Header>
    <Name href="HealMana.(BuffResource).Name.txt" />
    <Description href="HealMana.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/PetModePassive.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="HealMana.(BuffResource).xdb" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="HealMana.(BuffResource).xdb" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsToPet">
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMaster">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.IncrementMana">
                                                    <manaType>Mana</manaType>
                                                    <amount>1</amount>
                                                    <threatMultiplier>0</threatMultiplier>
                                                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                        <mulCalcer type="gameMechanics.elements.calcers.FullManaCalcer">
                                                            <multiplier>0.1</multiplier>
                                                        </mulCalcer>
                                                    </scaler>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="HealMana.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </conditionalImpacts>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>