<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739895099</resourceId>
	</Header>
	<Name href="NetTrap.(SpellArea).Name.txt" />
	<visualScripts href="NetTrap.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>60</value>
	</range>
	<prepareDuration>3200</prepareDuration>
	<needLos>false</needLos>
	<mechanics>
		<cooldown>
			<duration>10000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="Net.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</predicate>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
				<projectileData>
					<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
					<resource href="Trap.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
				</projectileData>
				<pool href="Pool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
				<delay>3000</delay>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<affectHolder>false</affectHolder>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
							<Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
						</impacts>
						<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
									<mobs>
										<Item href="AviakBoss_add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									</mobs>
								</Item>
							</predicates>
						</filter>
					</Item>
				</impacts>
			</Item>
		</targetImpacts>
	</mechanics>
	<maxTargets>3</maxTargets>
	<radius>60</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
