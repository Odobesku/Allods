<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739920240</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Paladin/PaladinShield.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/LimitOfFaith.(VisObjectTemplate).xdb" />
            <scale>1.4</scale>
            <fadeInTime>300</fadeInTime>
            <fadeOutTime>300</fadeOutTime>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.DamageThreshold">
            <healthCalcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer hrefvar="externalCalcer" />
                            </mulCalcer>
                        </Item>
                        <Item type="gameMechanics.elements.scalers.ScalerExternal">
                            <scalerResource href="/Mechanics/SpecialStats/ShieldsScaler.(ScalerResource).xdb" />
                        </Item>
                    </scalers>
                </scaler>
                <value>1</value>
            </healthCalcer>
            <healthScalerTarget type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>0.01</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="/Mechanics/SpecialStats/SpecialCoeffDiv.(CalcerFloatResource).xdb" />
                                </Item>
                                <Item type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="/Mechanics/SpecialStats/HealModifier.(CalcerFloatResource).xdb" />
                                </Item>
                            </calcers>
                        </mulCalcer>
                        <sum>1</sum>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.RuneLethalityScaler" />
                </scalers>
            </healthScalerTarget>
            <outOfCombatPolicy>Nothing</outOfCombatPolicy>
            <ownerDamageFactor type="gameMechanics.elements.calcers.FloatData">
                <value>0</value>
            </ownerDamageFactor>
            <barrierDamageFactor type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </barrierDamageFactor>
            <impacts>
                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.MarkedImpact">
                            <mark href="HolyWordSwitchOff.(MarkResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <scaledByCasterStats>true</scaledByCasterStats>
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ClassChangeBuffs.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>