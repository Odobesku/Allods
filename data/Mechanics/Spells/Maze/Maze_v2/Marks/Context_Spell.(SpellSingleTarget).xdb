<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>198024</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Maze.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <element>SHADOW</element>
    <Name href="Context_Spell.(SpellSingleTarget).Name.txt" />
    <Description href="Context_Spell.(SpellSingleTarget).Description.txt" />
    <prepareDuration>1000</prepareDuration>
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Mark_01Context.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
                        <radius>5</radius>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateProjectile" />
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="Mark_Context.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>