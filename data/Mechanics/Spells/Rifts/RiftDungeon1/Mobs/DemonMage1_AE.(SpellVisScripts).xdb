<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/AOEAura_Red_R4.(VisObjectTemplate).xdb" />
						<useCastPoint>true</useCastPoint>
						<lifeTime>2</lifeTime>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Engineer_Cannon.ProjectilePoison_01.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Spells/HitDemonBlastSmall1.(VisObjectTemplate).xdb" />
						<theGe>6</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Mouth</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>