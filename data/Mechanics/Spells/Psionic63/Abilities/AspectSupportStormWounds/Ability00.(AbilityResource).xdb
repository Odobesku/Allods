<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>220373</resourceId>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/PetCommandAttack.chn.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIf">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                            <onSlave type="gameMechanics.elements.predicates.PredicateHasSpell">
                                <spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Wounds/Wounds1.(SpellSingleTarget).xdb" />
                            </onSlave>
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
                            <mark href="/Mechanics/Spells/Psionic63/Spells/MentalStorm/MentalStorm.(MarkResource).xdb" />
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Wounds/Wounds.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </effectsIf>
                </Item>
                <Item type="gameMechanics.elements.effects.SpellsModifier">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Psionic63/Spells/MentalStorm/Spell03.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </predicates>
                    <modifiers>
                        <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                            <effects>
                                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                        <coeff>0.45</coeff>
                                    </scaler>
                                </Item>
                            </effects>
                            <onBehalfOfHolder>true</onBehalfOfHolder>
                        </Item>
                    </modifiers>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>