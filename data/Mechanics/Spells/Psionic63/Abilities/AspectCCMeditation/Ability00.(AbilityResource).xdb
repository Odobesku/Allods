<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>220367</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="reduction" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value var="speed" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Psionic/PsionicMeditation.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/CC/Buff01.(BuffResource).xdb" />
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.BuffExtraEffects">
                    <buffs>
                        <Item href="/Mechanics/Spells/Psionic63/Spells/Meditation/MeditationBuff.(BuffResource).xdb" />
                    </buffs>
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                <coeff var="reduction" />
                            </scaler>
                        </Item>
                        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
                            <effectScaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                <coeff>-0.01</coeff>
                                <calcer type="gameMechanics.elements.calcers.FloatData">
                                    <value var="speed" />
                                </calcer>
                            </effectScaler>
                        </Item>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/WillPower/WillPower.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>5</multiplier>
                                    </durationScaler>
                                </Item>
                            </impactsOn>
                            <impactsOff>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/WillPower/WillPower.(BuffResource).xdb" />
                                </Item>
                            </impactsOff>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.CastOnMove">
                    <spells>
                        <Item href="/Mechanics/Spells/Psionic63/Spells/Meditation/Spell01.(SpellSingleTarget).xdb" />
                    </spells>
                    <moveTypes>
                        <Item>Step</Item>
                    </moveTypes>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>