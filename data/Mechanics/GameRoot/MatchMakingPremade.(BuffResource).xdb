<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>238862</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateInRaid" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectGroupTrigger">
                    <impactsOnJoin>
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
                    </impactsOnJoin>
                    <impactsOnLeave>
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
                    </impactsOnLeave>
                    <impactsOnMemberJoin>
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
                    </impactsOnMemberJoin>
                    <impactsOnMemberLeave>
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
                    </impactsOnMemberLeave>
                    <ignoreImpactsOnStartStop>true</ignoreImpactsOnStartStop>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectRaidTrigger">
            <impactOnChange>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
            </impactOnChange>
            <impactOnNewLeader>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
            </impactOnNewLeader>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>