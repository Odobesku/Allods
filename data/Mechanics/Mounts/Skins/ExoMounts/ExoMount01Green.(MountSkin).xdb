<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.mount.MountSkin>
    <Header>
        <resourceId>739917509</resourceId>
    </Header>
    <Name href="ExoMount01Green.(MountSkin).Name.txt" />
    <Description href="ExoMount01Green.(MountSkin).Description.txt" />
    <SourceDescription href="/Mechanics/Mounts/Skins/ItemMallSource.txt" />
    <image href="/Interface/Icons/Mounts/MountExoskeletGreen.(UISingleTexture).xdb" />
    <visualMount href="/Client/VisualMounts/Exoskeleton/Exoskeleton01Green.(VisualMount).xdb" />
    <visualScript type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="PredicateExoVisualAllowedAction" />
        <preconditional>true</preconditional>
        <elements>
            <Item type="CreatureChangeVisItemsAction">
                <removeAllItems>true</removeAllItems>
                <leaveWeapons>true</leaveWeapons>
                <items>
                    <Item>
                        <slot>BOOTS</slot>
                        <newItem href="/Items/VisualItems/Cloak/Bag_Plate_E_46ExoskeletonBaseGreen.(VisualItem).xdb" />
                    </Item>
                    <Item>
                        <slot>HELM</slot>
                        <newItem href="/Items/VisualItems/Helm/Helm_Plate_E_46ExoskeletonBaseGreen.(VisualItem).xdb" />
                    </Item>
                    <Item>
                        <slot>SHIRT</slot>
                        <newItem href="/Items/VisualItems/Shirt/Plate_E_46ExoskeletonBaseGreenArmor.(VisualItem).xdb" />
                    </Item>
                    <Item>
                        <slot>MANTLE</slot>
                        <newItem href="/Items/VisualItems/Mantle/Shoulder_Plate_E_46ExoskeletonBaseGreen.(VisualItem).xdb" />
                    </Item>
                </items>
                <notForDolls>true</notForDolls>
            </Item>
        </elements>
    </visualScript>
    <p2p>false</p2p>
    <unlock href="ExoMount01Green.(UnlockResource).xdb" />
</gameMechanics.constructor.schemes.mount.MountSkin>