                                    <quest href="WW_14_1.xdb" />
                                    <counterResource href="Counter1_1.(QuestCountId).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                <zone href="/Maps/ZC12_Map02/ScriptZones/WW_14_1_Crystal_02.(ScriptZone).xdb" />
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                    <quest href="WW_14_1.xdb" />
                                    <counterResource href="Counter1_2.(QuestCountId).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                <zone href="/Maps/ZC12_Map02/ScriptZones/WW_14_1_Crystal_03.(ScriptZone).xdb" />
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                    <quest href="WW_14_1.xdb" />
                                    <counterResource href="Counter1_3.(QuestCountId).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                <zone href="/Maps/ZC12_Map02/ScriptZones/WW_14_1_Crystal_04.(ScriptZone).xdb" />
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                    <quest href="WW_14_1.xdb" />
                                    <counterResource href="Counter1_4.(QuestCountId).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
