<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.PostEffectVisAction">
        <userPostEffect href="/Spells/FX/InterfaceFX/AO11EM_Hangover01_Samogon_Drunken.(UserPostEffect).xdb#xpointer(/client.VisualConstructor.UserPostEffect)" />
      </Item>
      <Item type="client.Replica.CreatureReplaceAnimationAction">
        <action>WALK</action>
        <newAnimation>walkDrunken</newAnimation>
      </Item>
      <Item type="client.Replica.CreatureReplaceAnimationAction">
        <action>RUN</action>
        <newAnimation>walkDrunken</newAnimation>
      </Item>
      <Item type="client.Replica.CreatureAnimationSetSpeedAction">
        <channel>CHANNEL_MOVE</channel>
        <speed>4</speed>
      </Item>
      <Item type="client.Replica.CreatureReplaceAnimationAction">
        <action>IDLE_SPECIAL</action>
        <newAnimation>idleDrunken</newAnimation>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>