<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Children>
        <Item href="/Interface/Ingame/ContextPlates/Common/GenericPortrait/Portrait.(WidgetTextView).xdb#xpointer(/client.Widgets.WidgetTextView)"/>
        <Item href="/Interface/Ingame/ContextPlates/Common/GenericPortrait/PortraitSplash.(WidgetPanel).xdb#xpointer(/client.Widgets.WidgetPanel)"/>
        <Item href="/Interface/Ingame/ContextPlates/Common/GenericPortrait/Portrait.(WidgetPanel).xdb#xpointer(/client.Widgets.WidgetPanel)"/>
        <Item href="/Interface/Ingame/ContextPlates/Common/CombatStatus/CombatStatus.(WidgetPanel).xdb#xpointer(/client.Widgets.WidgetPanel)"/>
    </Children>
    <Name>Portrait</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Pos>1</Pos>
            <Size>50</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Pos>-3</Pos>
            <Size>50</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <pickMask href="/Interface/Ingame/ContextPlates/Common/GenericPortrait/PortraitPickMask.(UISingleTexture).xdb#xpointer(/client.Widgets.UISingleTexture)"/>
    <reactionOnPointing>portrait_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <textureMask href="/Interface/Ingame/ContextPlates/Common/GenericPortrait/PortraitClipMask.(UISingleTexture).xdb#xpointer(/client.Widgets.UISingleTexture)"/>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_DEFAULT</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag></TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextPlates/Common/GenericPortrait/PortraitHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            <PushedOffset x="0" y="0"/>
            <Reaction>portrait_pressed</Reaction>
            <ReactionRightClick>portrait_rmb_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal/>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ContextPlates/Common/GenericPortrait/PortraitHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
