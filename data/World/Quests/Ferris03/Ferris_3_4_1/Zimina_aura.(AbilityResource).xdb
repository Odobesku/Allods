<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739905107</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.Aura">
			<radius>10</radius>
			<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
								<quest href="Ferris_3_4_1.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
								<counterResource href="CountId_3.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
								<value>1</value>
							</predicate>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="CountId_3.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>4000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateInZone">
											<zone href="/Maps/Ferris_indoor/Zones/Ferris_indoor/Ferris_indoor.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.BuffDetacher">
											<buff href="Ferris_3_4_1_Meh.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											<anyRank>false</anyRank>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ReturningImpact">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
									<data href="Zimina_finish.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsIn>
			<filter type="gameMechanics.world.creature.AvatarFilter" />
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
