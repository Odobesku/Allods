<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>215949</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Platform.(BuffResource).Name.txt" />
    <Description href="Platform.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/EngineerDrone.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                <coeff>-1</coeff>
                <calcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer hrefvar="externalCalcer" />
                </calcer>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateFaction">
                            <faction href="/World/Factions/League.xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="VisualLeague.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <elseImpacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="VisualEmpire.(BuffResource).xdb" />
                        </Item>
                    </elseImpacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="VisualLeague.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="VisualEmpire.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <ranks>
        <Item href="Platform01.(BuffResource).xdb" />
        <Item href="Platform02.(BuffResource).xdb" />
        <Item href="Platform03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>