<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <objects>
            <Item>
                <locatorName>Global</locatorName>
                <visObject href="/Spells/FX/Mobs/Slime_SlimeDec.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
