<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739918313</resourceId>
	</Header>
	<visualScripts href="ChannelingVisual.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>85</value>
	</range>
	<prepareDuration>2000</prepareDuration>
	<targetType>STTCurrentTargetNotSelf</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
				<impacts>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="Damager.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
						<element>DISEASE</element>
						<damage>10</damage>
						<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
							<scalers>
								<Item type="gameMechanics.elements.scalers.MagicScaler" />
								<Item type="gameMechanics.elements.scalers.SumBuffsStackScaler">
									<buffs>
										<Item href="Damager.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									</buffs>
								</Item>
							</scalers>
						</scaler>
					</Item>
				</impacts>
				<filter type="gameMechanics.world.creature.AvatarFilter" />
				<targetsLimit>1</targetsLimit>
				<sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
					<order>Ascending</order>
				</sorting>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
