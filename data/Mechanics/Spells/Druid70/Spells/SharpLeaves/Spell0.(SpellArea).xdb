<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739923071</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
    </groups>
    <element>POISON</element>
    <Name href="Spell0.(SpellSingleTarget).Name.txt" />
    <Description href="Spell0.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Druid/DruidNaturalBalance.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Druid/SharpLeavesAE.(SpellVisScripts).xdb" />
    <prepareDuration>2500</prepareDuration>
    <targetType>STTSelf</targetType>
    <ranks>
        <Item href="Spell01.(SpellArea).xdb" />
        <Item href="Spell02.(SpellArea).xdb" />
        <Item href="Spell03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>4000</duration>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>71.1504</mana>
                <manaType>
                    <Item>Mana</Item>
                </manaType>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>POISON</element>
                <damage var="damage" />
                <impactsOnHitTarget>
                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                        <mark href="/Mechanics/Spells/Druid70/Abilities/PoisonTornado/PoisonWatcher.(MarkResource).xdb" />
                    </Item>
                </impactsOnHitTarget>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.RectangularRay">
        <width>3</width>
        <topPlane>3</topPlane>
    </shape>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <shapeOrientation type="gameMechanics.elements.common.ShapeOrientationYawAndPitch" />
    <radius>15</radius>
    <stopOnNoTargets>false</stopOnNoTargets>
</gameMechanics.constructor.schemes.spell.area.SpellArea>