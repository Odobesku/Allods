<?xml version="1.0" encoding="UTF-8" ?>
<CreatureVisActionResource>
    <action type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.VisActionList">
                <elements>
                    <Item type="client.Replica.VisActionList">
                        <elements>
                            <Item type="client.Replica.Sound3DAction">
                                <locator>Global</locator>
                                <sound>
                                    <creationRadius>-1</creationRadius>
                                    <name>/spells/Mount/MountExoskeletonV11/EnterCombat</name>
                                    <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
                                </sound>
                                <forcedSoundStop>true</forcedSoundStop>
                                <onlyForMainAvatar>false</onlyForMainAvatar>
                            </Item>
                        </elements>
                        <play>Simultaneously</play>
                        <playWhile type="client.Replica.VisActionDelay">
                            <time>1700</time>
                        </playWhile>
                        <preconditional>false</preconditional>
                        <restartOnVisualChange>true</restartOnVisualChange>
                        <stopOnDeath>false</stopOnDeath>
                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                    </Item>
                    <Item type="client.Replica.VisActionList">
                        <elements>
                            <Item type="client.Replica.CreatureEffectsAction">
                                <category>EFFECT_DEFAULT</category>
                                <visualEffects>
                                    <Item>
                                        <delay>0</delay>
                                        <effectAnimations>
                                            <mode>DIE</mode>
                                        </effectAnimations>
                                        <effectFx href="/Spells/FX/Spells/MEV6Base_Start.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                                        <fadeInTime>50</fadeInTime>
                                        <fadeOutTime>150</fadeOutTime>
                                        <scale>1</scale>
                                        <fixPoint>true</fixPoint>
                                        <lockScale>false</lockScale>
                                        <muteFxSounds>false</muteFxSounds>
                                        <ignoreParentRotation>true</ignoreParentRotation>
                                        <locator>Global</locator>
                                        <member>Default_Member</member>
                                        <offset x="0" y="0" z="0" />
                                        <rotation x="0" y="0.099999994" z="0" w="0" />
                                        <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                                    </Item>
                                </visualEffects>
                                <dontFade>false</dontFade>
                                <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                                <stopOnDeath>false</stopOnDeath>
                            </Item>
                        </elements>
                        <play>Simultaneously</play>
                        <preconditional>false</preconditional>
                        <restartOnVisualChange>false</restartOnVisualChange>
                        <stopOnDeath>false</stopOnDeath>
                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                    </Item>
                </elements>
                <play>Simultaneously</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
            <Item type="client.Replica.VisActionList">
                <elements>
                    <Item type="client.SLON.CreatureStepSoundParamAction">
                        <param>
                            <parameter href="/Mechanics/Mounts/Skins/ExoMounts/ExoFootsteps.(SoundParameter).xdb#xpointer(/client.Sound.SoundParameter)" />
                            <value>0.299999982</value>
                        </param>
                        <onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
                    </Item>
                </elements>
                <play>Simultaneously</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>true</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
            <Item type="client.Replica.VisActionList">
                <elements>
                    <Item type="client.Replica.VisActionDelay">
                        <time>350</time>
                    </Item>
                    <Item type="client.Replica.CreatureChangeVisItemsAction">
                        <items>
                            <Item>
                                <slot>HELM</slot>
                            </Item>
                            <Item>
                                <slot>LIFESTYLEHEAD</slot>
                            </Item>
                        </items>
                        <isGfxCondition>false</isGfxCondition>
                        <leaveWeapons>false</leaveWeapons>
                        <notForDolls>false</notForDolls>
                        <removeAllItems>false</removeAllItems>
                    </Item>
                </elements>
                <play>InSequence</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
            <Item type="client.Replica.VisActionList">
                <elements>
                    <Item type="client.Replica.VisActionList">
                        <elements>
                            <Item type="client.Replica.CreatureChangeVisItemsAction">
                                <items>
                                    <Item>
                                        <newItem href="/Items/VisualItems/Cloak/Bag_Plate_E_95ExoskeletonV10.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                                        <slot>EARRING2</slot>
                                    </Item>
                                </items>
                                <isGfxCondition>false</isGfxCondition>
                                <leaveWeapons>true</leaveWeapons>
                                <notForDolls>true</notForDolls>
                                <removeAllItems>false</removeAllItems>
                            </Item>
                        </elements>
                        <play>Simultaneously</play>
                        <playWhile type="client.SLON.PredicateVisualMountAction">
                            <mountsList>
                                <Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton10Inventor.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
                            </mountsList>
                            <checkIsInTheList>true</checkIsInTheList>
                            <checkOnStartOnly>true</checkOnStartOnly>
                        </playWhile>
                        <preconditional>false</preconditional>
                        <restartOnVisualChange>true</restartOnVisualChange>
                        <stopOnDeath>false</stopOnDeath>
                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                    </Item>
                    <Item type="client.Replica.VisActionList">
                        <elements>
                            <Item type="client.Replica.CreatureChangeVisItemsAction">
                                <items>
                                    <Item>
                                        <newItem href="/Items/VisualItems/Cloak/Bag_Plate_E_96ExoskeletonV10Red.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                                        <slot>EARRING2</slot>
                                    </Item>
                                </items>
                                <isGfxCondition>false</isGfxCondition>
                                <leaveWeapons>true</leaveWeapons>
                                <notForDolls>true</notForDolls>
                                <removeAllItems>false</removeAllItems>
                            </Item>
                        </elements>
                        <play>Simultaneously</play>
                        <playWhile type="client.SLON.PredicateVisualMountAction">
                            <mountsList>
                                <Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton10InventorRed.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
                            </mountsList>
                            <checkIsInTheList>true</checkIsInTheList>
                            <checkOnStartOnly>true</checkOnStartOnly>
                        </playWhile>
                        <preconditional>false</preconditional>
                        <restartOnVisualChange>false</restartOnVisualChange>
                        <stopOnDeath>false</stopOnDeath>
                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                    </Item>
                    <Item type="client.Replica.VisActionList">
                        <elements>
                            <Item type="client.Replica.CreatureChangeVisItemsAction">
                                <items>
                                    <Item>
                                        <newItem href="/Items/VisualItems/Cloak/Bag_Plate_E_97ExoskeletonV10Corrupted.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                                        <slot>EARRING2</slot>
                                    </Item>
                                </items>
                                <isGfxCondition>false</isGfxCondition>
                                <leaveWeapons>true</leaveWeapons>
                                <notForDolls>true</notForDolls>
                                <removeAllItems>false</removeAllItems>
                            </Item>
                        </elements>
                        <play>Simultaneously</play>
                        <playWhile type="client.SLON.PredicateVisualMountAction">
                            <mountsList>
                                <Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton10InventorCorrupted.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
                            </mountsList>
                            <checkIsInTheList>true</checkIsInTheList>
                            <checkOnStartOnly>true</checkOnStartOnly>
                        </playWhile>
                        <preconditional>false</preconditional>
                        <restartOnVisualChange>false</restartOnVisualChange>
                        <stopOnDeath>false</stopOnDeath>
                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                    </Item>
                </elements>
                <play>Simultaneously</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="client.SLON.PredicateVisualMountAction">
            <mountsList>
                <Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton10Inventor.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
                <Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton10InventorRed.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
                <Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton10InventorCorrupted.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
            </mountsList>
            <checkIsInTheList>true</checkIsInTheList>
            <checkOnStartOnly>true</checkOnStartOnly>
        </playWhile>
        <preconditional>false</preconditional>
        <restartOnVisualChange>true</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </action>
</CreatureVisActionResource>