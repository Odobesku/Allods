	<visualScripts href="PowerStrike.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
	<prepareDuration>2000</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>666666</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="ChargeBuff.(BuffResource).xdb" />
				</predicate>
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="PowerStrikeTarget.(BuffResource).xdb" />
			</Item>
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormGlacialBoss/DoNotMove.(BuffResource).xdb" />
				<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
