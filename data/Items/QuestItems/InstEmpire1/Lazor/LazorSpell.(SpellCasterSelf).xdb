<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>24624</resourceId>
    </Header>
    <Name href="LazorSpell_Name.txt" />
    <Description href="LazorSpell_Desc.txt" />
