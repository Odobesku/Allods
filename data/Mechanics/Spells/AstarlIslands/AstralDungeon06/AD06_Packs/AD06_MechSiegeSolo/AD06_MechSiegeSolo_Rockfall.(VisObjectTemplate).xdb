<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>250</fadeInMS>
    <fadeOutMS>250</fadeOutMS>
    <geometry href="/Spells/FX/Spells/Parts/Dummy.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <scale>1</scale>
    <sound />
    <visObjComponents>
        <Item type="AlignCollisionComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <endHeight>-6</endHeight>
            <locatorName></locatorName>
            <offset x="0" y="0" z="0" />
            <scale>1</scale>
            <startHeight>6</startHeight>
            <visObject href="/Spells/FX/World/Trap_Aura.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <alignNormal>true</alignNormal>
            <checkNormal>true</checkNormal>
            <fixedPosition>false</fixedPosition>
            <getPrevObjectHeight>false</getPrevObjectHeight>
            <lockScale>false</lockScale>
            <placeAlways>true</placeAlways>
        </Item>
        <Item type="DelayComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <component type="AttachedVisObjectComponent">
                <VisualObjectComponentID></VisualObjectComponentID>
                <locatorName></locatorName>
                <offset x="0" y="0" z="-1" />
                <priority>0</priority>
                <rotation x="0" y="0" z="0" w="1" />
                <scale>0.6</scale>
                <visObject href="/Spells/FX/Spells/Lesavka_RockfallOne.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                <hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
                <isPortraitEnabled>true</isPortraitEnabled>
                <lockScale>false</lockScale>
                <scaleFromGlobal>false</scaleFromGlobal>
                <skipSound>false</skipSound>
            </component>
            <timeMax>1.1</timeMax>
            <timeMin>1.1</timeMin>
            <skipLoading>true</skipLoading>
        </Item>
        <Item type="DelayComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <component type="AttachedSoundComponent">
                <VisualObjectComponentID></VisualObjectComponentID>
                <locatorName></locatorName>
                <sound>
                    <name>spells/Hits/StoneHit</name>
                    <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
                </sound>
            </component>
            <timeMax>2</timeMax>
            <timeMin>2</timeMin>
            <skipLoading>true</skipLoading>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>