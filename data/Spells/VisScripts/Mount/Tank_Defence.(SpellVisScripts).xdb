<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>CLAMP</mode>
				<use>USE_ANIMATIONS</use>
				<animations>
					<Item>special01</Item>
				</animations>
				<channel>CHANNEL_BUFF</channel>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>1800</delay>
						<effectFx href="/Spells/FX/Mobs/MountsTank_KillTank_End.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<fadeOutTime>500</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting />
	<launch />
</SpellVisScripts>
