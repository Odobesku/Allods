<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221511</resourceId>
    </Header>
    <Name href="Phase3_LastHole.(BuffResource).Name.txt" />
    <image href="/Interface/Ingame/EngineerOverheating/textures/EngineerScavengerCounter4.(UISingleTexture).xdb" />
    <visScript href="Phase3Visual.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="L_1.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="L_2.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="L_3.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ImmunityBuff.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="DamageThresholdBuff.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                    <group href="/Mechanics/Spells/Groups/FerrisRaid_Worm.(ActionGroup).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>DynamiteBox</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                    <spell href="SlimeCleave/SlimeCleave.(SpellArea).xdb" />
                    <duration>
                        <second>4</second>
                    </duration>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="ReflectReadyBuff.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>33000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                            <selector type="gameMechanics.tools.SelectorShuffle">
                                <sourceSelector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                    <range min="0" max="1" />
                                    <withinRange>false</withinRange>
                                    <minCandidatesCount>1</minCandidatesCount>
                                    <targetCount>1</targetCount>
                                </sourceSelector>
                            </selector>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </filter>
                            <impacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="Phase3/TransmissiveCorruption.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>10000</tick>
            <initialDelay>10000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Incoming</vector>
                <direction>Incoming</direction>
                <plane href="WormBossPlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Incoming</vector>
                <direction>Incoming</direction>
                <plane href="WormBossPlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAbility">
            <ability href="Phase1_Phase2_Animation.(AbilityResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>100</delay>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="DoNotMove.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>7</multiplier>
                                    </durationScaler>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="CorruptionCleave/CorruptionCleave.(SpellArea).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Start</Item>
            </stages>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                            <selector type="gameMechanics.tools.SelectorShuffle">
                                <sourceSelector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                    <range min="0" max="1" />
                                    <withinRange>false</withinRange>
                                    <minCandidatesCount>1</minCandidatesCount>
                                    <targetCount>1</targetCount>
                                </sourceSelector>
                            </selector>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </filter>
                            <impacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="Phase2/CorruptChargeResource.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/RaidInstances/Tank.(BuffResource).xdb" />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier>3</multiplier>
                                            </durationScaler>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                            <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                                <base type="gameMechanics.map.destination.SelfPosDestination" />
                                                <offset>3</offset>
                                            </destination>
                                            <object href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/StasisSphere/StasisSphere.(MobWorld).xdb" />
                                            <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <impactsNotSelected>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/RaidInstances/Tank.(BuffResource).xdb" />
                                </Item>
                            </impactsNotSelected>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>20000</tick>
            <initialDelay>10000</initialDelay>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>