<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>1000</time>
			</Item>
			<Item type="VisActionLoopAction">
				<actionToLoop type="VisActionList">
					<play>Simultaneously</play>
					<playWhile />
					<elements>
						<Item type="CreatureEffectsAction">
							<visualEffects>
								<Item>
									<effectFx href="/Spells/FX/Spells/Druid70_ThunderLightning.(VisObjectTemplate).xdb" />
									<lockScale>true</lockScale>
									<fadeOutTime>1000</fadeOutTime>
									<locator>Slot_Global</locator>
								</Item>
							</visualEffects>
						</Item>
					</elements>
				</actionToLoop>
				<totalTime>2</totalTime>
				<repeat>2</repeat>
			</Item>
		</elements>
	</action>
	<postAction type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/Druid70_ThunderLightning.(VisObjectTemplate).xdb" />
				<lockScale>true</lockScale>
				<fadeOutTime>1000</fadeOutTime>
				<locator>Slot_Global</locator>
				<offendTime />
			</Item>
		</visualEffects>
	</postAction>
</BuffVisScripts>
