            <Item>
                <animation>run</animation>
                <playOnMount>run</playOnMount>
                <playOnRiderBottom>mountStoveRun</playOnRiderBottom>
                <playOnRiderTop>mountStoveRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>shuffleLeft</animation>
                <playOnMount>shuffleLeft</playOnMount>
                <playOnRiderBottom>mountStoveIdle</playOnRiderBottom>
                <playOnRiderTop>mountStoveIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>shuffleRight</animation>
                <playOnMount>shuffleRight</playOnMount>
                <playOnRiderBottom>mountStoveIdle</playOnRiderBottom>
                <playOnRiderTop>mountStoveIdle</playOnRiderTop>
