                            <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="cd_duration" />
                                </mulCalcer>
                            </durationScaler>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="APWatcher01.(BuffResource).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOnAttach>
            <restrictiveBuff href="BuffCD.(BuffResource).xdb" />
            <suppressDamage>true</suppressDamage>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffInterceptor">
            <impactsOnDetach>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="APWatcher01.(BuffResource).xdb" />
                </Item>
            </impactsOnDetach>
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffEquals">
