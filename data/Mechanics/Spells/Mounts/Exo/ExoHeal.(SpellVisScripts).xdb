        </Variables>
    </Header>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="VisActionDelay">
            <time>675</time>
        </playWhile>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect_Nihil_ElectoBlade.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
