<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739924243</resourceId>
    </Header>
    <visualScript type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionList">
                <playWhile type="VisActionDelay">
                    <time>1000</time>
                </playWhile>
                <elements>
                    <Item type="CreatureSetTransparencyAction">
                        <transparency>0</transparency>
                    </Item>
                </elements>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>500</time>
                    </Item>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>resurrection</Item>
                        </animations>
                        <channel>CHANNEL_KNOCKDOWN</channel>
                        <advanced>
                            <speed>0.5</speed>
                        </advanced>
                    </Item>
                </elements>
            </Item>
        </elements>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="RD2_Boss01_Disabled.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>12000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                            <ability href="RD2_Boss01_Disabled.(AbilityResource).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>