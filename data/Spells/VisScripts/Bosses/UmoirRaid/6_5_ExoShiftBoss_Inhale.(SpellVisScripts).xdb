<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readySpellDirected</Item>
		</animations>
	</actionBarStart>
	<wholeCasting type="CreatureVisObjectComponentsAction">
		<visObjComponents>
			<Item type="AttachedVisObjectComponent">
				<visObject href="/Spells/FX/Mobs/ExoShiftBoss_PulseReady.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<scale>5</scale>
				<locatorName>ForeArmTwist_R</locatorName>
			</Item>
			<Item type="AttachedVisObjectComponent">
				<visObject href="/Spells/FX/Mobs/ExoShiftBoss_PulseReady.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<rotation x="0" y="1" z="0" w="0" />
				<scale>5</scale>
				<locatorName>ForeArmTwist_L</locatorName>
			</Item>
		</visObjComponents>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ExoShiftBoss_InhaleCleave.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
