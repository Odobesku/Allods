	<Name href="PsionicWave.(SpellSingleTarget).Name.txt" />
	<Description href="PsionicWave.(SpellSingleTarget).Description.txt" />
	<image href="/Interface/Icons/Special/Alchemy/Stun.(UISingleTexture).xdb" />
