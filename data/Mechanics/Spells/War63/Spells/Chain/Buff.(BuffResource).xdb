<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739921143</resourceId>
    </Header>
    <Name href="Buff.(BuffResource).Name.txt" />
    <Description href="Buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/StalkerArrowHeartseeking.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Warrior/Chain.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="ChainVisual.(ClientData).xdb" />
                            <calcers>
                                <addressEntries>
                                    <Item>
                                        <name>target</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                    </Item>
                                    <Item>
                                        <name>caster</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    </Item>
                                </addressEntries>
                            </calcers>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                    <time>750</time>
                    <impactsOnLand>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Buff.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>1.5</multiplier>
                            </durationScaler>
                        </Item>
                    </impactsOnLand>
                    <turnToDestination>true</turnToDestination>
                    <destination type="gameMechanics.map.destination.DestinationModified">
                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                        <modifiers>
                            <Item type="gameMechanics.map.destination.modifier.ModifierTrailFrom">
                                <from type="gameMechanics.elements.calcers.DestinationSpellTargetThrust">
                                    <maxDist>1</maxDist>
                                </from>
                                <corpulence type="gameMechanics.elements.calcers.FloatData">
                                    <value>3</value>
                                </corpulence>
                            </Item>
                        </modifiers>
                    </destination>
                    <keepOnGround>false</keepOnGround>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>2000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>