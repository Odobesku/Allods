    <internalName>UI04_NayanTower</internalName>
    <name href="UI04_NayanTower.(ZoneResource).Name.txt" />
    <color>0xff00bbbb</color>
    <pvpType href="/Mechanics/ZonePvpTypes/SanctuaryNoGroup.xdb#xpointer(/gameMechanics.map.zone.Sanctuary)" />
    <mountsProhibited>true</mountsProhibited>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectAvatarRespawnStrategy">
            <respawnStrategy type="gameMechanics.world.avatar.RandomLocatorRespawnStrategy">
                <locators>
                    <Item>
                        <scriptID>TowerDeath</scriptID>
                        <map href="/Maps/UmoirIsland04/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </Item>
                </locators>
                <impactsOnRespawn>
                    <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                        <assistantResource href="/Mechanics/Characters/Hadagan_male/UmoirIsland04/Miloslavin.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                        <mobResource href="/Characters/Hadagan_male/Instances/UmoirIsland04/Miloslavin.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="/Maps/UmoirIsland04/Scripts/TimeParadox.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impactsOnRespawn>
            </respawnStrategy>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="/Maps/UmoirIsland04/SpawnTables/NT_Guards.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="/Maps/UmoirIsland04/SpawnTables/ManaElemental.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                            <table href="/Maps/UmoirIsland04/SpawnTables/NT_Guards.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                        <quest href="/World/Quests/UmoirIsland04/UI04_Q03/UI04_Q03_02.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                        <status>Finished</status>
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                    <table href="/Maps/UmoirIsland04/SpawnTables/ManaElemental.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <sanctuaries>
