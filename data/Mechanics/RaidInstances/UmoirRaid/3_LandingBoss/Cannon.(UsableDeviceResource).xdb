                        </Item>
                    </userImpactsOnFinishUse>
                </Item>
            </effects>
        </Item>
    </persistentParts>
    <name href="Cannon.(UsableDeviceResource).Name.txt" />
    <corpulence>2</corpulence>
    <visObj href="/Ships/Components/Cannon_01/Cannon_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
