<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>specialCast</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect01DownMusic.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2.2</scale>
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>800</fadeOutTime>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
