<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221195275</resourceId>
    </Header>
    <Name href="Buff_Name.txt" />
    <Description href="Buff_Desc.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageDispelMagic.(UISingleTexture).xdb" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.AbonentLostWatcher">
            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff01.xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EventTrigger">
            <conditionalEvents>
                <Item>
                    <obj>gameMechanics.elements.events.EventSpellLaunched</obj>
                    <predicate type="gameMechanics.elements.predicates.PredicateEventSpellLaunched">
                        <spell href="Spell01.xdb" />
                    </predicate>
                </Item>
            </conditionalEvents>
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff01.xdb" />
                </Item>
            </impacts>
            <eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
        </Item>
        <Item type="gameMechanics.elements.effects.HealthLowerTrigger">
            <max type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.35</multiplier>
            </max>
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff01.xdb" />
                    <anyRank>false</anyRank>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>50</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactHeal">
                            <heal>110</heal>
                            <scalerCaster type="gameMechanics.elements.scalers.ScalerMax">
                                <scaler1 type="gameMechanics.elements.scalers.HealScaler" />
                                <scaler2 type="gameMechanics.elements.scalers.HealSlotScaler">
                                    <slot>MAINHAND</slot>
                                </scaler2>
                            </scalerCaster>
                        </Item>
                    </impacts>
                    <useSpellEnvelopeTargetEffects>true</useSpellEnvelopeTargetEffects>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ForgetSpellWatcher.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ForgetSpellWatcher.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>3600000</duration>
    <isStackable>false</isStackable>
    <stackLimit>1</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>false</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/PvPRemoveBuff.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>