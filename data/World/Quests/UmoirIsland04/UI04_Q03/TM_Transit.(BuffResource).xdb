    </Header>
    <Name href="TM_Transit.(BuffResource).Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>ui04_nayanaggro01</scriptID>
                                            <map href="/Maps/UmoirIsland04/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>2000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                            <data href="NayanPreAggro.(ClientData).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                            <delay>2000</delay>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                                                    </impacts>
                                                                    <spawnResource href="/Maps/UmoirIsland04/SpawnTables/UI04_Q03_TM_TowerMages.(SpawnTable).xdb" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                    <spawnResource href="/Maps/UmoirIsland04/SpawnTables/TM_Crew.(SpawnTable).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <spawnResource href="/Maps/UmoirIsland04/SpawnTables/NayanInTower.(SpawnTable).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.abilities.ImpactClearTimeLapseHistory" />
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                    <table href="/Maps/UmoirIsland04/SpawnTables/NayanInTower.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                    <table href="/Maps/UmoirIsland04/SpawnTables/TM_Crew.(SpawnTable).xdb" />
