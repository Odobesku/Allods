<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>5000</time>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>jumpStart</Item>
					<Item>jump</Item>
				</animations>
			</Item>
		</elements>
	</action>
	<postAction type="CreatureAnimationAction">
		<animations>
			<Item>jumpEnd</Item>
		</animations>
	</postAction>
</BuffVisScripts>
