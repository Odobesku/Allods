<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.SLON.IfAction">
            <condition type="client.SLON.IfCreatureVisCharacter">
              <visCharList>
                <Item href="/Characters/Undead_female/UndeadFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
                <Item href="/Characters/Undead_male/UndeadMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
              </visCharList>
              <checkIsInTheList>true</checkIsInTheList>
              <checkOnStartOnly>false</checkOnStartOnly>
            </condition>
            <elseAction type="client.SLON.IfAction">
              <condition type="client.SLON.IfBuffAttached">
                <buff href="/World/Quests/ZC14/Prototypes/ZC14_ExoMountRiding_Marker.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <checkOnMainAvatar>true</checkOnMainAvatar>
              </condition>
              <elseAction type="client.Replica.VisActionList">
                <elements>
                  <Item type="client.Replica.CreatureAnimationAction">
                    <advanced>
                      <autoHasten>
                        <mode>AUTOHASTEN_NONE</mode>
                        <timeToBeLeft>0</timeToBeLeft>
                      </autoHasten>
                      <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                      <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                      <offendType>NO_OFFEND</offendType>
                      <speed>0</speed>
                      <turnToTarget>TURN_DEFAULT</turnToTarget>
                      <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                      <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
                      <denyAutoHasten>false</denyAutoHasten>
                      <disableRandomFirstFrame>true</disableRandomFirstFrame>
                      <eventPlaybackEnd>false</eventPlaybackEnd>
                      <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                      <stopIfMoved>false</stopIfMoved>
                      <stopIfRotated>false</stopIfRotated>
                    </advanced>
                    <channel>CHANNEL_DEFAULT</channel>
                    <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                    <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                    <mode>DIE</mode>
                    <use>USE_ANIMATIONS</use>
                    <dontFreezePrecast>false</dontFreezePrecast>
                  </Item>
                </elements>
                <play>Simultaneously</play>
                <playWhile type="client.Replica.VisActionDelay">
                  <time>4000</time>
                </playWhile>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
              </elseAction>
              <onBreak>
                <breakEnabled>false</breakEnabled>
              </onBreak>
              <thenAction type="client.Replica.VisActionList">
                <elements>
                  <Item type="client.Replica.CreatureAnimationAction">
                    <advanced>
                      <autoHasten>
                        <mode>AUTOHASTEN_NONE</mode>
                        <timeToBeLeft>0</timeToBeLeft>
                      </autoHasten>
                      <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                      <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                      <offendType>NO_OFFEND</offendType>
                      <speed>0</speed>
                      <turnToTarget>TURN_DEFAULT</turnToTarget>
                      <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                      <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
                      <denyAutoHasten>false</denyAutoHasten>
                      <disableRandomFirstFrame>true</disableRandomFirstFrame>
                      <eventPlaybackEnd>false</eventPlaybackEnd>
                      <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                      <stopIfMoved>false</stopIfMoved>
                      <stopIfRotated>false</stopIfRotated>
                    </advanced>
                    <channel>CHANNEL_DEFAULT</channel>
                    <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                    <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                    <mode>DIE</mode>
                    <use>USE_ANIMATIONS</use>
                    <dontFreezePrecast>false</dontFreezePrecast>
                  </Item>
                </elements>
                <play>Simultaneously</play>
                <playWhile type="client.Replica.VisActionDelay">
                  <time>4000</time>
                </playWhile>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
              </thenAction>
            </elseAction>
            <onBreak>
              <breakEnabled>false</breakEnabled>
            </onBreak>
            <thenAction type="client.Replica.VisActionList">
              <elements>
                <Item type="client.Replica.CreatureAnimationAction">
                  <advanced>
                    <autoHasten>
                      <mode>AUTOHASTEN_NONE</mode>
                      <timeToBeLeft>0</timeToBeLeft>
                    </autoHasten>
                    <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                    <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                    <offendType>NO_OFFEND</offendType>
                    <speed>0</speed>
                    <turnToTarget>TURN_DEFAULT</turnToTarget>
                    <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                    <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
                    <denyAutoHasten>false</denyAutoHasten>
                    <disableRandomFirstFrame>true</disableRandomFirstFrame>
                    <eventPlaybackEnd>false</eventPlaybackEnd>
                    <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                    <stopIfMoved>false</stopIfMoved>
                    <stopIfRotated>false</stopIfRotated>
                  </advanced>
                  <channel>CHANNEL_DEFAULT</channel>
                  <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                  <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                  <mode>DIE</mode>
                  <use>USE_ANIMATIONS</use>
                  <dontFreezePrecast>false</dontFreezePrecast>
                </Item>
              </elements>
              <play>Simultaneously</play>
              <playWhile type="client.Replica.VisActionDelay">
                <time>4000</time>
              </playWhile>
              <preconditional>false</preconditional>
              <restartOnVisualChange>false</restartOnVisualChange>
              <stopOnDeath>false</stopOnDeath>
              <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </thenAction>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>true</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.VisActionDelay">
            <time>1000</time>
          </Item>
          <Item type="client.Replica.PostEffectVisAction">
            <userPostEffect href="/Spells/FX/InterfaceFX/Black_Long.(UserPostEffect).xdb#xpointer(/client.VisualConstructor.UserPostEffect)" />
          </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
