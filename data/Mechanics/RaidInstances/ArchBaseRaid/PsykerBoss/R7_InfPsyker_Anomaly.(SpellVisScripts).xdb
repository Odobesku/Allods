<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/AstralElemental_Smoke.(VisObjectTemplate).xdb" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/AstralPlangtonCloud.(VisObjectTemplate).xdb" />
						<scale>0.5</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/MindFlayerMage_HandSmoke.(VisObjectTemplate).xdb" />
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>instantSpellCastOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="DelayComponent">
						<timeMin>0.5</timeMin>
						<timeMax>0.5</timeMax>
						<component type="AttachedVisObjectComponent">
							<visObject href="/Spells/FX/Spells/MageManaBurn.(VisObjectTemplate).xdb" />
							<scale>7</scale>
							<locatorName>Slot_Global</locatorName>
						</component>
					</Item>
				</visObjComponents>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
