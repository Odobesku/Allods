<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellOmni</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect01DownMusic.(VisObjectTemplate).xdb" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>DIE</mode>
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visActionID>fx</visActionID>
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb" />
                        <locator>Slot_Hand_L</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb" />
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
                <stopOnDeath>true</stopOnDeath>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>1000</time>
                    </Item>
                    <Item type="VisActionStopAction">
                        <stoppedActionID>fx</stoppedActionID>
                    </Item>
                </elements>
            </Item>
        </elements>
        <stopOnDeath>true</stopOnDeath>
    </launch>
</SpellVisScripts>