    <fadeInMS>500</fadeInMS>
    <fadeOutMS>500</fadeOutMS>
    <geometry href="/Spells/FX/Spells/BombFireHG.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <particle href="/Spells/FX/Spells/BombFireHG.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)" />
    <scale>1</scale>
    <sound />
    <states>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/Spells/BombFireHG.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <visObjComponents>
        <Item type="AttachedVisObjectComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <locatorName></locatorName>
            <offset x="0" y="0" z="0" />
            <priority>0</priority>
            <rotation x="0" y="0" z="0" w="1" />
            <scale>1</scale>
            <visObject href="/Spells/FX/Spells/AOEAura_Red_R5.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
            <isPortraitEnabled>true</isPortraitEnabled>
            <lockScale>false</lockScale>
            <scaleFromGlobal>false</scaleFromGlobal>
            <skipSound>false</skipSound>
        </Item>
        <Item type="DelayComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <component type="AttachedVisObjectComponent">
                <VisualObjectComponentID></VisualObjectComponentID>
                <locatorName></locatorName>
                <offset x="0" y="0" z="0" />
                <priority>0</priority>
                <rotation x="0" y="0" z="0" w="1" />
                <scale>1</scale>
                <visObject href="/Spells/FX/Spells/HitFireball2.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                <hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
                <isPortraitEnabled>true</isPortraitEnabled>
                <lockScale>false</lockScale>
                <scaleFromGlobal>false</scaleFromGlobal>
                <skipSound>false</skipSound>
            </component>
            <timeMax>3</timeMax>
            <timeMin>3</timeMin>
            <skipLoading>true</skipLoading>
