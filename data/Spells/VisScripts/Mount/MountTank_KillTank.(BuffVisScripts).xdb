<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>special</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/MountsTank_KillTank.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<stopOnDeath>false</stopOnDeath>
	</action>
	<postAction />
</BuffVisScripts>
