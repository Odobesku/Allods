<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>188418</resourceId>
    </Header>
    <Name href="ChewingChannelBuff.(BuffResource).Name.txt" />
    <Description href="ChewingChannelBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidPetGetItUpgrade.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>DISEASE</element>
                    <damage>10</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/AstarlIslands/AI71/Common/PlagueCarrier/PlagueDOT.(BuffResource).xdb" />
                </Item>
            </impacts>
            <tick>500</tick>
            <initialDelay>1750</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/RaidInstances/DisableEscapes.(BuffResource).xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>9.5</multiplier>
                    </durationScaler>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/RaidInstances/DisableEscapes.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>