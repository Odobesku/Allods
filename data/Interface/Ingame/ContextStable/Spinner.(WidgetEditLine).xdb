<?xml version="1.0" encoding="UTF-8" ?>
<WidgetEditLine>
	<Header>
		<Prototype href="/Interface/Common/EditLine/Prototype.(WidgetEditLine).xdb#xpointer(/WidgetEditLine)" />
	</Header>
	<Name>Edit</Name>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>32</Pos>
			<HighPos>32</HighPos>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>4</Pos>
			<HighPos>4</HighPos>
		</Y>
	</Placement>
	<ReactionEsc>feed_spinner_escape</ReactionEsc>
	<ReactionChanged>feed_spinner_changed</ReactionChanged>
	<maxSymbolsCount>2</maxSymbolsCount>
	<filterAlias>NUMBERS</filterAlias>
	<globalClassName>EditLineMoneyCount</globalClassName>
	<selectionClassName>EditLineMoneyCountSelection</selectionClassName>
	<ReactionEnter>feed_spinner_enter</ReactionEnter>
</WidgetEditLine>
