<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>channelCastDirected</Item>
						</animations>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Engineer_BeamCannon_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<lockScale>true</lockScale>
								<fadeInTime>300</fadeInTime>
								<fadeOutTime>300</fadeOutTime>
								<locator>FROM_LOCATOR_NAME</locator>
								<member>Mount</member>
								<locatorName>Turret_transform</locatorName>
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Engineer_BeamCannon_ShotTurr.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<locator>FROM_LOCATOR_NAME</locator>
								<member>Mount</member>
								<locatorName>Turret_transform</locatorName>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>channelCastDirectedEngineer</Item>
						</animations>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Engineer_BeamCannon_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<lockScale>true</lockScale>
								<fadeInTime>300</fadeInTime>
								<fadeOutTime>300</fadeOutTime>
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Engineer_BeamCannon_Shot.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
