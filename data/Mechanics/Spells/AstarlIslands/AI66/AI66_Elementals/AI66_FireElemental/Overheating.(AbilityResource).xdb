<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>187446</resourceId>
    </Header>
    <name href="Overheating.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>500</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>6</radius>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                <mobs>
                                                    <Item href="AI66_FireElemental.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                    <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Elementals/AI66_LavaElemental/AI66_LavaElemental.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                </mobs>
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>FIRE</element>
                                            <damage>80</damage>
                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="FlameDOT.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Elementals/AI66_FrostElemental/FrostPrison.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="Explosion.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>