<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739871529</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        </moveType>
                                        <resource href="HealPuddle.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                    </projectileData>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                            </filter>
                            <targetsLimit>1</targetsLimit>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>7000</tick>
            <initialDelay>2000</initialDelay>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>