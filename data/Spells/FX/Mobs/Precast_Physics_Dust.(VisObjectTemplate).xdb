            <params href="/Spells/FX/InterfaceFX/WarriorStatue_FearCry.(CameraShakeParameters).xdb#xpointer(/client.VisualConstructor.CameraShakeParameters)" />
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
