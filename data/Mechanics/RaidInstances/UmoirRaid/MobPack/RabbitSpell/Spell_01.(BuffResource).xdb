<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>224997</resourceId>
    </Header>
    <Name href="Spell_01.(BuffResource).Name.txt" />
    <Description href="Spell_01.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/PetModeAggressive.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/HitBloodBleedingRed.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <locator>Slot_BodyFX</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.PhysicalDoT">
            <parameters>
                <damagePerTick>20</damagePerTick>
            </parameters>
            <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                        <value>0.05</value>
                    </chanceCalcer>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="Buff_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Buff_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.AbonentLostWatcher">
            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Spell_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>