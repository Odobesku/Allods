                                    <predicates>
                                        <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                                            <groups>
                                                <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
                                                <Item href="/Mechanics/Spells/Groups/Poisons.xdb" />
                                                <Item href="/Mechanics/Spells/Groups/Diseases.xdb" />
                                                <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                            </groups>
                                        </Item>
                                    </predicates>
                                    <detachCount type="gameMechanics.elements.calcers.LongData">
                                        <value>1</value>
                                    </detachCount>
                                    <impactsOnHolder>
                                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                            <impacts>
                                                <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="DispellStacks.(BuffResource).xdb" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                    <assistantResource href="/Mechanics/Spells/Engineer63/Spells/HealStation/HealStation.(AssistantResource).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsOnHolder>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                    <impactsOff>
