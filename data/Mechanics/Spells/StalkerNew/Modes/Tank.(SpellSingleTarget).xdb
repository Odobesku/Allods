<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739882312</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="Tank.(SpellSingleTarget).Name.txt" />
    <Description href="Tank.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Equipment/Leather/GlovesLeatherCrude.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Common/PhysDmg.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <isWorkOnDead>true</isWorkOnDead>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                        <spell href="Tank.(SpellSingleTarget).xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
                        <spell href="Tank.(SpellSingleTarget).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="Tank.(BuffResource).xdb" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellActivate">
                        <spell href="Tank.(SpellSingleTarget).xdb" />
                        <effects>
                            <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
                                <impacts>
                                    <casterToTarget>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/StalkerNew/ActiveDefence/Defence.(BuffResource).xdb" />
                                        </Item>
                                    </casterToTarget>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.EffectList">
                                <effectsResource href="DisableArchery.(EffectListResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.effects.SpellsModifier">
                                <modifiers>
                                    <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                                        <effects>
                                            <Item type="gameMechanics.elements.effects.ThreatMultiplier">
                                                <factor type="gameMechanics.elements.calcers.FloatData">
                                                    <value>3</value>
                                                </factor>
                                            </Item>
                                        </effects>
                                        <onBehalfOfHolder>true</onBehalfOfHolder>
                                    </Item>
                                </modifiers>
                            </Item>
                            <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                                <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                    <coeff>-0.05</coeff>
                                </scaler>
                            </Item>
                            <Item type="gameMechanics.elements.effects.EffectDisableAction">
                                <action href="/Mechanics/Spells/StalkerNew/Virtue/Spell01.xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.effects.EffectDisableAction">
                                <action href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/PhysDmg/Spell01.xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                    <coeff>-0.35</coeff>
                                </scaler>
                                <group href="/Mechanics/Spells/Groups/RangedAttacks.xdb" />
                            </Item>
                        </effects>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Tank.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
                        <spell href="Assassin.(SpellSingleTarget).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="Assassin.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/PhysDmg/PhysDmgEnforcer.xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
                        <spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/PhysDmg/Spell01.xdb" />
                    </Item>
                </impactsElse>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                <spell href="Assassin.(SpellSingleTarget).xdb" />
                <duration>10000</duration>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                        <affectPets>false</affectPets>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="/Mechanics/Spells/CommonSpells/DoubleHP/Buff.(BuffResource).xdb" />
                                <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <linkedAbility href="Tank.(AbilityResource).xdb" />
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>