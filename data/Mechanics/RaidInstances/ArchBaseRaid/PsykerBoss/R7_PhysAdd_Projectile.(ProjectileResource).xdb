<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739934854</resourceId>
	</Header>
	<visObject href="R7_PhysAdd_Projectile.(VisObjectTemplate).xdb" />
	<altitude>2</altitude>
	<speed>0.004</speed>
	<lifeLengthCap>25000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
			<effects>
				<Item type="gameMechanics.elements.effects.TickableEntityAura">
					<tick>1000</tick>
					<affectGroup>All</affectGroup>
					<radius>2</radius>
					<height>0</height>
					<filter type="gameMechanics.world.creature.AvatarFilter" />
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<holderImpactsIn>
						<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
							<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
							<radius>6</radius>
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>LIGHTNING</element>
									<damage>90</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
						</Item>
					</holderImpactsIn>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.EffectDeferredEffects">
					<effects>
						<Item type="gameMechanics.elements.effects.TickableEntityAura">
							<tick>1000</tick>
							<affectGroup>All</affectGroup>
							<radius>2</radius>
							<height>0</height>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							</predicates>
							<impactsIn>
								<Item type="gameMechanics.elements.impacts.ReturningImpact">
									<impacts>
										<Item type="gameMechanics.elements.impacts.Disintegrate" />
									</impacts>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
									<projectileData>
										<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
											<destination type="gameMechanics.map.destination.SelfPosDestination" />
										</moveType>
										<resource href="R7_PhysAdd_Projectile_Destruction.(ProjectileResource).xdb" />
									</projectileData>
								</Item>
							</impactsIn>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="Phys_Plane.(Plane).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
					<projectileData>
						<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
							<destination type="gameMechanics.map.destination.SelfPosDestination" />
						</moveType>
						<resource href="R7_PhysAdd_Projectile_Destruction.(ProjectileResource).xdb" />
					</projectileData>
				</Item>
			</impactsOff>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>