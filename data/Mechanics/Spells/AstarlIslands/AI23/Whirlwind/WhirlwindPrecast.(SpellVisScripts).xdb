<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <visActionID>anim1</visActionID>
                <animations>
                    <Item>dodgeDouble</Item>
                </animations>
                <advanced>
                    <speed>1.25</speed>
                    <offendType>NO_OFFEND</offendType>
                    <animationKeysAction />
                </advanced>
            </Item>
            <Item type="VisActionList">
                <play>InSequence</play>
                <elements>
                    <Item type="VisActionDelay">
                        <time>1250</time>
                    </Item>
                    <Item type="VisActionStopAction">
                        <stoppedActionID>anim1</stoppedActionID>
                    </Item>
                </elements>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>