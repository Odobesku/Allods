<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739922322</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="value" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Mage/MageConflagrate.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
			<mark href="FireBoltAoEDebuff.(MarkResource).xdb" />
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
								<spell href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisable.(SpellSingleTarget).xdb" />
							</predicate>
						</Item>
					</predicates>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>10</radius>
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Vulnerability/Vulnerability.(BuffResource).xdb" />
									<durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
											<calcers>
												<Item type="gameMechanics.elements.calcers.AbilityRankCalcer">
													<ability href="/Mechanics/Spells/Mage63/Abilities/FireBoltVulnerability/Ability01.(AbilityResource).xdb" />
													<mul>0.2</mul>
												</Item>
												<Item type="gameMechanics.elements.calcers.SpellRankCalcer">
													<spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Vulnerability/Vulnerability1.(SpellSingleTarget).xdb" />
													<mul>1</mul>
												</Item>
											</calcers>
										</mulCalcer>
									</durationScaler>
								</Item>
							</impacts>
							<targetsLimit var="targetsLimit" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.AbilityUnlockerEffect">
			<abilities>
				<Item href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisableAbility.(AbilityResource).xdb" />
			</abilities>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
