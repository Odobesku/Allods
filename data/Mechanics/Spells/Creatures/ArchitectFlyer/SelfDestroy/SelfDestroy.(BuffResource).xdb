<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739936918</resourceId>
	</Header>
	<Name href="SelfDestroy.(BuffResource).Name.txt" />
	<image href="/Interface/Icons/Equipment/Trinket/AstralBomb_01.(UISingleTexture).xdb" />
	<visualEffects />
	<visualPostEffects />
	<visualEffectsIncCount />
	<visualEffectsDecCount />
	<visScript href="SelfDestroy.(BuffVisScripts).xdb" />
	<uiComponents />
	<descVars />
	<gainSpells />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>10</radius>
					<conditions />
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>LIGHTNING</element>
									<threatMultiplier>1</threatMultiplier>
									<damage>50</damage>
									<impactsOnHitTarget />
									<impactsOnHitCaster />
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ImpactHeal">
									<heal>180</heal>
									<scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
								</Item>
							</impactsElse>
						</Item>
					</impacts>
					<impactsOnNoTargets />
					<impactsOnTargetsFound />
					<finishImpacts />
					<filter type="gameMechanics.constructor.basicElements.FilterAnd">
						<filters>
							<Item type="gameMechanics.constructor.basicElements.FilterOr">
								<filters>
									<Item type="gameMechanics.world.creature.AvatarFilter" />
									<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
										<predicates>
											<Item type="gameMechanics.constructor.basicElements.PredicateOr">
												<predicates>
													<Item type="gameMechanics.elements.predicates.PredicateFaction">
														<faction href="/World/Factions/Wild.xdb" />
													</Item>
													<Item type="gameMechanics.elements.predicates.PredicateFaction">
														<faction href="/World/Factions/Neutral.xdb" />
													</Item>
												</predicates>
											</Item>
										</predicates>
									</Item>
								</filters>
							</Item>
							<Item type="gameMechanics.world.creature.AliveFilter" />
						</filters>
					</filter>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="ExplosionVisual.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactKill" />
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Rotate</Item>
				<Item>Move</Item>
				<Item>Jump</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
				<Item type="gameMechanics.constructor.basicElements.PredicateGenericNot">
					<predicate type="gameMechanics.constructor.schemes.buff.BuffInGroup">
						<groups>
							<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
						</groups>
					</predicate>
				</Item>
			</predicates>
			<removeExistingBuffs>true</removeExistingBuffs>
		</Item>
		<Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
		<Item type="gameMechanics.elements.effects.ImmunityToHarmfulSpells" />
	</effects>
	<duration>5000</duration>
	<isHelpful>true</isHelpful>
	<ranks />
	<canBeSaved>false</canBeSaved>
	<groups />
</gameMechanics.constructor.schemes.buff.BuffResource>
