<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readyCast</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Smeyana_Vishata_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>250</delay>
						<effectFx href="/Spells/FX/Mobs/Smeyana_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<locator>Slot_Global</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>150</delay>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectLightningWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<locator>Slot_Glove_L</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
