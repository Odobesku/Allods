<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionList">
			<elements>
				<Item type="VisActionDelay">
					<time>1000</time>
				</Item>
				<Item type="VisActionChangeVisObject">
					<newVisMob href="/Characters/Orc_male/Instances/UmoirIsland04/OrcGuard.(VisualMob).xdb#xpointer(/VisualMob)" />
				</Item>
			</elements>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/CreaturesTransform.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
	</action>
	<postAction type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/CreaturesTransform.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fixPoint>true</fixPoint>
			</Item>
		</visualEffects>
	</postAction>
</BuffVisScripts>
