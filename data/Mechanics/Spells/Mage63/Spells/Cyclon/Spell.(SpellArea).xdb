<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>207990</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/IceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
    </groups>
    <element>COLD</element>
    <Name href="Spell.(SpellArea).Name.txt" />
    <Description href="Spell.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>MagicScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Mage/IceStorm.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mage/IceStorm.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>5000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTPoint</targetType>
    <ranks>
        <Item href="Spell01.(SpellArea).xdb" />
        <Item href="Spell02.(SpellArea).xdb" />
        <Item href="Spell03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <channelingMechanics>
            <channelingBuff hrefvar="channelingBuff" />
            <finishImpacts>
                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                    <mark href="/Mechanics/Spells/Mage63/Abilities/IceRoot/Mark.(MarkResource).xdb" />
                </Item>
            </finishImpacts>
        </channelingMechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    </moveType>
                    <resource href="Proj.(ProjectileResource).xdb" />
                </projectileData>
            </Item>
        </casterImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>