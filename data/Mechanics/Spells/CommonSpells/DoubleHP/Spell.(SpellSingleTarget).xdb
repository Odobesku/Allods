<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>200183</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <contextActionInfo>
        <priority>103</priority>
    </contextActionInfo>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <element>ASTRAL</element>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <level>12</level>
    <prepareDuration>4000</prepareDuration>
    <isAggro>false</isAggro>
    <modifiers>
        <Item type="gameMechanics.elements.spell.RaiseRepelType" />
    </modifiers>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>60000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
            </Item>
        </targetConditions>
        <conditions>
            <Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
                <affectGroup>Raid</affectGroup>
            </Item>
        </conditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>50</mana>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                        <mark href="AttachingDoubleHP.(MarkResource).xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                        <impactsElse>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsElse>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>