			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInZone">
							<zone href="/Maps/Umoir/Zones/Umoir/Umoir.(ZoneResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactTeleport">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>U_1_07_loc</scriptID>
									<map href="/Maps/Umoir/MapResource.xdb" />
								</locator>
							</destination>
							<finishImpacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="U_1_07_final_stun.(BuffResource).xdb" />
								</Item>
							</finishImpacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="/World/Quests/Umoir/U_1_07/CountId_1.xdb" />
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
							<quest href="/World/Quests/Umoir/U_1_07/U_1_07.xdb" />
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>1000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
							<data href="/Mechanics/Spells/QuestSpells/E2_Immortality/KnockDown.(ClientData).xdb" />
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Jump</Item>
				<Item>Move</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>3000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
							<data href="/Spells/ClientData/FadeOutScreen.(ClientData).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
							<data href="/Items/InteractiveObjects/ArchipelagoContested5/AC5_K_10_firewood/FadeOutSound.(ClientData).xdb" />
						</Item>
					</impactsOn>
				</Item>
			</effects>
