					<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
						<rule href="/Mechanics/Rules/HighEnd7/Season4.(RuleResource).xdb" />
					</Item>
				</predicates>
				<number>20</number>
			</Item>
