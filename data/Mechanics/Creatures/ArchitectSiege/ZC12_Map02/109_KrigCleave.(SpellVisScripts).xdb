<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>special01</Item>
				</animations>
				<advanced>
					<speed>1.5</speed>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>125</time>
					</Item>
					<Item type="CreatureLockRotationAction" />
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<offendTime type="EffectOffendConstDelay" />
			</Item>
		</visualEffects>
	</launch>
</SpellVisScripts>
