<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureVisCharacterAction">
					<visCharList>
						<Item href="/Characters/Undead_female/UndeadFemale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Undead_male/UndeadMale.(VisCharacterTemplate).xdb" />
					</visCharList>
				</playWhile>
				<elements>
					<Item type="VisActionDelay">
						<time>800</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Psionic70_Archont.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>1.3</scale>
								<fadeInTime>200</fadeInTime>
								<fadeOutTime>100</fadeOutTime>
								<locator>Slot_BodyFX</locator>
								<member>Group</member>
								<offendTime />
								<offset z="0.3" />
								<ignoreParentRotation>true</ignoreParentRotation>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureVisCharacterAction">
					<visCharList>
						<Item href="/Characters/Elf_female/ElfFemale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Elf_male/ElfMale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Gibberlings/GibberlingFemale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Gibberlings/GibberlingMale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Hadagan_female/HadaganFemale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Hadagan_male/HadaganMale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Kania_female/KaniaFemale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Kania_male/KaniaMale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Orc_female/OrcFemale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Orc_male/OrcMale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Praiden_female/PraidenFemale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Praiden_male/PraidenMale.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Giberling_Group/GiberlingFamily.(VisCharacterTemplate).xdb" />
						<Item href="/Characters/Giberling_Group/GiberlingGroup.(VisCharacterTemplate).xdb" />
					</visCharList>
				</playWhile>
				<elements>
					<Item type="VisActionDelay">
						<time>800</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Psionic70_Archont.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<fadeInTime>200</fadeInTime>
								<fadeOutTime>100</fadeOutTime>
								<locator>Slot_BodyFX</locator>
								<member>Group</member>
								<offendTime />
								<offset z="0.3" />
								<ignoreParentRotation>true</ignoreParentRotation>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
	<postAction />
</BuffVisScripts>
