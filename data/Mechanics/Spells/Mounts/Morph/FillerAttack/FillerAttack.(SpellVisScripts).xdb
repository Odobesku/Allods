<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <playWhile />
        <elements>
            <Item type="CreatureSetFlagAction">
                <flagName>Flag_MountNeeded</flagName>
                <timeOut>0.5</timeOut>
            </Item>
            <Item type="VisActionList">
                <playWhile type="PredicateCreatureFlagAction">
                    <flagName>Flag_Emote</flagName>
                </playWhile>
                <elements>
                    <Item type="VisActionDelay">
                        <time>500</time>
                    </Item>
                </elements>
            </Item>
            <Item type="VisActionList">
                <playWhile />
                <elements>
                    <Item type="VisActionList">
                        <play>Simultaneously</play>
                        <playWhile />
                        <elements>
                            <Item type="CreatureAnimationAction">
                                <mode>DIE</mode>
                                <use>USE_ANIMATIONS</use>
                                <animations>
                                    <Item>attack</Item>
                                </animations>
                                <channel>CHANNEL_KNOCKDOWN</channel>
                                <channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
                                <channelOverrideScript />
                                <advanced>
                                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                                    <stopIfMoved>true</stopIfMoved>
                                    <eventPlaybackEnd>true</eventPlaybackEnd>
                                    <waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
                                </advanced>
                            </Item>
                            <Item type="CreatureEffectsAction">
                                <visualEffects>
                                    <Item>
                                        <effectFx href="/Spells/FX/Mobs/MountChopper_Shot01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                        <effectAlias href="" />
                                        <scale>1.2</scale>
                                        <locator>Slot_Hand_R</locator>
                                        <member>Mount</member>
                                        <locatorName />
                                        <offendTime />
                                    </Item>
                                </visualEffects>
                            </Item>
                            <Item type="CreatureChannelDirectAction">
                                <channelingFx href="/Spells/FX/Mobs/MountChopper_Shot_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <fxLength>11</fxLength>
                                <startPoint type="VisPointLocator">
                                    <locator>Slot_Hand_R</locator>
                                    <member>Mount</member>
                                </startPoint>
                                <endPoint type="VisPointLocator">
                                    <locator>Slot_FX</locator>
                                    <member>All_Members</member>
                                </endPoint>
                            </Item>
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
    <playOnTargets>
        <specialAction type="CreatureEffectsAction">
            <visualEffects />
        </specialAction>
    </playOnTargets>
</SpellVisScripts>