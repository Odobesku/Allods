                        <forAllRanks>true</forAllRanks>
                    </mulCalcer>
                    <sum>1</sum>
                </rawManaScaler>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactHeal">
                <heal var="heal" />
                <threatMultiplier>1</threatMultiplier>
                <scalerCaster type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
