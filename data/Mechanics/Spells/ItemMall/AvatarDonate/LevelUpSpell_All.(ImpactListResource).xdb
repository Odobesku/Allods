<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>211114</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/AvatarDonate65Unlock.(UnlockResource).xdb" />
                </Item>
            </predicates>
            <elseImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                    <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/AvatarDonate65Unlock.(UnlockResource).xdb" />
                </Item>
            </elseImpacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactAddMoney">
            <sumCalcer type="gameMechanics.elements.calcers.LongData">
                <value>150000000</value>
            </sumCalcer>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactDropLoot">
            <lootTable href="/Mechanics/Spells/ItemMall/AvatarDonate/LevelUpLootTablt.(LootTableResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactAddReputation">
            <faction href="/World/Factions/Umoir/Umoir_Believers.(Faction).xdb" />
            <value>27500</value>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
            <currency href="/Mechanics/AlternativeCurrencies/Myrrh.xdb" />
            <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                <value>10000</value>
            </sumCalcer>
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="/Mechanics/Spells/PridenFactionChoise/CastMeFasterPls.(BuffResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactAddReputation">
            <faction href="/World/Factions/ZoneContested8/ZC8_GuardTekuani.(Faction).xdb" />
            <value>50000</value>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
            <item hrefvar="item" />
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>