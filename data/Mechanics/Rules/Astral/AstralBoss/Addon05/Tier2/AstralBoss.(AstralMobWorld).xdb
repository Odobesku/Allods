                                                <multiplier>20</multiplier>
                                            </scaler>
                                            <source>Kill</source>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsToAllTaggers>
                </Item>
                <Item type="gameMechanics.elements.effects.DeathTrigger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.AbsolutePos">
