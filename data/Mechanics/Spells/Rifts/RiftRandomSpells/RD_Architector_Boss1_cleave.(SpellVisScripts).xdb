<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="VisActionDelay">
							<time>300</time>
						</playWhile>
						<elements>
							<Item type="CreatureAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>ready</Item>
								</animations>
							</Item>
						</elements>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>CLAMP</mode>
						<animations>
							<Item>attack02</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
						<advanced>
							<speed>0.5</speed>
						</advanced>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>1500</delay>
						<effectFx href="/Spells/FX/Mobs/Architect_Swarm_Split_Ground_Crack_02.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureRotateToCastPointAction" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ArchitectBot_BodyFX.(VisObjectTemplate).xdb" />
						<lockScale>false</lockScale>
						<scale>2</scale>
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ArchitectBot_BodyFX.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<scale>2</scale>
						<locator>Slot_Head</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
