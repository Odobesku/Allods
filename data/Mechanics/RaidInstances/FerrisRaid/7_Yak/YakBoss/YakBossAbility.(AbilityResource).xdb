<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>220765</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Charge/TargetBuff.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro">
                                    <value>100</value>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="Charge/ChargeSpell.(SpellArea).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Start</Item>
            </stages>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectNoAggroChecks" />
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                            <variable href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/CorruptedYak.(MapVariableResource).xdb" />
                            <summand>1</summand>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                            <device>
                                <scriptID>7_chest_hm</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </device>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                            <device>
                                <scriptID>7_chest</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </device>
                        </Item>
                    </impactsElse>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>FR_7_Door_Out</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Open</switchType>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAbility">
            <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro" />
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                            <zone href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/FightZone.(ScriptZone).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                            <destination type="gameMechanics.map.destination.DestinationLocatorSpread">
                                                <locator>
                                                    <scriptID>FR_7_Entrance</scriptID>
                                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                </locator>
                                                <horizontalSpread>5</horizontalSpread>
                                            </destination>
                                            <finishImpacts>
                                                <Item type="gameMechanics.elements.abilities.ImpactClearTimeLapseHistory" />
                                            </finishImpacts>
                                        </Item>
                                    </impactsElse>
                                </Item>
                                <Item type="gameMechanics.elements.abilities.ImpactClearTimeLapseHistory" />
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>FR_7_Door_In_1</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Close</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>FR_7_Door_In_2</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Close</switchType>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>FR_7_Door_In_1</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Open</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>FR_7_Door_In_2</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Open</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                    <group href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
            <quality href="/Mechanics/RaidInstances/FerrisRaid/Other/Part2_Stats.(MobStatQuality).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.5</coeff>
            </scaler>
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/EnergySource/EnergySourcePlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/EnergySource/EnergySourcePlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>