			</place>
			<device href="/Items/InteractiveObjects/MW_Isle02/Resp_Blue_01.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
			<respawnLocator>
				<scriptID>Blue_enter_01</scriptID>
				<map href="/Maps/MW_Isle02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
			</respawnLocator>
		</Item>
		<Item type="gameMechanics.map.Locator">
			<scriptID>Blue_enter_02</scriptID>
