    <descTemplate href="Spell01_Desc.txt.template" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>6</value>
    </range>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>1000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <impactsOnHitTarget>
                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                            <value>0.15</value>
                        </chanceCalcer>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactIncrementBuffDuration">
                                        <buff href="Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <delta type="gameMechanics.elements.calcers.FloatData">
                                            <value>6000</value>
                                        </delta>
                                    </Item>
                                </impactsIf>
                                <impactsElse>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impacts>
                    </Item>
                </impactsOnHitTarget>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                <minDamage>7</minDamage>
                <maxDamage>7</maxDamage>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>