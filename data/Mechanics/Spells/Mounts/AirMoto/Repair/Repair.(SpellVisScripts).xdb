<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/MountChopper_Energize_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<scale>1.5</scale>
						<locator>Slot_Global</locator>
						<member>Assaulter</member>
						<locatorName>Hips</locatorName>
						<offset x="1.3" y="-1" z="-0.5" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>spells/Mount/MountChopper/Repair</name>
				</sound>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
