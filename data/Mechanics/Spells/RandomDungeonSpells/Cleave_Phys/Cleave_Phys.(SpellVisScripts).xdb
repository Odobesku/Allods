<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>1000</time>
                    </Item>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/WarriorCleaveAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>200</time>
                    </Item>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>attack02</Item>
                        </animations>
                        <advanced>
                            <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                        </advanced>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>