        <minTurnRadius>15</minTurnRadius>
        <minVelocity>6</minVelocity>
        <minVelocityPitch>1</minVelocityPitch>
        <pitchMaxVelocity>60</pitchMaxVelocity>
        <topVelocity>10</topVelocity>
        <topVelocityPitch>30</topVelocityPitch>
    </pitchParameters>
    <reinsSettings>
