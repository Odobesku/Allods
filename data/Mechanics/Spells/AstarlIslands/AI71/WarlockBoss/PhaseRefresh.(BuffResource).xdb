                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                                    <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                                        <base type="gameMechanics.map.destination.SelfPosDestination" />
                                                        <offset>12</offset>
                                                    </destination>
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="/Mechanics/Spells/AstarlIslands/AI71/GhoulBombAdd/ChaserBuff.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                    <object href="/Mechanics/Spells/AstarlIslands/AI71/GhoulBombAdd/GhoulBombAdd.(MobWorld).xdb" />
                                                    <pool href="/Mechanics/Spells/AstarlIslands/AI71/Common/AI71Pool.(SummonPool).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>20000</tick>
            <initialDelay>3000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
