<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>1500</time>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="VisActionList">
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/PaladinBladeofJusticeAbility_StartSmoke.(VisObjectTemplate).xdb" />
										<fixPoint>true</fixPoint>
										<locator>Slot_Global</locator>
									</Item>
									<Item>
										<effectFx href="/Spells/FX/Spells/YakGlacialChief_Charge_FX.(VisObjectTemplate).xdb" />
									</Item>
								</visualEffects>
							</Item>
							<Item type="CreatureTrailAction">
								<mainHandTrail href="/Spells/FX/InterfaceFX/TrailBlood.(TrailTemplate).xdb" />
							</Item>
						</elements>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>runCharge</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
						<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
						<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<elements>
			<Item type="CreatureTrailAction">
				<mainHandTrail href="/Spells/FX/InterfaceFX/TrailHoly.(TrailTemplate).xdb" />
				<offHandTrail href="" />
				<creatureTrail href="" />
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
