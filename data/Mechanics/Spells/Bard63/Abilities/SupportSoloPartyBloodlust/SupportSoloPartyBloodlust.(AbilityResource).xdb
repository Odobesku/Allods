											<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
												<coeff var="coeff" />
											</scaler>
										</Item>
									</effects>
									<onBehalfOfHolder>true</onBehalfOfHolder>
								</Item>
							</modifiers>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.AbilityUnlockerEffect">
			<abilities>
				<Item href="/Mechanics/Spells/Bard63/Abilities/CommonBuffProxy/DefenseSupportProxyAbility.(AbilityResource).xdb" />
