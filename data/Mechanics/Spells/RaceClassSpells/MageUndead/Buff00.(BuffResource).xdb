<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>196735</resourceId>
    </Header>
    <Name href="Buff00.(BuffResource).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffURFireRay.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/HitFire_Staff01.(VisObjectTemplate).xdb" />
            <locator>Slot_BodyFX</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <tickLength>1000</tickLength>
                <damagePerTick>9</damagePerTick>
                <affectedByDoubleAttack>true</affectedByDoubleAttack>
            </parameters>
            <element>FIRE</element>
            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>0.5</multiplier>
                    </durationScaler>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>0.5</multiplier>
                    </durationScaler>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>6000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>