<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound/>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>200</fadeOutMS>
    <geometry href="/Spells/FX/Spells/AstralDirectDamage_Channel.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)"/>
    <particle href="/Spells/FX/Spells/AstralDirectDamage_Channel.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)"/>
    <scale>0.25</scale>
    <sound/>
    <states>
        <Item>
            <keySounds>
                <Item>
                    <tunedSounds>
                        <Item>
                            <sound>
                                <name>spells/Hits/FireHit</name>
                                <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)"/>
                            </sound>
                            <volume>1</volume>
                            <overrideMoveSFX>false</overrideMoveSFX>
                        </Item>
                    </tunedSounds>
                </Item>
            </keySounds>
            <sound/>
            <allowMultipleSoundInstances>true</allowMultipleSoundInstances>
            <playSoundOnKeys>false</playSoundOnKeys>
            <animation href="/Spells/FX/Spells/AstralDirectDamage_Channel.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)"/>
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>
