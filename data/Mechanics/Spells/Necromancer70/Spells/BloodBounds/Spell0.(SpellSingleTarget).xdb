<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739933230</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceHealTrigger.xdb" />
        <Item href="/Mechanics/Spells/Groups/HealDamage.(ActionGroup).xdb" />
    </groups>
    <element>SHADOW</element>
    <Name href="Spell0_Name.txt" />
    <Description href="Spell0_Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="heal" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>HealScaler</formula>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value var="mul" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>var2</name>
            <value var="damage_self" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Buffs/BuffMartyr01.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Necromancer/Bloodpact.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>3000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.predicates.PredicateIsPet" />
                </predicates>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ExecuteImpactsUnderEffects">
                <effects>
                    <Item type="gameMechanics.elements.abilities.DieHardObserver">
                        <dieHardBuff href="/Mechanics/Spells/Necromancer70/Abilities/SafeBuff/Safebuff.(BuffResource).xdb" />
                        <impactsOnAttach>
                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                        <buff href="/Mechanics/Spells/Necromancer70/Abilities/SafeBuff/Safebuff.(BuffResource).xdb" />
                                        <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnAttach>
                        <suppressDamage>true</suppressDamage>
                    </Item>
                </effects>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.PureDamage">
                        <damage>1</damage>
                        <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="gameMechanics.elements.calcers.HealthCalcer">
                                <multiplier var="mul" />
                            </mulCalcer>
                            <sum>0</sum>
                        </scaler>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                        <variable href="/Mechanics/Spells/Necromancer70/Abilities/BloodDrops/BloodPool.(VariableResource).xdb" />
                        <summand>1</summand>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.PureHeal">
                <heal>1</heal>
                <threatMultiplier>1</threatMultiplier>
                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mul var="mul" />
                    <mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
                        <calcers>
                            <Item type="gameMechanics.elements.calcers.HealthInferiorityCalcer" />
                            <Item type="gameMechanics.elements.calcers.FullHealthCalcer" />
                        </calcers>
                    </mulCalcer>
                    <sum>-1</sum>
                </scalerTarget>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactHeal">
                <heal var="heal" />
                <scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>