<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.CreatureHangInAirAction">
        <hangHeight>1</hangHeight>
        <verticalSpeed>5</verticalSpeed>
      </Item>
      <Item type="client.Replica.CreatureReplaceAnimationsAction">
        <member>Default_Member</member>
        <onBottom>
          <animationsReplacements>
            <Item>
              <forAnimations>
                <Item>jump</Item>
              </forAnimations>
              <play>fly</play>
            </Item>
          </animationsReplacements>
          <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
        </onBottom>
        <onMount>
          <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
        </onMount>
        <onTop>
          <animationsReplacements>
            <Item>
              <forAnimations>
                <Item>jump</Item>
              </forAnimations>
              <play>stun</play>
            </Item>
          </animationsReplacements>
          <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
        </onTop>
        <replaceWhen>ReplaceAlways</replaceWhen>
        <restartOnVisualChange>false</restartOnVisualChange>
      </Item>
      <Item type="client.Replica.CreatureEffectsAction">
        <category>EFFECT_DEFAULT</category>
        <visualEffects>
          <Item>
            <delay>0</delay>
            <effectAnimations>
              <mode>DIE</mode>
            </effectAnimations>
            <effectFx href="/Spells/FX/Spells/TrinketChannelShadow_Hit.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <fadeInTime>0</fadeInTime>
            <fadeOutTime>0</fadeOutTime>
            <scale>1</scale>
            <fixPoint>false</fixPoint>
            <lockScale>false</lockScale>
            <muteFxSounds>false</muteFxSounds>
            <ignoreParentRotation>false</ignoreParentRotation>
            <locator>Global</locator>
            <member>Default_Member</member>
            <offset x="0" y="0" z="0" />
            <rotation x="0" y="0" z="0" w="0" />
            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
          </Item>
        </visualEffects>
        <dontFade>false</dontFade>
        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
        <stopOnDeath>false</stopOnDeath>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>