<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>186157</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Stuns.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="ShockWave.(SpellArea).Name.txt" />
    <visualScripts href="ShockWave.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="ShockWave.(SpellArea).Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>12</value>
    </range>
    <prepareDuration>200</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>16000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>12</radius>
                <affectGroup>Enemies</affectGroup>
                <affectHolder>false</affectHolder>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                        <minDamage>20</minDamage>
                        <maxDamage>20</maxDamage>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/AstarlIslands/UI03/PlotMain/StunSpell.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impacts>
                <filter type="gameMechanics.constructor.basicElements.FilterOr">
                    <filters>
                        <Item type="gameMechanics.world.creature.AvatarFilter">
                            <withPet>true</withPet>
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </predicates>
                        </Item>
                    </filters>
                </filter>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="RamStrikeChargeRecoil.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>3</multiplier>
                </durationScaler>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldownGeneric">
                <spell href="RamStrike.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                <factor>1</factor>
                <sum>2000</sum>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldownGeneric">
                <spell href="EarthCracking.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                <factor>1</factor>
                <sum>2000</sum>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>800</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="EarthShake.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>