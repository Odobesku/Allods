<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXProjectile>/Spells/FX/Mobs/Izba_ShotProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<Ge>20</Ge>
			<LocatorOnCaster>FROM_LOCATOR_NAME</LocatorOnCaster>
			<PreCastAnimation>readySpell</PreCastAnimation>
			<CastAnimation>spellCastDirected</CastAnimation>
			<FXOnCaster>/Spells/FX/Mobs/Izba_Cast_Door.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<FXProjectileHit>/Spells/FX/Mobs/Izba_HitShot.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
