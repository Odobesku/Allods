<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739865329</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Quest/DraconidHead.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
					<assistantResource href="/World/Quests/ArchipelagoContested5/AC5_D_2/Assistant.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
					<spell href="Summon_drakon_pet.(SpellCasterSelf).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.world.avatar.assistants.PredicateHasAssistant">
					<assistantResource href="/World/Quests/ArchipelagoContested5/AC5_D_2/Assistant.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.EffectIfOverTime">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMounted" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactIsolator">
							<impacts>
								<Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="PetPlane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</impacts>
									<assistantResource href="/World/Quests/ArchipelagoContested5/AC5_D_2/Assistant.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactIsolator">
							<impacts>
								<Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="PetPlane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.BuffDetacher">
													<buff href="PetPlane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
												</Item>
											</impactsIf>
										</Item>
									</impacts>
									<assistantResource href="/World/Quests/ArchipelagoContested5/AC5_D_2/Assistant.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
								</Item>
							</impacts>
						</Item>
					</impactsElse>
					<tick type="gameMechanics.elements.calcers.FloatData">
						<value>2000</value>
					</tick>
				</Item>
			</effectsIf>
		</Item>
		<Item type="gameMechanics.elements.effects.BuffInterceptor">
			<impactsOnDetach>
				<Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
					<destination type="gameMechanics.map.destination.RelativeRotatePos">
						<base type="gameMechanics.map.destination.RelativePos">
							<yaw type="constructor.basicElements.AngleRadians" />
						</base>
						<offset>4</offset>
						<yaw type="constructor.basicElements.AngleRadians">
							<value>1.57</value>
						</yaw>
					</destination>
					<impacts>
						<Item type="gameMechanics.constructor.schemes.quest.trigger.ImpactAttachTrigger">
							<trigger href="TriggerEgoism.(TriggerResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.trigger.TriggerResource)" />
						</Item>
					</impacts>
					<assistantResource href="/World/Quests/ArchipelagoContested5/AC5_D_2/Assistant.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
					<mobResource href="/Creatures/DraconidWarrior/Instances/ArchipelagoContested5/DraconidPet.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
				</Item>
			</impactsOnDetach>
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
					<groups>
						<Item href="/Mechanics/Spells/Groups/Transport.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
					</groups>
				</Item>
			</predicates>
		</Item>
	</effects>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<isClientReplicated>false</isClientReplicated>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
