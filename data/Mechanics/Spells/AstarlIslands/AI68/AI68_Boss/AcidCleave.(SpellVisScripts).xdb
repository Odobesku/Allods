<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>readySpell</Item>
                </animations>
                <channel>CHANNEL_ABILITY</channel>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>specialCast</Item>
                </animations>
                <channel>CHANNEL_ABILITY</channel>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>400</delay>
                        <effectFx href="/Spells/FX/Mobs/HG4_Boss_Swamper_ReadyAcid.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fixPoint>true</fixPoint>
                        <fadeOutTime>1500</fadeOutTime>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>100</time>
                    </Item>
                    <Item type="CreatureRotateToCastPointAction" />
                </elements>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <advanced>
                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                </advanced>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/HG4_Boss_Swamper_CastAcid.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fixPoint>true</fixPoint>
                        <fadeInTime>100</fadeInTime>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectPoisonWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fixPoint>true</fixPoint>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>