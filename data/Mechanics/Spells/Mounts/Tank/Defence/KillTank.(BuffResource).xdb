<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739869113</resourceId>
	</Header>
	<visScript href="/Spells/VisScripts/Mount/MountTank_KillTank.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactKill" />
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectStatSetter">
			<stat type="gameMechanics.elements.stat.StatFullHealth" />
			<valueCalcer type="constructor.elements.CalcerFloatExternal">
				<externalCalcer href="/Mechanics/GameRoot/Mount/MountHealthCalcer.(CalcerFloatResource).xdb#xpointer(/constructor.elements.CalcerFloatResource)" />
			</valueCalcer>
		</Item>
	</effects>
	<duration>1000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>true</canBeSaved>
	<ignoreLevelDelta>true</ignoreLevelDelta>
	<groups>
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
