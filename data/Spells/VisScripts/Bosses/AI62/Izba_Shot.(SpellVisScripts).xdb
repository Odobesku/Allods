			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorNameOnCaster>Slot_Special01</LocatorNameOnCaster>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Izba_ReadySpell_Shot.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>1000</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<locator>Slot_Global</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Izba_ReadySpell_Door.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special01</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
