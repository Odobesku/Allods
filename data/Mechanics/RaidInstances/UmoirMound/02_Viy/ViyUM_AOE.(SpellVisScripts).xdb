<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXOnTargets />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<FXProjectile>/Spells/FX/Spells/Spore_Projectile02.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<PreCastAnimation>readySpellOmni</PreCastAnimation>
			<CastAnimation>specialCast</CastAnimation>
			<FXProjectileHit>/Spells/FX/Spells/UmoirViy_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<LocatorOnCaster>Slot_FX</LocatorOnCaster>
			<FXOnCaster />
			<ProjectileLocatorOnTarget>Slot_BodyFX</ProjectileLocatorOnTarget>
			<HitPostFXOnTargets />
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="PreCastAnimation" />
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>7</scale>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item skiped="" />
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="CastAnimation" />
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction" />
					<Item type="VisActionList">
						<elements>
							<Item skiped="" />
							<Item type="CreatureProjectileAction">
								<explosionFx hrefvar="FXProjectileHit" />
								<pointOnCaster type="VisPointLocator">
									<locator var="LocatorOnCaster" />
								</pointOnCaster>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
