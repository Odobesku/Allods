<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart />
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Bee_Fire_PreCast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.75</scale>
                        <fadeInTime>500</fadeInTime>
                        <fadeOutTime>500</fadeOutTime>
                        <locator>Slot_Hand_L</locator>
                        <locatorName>RightHand</locatorName>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>