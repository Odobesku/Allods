<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.gameRoot.QuestRoot>
    <Header>
        <resourceId>85276787</resourceId>
    </Header>
    <questsLimit>20</questsLimit>
    <worldSecrets href="WorldSecrets.xdb#xpointer(/gameMechanics.constructor.schemes.quest.WorldSecrets)" />
    <nextQuestFinder href="QuestFinder/Quest.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
    <destinyPointScaler type="gameMechanics.elements.scalers.ScalerIf">
        <condition type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/SkipQuest.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
        </condition>
        <scalerIf type="gameMechanics.elements.scalers.TrivialScaler" />
        <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
            <multiplier>0</multiplier>
        </scalerElse>
    </destinyPointScaler>
    <cursendDestinyPointScaler type="gameMechanics.elements.scalers.ScalerIf">
        <condition type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/P2P_shard/P2P_shard_Server.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
        </condition>
        <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
            <multiplier>0</multiplier>
        </scalerIf>
        <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
            <condition type="gameMechanics.elements.predicates.PredicateHasContentKey">
                <key href="/System/ContentKeys/SkipQuest.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
            </condition>
            <scalerIf type="gameMechanics.elements.scalers.TrivialScaler" />
            <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
                <multiplier>0</multiplier>
            </scalerElse>
        </scalerElse>
    </cursendDestinyPointScaler>
    <skipQuestPriceScaler type="gameMechanics.elements.scalers.LinearScaler">
        <multiplier>7</multiplier>
    </skipQuestPriceScaler>
    <skipQuestMaxLevel type="gameMechanics.elements.calcers.CalcerLevelCap" />
    <skipQuestKey href="/System/ContentKeys/SkipQuest.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
    <shareRange>20</shareRange>
    <grindingQuests href="/World/Quests/Groups/Gold_Grind.(QuestGroup).xdb" />
</gameMechanics.world.gameRoot.QuestRoot>