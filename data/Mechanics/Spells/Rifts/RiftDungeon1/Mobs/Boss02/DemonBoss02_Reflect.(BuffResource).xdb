<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>208264</resourceId>
    </Header>
    <Name href="DemonBoss02_Reflect.(BuffResource).Name.txt" />
    <Description href="DemonBoss02_Reflect.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/ReflectDemedzh.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Other/ReflectionDamage.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.offender.PredicateIsAE" />
                </Item>
            </predicates>
            <impacts>
                <targetToOffender>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="DemonBoss02_Reflect.(ClientData).xdb" />
                                <calcers>
                                    <resourceEntries />
                                    <addressEntries>
                                        <Item>
                                            <name>caster</name>
                                            <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                        </Item>
                                        <Item>
                                            <name>target</name>
                                            <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                        </Item>
                                    </addressEntries>
                                    <coordEntries />
                                    <stringEntries />
                                    <longEntries />
                                    <floatEntries />
                                </calcers>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>ASTRAL</element>
                                <scalerTarget type="gameMechanics.elements.scalers.ScalerBuff">
                                    <buff href="RD_Humanoid_Boss1_ReflectStacks.(BuffResource).xdb" />
                                    <summand>0</summand>
                                    <stackCountSummand>1</stackCountSummand>
                                </scalerTarget>
                                <damage>1</damage>
                                <impactsOnHitTarget />
                                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                    <scalers>
                                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/IncreasingDamageBoss.(CalcerFloatResource).xdb" />
                                            </mulCalcer>
                                        </Item>
                                    </scalers>
                                </scaler>
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="RD_Humanoid_Boss1_ReflectStacks.(BuffResource).xdb" />
                            </Item>
                        </impactsIf>
                    </Item>
                </targetToOffender>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.9</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                        <range min="0" max="1" />
                        <withinRange>false</withinRange>
                        <minCandidatesCount>0</minCandidatesCount>
                        <targetCount>0</targetCount>
                    </selector>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="RD_Humanoid_Boss1_ReflectStacks.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>6000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>