            <filter type="gameMechanics.world.creature.CreatureFilter" />
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="RD_Humanoid_Boss3_BigAE_Shield.(BuffResource).xdb" />
