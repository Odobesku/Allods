<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.QuestResource>
    <Header>
        <resourceId>318390</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Quest_Learn_Talents_Prototype.(QuestResource).Name.txt" />
    <goal href="Quest_Learn_Talents_Prototype.(QuestResource).Goal.txt" />
    <checkText href="Quest_Learn_Talents_Prototype.(QuestResource).CheckText.txt" />
    <finishText href="Quest_Learn_Talents_Prototype.(QuestResource).FinishText.txt" />
    <finisher type="gameMechanics.elements.quest.QuestFinisherMob">
        <mobWorld hrefvar="QuestFinisher" />
    </finisher>
    <startImpacts>
        <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                <item href="/Items/CraftingObjects/Rubies/Ruby/Tutorial/RecipeTutorial.(ItemResource).xdb" />
            </item>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasSkill">
                    <skill href="/Mechanics/Skills/Rubies/Rubies.xdb" />
                </Item>
            </predicates>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.ImpactLearnSkill">
                    <skill href="/Mechanics/Skills/Rubies/Rubies.xdb" />
                </Item>
            </impactsElse>
        </Item>
    </startImpacts>
    <rewardImpacts>
        <Item type="gameMechanics.elements.impacts.ImpactRemoveSkill">
            <skill href="/Mechanics/Skills/Rubies/Rubies.xdb" />
        </Item>
    </rewardImpacts>
    <abandonImpacts>
        <Item type="gameMechanics.elements.impacts.ImpactRemoveSkill">
            <skill href="/Mechanics/Skills/Rubies/Rubies.xdb" />
        </Item>
    </abandonImpacts>
    <startConditions>
        <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/ItemmallService.(ContentKey).xdb" />
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                <unlock href="/Mechanics/Unlocks/AltCurrencies/Quest_Learn_All_Talents_Ruby_Unlock.xdb" />
            </predicate>
        </Item>
    </startConditions>
    <counters>
        <Item type="gameMechanics.elements.quest.QuestCountItem">
            <autoRelatedItems>
                <Item href="/Items/CraftingObjects/Rubies/Resources/RubyNormal.(ItemResource).xdb" />
                <Item href="/Items/CraftingObjects/Rubies/Resources/BindNoneRubies/RubyNormal.(ItemResource).xdb" />
            </autoRelatedItems>
            <relatedItems>
                <Item href="/Items/CraftingObjects/Rubies/Ruby/Tutorial/RecipeTutorial.(ItemResource).xdb" />
            </relatedItems>
            <limit>100</limit>
            <items>
                <Item href="/Items/CraftingObjects/Rubies/Resources/RubyNormal.(ItemResource).xdb" />
                <Item href="/Items/CraftingObjects/Rubies/Resources/BindNoneRubies/RubyNormal.(ItemResource).xdb" />
            </items>
            <removeOnAbandon>false</removeOnAbandon>
        </Item>
        <Item type="gameMechanics.elements.quest.QuestCountItem">
            <autoRelatedItems>
                <Item href="/Items/CraftingObjects/Rubies/Resources/RubyUncommon.(ItemResource).xdb" />
                <Item href="/Items/CraftingObjects/Rubies/Resources/BindNoneRubies/RubyUncommon.(ItemResource).xdb" />
            </autoRelatedItems>
            <relatedItems>
                <Item href="/Items/CraftingObjects/Rubies/Ruby/Tutorial/RecipeTutorial.(ItemResource).xdb" />
            </relatedItems>
            <limit>80</limit>
            <items>
                <Item href="/Items/CraftingObjects/Rubies/Resources/RubyUncommon.(ItemResource).xdb" />
                <Item href="/Items/CraftingObjects/Rubies/Resources/BindNoneRubies/RubyUncommon.(ItemResource).xdb" />
            </items>
            <removeOnAbandon>false</removeOnAbandon>
        </Item>
        <Item type="gameMechanics.elements.quest.QuestCountItem">
            <autoRelatedItems>
                <Item href="/Items/CraftingObjects/Rubies/Resources/RubyRare.(ItemResource).xdb" />
                <Item href="/Items/CraftingObjects/Rubies/Resources/BindNoneRubies/RubyRare.(ItemResource).xdb" />
            </autoRelatedItems>
            <relatedItems>
                <Item href="/Items/CraftingObjects/Rubies/Ruby/Tutorial/RecipeTutorial.(ItemResource).xdb" />
            </relatedItems>
            <limit>60</limit>
            <items>
                <Item href="/Items/CraftingObjects/Rubies/Resources/RubyRare.(ItemResource).xdb" />
                <Item href="/Items/CraftingObjects/Rubies/Resources/BindNoneRubies/RubyRare.(ItemResource).xdb" />
            </items>
            <removeOnAbandon>false</removeOnAbandon>
        </Item>
    </counters>
    <triggerAgents>
        <Item type="gameMechanics.elements.trigger.TriggerAgentSelf">
            <trigger href="Quest_Learn_Talents.(TriggerResource).xdb" />
            <detachesOnDeath>false</detachesOnDeath>
        </Item>
    </triggerAgents>
    <reward>
        <experience>1</experience>
        <unlocks>
            <Item href="/Mechanics/Unlocks/AltCurrencies/Quest_Learn_All_Talents_Ruby_Unlock.xdb" />
        </unlocks>
    </reward>
    <internalName>Quest_Learn_Talents_WAR</internalName>
    <zone href="/Maps/Kania/Zones/ZoneLeague1/ZoneLeague1.(ZoneResource).xdb" />
    <canBeSkipped>false</canBeSkipped>
    <skippedExp>1</skippedExp>
    <requiredLevel type="gameMechanics.formulas.IntConstantValue">
        <value>40</value>
    </requiredLevel>
    <level type="gameMechanics.formulas.IntConstantValue">
        <value>40</value>
    </level>
</gameMechanics.constructor.schemes.quest.QuestResource>