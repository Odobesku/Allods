<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readySpellOmniWand</Item>
		</animations>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmniWand</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>250</time>
					</Item>
					<Item type="CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Spells/PriestChainSmite_ChannelSecondary.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<startPoint type="VisPointLocator">
							<locator>Wand_Slot_FX</locator>
						</startPoint>
						<endPoint type="VisPointLocator">
							<locator>Slot_FX</locator>
						</endPoint>
					</Item>
					<Item type="CreatureEffectsOnTarget">
						<visualEffects>
							<Item>
								<delay>100</delay>
								<effectFx href="/Spells/FX/Spells/HitHoly.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>1.25</scale>
								<locator>Slot_FX</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
