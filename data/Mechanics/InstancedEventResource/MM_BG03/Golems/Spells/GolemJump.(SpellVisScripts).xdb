<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/OmniNoWand.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation />
			<LocatorNameOnTargets />
			<FXOnTargets />
			<CastAnimation>jumpStart</CastAnimation>
			<FixPointTarget>true</FixPointTarget>
			<FXOnCaster />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorNameOnCaster />
			<PreCastFX />
			<FXWand />
			<FixPointCaster>false</FixPointCaster>
			<FXPocket />
			<HitPostFXOnTargets />
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Ready_HowlingStrike.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.2</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements />
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2500</time>
		</playWhile>
		<elements />
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item skiped="" />
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
