<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739907717</resourceId>
    </Header>
    <Name href="ChainLightning.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
                    <phantom href="Thunderbird.(MobWorld).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>LIGHTNING</element>
                            <damage>10</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectJumpOnDetach">
            <jumps type="gameMechanics.elements.calcers.LongData">
                <value>4</value>
            </jumps>
            <buff href="ChainLightning1.(BuffResource).xdb" />
            <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.FilteringAutotarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
                <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.RandomAutotarget">
                    <group>All</group>
                </autotarget>
            </autotarget>
            <onBehalfOfCaster>true</onBehalfOfCaster>
            <radius>20</radius>
            <inCasterRange>false</inCasterRange>
            <renewingEffects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="/Mechanics/Spells/AstarlIslands/AI21/DruidChainLightning/ChainLightning_Long.(ClientData).xdb" />
                            <calcers>
                                <addressEntries>
                                    <Item>
                                        <name>caster</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    </Item>
                                    <Item>
                                        <name>target</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                    </Item>
                                </addressEntries>
                            </calcers>
                        </Item>
                    </impactsOff>
                </Item>
            </renewingEffects>
        </Item>
    </effects>
    <duration>50</duration>
    <isStackable>false</isStackable>
    <stackLimit>3</stackLimit>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>