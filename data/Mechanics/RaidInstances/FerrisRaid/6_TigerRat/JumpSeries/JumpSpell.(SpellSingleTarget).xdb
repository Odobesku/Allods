<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739900625</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
	</groups>
	<Name href="JumpSpell.(SpellSingleTarget).Name.txt" />
	<visualScripts href="TurnToTarget.(SpellVisScripts).xdb" />
	<prepareDuration>500</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>250000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="JumpTarget.(BuffResource).xdb" />
			</Item>
		</targetConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="JumpResource.(BuffResource).xdb" />
				<consumeStacks>1</consumeStacks>
			</Item>
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
				<time>1000</time>
				<impactsOnLand>
					<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
						<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
						<data href="/Spells/ClientData/HowlingStrike.(ClientData).xdb" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="JumpResource.(BuffResource).xdb" />
								<consumeStacks>1</consumeStacks>
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
								<spell href="JumpSpell.(SpellSingleTarget).xdb" />
							</Item>
						</impactsIf>
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<radius>6.75</radius>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
								<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
								<minDamage>25</minDamage>
								<maxDamage>25</maxDamage>
							</Item>
						</impacts>
						<filter type="gameMechanics.world.creature.AvatarFilter" />
						<targetsLimit>1</targetsLimit>
					</Item>
				</impactsOnLand>
				<turnToDestination>true</turnToDestination>
				<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
			</Item>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="/Mechanics/RaidInstances/FerrisRaid/6_TigerRat/Heed/JumpTargetSlowdown.(BuffResource).xdb" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
				<delay>1000</delay>
				<impacts>
					<Item type="gameMechanics.elements.impacts.BuffDetacher">
						<buff href="JumpTarget.(BuffResource).xdb" />
					</Item>
					<Item type="gameMechanics.elements.impacts.BuffDetacher">
						<buff href="/Mechanics/RaidInstances/FerrisRaid/6_TigerRat/Heed/JumpTargetSlowdown.(BuffResource).xdb" />
					</Item>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="/Mechanics/Spells/CommonBuffs/Bleed/Buff_02_01.xdb" />
						<stacks type="gameMechanics.elements.calcers.FloatData">
							<value>3</value>
						</stacks>
					</Item>
				</impacts>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
