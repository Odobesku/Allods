<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739925331</resourceId>
    </Header>
    <name href="AddCanonAfterBarrierEnding.(AbilityResource).Name.txt" />
    <description href="AddCanonAfterBarrierEnding.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Plate/GlovesKnight.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BarrierResolvedTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                        <value>0.5</value>
                                    </chanceCalcer>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable href="/Mechanics/Spells/Paladin63/Abilities/Canons/LightCanon.(VariableResource).xdb" />
                                        </Item>
                                    </impacts>
                                    <impactsLose>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable href="/Mechanics/Spells/Paladin63/Abilities/Canons/PurityCanon.(VariableResource).xdb" />
                                        </Item>
                                    </impactsLose>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <resolveType>TimeOutOnly</resolveType>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>