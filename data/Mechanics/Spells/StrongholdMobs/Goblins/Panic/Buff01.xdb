                <multiplier>0.1</multiplier>
            </healthCalcer>
            <ownerDamageFactor type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </ownerDamageFactor>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="Buff_04_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <durationScaler type="gameMechanics.elements.scalers.RandomScaler">
                                        <range>
