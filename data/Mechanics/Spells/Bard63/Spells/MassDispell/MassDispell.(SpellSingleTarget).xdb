<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>215459</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="MassDispell.(SpellSingleTarget).Name.txt" />
    <Description href="MassDispell.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="multiplier2" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/Bis.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Bard/MassDispell.(SpellVisScripts).xdb" />
    <prepareDuration var="prepareDuration" />
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="MassDispell01.(SpellSingleTarget).xdb" />
        <Item href="MassDispell02.(SpellSingleTarget).xdb" />
        <Item href="MassDispell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
                <sub var="sub" />
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                        <radius>40</radius>
                        <affectPets>true</affectPets>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="Visual.(ClientData).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.MassBuffDetacher">
                                <predicates>
                                    <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                                        <groups>
                                            <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
                                            <Item href="/Mechanics/Spells/Groups/Poisons.xdb" />
                                            <Item href="/Mechanics/Spells/Groups/Diseases.xdb" />
                                            <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                        </groups>
                                    </Item>
                                </predicates>
                                <detachCount type="gameMechanics.elements.calcers.LongData">
                                    <value>1</value>
                                </detachCount>
                                <impactsOnHolder>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                                            </Item>
                                        </predicates>
                                        <impactsElse>
                                            <Item type="gameMechanics.elements.impacts.RandomImpact">
                                                <entries>
                                                    <Item>
                                                        <impacts>
                                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Power/Power.(BuffResource).xdb" />
                                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                    <multiplier var="multiplier2" />
                                                                </durationScaler>
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                    <Item>
                                                        <impacts>
                                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Agility/Agility.(BuffResource).xdb" />
                                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                    <multiplier var="multiplier2" />
                                                                </durationScaler>
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                    <Item>
                                                        <impacts>
                                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Strength/Strength.(BuffResource).xdb" />
                                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                    <multiplier var="multiplier2" />
                                                                </durationScaler>
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                    <Item>
                                                        <impacts>
                                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/WillPower/WillPower.(BuffResource).xdb" />
                                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                    <multiplier var="multiplier2" />
                                                                </durationScaler>
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                    <Item>
                                                        <impacts>
                                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Bloodlust/Bloodlust.(BuffResource).xdb" />
                                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                    <multiplier var="multiplier2" />
                                                                </durationScaler>
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                    <Item>
                                                        <impacts>
                                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Defence/Defence.(BuffResource).xdb" />
                                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                    <multiplier var="multiplier2" />
                                                                </durationScaler>
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                    <Item>
                                                        <impacts>
                                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/StatIncr/StatIncr01.(BuffResource).xdb" />
                                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                    <multiplier var="multiplier2" />
                                                                </durationScaler>
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                </entries>
                                            </Item>
                                        </impactsElse>
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="DispellAfterDispell.(BuffResource).xdb" />
                                    </Item>
                                </impactsOnHolder>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>