                </Item>
            </holderImpactsOnBreak>
            <maxLength>8</maxLength>
            <reconnect>true</reconnect>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="ChainVisual.(ClientData).xdb" />
                            <calcers>
                                <addressEntries>
                                    <Item>
                                        <name>target</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                    </Item>
                                    <Item>
                                        <name>caster</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    </Item>
                                </addressEntries>
                            </calcers>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EventTrigger">
            <eventClasses>
                <Item>gameMechanics.elements.events.EventDeath</Item>
            </eventClasses>
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LightChain.(BuffResource).xdb" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                </Item>
            </impacts>
            <eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
        </Item>
    </effects>
    <duration>6000</duration>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
