<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>8633</resourceId>
    </Header>
    <visScript href="/Mechanics/Spells/Instances/UmoirIsland02/PlayerSpells/Mount/UI02_Mount.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsToPet">
            <effects>
                <Item type="gameMechanics.elements.effects.AddPlane">
                    <plane href="/Mechanics/Spells/Instances/UmoirIsland02/PlayerSpells/Mount/UI02_Mount.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllSpells" />
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                    <zone href="UI02_JumpZone.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                                    <time>2000</time>
                                    <impactsOnLand>
                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                            <delay>1500</delay>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="Jump01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsOnLand>
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>JumpDestination</scriptID>
                                            <map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </locator>
                                        <yaw type="constructor.basicElements.AngleDegrees">
                                            <value>90</value>
                                        </yaw>
                                    </destination>
                                    <keepOnGround>false</keepOnGround>
                                </Item>
                            </impactsIf>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                    <zone href="UI02_JumpBackZone.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                                    <time>2000</time>
                                    <impactsOnLand>
                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                            <delay>1500</delay>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="Jump01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsOnLand>
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>JumpStart</scriptID>
                                            <map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </locator>
                                        <yaw type="constructor.basicElements.AngleDegrees">
                                            <value>90</value>
                                        </yaw>
                                    </destination>
                                    <keepOnGround>false</keepOnGround>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                            <assistantResource href="/Mechanics/Spells/Instances/UmoirIsland02/UI02_Dreadnawt/UI02_AssistantResource.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                            <mobResource href="/Creatures/UmoirDreadnawt/UI02_Dreadnawt.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </Item>
                    </impactsOff>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>6000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
