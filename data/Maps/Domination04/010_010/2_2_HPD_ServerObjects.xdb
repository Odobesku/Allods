		<Item type="gameMechanics.map.spawn.recaptureable.RecapturablePlace">
			<scriptID>HPD_6_Red</scriptID>
			<scanRadius>80</scanRadius>
			<place>
				<coord x="204.578" y="149.945" z="6.13638" />
				<yaw>2.05453</yaw>
			</place>
			<device href="/Items/InteractiveObjects/BG04/HPD_6_Red.(SteleResource).xdb" />
			<autoCapturePeriodSec>500</autoCapturePeriodSec>
			<steleImpactsOnOwnerChange>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="/Mechanics/InstancedEventResource/MM_BG04/MM_BG04_HPD_Start.(ImpactListResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.EntityImpactScriptZoneSetDisabled">
