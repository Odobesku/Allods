<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739874039</resourceId>
    </Header>
    <name href="Kraken_Smite2.(ProjectileResource).Name.txt" />
    <visObject href="/Mechanics/Spells/AstarlIslands/AI59_UI07/SecondBoss/Boom.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>10000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <radius>5</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ASTRAL</element>
                            <damage>30</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="UI07_Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>2</multiplier>
                            </durationScaler>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="/Spells/ClientData/HitContactBreak.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impacts>
                    <finalImpactsOnHolder>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>2000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </finalImpactsOnHolder>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </filter>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>