<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>187589</resourceId>
    </Header>
    <Name href="Vampire_Pull.(SpellSingleTarget).Name.txt" />
    <visualScripts href="Vampire_Pull.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>12000</prepareDuration>
    <mechanics>
        <cooldown>
            <duration>20000</duration>
        </cooldown>
        <channelingMechanics>
            <channelingBuff href="Vampire_Pull.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.EffectsDeferred">
                <delay>2000</delay>
                <effects>
                    <Item type="gameMechanics.elements.effects.Switch">
                        <impactsOn>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Vampire_RandomAE.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                                <pool href="/Mechanics/InstanceModifiers/Addon5/SummonLimit.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                </impacts>
                            </Item>
                        </impactsOn>
                    </Item>
                </effects>
            </Item>
            <Item type="gameMechanics.elements.effects.TickableAura">
                <affectGroup>All</affectGroup>
                <radius>6</radius>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
                <impactsIn>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/AstarlIslands/AI61/AI61_Boss04/Boss03_SelfBurn_Stacks.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsIn>
                <impactsOut>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="/Mechanics/Spells/AstarlIslands/AI61/AI61_Boss04/Boss03_SelfBurn_Stacks.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsOut>
            </Item>
        </casterChannelingEffects>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Boss02/AI63_Boss02.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </mobs>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                        <spell href="Vampire_Pull.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                        <duration>25000</duration>
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>6</radius>
                <affectGroup>Enemies</affectGroup>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                        <time>1000</time>
                        <distance>10</distance>
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.CreatureFilter" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                <data href="Vampire_AstralKick.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>