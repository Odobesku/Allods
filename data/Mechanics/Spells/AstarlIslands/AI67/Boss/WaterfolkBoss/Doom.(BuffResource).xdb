	<image href="/Interface/Icons/Equipment/Ranged/WandWodoo.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visScript href="Doom.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<effects>
		<Item type="gameMechanics.elements.effects.HealthTrigger">
			<healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
				<multiplier>0.2</multiplier>
			</healthOn>
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactMobMorph">
					<newMobWorld href="Banshee.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Doom.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.Enlarge">
			<factor>1.2</factor>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisorient">
			<radius>5</radius>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.EffectUnworthyOfAttention" />
		<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.5</coeff>
			</scaler>
			<predicates>
				<Item type="gameMechanics.elements.predicates.offender.PredicateIsAE" />
			</predicates>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
