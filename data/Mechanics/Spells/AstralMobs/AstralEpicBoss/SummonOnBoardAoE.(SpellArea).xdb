<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>198304</resourceId>
    </Header>
    <Name href="SummonOnBoardAoE.(SpellArea).Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>0</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <element>FIRE</element>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>45000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                <predicates>
                    <Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.world.ship.elements.ImpactSummonOnBoard">
                        <spawnTable href="/Mechanics/Spells/AstralMobs/AstralBoss2/SummonOnBoard.(ShipSpawnTable).xdb#xpointer(/gameMechanics.world.ship.summon.ShipSpawnTable)" />
                        <impactsOnSummon>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/AstralMobShipBoarding/BoardingParty.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnSummon>
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <radius>700</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>