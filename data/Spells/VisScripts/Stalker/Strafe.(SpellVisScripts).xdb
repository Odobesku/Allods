<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<AttackAnimation>USE_CURRENT_RANGED_CHEAPSHOT</AttackAnimation>
			<LoadHoldMode>DIE</LoadHoldMode>
			<LoadHoldAnimation>USE_CURRENT_RANGED_LOAD</LoadHoldAnimation>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>whirlwind</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Stalker70_Strafe.(VisObjectTemplate).xdb" />
						<fadeInTime>100</fadeInTime>
						<fadeOutTime>200</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
