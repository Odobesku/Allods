<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>210710</resourceId>
    </Header>
    <Name href="AnniversaryLevelUp.(SpellSingleTarget).Name.txt" />
    <Description href="AnniversaryLevelUp.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>3000</prepareDuration>
    <targetType>STTSelf</targetType>
    <mechanics>
        <cooldown>
            <duration>86400000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventMember" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                    <minLevel type="gameMechanics.formulas.IntConstantValue">
                        <value>55</value>
                    </minLevel>
                </predicate>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAddExperience">
                <calcer type="gameMechanics.elements.calcers.CalcerLongSum">
                    <calcers>
                        <Item type="gameMechanics.elements.calcers.CalcerNextLevelExp">
                            <factor>1</factor>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.CalcerCurrentLevelExp">
                            <factor>-1</factor>
                        </Item>
                    </calcers>
                </calcer>
                <direct>true</direct>
                <scaleByGlobal>false</scaleByGlobal>
            </Item>
        </casterImpacts>
    </mechanics>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>