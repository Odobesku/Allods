				<Item>Move</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToExternalMove" />
		<Item type="gameMechanics.elements.effects.EffectModifyManaRegen">
			<manaType>Energy</manaType>
			<multiplier type="gameMechanics.elements.calcers.CalcerSum">
				<summands>
