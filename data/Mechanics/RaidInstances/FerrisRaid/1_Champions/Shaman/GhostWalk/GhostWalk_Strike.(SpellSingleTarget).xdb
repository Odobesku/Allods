<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739885802</resourceId>
    </Header>
    <Name href="GhostWalk_Strike.(SpellSingleTarget).Name.txt" />
    <visualScripts href="GhostWalk_Strike.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>2000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="GhostWalk.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="GhostWalk_HM.(BuffResource).xdb" />
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.DirectDamage">
                        <damage>1</damage>
                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                <multiplier>0.2</multiplier>
                            </mulCalcer>
                        </scalerTarget>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.DirectHeal">
                                <heal>1</heal>
                                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                        <multiplier>0.05</multiplier>
                                    </mulCalcer>
                                </scalerTarget>
                            </Item>
                        </impacts>
                        <spawnResource href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Champions.(SpawnTable).xdb" />
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>SHADOW</element>
                        <damage>20</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Stun.(BuffResource).xdb" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>