<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>holdCrossbow</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/Engeneer_MiniTurell_Ready.(VisObjectTemplate).xdb" />
				<scale>0.5</scale>
				<locator>Slot_Hand_R</locator>
				<offset y="-0.66" z="0.06" />
			</Item>
		</visualEffects>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attackCrossbow</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Engeneer_MiniTurell_Cast.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<locator>Slot_Hand_R</locator>
						<offset y="-0.66" z="0.06" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/Engeneer_MiniTurell_Projectile.(VisObjectTemplate).xdb" />
				<explosionFx href="/Spells/FX/Spells/Engeneer_MiniTurell_Hit.(VisObjectTemplate).xdb" />
				<pointOnCaster type="VisPointLocator">
					<shift y="-0.66" z="0.06" />
					<locator>Slot_Hand_R</locator>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_FX</locator>
				</pointOnTarget>
				<offendTime type="EffectOffendConstVelocity">
					<velocity>50</velocity>
				</offendTime>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
