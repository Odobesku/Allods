<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <PreCastAnimation>specialCast</PreCastAnimation>
            <LocatorOnTargets>Slot_Global</LocatorOnTargets>
            <FXOnTargets />
            <FixPointCaster>true</FixPointCaster>
            <FixPointTarget>true</FixPointTarget>
            <FxOnHands>/Spells/FX/Mobs/Integral_DeadSteam_upscaled.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
            <CastAnimation>spellCastDirected</CastAnimation>
        </Variables>
    </Header>
    <wholeCasting type="VisActionList">
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>333</delay>
                        <effectFx hrefvar="FxOnHands" />
                        <fixPoint>false</fixPoint>
                        <scale>0.75</scale>
                        <fadeInTime>333</fadeInTime>
                        <fadeOutTime>1000</fadeOutTime>
                        <locator>FROM_LOCATOR_NAME</locator>
                        <locatorName>Slot_Head</locatorName>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>