<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
    <Header>
        <resourceId>488663</resourceId>
    </Header>
    <parts />
    <persistentParts>
        <Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.StaticEntityAura">
                    <shape type="space.scaner.resources.Cylinder">
                        <halfHeight>5</halfHeight>
                    </shape>
                    <radius>10</radius>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.world.ship.elements.PredicateStandingOnBoundShip" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <anyRank>false</anyRank>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOut>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.bunchparts.BunchAddPlane">
            <plane href="DevicePlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
    </persistentParts>
    <name href="FireTrap_Name.txt" />
    <visObj href="/Spells/FX/Spells/MageFireTrapAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <collisionObject>false</collisionObject>
    <interactiveObject>true</interactiveObject>
    <exploitingText href="FireTrap_ExploitingText.txt" />
    <corpseEmptyDuration>30000</corpseEmptyDuration>
    <spell href="" />
</gameMechanics.world.device.SteleResource>