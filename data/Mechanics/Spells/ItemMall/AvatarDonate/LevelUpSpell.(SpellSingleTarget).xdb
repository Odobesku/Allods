<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739891417</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="LevelUpSpell.(SpellSingleTarget).Name.txt" />
    <Description href="LevelUpSpell.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Teleportation.(SpellVisScripts).xdb" />
    <prepareDuration>2000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>4</value>
                </minLevel>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                <faction href="/World/Factions/League.xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                <faction href="/World/Factions/Empire.xdb" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                <faction href="/World/Factions/League.xdb" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                <impactsResource href="LevelUpSpell_L.(ImpactListResource).xdb" />
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                <impactsResource href="LevelUpSpell_E.(ImpactListResource).xdb" />
                            </Item>
                        </impactsElse>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactAddExperience">
                        <calcer type="gameMechanics.elements.calcers.CalcerRemainingExpirience">
                            <level type="gameMechanics.elements.calcers.LongData">
                                <value var="level" />
                            </level>
                        </calcer>
                        <direct>true</direct>
                        <scaleByGlobal>false</scaleByGlobal>
                        <transactional>true</transactional>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource hrefvar="impactsResource" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactClientData">
                        <data href="PridenFactionChoise.(ClientData).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>2000</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAddExperience">
                                <calcer type="gameMechanics.elements.calcers.CalcerRemainingExpirience">
                                    <level type="gameMechanics.elements.calcers.LongData">
                                        <value var="level" />
                                    </level>
                                </calcer>
                                <direct>true</direct>
                                <scaleByGlobal>false</scaleByGlobal>
                                <transactional>true</transactional>
                            </Item>
                        </impacts>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>