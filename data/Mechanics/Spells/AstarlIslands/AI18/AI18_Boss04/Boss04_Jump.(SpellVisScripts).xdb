<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>special</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="Boss04_JumpDecal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/Ready_HowlingStrike.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>2</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_HITCRITICAL</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>500</delay>
                        <effectFx href="/Spells/FX/Spells/HowlingStrike_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>