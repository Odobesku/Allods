<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739848909</resourceId>
    </Header>
    <element>ASTRAL</element>
    <visualScripts href="ME_Bombs.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <prepareDuration>3000</prepareDuration>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="MEBoss_Red_Add.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <spawnAt>Caster</spawnAt>
                        <destination type="gameMechanics.map.destination.DestinationModified">
                            <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                            <modifiers>
                                <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                    <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                        <verticalRange min="0" max="0" />
                                        <horizontalRange min="0" max="4" />
                                    </modifier>
                                </Item>
                                <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                    <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                        <verticalRange min="0" max="0" />
                                        <horizontalRange min="4" max="8" />
                                    </modifier>
                                </Item>
                            </modifiers>
                        </destination>
                    </moveType>
                    <resource href="ME_Bombs_Land.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                </projectileData>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>