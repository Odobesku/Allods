<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>214891</resourceId>
    </Header>
    <Name href="Summon_Turret.(SpellSingleTarget).Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>16000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                            <verticalRange min="1" max="1" />
                            <horizontalRange min="1" max="2" />
                        </Item>
                    </modifiers>
                </destination>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Disable_Act.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                <value>1</value>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.world.creature.AvatarFilter" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <traceDown>true</traceDown>
                <object href="Fire_Enginere_Add.(MobWorld).xdb" />
                <pool href="Turret_Pool.(SummonPool).xdb" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>