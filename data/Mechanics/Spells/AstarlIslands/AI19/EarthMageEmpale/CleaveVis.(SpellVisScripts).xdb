<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>specialCast</Item>
        </animations>
        <advanced>
            <speed>0.75</speed>
            <turnToTarget>NO_TURN</turnToTarget>
        </advanced>
    </actionBarStart>
    <actionBarComplite type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Gargoyle_Cleave.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fixPoint>true</fixPoint>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
            </Item>
        </elements>
    </actionBarComplite>
</SpellVisScripts>