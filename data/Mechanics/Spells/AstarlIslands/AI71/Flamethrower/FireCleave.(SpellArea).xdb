<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>188303</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/AutoAttackSharedMagic.(ActionGroup).xdb" />
    </groups>
    <Name href="FireCleave.(SpellArea).Name.txt" />
    <visualScripts href="FireCleave.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>7</value>
    </range>
    <prepareDuration>500</prepareDuration>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>3000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/AstarlIslands/AI71/Common/RestrictRotationAndMovement.(BuffResource).xdb" />
                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>2</multiplier>
                </durationScaler>
            </Item>
            <Item type="gameMechanics.elements.impacts.RunImpactsInShape">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="FireCleaveChannel.(BuffResource).xdb" />
                            </Item>
                        </predicates>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactsIf">
                                <predicate type="gameMechanics.elements.predicates.PredicateDistance">
                                    <range min="0" max="15" />
                                </predicate>
                                <impactsElse>
                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                        <element>FIRE</element>
                                        <damage>25</damage>
                                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impactsElse>
                    </Item>
                </impacts>
                <shape type="gameMechanics.constructor.schemes.spell.area.RectangularRay">
                    <width>4</width>
                </shape>
                <affectGroup>Enemies</affectGroup>
                <radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
                    <value>75</value>
                </radius>
                <affectMainTarget>false</affectMainTarget>
                <workOnDead>false</workOnDead>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsIf">
                <predicate type="gameMechanics.elements.predicates.PredicateDistance">
                    <range min="0" max="15" />
                </predicate>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>FIRE</element>
                        <damage>25</damage>
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="FireCleaveChannel.(BuffResource).xdb" />
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>15</value>
        </angle>
    </shape>
    <radius>25</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>