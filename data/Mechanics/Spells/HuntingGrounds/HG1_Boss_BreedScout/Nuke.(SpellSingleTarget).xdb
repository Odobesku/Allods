<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739854185</resourceId>
	</Header>
	<visualScripts href="Nuke.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>15000</duration>
		</cooldown>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
				<element>ASTRAL</element>
				<damage>12</damage>
				<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
					<scalers>
						<Item type="gameMechanics.elements.scalers.MagicScaler" />
						<Item type="gameMechanics.elements.scalers.SumBuffsStackScaler">
							<buffs>
								<Item href="AttentionStacks.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</buffs>
							<multiplier>0.2</multiplier>
						</Item>
					</scalers>
				</scaler>
			</Item>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="AttentionStacks.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.PostponedImpacts">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactsConditional">
						<conditions>
							<Item type="gameMechanics.elements.conditions.PredicatesCondition">
								<targetPredicates>
									<Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
										<buff href="AttentionStacks.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										<range>
											<min>6</min>
											<max>7</max>
										</range>
									</Item>
								</targetPredicates>
							</Item>
						</conditions>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.BuffDetacher">
								<buff href="AttentionStacks.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</impactsIf>
					</Item>
				</impacts>
			</Item>
		</targetImpacts>
	</mechanics>
	<speed>20</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
