<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>200</fadeOutMS>
    <geometry href="/Spells/FX/Spells/MoveByClick03.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <scale>1</scale>
    <sound />
    <states>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/Spells/MoveByClick03.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <visObjComponents>
        <Item type="AlignCollisionComponent">
            <endHeight>-2</endHeight>
            <locatorName></locatorName>
            <offset x="0" y="0" z="0" />
            <scale>1</scale>
            <startHeight>2</startHeight>
            <visObject href="/Spells/FX/Spells/MoveByClick03Start_China.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <alignNormal>false</alignNormal>
