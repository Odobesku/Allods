						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
							<spawn>
								<scriptID var="FXProjScriptID" />
								<map href="/Maps/FerrisRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
							</spawn>
							<impacts>
