<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739871735</resourceId>
	</Header>
	<Name href="Visual.(BuffResource).Name.txt" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="Link.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					<calcers>
						<addressEntries>
							<Item>
								<name>caster</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
							</Item>
							<Item>
								<name>target</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
							</Item>
						</addressEntries>
					</calcers>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
					<projectileData>
						<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
							<destination type="gameMechanics.map.destination.DestinationModified">
								<destination type="gameMechanics.map.destination.SelfPosDestination" />
								<modifiers>
									<Item type="gameMechanics.map.destination.modifier.ModifierRelativePolar">
										<radius type="gameMechanics.elements.calcers.FloatData">
											<value>3</value>
										</radius>
										<angle type="constructor.basicElements.AngleDegrees" />
									</Item>
									<Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
								</modifiers>
							</destination>
						</moveType>
						<resource href="PlasmaPool.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
					</projectileData>
					<pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
				</Item>
			</impacts>
			<initialDelay>4000</initialDelay>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
