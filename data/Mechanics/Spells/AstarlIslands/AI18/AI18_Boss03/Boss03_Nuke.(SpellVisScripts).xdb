<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialAttack</Item>
                </animations>
                <channel>CHANNEL_HITCRITICAL</channel>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectNatureWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialAttack</Item>
                </animations>
                <channel>CHANNEL_HITCRITICAL</channel>
            </Item>
        </elements>
    </launch>
    <playOnTargets>
        <specialAction type="CreatureEffectsAction">
            <visualEffects>
                <Item>
                    <effectFx href="/Spells/FX/Spells/HitMeleeCrit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    <scale>2</scale>
                    <locator>Slot_FX</locator>
                </Item>
            </visualEffects>
        </specialAction>
    </playOnTargets>
</SpellVisScripts>