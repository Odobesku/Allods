<?xml version ="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <actionPreviewInfo>
        <elseInfo/>
        <info/>
    </actionPreviewInfo>
    <binding>BindOnPickup</binding>
    <category
            href="/Mechanics/ItemCategories/Quest.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)"/>
    <description href="/Mechanics/Stronghold/SeasonRewards/DungeonTitle.(ItemResource).Description.txt"/>
    <image href="/Interface/Icons/Misc/Papers/Offhand_Book_C_01Gold.(UISingleTexture).xdb#xpointer(/client.Widgets.UISingleTexture)"/>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)"/>
    <itemMallType>NOTITEMMALLABLE</itemMallType>
    <level>1</level>
    <lifeLengthCap>0</lifeLengthCap>
    <name href="/Mechanics/Stronghold/SeasonRewards/DungeonTitle.(ItemResource).Name.txt"/>
    <ownershipLimit>0</ownershipLimit>
    <quality
            href="/Mechanics/ItemQualities/Uncommon.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)"/>
    <requiredLevel>1</requiredLevel>
    <requiredReputation>Hostility</requiredReputation>
    <showItemContextAction>Default</showItemContextAction>
    <slot>UNDRESSABLE</slot>
    <source>Quest</source>
    <spell href="/Mechanics/Stronghold/SeasonRewards/Spell01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.Spell)"/>
    <stackLimit>100</stackLimit>
    <sysName></sysName>
    <canBeDeposited>true</canBeDeposited>
    <clearAllOnTry>false</clearAllOnTry>
    <forceShowQuality>false</forceShowQuality>
    <ignoreDressSlotLevel>false</ignoreDressSlotLevel>
    <isHideLifestyleWhileNotEquipped>false</isHideLifestyleWhileNotEquipped>
    <isProbe>false</isProbe>
    <isQuestRelated>false</isQuestRelated>
    <needCheckPredicates>true</needCheckPredicates>
    <ritual>false</ritual>
    <showOnlyIconInLink>false</showOnlyIconInLink>
    <soldForAltCurrency>false</soldForAltCurrency>
</gameMechanics.constructor.schemes.item.ItemResource>
