<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound>
            <name></name>
        </sound>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>1000</fadeInMS>
    <fadeOutMS>1000</fadeOutMS>
    <scale>1</scale>
    <sound>
        <name></name>
    </sound>
    <visObjComponents>
        <Item type="AlignCollisionComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <endHeight>-5</endHeight>
            <locatorName></locatorName>
            <offset x="0" y="0" z="0" />
            <scale>1</scale>
            <startHeight>5</startHeight>
            <visObject href="/Mechanics/Spells/AstarlIslands/AI25/AI25_Reuse/AI25_Boss1/AI25_Boss1_BlinkAttackFirePoolPart.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <alignNormal>false</alignNormal>
