<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Omni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationPotion.(CreatureVisActionResource).xdb</PreCastAnimation>
			<CastAnimation>spellCastPotion</CastAnimation>
			<FXOnCaster>/Spells/FX/Spells/DruidVigorousConcoction_cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<PreCastFX>/Spells/VisScripts/Prototypes/PreCastFXNature.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastFX>
			<FXWand />
			<FXPocket>/Spells/FX/Spells/PocketSpellNature01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXPocket>
			<LocatorOnCaster>Slot_TopFX</LocatorOnCaster>
			<FXDown>/Spells/FX/Spells/ReadySpellDirect03DownNature.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXDown>
			<FXHands>/Spells/FX/Spells/ReadySpellDirectNatureWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXHands>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>1000</delay>
								<effectFx hrefvar="FXDown" />
								<effectAlias href="" />
								<locator>Slot_Global</locator>
								<offendTime />
							</Item>
							<Item>
								<effectFx hrefvar="FXHands" />
								<effectAlias href="" />
								<scale>0.5</scale>
								<locator>Slot_Hand_L</locator>
								<offendTime />
							</Item>
							<Item>
								<effectFx hrefvar="FXHands" />
								<effectAlias href="" />
								<scale>0.5</scale>
								<locator>Slot_Hand_R</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/DruidVigorousConcoction_loop.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_TopFX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
