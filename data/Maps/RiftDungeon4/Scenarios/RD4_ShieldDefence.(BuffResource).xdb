<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739937035</resourceId>
	</Header>
	<Name href="/Maps/RiftDungeon4/Scenarios/RD4_ShieldDefence.(BuffResource).Name.txt" />
	<Description href="/Maps/RiftDungeon4/Scenarios/RD4_ShieldDefence.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Event/ShieldCarrier.(UISingleTexture).xdb" />
	<interfaceHighPriority>true</interfaceHighPriority>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
					<mobs>
						<Item href="/Mechanics/Spells/Rifts/RiftDungeon4/Mobs/RD4_Fighter.(MobWorld).xdb" />
					</mobs>
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.EffectInstantiating">
					<effects>
						<Item type="gameMechanics.elements.effects.EffectsDeferred">
							<delay>2000</delay>
							<effects>
								<Item type="gameMechanics.elements.effects.TickableAura">
									<affectGroup>Enemies</affectGroup>
									<radius>30</radius>
									<filter type="gameMechanics.world.creature.MobFilter" />
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateFaction">
											<faction href="/World/Factions/Wild.xdb" />
										</Item>
									</predicates>
									<conditions />
									<impactsIn>
										<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
													<value>100</value>
												</Item>
											</impacts>
										</Item>
									</impactsIn>
									<impactsOut />
									<holderImpactsIn />
									<holderImpactsOut />
								</Item>
							</effects>
						</Item>
					</effects>
				</Item>
				<Item type="gameMechanics.elements.common.HealOverTime">
					<healPerTick type="gameMechanics.elements.calcers.FullHealthCalcer">
						<multiplier>0.02</multiplier>
					</healPerTick>
					<scaler type="gameMechanics.elements.scalers.TrivialScaler" />
					<scalerTarget type="gameMechanics.elements.scalers.TrivialScaler" />
					<mode>Pure</mode>
					<considerOutgoingModifiers>false</considerOutgoingModifiers>
				</Item>
			</effectsIf>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Maps/RiftDungeon4/Scenarios/RD4_Bombs.(BuffResource).xdb" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>