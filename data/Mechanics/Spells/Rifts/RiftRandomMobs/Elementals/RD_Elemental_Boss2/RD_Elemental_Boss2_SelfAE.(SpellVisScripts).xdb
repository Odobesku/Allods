<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Ready_Spell_FettersFrost_Decal.(VisObjectTemplate).xdb" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Spell_Cast_FettersFrost_Decal.(VisObjectTemplate).xdb" />
						<ignoreParentRotation>true</ignoreParentRotation>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>