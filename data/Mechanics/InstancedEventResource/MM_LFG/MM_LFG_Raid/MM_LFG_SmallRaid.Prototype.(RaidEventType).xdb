<?xml version="1.0" encoding="UTF-8" ?>
<avatarPopulation.service.impl.matchMakingImpl.eventType.lfg.RaidEventType>
    <Header>
        <resourceId>241398</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer hrefvar="GearScoreDesc" />
                </mulCalcer>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <text href="MM_LFG_SmallRaid.Prototype.(RaidEventType).Text.txt" />
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.elements.predicates.PredicateEqualsLong">
                    <lhs type="itemService.serverVariables.CalcerServerVariable">
                        <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                    </lhs>
                    <rhs type="gameMechanics.elements.calcers.LongData">
                        <value var="ServerVar_7" />
                    </rhs>
                </condition>
            </scaler>
        </Item>
        <Item>
            <name>var2</name>
            <text href="MM_LFG_SmallRaid.Prototype.(RaidEventType).Text02.txt" />
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.constructor.basicElements.PredicateExternal">
                    <predicateResource hrefvar="GearScorePred" />
                </condition>
            </scaler>
        </Item>
        <Item>
            <name>var3</name>
            <text href="MM_LFG_SmallRaid.Prototype.(RaidEventType).Text03.txt" />
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.constructor.basicElements.PredicateExternal">
                        <predicateResource hrefvar="GearScorePred" />
                    </predicate>
                </condition>
            </scaler>
        </Item>
    </descVars>
    <category href="/Mechanics/InstancedEventResource/MM_LFG/Categories/LFG_SmallRaids.(BattleEventCategory).xdb" />
    <difficultyMode var="difficultyMode" />
    <showPredicates>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                    <lhs type="itemService.serverVariables.CalcerServerVariable">
                        <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                    </lhs>
                    <rhs type="gameMechanics.elements.calcers.LongData">
                        <value var="ServerVar_7" />
                    </rhs>
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                    <lhs type="itemService.serverVariables.CalcerServerVariable">
                        <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                    </lhs>
                    <rhs type="gameMechanics.elements.calcers.LongData">
                        <value var="ServerVar_7" />
                    </rhs>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateUnlock">
            <unlock hrefvar="unlock" />
        </Item>
    </showPredicates>
    <minAvatarLevel type="gameMechanics.formulas.MaxLevelConstant" />
    <minAvatarsCount>1</minAvatarsCount>
    <leaderOnly>true</leaderOnly>
    <capacity>12</capacity>
    <immediatelyStartFactor>0.05</immediatelyStartFactor>
    <unionType>SmallRaid</unionType>
    <joinConditions>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                    <lhs type="itemService.serverVariables.CalcerServerVariable">
                        <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                    </lhs>
                    <rhs type="gameMechanics.elements.calcers.LongData">
                        <value var="ServerVar_7" />
                    </rhs>
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                    <lhs type="itemService.serverVariables.CalcerServerVariable">
                        <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                    </lhs>
                    <rhs type="gameMechanics.elements.calcers.LongData">
                        <value var="ServerVar_7" />
                    </rhs>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateUnlock">
            <unlock hrefvar="unlock" />
        </Item>
    </joinConditions>
    <unionRequirements>
        <Item type="gameMechanics.elements.predicates.SoftUnionRequirement">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateExternal">
                    <predicateResource hrefvar="GearScorePred" />
                </Item>
            </predicates>
            <successesPerFailure>2</successesPerFailure>
            <errorClientData href="/Mechanics/InstancedEventResource/CommonMechanics/GearscoreUnionRequirement.(ClientData).xdb" />
        </Item>
        <Item type="gameMechanics.elements.predicates.StrictUnionRequirement">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                </Item>
            </predicates>
            <errorClientData href="/Mechanics/InstancedEventResource/CommonMechanics/CombatStateUnionRequirement.(ClientData).xdb" />
        </Item>
    </unionRequirements>
    <allowedInviteToEvent>true</allowedInviteToEvent>
    <allowedAwayFromEvent>true</allowedAwayFromEvent>
    <inviteTimeout>
        <minute>1</minute>
    </inviteTimeout>
    <leaveQueueQuestion href="/Mechanics/InstancedEventResource/MM_LFG/LeaveQueueQuiz.(Question).xdb" />
    <question href="/Mechanics/InstancedEventResource/MM_LFG/RoleQuiz.(Question).xdb" />
    <forceStartQuestion href="/Mechanics/InstancedEventResource/MM_LFG/ForceStartQuiz.(Question).xdb" />
    <roles>
        <Item>
            <role>Tank</role>
            <capacity>2</capacity>
        </Item>
        <Item>
            <role>Healer</role>
            <capacity>2</capacity>
        </Item>
        <Item>
            <role>DamageDealer</role>
            <capacity>8</capacity>
        </Item>
    </roles>
    <impactsOnAvatar>
        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
            <buff href="/Mechanics/LFG/Quests/RuleQuests/IsLFGBuff.(BuffResource).xdb" />
        </Item>
    </impactsOnAvatar>
    <impactsOnMap>
        <Item type="gameMechanics.elements.impacts.ImpactAddVotingSpellsPartToMap">
            <parts>
                <Item href="/Mechanics/Spells/VoteKick/VoteForKick.(SpellSingleTarget).xdb" />
            </parts>
        </Item>
    </impactsOnMap>
    <destinationMaps />
    <destinationTag hrefvar="destinationTag" />
</avatarPopulation.service.impl.matchMakingImpl.eventType.lfg.RaidEventType>