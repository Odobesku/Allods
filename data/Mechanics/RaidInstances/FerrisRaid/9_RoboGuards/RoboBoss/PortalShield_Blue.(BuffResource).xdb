<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739905115</resourceId>
    </Header>
    <Name href="PortalShield_Blue.(BuffResource).Name.txt" />
    <Description href="PortalShield_Blue.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Event/ShieldCarrier.(UISingleTexture).xdb" />
    <visScript href="PortalShield_Blue.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="/Maps/FerrisRaid/SpawnTables/RobobossGenerators.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <object href="PortalSpecial_collision.(SteleResource).xdb" />
                    <pool href="PortalShield_collision.(SummonPool).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="PortalShield_collision.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                    <table href="/Maps/FerrisRaid/SpawnTables/RobobossGenerators.(SpawnTable).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="PortalShield_Robot.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>1</level>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAbility">
            <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                        <range min="0" max="1" />
                        <withinRange>false</withinRange>
                        <minCandidatesCount>3</minCandidatesCount>
                        <targetCount>3</targetCount>
                    </selector>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="PortalKiller_Permission.(BuffResource).xdb" />
                                </predicate>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="PortalDispell_Permission.(BuffResource).xdb" />
                                </predicate>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="PortalShield_Permission.(BuffResource).xdb" />
                                </predicate>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="InPortal.(BuffResource).xdb" />
                                </predicate>
                            </Item>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/9_Roboguards_Room.(BuffResource).xdb" />
                            </Item>
                        </predicates>
                    </filter>
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                            <destination type="gameMechanics.map.destination.DestinationModified">
                                                <destination type="gameMechanics.map.destination.RelativePos">
                                                    <coord z="-1" />
                                                </destination>
                                                <modifiers>
                                                    <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                                                </modifiers>
                                            </destination>
                                        </moveType>
                                        <resource href="PortalShield_Blue_small.(ProjectileResource).xdb" />
                                    </projectileData>
                                    <pool href="PortalShield_collision.(SummonPool).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>3000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="IncreaseDamage.(BuffResource).xdb" />
                </Item>
            </impacts>
            <tick>20000</tick>
            <initialDelay>-1</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactBaseHealth">
                            <healthMultiplier>0.1</healthMultiplier>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuards_disabled.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="RoboGuards_EnrageAura.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <spawnResource href="/Maps/FerrisRaid/SpawnTables/9_RoboGuards.(SpawnTable).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="PortalShield_Permission.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="PortalKiller_pool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                    <resources>
                                        <Item href="PortalShield_Blue_small.(ProjectileResource).xdb" />
                                    </resources>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <affectGroup>All</affectGroup>
            <radius>10</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="PortalShield_Permission.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="TeleportStart.(ClientData).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>FR_9_B2</scriptID>
                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                </locator>
                            </destination>
                            <finishImpacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="TeleportEnd.(ClientData).xdb" />
                                </Item>
                            </finishImpacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="PortalShield_Permission.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="TeleportStart.(ClientData).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>FR_9_B</scriptID>
                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                </locator>
                            </destination>
                            <finishImpacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="TeleportEnd.(ClientData).xdb" />
                                </Item>
                            </finishImpacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="SpecialPortal_cooldown.(BuffResource).xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>0.5</multiplier>
                    </durationScaler>
                </Item>
            </impacts>
            <tick>5000</tick>
            <initialDelay>-1</initialDelay>
        </Item>
    </effects>
    <stackLimit>3</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>