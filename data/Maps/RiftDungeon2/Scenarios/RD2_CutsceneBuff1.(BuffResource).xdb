<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739924270</resourceId>
    </Header>
    <visScript href="RD2_CutsceneBuff1.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>2000</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
                        <Item type="gameMechanics.elements.effects.EffectDisableAct">
                            <actions>
                                <Item>Move</Item>
                            </actions>
                            <rooted>true</rooted>
                        </Item>
                        <Item type="gameMechanics.elements.effects.LifeGuard">
                            <level>1</level>
                        </Item>
                        <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>RiftDungeon2_Scenario_goal1</scriptID>
                                            <map href="/Maps/RiftDungeon2/MapResource.xdb" />
                                        </locator>
                                        <yaw type="constructor.basicElements.AngleDegrees">
                                            <value>313</value>
                                        </yaw>
                                    </destination>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
                                </Item>
                            </impactsOn>
                            <impactsOff>
                                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>RiftDungeon2_Scenario_goal1</scriptID>
                                            <map href="/Maps/RiftDungeon2/MapResource.xdb" />
                                        </locator>
                                        <yaw type="constructor.basicElements.AngleDegrees">
                                            <value>313</value>
                                        </yaw>
                                    </destination>
                                </Item>
                            </impactsOff>
                        </Item>
                        <Item type="gameMechanics.elements.effects.AddPlane">
                            <plane href="/Mechanics/Spells/Rifts/Abilities/RD_CutscenePlane.(Plane).xdb" />
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                            <ability href="/Mechanics/Spells/Rifts/RiftDungeon2/Mobs/RD2_Boss01/RD2_Boss01_Disabled.(AbilityResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>