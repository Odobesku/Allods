<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>220572</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Mobparts/EyeAnimal.(UISingleTexture).xdb" />
    <visScript href="Portal_Start_CutScene_Camera.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>CutScene_Rysina</scriptID>
                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                        </locator>
                        <yaw type="constructor.basicElements.AngleDegrees">
                            <value>130</value>
                        </yaw>
                    </destination>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Ray_CutScene_Rysina.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <object href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Allies/Rysina_CutScene.(MobWorld).xdb" />
                    <pool href="CutScenePool.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>CutScene_Rysina</scriptID>
                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                </locator>
                                <yaw type="constructor.basicElements.AngleDegrees">
                                    <value>130</value>
                                </yaw>
                            </destination>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Projectile_Plane.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <object href="Rysina_Portal.(ProjectileResource).xdb" />
                            <pool href="CutScenePool.(SummonPool).xdb" />
                            <isPersonalPool>true</isPersonalPool>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="/World/Quests/Ferris_indoor/Ferris_3_4_2/Portal_Sub8.(ClientData).xdb" />
