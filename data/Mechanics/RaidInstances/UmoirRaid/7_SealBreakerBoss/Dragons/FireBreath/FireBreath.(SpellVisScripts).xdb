<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarComplite type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/DragonForm_FireBreath.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<locator>Slot_FX</locator>
			</Item>
		</visualEffects>
	</actionBarComplite>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>800</delay>
						<effectFx href="/Spells/FX/Mobs/Firebreath_Cleave_02.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
