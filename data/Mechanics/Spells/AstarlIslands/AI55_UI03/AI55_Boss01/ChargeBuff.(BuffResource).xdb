<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>186214</resourceId>
    </Header>
    <Name href="ChargeBuff.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorCharge.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="ChargeBuff.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <nameTemplate href="ChargeBuff.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>1</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectForceMove">
            <destinations>
                <Item type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
            </destinations>
            <impactsOnArrived>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>3</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                    <impactsOnHitTarget>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsOnHitTarget>
                                    <minDamage>20</minDamage>
                                    <maxDamage>20</maxDamage>
                                </Item>
                            </impacts>
                            <impactsOnNoTargets>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ChargeMissed.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsOnNoTargets>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="ChargeTarget.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ChargeBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOnArrived>
        </Item>
    </effects>
    <duration>3000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>