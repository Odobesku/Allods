<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>CLAMP</mode>
				<animations>
					<Item>knockdownStart</Item>
				</animations>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>knockdownEnd</Item>
				</animations>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
