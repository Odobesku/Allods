<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Stun.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<locator>Slot_Head</locator>
								<member>All_Members_WithoutMount</member>
							</Item>
						</visualEffects>
					</Item>
					<Item type="VisActionList">
						<elements>
							<Item type="CreatureAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>knockdownStart</Item>
									<Item>knockdownLoop</Item>
								</animations>
								<channel>CHANNEL_KNOCKDOWN</channel>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
					<Item type="VisActionList">
						<playWhile type="VisActionDelay">
							<time>3000</time>
						</playWhile>
						<elements>
							<Item type="PostEffectVisAction">
								<userPostEffect href="/World/Quests/Ferris03/Ferris_3_1_6/Ferris_3_1_6_Boss.(UserPostEffect).xdb#xpointer(/UserPostEffect)" />
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
