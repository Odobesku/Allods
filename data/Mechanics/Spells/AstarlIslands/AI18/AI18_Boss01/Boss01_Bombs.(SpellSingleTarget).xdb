<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>194122</resourceId>
    </Header>
    <Name href="Boss01_Bombs.(SpellSingleTarget).Name.txt" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                <impact type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.RelativePos" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="0" max="0" />
                                                    <horizontalRange min="15" max="15" />
                                                </modifier>
                                            </Item>
                                        </modifiers>
                                    </destination>
                                </moveType>
                                <resource href="Boss01_Bombs.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                            </projectileData>
                        </Item>
                    </impacts>
                </impact>
                <count type="gameMechanics.elements.calcers.FloatData">
                    <value>5</value>
                </count>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <affectGroup>Enemies</affectGroup>
                <affectHolder>false</affectHolder>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                        <projectileData>
                            <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                            <resource href="Boss01_Bombs.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                        </projectileData>
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
                <targetsLimit>2</targetsLimit>
            </Item>
        </casterImpacts>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>