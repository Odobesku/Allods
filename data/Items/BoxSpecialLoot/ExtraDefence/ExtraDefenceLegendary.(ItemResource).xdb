<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739950235</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/PrintConclave.(UISingleTexture).xdb" />
    <source>Vendor</source>
    <showItemContextAction>Never</showItemContextAction>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <warningUseText href="ExtraDefenceLegendary.(ItemResource).WarningUseText.txt" />
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.avatar.itemBag.ConvertToUnlockTakeAction">
                        <unlock href="/Mechanics/Unlocks/ItemMall/ExtraDefenceLegendary.(UnlockResource).xdb" />
                    </Item>
                </actions>
                <consumeItems>1</consumeItems>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="/Mechanics/Unlocks/ItemMall/ExtraDefenceLegendary.(UnlockResource).xdb" />
                </predicate>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>4</value>
                </minLevel>
            </Item>
        </predicates>
    </functionalPart>
    <quality href="/Mechanics/ItemQualities/Relic.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.AuctionItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
    </prices>
    <lifeLengthCap>15724800000</lifeLengthCap>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="ExtraDefenceLegendary.(ItemResource).Name.txt" />
    <description href="ExtraDefenceLegendary.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/ItemMall.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>