<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="WeatherCreatureVisAction">
				<params>
					<skyMesh href="/World/Sky/AC7_New.(SkyMesh).xdb#xpointer(/SkyMesh)" />
					<hasLight>true</hasLight>
					<ambientSoundImpact>Stop</ambientSoundImpact>
				</params>
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Music/Music.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>Music/AdaptiveMusic/Infiltration</name>
				</sound>
				<actionType>Music</actionType>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
