                        <buff href="AddStun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsOnLand>
                <distance>10</distance>
            </Item>
        </targetImpacts>
    </mechanics>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>3</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>