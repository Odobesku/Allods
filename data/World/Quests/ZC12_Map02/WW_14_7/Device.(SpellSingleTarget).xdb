<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>310544</resourceId>
    </Header>
    <visualScripts href="/Spells/VisScripts/Items/Gadget.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>25</value>
    </range>
    <prepareDuration>3000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="WW_14_7.xdb" />
                <status>Started</status>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                    <quest href="WW_14_7.xdb" />
                    <counterResource href="Counter1.(QuestCountId).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Characters/HumMobs/ZC12/WW_14_7_Soulless.(MobWorld).xdb" />
                    <Item href="/Characters/HumMobs/ZC12/WW_14_7_Soulless_01.(MobWorld).xdb" />
                    <Item href="/Characters/HumMobs/ZC12/WW_14_7_Soulless_02.(MobWorld).xdb" />
                    <Item href="/Characters/Kania_female/Instances/ZC12_Map02/WW_14_7_Soulless_03.(MobWorld).xdb" />
                    <Item href="/Characters/Hadagan_male/Instances/ZC12_Map02/WW_14_7_Soulless_04.(MobWorld).xdb" />
                </mobs>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Exach_near.(BuffResource).xdb" />
                </predicate>
            </Item>
        </targetConditions>
        <conditions>
            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                    <buff href="Fail.(BuffResource).xdb" />
                </predicate>
            </Item>
        </conditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>0.7</value>
                </chanceCalcer>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Buff.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                <id href="Counter1.(QuestCountId).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactSetFaction">
                        <faction href="/World/Factions/ZC12/ZC12_FriendlyMob.(Faction).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                        <ability href="/Mechanics/Abilities/Creatures/ArchitectGhost/ArchitectGhost.(AbilityResource).xdb" />
                    </Item>
                </impacts>
                <impactsLose>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Fail.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                        <data href="AttemptFailed.(ClientData).xdb" />
                    </Item>
                </impactsLose>
            </Item>
        </targetImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>