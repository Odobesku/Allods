<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739931670</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Engineer/Shots/Shots.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/RangedAttacks.xdb" />
	</groups>
	<element>ACID</element>
	<Name href="Poison.(SpellSingleTarget).Name.txt" />
	<Description href="Poison.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>dmg</name>
			<value var="damage" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>MagicScaler</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Equipment/Ships/Shot/AcidShot02.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Engineer/Poison_Shot.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<ranks>
		<Item href="Poison01.(SpellSingleTarget).xdb" />
		<Item href="Poison02.(SpellSingleTarget).xdb" />
		<Item href="Poison03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<launchWhenReady>true</launchWhenReady>
	<mechanics>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateCreature" />
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="/Mechanics/Spells/Engineer63/Abilities/Reactor/AutoCoolingDisable.(BuffResource).xdb" />
			</Item>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.elements.impacts.PostponedImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
								<variable href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
								<summand>-40</summand>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.MarkedImpact">
						<mark href="/Mechanics/Spells/Engineer63/Spells/Acid/ShotOnCaster.(MarkResource).xdb" />
					</Item>
				</impacts>
				<groupRepeaters>true</groupRepeaters>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
						<element>ACID</element>
						<damage var="damage" />
						<impactsOnHitTarget>
							<Item type="gameMechanics.elements.impacts.MarkedImpact">
								<mark href="/Mechanics/Spells/Engineer63/Spells/Acid/ShotOnTarget.(MarkResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.MarkedImpact">
								<mark href="/Mechanics/Spells/Engineer63/Spells/Acid/AcidShotTarget.(MarkResource).xdb" />
							</Item>
						</impactsOnHitTarget>
						<scaler type="gameMechanics.elements.scalers.MagicScaler" />
					</Item>
				</impacts>
				<groupRepeaters>true</groupRepeaters>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
