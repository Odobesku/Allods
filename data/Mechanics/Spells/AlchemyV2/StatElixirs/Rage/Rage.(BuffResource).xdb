<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739863919</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<image href="/Interface/Icons/Misc/Potions/SmallBottlePurple.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.SummandStat">
			<stat type="gameMechanics.elements.stat.InnateStat">
				<stat>Rage</stat>
			</stat>
			<value>5</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.ScalerIf">
						<condition type="gameMechanics.elements.predicates.PredicateCreatureLevel">
							<hideText>true</hideText>
							<minLevel type="gameMechanics.formulas.IntConstantValue">
								<value var="value1" />
							</minLevel>
						</condition>
						<scalerIf type="gameMechanics.elements.scalers.ScalerIf">
							<condition type="gameMechanics.elements.predicates.PredicateCreatureLevel">
								<hideText>true</hideText>
								<minLevel type="gameMechanics.formulas.IntConstantValue">
									<value var="value2" />
								</minLevel>
							</condition>
							<scalerIf type="gameMechanics.elements.scalers.LinearScaler">
								<multiplier>0</multiplier>
							</scalerIf>
							<scalerElse type="gameMechanics.elements.scalers.LinearScaler">
								<multiplier>0.5</multiplier>
							</scalerElse>
						</scalerIf>
						<scalerElse type="gameMechanics.elements.scalers.LinearScaler">
							<multiplier>1</multiplier>
						</scalerElse>
					</Item>
					<Item type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>10</multiplier>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</effects>
	<duration>1800000</duration>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<ranks>
		<Item href="Rage1.(BuffResource).xdb" />
		<Item href="Rage2.(BuffResource).xdb" />
		<Item href="Rage3.(BuffResource).xdb" />
		<Item href="Rage4.(BuffResource).xdb" />
		<Item href="Rage5.(BuffResource).xdb" />
		<Item href="Rage6.(BuffResource).xdb" />
		<Item href="Rage7.(BuffResource).xdb" />
		<Item href="Rage8.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>true</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/BuffConsumables.xdb" />
		<Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
		<Item href="/Mechanics/Spells/AlchemyV2/StatElixirs/Stats.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/AlchemyPots.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
