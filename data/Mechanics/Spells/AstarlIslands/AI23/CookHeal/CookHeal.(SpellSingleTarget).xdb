    <nameTemplate href="SpellName.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>75</value>
    </range>
    <prepareDuration>1000</prepareDuration>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>4000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                        <level>0.25</level>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                                <level>0.5</level>
                            </Item>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="CookHealBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                <buff href="CookHealBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <range>
                    <max>9</max>
                </range>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.PureHeal">
                <heal>1</heal>
                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                        <multiplier>0.5</multiplier>
                    </mulCalcer>
                </scalerTarget>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="CookHealBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>