<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739878249</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
					<device>
						<scriptID>Firewall_01</scriptID>
						<map href="/Maps/HuntingGround4/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</device>
				</Item>
			</onEnter>
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Firewall_01</scriptID>
						<map href="/Maps/HuntingGround4/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.ImpactDeviceDisintergrate" />
					</impacts>
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Firewall_01</scriptID>
						<map href="/Maps/HuntingGround4/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.ImpactDeviceDisintergrate" />
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
