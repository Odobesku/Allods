    </prices>
    <binding>BindOnPickup</binding>
    <name href="NewYear200Coupons.(ItemResource).Name.txt" />
    <description href="NewYear200Coupons.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/Consumables/Special.xdb" />
