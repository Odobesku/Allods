<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>225716</resourceId>
    </Header>
    <Name href="CannonUserBuff.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Equipment/Ships/CannonBigTypeIcon.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="CannonUserBuff.(BuffResource)_Name.txt.template" />
    <effects>
        <Item type="gameMechanics.world.ship.elements.TriggerUse">
            <impactsFinish>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="CannonUserBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsFinish>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="CannonPoison.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <stacks type="gameMechanics.elements.calcers.LinearCalcer">
                        <mul>1</mul>
                        <sum>0</sum>
                    </stacks>
                </Item>
            </impacts>
            <tick>900</tick>
            <initialDelay>1000</initialDelay>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>