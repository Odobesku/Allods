                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="R7_Capsule_1.(ScriptZone).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="R7_Capsule_2.(ScriptZone).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="R7_Capsule_3.(ScriptZone).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="R7_Capsule_4.(ScriptZone).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="R7_Capsule_5.(ScriptZone).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="R7_Enter_PsykerArena.(ScriptZone).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
