                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <object href="AI62_Psionic_NPC.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </Item>
                    </impactsElse>
                </Item>
            </onLeave>
