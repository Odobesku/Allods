										<delta>
											<min>90</min>
											<max>100</max>
										</delta>
										<budgetType>OffenceBudget</budgetType>
									</Item>
								</modifiers>
							</Item>
						</modifiers>
					</lootTable>
					<curseProbability>1</curseProbability>
					<dropUncursed>false</dropUncursed>
				</lootTable>
				<chance var="dropItemsCount" />
			</Item>
			<Item>
				<lootTable type="gameMechanics.constructor.schemes.item.LootTableSingleItem">
					<itemProvider type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
