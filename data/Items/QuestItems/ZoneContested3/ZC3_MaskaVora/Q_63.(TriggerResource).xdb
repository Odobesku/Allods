<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>472026</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectVariable">
            <resource href="Q_63.(VariableResource).xdb" />
            <valueTriggers>
                <Item>
                    <onGreaterOrEqual>true</onGreaterOrEqual>
                    <value type="gameMechanics.elements.calcers.FloatData">
                        <value>1</value>
                    </value>
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectSetReputation">
                            <faction href="/World/Factions/ZoneContested3/Guard_Traders.(Faction).xdb" />
                            <value>-26000</value>
                        </Item>
                    </effects>
                </Item>
            </valueTriggers>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                            <quest href="/World/Quests/ZoneContested3/Q_063/Q_063.xdb" />
                            <counterResource href="/World/Quests/ZoneContested3/Q_063/CountId_0.(QuestCountId).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="/World/Quests/ZoneContested3/Q_063/CountId_0.(QuestCountId).xdb" />
                            <value>-1</value>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>