<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>1000</time>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>idle01</Item>
				</animations>
				<advanced>
					<speed>0.9</speed>
				</advanced>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
