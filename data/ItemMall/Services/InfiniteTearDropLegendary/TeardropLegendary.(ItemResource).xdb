<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>740163420</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/IMDragonTears_Legendary.(UISingleTexture).xdb#xpointer(/UISingleTexture)"/>
    <source>Quest</source>
    <slot>AMMO</slot>
    <itemClass
            href="/Mechanics/ItemClasses/Other_InfiniteTeardrop.(ItemClass).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)"/>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                                <unlock href="/Mechanics/Unlocks/ItemMall/LegendaryInfiniteDragonTear.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)"/>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                            <unlock href="/Mechanics/Unlocks/ItemMall/LegendaryInfiniteDragonTear.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)"/>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <level>52</level>
    <requiredLevel>52</requiredLevel>
    <quality
            href="/Mechanics/ItemQualities/Legendary.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)"/>
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>1</money>
        </cost>
    </prices>
    <binding>BindOnEquip</binding>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="TeardropLegendary.(ItemResource).Name.txt"/>
    <description href="TeardropLegendary.(ItemResource).Description.txt"/>
    <category
            href="/Mechanics/ItemCategories/ItemMall.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)"/>
</gameMechanics.constructor.schemes.item.ItemResource>