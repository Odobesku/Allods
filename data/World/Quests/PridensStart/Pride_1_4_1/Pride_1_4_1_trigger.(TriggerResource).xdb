<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
	<Header>
		<resourceId>739886718</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<conditionalEvents>
				<Item>
					<obj>gameMechanics.elements.events.EventEmoteProcess</obj>
					<predicate type="gameMechanics.elements.predicates.PredicateEmoteProcess">
						<clientData href="/Client/SlashCommands/EmoteRasp.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					</predicate>
				</Item>
			</conditionalEvents>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobNear">
							<radius>15</radius>
							<mobs>
								<Item href="/Characters/Praiden_male/Instances/PridensStart/Pride_1_4_1_Pyatno.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							</mobs>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="CountId_1.xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
							<spawn>
								<scriptID>Pride_1_4_1_Pyatno</scriptID>
								<map href="/Maps/PridensStart/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
							</spawn>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
									<data href="/World/Quests/PridensStart/Pride_1_2/Pride_1_4_1_PyatnoLeave.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>4000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactSummon">
									<destination type="gameMechanics.map.destination.DestinationLocator">
										<locator>
											<scriptID>Pride_1_4_1_PyatnoLoc</scriptID>
											<map href="/Maps/PridensStart/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
										</locator>
									</destination>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
											<ability href="Pride_1_4_1_Pyatno_plane.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
										</Item>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="Pride_1_4_1_Pyatno_Personal.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactGoTo">
											<destination type="gameMechanics.map.destination.DestinationLocalLocator">
												<scriptID>Pride_1_2_KaniaPriest_Leave</scriptID>
											</destination>
											<runningMode>true</runningMode>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
													<delay>10000</delay>
													<impacts>
														<Item type="gameMechanics.elements.impacts.Disintegrate" />
													</impacts>
												</Item>
											</impacts>
										</Item>
									</impacts>
									<object href="/Characters/Praiden_male/Instances/PridensStart/Pride_1_4_1_Pyatno.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="Pride_1_4_1_Pyatno_Resolvent.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
							<data href="Pride_1_4_1_TooFar.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
						</Item>
					</impactsElse>
