<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739917896</resourceId>
    </Header>
    <Name href="EnchantedTrap.(BuffResource).Name.txt" />
    <Description href="EnchantedTrap.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerSleepingDropsy.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/VisScripts/Necromancer/GhostWorld.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectDisablePassiveThreat" />
        <Item type="gameMechanics.elements.effects.EffectAllowNoVisibleTargets" />
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Banish_HA.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.SimpleEffectScaler">
                <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="gameMechanics.elements.calcers.FloatData">
                        <value>0</value>
                    </mulCalcer>
                </scaler>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisorient">
            <radius>20</radius>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.5</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="NoTrap.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>6</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ASTRAL</element>
                            <damage>70</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="AoEVisual.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
            </impacts>
            <tick>6000</tick>
            <initialDelay>5000</initialDelay>
        </Item>
    </effects>
    <duration>30000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
