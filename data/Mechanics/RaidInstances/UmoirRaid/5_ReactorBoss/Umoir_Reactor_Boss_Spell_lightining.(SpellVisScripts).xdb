<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Mobs/ReactorBoss_Lightining.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fxLength>6.5</fxLength>
				<startPoint type="VisPointLocator">
					<shift y="-2.9" z="10" />
					<locator>Slot_Global</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
				<offendTime />
				<secondaryTargetParams>
					<channelingFx href="" />
					<offendTime />
				</secondaryTargetParams>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>0.7</scale>
						<locator>Slot_FX</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction />
	</playOnTargets>
</SpellVisScripts>
