<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>throwWeapon</Item>
        </animations>
    </actionBarStart>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/StalkerFlourBagAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.5</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>