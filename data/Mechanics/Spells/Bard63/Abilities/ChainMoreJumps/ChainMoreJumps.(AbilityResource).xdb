<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>215209</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="ChainMoreJumps.(AbilityResource).Name.txt" />
    <description href="ChainMoreJumps.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
        </Item>
        <Item>
            <name>heal</name>
            <value var="heal" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/DoubleVirtue.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                    <spells>
                        <Item href="/Mechanics/Spells/Bard63/Spells/ChainHealDamage/ChainHealDamage01.(SpellSingleTarget).xdb" />
                    </spells>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.OutgoingHealModifier">
                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                <coeff var="heal" />
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
    </effects>
    <ranks>
        <Item href="ChainMoreJumps01.(AbilityResource).xdb" />
        <Item href="ChainMoreJumps02.(AbilityResource).xdb" />
        <Item href="ChainMoreJumps03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>