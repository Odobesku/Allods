<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739931559</resourceId>
    </Header>
    <Name href="GrenadeThrow.(SpellArea).Name.txt" />
    <Description href="GrenadeThrow.(SpellArea).Description.txt" />
    <visualScripts href="GrenadeThrow.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>9</value>
    </range>
    <prepareDuration>1000</prepareDuration>
    <targetType>STTPoint</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Everyone</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="WW_1_5.xdb" />
                <status>Started</status>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                    <quest href="WW_1_5.xdb" />
                    <counterResource href="Counter1_1.(QuestCountId).xdb" />
                </predicate>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateInZone">
                <zone href="/Maps/ZC12/Zones/ZC12_01.(ZoneResource).xdb" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    </moveType>
                    <resource href="Smoke.(ProjectileResource).xdb" />
                </projectileData>
                <pool href="SmokePool.(SummonPool).xdb" />
                <isPersonalPool>true</isPersonalPool>
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>10</speed>
    <radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>