		<Item href="FlamethrowerV1R2.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
		<Item href="FlamethrowerV1R3.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateVariableEqualsLessThan">
								<resource href="/Mechanics/Spells/Engineer/Overheating/Overheating.(VariableResource).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
								<maxValue>170</maxValue>
							</Item>
							<Item type="gameMechanics.elements.predicates.PredicateVariableGreatThan">
								<resource href="/Mechanics/Spells/Engineer/Overheating/Overheating.(VariableResource).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
								<minValue>-25</minValue>
							</Item>
						</predicates>
					</Item>
					<Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
						<spell href="FlamethrowerV1R1.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
					</Item>
				</predicates>
			</Item>
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceMana">
				<mana>40</mana>
				<rawManaScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
					<mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
						<summands>
							<Item type="gameMechanics.elements.calcers.FloatData">
								<value>1</value>
							</Item>
							<Item type="gameMechanics.elements.calcers.CalcerMul">
								<calcers>
									<Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
										<buff href="BurnEmR1.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										<forAllRanks>true</forAllRanks>
									</Item>
									<Item type="gameMechanics.elements.calcers.FloatData">
										<value>-1</value>
									</Item>
								</calcers>
							</Item>
						</summands>
					</mulCalcer>
				</rawManaScaler>
				<manaType>
					<Item>Energy</Item>
				</manaType>
			</Item>
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
				<predicates>
					<Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
						<spell href="FlamethrowerV1R1.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
					</Item>
				</predicates>
				<impacts>
					<Item type="gameMechanics.elements.impacts.BuffDetacher">
						<buff href="BurnEmR1.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</impacts>
				<elseImpacts>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff hrefvar="BurnEmBuff" />
					</Item>
				</elseImpacts>
			</Item>
			<Item type="gameMechanics.constructor.basicElements.ImpactNull">
				<value var="damage" />
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
