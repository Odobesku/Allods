                                            </impacts>
                                            <spawnResource href="/Mechanics/RaidInstances/FerrisRaid/15_General/DronesPortal.(SpawnTable).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/Portals/MobBlue.(BuffResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/Portals/MobBlue.(BuffResource).xdb" />
                                                    <range>
                                                        <min>2</min>
                                                        <max>2</max>
                                                    </range>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                                    </impacts>
                                                    <spawnResource href="/Mechanics/RaidInstances/FerrisRaid/15_General/TripodsPortal.(SpawnTable).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/Portals/MobBlue.(BuffResource).xdb" />
                                                </Item>
                                            </impactsIf>
                                            <impactsElse>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/Portals/MobBlue.(BuffResource).xdb" />
                                                            <range>
                                                                <min>3</min>
                                                                <max>3</max>
                                                            </range>
                                                        </Item>
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                                            <impacts>
