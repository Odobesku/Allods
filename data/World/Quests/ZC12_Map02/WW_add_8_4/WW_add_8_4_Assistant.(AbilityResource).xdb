<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>310350</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="WW_add_8_4_Assistant.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="WW_add_8_4_Assistant_Stun.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                        <value>0.5</value>
                                    </chanceCalcer>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                            <radius>30</radius>
                                            <affectGroup>Enemies</affectGroup>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                        <Item type="gameMechanics.elements.impacts.RandomImpact">
                                                            <entries>
                                                                <Item>
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                                            <data href="WW_add_8_4_Assistant.(ClientData).xdb" />
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                                <Item>
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                                            <data href="WW_add_8_4_Assistant_01.(ClientData).xdb" />
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </entries>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                    <value>100</value>
                                                </Item>
                                            </impacts>
                                            <impactsOnNoTargets>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                                <buff href="WW_add_8_4_Assistant_Stun_Coldown.(BuffResource).xdb" />
                                                            </predicate>
                                                        </Item>
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="WW_add_8_4_Assistant_Stun.(BuffResource).xdb" />
                                                        </Item>
                                                    </impactsIf>
                                                </Item>
                                            </impactsOnNoTargets>
                                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                <predicates>
                                                    <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                        <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                                    </Item>
                                                </predicates>
                                            </filter>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>12000</tick>
            <initialDelay>-1</initialDelay>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>