                                <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                    <buff href="/Items/QuestItems/Tropical_Atoll/Cocktail_01/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <range>
                                        <min>2</min>
                                        <max>7</max>
