<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>215476</resourceId>
    </Header>
    <name href="Reactor.(AbilityResource).Name.txt" />
    <description href="Reactor.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Ships/ReactorBigTypeIcon.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectVariable">
            <resource href="Overheating.(VariableResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="AutoCoolingDisable.(BuffResource).xdb" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateGreater">
                                            <lhs type="gameMechanics.elements.calcers.VariableValueCalcer">
                                                <variable href="Overheating.(VariableResource).xdb" />
                                            </lhs>
                                            <rhs type="gameMechanics.constructor.basicElements.FloatZero" />
                                        </Item>
                                    </predicates>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable href="Overheating.(VariableResource).xdb" />
                                            <summand>-10</summand>
                                        </Item>
                                    </impacts>
                                    <elseImpacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateGreater">
                                                    <lhs type="gameMechanics.constructor.basicElements.FloatZero" />
                                                    <rhs type="gameMechanics.elements.calcers.VariableValueCalcer">
                                                        <variable href="Overheating.(VariableResource).xdb" />
                                                    </rhs>
                                                </Item>
                                            </predicates>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                                    <variable href="Overheating.(VariableResource).xdb" />
                                                    <summand>10</summand>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </elseImpacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>-1</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="AutoCoolingDisable.(BuffResource).xdb" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateGreater">
                                            <lhs type="gameMechanics.elements.calcers.VariableValueCalcer">
                                                <variable href="Overheating.(VariableResource).xdb" />
                                            </lhs>
                                            <rhs type="gameMechanics.constructor.basicElements.FloatZero" />
                                        </Item>
                                    </predicates>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable href="Overheating.(VariableResource).xdb" />
                                            <summand>-10</summand>
                                        </Item>
                                    </impacts>
                                    <elseImpacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateGreater">
                                                    <lhs type="gameMechanics.constructor.basicElements.FloatZero" />
                                                    <rhs type="gameMechanics.elements.calcers.VariableValueCalcer">
                                                        <variable href="Overheating.(VariableResource).xdb" />
                                                    </rhs>
                                                </Item>
                                            </predicates>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                                    <variable href="Overheating.(VariableResource).xdb" />
                                                    <summand>10</summand>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </elseImpacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
