		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/Mechanics/LoginEvent3/LE3SoloQuest05.(QuestCountId).xdb" />
		</Item>
	</impactsOnWinners>
	<impactsOnLosers>
