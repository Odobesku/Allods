                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/World/Quests/Tropical_Atoll/ChargeTrace/ChargeFast.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>0.33</multiplier>
                                        </durationScaler>
                                    </Item>
                                </impacts>
                            </Item>
