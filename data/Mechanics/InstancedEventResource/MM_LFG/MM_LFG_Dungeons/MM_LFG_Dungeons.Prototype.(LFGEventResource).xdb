<?xml version="1.0" encoding="UTF-8" ?>
<avatarPopulation.service.impl.matchMakingImpl.eventType.lfg.DungeonEventType>
    <Header>
        <resourceId>241410</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <category href="/Mechanics/InstancedEventResource/MM_LFG/Categories/LFG_Dungeons.(BattleEventCategory).xdb" />
    <minAvatarLevel type="gameMechanics.formulas.IntConstantValue">
        <value var="minAvatarLevel" />
    </minAvatarLevel>
    <levelsPartition>
        <entries>
            <Item>
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value var="minAvatarLevel" />
                </minLevel>
                <capacity>0</capacity>
            </Item>
        </entries>
    </levelsPartition>
    <minTeamSize>1</minTeamSize>
    <leaderOnly>true</leaderOnly>
    <capacity>6</capacity>
    <immediatelyStartFactor>0.2</immediatelyStartFactor>
    <commonShard var="commonShard" />
    <joinConditions>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateInRaid" />
        </Item>
    </joinConditions>
    <activeEventJoinPeriod>-1</activeEventJoinPeriod>
    <inviteTimeout>
        <minute>1</minute>
    </inviteTimeout>
    <canDenyParticipation>false</canDenyParticipation>
    <leaveQueueQuestion href="/Mechanics/InstancedEventResource/MM_LFG/LeaveQueueQuiz.(Question).xdb" />
    <question href="/Mechanics/InstancedEventResource/MM_LFG/RoleQuiz.(Question).xdb" />
    <forceStartQuestion href="/Mechanics/InstancedEventResource/MM_LFG/ForceStartQuiz.(Question).xdb" />
    <roles>
        <Item>
            <role>Tank</role>
            <capacity>1</capacity>
        </Item>
        <Item>
            <role>Healer</role>
            <capacity>1</capacity>
        </Item>
        <Item>
            <role>DamageDealer</role>
            <capacity>4</capacity>
        </Item>
    </roles>
    <impactsOnAvatar>
        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
            <buff href="/Mechanics/LFG/Quests/RuleQuests/IsLFGBuff.(BuffResource).xdb" />
        </Item>
    </impactsOnAvatar>
    <impactsOnMap>
        <Item type="gameMechanics.elements.impacts.ImpactAddVotingSpellsPartToMap">
            <parts>
                <Item href="/Mechanics/Spells/VoteKick/VoteForKick.(SpellSingleTarget).xdb" />
            </parts>
        </Item>
    </impactsOnMap>
    <effectsQueueSolo>
        <Item type="gameMechanics.elements.effects.EffectGroupTrigger">
            <impactsOnJoin>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
            </impactsOnJoin>
            <impactsOnMemberJoin>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
            </impactsOnMemberJoin>
            <ignoreImpactsOnStartStop>true</ignoreImpactsOnStartStop>
        </Item>
    </effectsQueueSolo>
    <effectsQueuePremade>
        <Item type="gameMechanics.elements.effects.EffectGroupTrigger">
            <impactsOnJoin>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
            </impactsOnJoin>
            <impactsOnMemberJoin>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactLeaveFromEventQueues" />
            </impactsOnMemberJoin>
            <ignoreImpactsOnStartStop>true</ignoreImpactsOnStartStop>
        </Item>
    </effectsQueuePremade>
    <destinationMaps>
        <Item hrefvar="destinationMap" />
    </destinationMaps>
    <destinationTag hrefvar="destinationTag" />
    <tier var="tier" />
    <difficult var="difficult" />
    <level var="level" />
</avatarPopulation.service.impl.matchMakingImpl.eventType.lfg.DungeonEventType>