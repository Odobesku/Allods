                <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>FIRE</element>
                <damage>75</damage>
                <impactsOnHitCaster>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateAggrolistCanSelect">
                                        <selector type="gameMechanics.tools.SelectorRandomNotLess">
                                            <minIndex>0</minIndex>
                                        </selector>
                                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="AI60_Boss_FrostRage02.(BuffResource).xdb" />
                                                </Item>
                                            </predicates>
                                        </filter>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                                        <spell href="AI60_Boss_FireFinish.(SpellSingleTarget).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="AI60_BossFireCast.(BuffResource).xdb" />
                                    </Item>
                                </impactsIf>
                                <impactsElse>
                                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                        <delay>500</delay>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                <buff href="AI60_BossFireCast.(BuffResource).xdb" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impacts>
                    </Item>
                </impactsOnHitCaster>
