<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739895616</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Calibration.(AbilityResource).Name.txt" />
    <description href="Calibration.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>value</name>
            <value var="value" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Itemmall/RareCannonPrints.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                    <group href="/Mechanics/Spells/Engineer/Shots/Shots.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.SummandStat">
                            <stat type="gameMechanics.elements.stat.InnateStat">
                                <stat>CritChance</stat>
                            </stat>
                            <value var="value" />
                            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>10</multiplier>
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
    </effects>
    <ranks>
        <Item href="Calibration01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Calibration02.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Calibration03.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>