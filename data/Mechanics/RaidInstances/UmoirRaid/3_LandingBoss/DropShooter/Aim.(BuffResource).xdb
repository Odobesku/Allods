	<Header>
		<resourceId>739833695</resourceId>
	</Header>
	<Name href="Aim.(BuffResource).Name.txt" />
	<Description href="Aim.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Itemmall/IMFireworkTarget.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Spells/ArrowBlinded.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
			<scale>1.2</scale>
			<locator>Slot_FX</locator>
		</Item>
	</visualEffects>
	<visScript href="/Spells/VisScripts/Bard/Allegro_Target.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<nameTemplate href="Aim.(BuffResource).Name.txt" />
	<descTemplate href="Aim.(BuffResource).DescTemplate.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
						<radius>40</radius>
					</distributor>
					<data href="/Spells/ClientData/FireHit.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.PureDamage">
					<damage>1</damage>
