<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>specialIdle</Item>
				</animations>
				<channel>CHANNEL_EMOTE_BOTTOM</channel>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>specialWalk</play>
							<forAnimations>
								<Item>walk</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>spellCastDirected01</play>
							<forAnimations>
								<Item>spellCastDirected</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>walkBackwards01</play>
							<forAnimations>
								<Item>walkBackwards</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>channelCastDirected01</play>
							<forAnimations>
								<Item>channelCastDirected</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>specialWalk</play>
							<forAnimations>
								<Item>run</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>invalid</play>
							<forAnimations>
								<Item>run01</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>hit01</play>
							<forAnimations>
								<Item>hit</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>specialIdle</play>
							<forAnimations>
								<Item>idle01</Item>
								<Item>idle02</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpEngineer</play>
							<forAnimations>
								<Item>jump</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpStartEngineer</play>
							<forAnimations>
								<Item>jumpStart</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpEndEngineer</play>
							<forAnimations>
								<Item>jumpEnd</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpLandRunEngineer</play>
							<forAnimations>
								<Item>jumpLandRun</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>specialWalk</play>
							<forAnimations>
								<Item>walk</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>spellCastDirected01</play>
							<forAnimations>
								<Item>spellCastDirected</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>walkBackwards01</play>
							<forAnimations>
								<Item>walkBackwards</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>channelCastDirected01</play>
							<forAnimations>
								<Item>channelCastDirected</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>specialWalk</play>
							<forAnimations>
								<Item>run</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>invalid</play>
							<forAnimations>
								<Item>run01</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>hit01</play>
							<forAnimations>
								<Item>hit</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>specialIdle</play>
							<forAnimations>
								<Item>idle01</Item>
								<Item>idle02</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpEngineer</play>
							<forAnimations>
								<Item>jump</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpStartEngineer</play>
							<forAnimations>
								<Item>jumpStart</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpEndEngineer</play>
							<forAnimations>
								<Item>jumpEnd</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpLandRunEngineer</play>
							<forAnimations>
								<Item>jumpLandRun</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
				<member>Mount</member>
				<priority href="" />
				<restartOnVisualChange>true</restartOnVisualChange>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
