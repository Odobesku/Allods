						<buff href="/Mechanics/Spells/Necromancer70/Abilities/ChannelWatcher/Channel.(BuffResource).xdb" />
						<impactsOnAttach />
						<impactsOnFail />
					</Item>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="/Mechanics/Spells/Necromancer70/Abilities/ChannelWatcher/HealingChannel.(BuffResource).xdb" />
					</Item>
				</impactsOn>
				<impactsOff>
					<Item type="gameMechanics.elements.impacts.BuffDetacher">
						<buff href="/Mechanics/Spells/Necromancer70/Abilities/ChannelWatcher/Channel.(BuffResource).xdb" />
					</Item>
					<Item type="gameMechanics.elements.impacts.BuffDetacher">
						<buff href="/Mechanics/Spells/Necromancer70/Abilities/ChannelWatcher/HealingChannel.(BuffResource).xdb" />
					</Item>
				</impactsOff>
			</Item>
		</casterChannelingEffects>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>