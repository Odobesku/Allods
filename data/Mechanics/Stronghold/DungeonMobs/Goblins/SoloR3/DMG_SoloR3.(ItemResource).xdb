<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739870761</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/Stronghold/StrongholdGoblinSoloR2.(UISingleTexture).xdb#xpointer(/UISingleTexture)"/>
    <source>FixedDrop</source>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)"/>
    <functionalPart type="gameMechanics.world.stronghold.Beast">
        <mob href="DMG_SoloR3.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)"/>
        <type>Solo</type>
    </functionalPart>
    <stackLimit>1000</stackLimit>
    <quality href="/Mechanics/ItemQualities/Rare.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)"/>
    <prices type="gameMechanics.constructor.schemes.item.prices.AltCurrenciesItem">
        <currencies>
            <Item>
                <currency
                        href="/Mechanics/AlternativeCurrencies/EP_Points.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)"/>
                <value>25000</value>
            </Item>
        </currencies>
    </prices>
    <binding>BindOnPickup</binding>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="DMG_SoloR3.(ItemResource).Name.txt"/>
    <description href="DMG_SoloR3.(ItemResource).Description.txt"/>
    <category
            href="/Mechanics/ItemCategories/Consumables/Special.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)"/>
</gameMechanics.constructor.schemes.item.ItemResource>
