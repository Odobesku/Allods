<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739973079</resourceId>
	</Header>
	<visObject href="RD2_Boss02_CD_Impulse.(VisObjectTemplate).xdb" />
	<altitude>-1</altitude>
	<lifeLengthCap>4000</lifeLengthCap>
	<impactsOnStart>
		<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
			<radius>12</radius>
			<affectHolder>false</affectHolder>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
					<time>500</time>
					<distance>10</distance>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
							<value>100</value>
						</Item>
					</impactsIf>
				</Item>
			</impacts>
			<filter type="gameMechanics.constructor.basicElements.FilterAnd">
				<filters>
					<Item type="gameMechanics.world.creature.CreatureFilter" />
					<Item type="gameMechanics.world.creature.AliveFilter" />
				</filters>
			</filter>
		</Item>
	</impactsOnStart>
</gameMechanics.world.projectile.ProjectileResource>