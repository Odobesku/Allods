<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>1500</time>
		</playWhile>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack01</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="VisActionList">
				<playWhile />
				<elements>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Mobs/LizardmenMage_SlotsForTrail.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<locatorName>Spear</locatorName>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
