                                                </mobs>
                                            </Item>
                                        </predicates>
                                    </filter>
                                    <targetsLimit>2</targetsLimit>
                                    <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
                                        <order>Ascending</order>
                                    </sorting>
                                </Item>
                            </impacts>
