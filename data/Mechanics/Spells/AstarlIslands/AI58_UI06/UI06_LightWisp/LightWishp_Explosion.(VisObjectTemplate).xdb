                            </sound>
                            <volume>1</volume>
                            <overrideMoveSFX>false</overrideMoveSFX>
                        </Item>
                    </tunedSounds>
                </Item>
            </keySounds>
            <sound>
                <name>spells/Hits/HitFireball</name>
                <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
            </sound>
            <allowMultipleSoundInstances>true</allowMultipleSoundInstances>
            <playSoundOnKeys>false</playSoundOnKeys>
            <animation href="/Spells/FX/Spells/HitFireball2.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <visObjComponents>
        <Item type="CameraShakerComponent">
            <params href="/Spells/FX/InterfaceFX/CameraShakeVert1.(CameraShakeParameters).xdb#xpointer(/client.VisualConstructor.CameraShakeParameters)" />
        </Item>
