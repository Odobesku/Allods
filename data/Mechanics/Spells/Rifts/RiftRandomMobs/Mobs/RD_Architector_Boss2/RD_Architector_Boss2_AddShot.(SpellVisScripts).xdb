<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>ready</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Architect_Swarm_Avatar_Instable.(VisObjectTemplate).xdb" />
                        <locator>Slot_Mouth</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="CreatureEffectsOnTarget">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Mobs/CannonArchitect_Target.(VisObjectTemplate).xdb" />
                <locator>Slot_TopFX</locator>
            </Item>
            <Item>
                <effectFx href="/Spells/FX/Spells/AOEAura_Red_R10.(VisObjectTemplate).xdb" />
                <lockScale>true</lockScale>
            </Item>
        </visualEffects>
    </wholeCasting>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
            </Item>
            <Item type="CreatureVisActionStartThrow" />
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Mobs/ArchitectMinibossCombo_Projectile_01.(VisObjectTemplate).xdb" />
                <explosionFx href="/Spells/FX/Mobs/Architect_Explosion_R15.(VisObjectTemplate).xdb" />
                <theGe>6</theGe>
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator" />
            </Item>
        </elements>
    </launch>
</SpellVisScripts>