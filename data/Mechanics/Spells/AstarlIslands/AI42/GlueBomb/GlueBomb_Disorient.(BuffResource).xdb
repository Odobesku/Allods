                                </predicates>
                            </Item>
                        </predicates>
                    </filter>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="GlueBomb_DisorientControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
