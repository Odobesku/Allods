<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739865354</resourceId>
    </Header>
    <visObject href="/Spells/FX/Mobs/DemonBreedWarriorBlue_AxeFx.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>0</lifeLengthCap>
    <impactsOnDeath>
        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <radius>85</radius>
            <affectGroup>Enemies</affectGroup>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>SHADOW</element>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>0.05</mul>
                        <additionalMultiplier>
                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.DistanceScaler" />
                                    <Item type="gameMechanics.elements.scalers.ExponentialScaler">
                                        <pow type="gameMechanics.elements.calcers.LongData">
                                            <value>-1</value>
                                        </pow>
                                    </Item>
                                </scalers>
                            </scaler>
                        </additionalMultiplier>
                    </scalerTarget>
                    <damage>30</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
            </impacts>
            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                <filters>
                    <Item type="gameMechanics.world.creature.AliveFilter" />
                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                </filters>
            </filter>
        </Item>
    </impactsOnDeath>
    <effects>
        <Item type="gameMechanics.elements.effects.Aura">
            <checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
            <affectGroup>Enemies</affectGroup>
            <radius>4</radius>
            <delayIn>1000</delayIn>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="LihoTraps.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>