<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readyUnarmed</Item>
		</animations>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2</scale>
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/PocketSpellShadow01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2</scale>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Ritualist_DefaultBolt.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_L</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_BodyFX</locator>
						</pointOnTarget>
						<offendTime type="EffectOffendConstVelocity">
							<velocity>20</velocity>
						</offendTime>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
