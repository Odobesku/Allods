<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<animations>
			<Item>spellCastDirected</Item>
		</animations>
		<advanced>
			<speed>0.6</speed>
		</advanced>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>200</time>
					</Item>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Spells/Lesavka_EarthExplosion.(VisObjectTemplate).xdb" />
								<offset x="-0.5" y="-2" />
								<locatorName>Slot_Global</locatorName>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Lesavka_MagicStoneProjectile.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Spells/HitLightning_big_01.(VisObjectTemplate).xdb" />
						<theGe>1</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_BodyFX</locator>
						</pointOnTarget>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>300</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visActionID>st01</visActionID>
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Lesavka_Stone.(VisObjectTemplate).xdb" />
								<lockScale>true</lockScale>
								<scale>1.5</scale>
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
					<Item type="VisActionDelay">
						<time>885</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>st01</stoppedActionID>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>350</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visActionID>hnd01</visActionID>
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Lesavka_HandDirect02.(VisObjectTemplate).xdb" />
								<fadeInTime>800</fadeInTime>
								<fadeOutTime>200</fadeOutTime>
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
					<Item type="VisActionDelay">
						<time>850</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>hnd01</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
