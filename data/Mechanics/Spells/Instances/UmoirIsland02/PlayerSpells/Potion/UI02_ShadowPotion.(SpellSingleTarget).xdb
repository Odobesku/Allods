<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739850153</resourceId>
    </Header>
    <Name href="UI02_ShadowPotion.(SpellSingleTarget).Name.txt" />
    <visualScripts href="UI02_ShadowPotion.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>3000</prepareDuration>
    <targetType>STTSelf</targetType>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateTrue" />
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/Instances/UmoirIsland02/PlayerSpells/Shadow/UI02_Shadow.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="/World/Quests/UmoirIsland02/UI02_Q04/Counter03.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                <quest href="/World/Quests/UmoirIsland02/UI02_Q04/UI02_Q04.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <counterResource href="/Items/InteractiveObjects/UmoirIsland02/UI02_ShadowPotion.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateInZone">
                        <zone href="/Maps/UmoirIsland02/Zones/UI02_KoscheyDungeon.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                        <spawn>
                            <scriptID>Koschey</scriptID>
                            <map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </spawn>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="/Items/InteractiveObjects/UmoirIsland02/Ritual/UI02_ShadowPotion.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                        </impacts>
                    </Item>
                </impactsIf>
            </Item>
        </casterImpacts>
    </mechanics>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>