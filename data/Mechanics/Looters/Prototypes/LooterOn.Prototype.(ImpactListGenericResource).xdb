<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>232301</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <CurrentSpell />
        </Variables>
    </Header>
    <impacts>
        <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellGroupDeactivate">
            <group href="/Mechanics/Spells/Groups/LooterSpells.xdb" />
        </Item>
        <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellActivate">
            <spell hrefvar="CurrentSpell" />
            <effects>
                <Item type="gameMechanics.elements.effects.DeathTrigger" />
                <Item type="gameMechanics.elements.effects.WhileAlive">
                    <effects>
                        <Item type="itemService.autoLooting.EffectAutoLooter">
                            <looter hrefvar="looter" />
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Looters/NoPick.(ImpactListGenericResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Looters/NoSickle.(ImpactListGenericResource).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
                <Item type="gameMechanics.elements.effects.ItemBagTrigger">
                    <item href="/Items/CraftingObjects/BlacksmithV2/Tools/Pick.xdb" />
                    <impactsOnRemove>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Looters/NoPick.(ImpactListGenericResource).xdb" />
                        </Item>
                    </impactsOnRemove>
                </Item>
                <Item type="gameMechanics.elements.effects.ItemBagTrigger">
                    <item href="/Items/CraftingObjects/BlacksmithV2/Tools/Pick15.xdb" />
                    <impactsOnRemove>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Looters/NoPick.(ImpactListGenericResource).xdb" />
                        </Item>
                    </impactsOnRemove>
                </Item>
                <Item type="gameMechanics.elements.effects.ItemBagTrigger">
                    <item href="/Items/CraftingObjects/BlacksmithV2/Tools/Pick25.xdb" />
                    <impactsOnRemove>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Looters/NoPick.(ImpactListGenericResource).xdb" />
                        </Item>
                    </impactsOnRemove>
                </Item>
                <Item type="gameMechanics.elements.effects.ItemBagTrigger">
                    <item href="/Items/CraftingObjects/BlacksmithV2/Tools/Pick40.xdb" />
                    <impactsOnRemove>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Looters/NoPick.(ImpactListGenericResource).xdb" />
                        </Item>
                    </impactsOnRemove>
                </Item>
                <Item type="gameMechanics.elements.effects.ItemBagTrigger">
                    <item href="/Items/CraftingObjects/AlchemyV2/Tools/SickleUni.(ItemResource).xdb" />
                    <impactsOnRemove>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Looters/NoSickle.(ImpactListGenericResource).xdb" />
                        </Item>
                    </impactsOnRemove>
                </Item>
                <Item type="gameMechanics.elements.effects.ItemBagTrigger">
                    <item href="/Items/CraftingObjects/BlacksmithV2/Tools/Pick60.(ItemResource).xdb" />
                    <impactsOnRemove>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Looters/NoSickle.(ImpactListGenericResource).xdb" />
                        </Item>
                    </impactsOnRemove>
                </Item>
            </effects>
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>