<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<play>InSequence</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<stackCountVisScripts>
		<Item>
			<allTimeScript type="client.SLON.CreatureEnlargeFovAction">
				<actionTime>-1</actionTime>
				<fadeInTime>1</fadeInTime>
				<fadeOutTime>1</fadeOutTime>
				<fovCoefficient>0.04</fovCoefficient>
				<onlyIfOnMainAvatar>true</onlyIfOnMainAvatar>
			</allTimeScript>
			<maxValue>3</maxValue>
			<playIfStateSkipedFromBigger>false</playIfStateSkipedFromBigger>
			<playIfStateSkipedFromLower>false</playIfStateSkipedFromLower>
		</Item>
		<Item>
			<allTimeScript type="client.SLON.CreatureEnlargeFovAction">
				<actionTime>-1</actionTime>
				<fadeInTime>1</fadeInTime>
				<fadeOutTime>1.6</fadeOutTime>
				<fovCoefficient>0.12</fovCoefficient>
				<onlyIfOnMainAvatar>true</onlyIfOnMainAvatar>
			</allTimeScript>
			<maxValue>5</maxValue>
			<playIfStateSkipedFromBigger>false</playIfStateSkipedFromBigger>
			<playIfStateSkipedFromLower>false</playIfStateSkipedFromLower>
		</Item>
		<Item>
			<allTimeScript type="client.SLON.CreatureEnlargeFovAction">
				<actionTime>-1</actionTime>
				<fadeInTime>1</fadeInTime>
				<fadeOutTime>1.7</fadeOutTime>
				<fovCoefficient>0.24</fovCoefficient>
				<onlyIfOnMainAvatar>true</onlyIfOnMainAvatar>
			</allTimeScript>
			<maxValue>8</maxValue>
			<playIfStateSkipedFromBigger>false</playIfStateSkipedFromBigger>
			<playIfStateSkipedFromLower>false</playIfStateSkipedFromLower>
		</Item>
		<Item>
			<allTimeScript type="client.Replica.VisActionList">
				<elements>
					<Item type="client.SLON.CreatureEnlargeFovAction">
						<actionTime>-1</actionTime>
						<fadeInTime>1</fadeInTime>
						<fadeOutTime>1.8</fadeOutTime>
						<fovCoefficient>0.4</fovCoefficient>
						<onlyIfOnMainAvatar>true</onlyIfOnMainAvatar>
					</Item>
					<Item type="client.Replica.PostEffectVisAction">
						<userPostEffect href="/Spells/FX/InterfaceFX/Bard_Evasion.(UserPostEffect).xdb#xpointer(/UserPostEffect)" />
					</Item>
					<Item type="client.Replica.Sound3DAction">
						<locator>FROM_LOCATOR_NAME</locator>
						<sound>
							<creationRadius>-1</creationRadius>
							<name>World/Zones/Ferris/FerrisWind/FerrisWind02</name>
							<project href="/SFX/World/World.(FMODProject).xdb#xpointer(/FMODProject)" />
						</sound>
						<forcedSoundStop>false</forcedSoundStop>
						<onlyForMainAvatar>true</onlyForMainAvatar>
					</Item>
					<Item type="client.Replica.CreatureEffectsAction">
						<category>EFFECT_DEFAULT</category>
						<visualEffects>
							<Item>
								<delay>0</delay>
								<effectAnimations>
									<mode>DIE</mode>
								</effectAnimations>
								<effectFx href="/Spells/FX/Mobs/SpringDragon_Trail01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fadeInTime>0</fadeInTime>
								<fadeOutTime>0</fadeOutTime>
								<scale>0.75</scale>
								<fixPoint>false</fixPoint>
								<lockScale>false</lockScale>
								<muteFxSounds>false</muteFxSounds>
								<ignoreParentRotation>false</ignoreParentRotation>
								<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
								<locator>Global</locator>
								<member>Default_Member</member>
								<offset x="0" y="0" z="0" />
								<rotation x="0" y="0" z="0" />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
							</Item>
						</visualEffects>
						<dontFade>false</dontFade>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
						<stopOnDeath>false</stopOnDeath>
					</Item>
				</elements>
				<play>Simultaneously</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</allTimeScript>
			<maxValue>10</maxValue>
			<playIfStateSkipedFromBigger>false</playIfStateSkipedFromBigger>
			<playIfStateSkipedFromLower>false</playIfStateSkipedFromLower>
		</Item>
	</stackCountVisScripts>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>