    <descTemplate href="DeathlyVirus.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.HighStackEffect">
            <effect type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.elements.impacts.ImpactKill" />
                </impactsOn>
            </effect>
            <stackCountTrigger>100</stackCountTrigger>
        </Item>
        <Item type="gameMechanics.elements.effects.NotStackableEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.MagicDoT">
                    <parameters>
                        <tickLength>3000</tickLength>
                        <damagePerTick>0.05</damagePerTick>
                        <impactsPerTick>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                        <zone href="/Maps/AstralIsle25/Zones/AstralIsle25/AstralIsle25.(ZoneResource).xdb" />
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                                <radius>8</radius>
                                                <impacts>
                                                    <Item type="gameMechanics.constructor.schemes.buff.StackBuffGeneric">
                                                        <buff href="DeathlyVirus.(BuffResource).xdb" />
                                                        <delta type="gameMechanics.elements.calcers.FloatData">
                                                            <value>1</value>
                                                        </delta>
                                                        <attachIfNotExist>true</attachIfNotExist>
                                                        <resetTimer>false</resetTimer>
                                                    </Item>
                                                </impacts>
                                                <filter type="gameMechanics.constructor.basicElements.FilterOr">
                                                    <filters>
                                                        <Item type="gameMechanics.world.creature.AvatarFilter" />
                                                        <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                            <predicates>
