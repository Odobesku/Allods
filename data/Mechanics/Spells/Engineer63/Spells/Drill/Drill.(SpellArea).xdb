                                                <buff href="/Mechanics/Spells/CommonBuffs/AssistantForkAgro/AssistantForkEnemies.(BuffResource).xdb" />
                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier>30</multiplier>
                                                </durationScaler>
