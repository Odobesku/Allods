<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/StalkerShootLightningArrow_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<startPoint type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureChannelDirectAction">
						<visActionID>ray</visActionID>
						<channelingFx href="/Spells/FX/Spells/StalkerShootLightningArrow_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<startPoint type="VisPointLocator">
							<locator>Slot_BodyFX</locator>
						</startPoint>
						<endPoint type="VisPointLocator">
							<locator>Slot_FX</locator>
						</endPoint>
					</Item>
					<Item type="CreatureEffectsOnTarget">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<locator>Slot_FX</locator>
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureRunVisActionResource">
						<resource href="/Spells/VisScripts/HitPostFxOnTarget/HitLightningShader.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
					</Item>
					<Item type="VisActionDelay">
						<visActionID>1000</visActionID>
						<time>0</time>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionStopAction">
				<stoppedActionID>ray</stoppedActionID>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
