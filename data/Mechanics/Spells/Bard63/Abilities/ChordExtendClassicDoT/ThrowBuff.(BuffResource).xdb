<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>215067</resourceId>
    </Header>
    <Name href="ThrowBuff.(BuffResource).Name.txt" />
    <Description href="ThrowBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Bard/Terrify.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                    <spells>
                        <Item href="/Mechanics/Spells/Bard63/Spells/GuitarThrow/GuitarThrow03.(SpellSingleTarget).xdb" />
                    </spells>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                <coeff>0.5</coeff>
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellPrepareDurationModifier">
            <spell href="/Mechanics/Spells/Bard63/Spells/GuitarThrow/GuitarThrow03.(SpellSingleTarget).xdb" />
            <factor>-1</factor>
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>