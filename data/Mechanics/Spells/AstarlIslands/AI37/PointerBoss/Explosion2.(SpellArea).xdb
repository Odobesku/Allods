<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739877781</resourceId>
	</Header>
	<Name href="Explosion2.(SpellArea).Name.txt" />
	<visualScripts href="Explosion2.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
	<targetType>STTSelf</targetType>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>600000</duration>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactKill" />
			<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
				<delay>1600</delay>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<radius>5</radius>
						<affectHolder>false</affectHolder>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateOr">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											</Item>
										</predicates>
									</Item>
								</predicates>
								<impactsIf>
									<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
										<element>FIRE</element>
										<damage>40</damage>
									</Item>
								</impactsIf>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
										<mobs>
											<Item href="/Creatures/GoblinWarrior/Instances/AstralIsle37/AI37PointerBoss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
										</mobs>
									</Item>
								</predicates>
								<impactsIf>
									<Item type="gameMechanics.elements.impacts.DirectDamage">
										<damage>1</damage>
										<scaler type="gameMechanics.elements.scalers.TrivialScaler" />
										<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
											<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
												<multiplier>0.1</multiplier>
											</mulCalcer>
										</scalerTarget>
									</Item>
								</impactsIf>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
						<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
						<data href="Boom.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>5</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
