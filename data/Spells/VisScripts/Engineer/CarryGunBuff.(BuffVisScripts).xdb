					</forAnimations>
				</Item>
				<Item>
					<play>hitEngineer</play>
					<forAnimations>
						<Item>hit</Item>
						<Item>hit01</Item>
						<Item>hitCritical</Item>
						<Item>hitCritical01</Item>
						<Item>dodge</Item>
						<Item>standWound</Item>
