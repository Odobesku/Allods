<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739902760</resourceId>
	</Header>
	<Name href="ToNest1.(BuffResource).Name.txt" />
	<image href="/Interface/Ingame/EngineerOverheating/textures/EngineerScavengerCounter1.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectOnLand">
			<impactsOnLand>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="SavedBuff.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.DirectDamage">
							<damage>1</damage>
							<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
							</scalerTarget>
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ToNest1.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
					<radius>10</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
									<resources>
										<Item href="TargetNest.(ProjectileResource).xdb" />
										<Item href="SavingProjectile.(ProjectileResource).xdb" />
									</resources>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impactsIf>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Unworthy.(BuffResource).xdb" />
				</Item>
			</impactsOnLand>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<isClientReplicated>false</isClientReplicated>
	<groups>
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
