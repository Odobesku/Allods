<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739884566</resourceId>
	</Header>
	<Name href="PoisonSpitAOE.(SpellArea).Name.txt" />
	<visualScripts href="PoisonSpitAOE.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<prepareDuration>1000</prepareDuration>
	<targetType>STTPoint</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>1000</duration>
		</cooldown>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
				<element>POISON</element>
				<damage>30</damage>
				<scaler type="gameMechanics.elements.scalers.MagicScaler" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="PuddleSummonCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</predicates>
				<elseImpacts>
					<Item type="gameMechanics.elements.impacts.ReturningImpact">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
								<impacts>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="PuddleSummonCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
											<multiplier>4</multiplier>
										</durationScaler>
									</Item>
									<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
										<affectGroup>Friends</affectGroup>
										<affectHolder>false</affectHolder>
										<impacts>
											<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
												<buff href="PuddleSummonCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											</Item>
										</impacts>
										<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
													<mobs>
														<Item href="/Creatures/BlackWidow/Instances/AstralIsle21/AstralSpiderSmallRanged.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
													</mobs>
												</Item>
												<Item type="gameMechanics.constructor.basicElements.PredicateNot">
													<predicate type="gameMechanics.elements.resources.ResourceBuff">
														<buff href="PuddleSummonCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
													</predicate>
												</Item>
											</predicates>
										</filter>
									</Item>
								</impacts>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
						<projectileData>
							<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
								<destination type="gameMechanics.map.destination.SelfPosDestination" />
								<directed>false</directed>
							</moveType>
							<resource href="PoisonPuddle.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
						</projectileData>
						<pool href="PuddlePool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					</Item>
				</elseImpacts>
			</Item>
		</targetImpacts>
	</mechanics>
	<speed>20</speed>
	<radius>5</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
