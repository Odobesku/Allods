					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
					<Item type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.elements.predicates.PredicateIsPet" />
					</Item>
				</predicates>
			</Item>
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
				<selector type="gameMechanics.elements.calcers.RangeSelectorResource">
					<range min="0" max="40" />
					<withinRange>false</withinRange>
					<minCandidatesCount>3</minCandidatesCount>
					<targetCount>3</targetCount>
				</selector>
				<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
							</predicates>
						</Item>
					</predicates>
				</filter>
				<impacts>
