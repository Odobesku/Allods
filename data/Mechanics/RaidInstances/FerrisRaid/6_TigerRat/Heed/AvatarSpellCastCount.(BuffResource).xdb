                                                    <value>200000</value>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <count type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                <calcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                    <buff href="AvatarSpellCastCount.(BuffResource).xdb" />
                                </calcer>
                            </count>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>12000</duration>
    <stackLimit>255</stackLimit>
    <isHelpful>false</isHelpful>
