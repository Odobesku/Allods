<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739817732</resourceId>
	</Header>
	<element>LIGHTNING</element>
	<Name href="ElectroAOE.(SpellArea).Name.txt" />
	<visualScripts href="ElectroAOE.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<nameTemplate href="ElectroAOE.(SpellArea).Name.txt" />
	<range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
	<prepareDuration>2000</prepareDuration>
	<targetType>STTSelf</targetType>
	<isWorkOnDead>false</isWorkOnDead>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>15000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="Calm.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</predicates>
			</Item>
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<radius>60</radius>
						<impacts>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="Positive.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</impacts>
						<filter type="gameMechanics.world.creature.AvatarFilter" />
						<targetsLimit>1</targetsLimit>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
						<element>LIGHTNING</element>
						<scaler type="gameMechanics.elements.scalers.MagicScaler" />
						<damage>15</damage>
					</Item>
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<radius>85</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
