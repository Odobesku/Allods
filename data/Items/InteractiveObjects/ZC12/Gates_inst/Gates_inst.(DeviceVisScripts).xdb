<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states>
		<Item>
			<action type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>idle</Item>
						</animations>
					</Item>
				</elements>
			</action>
		</Item>
		<Item>
			<action type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceVisActionChangeModel">
						<visObj href="/World/SacredLand/ZoneContested12/Models/ZC12_Gates.(VisObjectTemplate).xdb" />
					</Item>
					<Item type="DeviceAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>specialIdle</Item>
						</animations>
					</Item>
				</elements>
			</action>
		</Item>
		<Item>
			<action type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceVisActionChangeModel">
								<visObj href="/World/SacredLand/ZoneContested12/Models/ZC12_Gates.(VisObjectTemplate).xdb" />
							</Item>
						</elements>
					</Item>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceAnimationAction">
								<animations>
									<Item>specialIdleStart</Item>
								</animations>
							</Item>
						</elements>
					</Item>
					<Item type="DeviceVisActionList">
						<elements>
							<Item type="DeviceVisActionDelay">
								<time>2030</time>
							</Item>
							<Item type="DeviceAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>specialIdle</Item>
								</animations>
							</Item>
						</elements>
					</Item>
				</elements>
			</action>
		</Item>
	</states>
</DeviceVisScripts>
