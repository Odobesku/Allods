<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739940286</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
        <Item href="/Mechanics/Spells/Groups/BardPerfomance.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
    </groups>
    <element>DISEASE</element>
    <Name href="Party.(SpellArea).Name.txt" />
    <Description href="Party.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value var="var" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/MassDissonance.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Bard/Bard_Party.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <prepareDuration>0</prepareDuration>
    <targetType>STTCurrentTarget</targetType>
    <ranks>
        <Item href="Party01.(SpellArea).xdb" />
        <Item href="Party02.(SpellArea).xdb" />
        <Item href="Party03.(SpellArea).xdb" />
    </ranks>
    <modifiers>
        <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
            <effects>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>1</coeff>
                        <calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.002</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
                                    </stat>
                                    <valueType>ShortTerm</valueType>
                                </mulCalcer>
                                <sum>0.5</sum>
                            </scaler>
                            <value>1</value>
                        </calcer>
                    </scaler>
                </Item>
            </effects>
            <onBehalfOfHolder>true</onBehalfOfHolder>
        </Item>
    </modifiers>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                        <ability href="/Mechanics/Spells/Bard63/Abilities/PartyExtraBuff/PartyExtraBuff02.(AbilityResource).xdb" />
                        <anyRank>false</anyRank>
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.elements.resources.ResourceVariable">
                    <variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
                    <sub>2</sub>
                </resourceIf>
                <resourceElse type="gameMechanics.elements.resources.ResourceIf">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                            <ability href="/Mechanics/Spells/Bard63/Abilities/PartyExtraBuff/PartyExtraBuff01.(AbilityResource).xdb" />
                            <anyRank>false</anyRank>
                        </Item>
                    </predicates>
                    <resourceIf type="gameMechanics.elements.resources.ResourceVariable">
                        <variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
                        <sub>3</sub>
                    </resourceIf>
                    <resourceElse type="gameMechanics.elements.resources.ResourceVariable">
                        <variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
                        <sub>4</sub>
                    </resourceElse>
                </resourceElse>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                <mark href="SoloPartyHitOnCaster.(MarkResource).xdb" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff hrefvar="buff" />
                <stacks type="gameMechanics.elements.calcers.FloatData">
                    <value>3</value>
                </stacks>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>DISEASE</element>
                        <damage var="damage" />
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impacts>
                <groupRepeaters>true</groupRepeaters>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>