<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.LootTableResource>
    <Header>
        <resourceId>261655</resourceId>
    </Header>
    <table type="gameMechanics.constructor.schemes.item.LootTablePredicates">
        <predicates>
            <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                <lhs type="gameMechanics.elements.calcers.LongData">
                    <value>2</value>
                </lhs>
                <rhs type="itemService.serverVariables.CalcerServerVariable">
                    <variableResource href="/Mechanics/ServerUnlock/ServerUnlock.(ServerVariableResource).xdb" />
                </rhs>
            </Item>
        </predicates>
        <lootTable type="gameMechanics.constructor.schemes.item.LootTableAnd">
            <entries>
                <Item>
                    <lootTable type="gameMechanics.constructor.schemes.item.LootTableSingleItem">
                        <itemProvider type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="ServerUnlock.Common.(ItemResource).xdb" />
                        </itemProvider>
                        <isForAll>true</isForAll>
                    </lootTable>
                    <chance>0.25</chance>
                </Item>
            </entries>
        </lootTable>
    </table>
</gameMechanics.constructor.schemes.item.LootTableResource>