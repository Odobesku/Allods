                <playOnMount>idle</playOnMount>
                <playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
                <playOnRiderTop>mountBikeIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>swim</animation>
                <playOnMount>run</playOnMount>
                <playOnRiderBottom>mountBikeRun</playOnRiderBottom>
                <playOnRiderTop>mountBikeRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>swimBackwards</animation>
                <playOnMount>run</playOnMount>
                <playOnRiderBottom>mountBikeRun</playOnRiderBottom>
                <playOnRiderTop>mountBikeRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>swimLeft</animation>
                <playOnMount>run</playOnMount>
                <playOnRiderBottom>mountBikeRun</playOnRiderBottom>
                <playOnRiderTop>mountBikeRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>swimRight</animation>
                <playOnMount>run</playOnMount>
                <playOnRiderBottom>mountBikeRun</playOnRiderBottom>
                <playOnRiderTop>mountBikeRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>fall</animation>
                <playOnMount>jump</playOnMount>
                <playOnRiderBottom>mountBikeJump</playOnRiderBottom>
                <playOnRiderTop>mountBikeJump</playOnRiderTop>
            </Item>
            <Item>
                <animation>jump</animation>
                <playOnMount>jump</playOnMount>
                <playOnRiderBottom>mountBikeJump</playOnRiderBottom>
                <playOnRiderTop>mountBikeJump</playOnRiderTop>
            </Item>
            <Item>
                <animation>jumpEnd</animation>
                <playOnMount>jumpEnd</playOnMount>
                <playOnRiderBottom>mountBikeJumpEnd</playOnRiderBottom>
                <playOnRiderTop>mountBikeJumpEnd</playOnRiderTop>
            </Item>
            <Item>
                <animation>jumpLandRun</animation>
                <playOnMount>jumpLandRun</playOnMount>
                <playOnRiderBottom>mountBikeJumpLandRun</playOnRiderBottom>
                <playOnRiderTop>mountBikeJumpLandRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>jumpStart</animation>
                <playOnMount>jumpStart</playOnMount>
                <playOnRiderBottom>mountBikeJumpStart</playOnRiderBottom>
                <playOnRiderTop>mountBikeJumpStart</playOnRiderTop>
            </Item>
            <Item>
                <animation>mountRideSit</animation>
                <playOnRiderBottom>mountBikeSit</playOnRiderBottom>
                <playOnRiderTop>mountBikeSit</playOnRiderTop>
            </Item>
            <Item>
                <animation>levelUp</animation>
                <playOnMount>levelUp</playOnMount>
                <playOnRiderBottom>mountBikeLevelUp</playOnRiderBottom>
                <playOnRiderTop>mountBikeLevelUp</playOnRiderTop>
            </Item>
            <Item>
                <animation>run</animation>
                <playOnMount>run</playOnMount>
                <playOnRiderBottom>mountBikeRun</playOnRiderBottom>
                <playOnRiderTop>mountBikeRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>runCharge</animation>
                <playOnMount>runCharge</playOnMount>
                <playOnRiderBottom>mountBikeRun</playOnRiderBottom>
                <playOnRiderTop>mountBikeRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>runFast</animation>
                <playOnMount>runFast</playOnMount>
                <playOnRiderBottom>mountBikeRun</playOnRiderBottom>
                <playOnRiderTop>mountBikeRun</playOnRiderTop>
            </Item>
            <Item>
                <animation>shuffleLeft</animation>
                <playOnMount>shuffleLeft</playOnMount>
                <playOnRiderBottom>mountBikeShuffleLeft</playOnRiderBottom>
