<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739904897</resourceId>
	</Header>
	<Name href="RoboBoss_Chain.(BuffResource).Name.txt" />
	<Description href="RoboBoss_Chain.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Quest/Chains.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.NotStackableEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.PureDamage">
							<damage>1</damage>
							<scaler type="gameMechanics.elements.scalers.TrivialScaler" />
							<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
									<multiplier>0.125</multiplier>
								</mulCalcer>
							</scalerTarget>
						</Item>
					</impacts>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="PortalDispell_Permission.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="RoboBoss_Chain.(BuffResource).xdb" />
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<eventClasses>
				<Item>gameMechanics.elements.events.EventDeath</Item>
			</eventClasses>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
							<pool href="PortalSpecial.(SummonPool).xdb" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.PostponedImpacts">
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="RoboBoss_Chain.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
									<impacts>
										<Item type="gameMechanics.elements.impacts.BuffDetacher">
											<buff href="PortalDispell_Permission.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="PortalSpecial_Green.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="PortalSpecial_Blue.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="PortalSpecial_Yellow.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="PortalSpecial_Red.(BuffResource).xdb" />
								</Item>
							</impacts>
							<spawnResource href="/Maps/FerrisRaid/SpawnTables/9_RoboBoss.(SpawnTable).xdb" />
						</Item>
					</impacts>
				</Item>
			</impacts>
			<eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>6</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="PortalDispell_Permission.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactKill" />
							</impactsIf>
						</Item>
					</impacts>
					<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
						</predicates>
					</filter>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="PortalKiller_pool.(SummonPool).xdb" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
									<resources>
										<Item href="RoboBoss_Chain.(MobWorld).xdb" />
									</resources>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
	<duration>13000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
