<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>300</delay>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectLightning_AstralMobs.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<scale>1.5</scale>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="VisActionList">
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Ships/Cannon.ProjectileFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<pointOnCaster type="VisPointLocator">
									<locator>Slot_Hand_R</locator>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator>FROM_LOCATOR_NAME</locator>
									<locatorName>Slot_Special03</locatorName>
								</pointOnTarget>
								<offendTime type="EffectOffendType" />
							</Item>
							<Item type="CreatureAstralSpellFXVisAction">
								<astralSpell type="AstralSpellProjectile">
									<shieldExplosion href="/Spells/FX/Ships/Shield.CanonHitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
									<shieldCrit href="/Spells/FX/Ships/Shield.CanonHitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
									<hullExplosion href="/Spells/FX/Ships/Hull.CanonHitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
									<hullCrit href="/Spells/FX/Ships/Hull.CanonHitLightning_Crit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
									<projectileFx href="/Spells/FX/Ships/Cannon.ProjectileFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								</astralSpell>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
