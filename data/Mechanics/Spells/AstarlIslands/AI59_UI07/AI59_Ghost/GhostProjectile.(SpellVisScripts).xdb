<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpellDirected</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectDisease.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/AstralComet_ProjectileRootMini.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="/Spells/FX/Spells/HitDisease.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<theGe>6</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</pointOnTarget>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
