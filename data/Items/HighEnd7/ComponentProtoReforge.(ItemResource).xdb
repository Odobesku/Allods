<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739939108</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Misc/Crafting/MagicPollen01.(UISingleTexture).xdb" />
    <source>Crafted</source>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseItemChoice">
        <warningUseText href="ComponentProtoReforge.(ItemResource).WarningUseText.txt" />
        <usages>
            <Item>
                <desc href="ComponentProtoReforge.(ItemResource).Desc.txt" />
                <image hrefvar="AltCurrimage" />
                <givenAltCurrency hrefvar="givenAltCurrency" />
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                        <currency hrefvar="givenAltCurrency" />
                    </Item>
                </actions>
                <consumeItems>1</consumeItems>
            </Item>
            <Item>
                <desc href="ComponentProtoReforge.(ItemResource).Desc02.txt" />
                <image hrefvar="ItemAltCurr" />
                <resultItem type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item hrefvar="givenItem" />
                </resultItem>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                        <item type="gameMechanics.constructor.schemes.item.RewardExchangeItemProvider">
                            <createCopy>true</createCopy>
                            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                <item hrefvar="givenItem" />
                            </item>
                        </item>
                        <count type="itemService.elements.avatarstuffcalcer.StuffCalcerAlternativeCurrency">
                            <currency hrefvar="givenAltCurrency" />
                        </count>
                    </Item>
                    <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                        <currency hrefvar="givenAltCurrency" />
                        <multiplier>-1</multiplier>
                        <multiplierCalcer type="itemService.elements.avatarstuffcalcer.StuffCalcerAlternativeCurrency">
                            <currency hrefvar="givenAltCurrency" />
                        </multiplierCalcer>
                    </Item>
                </actions>
                <consumeItems>0</consumeItems>
                <maxStack>1</maxStack>
            </Item>
        </usages>
        <useStack>true</useStack>
    </functionalPart>
    <stackLimit>100000</stackLimit>
    <quality href="/Mechanics/ItemQualities/Common.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.ExchangeItem" />
    <binding>BindOnPickup</binding>
</gameMechanics.constructor.schemes.item.ItemResource>