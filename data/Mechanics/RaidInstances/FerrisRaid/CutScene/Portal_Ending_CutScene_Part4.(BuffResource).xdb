                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>3000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>Cut_Scene_Walk_DiArder</scriptID>
                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                    <runningMode>true</runningMode>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>Cut_Scene_Portal</scriptID>
                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                    <runningMode>true</runningMode>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <object href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Allies/DiArder_CutScene.(MobWorld).xdb" />
                    <pool href="CutScenePool.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
