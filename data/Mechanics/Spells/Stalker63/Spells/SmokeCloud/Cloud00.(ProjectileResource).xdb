<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>197039</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Cloud00.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/Stalker70_SmokeCloud.(VisObjectTemplate).xdb" />
    <lifeLengthCap>8000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <tick>1000</tick>
            <affectGroup>Group</affectGroup>
            <radius>7</radius>
            <height>2</height>
            <filter type="gameMechanics.world.creature.AliveFilter">
                <alowImmortal>false</alowImmortal>
            </filter>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff hrefvar="buff" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff01.(BuffResource).xdb" />
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                    <ability href="/Mechanics/Spells/Stalker63/Abilities/SmokeCloudEnemyWounds/Ability00.(AbilityResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.TickableEntityAura">
                    <affectGroup>Enemies</affectGroup>
                    <radius>7</radius>
                    <height>3</height>
                    <filter type="gameMechanics.world.creature.AliveFilter" />
                    <impactsIn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Wounds/Wounds.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>8</multiplier>
                            </durationScaler>
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Wounds/Wounds.(BuffResource).xdb" />
                        </Item>
                    </impactsOut>
                </Item>
            </effectsIf>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>