<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>special</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/DC_2BossMindflayer_ReadySpellDirectDown_Fire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/DC_3BossDraconid_FireSpitLandProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/HitFireballBig.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="ShakeAction">
				<params href="/Spells/FX/InterfaceFX/CameraShake_Fatality.(CameraShakeParameters).xdb#xpointer(/CameraShakeParameters)" />
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
