<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739913575</resourceId>
    </Header>
    <Name href="CorrosiveShot.(SpellSingleTarget).Name.txt" />
    <visualScripts href="CorrosiveShot.(SpellVisScripts).xdb" />
    <prepareDuration>4000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Adds/DoNotCastDoNotMove.(BuffResource).xdb" />
                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>2</multiplier>
                </durationScaler>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>5</radius>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                        <time>300</time>
                        <distance>5</distance>
                    </Item>
                </impacts>
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                </filter>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="CorrosionDot.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>ASTRAL</element>
                <damage>15</damage>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>15</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>