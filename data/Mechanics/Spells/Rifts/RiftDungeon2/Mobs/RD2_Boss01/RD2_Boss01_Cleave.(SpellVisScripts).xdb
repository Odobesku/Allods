<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>100</time>
                    </Item>
                    <Item type="CreatureRotateToCastPointAction" />
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Mobs/WormGlacial_CorruptionCleave_Decal.(VisObjectTemplate).xdb" />
                                <fixPoint>true</fixPoint>
                                <lockScale>true</lockScale>
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>1300</time>
                    </Item>
                    <Item type="VisActionList">
                        <play>Simultaneously</play>
                        <elements>
                            <Item type="CreatureAnimationAction">
                                <animations>
                                    <Item>attack</Item>
                                </animations>
                                <advanced>
                                    <speed>1</speed>
                                </advanced>
                            </Item>
                            <Item type="CreatureEffectsAction">
                                <visualEffects>
                                    <Item>
                                        <effectFx href="/Spells/FX/Mobs/ArchitectDestroyer_SpellCastCleave.(VisObjectTemplate).xdb" />
                                        <locator>Slot_Global</locator>
                                        <offset y="-3.5" z="1.5" />
                                    </Item>
                                </visualEffects>
                            </Item>
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>