<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Mobs/Architect_Chain_Lightning.(VisObjectTemplate).xdb" />
				<fxLength>2</fxLength>
				<startPoint type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</endPoint>
				<velocity>30</velocity>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
