<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739903941</resourceId>
	</Header>
	<mechanics>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.BuffDetacher">
								<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</impactsIf>
						<impactsElse>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</impactsElse>
					</Item>
				</impacts>
				<spawnResource href="Main.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
