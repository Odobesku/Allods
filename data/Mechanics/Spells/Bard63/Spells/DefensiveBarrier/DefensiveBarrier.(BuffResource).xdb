<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739936468</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="DefensiveBarrier.(BuffResource).Name.txt" />
	<Description href="DefensiveBarrier.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Bard/AcousticBarrier.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Bard/DirgeBard_Slowdown.Buff.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDamageTrigger">
			<impacts>
				<targetToOffender>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateCreature" />
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.PureDamage">
								<damage>1</damage>
								<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
									<mulCalcer type="constructor.elements.CalcerFloatExternal">
										<externalCalcer hrefvar="externalCalcer" />
									</mulCalcer>
								</scaler>
							</Item>
						</impactsIf>
					</Item>
				</targetToOffender>
			</impacts>
			<scaleImpactsByDamage>true</scaleImpactsByDamage>
		</Item>
		<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
			<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
				<coeff>1</coeff>
				<calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
					<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</scaler>
					<value>-1</value>
				</calcer>
			</scaler>
		</Item>
	</effects>
	<duration var="duration" />
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<isMultiple>true</isMultiple>
	<ranks>
		<Item href="DefensiveBarrier01.(BuffResource).xdb" />
		<Item href="DefensiveBarrier02.(BuffResource).xdb" />
		<Item href="DefensiveBarrier03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
