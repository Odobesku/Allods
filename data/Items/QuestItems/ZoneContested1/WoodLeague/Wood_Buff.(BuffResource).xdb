<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>84232200</resourceId>
    </Header>
    <Name href="Wood_Buff_Name.txt" />
    <Description href="Wood_Buff_Desc.txt" />
    <image href="/Interface/Icons/Misc/Food/Caraway.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.3</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactHeal">
                    <heal>1</heal>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.7</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.ModifyWeaponDPS">
            <factor>1.9</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectIncreaseHealth">
            <bonusHealthPercent>0.7</bonusHealthPercent>
        </Item>
    </effects>
    <duration>30000</duration>
    <stackLimit>5</stackLimit>
    <isGradual>true</isGradual>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>