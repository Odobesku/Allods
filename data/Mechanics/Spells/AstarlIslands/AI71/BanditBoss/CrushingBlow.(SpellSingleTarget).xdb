<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739936137</resourceId>
    </Header>
    <Name href="CrushingBlow.(SpellSingleTarget).Name.txt" />
    <visualScripts href="CrushingBlow.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <prepareDuration>1</prepareDuration>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>2500</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="PowerStrikeResource.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                        <projectileData>
                            <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                            </moveType>
                            <resource href="ExtraPowerfulStrike.(ProjectileResource).xdb" />
                        </projectileData>
                        <pool href="/Mechanics/Spells/AstarlIslands/AI71/Common/AI71Pool.(SummonPool).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="PowerStrikeResource.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="Phase2.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                                <impactsElse>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="CoolHead.(BuffResource).xdb" />
                                        <stacks type="gameMechanics.elements.calcers.FloatData">
                                            <value>5</value>
                                        </stacks>
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>2</multiplier>
                        </durationScaler>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="PowerStrikeResource.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>FIRE</element>
                                <damage>70</damage>
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    </predicates>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                        </filter>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>FIRE</element>
                        <damage>70</damage>
                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>4</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>FIRE</element>
                                <damage>70</damage>
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    </predicates>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                        </filter>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>FIRE</element>
                        <damage>70</damage>
                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.StackBuff">
                                <buff href="CoolHead.(BuffResource).xdb" />
                                <delta type="gameMechanics.elements.calcers.FloatData">
                                    <value>-1</value>
                                </delta>
                            </Item>
                        </impacts>
                    </Item>
                </elseImpacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>1000</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>