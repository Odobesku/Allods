                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                        <mark href="/Mechanics/Spells/Engineer63/Abilities/DefenseStrategyGroup/StrategyGroupShield.(MarkResource).xdb" />
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impacts>
                    </Item>
                </finishImpacts>
                <targetsLimit>1</targetsLimit>
                <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
                    <order>Ascending</order>
