<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739932985</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/AssistantSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="DrillChannel.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Engineer/DrillChannel.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>20</value>
    </range>
    <prepareDuration>10000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <channelingMechanics>
            <channelingBuff href="DrillChannel.(BuffResource).xdb" />
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                        <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                        <radius>40</radius>
                                        <affectPets>true</affectPets>
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Power/Power.(BuffResource).xdb" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <tick>1000</tick>
            </Item>
        </casterChannelingEffects>
    </mechanics>
    <speed>30</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>