                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>1000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactMobChat">
                            <msg href="U_10_11_Replika_03.(TextMessage).xdb#xpointer(/gameMechanics.world.TextMessage)" />
                            <defaultSpeaker href="/Characters/Kania_female/Instances/Umoir/Umoir_Smeyana_Final_inst.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
