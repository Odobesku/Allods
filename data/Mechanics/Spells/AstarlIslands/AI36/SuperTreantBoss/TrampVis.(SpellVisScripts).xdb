<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="CreatureAnimationAction">
		<animations>
			<Item>specialAttack</Item>
		</animations>
		<channel>CHANNEL_ATTACK</channel>
		<channelOverrideScript />
		<advanced>
			<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
		</advanced>
	</wholeCasting>
	<launch type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Mobs/DC_1Boss_DustCloud_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fixPoint>true</fixPoint>
				<scale>1.5</scale>
			</Item>
		</visualEffects>
	</launch>
</SpellVisScripts>
