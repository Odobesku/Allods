<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
				<advanced>
					<speed>1</speed>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>3250</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>250</delay>
								<effectFx href="/Spells/FX/Spells/Cone_Decal_10_45.(VisObjectTemplate).xdb" />
								<fixPoint>true</fixPoint>
								<lockScale>true</lockScale>
								<scale>2</scale>
							</Item>
							<Item>
								<delay>250</delay>
								<effectFx href="/Spells/FX/Spells/Cone_Decal_10_45.(VisObjectTemplate).xdb" />
								<fixPoint>true</fixPoint>
								<lockScale>true</lockScale>
								<scale>2</scale>
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureLockRotationAction" />
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="AI38_Turtle_Cleave.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<scale>1.8</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastDirected</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
