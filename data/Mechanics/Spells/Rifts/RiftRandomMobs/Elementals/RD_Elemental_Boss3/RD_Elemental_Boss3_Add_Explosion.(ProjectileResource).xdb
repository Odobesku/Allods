<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>208846</resourceId>
    </Header>
    <name href="RD_Elemental_Boss3_Add_Explosion.(ProjectileResource).Name.txt" />
    <visObject href="RD_Elemental_Boss3_Add_Explosion.(VisObjectTemplate).xdb" />
    <lifeLengthCap>3000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <radius>6</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>ASTRAL</element>
                                    <damage>1</damage>
                                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                        <scalers>
                                            <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
                                                </mulCalcer>
                                            </Item>
                                        </scalers>
                                    </scaler>
                                </Item>
                            </impacts>
                            <finalImpactsOnHolder>
                                <Item type="gameMechanics.elements.impacts.ReturningImpactsGeneric">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                            </finalImpactsOnHolder>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>