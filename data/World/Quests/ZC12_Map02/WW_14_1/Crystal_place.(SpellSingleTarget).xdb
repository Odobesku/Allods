                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                <zone href="/Maps/ZC12_Map02/ScriptZones/WW_14_1_Crystal_02.(ScriptZone).xdb" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                <id href="Counter1.(QuestCountId).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                <id href="Counter1_2.(QuestCountId).xdb" />
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                        <zone href="/Maps/ZC12_Map02/ScriptZones/WW_14_1_Crystal_03.(ScriptZone).xdb" />
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                        <id href="Counter1.(QuestCountId).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                        <id href="Counter1_3.(QuestCountId).xdb" />
                                    </Item>
                                </impactsIf>
                                <impactsElse>
