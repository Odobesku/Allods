<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>220790</resourceId>
    </Header>
    <Name href="ForcedAggro.(BuffResource).Name.txt" />
    <Description href="ForcedAggro.(BuffResource).Description.txt" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>2</radius>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                    <mobs>
                                                        <Item href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/EnergySource/EnergySource.(MobWorld).xdb" />
                                                    </mobs>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                                    </impacts>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                    <data href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakBoss/LightningSphere/LightningHit.(ClientData).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                    <element>LIGHTNING</element>
                                                    <damage>8</damage>
                                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                        <filters>
                                            <Item type="gameMechanics.world.creature.AliveFilter" />
                                            <Item type="gameMechanics.world.creature.CreatureFilter" />
                                        </filters>
                                    </filter>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>400</tick>
                </Item>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>2</radius>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                    <mobs>
                                                        <Item href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/EnergySource/EnergySource.(MobWorld).xdb" />
                                                    </mobs>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                                    </impacts>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                    <data href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakBoss/LightningSphere/LightningHit.(ClientData).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                    <element>LIGHTNING</element>
                                                    <damage>8</damage>
                                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                        <filters>
                                            <Item type="gameMechanics.world.creature.AliveFilter" />
                                            <Item type="gameMechanics.world.creature.CreatureFilter" />
                                        </filters>
                                    </filter>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>400</tick>
                    <initialDelay>200</initialDelay>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="SpherePlane.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectNoAggroChecks" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakBoss/LightningSphere/LightningSphereTarget.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakBoss/LightningSphere/LightningSphereTarget.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/EnergySource/EnergySourcePlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/EnergySource/EnergySourcePlane.(Plane).xdb" />
            </visibilityRule>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
