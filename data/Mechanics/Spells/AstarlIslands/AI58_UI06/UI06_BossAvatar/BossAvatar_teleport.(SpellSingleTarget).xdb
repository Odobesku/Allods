<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739851636</resourceId>
	</Header>
	<Name href="BossAvatar_teleport.(SpellSingleTarget).Name.txt" />
	<image href="/Interface/Icons/Mounts/SpellsMounts/Blink.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualScripts href="/Spells/VisScripts/Creatures/BossAvatar/Blink.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<nameTemplate href="BossAvatar_teleport.(SpellSingleTarget).Name.txt" />
	<prepareDuration>1000</prepareDuration>
	<targetType>STTSelf</targetType>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>20000</duration>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactTeleport">
				<destination type="gameMechanics.map.destination.DestinationLocator">
					<locator>
						<scriptID>AI58_AvatarTeleport</scriptID>
						<map href="/Maps/AstralIsle58_UI06/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</locator>
				</destination>
				<finishImpacts>
					<Item type="gameMechanics.elements.impacts.RemoveMeFromAvatarTarget" />
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="BossAvatar_Pull.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
						<selector type="gameMechanics.elements.calcers.RangeSelectorResource">
							<range min="0" max="0" />
							<withinRange>false</withinRange>
							<minCandidatesCount>0</minCandidatesCount>
							<targetCount>0</targetCount>
						</selector>
						<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateOr">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</predicates>
								</Item>
							</predicates>
						</filter>
						<impacts>
							<Item>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
										</predicates>
										<impactsIf>
											<Item type="gameMechanics.elements.impacts.ImpactTeleport">
												<destination type="gameMechanics.map.destination.DestinationModified">
													<destination type="gameMechanics.map.destination.DestinationLocator">
														<locator>
															<scriptID>AI58_AvatarTeleport</scriptID>
															<map href="/Maps/AstralIsle58_UI06/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
														</locator>
													</destination>
													<modifiers>
														<Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
															<alternatives>
																<Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
																	<radius type="gameMechanics.elements.calcers.FloatData">
																		<value>10</value>
																	</radius>
																</Item>
															</alternatives>
															<safetyRadius>10</safetyRadius>
														</Item>
													</modifiers>
												</destination>
												<finishImpacts>
													<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
														<buff href="BossAvatar_Pull1.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
													</Item>
												</finishImpacts>
											</Item>
										</impactsIf>
										<impactsElse>
											<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
												<buff href="BossAvatar_Pull1.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											</Item>
										</impactsElse>
									</Item>
								</impacts>
							</Item>
						</impacts>
					</Item>
				</finishImpacts>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
