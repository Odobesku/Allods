<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<preconditional>false</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>DIE</mode>
						<animations>
							<Item>spellCastDirectedEngineer</Item>
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<channelOverrideScript />
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/RaceClass_EngineerHadagan.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<lockScale>true</lockScale>
								<fadeInTime>300</fadeInTime>
								<fadeOutTime>300</fadeOutTime>
								<locator>Global</locator>
								<offendTime />
								<ignoreParentRotation>false</ignoreParentRotation>
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/RaceClass_EngineerHadaganTurr.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<fadeOutTime>200</fadeOutTime>
								<locator>Slot_Hand_R</locator>
								<offendTime />
								<ignoreParentRotation>false</ignoreParentRotation>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
