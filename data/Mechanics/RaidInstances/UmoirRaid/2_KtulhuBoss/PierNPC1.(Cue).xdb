<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>739833029</resourceId>
    </Header>
    <name href="PierNPC1.(Cue).Name.txt" />
    <text href="PierNPC1.(Cue).Text.txt" />
    <conditions>
        <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
            <predicates>
                <Item type="gameMechanics.map.variables.PredicateMapVariableGreater">
                    <variableResource href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/PierBoss.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <minValue type="gameMechanics.elements.calcers.FloatData">
                        <value>0</value>
                    </minValue>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.map.variables.PredicateMapVariableGreater">
                        <variableResource href="KtulhuBoss.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                        <minValue type="gameMechanics.elements.calcers.FloatData">
                            <value>0</value>
                        </minValue>
                    </predicate>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                </Item>
            </predicates>
        </Item>
    </conditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.map.variables.PredicateMapVariableLess">
                    <variableResource href="Scene/KtulhuScene.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <maxValue type="gameMechanics.elements.calcers.FloatData">
                        <value>1</value>
                    </maxValue>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="Scene/Scene.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Scene/KtulhuScene.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>10500</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Scene/KtulhuScenario.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                            <spawnResource href="Scene/Scene.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>11000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                                    <mob>
                                        <scriptID>Ktulhu</scriptID>
                                        <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                    </mob>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                                    <mob>
                                        <scriptID>Ship</scriptID>
                                        <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                    </mob>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                            <variable href="Scene/KtulhuScene.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                            <summand>1</summand>
                        </Item>
                    </impacts>
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                    <mob>
                        <scriptID>Ktulhu</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </mob>
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                    <mob>
                        <scriptID>Ship</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </mob>
                </Item>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="TeleportOn.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <summand>-2</summand>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Teleport.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsElse>
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>