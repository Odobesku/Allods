<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>useSpecialLoop</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectFx href="/Spells/FX/Mobs/Magicmeter_Main01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>false</fixPoint>
						<lockScale>true</lockScale>
						<locator>Slot_Hand_R</locator>
						<member>Assaulter</member>
						<locatorName>Slot_Glove_R</locatorName>
						<offset x="0" y="0" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
