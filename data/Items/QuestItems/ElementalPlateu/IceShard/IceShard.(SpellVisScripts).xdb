<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirected</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PocketSpellIce01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/MageIceShardsAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<startPoint type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
