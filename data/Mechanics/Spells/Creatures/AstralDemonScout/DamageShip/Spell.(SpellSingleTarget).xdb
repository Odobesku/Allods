<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>205296</resourceId>
    </Header>
    <iffPolicy>Enemies</iffPolicy>
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <mechanics>
        <cooldown>
            <duration>1</duration>
            <scaler type="gameMechanics.elements.scalers.WeaponSpeedScaler" />
        </cooldown>
        <conditions>
            <Item type="gameMechanics.elements.predicates.BinaryPredicateSwitchActors">
                <predicate type="gameMechanics.elements.predicates.PredicateIsAggroLeader" />
            </Item>
        </conditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.world.ship.elements.PredicateIsShip" />
                    <Item type="gameMechanics.elements.predicates.PredicateDevice" />
                </predicates>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.world.ship.elements.ImpactDeviceHit">
                <damage type="gameMechanics.elements.calcers.CalcerMul">
                    <calcers>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value>60</value>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.CalcerExp">
                            <base>1.33</base>
                            <powCalc type="gameMechanics.elements.calcers.CalcerDiff">
                                <minuend type="gameMechanics.elements.calcers.AstralSectorTLCalcerFloat" />
                                <subtrahend type="gameMechanics.elements.calcers.FloatData">
                                    <value>0</value>
                                </subtrahend>
                            </powCalc>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.InverseCalcer">
                            <value type="gameMechanics.elements.calcers.MobDpsModCalcer" />
                        </Item>
                    </calcers>
                </damage>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>