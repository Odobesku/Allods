<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>750</fadeInMS>
    <fadeOutMS>750</fadeOutMS>
    <geometry href="/Spells/FX/Mobs/ArchitectSiege_Core.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <particle href="/Spells/FX/Mobs/ArchitectSiege_Core.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)" />
    <scale>3</scale>
    <sound />
    <states>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/Mobs/ArchitectSiege_Core.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/Mobs/CannonArchitect_Target.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <visObjComponents>
        <Item type="AnimationFromParentComponent">
            <ifAnimationNotExistsRun>idle</ifAnimationNotExistsRun>
            <skipBlendOptimization>false</skipBlendOptimization>
            <synchronizeAnimationPosition>false</synchronizeAnimationPosition>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>