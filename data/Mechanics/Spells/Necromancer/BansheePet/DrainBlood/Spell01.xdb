                                                        <scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                                            <buff href="/Mechanics/Abilities/NecromancerTalents/VampireStudent/DarkMark.(BuffResource).xdb" />
                                                            <anyRank>true</anyRank>
                                                            <onlyFromMaster>true</onlyFromMaster>
                                                            <mul>1</mul>
                                                        </scalerTarget>
                                                        <damage>5.13</damage>
                                                        <impactsOnHitTarget>
                                                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                                                <impacts>
                                                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                                        <buff href="/Mechanics/Abilities/NecromancerTalents/VampireStudent/DarkMark.(BuffResource).xdb" />
                                                                        <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                                                    </Item>
                                                                </impacts>
                                                            </Item>
                                                        </impactsOnHitTarget>
                                                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                            <scalers>
                                                                <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                                <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                    <mulCalcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
                                                                        <ability href="/Mechanics/Abilities/NecromancerTalents/VampireStudent/Ability01.xdb" />
                                                                        <mul>1</mul>
                                                                    </mulCalcer>
                                                                </Item>
                                                            </scalers>
                                                        </scaler>
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsOnHitTarget>
                <impactsOnHitCaster>
                    <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactsToMaster">
