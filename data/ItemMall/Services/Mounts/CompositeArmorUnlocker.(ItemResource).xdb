<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>324220930</resourceId>
    </Header>
    <image href="/Interface/Icons/Equipment/Ships/RepairCorps.(UISingleTexture).xdb#xpointer(/UISingleTexture)"/>
    <itemMallDescription href="CompositeArmorUnlocker.(ItemResource).ItemMallDescription.txt"/>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)"/>
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.avatar.itemBag.GrantUnlockTakeAction">
                        <unlock href="/Mechanics/Unlocks/ItemMall/CompositeArmor.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)"/>
                    </Item>
                </actions>
                <consumeItems>1</consumeItems>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="/Mechanics/Unlocks/ItemMall/CompositeArmor.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)"/>
                </predicate>
            </Item>
        </predicates>
    </functionalPart>
    <stackLimit>100</stackLimit>
    <quality href="/Mechanics/ItemQualities/Rare.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)"/>
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
        <sellMod>0.5</sellMod>
    </prices>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="CompositeArmorUnlocker.(ItemResource).Name.txt"/>
    <description href="CompositeArmorUnlocker.(ItemResource).Description.txt"/>
    <category
            href="/Mechanics/ItemCategories/ItemMall.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)"/>
</gameMechanics.constructor.schemes.item.ItemResource>
