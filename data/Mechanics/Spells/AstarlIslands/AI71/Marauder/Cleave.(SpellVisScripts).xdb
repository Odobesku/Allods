<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<precastType>PRECAST_NONE</precastType>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<channel>CHANNEL_TURNSPECIAL</channel>
				<advanced>
					<animationKeysAction>
						<Item>
							<action type="VisActionList">
								<elements>
									<Item type="CreatureEffectsOnTarget">
										<visualEffects>
											<Item>
												<effectFx href="/Spells/FX/Spells/HitMelee.(VisObjectTemplate).xdb" />
												<locator>Slot_FX</locator>
												<offendTime type="EffectOffendConstDelay" />
											</Item>
										</visualEffects>
									</Item>
								</elements>
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/WarriorCleaveAbility.(VisObjectTemplate).xdb" />
								<locator>Slot_Global</locator>
								<offset z="0.25" />
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureTrailAction">
						<mainHandTrail href="/Spells/FX/InterfaceFX/TrailCleave.(TrailTemplate).xdb" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
