<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>261646</resourceId>
    </Header>
    <Name href="ServerUnlock.Common.(SpellSingleTarget).Name.txt" />
    <Description href="ServerUnlock.Common.(SpellSingleTarget).Description.txt" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem">
                <number>-1</number>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                        <lhs type="gameMechanics.elements.calcers.LongData">
                            <value>2</value>
                        </lhs>
                        <rhs type="itemService.serverVariables.CalcerServerVariable">
                            <variableResource href="/Mechanics/ServerUnlock/ServerUnlock.(ServerVariableResource).xdb#xpointer(/itemService.basicInterfaces.ServerVariableResource)" />
                        </rhs>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="itemService.serverVariables.ImpactServerVariableSummand">
                        <variableResource href="/Mechanics/ServerUnlock/PlayerCounter.(ServerVariableResource).xdb#xpointer(/itemService.basicInterfaces.ServerVariableResource)" />
                        <value type="gameMechanics.elements.calcers.FloatToLongCalcer">
                            <calcer type="gameMechanics.elements.calcers.CalcerActiveItemStack" />
                        </value>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                        <data href="ServerUnlock.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        <calcers>
                            <longEntries>
                                <Item>
                                    <name>PlayerCounter</name>
                                    <calcer type="gameMechanics.elements.calcers.CalcerLongSum">
                                        <calcers>
                                            <Item type="itemService.serverVariables.CalcerServerVariable">
                                                <variableResource href="/Mechanics/ServerUnlock/PlayerCounter.(ServerVariableResource).xdb#xpointer(/itemService.basicInterfaces.ServerVariableResource)" />
                                            </Item>
                                            <Item type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                                <calcer type="gameMechanics.elements.calcers.CalcerActiveItemStack" />
                                            </Item>
                                        </calcers>
                                    </calcer>
                                </Item>
                            </longEntries>
                        </calcers>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                        <data href="OldUnlock.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>