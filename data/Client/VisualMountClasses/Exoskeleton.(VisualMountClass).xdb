	</fxSettings>
	<controlParameters>
		<speedFactorForward>
			<startVelocity>12</startVelocity>
			<stopVelocity>2</stopVelocity>
			<startTime>200</startTime>
			<stopTime>150</stopTime>
		</speedFactorForward>
		<speedFactorBackward>
			<startVelocity>3</startVelocity>
			<stopVelocity>0</stopVelocity>
			<startTime>0</startTime>
			<stopTime>0</stopTime>
		</speedFactorBackward>
	</controlParameters>
	<pitchParameters>
		<minVelocity>0.4</minVelocity>
		<minVelocityPitch>3</minVelocityPitch>
		<topVelocity>8</topVelocity>
		<topVelocityPitch>15</topVelocityPitch>
		<minStepDeltaTMainAvatar>50</minStepDeltaTMainAvatar>
		<minStepDeltaT>150</minStepDeltaT>
		<minTurnRadius>1</minTurnRadius>
		<pitchMaxVelocity>10</pitchMaxVelocity>
		<maxPitch>30</maxPitch>
	</pitchParameters>
	<jumpSettings>
		<useJump>ALWAIS</useJump>
		<specialJumpPause>500</specialJumpPause>
	</jumpSettings>
	<reinsSettings>
		<use>false</use>
		<reinsBone01>Slot_Reins01</reinsBone01>
		<member>Assaulter</member>
		<disablingAnimations href="Horse/DisableReins.(CharacterAnimationsGroup).xdb" />
	</reinsSettings>
	<skinChangedScript href="/Spells/VisScripts/Commands/ChangeSkin.(CreatureVisActionResource).xdb" />
	<levelChangedScript href="/Spells/VisScripts/Mount/Exoskeleton_LevelUp.(CreatureVisActionResource).xdb" />
	<summonVisualScript href="/Spells/VisScripts/Mount/Exoskeleton_Summon.(SpellVisScripts).xdb" />
	<riderOrientation>Yaw_FromMountSlot</riderOrientation>
	<useRiderSpineTurn>false</useRiderSpineTurn>
	<nonDismountable>true</nonDismountable>
</VisualMountClass>
