<?xml version="1.0" encoding="UTF-8" ?>
<MobEventsScripts>
	<idleScriptParams>
		<idlePeriodMin>12</idlePeriodMin>
		<idlePeriodMax>20</idlePeriodMax>
		<script type="VisActionLoopAction">
			<actionToLoop type="CreatureAnimationAction">
				<use>USE_RANDOM_FROM_LIST</use>
				<animations>
					<Item>emoteAFK</Item>
					<Item>emoteBoring</Item>
					<Item>emoteProvoke</Item>
					<Item>emoteRasp</Item>
					<Item>emoteMuscle</Item>
				</animations>
				<advanced>
					<denyAutoHasten>true</denyAutoHasten>
				</advanced>
			</actionToLoop>
		</script>
	</idleScriptParams>
</MobEventsScripts>
