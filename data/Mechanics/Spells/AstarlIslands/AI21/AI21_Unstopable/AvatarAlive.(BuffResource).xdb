<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739904040</resourceId>
    </Header>
    <image href="/Interface/Icons/Spells/Necromancer/SummonSkeleton.chn.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.DeathTrigger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="AvatarAlive.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="AvatarAlive.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="AvatarAlive.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOff>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                    <table href="/Maps/AstralIsle21/SpawnTables/AstralIsle21/AI21_DruidWereWolfAdBoss.(MobSpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOff>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <stackLimit>60</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>