                                    </impacts>
                                    <conditions>
                                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                            <spells>
                                                <Item href="/Mechanics/Spells/Priest63/Spells/HeavenlyStrike/Spell01.(SpellArea).xdb" />
                                            </spells>
                                        </Item>
                                    </conditions>
                                </Item>
                            </conditionalImpacts>
                            <stages>
                                <Item>Start</Item>
                            </stages>
                        </Item>
                        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
                            <conditionalImpacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable href="Zeal.(VariableResource).xdb" />
                                            <summand>-1</summand>
                                        </Item>
                                    </impacts>
                                    <conditions>
                                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                            <spells>
                                                <Item href="/Mechanics/Spells/Priest63/Spells/CompleteHealUpgrade/Spell01.(SpellSingleTarget).xdb" />
                                            </spells>
                                        </Item>
                                    </conditions>
                                </Item>
                            </conditionalImpacts>
                            <stages>
                                <Item>Start</Item>
                            </stages>
                        </Item>
                        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
                            <conditionalImpacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable href="Zeal.(VariableResource).xdb" />
                                            <summand>-1</summand>
                                        </Item>
                                    </impacts>
                                    <conditions>
                                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                            <spells>
                                                <Item href="/Mechanics/Spells/Priest63/Spells/ChainSmite/Spell01.(SpellSingleTarget).xdb" />
                                            </spells>
                                        </Item>
                                    </conditions>
                                </Item>
                            </conditionalImpacts>
                            <stages>
                                <Item>Start</Item>
                            </stages>
                        </Item>
