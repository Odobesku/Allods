<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739864416</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>mul</name>
			<value var="coeff" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Engineer/FragGrenade.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.SpellsModifier">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
					<spells>
						<Item href="/Mechanics/Spells/Engineer/AirStrike/Spell01.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
					</spells>
				</Item>
			</predicates>
			<modifiers>
				<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
					<effects>
						<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
							<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
								<coeff var="coeff" />
							</scaler>
						</Item>
					</effects>
					<onBehalfOfHolder>false</onBehalfOfHolder>
				</Item>
			</modifiers>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Ability02.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Ability03.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
