<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>218436</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Spells/Stalker/StalkerArrowIncendiary.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/BuffVisScripts/DotFire.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <scaleOnTick>true</scaleOnTick>
                <damagePerTick var="damagePerTick" />
            </parameters>
            <element>FIRE</element>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.AbilityRankScaler">
                        <ability href="/Mechanics/Spells/StalkerNew/Talents/ArrowDamage/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        <mul>0.2</mul>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.WeaponScaler">
                        <source>Ranged</source>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>FIRE</element>
                    <damage var="damage" />
                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                        <scalers>
                            <Item type="gameMechanics.elements.scalers.AbilityRankScaler">
                                <ability href="/Mechanics/Spells/StalkerNew/Talents/ArrowDamage/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                <mul>0.05</mul>
                            </Item>
                            <Item type="gameMechanics.elements.scalers.WeaponScaler">
                                <source>Ranged</source>
                            </Item>
                        </scalers>
                    </scaler>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>12000</duration>
    <isStackable>true</isStackable>
    <isGradual>true</isGradual>
    <isHelpful>false</isHelpful>
    <isDetachableOnWill>false</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff03.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/RangedAttacks.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>