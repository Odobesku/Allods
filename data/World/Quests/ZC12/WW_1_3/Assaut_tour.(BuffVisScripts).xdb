<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>idle</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
				<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/World/SacredLand/ZoneContested12/Models/ZC12_Assault_Boat.(VisObjectTemplate).xdb" />
						<effectAnimations>
							<mode>LOOP</mode>
							<animations>
								<Item>idle</Item>
							</animations>
						</effectAnimations>
						<lockScale>true</lockScale>
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<member>Assaulter</member>
						<offset z="-0.7" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/World/Astral_ObjectShiningGlowBlue.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<scale>17</scale>
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<member>Assaulter</member>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Ships/EngineTL01.Idle.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<scale>0.6</scale>
						<member>Assaulter</member>
						<offset x="1.9" y="32.5" z="0.5" />
						<rotation y="0" z="180" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Ships/EngineTL01.Idle.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<lockScale>true</lockScale>
						<scale>0.6</scale>
						<member>Assaulter</member>
						<offendTime />
						<offset x="-1.9" y="32.5" z="0.5" />
						<rotation z="180" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureIfMainAvatarRunAction">
				<action type="CameraParametersAction">
					<parameters>
						<maxDistance>100</maxDistance>
						<minDistance>50</minDistance>
					</parameters>
				</action>
			</Item>
			<Item type="CreatureIfMainAvatarRunAction">
				<action type="ShiftAction">
					<verticalShift>10</verticalShift>
				</action>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
