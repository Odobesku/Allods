<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>specialAttack</Item>
						</animations>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
						</advanced>
					</Item>
					<Item type="VisActionList">
						<elements>
							<Item type="VisActionDelay">
								<time>270</time>
							</Item>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<effectAlias href="" />
										<fixPoint>true</fixPoint>
										<locator>FROM_LOCATOR_NAME</locator>
										<locatorName>Slot_Special80</locatorName>
										<offendTime />
									</Item>
									<Item>
										<effectFx href="/Spells/FX/Spells/GoblinTrioBoss_Cleave.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<effectAlias href="" />
										<fixPoint>true</fixPoint>
										<locator>Slot_Global</locator>
										<offendTime />
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
