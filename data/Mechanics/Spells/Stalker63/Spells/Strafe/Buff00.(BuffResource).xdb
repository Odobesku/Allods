<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739932268</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Buff00.(BuffResource).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/VolleyOfArrows.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>15</radius>
                    <affectGroup>Enemies</affectGroup>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateCanSee" />
                    </conditions>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                        <scalers>
                                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer href="CalcerDamage.(CalcerFloatResource).xdb" />
                                                </mulCalcer>
                                            </Item>
                                            <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                                            <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                                            <Item type="gameMechanics.elements.scalers.ScalerIf">
                                                <condition type="gameMechanics.elements.predicates.PredicateEquipped">
                                                    <dressType>AMMO</dressType>
                                                </condition>
                                                <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                    <mul>0.15</mul>
                                                    <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                                                        <summands>
                                                            <Item type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                                                <dressSlot>AMMO</dressSlot>
                                                            </Item>
                                                            <Item type="gameMechanics.elements.calcers.FloatData">
                                                                <value>-5</value>
                                                            </Item>
                                                        </summands>
                                                    </mulCalcer>
                                                    <sum>1</sum>
                                                </scalerIf>
                                                <scalerElse type="gameMechanics.elements.scalers.TrivialScaler" />
                                            </Item>
                                        </scalers>
                                    </scaler>
                                    <avgDamage>1</avgDamage>
                                    <source>Ranged</source>
                                </Item>
                            </impacts>
                            <groupRepeaters>true</groupRepeaters>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="ArrowHit.(ClientData).xdb" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AliveFilter" />
                    <targetsLimit var="targetsLimit" />
                    <sorting type="gameMechanics.elements.targetSelector.sorts.RandomSort" />
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                        <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                    </groups>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="InfinityInterrupt.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>