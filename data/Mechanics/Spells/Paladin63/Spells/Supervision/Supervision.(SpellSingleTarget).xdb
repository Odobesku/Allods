<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>206773</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <element>HOLY</element>
    <Name href="Supervision.(SpellSingleTarget).Name.txt" />
    <Description href="Supervision.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>stack</name>
            <value var="stack" />
        </Item>
        <Item>
            <name>dmg</name>
            <value>20</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Paladin/PaladinKanon.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Paladin/Exorcism.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>0</value>
    </range>
    <targetType>STTCurrentTarget</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Supervision01.(SpellSingleTarget).xdb" />
        <Item href="Supervision02.(SpellSingleTarget).xdb" />
        <Item href="Supervision03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Paladin63/Abilities/Canons/PurityCanon.(VariableResource).xdb" />
                <sub>1</sub>
            </Item>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Paladin63/Abilities/Canons/LightCanon.(VariableResource).xdb" />
                <sub>1</sub>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="SupervisionSelfBuff.(BuffResource).xdb" />
                <stacks type="gameMechanics.elements.calcers.FloatData">
                    <value var="stack" />
                </stacks>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>