<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>251832</resourceId>
    </Header>
    <isHidden>true</isHidden>
    <name href="Creeping_Death.(AbilityResource).Name.txt" />
    <visualScript type="CreatureVisObjectComponentsAction">
        <visObjComponents>
            <Item type="AttachedVisObjectComponent">
                <visObject href="/Mechanics/InstanceModifiers/Addon5/Creeping_Death/Normal/Creeping_Death_Visual.(VisObjectTemplate).xdb" />
            </Item>
        </visObjComponents>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>3000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Creeping_Death.(BuffResource).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/InstanceModifiers/Addon5/Creeping_Death/Normal/Creeping_Summon.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Mechanics/InstanceModifiers/Addon5/Creeping_Death/Creeping_Death_FX_Summon.(ClientData).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>4000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Creeping_Death_Link.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="Creeping_Death.(MobWorld).xdb" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectUnworthyOfAttention" />
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactKill" />
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/Planes/Banish.xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Outgoing</direction>
                <plane href="/Mechanics/Planes/Banish.xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Self</direction>
                <plane href="/Mechanics/Planes/Banish.xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/Planes/Banish.xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Outgoing</direction>
                <plane href="/Mechanics/Planes/Banish.xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Self</direction>
                <plane href="/Mechanics/Planes/Banish.xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                    <ability href="Creeping_Death.(AbilityResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>