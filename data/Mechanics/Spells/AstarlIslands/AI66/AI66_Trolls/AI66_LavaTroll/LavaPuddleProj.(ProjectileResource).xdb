<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>187387</resourceId>
    </Header>
    <name href="LavaPuddleProj.(ProjectileResource).Name.txt" />
    <corpulence>2</corpulence>
    <visObject href="/Spells/FX/World/FirePuddle.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0</altitude>
    <lifeLengthCap>7000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>2</radius>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblinRange/AI66_WildGoblinRange.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblin/AI66_WildGoblin.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblin/AI66_WildGoblin_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>FIRE</element>
                                    <damage>70</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impactsIf>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    </predicates>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>FIRE</element>
                                    <damage>40</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>