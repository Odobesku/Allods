        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.2</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                                                <groups>
                                                    <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                                    <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
                                                </groups>
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                            <selector type="gameMechanics.tools.SelectorRandomNotLess">
                                                <minIndex>0</minIndex>
                                            </selector>
                                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                                            <impacts>
                                                <Item>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                            <projectileData>
                                                                <moveType type="gameMechanics.world.projectile.MoveTypeDestination">
                                                                    <to type="gameMechanics.map.destination.SelfPosDestination" />
                                                                </moveType>
                                                                <resource href="IceBombProjectile.(ProjectileResource).xdb" />
                                                            </projectileData>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>10000</tick>
                </Item>
            </effects>
        </Item>
    </effects>
    <isAE>true</isAE>
