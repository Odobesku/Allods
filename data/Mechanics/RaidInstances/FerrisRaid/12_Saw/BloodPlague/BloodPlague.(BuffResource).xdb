<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739906093</resourceId>
    </Header>
    <Name href="BloodPlague.(BuffResource).Name.txt" />
    <Description href="BloodPlague.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/GenemodifiedPlague.tr.(UISingleTexture).xdb" />
    <visScript href="BloodPlague.(BuffVisScripts).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.NotStackableEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.PureDamageDoT">
                    <parameters>
                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
                                <calcers>
                                    <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                        <buff href="BloodPlague.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.calcers.FullHealthCalcer">
                                        <multiplier>0.05</multiplier>
                                    </Item>
                                </calcers>
                            </mulCalcer>
                        </scalerTarget>
                        <scaleOnTick>true</scaleOnTick>
                        <damagePerTick>1</damagePerTick>
                        <impactsPerTick>
                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="Heal.(BuffResource).xdb" />
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                <buff href="BloodPlague.(BuffResource).xdb" />
                                            </Item>
                                        </impactsIf>
                                        <impactsElse>
                                            <Item type="gameMechanics.elements.impacts.StackBuff">
                                                <buff href="BloodPlague.(BuffResource).xdb" />
                                                <delta type="gameMechanics.elements.calcers.FloatData">
                                                    <value>1</value>
                                                </delta>
                                            </Item>
                                        </impactsElse>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsPerTick>
                    </parameters>
                    <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
                </Item>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <tick>1000</tick>
                    <affectGroup>All</affectGroup>
                    <radius>4.5</radius>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="HealContextActionBuff.(BuffResource).xdb" />
                        </Item>
                    </impactsOut>
                </Item>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>5</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="HealContextActionBuff.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="HealContextActionBuff.(BuffResource).xdb" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>60000</duration>
    <stackLimit>100</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
