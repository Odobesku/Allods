<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>225475</resourceId>
    </Header>
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.05</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectStackTrigger">
            <count>25</count>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>Ship</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <onBehalfOfTarget>true</onBehalfOfTarget>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                            <damage>1</damage>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier>0.125</multiplier>
                                </mulCalcer>
                            </scalerTarget>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="Fireball.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>3000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <stackLimit>25</stackLimit>
    <isHelpful>false</isHelpful>
    <isClientReplicated>false</isClientReplicated>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>