                            </predicate>
                            <clientData href="WrongSex.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </onSlave>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                        <onMaster type="gameMechanics.elements.predicates.PredicateWrapClientData">
                            <predicate type="gameMechanics.elements.predicates.PredicateCharacterSex">
