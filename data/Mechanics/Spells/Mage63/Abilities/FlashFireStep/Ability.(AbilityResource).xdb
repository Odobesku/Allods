<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739922114</resourceId>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>perc</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer href="Calcer.(CalcerFloatResource).xdb" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>MagicScaler</formula>
					</Item>
					<Item type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>0.25</multiplier>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Stalker/Rush.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/Mage63/Abilities/Flash/Buff.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateNot">
											<predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
												<spell href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisable.(SpellSingleTarget).xdb" />
											</predicate>
										</Item>
									</predicates>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
											<projectileData>
												<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
													<destination type="gameMechanics.map.destination.DestinationModified">
														<destination type="gameMechanics.map.destination.SelfPosDestination" />
														<modifiers>
															<Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
														</modifiers>
													</destination>
												</moveType>
												<resource href="Projectile.(ProjectileResource).xdb" />
											</projectileData>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impacts>
					<tick>3000</tick>
					<initialDelay>5000</initialDelay>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.AbilityUnlockerEffect">
			<abilities>
				<Item href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisableAbility.(AbilityResource).xdb" />
			</abilities>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
