<?xml version="1.0" encoding="UTF-8" ?>
<VisualMob>
    <character href="/Creatures/ArchitectBossInvasion/ArchitectBossInvasionBall.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)"/>
    <colorCoefficients>
        <b>1</b>
        <g>1</g>
        <r>1</r>
        <w>0.2</w>
        <use>false</use>
    </colorCoefficients>
    <creatureParameters>
        <disableProceduralAndColorEffects>false</disableProceduralAndColorEffects>
    </creatureParameters>
    <decalScale>1</decalScale>
    <fixedIdleAnimation>invalid</fixedIdleAnimation>
    <hitAnimationCooldown>60000</hitAnimationCooldown>
    <hitCritAnimationCooldown>60000</hitCritAnimationCooldown>
    <pickAabb>
        <center x="0" y="0" z="0"/>
        <extents x="0" y="0" z="0"/>
    </pickAabb>
    <procedureFxScale>1</procedureFxScale>
    <scale>5</scale>
    <timeToCorpseFadingMax>1</timeToCorpseFadingMax>
    <timeToCorpseFadingMin>1</timeToCorpseFadingMin>
    <transparency>1</transparency>
    <variation>
        <hairColor>-1</hairColor>
        <morphPreset/>
        <morphPresetIndex>0</morphPresetIndex>
        <skinColor>-1</skinColor>
    </variation>
    <visualScript type="VisActionList">
        <visActionID></visActionID>
        <elements>
            <Item type="CreatureAnimationAction">
                <visActionID></visActionID>
                <advanced>
                    <autoHasten>
                        <mode>AUTOHASTEN_NONE</mode>
                        <timeToBeLeft>0</timeToBeLeft>
                    </autoHasten>
                    <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                    <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                    <offendType>NO_OFFEND</offendType>
                    <turnToTarget>TURN_DEFAULT</turnToTarget>
                    <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                    <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
                    <denyAutoHasten>false</denyAutoHasten>
                    <disableRandomFirstFrame>true</disableRandomFirstFrame>
                    <eventPlaybackEnd>false</eventPlaybackEnd>
                    <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                    <stopIfMoved>false</stopIfMoved>
                    <stopIfRotated>false</stopIfRotated>
                </advanced>
                <animations>
                    <Item>special</Item>
                </animations>
                <channel>CHANNEL_DEFAULT</channel>
                <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                <mode>DIE</mode>
                <specialController></specialController>
                <use>USE_ANIMATIONS</use>
                <dontFreezePrecast>true</dontFreezePrecast>
            </Item>
            <Item type="CreatureDisableShadowAction">
                <visActionID></visActionID>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </visualScript>
    <skipCharacterVisualScript>false</skipCharacterVisualScript>
    <useIdleSpecial>true</useIdleSpecial>
    <useVisualTweaks>true</useVisualTweaks>
</VisualMob>
