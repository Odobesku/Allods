<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>341607427</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectGroup>Friends</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Creatures/Yeti/Instances/AstralIsle44/Yeti.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                    </impactsIf>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.MobFilter" />
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Creatures/Yeti/Instances/AstralIsle44/Yeti.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="HealYeti.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <spawnResource href="/Maps/AstralIsle44/SpawnTables/AI44_Boss01Pack.(SpawnTable).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>