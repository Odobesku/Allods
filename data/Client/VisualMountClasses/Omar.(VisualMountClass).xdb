<?xml version="1.0" encoding="UTF-8"?>
<VisualMountClass>
    <animationSettings>
        <complexAnimations>
            <Item>
                <animation>whirlwind</animation>
                <playOnMount>idle</playOnMount>
                <playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
                <playOnRiderTop>mountBikeIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>loot</animation>
                <playOnMount>idle</playOnMount>
                <playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
                <playOnRiderTop>mountBikeIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>lootLoop</animation>
                <playOnMount>idle</playOnMount>
                <playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
                <playOnRiderTop>mountBikeIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>sitGroundDown</animation>
                <playOnMount>emoteAFK</playOnMount>
                <playOnRiderBottom>mountBikeEmoteAFK</playOnRiderBottom>
                <playOnRiderTop>mountBikeEmoteAFK</playOnRiderTop>
            </Item>
