<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739922727</resourceId>
    </Header>
    <Name href="R7_RayAttack_2.(BuffResource).Name.txt" />
    <Description href="R7_RayAttack_2.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Ships/ComplexTarget.(UISingleTexture).xdb" />
    <visScript href="R7_Ray_Attack.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>5</radius>
                    <affectGroup>Friends</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="R7_RayAttack.(ClientData).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="R7_CageMob.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                <mobs>
                                                    <Item href="AssassinsBoss_HM.(MobWorld).xdb" />
                                                </mobs>
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>ASTRAL</element>
                                            <damage>200</damage>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impactsElse>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>ASTRAL</element>
                                    <damage>200</damage>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>1000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="R7_RayAttack_2.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="R7_Assassins_RayAttack_vis.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>5000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/RaidInstances/ArchBaseRaid/SiegeBoss/R7_ArchBase_Raid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>