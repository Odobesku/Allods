<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739925374</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<source>Crafted</source>
	<slot var="slot" />
	<itemClass hrefvar="itemClass" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateExternal">
											<predicateResource href="/Mechanics/ServerUnlock/Gearscore/RecCheck71_2.(PredicateResource).xdb" />
										</Item>
										<Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
											<lhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
												<calcer type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
													<currency href="/Mechanics/ServerUnlock/Gearscore/GearFake.(AlternativeCurrency).xdb" />
												</calcer>
											</lhs>
											<rhs type="gameMechanics.elements.calcers.LongData">
												<value>0</value>
											</rhs>
										</Item>
									</predicates>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactClientData">
									<data href="/Mechanics/ServerUnlock/Gearscore/NewRecCD.(ClientData).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
									<currency href="/Mechanics/ServerUnlock/Gearscore/GearFake.(AlternativeCurrency).xdb" />
									<sumCalcer type="gameMechanics.elements.calcers.FloatData">
										<value>1</value>
									</sumCalcer>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateExternal">
											<predicateResource href="/Mechanics/ServerUnlock/Gearscore/RecCheck71_3.(PredicateResource).xdb" />
										</Item>
										<Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
											<lhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
												<calcer type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
													<currency href="/Mechanics/ServerUnlock/Gearscore/GearFake.(AlternativeCurrency).xdb" />
												</calcer>
											</lhs>
											<rhs type="gameMechanics.elements.calcers.LongData">
												<value>1</value>
											</rhs>
										</Item>
									</predicates>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactClientData">
									<data href="/Mechanics/ServerUnlock/Gearscore/NewRecCD.(ClientData).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
									<currency href="/Mechanics/ServerUnlock/Gearscore/GearFake.(AlternativeCurrency).xdb" />
									<sumCalcer type="gameMechanics.elements.calcers.FloatData">
										<value>1</value>
									</sumCalcer>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateExternal">
											<predicateResource href="/Mechanics/ServerUnlock/Gearscore/RecCheck71_4.(PredicateResource).xdb" />
										</Item>
										<Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
											<lhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
												<calcer type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
													<currency href="/Mechanics/ServerUnlock/Gearscore/GearFake.(AlternativeCurrency).xdb" />
												</calcer>
											</lhs>
											<rhs type="gameMechanics.elements.calcers.LongData">
												<value>2</value>
											</rhs>
										</Item>
									</predicates>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactClientData">
									<data href="/Mechanics/ServerUnlock/Gearscore/NewRecCD.(ClientData).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
									<currency href="/Mechanics/ServerUnlock/Gearscore/GearFake.(AlternativeCurrency).xdb" />
									<sumCalcer type="gameMechanics.elements.calcers.FloatData">
										<value>1</value>
									</sumCalcer>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<functionalPart type="gameMechanics.constructor.schemes.item.ItemBonus">
		<powerFactor type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerMul">
			<calcers>
				<Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerBudgetType">
					<type>MainBudget</type>
				</Item>
				<Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
					<value>0.01</value>
				</Item>
			</calcers>
		</powerFactor>
		<staminaFactor type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerMul">
			<calcers>
				<Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
					<value>0.01</value>
				</Item>
				<Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerBudgetType">
					<type>MainBudget</type>
				</Item>
			</calcers>
		</staminaFactor>
		<secondaryMinorFactor type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
			<value>0</value>
		</secondaryMinorFactor>
		<secondaryMajorFactor type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
			<value>0</value>
		</secondaryMajorFactor>
		<specialStatOffenceMod type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerExternal">
			<externalCalcer href="NSSSpecialStats.(ItemCalcerResource).xdb" />
		</specialStatOffenceMod>
		<specialStatDefenceMod type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerExternal">
			<externalCalcer href="NSSSpecialStatsDef.(ItemCalcerResource).xdb" />
		</specialStatDefenceMod>
		<specialStats>
			<Item href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/CritChance.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/NatureDmg.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/PhysicalDmg.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/ElementalDmg.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/HolyDmg.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/AntiHeal.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/DoubleHitChance.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/ColldownDecreaser.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/AntiController.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/HealModifier.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/NatureDef.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/PhysicalDef.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/ElementalDef.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/HolyDef.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/IncomingDmgControlled.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/NotBubble.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/BarrierOnHit.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/Rage.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/Plain.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/Vitality.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/Will.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/Lifesteal.(SpecialStatResource).xdb" />
			<Item href="/Mechanics/SpecialStats/Finisher.(SpecialStatResource).xdb" />
		</specialStats>
		<secondaryStats>
			<Item>Plain</Item>
			<Item>Vitality</Item>
			<Item>Rage</Item>
			<Item>Endurance</Item>
		</secondaryStats>
	</functionalPart>
	<level var="level" />
	<requiredLevel var="requiredLevel" />
	<quality hrefvar="quality" />
	<prices type="gameMechanics.constructor.schemes.item.prices.ItemPricesIf">
		<predicate type="gameMechanics.elements.item.ItemPredicateOr">
			<predicates>
				<Item type="gameMechanics.elements.item.ItemPredicateLevel">
					<range>
						<max>70</max>
					</range>
				</Item>
				<Item type="gameMechanics.elements.item.ItemPredicateAnd">
					<predicates>
						<Item type="gameMechanics.elements.item.ItemPredicateQuality">
							<quality href="/Mechanics/ItemQualities/Common.xdb" />
						</Item>
						<Item type="gameMechanics.elements.item.ItemPredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.item.ItemPredicateGeneralDressSlot">
									<generalizedSlot>HELM</generalizedSlot>
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateGeneralDressSlot">
									<generalizedSlot>ARMOR</generalizedSlot>
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateGeneralDressSlot">
									<generalizedSlot>PANTS</generalizedSlot>
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateGeneralDressSlot">
									<generalizedSlot>BOOTS</generalizedSlot>
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateGeneralDressSlot">
									<generalizedSlot>SHIRT</generalizedSlot>
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateGeneralDressSlot">
									<generalizedSlot>EARRINGS</generalizedSlot>
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateGeneralDressSlot">
									<generalizedSlot>RING</generalizedSlot>
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateGeneralDressSlot">
									<generalizedSlot>CLOAK</generalizedSlot>
								</Item>
							</predicates>
						</Item>
					</predicates>
				</Item>
			</predicates>
		</predicate>
		<priceIf type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
		<priceElse type="gameMechanics.constructor.schemes.item.prices.TradableItem">
			<cost type="gameMechanics.constructor.schemes.item.prices.DressableCost">
				<slot var="slot" />
			</cost>
			<sellMod>0.1</sellMod>
		</priceElse>
	</prices>
	<binding>BindOnPickup</binding>
</gameMechanics.constructor.schemes.item.ItemResource>
