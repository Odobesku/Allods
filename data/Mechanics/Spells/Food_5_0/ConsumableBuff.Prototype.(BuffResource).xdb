<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>219913</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <ImagePic />
            <Stat />
            <Group />
        </Variables>
    </Header>
    <Name hrefvar="Name" />
    <Description href="ConsumableBuff.(BuffResource).Description.txt" />
    <image hrefvar="ImagePic" />
    <effects>
        <Item type="gameMechanics.elements.effects.SummandStat">
            <stat type="gameMechanics.elements.stat.InnateStat">
                <stat var="Stat" />
            </stat>
            <value>1</value>
        </Item>
    </effects>
    <duration>2700000</duration>
    <stackLimit>100</stackLimit>
    <isHelpful>true</isHelpful>
    <groups>
        <Item hrefvar="Group" />
    </groups>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>