<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<FixPointCaster>true</FixPointCaster>
			<LocatorNameOnCaster />
			<FixPointTarget>true</FixPointTarget>
			<LocatorNameOnTargets />
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<PreCastAnimation>ready</PreCastAnimation>
			<HitPostFXOnTargets />
			<FxOnHands />
			<FXOnCaster>/Spells/FX/Mobs/KrakenAdd_Cleave_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<CastAnimation>battleRoar</CastAnimation>
			<FXOnTargets />
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx hrefvar="FXOnCaster" />
								<fixPoint var="FixPointCaster" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
