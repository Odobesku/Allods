                    </durationScaler>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                    <value>1</value>
                </Item>
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
