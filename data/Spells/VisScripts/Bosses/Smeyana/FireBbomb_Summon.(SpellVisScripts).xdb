<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>ready</PreCastAnimation>
			<FxOnHands>/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<FXOnCaster />
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item skiped="" />
					<Item skiped="" />
					<Item>
						<effectFx href="/Spells/FX/Mobs/ReadySpell_FireBbomb.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2.5</scale>
						<locator>Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<actionBarComplite type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>250</delay>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFireWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special02</locatorName>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarComplite>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item skiped="" />
							<Item>
								<effectFx href="/Spells/FX/Mobs/CastSpell_FireBomb.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
