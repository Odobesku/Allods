            </Item>
        </actions>
    </functionalPart>
    <stackLimit>50</stackLimit>
    <quality href="/Mechanics/ItemQualities/Goods.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="ArenaRatePoints.(ItemResource).Name.txt" />
    <description href="ArenaRatePoints.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/Consumables/Special.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>