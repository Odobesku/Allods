    <altitude>0.01</altitude>
    <lifeLengthCap>8000</lifeLengthCap>
    <impactsOnDeath>
        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                <value>0.1</value>
            </chanceCalcer>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <object href="SB1_YetiBoss_SummonAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </Item>
            </impacts>
        </Item>
    </impactsOnDeath>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
                    <delay>7000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                            <radius>8</radius>
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>COLD</element>
                                    <damage>60</damage>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>