<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739948238</resourceId>
    </Header>
    <Name href="ReferlBoxUniversal.(SpellSingleTarget).Name.txt" />
    <Description href="ReferlBoxUniversal.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Prototypes/UseItem.(SpellVisScripts).xdb" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateGreaterLong">
                        <lhs type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                        <rhs type="gameMechanics.elements.calcers.CalcerLevel" />
                    </predicate>
                </predicate>
                <clientData href="BonusBoxUniversal_LevelData.(ClientData).xdb" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateGreater">
                        <lhs type="gameMechanics.elements.calcers.LongToFloatCalcer">
                            <calcer type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                        </lhs>
                        <rhs type="gameMechanics.elements.calcers.LongToFloatCalcer">
                            <calcer type="gameMechanics.elements.calcers.CalcerLongSum">
                                <calcers>
                                    <Item type="gameMechanics.elements.calcers.CalcerLevelCap" />
                                    <Item type="gameMechanics.elements.calcers.LongData">
                                        <value>-1</value>
                                    </Item>
                                </calcers>
                            </calcer>
                        </rhs>
                    </Item>
                </predicates>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                <item href="ReferlBoxUniversal.(ItemResource).xdb" />
                            </item>
                        </item>
                        <itemLevel type="gameMechanics.elements.calcers.CalcerLongSum">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                                <Item type="gameMechanics.elements.calcers.LongData">
                                    <value>10</value>
                                </Item>
                            </calcers>
                        </itemLevel>
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                <impactsResource href="ReferalReward.(ImpactListResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                        <minLevel type="gameMechanics.formulas.MaxLevelConstant" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                                <key href="/System/ContentKeys/ItemmallService.(ContentKey).xdb" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                        <item href="/ItemMall/Potions/Defence/IMStaminaElixir.xdb" />
                                    </item>
                                </item>
                                <count>3</count>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                        <item href="/ItemMall/Potions/Physical/IMStrengthElixir.xdb" />
                                    </item>
                                </item>
                                <count>3</count>
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                        <item href="/ItemMall/Potions/Defence/IMStaminaPotion.xdb" />
                                    </item>
                                </item>
                                <count>3</count>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                        <item href="/ItemMall/Potions/Magical/IMIntellectPotion.xdb" />
                                    </item>
                                </item>
                                <count>3</count>
                            </Item>
                        </impactsElse>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="ReferalEquipReward.(ImpactListResource).xdb" />
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>