<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.rules.RuleResource>
    <Header>
        <resourceId>739883811</resourceId>
    </Header>
    <name href="TeamFootballRule_name.txt" />
    <description href="TeamFootballRule_desc.txt" />
    <types>
        <Item>RULE_TYPE_SINGLE</Item>
    </types>
    <predicates>
        <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/TeamFootball.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
        </Item>
    </predicates>
    <startImpacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                    <key href="/System/ContentKeys/P2P_shard/P2P_shard_Server.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
                </Item>
            </predicates>
            <elseImpacts>
                <Item type="itemService.elements.ladderEvents.ImpactSnapshotRating">
                    <event href="/Mechanics/Rules/Seasons/Football.(RuleResource).xdb" />
                    <rewards href="Rewards.(LadderRewardResource).xdb#xpointer(/itemService.elements.ladderEvents.LadderRewardResource)" />
                </Item>
            </elseImpacts>
            <impacts>
                <Item type="itemService.elements.ladderEvents.ImpactSnapshotRating">
                    <event href="/Mechanics/Rules/Seasons/Football.(RuleResource).xdb" />
                    <rewards href="Rewards_P2P.(LadderRewardResource).xdb#xpointer(/itemService.elements.ladderEvents.LadderRewardResource)" />
                </Item>
            </impacts>
        </Item>
    </startImpacts>
    <timeTable href="TeamFootballSnapshot.(TimePeriodTable).xdb#xpointer(/timeperiod.TimePeriodTable)" />
    <canBeScheduled>true</canBeScheduled>
</gameMechanics.world.rules.RuleResource>