                            <targetPredicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </targetPredicates>
                        </Item>
                    </conditions>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsConditional">
                            <conditions>
                                <Item type="gameMechanics.elements.conditions.PredicatesCondition">
                                    <targetPredicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                            <quest href="/World/Quests/ArchipelagoGipatsShard/Quest3_2/Quest3_2.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                        </Item>
                                    </targetPredicates>
                                </Item>
                            </conditions>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/World/Quests/ArchipelagoGipatsShard/Quest3_2/PigKickZone.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/World/Quests/ArchipelagoGipatsShard/Quest3_2/PigKickZone.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
