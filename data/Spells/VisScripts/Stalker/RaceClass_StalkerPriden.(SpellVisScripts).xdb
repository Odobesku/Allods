<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/OmniNoWand.(SpellVisScripts).xdb" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationOmni.(CreatureVisActionResource).xdb</PreCastAnimation>
			<FXOnCaster />
			<PreCastFX>/Spells/VisScripts/Prototypes/PreCastFXPoison.(CreatureVisActionResource).xdb</PreCastFX>
			<FXWand />
			<LocatorNameOnTargets />
			<FXOnTargets />
			<CastAnimation>spellCastOmni</CastAnimation>
			<FixPointTarget>true</FixPointTarget>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorNameOnCaster />
			<FixPointCaster>true</FixPointCaster>
			<FXPocket />
			<WholeCastFX />
			<HitPostFXOnTargets />
