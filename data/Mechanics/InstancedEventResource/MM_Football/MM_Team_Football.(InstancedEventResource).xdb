<?xml version="1.0" encoding="UTF-8" ?>
<avatarPopulation.service.impl.matchMakingImpl.eventType.premade.MarkedPremadeInstancedEvent>
    <Header>
        <resourceId>356703235</resourceId>
    </Header>
    <name href="TeamFootballName.txt" />
    <description href="TeamFootballDesc.txt" />
    <minAvatarLevel type="gameMechanics.formulas.IntConstantValue">
        <value>23</value>
    </minAvatarLevel>
    <levelsPartition>
        <entries>
            <Item>
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>23</value>
                </minLevel>
            </Item>
        </entries>
    </levelsPartition>
    <minAvatarsCount>3</minAvatarsCount>
    <capacity>4</capacity>
    <keepGroupAfterFinish>true</keepGroupAfterFinish>
    <immediatelyStartFactor>0.1</immediatelyStartFactor>
    <maps>
        <Item href="TeamBattleEventMapMechanics.xdb#xpointer(/gameMechanics.battleground.BattleEventMapMechanics)" />
    </maps>
    <startTime href="MM_Team_Football.(TimeTable).xdb#xpointer(/timetables.TimeTable)" />
    <activeEventJoinPeriod>-1</activeEventJoinPeriod>
    <maxVisitsPerDay>1</maxVisitsPerDay>
    <maxVisitsPerWeek>4</maxVisitsPerWeek>
    <ladderRatingRewards>
        <Item>
            <event href="/Mechanics/Rules/Seasons/Football.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
            <count type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerMul">
                <calcers>
                    <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                        <value>180</value>
                    </Item>
                    <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerDiv">
                        <dividend type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.AchievementCalcer">
                            <achievementResource href="MM_Football.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
                        </dividend>
                        <divisor type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerSum">
                            <calcers>
                                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.WinnerAchievementCalcer">
                                    <achievementResource href="MM_Football.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
                                </Item>
                                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.LoserAchievementCalcer">
                                    <achievementResource href="MM_Football.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
                                </Item>
                            </calcers>
                        </divisor>
                    </Item>
                </calcers>
            </count>
            <eventPredicates>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateHasWinner" />
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateGreater">
                    <lhs type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.LoserAchievementCalcer">
                        <achievementResource href="MM_Football.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
                    </lhs>
                    <rhs type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                        <value>0</value>
                    </rhs>
                </Item>
            </eventPredicates>
            <scorePolicy>CumulativeScore</scorePolicy>
        </Item>
        <Item>
            <event href="/Mechanics/Rules/Seasons/Football.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
            <count type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                <value>18</value>
            </count>
            <eventPredicates>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateAchievementInRange">
                    <achievementResource href="MM_Football.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
                    <minCount>0</minCount>
                    <maxCount>0</maxCount>
                </Item>
            </eventPredicates>
            <scorePolicy>CumulativeScore</scorePolicy>
        </Item>
        <Item>
            <event href="/Mechanics/Rules/Seasons/Football.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
            <count type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                <value>45</value>
            </count>
            <eventPredicates>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateNot">
                    <predicate type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateEventWinner" />
                </Item>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateNot">
                    <predicate type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateHasWinner" />
                </Item>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateNot">
                    <predicate type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateAchievementInRange">
                        <achievementResource href="MM_Football.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
                        <minCount>0</minCount>
                        <maxCount>0</maxCount>
                    </predicate>
                </Item>
            </eventPredicates>
            <scorePolicy>CumulativeScore</scorePolicy>
        </Item>
        <Item>
            <event href="/Mechanics/Rules/Seasons/Football.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
            <count type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                <value>162</value>
            </count>
            <eventPredicates>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateHasWinner" />
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateGreater">
                    <lhs type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                        <value>1</value>
                    </lhs>
                    <rhs type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.LoserAchievementCalcer">
                        <achievementResource href="MM_Football.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
                    </rhs>
                </Item>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateEventWinner" />
            </eventPredicates>
            <scorePolicy>CumulativeScore</scorePolicy>
        </Item>
    </ladderRatingRewards>
    <joinConditions>
        <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
            <rule href="/Mechanics/Rules/FootballRules/TeamFootballDailyRule.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateInRaid" />
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateGroupSizeGE">
            <size>4</size>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateGroupSizeGE">
                <size>5</size>
            </predicate>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/Empire.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/League.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                </Item>
            </predicates>
        </Item>
    </joinConditions>
    <leaderOnly>true</leaderOnly>
    <inviteTimeout>
        <second>30</second>
    </inviteTimeout>
    <acceptStage>Queue</acceptStage>
</avatarPopulation.service.impl.matchMakingImpl.eventType.premade.MarkedPremadeInstancedEvent>