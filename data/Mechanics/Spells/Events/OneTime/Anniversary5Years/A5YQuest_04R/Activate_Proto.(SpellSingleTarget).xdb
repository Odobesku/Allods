                        <data href="ElemActive.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceItem">
                                <item hrefvar="itemForSummon" />
                            </Item>
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="ElemGivePlane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="ElemGivePlane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                <predicates>
                                                    <Item type="gameMechanics.world.pet.PredicateHasPet" />
                                                </predicates>
                                                <impactsIf>
                                                    <Item type="gameMechanics.elements.impacts.ImpactsToPet">
