<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739947793</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="ChordCritChance.(AbilityResource).Name.txt" />
    <description href="ChordCritChance.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>dmg</name>
            <value var="dmg" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/Execute.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="/Mechanics/Spells/Bard63/Spells/HardRock/EtudeFinishOnTarget.(MarkResource).xdb" />
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="CritChanceMarkOnTarget.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.SpellsModifier">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                            <group href="/Mechanics/Spells/Groups/BardChord.(ActionGroup).xdb" />
                        </Item>
                    </predicates>
                    <modifiers>
                        <Item type="gameMechanics.elements.spell.SpellEnvelopeTargetModifier">
                            <effects>
                                <Item type="gameMechanics.elements.effects.EffectsIf">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                            <buff href="CritChanceMarkOnTarget.(BuffResource).xdb" />
                                            <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                        </Item>
                                    </predicates>
                                    <effectsIf>
                                        <Item type="gameMechanics.elements.effects.IncomingCritProbabilitySummand">
                                            <summand type="gameMechanics.elements.calcers.FloatData">
                                                <value var="value" />
                                            </summand>
                                            <onlyFromCaster>true</onlyFromCaster>
                                        </Item>
                                    </effectsIf>
                                </Item>
                            </effects>
                            <onBehalfOfHolder>true</onBehalfOfHolder>
                        </Item>
                    </modifiers>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                    <spells>
                        <Item href="/Mechanics/Spells/Bard63/Spells/DissonanceUpgrade/DissonanceUpgrade01.(SpellSingleTarget).xdb" />
                        <Item href="/Mechanics/Spells/Bard63/Spells/Dissonance/Dissonance01.(SpellSingleTarget).xdb" />
                    </spells>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                <coeff var="dmg" />
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
    </effects>
    <ranks>
        <Item href="ChordCritChance01.(AbilityResource).xdb" />
        <Item href="ChordCritChance02.(AbilityResource).xdb" />
        <Item href="ChordCritChance03.(AbilityResource).xdb" />
        <!-- <Item href="ChordCritChance04.(AbilityResource).xdb" /> -->
        <!-- <Item href="ChordCritChance05.(AbilityResource).xdb" /> -->
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>