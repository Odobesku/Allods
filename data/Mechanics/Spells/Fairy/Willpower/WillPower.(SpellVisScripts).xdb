<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart />
    <launch type="VisActionList">
        <play>InSequence</play>
        <elements>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <playWhile type="PredicateVeteranRankAction">
                    <checkCaster>false</checkCaster>
                    <checkIsNotSet>false</checkIsNotSet>
                    <ranksList>
                        <Item href="/Mechanics/Unlocks/VeteranRewards/Ranks/Master.xdb#xpointer(/gameMechanics.world.avatar.veteran.VeteranRank)" />
                    </ranksList>
                </playWhile>
                <preconditional>true</preconditional>
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/Geleral_Willpower_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <effectAlias href="" />
                                <offendTime />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
            <Item type="VisActionList">
                <playWhile type="PredicateVeteranRankAction">
                    <checkCaster>false</checkCaster>
                    <checkIsNotSet>true</checkIsNotSet>
                    <ranksList>
                        <Item href="/Mechanics/Unlocks/VeteranRewards/Ranks/Master.xdb#xpointer(/gameMechanics.world.avatar.veteran.VeteranRank)" />
                    </ranksList>
                </playWhile>
                <preconditional>true</preconditional>
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/FairyWillpower.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <effectAlias href="" />
                                <offendTime />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>