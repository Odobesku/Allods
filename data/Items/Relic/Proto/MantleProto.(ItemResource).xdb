<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739858612</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<actionGroupsBonuses>
		<Item>
			<actionGroup href="/Mechanics/Spells/Groups/DragonRelic5.(ActionGroup).xdb" />
			<statBonuses>
				<Item>
					<stat var="stat" />
					<value type="gameMechanics.elements.calcers.CalcerMul">
						<calcers>
							<Item type="gameMechanics.elements.calcers.FloatData">
								<value var="valueStat" />
							</Item>
							<Item type="constructor.elements.CalcerFloatExternal">
								<externalCalcer hrefvar="dampingCalcer" />
							</Item>
						</calcers>
					</value>
				</Item>
			</statBonuses>
		</Item>
	</actionGroupsBonuses>
	<image href="/Interface/Icons/Equipment/Staff/StaffBone.(UISingleTexture).xdb" />
	<source>FixedDrop</source>
	<slot>MANTLE</slot>
	<ritual>true</ritual>
	<itemClass href="/Mechanics/ItemClasses/DragonRelic.xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfCaster">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateActiveItem">
					<source>Dressable</source>
					<predicates>
						<Item type="gameMechanics.elements.item.ItemPredicateNot">
							<predicate type="gameMechanics.constructor.schemes.item.ItemPredicateCursed" />
						</Item>
					</predicates>
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.SpellsModifier">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
							<group href="/Mechanics/Spells/Groups/DragonRelic5.(ActionGroup).xdb" />
						</Item>
					</predicates>
					<modifiers>
						<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
							<effects>
								<Item type="gameMechanics.elements.effects.SummandStat">
									<stat type="gameMechanics.elements.stat.InnateStat">
										<stat var="stat" />
									</stat>
									<value var="valueStat" />
									<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
										<scalers>
											<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="constructor.elements.CalcerFloatExternal">
													<externalCalcer hrefvar="dampingCalcer" />
												</mulCalcer>
											</Item>
											<Item type="gameMechanics.elements.scalers.LinearScaler">
												<multiplier>10</multiplier>
											</Item>
										</scalers>
									</scaler>
								</Item>
							</effects>
							<onBehalfOfHolder>false</onBehalfOfHolder>
						</Item>
					</modifiers>
				</Item>
				<Item type="gameMechanics.elements.effects.EffectsIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
							<hideText>true</hideText>
							<characterClass href="/Mechanics/Classes/Druid.xdb" />
						</Item>
					</predicates>
					<effectsIf>
						<Item type="gameMechanics.elements.effects.EffectsToPet">
							<effects>
								<Item type="gameMechanics.elements.effects.SummandStat">
									<stat type="gameMechanics.elements.stat.InnateStat">
										<stat var="stat" />
									</stat>
									<value var="valueStat" />
									<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
										<scalers>
											<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="constructor.elements.CalcerFloatExternal">
													<externalCalcer hrefvar="dampingCalcer" />
												</mulCalcer>
											</Item>
											<Item type="gameMechanics.elements.scalers.LinearScaler">
												<multiplier>10</multiplier>
											</Item>
										</scalers>
									</scaler>
								</Item>
							</effects>
						</Item>
					</effectsIf>
				</Item>
			</effectsIf>
		</Item>
	</effects>
	<functionalPart type="gameMechanics.constructor.schemes.item.ItemBonus">
		<secondaryStats>
			<Item>Vitality</Item>
			<Item>Plain</Item>
		</secondaryStats>
	</functionalPart>
	<level var="level" />
	<requiredLevel var="level" />
	<quality href="/Mechanics/ItemQualities/Relic.xdb" />
	<prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
		<cost type="gameMechanics.constructor.schemes.item.prices.DressableCost">
			<slot>MANTLE</slot>
		</cost>
	</prices>
	<binding>BindOnPickup</binding>
	<name href="BasePrototype.(ItemResource).Name.txt" />
	<description href="BasePrototype.(ItemResource).Description.txt" />
	<category href="/Mechanics/ItemCategories/DragonRelic/Mantle.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>
