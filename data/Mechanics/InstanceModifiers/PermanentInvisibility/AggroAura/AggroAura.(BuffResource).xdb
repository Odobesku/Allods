<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>299079681</resourceId>
	</Header>
	<visScript href="/Mechanics/InstanceModifiers/PermanentInvisibility/Sound.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>Enemies</affectGroup>
			<radius>17</radius>
			<delayIn>1500</delayIn>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsEnemy">
							<factions>
								<Item href="/World/Factions/League.xdb" />
								<Item href="/World/Factions/Empire.xdb" />
							</factions>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
							<value>10</value>
						</Item>
					</impactsIf>
				</Item>
			</impactsIn>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
							<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
								<value>0.01</value>
							</chanceCalcer>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
											<radius>40</radius>
											<affectGroup>Enemies</affectGroup>
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
													<value>10</value>
												</Item>
											</impacts>
											<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
												<predicates>
													<Item type="gameMechanics.elements.predicates.PredicateIsEnemy">
														<factions>
															<Item href="/World/Factions/League.xdb" />
															<Item href="/World/Factions/Empire.xdb" />
														</factions>
													</Item>
													<Item type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
														<quality href="/Mechanics/MobQualities/Boss.xdb" />
													</Item>
												</predicates>
											</filter>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>10000</tick>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
