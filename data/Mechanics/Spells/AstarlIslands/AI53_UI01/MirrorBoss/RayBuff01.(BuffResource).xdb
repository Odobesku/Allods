	</Header>
	<Name href="RayBuff01.(BuffResource).Name.txt" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<nameTemplate href="RayBuff01.(BuffResource).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
			<impactsIn type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine$ImpactsPack">
				<impactsFromCaster>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.resources.ResourceBuff">
