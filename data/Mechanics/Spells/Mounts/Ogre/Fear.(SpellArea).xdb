<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>204735</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
    </groups>
    <element>ASTRAL</element>
    <Name href="Fear.(SpellArea).Name.txt" />
    <Description href="Fear.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1500</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>0.1</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                            <group href="/Mechanics/Mounts/Groups/Ogres12.(MountGroupResource).xdb" />
                        </mulCalcer>
                        <sum>1</sum>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>FormulaSeconds</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Mounts/SpellsMounts/FireBeam.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Creatures/OgreShot.(SpellVisScripts).xdb" />
    <sysName>1</sysName>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>300000</duration>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>-0.04</mul>
                <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                    <group href="/Mechanics/Mounts/Groups/Ogres12.(MountGroupResource).xdb" />
                </mulCalcer>
                <sum>1</sum>
            </scaler>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMountFromGroupFeeded">
                <group href="/Mechanics/Mounts/Groups/Ogres12.(MountGroupResource).xdb" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/Mounts/Prototypes/AntiNormalMountCC.(BuffResource).xdb" />
                </predicate>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="FearOgre.(BuffResource).xdb" />
                <impactsOnAttach>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Mounts/Prototypes/AntiNormalMountCC.(BuffResource).xdb" />
                    </Item>
                </impactsOnAttach>
                <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mul>0.1</mul>
                    <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                        <group href="/Mechanics/Mounts/Groups/Ogres12.(MountGroupResource).xdb" />
                    </mulCalcer>
                    <sum>1</sum>
                </durationScaler>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>20</speed>
    <radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>