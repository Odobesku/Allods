<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739833595</resourceId>
    </Header>
    <name href="KtulhuAstral.(AbilityResource).Name.txt" />
    <nameTemplate href="KtulhuAstral.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="KtulhuBoss.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                    <mob>
                        <scriptID>KtulhuBrain</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </mob>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>Astral</scriptID>
                                    <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                </locator>
                            </destination>
                        </moveType>
                        <resource href="Astral.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <disableWhileDead>true</disableWhileDead>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.ability.AbilityResource>