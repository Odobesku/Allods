<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739849259</resourceId>
	</Header>
	<Name href="PetDance.(BuffResource).Name.txt" />
	<visScript href="PetDance.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
					<predicates>
						<Item type="gameMechanics.world.pet.PredicateHasPet" />
					</predicates>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsToPet">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="PetDance2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
					<predicates>
						<Item type="gameMechanics.world.pet.PredicateHasPet" />
					</predicates>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsToPet">
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="PetDance2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<duration>60000</duration>
	<isHelpful>false</isHelpful>
	<ignoreLevelDelta>true</ignoreLevelDelta>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Events/EventBuffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
	<canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
