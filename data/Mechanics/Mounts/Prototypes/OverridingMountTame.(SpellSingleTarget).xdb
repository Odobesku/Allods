<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739916648</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <Description_Text />
        </Variables>
    </Header>
    <Name href="GainingMount.txt" />
    <Description hrefvar="Description_Text" />
    <image hrefvar="Icon_Image" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>2500</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasFreeStableSlots">
                                <forMount hrefvar="Mount_Resourse" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                <group hrefvar="Mount_Group" />
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                            <group hrefvar="Mount_Group" />
                                        </predicate>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasFreeStableSlots">
                                        <forMount hrefvar="Mount_Resourse" />
                                    </Item>
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                        <group hrefvar="Mount_Group" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                                            <unlock hrefvar="Mount_Unlock" />
                                        </predicate>
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateGreater">
                        <lhs type="gameMechanics.elements.calcers.FloatData">
                            <value var="value" />
                        </lhs>
                        <rhs type="gameMechanics.elements.calcers.FloatData">
                            <value>0</value>
                        </rhs>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                        <group hrefvar="Mount_Group" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                        <data href="OverrideMount.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactTameMount">
                        <mount hrefvar="Mount_Resourse" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactConsumeResources">
                        <resources>
                            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
                        </resources>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                <group hrefvar="Mount_Group" />
                            </Item>
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                                <unlock hrefvar="Mount_Unlock" />
                            </Item>
                        </impacts>
                        <elseImpacts>
                            <Item type="gameMechanics.elements.impacts.ImpactTameMount">
                                <mount hrefvar="Mount_Resourse" />
                            </Item>
                        </elseImpacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactConsumeResources">
                        <resources>
                            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
                        </resources>
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>