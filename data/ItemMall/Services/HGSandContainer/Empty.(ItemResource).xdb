<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739862106</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/AverageSlotMaker1.(UISingleTexture).xdb" />
    <itemMallDescription href="Empty.(ItemResource).ItemMallDescription.txt" />
    <source>FixedDrop</source>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <usages>
            <Item>
                <predicate type="itemService.mail.predicates.PredicateAltCurrencyGE">
                    <currency href="/Mechanics/RevardsExchange/ExchangeAltcurr7s1.(AlternativeCurrency).xdb" />
                    <value>500</value>
                </predicate>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="RewardExchange7.(ItemResource).xdb" />
                        </item>
                    </Item>
                    <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                        <currency href="/Mechanics/RevardsExchange/ExchangeAltcurr7s1.(AlternativeCurrency).xdb" />
                        <multiplier>-500</multiplier>
                    </Item>
                </actions>
                <consumeItems>1</consumeItems>
            </Item>
            <Item>
                <actions>
                    <Item type="itemService.elements.components.ItemTakeActionImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                <data href="CD.(ClientData).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </actions>
                <consumeItems>0</consumeItems>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>10</value>
                </minLevel>
            </Item>
        </predicates>
    </functionalPart>
    <requiredLevel>10</requiredLevel>
    <stackLimit>20</stackLimit>
    <quality href="/Mechanics/ItemQualities/Uncommon.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>1</money>
        </cost>
    </prices>
    <binding>BindOnUse</binding>
    <lifeLengthCap>2592000000</lifeLengthCap>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="Empty.(ItemResource).Name.txt" />
    <description href="Empty.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/ItemMall.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>