<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>readySpell</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/GorinichSmall_Corrupted_SpecialCast_FX_Decal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>1.1</scale>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/GorinichSmall_Corrupted_ReadySpell_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <effectAlias href="" />
                        <scale>1.5</scale>
                        <offendTime />
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/GorinichSmall_Corrupted_ReadySpell_FX_Flame.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <effectAlias href="" />
                        <scale>1.5</scale>
                        <offendTime />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/GorinichSmall_Corrupted_SpecialCast_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>1.5</scale>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/GorinichSmall_Corrupted_SpecialCast_FX_Flame.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <effectAlias href="" />
                        <scale>1.5</scale>
                        <offendTime />
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialCast</Item>
                </animations>
            </Item>
            <Item type="Sound3DAction">
                <sound>
                    <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
                    <name>spells/FX/Mobs/HG7/HG7_Dragon_Conereadyspell</name>
                </sound>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>