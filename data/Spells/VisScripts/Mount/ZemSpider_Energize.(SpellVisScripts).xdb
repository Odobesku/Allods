<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureSetFlagAction">
				<flagName>Flag_MountNeeded</flagName>
				<timeOut>0.5</timeOut>
			</Item>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Flag_Emote</flagName>
				</playWhile>
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="PredicateVisualMountAction">
							<mountsList>
								<Item href="/Client/VisualMounts/Spider/Spider.(VisualMount).xdb#xpointer(/VisualMount)" />
							</mountsList>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Mobs/MountSpider_Energize.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<effectAlias href="" />
										<locator>FROM_LOCATOR_NAME</locator>
										<member>Mount</member>
										<locatorName>Hips</locatorName>
										<offendTime />
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="PredicateVisualMountAction">
							<mountsList>
								<Item href="/Client/VisualMounts/Spider/SpiderHeroesArena.xdb#xpointer(/VisualMount)" />
							</mountsList>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Mobs/MountSpider_HA_Energize.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<effectAlias href="" />
										<locator>FROM_LOCATOR_NAME</locator>
										<member>Mount</member>
										<locatorName>Hips</locatorName>
										<offendTime />
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="PredicateVisualMountAction">
							<mountsList>
								<Item href="/Client/VisualMounts/Spider/ZemSpiderTepPyramid.(VisualMount).xdb#xpointer(/VisualMount)" />
							</mountsList>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Mobs/MountSpider_PT_Energize.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<effectAlias href="" />
										<locator>FROM_LOCATOR_NAME</locator>
										<member>Mount</member>
										<locatorName>Head</locatorName>
										<offendTime />
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="PredicateVisualMountAction">
							<mountsList>
								<Item href="/Client/VisualMounts/Spider/SpiderUmoir.xdb#xpointer(/VisualMount)" />
							</mountsList>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Mobs/MountSpiderUmoir_Energize.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<effectAlias href="" />
										<locator>FROM_LOCATOR_NAME</locator>
										<member>Mount</member>
										<locatorName>Head</locatorName>
										<offendTime />
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
