<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>371500045</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                        <spell hrefvar="spell" />
                        <anyRank>false</anyRank>
                    </predicate>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Bard/Abilities/Music/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellActivate">
                            <spell hrefvar="spell" />
                            <effects>
                                <Item type="gameMechanics.elements.effects.WhileAlive">
                                    <effects>
                                        <Item type="gameMechanics.elements.effects.Switch">
                                            <impactsOn>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impactsOn>
                                            <impactsOff>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impactsOff>
                                        </Item>
                                    </effects>
                                </Item>
                                <Item type="gameMechanics.elements.effects.Switch">
                                    <impactsOn>
                                        <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                            <mark href="/Mechanics/Spells/Marks/BardSongStart.xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
                                        </Item>
                                    </impactsOn>
                                    <impactsOff>
                                        <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                            <mark href="/Mechanics/Spells/Marks/BardSongEnd.xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
                                        </Item>
                                    </impactsOff>
                                </Item>
                            </effects>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="SongEnforcer.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsElse>
