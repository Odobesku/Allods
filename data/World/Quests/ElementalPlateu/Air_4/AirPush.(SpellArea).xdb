<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739866221</resourceId>
    </Header>
    <visualScripts href="AirPush.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <prepareDuration>6000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Creatures/AirElemental/ElementalPlateu/AirBoss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </mobs>
            </Item>
        </casterConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                <time>1000</time>
                <impactsOnLand>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mul>0.5</mul>
                        </durationScaler>
                    </Item>
                </impactsOnLand>
                <distance>20</distance>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>40</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>