    <image href="/Interface/Icons/Special/Emotions/Applaud.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectStackChangeTrigger">
            <impactsOnIncrease>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                    <lhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                        <calcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                            <buff href="WinStreak.(BuffResource).xdb" />
                                        </calcer>
                                    </lhs>
                                    <rhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                        <calcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                            <buff href="Combination/Difficulty.(BuffResource).xdb" />
                                        </calcer>
                                    </rhs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="SuccessfulHacksCount.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnIncrease>
        </Item>
    </effects>
    <stackLimit>4</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
