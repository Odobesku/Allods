<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739923572</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Spell0.(SpellSingleTarget).Name.txt" />
    <Description href="HoT0.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidNaturalRegeneration.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.ImpactsOverTime">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>20</radius>
                                <affectGroup>Group</affectGroup>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                        <mark href="/Mechanics/Spells/Druid70/Abilities/NatureHelpUpHeal/AddTargets.(MarkResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactsUnderEnvelope">
                                                <spell href="Spell01.(SpellSingleTarget).xdb" />
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ImpactHeal">
                                                        <heal>1</heal>
                                                        <scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                <externalCalcer hrefvar="externalCalcer" />
                                                            </mulCalcer>
                                                            <additionalMultiplier>
                                                                <scaler type="gameMechanics.elements.scalers.HealScaler" />
                                                            </additionalMultiplier>
                                                        </scalerCaster>
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="Checker.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.world.creature.AliveFilter" />
                                <targetsLimit>1</targetsLimit>
                                <sorting type="gameMechanics.elements.targetSelector.sorts.SortByHealthInjury" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <tick>500</tick>
                <initialDelay>500</initialDelay>
            </effect>
            <ticksCount>8</ticksCount>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="HoT01.(BuffResource).xdb" />
        <Item href="HoT02.(BuffResource).xdb" />
        <Item href="HoT03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>