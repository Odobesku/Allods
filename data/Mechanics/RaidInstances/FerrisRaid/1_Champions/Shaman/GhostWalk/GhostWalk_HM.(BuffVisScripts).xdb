<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Mobs/Champions_GhostWalk_HMIn.(VisObjectTemplate).xdb" />
				<lifeTime>2</lifeTime>
			</Item>
			<Item type="VisActionList">
				<playWhile />
				<elements>
					<Item type="VisActionDelay">
						<time>200</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile />
						<elements>
							<Item type="VisActionChangeVisObject">
								<newVisMob href="/Creatures/ToothedTiger/ToothedTiger.(VisualMob).xdb" />
							</Item>
							<Item type="CreatureSetTransparencyAction">
								<transparency>0.5</transparency>
							</Item>
							<Item type="CreatureScaleAction">
								<scale>1.5</scale>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>hitCritical</Item>
				</animations>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Mobs/Champions_GhostWalk_HMOut.(VisObjectTemplate).xdb" />
				<lifeTime>2</lifeTime>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>idle01</Item>
				</animations>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
