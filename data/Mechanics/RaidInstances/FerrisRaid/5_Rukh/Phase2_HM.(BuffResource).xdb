<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739902555</resourceId>
    </Header>
    <image href="/Interface/Ingame/Lottery/Textures/Numerals/Num2.(UISingleTexture).xdb" />
    <visScript href="ElementalDefenceHM.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.NotStackableEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
                <Item type="gameMechanics.elements.effects.LifeGuard">
                    <level>1</level>
                </Item>
                <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
                <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
                    <predicates>
                        <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
                    </predicates>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectDisableAct">
                    <actions>
                        <Item>Move</Item>
                        <Item>Rotate</Item>
                    </actions>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>200</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                            <spawnResource href="Tornados1.(SpawnTable).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                            <zone href="HurricaneCenter.(ScriptZone).xdb" />
                            <disable>false</disable>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>5_RukhLoc</scriptID>
                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                </locator>
                            </destination>
                            <finishImpacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="TornadoBuff.(BuffResource).xdb" />
                                </Item>
                            </finishImpacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="HMCopies.(SpawnTable).xdb" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                                    <value>1</value>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Adds/DoNotCastDoNotMove.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>2</multiplier>
                                    </durationScaler>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                    <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                                    <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Adds/DoNotCastDoNotMove.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>2</multiplier>
                            </durationScaler>
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                    <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.AttachAbility">
                                            <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impactsOff>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Phase2HMPlane.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/RaidInstances/Phase1.(ActionGroup).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>