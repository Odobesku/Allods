    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>0</prepareDuration>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <modifiers>
        <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
            <effects>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>1</coeff>
                        <calcer type="gameMechanics.elements.calcers.CalcerIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateVariableGreatThan">
                                <resource href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
                            </predicate>
                            <calcerIf type="gameMechanics.elements.calcers.FloatData">
                                <value>1</value>
                            </calcerIf>
                            <calcerElse type="gameMechanics.elements.calcers.FloatData">
                                <value>0</value>
                            </calcerElse>
                        </calcer>
                    </scaler>
                </Item>
            </effects>
            <onBehalfOfHolder>true</onBehalfOfHolder>
        </Item>
    </modifiers>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <casterResources />
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                <mark href="ArdentFan.(MarkResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                <variable href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
                <summand>-1</summand>
                <scaler type="gameMechanics.elements.scalers.ScalerIf">
                    <condition type="gameMechanics.elements.predicates.PredicateHasAbility">
                        <ability href="/Mechanics/Spells/Priest63/Abilities/FreeZealFromRetribution/Ability01.(AbilityResource).xdb" />
                    </condition>
                    <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>2</multiplier>
                    </scalerIf>
                    <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>1</multiplier>
                    </scalerElse>
                </scaler>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>HOLY</element>
                        <damage>1</damage>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer hrefvar="externalCalcer" />
                                    </mulCalcer>
                                </Item>
                                <Item type="gameMechanics.elements.scalers.MagicScaler" />
                            </scalers>
                        </scaler>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>25</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>