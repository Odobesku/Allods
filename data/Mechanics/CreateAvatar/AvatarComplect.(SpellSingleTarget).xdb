<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>253141</resourceId>
    </Header>
    <Name href="/Mechanics/Spells/ItemMall/AvatarDonate/Spell.(SpellSingleTarget).Name.txt" />
    <Description href="/Mechanics/Spells/ItemMall/AvatarDonate/Spell.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <visualScripts href="/Mechanics/Spells/ItemMall/AvatarDonate/AvatarComplect.(SpellVisScripts).xdb" />
    <prepareDuration>10000</prepareDuration>
    <mechanics>
        <casterConditions>
            <!-- <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel"> -->
            <!-- <minLevel type="gameMechanics.formulas.IntConstantValue"> -->
            <!-- <value>4</value> -->
            <!-- </minLevel> -->
            <!-- </Item> -->
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/BuyBox65.(UnlockResource).xdb" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateIsRemort" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                <impactsResource href="/Mechanics/CreateAvatar/StartImpacts.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                <denyIteratorTraverse>false</denyIteratorTraverse>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactDropLoot">
                <lootTable href="AvatarComplectLootTable.(LootTableResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateUnlock">
                        <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/BuyBox65.(UnlockResource).xdb" />
                    </Item>
                </predicates>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                        <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/BuyBox65.(UnlockResource).xdb" />
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateGreater">
                                <lhs type="gameMechanics.elements.calcers.FloatData">
                                    <value>2</value>
                                </lhs>
                                <rhs type="gameMechanics.elements.calcers.FloatData">
                                    <value>1</value>
                                </rhs>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateUnlock">
                                            <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/BuyBox60.(UnlockResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateUnlock">
                                            <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/GiveRunes.(UnlockResource).xdb" />
                                        </Item>
                                    </predicates>
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactDropLoot">
                        <lootTable href="/Mechanics/Spells/ItemMall/AvatarDonate/AvatarComplectLootTable_withRunes.(LootTableResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                        <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/GiveRunes.(UnlockResource).xdb" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>