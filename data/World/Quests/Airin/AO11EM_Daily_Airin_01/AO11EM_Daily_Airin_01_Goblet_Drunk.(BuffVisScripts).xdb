<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.PostEffectVisAction">
        <userPostEffect href="/Spells/FX/InterfaceFX/Drunk_Vision_01.(UserPostEffect).xdb#xpointer(/client.VisualConstructor.UserPostEffect)" />
      </Item>
      <Item type="client.Replica.CreatureChangeVisItemsAction">
        <items>
          <Item>
            <newItem href="/Items/VisualItems/Weapon/1HOffhand/Offhand_Orb_E_03Silver.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
            <slot>MAINHAND</slot>
          </Item>
        </items>
        <isGfxCondition>false</isGfxCondition>
        <leaveWeapons>false</leaveWeapons>
        <notForDolls>false</notForDolls>
        <removeAllItems>false</removeAllItems>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>