<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739851280</resourceId>
	</Header>
	<name href="PoisonPoolRed.(ProjectileResource).Name.txt" />
	<visObject href="/Spells/FX/Mobs/UmoirRaidTentacleRed_Pool.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<altitude>0</altitude>
	<lifeLengthCap>6000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
					<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
					<radius>4</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>POISON</element>
									<damage>7</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
											<mobs>
												<Item href="Tentacles/TentacleBlue.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
												<Item href="BlueTentacleBig.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
											</mobs>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.PureDamage">
											<damage>1</damage>
											<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
													<multiplier>0.3</multiplier>
												</mulCalcer>
											</scalerTarget>
										</Item>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="TentacleBlueHealing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</impactsIf>
									<impactsElse>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
													<mobs>
														<Item href="Tentacles/TentacleRed.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
														<Item href="RedTentacleBig.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
													</mobs>
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="TentacleBlueDamage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
												</Item>
												<Item type="gameMechanics.elements.impacts.DirectHeal">
													<heal>1</heal>
													<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
														<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
															<multiplier>1</multiplier>
														</mulCalcer>
													</scalerTarget>
												</Item>
											</impactsIf>
										</Item>
									</impactsElse>
								</Item>
							</impactsElse>
						</Item>
					</impacts>
					<filter type="gameMechanics.constructor.basicElements.FilterOr">
						<filters>
							<Item type="gameMechanics.constructor.basicElements.FilterAnd">
								<filters>
									<Item type="gameMechanics.world.creature.AliveFilter" />
									<Item type="gameMechanics.world.creature.AvatarFilter" />
								</filters>
							</Item>
							<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
										<predicates>
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.predicates.PredicateProjectile" />
											</Item>
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.predicates.PredicateMobWorld">
													<mobs>
														<Item href="Worm.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
														<Item href="RightPaw.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
														<Item href="WormRed.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
														<Item href="LeftPaw.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
													</mobs>
												</predicate>
											</Item>
										</predicates>
									</Item>
								</predicates>
							</Item>
						</filters>
					</filter>
				</Item>
			</impacts>
			<tick>1000</tick>
			<initialDelay>1000</initialDelay>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
