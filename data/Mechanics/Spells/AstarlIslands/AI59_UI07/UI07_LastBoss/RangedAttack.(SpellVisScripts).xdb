<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>rangedAttack</Item>
				</animations>
				<advanced>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="CreatureProjectileAction">
		<projectileFx href="/Spells/FX/Spells/AstralToxin.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
		<explosionFx href="/Spells/FX/Spells/HitAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	</launch>
</SpellVisScripts>
