<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>5000</time>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/UmoirMound_Frog_ReadyDown.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<scale>4</scale>
						<fadeInTime>1000</fadeInTime>
						<fadeOutTime>3000</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
