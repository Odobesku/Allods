<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>5000</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="PostEffectVisAction">
								<userPostEffect href="/Spells/FX/InterfaceFX/Black_Long.(UserPostEffect).xdb" />
							</Item>
							<Item type="Sound2DAction">
								<forcedSoundStop>true</forcedSoundStop>
								<actionType>GlobalParams</actionType>
								<musicSourceParameters>
									<Item>
										<parameter href="/Items/InteractiveObjects/ZC7/ZC7_Distortion_Empire/ZC7_Distortion_Empire_Vol0.5.(SoundParameter).xdb" />
										<value>0.9</value>
									</Item>
								</musicSourceParameters>
								<onlyForMainAvatar>true</onlyForMainAvatar>
							</Item>
							<Item type="Sound3DAction">
								<sound>
									<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
									<name>spells/FX/World/RealityGap/RalealityGap2dReverse</name>
								</sound>
								<forcedSoundStop>true</forcedSoundStop>
								<onlyForMainAvatar>true</onlyForMainAvatar>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
