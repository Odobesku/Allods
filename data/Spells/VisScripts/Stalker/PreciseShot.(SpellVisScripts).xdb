<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/RangedAttack.(SpellVisScripts).xdb" />
		<Variables>
			<FxOnHands>/Spells/FX/Spells/Stalker70_PreciseShot.(VisObjectTemplate).xdb</FxOnHands>
			<LocatorNameOnArrow>Slot_FX</LocatorNameOnArrow>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>200</delay>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item skiped="" />
			<Item skiped="" />
			<Item skiped="" />
			<Item skiped="" />
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantCold</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureThrowArrowAction">
						<arrow href="" />
						<enchantedArrowIndex>1</enchantedArrowIndex>
						<arrowInTargetTime>15000</arrowInTargetTime>
						<theGe>8</theGe>
						<additionalEffectFx href="/Spells/FX/Weapon/ArrowEnchantTrail_Blue.(VisObjectTemplate).xdb" />
						<effectBone var="LocatorNameOnArrow" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantFire</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureThrowArrowAction">
						<arrow href="" />
						<enchantedArrowIndex>1</enchantedArrowIndex>
						<arrowInTargetTime>15000</arrowInTargetTime>
						<theGe>8</theGe>
						<additionalEffectFx href="/Spells/FX/Weapon/ArrowEnchantTrail_Red.(VisObjectTemplate).xdb" />
						<effectBone var="LocatorNameOnArrow" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantPoison</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureThrowArrowAction">
						<arrow href="" />
						<enchantedArrowIndex>1</enchantedArrowIndex>
						<arrowInTargetTime>15000</arrowInTargetTime>
						<theGe>8</theGe>
						<additionalEffectFx href="/Spells/FX/Weapon/ArrowEnchantTrail_Green.(VisObjectTemplate).xdb" />
						<effectBone var="LocatorNameOnArrow" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>BonusDmgAll</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureThrowArrowAction">
						<arrow href="" />
						<enchantedArrowIndex>1</enchantedArrowIndex>
						<arrowInTargetTime>15000</arrowInTargetTime>
