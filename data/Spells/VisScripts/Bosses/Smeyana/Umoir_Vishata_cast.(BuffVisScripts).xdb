<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readyCast</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Smeyana_Vishata_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
	<postAction />
</BuffVisScripts>
