<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>739894911</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                    <quality href="/Mechanics/MobQualities/AstralMobElite.(MobQuality).xdb#xpointer(/gameMechanics.world.mob.MobQuality)" />
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff hrefvar="PackMobs" />
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff hrefvar="SingleMobs" />
                </Item>
            </impactsElse>
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>