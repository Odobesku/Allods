<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739850785</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                    </impactsIf>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                                    <pool href="/Mechanics/Spells/AstarlIslands/AI58_UI06/UI06_SoloHealer/SoloHealer_Wisp.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                    <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <spawnResource href="/Maps/AstralIsle58_UI06/SpawnTables/AI58_Boss4Pack_05.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>