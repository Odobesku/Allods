<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739973017</resourceId>
	</Header>
	<Name href="TotemBuff_2.(BuffResource).Name.txt" />
	<image href="/Interface/Icons/Misc/Event/TrinketIceSculpture.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Spells/VoidGood_Small.(VisObjectTemplate).xdb" />
			<scale>1</scale>
			<locator>Slot_Global</locator>
		</Item>
	</visualEffects>
	<effects>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="Totem_BossBuff_2.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="Totem_BossBuff_2.(BuffResource).xdb" />
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Totem_BossBuff_2.(BuffResource).xdb" />
								</Item>
							</impactsElse>
						</Item>
						<Item type="gameMechanics.elements.impacts.PostponedImpacts">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
									<pool href="WerebearBossHeal.(SummonPool).xdb" />
									<impacts>
										<Item type="gameMechanics.elements.impacts.Disintegrate" />
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>