<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellOmni</Item>
                    <Item>readySpell</Item>
                    <Item>ready</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/ArchitectDestroyer_ReadySpellAoe.(VisObjectTemplate).xdb" />
                        <scale>1.2</scale>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Architect_Swarm_Avatar_Instable.(VisObjectTemplate).xdb" />
                        <effectAlias href="" />
                        <locator>Head</locator>
                        <offendTime />
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Red_R8.(VisObjectTemplate).xdb" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>0</delay>
                        <effectFx href="/Spells/FX/Mobs/ArchitectDestroyer_SpellCastAoe.(VisObjectTemplate).xdb" />
                        <fixPoint>true</fixPoint>
                        <lockScale>true</lockScale>
                        <scale>0.8</scale>
                    </Item>
                    <Item>
                        <delay>200</delay>
                        <effectFx href="/Spells/FX/Spells/HitLightning_big_ShakeCamera.(VisObjectTemplate).xdb" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>