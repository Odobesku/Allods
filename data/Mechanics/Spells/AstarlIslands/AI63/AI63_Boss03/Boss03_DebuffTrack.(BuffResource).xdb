<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739911830</resourceId>
	</Header>
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Boss03_DebuffTrack.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.DispelInterceptor">
			<holderImpacts>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Boss03_DebuffTrack.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Boss03_DebuffAdd.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactSummon">
							<destination type="gameMechanics.map.destination.SelfPosDestination" />
							<object href="Boss03_UndAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							<pool href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss03_UndAdd.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Boss03_DebuffAdd.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Boss03_DebuffAdd.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsElse>
				</Item>
			</holderImpacts>
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.PredicateBuffEquals">
					<buff href="Boss03_Debuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</predicates>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
