<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739903852</resourceId>
	</Header>
	<Name href="ChainBuff.(BuffResource).Name.txt" />
	<Description href="ChainBuff.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Buffs/ChainViolet.(UISingleTexture).xdb" />
	<visScript href="/Spells/BuffVisScripts/DotLightniing.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.PostponedImpacts">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
									<affectHolder>false</affectHolder>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="ChainBuff2.(BuffResource).xdb" />
										</Item>
									</impacts>
									<impactsOnNoTargets>
										<Item type="gameMechanics.elements.impacts.BuffDetacher">
											<buff href="ChainBuff.(BuffResource).xdb" />
										</Item>
									</impactsOnNoTargets>
									<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="/Mechanics/RaidInstances/Tank.(BuffResource).xdb" />
												</predicate>
											</Item>
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/BombBuff_NoHM.(BuffResource).xdb" />
												</predicate>
											</Item>
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="ChainBuff.(BuffResource).xdb" />
												</predicate>
											</Item>
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="ChainBuff2.(BuffResource).xdb" />
												</predicate>
											</Item>
										</predicates>
									</filter>
									<targetsLimit>1</targetsLimit>
									<sorting type="gameMechanics.elements.targetSelector.sorts.RandomSort">
										<avatarsFirst>true</avatarsFirst>
									</sorting>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
					<phantom href="RoboGuard2.(MobWorld).xdb" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>LIGHTNING</element>
							<damage>13</damage>
							<scaler type="gameMechanics.elements.scalers.MagicScaler" />
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ChainBuff.(BuffResource).xdb" />
				</Item>
			</onLeave>
