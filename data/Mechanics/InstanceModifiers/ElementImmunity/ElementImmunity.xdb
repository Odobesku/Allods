<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.basicElements.MapModifierResource>
    <Header>
        <resourceId>193181697</resourceId>
    </Header>
    <name href="ElementImmunity.txt" />
    <description href="ElementImmunity.Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/ResistanceAstral.(UISingleTexture).xdb" />
    <mapEffects>
        <Item type="gameMechanics.elements.effects.AddMapSpecificEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsEnemy">
                                            <factions>
                                                <Item href="/World/Factions/League.xdb" />
                                            </factions>
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsEnemy">
                                            <factions>
                                                <Item href="/World/Factions/Empire.xdb" />
                                            </factions>
                                        </Item>
                                    </predicates>
                                </Item>
                            </predicates>
                            <effectsIf>
                                <Item type="gameMechanics.elements.effects.Switch">
                                    <impactsOn>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="IHaveImmunityToo.(BuffResource).xdb" />
                                        </Item>
                                    </impactsOn>
                                </Item>
                            </effectsIf>
                            <effectsElse>
                                <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.offender.PredicateActionGroup">
                                            <groups>
                                                <Item href="/Mechanics/Spells/Groups/MercenarySpells.(ActionGroup).xdb" />
                                                <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
                                            </groups>
                                        </Item>
                                    </predicates>
                                    <impacts>
                                        <casterToTarget>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="IHaveImmunityToo.(BuffResource).xdb" />
                                            </Item>
                                        </casterToTarget>
                                    </impacts>
                                </Item>
                            </effectsElse>
                        </Item>
                    </effectsIf>
                </Item>
            </effects>
        </Item>
    </mapEffects>
    <exclusions>
        <Item href="/Maps/AstralIsle16/MapResource.xdb" />
        <Item href="/Maps/AstralIsle18/MapResource.xdb" />
    </exclusions>
</gameMechanics.map.basicElements.MapModifierResource>