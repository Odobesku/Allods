<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>184909</resourceId>
    </Header>
    <name href="Ability01_Add01.(AbilityResource).Name.txt" />
    <visualScript type="VisActionList">
        <playWhile type="CreatureEffectsAction">
            <visualEffects>
                <Item>
                    <effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    <scale>3</scale>
                    <fadeOutTime>300</fadeOutTime>
                </Item>
            </visualEffects>
        </playWhile>
    </visualScript>
    <nameTemplate href="Ability01_Add01.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="UI02_Boss01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Buff04_Helper.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.constructor.basicElements.FloatZero" />
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>8</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="UI02_Boss01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                <Item href="/Mechanics/Spells/AstarlIslands/AI54_UI02/SoloMob01/UI02_SoloMob01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Buff05_BossDebuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>35</radius>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="Visual_For_Add.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    <calcers>
                                        <addressEntries>
                                            <Item>
                                                <name>caster</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                            </Item>
                                            <Item>
                                                <name>target</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                            </Item>
                                        </addressEntries>
                                    </calcers>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                <mobs>
                                                    <Item href="UI02_Boss01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                    <Item href="/Mechanics/Spells/AstarlIslands/AI54_UI02/SoloMob01/UI02_SoloMob01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                </mobs>
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                            <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                        </predicates>
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>500</initialDelay>
        </Item>
    </effects>
    <disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>