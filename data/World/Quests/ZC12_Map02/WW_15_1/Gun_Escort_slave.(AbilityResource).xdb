<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739955775</resourceId>
	</Header>
	<visualScript type="CreatureMountVisAction">
		<visualMount href="/Mechanics/Spells/Events/SummerBoss2012/SummerBossMountGolemVisual.(VisualMount).xdb" />
	</visualScript>
	<effects>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="/Mechanics/QuestSchemes/Maintenance/CopyQGPlane.(Plane).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.Guard">
			<scanRadius>40</scanRadius>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>2000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>All</affectGroup>
			<radius>40</radius>
			<filter type="gameMechanics.world.creature.MobFilter" />
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="/Creatures/ArchitectMele/Instances/ZC12_Map02/ArchitectMelee_WW_15_1_escort_enemy.(MobWorld).xdb" />
							</mobs>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ForceAggro" />
							</impactsIf>
						</Item>
					</impactsIf>
				</Item>
			</impactsIn>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
