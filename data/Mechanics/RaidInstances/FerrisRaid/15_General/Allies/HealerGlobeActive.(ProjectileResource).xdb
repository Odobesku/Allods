<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>222872</resourceId>
    </Header>
    <persistentParts>
        <Item type="gameMechanics.constructor.schemes.buff.BuffsResource" />
    </persistentParts>
    <visObject href="/Spells/FX/Mobs/General_HealerGlobe_Loop.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>12000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>14000</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        </moveType>
                                        <resource href="HealerGlobeDisappears.(ProjectileResource).xdb" />
                                    </projectileData>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>1500</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.TickableEntityAura">
                            <affectGroup>All</affectGroup>
                            <radius>1.5</radius>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="HealerBuff.(BuffResource).xdb" />
                                </Item>
                            </impactsIn>
                            <holderImpactsIn>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                            <projectileData>
                                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                </moveType>
                                                <resource href="HealerGlobeDisappears.(ProjectileResource).xdb" />
                                            </projectileData>
                                        </Item>
                                    </impacts>
                                </Item>
                            </holderImpactsIn>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>250</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.EntityImpactEntitiesAround">
                                    <radius>5</radius>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                                    <resources>
                                                        <Item href="HealerGlobe.(ProjectileResource).xdb" />
                                                        <Item href="EmptyGlobe.(ProjectileResource).xdb" />
                                                    </resources>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>