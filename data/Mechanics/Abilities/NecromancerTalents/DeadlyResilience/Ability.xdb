<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>88939562</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.Name.txt" />
    <description href="Ability.Description.txt" />
    <descVars>
        <Item>
            <name>multiplier</name>
            <value var="multiplier" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent1MinusAbs</formula>
            </scaler>
        </Item>
        <Item>
            <name>petsta</name>
            <value var="petsta" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent1MinusAbs</formula>
            </scaler>
        </Item>
        <Item>
            <name>amount</name>
            <value var="amount" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>ManaLevelScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Event/ElixirOfGiant.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatStamina" />
            <multiplier var="multiplier" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsToPet">
            <effects>
                <Item type="gameMechanics.elements.effects.MultiplyStat">
                    <stat type="gameMechanics.elements.stat.StatStamina" />
                    <multiplier var="petsta" />
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.IncrementMana">
                            <manaType>Mana</manaType>
                            <amount var="amount" />
                            <scaler type="gameMechanics.elements.scalers.ManaLevelScaler" />
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Necromancer/FeignDeath/Spell01.xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
        </Item>
    </effects>
    <majorEffect>-1</majorEffect>
    <level>1</level>
    <ranks>
        <Item href="Ability01.xdb" />
        <Item href="Ability02.xdb" />
        <Item href="Ability03.xdb" />
    </ranks>
    <disableWhileDead>false</disableWhileDead>
    <saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>