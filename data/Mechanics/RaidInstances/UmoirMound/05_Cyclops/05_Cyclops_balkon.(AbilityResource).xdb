<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739877831</resourceId>
	</Header>
	<name href="05_Cyclops_balkon.(AbilityResource).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
			<groups>
				<Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
			</groups>
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
					<groups>
						<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
					</groups>
				</Item>
			</predicates>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
					<ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>05_Cyclops_01_B</scriptID>
						<map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
							<visualState>1</visualState>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.EntityImpactScriptZoneSetDisabled">
					<zone href="/Maps/UmoirMound/ScriptZones/05_Cyclops_01.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
					<disable>false</disable>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="05_Cyclops_Balkon_P_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
									<time>2000</time>
									<impactsOnLand>
										<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ForceAggro" />
											</impacts>
										</Item>
										<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
											<element>PHYSICAL</element>
											<damage>20</damage>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactTeleport">
											<destination type="gameMechanics.map.destination.DestinationLocator">
												<locator>
													<scriptID>05_Cyclops</scriptID>
													<map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
												</locator>
											</destination>
										</Item>
									</impactsOnLand>
									<destination type="gameMechanics.map.destination.DestinationLocator">
										<locator>
											<scriptID>05_Cyclops</scriptID>
											<map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
										</locator>
									</destination>
									<keepOnGround>false</keepOnGround>
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="05_Cyclops_Balkon_P_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<filter type="gameMechanics.world.creature.AvatarFilter" />
				</Item>
				<Item type="gameMechanics.elements.impacts.EntityImpactScriptZoneSetDisabled">
					<zone href="/Maps/UmoirMound/ScriptZones/05_Cyclops_01.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>05_Cyclops_01_B</scriptID>
						<map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
							<visualState>2</visualState>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.IncomingHealModifier">
			<priority>Multiplier</priority>
			<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
				<coeff>0</coeff>
				<calcer type="gameMechanics.elements.calcers.FloatData">
					<value>0</value>
				</calcer>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDamageTrigger">
			<impacts>
				<casterToOffender>
					<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
										<predicates>
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="05_Cyclops_Balkon_P_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											</Item>
										</predicates>
										<impactsIf>
											<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
												<element>PHYSICAL</element>
												<damage>15</damage>
											</Item>
										</impactsIf>
									</Item>
								</impacts>
							</Item>
						</impacts>
					</Item>
				</casterToOffender>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.IncomingHealModifier">
			<priority>Multiplier</priority>
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-1</coeff>
			</scaler>
		</Item>
	</effects>
	<disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>
