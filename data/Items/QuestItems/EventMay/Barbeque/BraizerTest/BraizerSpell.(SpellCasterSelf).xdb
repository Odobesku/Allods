    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="BraizerSpell_Name.txt" />
    <descTemplate href="BraizerSpell_Desc.txt" />
    <prepareDuration>3000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>300000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/Kania/Zones/ZoneLeague1/ZL1_0Capital.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/Hadagan/Zones/ZoneHadagan1/E1_Tower.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                        </Item>
                    </predicates>
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.world.ship.elements.PredicateStandingOnShip" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInWater" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>20</value>
                </minLevel>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateDeviceNear">
                        <radius>20</radius>
                        <devices>
                            <Item href="/Items/InteractiveObjects/EventMay/Braizer/Braizer.(ChestResource).xdb#xpointer(/gameMechanics.world.device.ChestResource)" />
                        </devices>
                    </predicate>
                </predicate>
                <clientData href="TooClose.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceItem">
                <item href="Braizer.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            </Item>
            <Item type="gameMechanics.elements.resources.ResourceItem">
                <item href="/Items/QuestItems/EventMay/Barbeque/Charcoal.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="/World/Quests/ZoneLeague1/ZL1_MayEvent_TutorBrazier/Brazier.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="/World/Quests/ZoneHadagan1/ZH1_MayEvent_TutorBrazier/Brazier.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                    <base type="gameMechanics.map.destination.RelativePos">
                        <yaw type="constructor.basicElements.AngleRadians" />
                        <faceSourcePos>false</faceSourcePos>
                    </base>
                    <offset>0</offset>
                </destination>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>300000</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        </impacts>
                    </Item>
                </impacts>
                <object href="/Items/InteractiveObjects/EventMay/Braizer/Braizer.(ChestResource).xdb#xpointer(/gameMechanics.world.device.ChestResource)" />
                <pool href="KaniaSummonPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                <isPersonalPool>true</isPersonalPool>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>