<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>14654</resourceId>
    </Header>
    <Name href="/World/Quests/Ferris4/Ferris_4_2_4/WatchingDialog.(BuffResource).Name.txt" />
    <Description href="/World/Quests/Ferris4/Ferris_4_2_4/WatchingDialog.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/TepSoulSteal.(UISingleTexture).xdb" />
    <visScript href="Kursk_2.(BuffVisScripts).xdb" />
    <sysUIScriptName>cutScene</sysUIScriptName>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>Kursk_2</scriptID>
                            <map href="/Maps/Inst_ZoneContested12_Start/MapResource.xdb" />
                        </locator>
                    </destination>
                    <finishImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>3000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                                    <spawn>
                                        <scriptID>Kursk_2_scene</scriptID>
                                        <map href="/Maps/Inst_ZoneContested12_Start/MapResource.xdb" />
                                    </spawn>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                                            <visualState>3</visualState>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </finishImpacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Kursk_2_Watched.(BuffResource).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/World/Quests/ZC12/WW_7_3/WW_7_3_NoSeeEgida.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>WW_7_5_Messanger2</scriptID>
                            <map href="/Maps/ZC12/MapResource.xdb" />
                        </locator>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                    <spawn>
                        <scriptID>Kursk_2_scene</scriptID>
                        <map href="/Maps/Inst_ZoneContested12_Start/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDoesNotAggro" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
    </effects>
    <duration>34000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>