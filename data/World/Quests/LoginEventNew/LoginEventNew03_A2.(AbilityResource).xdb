			<impactsToKiller>
				<Item type="gameMechanics.elements.impacts.ImpactIsolator">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
							<affectPets>false</affectPets>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
										<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
											<rule href="/Mechanics/Rules/LoginEventNew.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
										</Item>
										<Item type="gameMechanics.constructor.basicElements.PredicateOr">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
													<quest href="LoginEventNewLeague03.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
													<status>Started</status>
												</Item>
												<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
													<quest href="LoginEventNewEmpire03.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
													<status>Started</status>
												</Item>
											</predicates>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
											<id href="LoginEventNew03_A2.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
										</Item>
									</impactsIf>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsToKiller>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
