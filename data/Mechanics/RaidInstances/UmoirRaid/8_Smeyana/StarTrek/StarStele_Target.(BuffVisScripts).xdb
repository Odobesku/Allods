<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visActionID>Vis</visActionID>
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Smeyana_MoonPuddle_Glow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>3000</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>Vis</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
