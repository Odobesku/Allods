<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirected</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/DemonCrabBoss_ReadySpellDirectDown.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>3</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/NecromancerAcidBoltAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Spells/HitPoisonAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Mouth</locator>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_Global</locator>
				</pointOnTarget>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
