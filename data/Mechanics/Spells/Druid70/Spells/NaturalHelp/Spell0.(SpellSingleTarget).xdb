                            </scaler>
                            <value>1</value>
                        </calcer>
                    </scaler>
                </Item>
            </effects>
            <onBehalfOfHolder>true</onBehalfOfHolder>
        </Item>
    </modifiers>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>12000</duration>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>23.72</mana>
