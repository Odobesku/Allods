<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739902367</resourceId>
    </Header>
    <Name href="ChannelBuff.(BuffResource).Name.txt" />
    <Description href="ChannelBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/ZC6_BirdBeak.(UISingleTexture).xdb" />
    <visScript href="/Mechanics/Spells/CommonBuffs/KnockDown/KnockDown.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.DirectDamage">
                    <damage>1</damage>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.100001</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.RelativePos">
                        <yaw type="constructor.basicElements.AngleDegrees" />
                        <coord x="1.2" />
                    </destination>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                    <spawn>
                        <scriptID>5_Rukh</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="StopChewing.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="AcidContextBuff.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>2</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
            </groups>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/HealthBalanceProhibited.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>