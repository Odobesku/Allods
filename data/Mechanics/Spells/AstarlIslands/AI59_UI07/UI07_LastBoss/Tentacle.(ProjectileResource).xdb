<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739861665</resourceId>
	</Header>
	<visObject href="/Creatures/Kraken/KrakenProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<lifeLengthCap>7000</lifeLengthCap>
	<impactsOnDeath />
	<impactsOnStart>
		<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
			<projectileData>
				<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
				<resource href="Tentacle_Decal.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
			</projectileData>
		</Item>
	</impactsOnStart>
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
					<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
					<radius>10</radius>
					<affectGroup>Enemies</affectGroup>
					<affectHolder>false</affectHolder>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
							<time>2000</time>
							<impactsOnLand>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
