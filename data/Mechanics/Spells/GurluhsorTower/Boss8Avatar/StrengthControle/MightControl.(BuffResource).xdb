<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>169695276</resourceId>
	</Header>
	<Name href="Buff_Name.txt" />
	<Description href="Buff_Desc.txt" />
	<image href="/Interface/Icons/Spells/Mage/MageClairvoyance.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visScript href="/Spells/VisScripts/Bosses/GT_8Boss/Control.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<nameTemplate href="Buff_Name.txt" />
	<descTemplate href="Buff_Desc.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="MightControl_Plane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="MightControl_Plane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					<anyRank>false</anyRank>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
									<radius>2</radius>
									<affectHolder>false</affectHolder>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
											<element>HOLY</element>
											<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
													<multiplier>0.2</multiplier>
												</mulCalcer>
											</scalerTarget>
											<scaler type="gameMechanics.elements.scalers.TrivialScaler" />
											<damage>1</damage>
										</Item>
									</impacts>
									<filter type="gameMechanics.world.creature.AvatarFilter" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
	</effects>
	<duration>40000</duration>
	<isHelpful>true</isHelpful>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
