<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>318646</resourceId>
    </Header>
    <Name href="U_Isle_07_abandon.(BuffResource).Name.txt" />
    <Description href="U_Isle_07_abandon.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Unlocks/UnlockPortal.(UISingleTexture).xdb" />
    <visScript href="/World/Quests/ArchipelagoEmpire1/Quest6_2/Teleport.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                    <zone href="/Maps/UmoirIsland07/Zones/UmoirIsland07/UmoirIsland07.(ZoneResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                    <zone href="/Maps/Umoir/Zones/Umoir/Umoir.(ZoneResource).xdb" />
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>GoblinPiratesShip</scriptID>
                                    <map href="/Maps/2ndCircle/MapResource.xdb" />
                                </locator>
                            </destination>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                    <data href="U_Isle_07_abandon.(ClientData).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.Hover" />
    </effects>
    <duration>6000</duration>
    <isHelpful>false</isHelpful>
    <decayPolicy>NoOfflineDecay</decayPolicy>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>