<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>140719</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="RollUnlockerSpell.(SpellSingleTarget).Name.txt" />
    <Description href="RollUnlockerSpell.(SpellSingleTarget).Description.txt" />
    <nameTemplate href="RollUnlockerSpell.(SpellSingleTarget).NameTemplate.txt" />
    <descTemplate href="RollUnlockerSpell.(SpellSingleTarget).DescTemplate.txt" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceItem">
                    <item hrefvar="itemReward" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock hrefvar="unlock" />
                </predicate>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value var="predicateLevel" />
                </minLevel>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCanTake">
                <item hrefvar="itemReward" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item hrefvar="itemReward" />
                </item>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>