<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739934878</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Spell0_Name.txt" />
    <Description href="Buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/SummonGuard.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Other/Ghost_Black.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                    <variable href="/Mechanics/Spells/Necromancer70/Abilities/BloodDrops/BloodPool.(VariableResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                </Item>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>1</coeff>
                        <calcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="IncreaseDamageCalcer" />
                        </calcer>
                    </scaler>
                </Item>
                <Item type="gameMechanics.elements.effects.CastOnMove">
                    <moveTypes>
                        <Item>Step</Item>
                    </moveTypes>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Necromancer70/Spells/SummonSkeleton/Buff01.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                            <targetImpacts>
                                <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                            <externalCalcer hrefvar="SkeletonDamageCalcer" />
                                        </mulCalcer>
                                        <additionalMultiplier>
                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                        </additionalMultiplier>
                                    </scaler>
                                    <avgDamage>1</avgDamage>
                                </Item>
                            </targetImpacts>
                            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                                <spells>
                                    <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonSkeleton/SkeletonHit01.(SpellSingleTarget).xdb" />
                                    <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonSkeleton/SkeletonHit02.(SpellSingleTarget).xdb" />
                                    <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonSkeleton/SkeletonHit03.(SpellSingleTarget).xdb" />
                                </spells>
                            </destination>
                        </Item>
                    </effectsIf>
                    <effectsElse>
                        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Necromancer70/Spells/SummonZombie/Buff001.xdb" />
                                </Item>
                            </predicates>
                            <effectsIf>
                                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                                    <targetImpacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/Necromancer70/Spells/Virus/Buff001.xdb" />
                                        </Item>
                                    </targetImpacts>
                                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                                        <spells>
                                            <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonZombie/ZombieHit1.(SpellArea).xdb" />
                                        </spells>
                                    </destination>
                                </Item>
                                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                                    <targetImpacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/Necromancer70/Spells/Virus/Buff002.xdb" />
                                        </Item>
                                    </targetImpacts>
                                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                                        <spells>
                                            <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonZombie/ZombieHit2.(SpellArea).xdb" />
                                        </spells>
                                    </destination>
                                </Item>
                                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                                    <targetImpacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/Necromancer70/Spells/Virus/Buff003.xdb" />
                                        </Item>
                                    </targetImpacts>
                                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                                        <spells>
                                            <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonZombie/ZombieHit3.(SpellArea).xdb" />
                                        </spells>
                                    </destination>
                                </Item>
                            </effectsIf>
                            <effectsElse>
                                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Necromancer70/Spells/SummonBanshee/Buff001.xdb" />
                                        </Item>
                                    </predicates>
                                    <effectsIf>
                                        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                                            <targetImpacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/SilenceDisarm/SilenceDisarm.(BuffResource).xdb" />
                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier>3</multiplier>
                                                    </durationScaler>
                                                </Item>
                                            </targetImpacts>
                                            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                                                <spells>
                                                    <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonBanshee/BansheeHit.(SpellSingleTarget).xdb" />
                                                </spells>
                                            </destination>
                                        </Item>
                                    </effectsIf>
                                </Item>
                            </effectsElse>
                        </Item>
                    </effectsElse>
                </Item>
            </effectsElse>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAction">
            <action href="/Mechanics/Spells/Necromancer70/Spells/BloodPact/Spell01.(SpellSingleTarget).xdb" />
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.xdb" />
        <Item href="Buff02.xdb" />
        <Item href="Buff03.xdb" />
