<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>320908</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.2</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactSetFaction">
                    <faction href="/World/Factions/ZC12/ZC12_Traders.(Faction).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="Gang_02_surrender.(ClientData).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>10000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>0.19</level>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                        <value>0.8</value>
                    </chanceCalcer>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.RandomImpact">
                                    <entries>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                    <data href="Gang_03_aggro.(ClientData).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                    <data href="Gang_03_aggro2.(ClientData).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                    <data href="Gang_03_aggro3.(ClientData).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </entries>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>