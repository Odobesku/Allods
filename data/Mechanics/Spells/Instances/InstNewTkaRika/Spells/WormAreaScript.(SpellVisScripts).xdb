<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>ready</Item>
        </animations>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="CreatureEffectsAction">
            <visualEffects>
                <Item>
                    <effectFx href="/Spells/FX/Spells/TkaRika_Demon_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    <scale>2.5</scale>
                </Item>
            </visualEffects>
        </playWhile>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialCast</Item>
                </animations>
                <advanced>
                    <offendType>EVERYKEY_OFFEND</offendType>
                </advanced>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>