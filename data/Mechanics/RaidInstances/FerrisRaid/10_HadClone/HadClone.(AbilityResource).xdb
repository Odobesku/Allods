<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739903597</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
                    <quality href="HadCloneBossHM.(MobStatQuality).xdb#xpointer(/gameMechanics.world.mob.MobStatQuality)" />
                </Item>
                <Item type="gameMechanics.elements.effects.EffectDisableAction">
                    <action href="ColdPuddle.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
                    <quality href="HadCloneBossNormal.(MobStatQuality).xdb#xpointer(/gameMechanics.world.mob.MobStatQuality)" />
                </Item>
            </effectsElse>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactsToTargetSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="ColdPahse.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ColdPahse.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="PoisonPhase.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ElectroPhase.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ColdPahsePrecast.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="PoisonPhasePrecast.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ElectroPhasePrecast.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="tmp20.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="CometPrecast.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.5</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToTargetSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                </Item>
            </impacts>
