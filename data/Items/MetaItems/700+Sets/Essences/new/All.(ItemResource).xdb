<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>479030</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Misc/Crafting/InsigniaEndurance.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <source>Vendor</source>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <functionalPart type="itemService.avatar.itemBag.UseOnItemAndTakeActions">
        <multipleUse>true</multipleUse>
        <highlightPredicate type="gameMechanics.elements.item.ItemPredicateAnd">
            <predicates>
                <Item type="gameMechanics.elements.item.ItemPredicateNot">
                    <predicate type="gameMechanics.elements.item.ItemPredicateOr">
                        <predicates>
                            <Item type="gameMechanics.constructor.schemes.item.ItemPredicateGreater">
                                <lhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                                    <value var="budget" />
                                </lhs>
                                <rhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerBudgetType">
                                    <type>DefenceBudget</type>
                                </rhs>
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.item.ItemPredicateGreater">
                                <lhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                                    <value var="budget" />
                                </lhs>
                                <rhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerBudgetType">
                                    <type>OffenceBudget</type>
                                </rhs>
                            </Item>
                        </predicates>
                    </predicate>
                </Item>
            </predicates>
        </highlightPredicate>
        <usages>
            <Item>
                <useActions>
                    <Item type="itemService.avatar.itemBag.OpenUseAction" />
                </useActions>
                <consumeUsedItem var="consumeUsedItem" />
                <consumeTargetItem>0</consumeTargetItem>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </predicates>
        <triggersGlobalCooldown>false</triggersGlobalCooldown>
    </functionalPart>
    <level>70</level>
    <requiredLevel>67</requiredLevel>
    <stackLimit>1000</stackLimit>
    <quality href="/Mechanics/ItemQualities/Legendary.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>100000</money>
        </cost>
    </prices>
    <name href="DefenceEssenceOnce.(ItemResource).Name.txt" />
    <description href="DefenceEssenceOnce.(ItemResource).Description.txt" />
</gameMechanics.constructor.schemes.item.ItemResource>