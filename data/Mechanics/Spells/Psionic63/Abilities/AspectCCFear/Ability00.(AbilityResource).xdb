<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>220312</resourceId>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerFear.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/CC/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <targetImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                                        <spell href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisable.(SpellSingleTarget).xdb" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>40</radius>
                                    <affectGroup>Enemies</affectGroup>
                                    <affectHolder>false</affectHolder>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                            <value>10</value>
                                        </Item>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/CommonBuffs/Fear/Buff.xdb" />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier>1.5</multiplier>
                                            </durationScaler>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.world.creature.AliveFilter" />
                                    <targetsLimit>1</targetsLimit>
                                    <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
                                        <order>Ascending</order>
                                    </sorting>
                                </Item>
                            </impacts>
                        </Item>
                    </targetImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                        <spells>
                            <Item href="/Mechanics/Spells/Psionic63/Spells/SuggestionFear/Spell01.(SpellSingleTarget).xdb" />
                        </spells>
                    </destination>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.AbilityUnlockerEffect">
            <abilities>
                <Item href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisableAbility.(AbilityResource).xdb" />
            </abilities>
