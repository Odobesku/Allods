    <image href="/Interface/Icons/Spells/Modifiers/RaptureBattle.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <mapEffects>
        <Item type="gameMechanics.elements.effects.AddMapSpecificEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                        <Item type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                            <quality href="/Mechanics/MobQualities/BossAdd.xdb#xpointer(/gameMechanics.world.mob.MobQuality)" />
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                <quality href="/Mechanics/MobQualities/Common.xdb#xpointer(/gameMechanics.world.mob.MobQuality)" />
                            </predicate>
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.DeathTrigger">
                            <impactsToKiller>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                                    <impactsResource href="RewardForKill.(ImpactListGenericResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                                                </Item>
                                            </impactsIf>
                                            <impactsElse>
                                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactsToMaster">
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                                                    <impactsResource href="RewardForKill.(ImpactListGenericResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsElse>
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impactsToKiller>
                        </Item>
                    </effectsIf>
                </Item>
            </effects>
        </Item>
    </mapEffects>
    <weight>1</weight>
</gameMechanics.map.basicElements.MapModifierResource>