<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>195039</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.AttachAbility">
                    <ability href="/Mechanics/Spells/AstarlIslands/Common/BossIndex/BossID4.(AbilityResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.map.variables.PredicateMapVariableGreater">
                            <variableResource href="/Mechanics/InstancedEventResource/MM_LFG/MM_LFG_AstralIsles/BossKilled.(MapVariableResource).xdb" />
                            <minValue type="gameMechanics.elements.calcers.FloatData">
                                <value>3</value>
                            </minValue>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.DestinationLocalLocator">
                                <scriptID>TPNet0</scriptID>
                            </destination>
                            <object href="TeleportStele.(SteleResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.DestinationLocalLocator">
                        <scriptID>TPNet4</scriptID>
                    </destination>
                    <object href="TeleportSteleBoss4.(SteleResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>