<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/UmoirViy_Ray.(VisObjectTemplate).xdb" />
				<fxLength>12</fxLength>
				<startPoint type="VisPointLocator">
					<locator>FROM_LOCATOR_NAME</locator>
					<locatorName>Slot_Eye_R</locatorName>
				</startPoint>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/MountOrcTkarika_Head_Lightning.(VisObjectTemplate).xdb" />
						<scale>4</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
