    <interactiveObject>true</interactiveObject>
    <spell href="CannonExploit.(Exploit).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
    <dropsPublicLoot>false</dropsPublicLoot>
    <deviceSpells>
