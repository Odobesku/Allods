<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>199249</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactKill" />
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>29000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.SummandStat">
            <stat type="gameMechanics.elements.stat.InnateStat">
                <stat>Vitality</stat>
            </stat>
            <value>0</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>2</multiplier>
                    </Item>
                    <scaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>10</multiplier>
                    </scaler>
                </scalers>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/Spells/HuntingGrounds8/Architector/BossBubble.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>