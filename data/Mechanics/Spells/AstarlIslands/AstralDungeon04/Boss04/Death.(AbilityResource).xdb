<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>186393</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>Door04</scriptID>
                        <map href="/Maps/AstralDungeon04/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Open</switchType>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Creatures/FireElemental/Instances/AstralDungeon04/ElementalSolo02/FireElemental.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="FireElemChannelBuff.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <spawnResource href="/Maps/AstralDungeon04/SpawnTables/Boss04.(SpawnTable).xdb" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/Characters/Hadagan_male/AstralDungeon04/AD04.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                    <group href="/Mechanics/Spells/Groups/AstralIslandSpells.xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                    <affectPets>false</affectPets>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                            <group href="/Mechanics/Spells/Groups/AstralIslandSpells.xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                    <table href="/Maps/AstralDungeon04/SpawnTables/Boss04.(SpawnTable).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Creatures/FireElemental/Instances/AstralDungeon04/ElementalSolo02/FireElemental.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impactsIf>
                                </Item>
                            </impacts>
                            <spawnResource href="/Maps/AstralDungeon04/SpawnTables/Boss04.(SpawnTable).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </onLeave>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellCastTrigger">
                    <conditionalImpacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                            <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                                <base type="gameMechanics.map.destination.SelfPosDestination" />
                                                <offset>12</offset>
                                            </destination>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/AstarlIslands/AstralDungeon04/SummonFireElem.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <impactsFromTarget>
                                                <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                                                    </impacts>
                                                </Item>
                                            </impactsFromTarget>
                                            <object href="/Creatures/FireElemental/Instances/AstralDungeon04/ElementalSolo02/FireElemental.(MobWorld).xdb" />
                                            <pool href="/Mechanics/Characters/Hadagan_male/AstralDungeon04/AD04.(SummonPool).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <conditions>
                                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                    <spells>
                                        <Item href="SummonFireElem.(SpellSingleTarget).xdb" />
                                    </spells>
                                </Item>
                            </conditions>
                        </Item>
                    </conditionalImpacts>
                    <stages>
                        <Item>Start</Item>
                    </stages>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>