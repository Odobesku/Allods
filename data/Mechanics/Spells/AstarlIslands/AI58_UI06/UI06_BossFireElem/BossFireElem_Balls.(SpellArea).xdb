<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739851387</resourceId>
    </Header>
    <Name href="BossFireElem_Balls.(SpellArea).Name.txt" />
    <image href="/Interface/Icons/Spells/Mage/FireBolt.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="BossFireElem_Balls.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="BossFireElem_Balls.(SpellArea).Name.txt" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>8000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="BossFireElem_TankShield.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </predicate>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                        <projectileData>
                            <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                            <resource href="BossFireElem_Bomb.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                        </projectileData>
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>20</speed>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>60</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>