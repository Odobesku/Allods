                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateInZone">
                                        <zone href="/Maps/AstralIsle19/Zones/AstralIsle19_Start.(ZoneResource).xdb" />
                                    </predicate>
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateInZone">
                                        <zone href="/Maps/AstralIsle19/Zones/AstralIsle19/AstralIsle19.(ZoneResource).xdb" />
                                    </predicate>
