<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739853995</resourceId>
    </Header>
    <name href="UI06_AOEFireElem_BossAdd.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
            <impactsToTarget>
                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                        <value>0.2</value>
                    </chanceCalcer>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="AOE_Elem_burn.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsToTarget>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </onLeave>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>