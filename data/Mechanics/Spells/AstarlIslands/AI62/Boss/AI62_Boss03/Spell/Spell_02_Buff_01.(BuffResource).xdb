<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>191785</resourceId>
    </Header>
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectJumpOnDetach">
            <jumps type="gameMechanics.elements.calcers.LongData">
                <value>6</value>
            </jumps>
            <buff href="Spell_02_Buff_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.FilteringAutotarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
                <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.RandomAutotarget">
                    <group>All</group>
                    <radius>85</radius>
                </autotarget>
            </autotarget>
            <onBehalfOfCaster>true</onBehalfOfCaster>
            <radius>85</radius>
            <inCasterRange>false</inCasterRange>
            <renewingEffects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                            <lhs type="gameMechanics.elements.calcers.CalcerMod">
                                                <dividend type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                                    <calcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                                        <buff href="Spell_02_Buff_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                    </calcer>
                                                </dividend>
                                                <divisor type="gameMechanics.elements.calcers.LongData">
                                                    <value>2</value>
                                                </divisor>
                                            </lhs>
                                            <rhs type="gameMechanics.elements.calcers.LongData">
                                                <value>1</value>
                                            </rhs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Spell_02_BLUE_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Spell_02_RED_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Spell_02_Buff_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </renewingEffects>
        </Item>
    </effects>
    <stackLimit>50</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/InstanceModifiers/Addon5/Not_Astral_Modifiers.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
