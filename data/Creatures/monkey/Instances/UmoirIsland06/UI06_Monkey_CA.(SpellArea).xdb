                                                                                <impactsIf>
                                                                                    <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                                                                                        <variable href="/Maps/UmoirIsland06/Variables/UI06_Var_MF_Lake.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                                                                                        <summand>1</summand>
                                                                                    </Item>
                                                                                </impactsIf>
                                                                                <impactsElse>
                                                                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                                                        <predicates>
                                                                                            <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                                                                                <zone href="/Maps/UmoirIsland06/Zones/UmoirIsland06_North.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                                                                                            </Item>
                                                                                        </predicates>
