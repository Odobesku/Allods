<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>220785</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
    </groups>
    <Name href="ChargeSpell.(SpellArea).Name.txt" />
    <visualScripts href="Charge.(SpellVisScripts).xdb" />
    <prepareDuration>2000</prepareDuration>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <isWorkOnDead>true</isWorkOnDead>
    <iffPolicy>Enemies</iffPolicy>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>666666</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="ChargeResource.(BuffResource).xdb" />
                <consumeStacks>1</consumeStacks>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="ChargeBuff.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>2</multiplier>
                </durationScaler>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.map.destination.RelativeRotatePos">
                            <base type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                            <offset>2</offset>
                            <yaw type="constructor.basicElements.AngleDegrees" />
                        </destination>
                    </moveType>
                    <resource href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChieftainBoss/Charge/TargetDecale.(ProjectileResource).xdb" />
                </projectileData>
                <pool href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChieftainBoss/Charge/TargetDecales.(SummonPool).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>0</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>