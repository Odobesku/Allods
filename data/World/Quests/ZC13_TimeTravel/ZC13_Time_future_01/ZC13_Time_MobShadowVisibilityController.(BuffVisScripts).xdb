<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <stackCountVisScripts>
    <Item>
      <allTimeScript type="client.Replica.CreatureSetTransparencyAction">
        <fadeMult>0.5</fadeMult>
        <priority>1</priority>
        <transparency>1</transparency>
      </allTimeScript>
      <maxValue>1</maxValue>
      <playIfStateSkipedFromBigger>true</playIfStateSkipedFromBigger>
      <playIfStateSkipedFromLower>true</playIfStateSkipedFromLower>
    </Item>
    <Item>
      <allTimeScript type="client.Replica.CreatureSetTransparencyAction">
        <fadeMult>0.5</fadeMult>
        <priority>1</priority>
        <transparency>0.199999988</transparency>
      </allTimeScript>
      <maxValue>2</maxValue>
      <playIfStateSkipedFromBigger>true</playIfStateSkipedFromBigger>
      <playIfStateSkipedFromLower>true</playIfStateSkipedFromLower>
    </Item>
    <Item>
      <allTimeScript type="client.Replica.CreatureSetTransparencyAction">
        <fadeMult>0.5</fadeMult>
        <priority>1</priority>
        <transparency>0</transparency>
      </allTimeScript>
      <maxValue>3</maxValue>
      <playIfStateSkipedFromBigger>true</playIfStateSkipedFromBigger>
      <playIfStateSkipedFromLower>true</playIfStateSkipedFromLower>
    </Item>
  </stackCountVisScripts>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>