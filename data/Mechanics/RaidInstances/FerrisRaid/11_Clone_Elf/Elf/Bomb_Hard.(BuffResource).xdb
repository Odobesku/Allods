        </Item>
        <Item>
            <effectFx href="Bomb_Hard.(VisObjectTemplate).xdb" />
            <scale>1.5</scale>
            <locator>Slot_Global</locator>
        </Item>
    </visualEffects>
    <visualPostEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/HitLightning_big.(VisObjectTemplate).xdb" />
            <scale>1.5</scale>
            <locator>Slot_Global</locator>
        </Item>
    </visualPostEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>4</radius>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>LIGHTNING</element>
                                    <damage>500</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="StopCast.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
