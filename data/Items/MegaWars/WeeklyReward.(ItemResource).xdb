														<Item type="itemService.elements.avatarstuffcalcer.StuffCalcerAlternativeCurrency">
															<currency href="/Mechanics/AlternativeCurrencies/MWrewardCurrency.(AlternativeCurrency).xdb" />
														</Item>
													</calcers>
												</mulCalcer>
											</mulCalcer>
