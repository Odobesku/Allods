<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739924341</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Killer00.(BuffResource).Name.txt" />
	<Description href="Killer00.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Psionic/PsionicPhantasmalKiller.(UISingleTexture).xdb" />
	<visualEffects />
	<visScript href="/Spells/VisScripts/Psionic/Killer.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.PostponedImpacts">
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<eventClasses>
				<Item>gameMechanics.elements.events.EventDeath</Item>
			</eventClasses>
			<impacts>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Killer01.(BuffResource).xdb" />
				</Item>
			</impacts>
			<eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderTargetDeferred" />
		</Item>
		<Item type="gameMechanics.elements.effects.MultiplyStat">
			<stat type="gameMechanics.elements.stat.StatFullHealth" />
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mulCalcer type="constructor.elements.CalcerFloatExternal">
					<externalCalcer hrefvar="calcerHP" />
				</mulCalcer>
			</scaler>
		</Item>
	</effects>
	<duration>1000</duration>
	<isHelpful>true</isHelpful>
	<ranks>
		<Item href="Killer01.(BuffResource).xdb" />
		<Item href="Killer02.(BuffResource).xdb" />
		<Item href="Killer03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
