        </Item>
    </persistentParts>
    <name href="UI08_BeeHive.(ChestResource).Name.txt" />
    <visObj href="/World/Generic/Nature/Models/Hive/Hive.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
