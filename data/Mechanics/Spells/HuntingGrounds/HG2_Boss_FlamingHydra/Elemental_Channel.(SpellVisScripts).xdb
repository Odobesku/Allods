<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
            </Item>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <elements>
                    <Item type="CreatureChannelDirectAction">
                        <channelingFx href="/Spells/FX/Spells/BattleStation_FireRay.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fxLength>14</fxLength>
                        <startPoint type="VisPointLocator">
                            <locator>Head</locator>
                            <member>Default_Member</member>
                            <locatorName />
                        </startPoint>
                        <endPoint type="VisPointLocator">
                            <locator>Slot_FX</locator>
                            <member>Assaulter</member>
                        </endPoint>
                        <fadeInTime>100</fadeInTime>
                        <fadeOutTime>200</fadeOutTime>
                        <velocity>40</velocity>
                        <multyTargetMode>Umbrella</multyTargetMode>
                        <secondaryTargetParams>
                            <fxLength>20</fxLength>
                            <offendTime type="EffectOffendConstDelay" />
                        </secondaryTargetParams>
                    </Item>
                    <Item type="VisActionList">
                        <elements>
                            <Item type="VisActionDelay">
                                <time>300</time>
                            </Item>
                            <Item type="VisActionList">
                                <play>Simultaneously</play>
                                <playWhile />
                                <preconditional>false</preconditional>
                                <elements>
                                    <Item type="CreatureEffectsOnTarget">
                                        <visualEffects>
                                            <Item>
                                                <effectFx href="/Spells/FX/Mobs/Elemental_FireChannelEndSlow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                                <fadeOutTime>300</fadeOutTime>
                                                <locator>Slot_FX</locator>
                                                <member>Default_Member</member>
                                            </Item>
                                        </visualEffects>
                                    </Item>
                                </elements>
                            </Item>
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>