<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.CreatureEffectsAction">
        <category>EFFECT_DEFAULT</category>
        <visualEffects>
          <Item>
            <delay>0</delay>
            <effectAnimations>
              <mode>DIE</mode>
            </effectAnimations>
            <effectFx href="/Spells/FX/Spells/CreaturesTransform.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <fadeInTime>0</fadeInTime>
            <fadeOutTime>0</fadeOutTime>
            <scale>1</scale>
            <fixPoint>false</fixPoint>
            <lockScale>false</lockScale>
            <muteFxSounds>false</muteFxSounds>
            <ignoreParentRotation>false</ignoreParentRotation>
            <locator>Global</locator>
            <member>Default_Member</member>
            <offset x="0" y="0" z="0" />
            <rotation x="0" y="0" z="0" w="0" />
            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
          </Item>
        </visualEffects>
        <dontFade>false</dontFade>
        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
        <stopOnDeath>false</stopOnDeath>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.VisActionDelay">
            <time>1000</time>
          </Item>
          <Item type="client.Replica.CreatureChangeVisItemsAction">
            <items>
              <Item>
                <newItem href="/Items/Costumes/VisItems/Head/Special/HelmLifeStyleEvil.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                <slot>LIFESTYLEHEAD</slot>
              </Item>
              <Item>
                <newItem href="/Items/Costumes/VisItems/Underwear/A_13SummerEvent.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                <slot>LIFESTYLEUNDERWEAR</slot>
              </Item>
            </items>
            <isGfxCondition>false</isGfxCondition>
            <leaveWeapons>false</leaveWeapons>
            <notForDolls>false</notForDolls>
            <removeAllItems>true</removeAllItems>
          </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>