<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739925392</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability00.(AbilityResource).Name.txt" />
	<description href="Ability00.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="damage" />
		</Item>
		<Item>
			<name>var1</name>
			<value>-100</value>
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mul>-1</mul>
				<mulCalcer type="gameMechanics.elements.calcers.FloatData">
					<value>1</value>
				</mulCalcer>
				<sum var="factor" />
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Psionic/PsionicSuffocate.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/CC/Buff01.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
					<spell href="/Mechanics/Spells/Psionic63/Spells/MentalStorm/Spell01.(SpellSingleTarget).xdb" />
					<factor var="factor" />
				</Item>
				<Item type="gameMechanics.elements.effects.SpellsModifier">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="/Mechanics/Spells/Psionic63/Spells/MentalStorm/Spell01.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</predicates>
					<modifiers>
						<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
							<effects>
								<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
									<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
										<coeff>0.01</coeff>
										<calcer type="gameMechanics.elements.calcers.FloatData">
											<value var="damage" />
										</calcer>
									</scaler>
								</Item>
							</effects>
							<onBehalfOfHolder>true</onBehalfOfHolder>
						</Item>
					</modifiers>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
