<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>739905674</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
            <spawn>
                <scriptID>FR_12_Boss</scriptID>
                <map href="/Maps/FerrisRaid/MapResource.xdb" />
            </spawn>
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Boss_PlayerCount.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </impactsIn>
    <impactsOut>
        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
            <group href="/Mechanics/Spells/Groups/Events/EventBuffs.(ActionGroup).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                    <spawn>
                        <scriptID>FR_12_Boss</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.StackBuff">
                            <buff href="Boss_PlayerCount.(BuffResource).xdb" />
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>-1</value>
                            </delta>
                        </Item>
                    </impacts>
                </Item>
            </impactsIf>
        </Item>
    </impactsOut>
</gameMechanics.map.scriptZone.ScriptZone>