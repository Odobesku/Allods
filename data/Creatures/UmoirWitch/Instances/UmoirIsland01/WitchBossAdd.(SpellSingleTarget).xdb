    <prepareDuration>500</prepareDuration>
    <targetType>STTSelf</targetType>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>20000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                    <base type="gameMechanics.map.destination.RelativePos" />
                    <offset>4</offset>
                </destination>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                        </impacts>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.world.creature.AvatarFilter" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <object href="/Creatures/TreantGhost/Instances/UmoirIsland01/UI01_TreantAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                <pool href="SummonPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
            </Item>
        </casterImpacts>
    </mechanics>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>