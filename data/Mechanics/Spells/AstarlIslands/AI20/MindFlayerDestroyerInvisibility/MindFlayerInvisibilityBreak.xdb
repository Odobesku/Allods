<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>194707</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                    <ability href="MindFlayerDestroyerInvisibility.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>3</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.AttachAbility">
                            <ability href="MindFlayerDestroyerInvisibility.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/Spells/AstarlIslands/AI20/MindFlayerDestoyer/MindFlayerDestoyer_Double.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    <isPersonalPool>true</isPersonalPool>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </onLeave>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>