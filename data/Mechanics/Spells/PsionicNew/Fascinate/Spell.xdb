		<value>40</value>
	</range>
	<level>1</level>
	<prepareDuration var="prepareDuration" />
	<immutablePrepareDuration>false</immutablePrepareDuration>
	<needLos>true</needLos>
	<targetType>STTSelf</targetType>
	<isAggro>true</isAggro>
	<replaceLowRanks>true</replaceLowRanks>
	<isWorkOnDead>false</isWorkOnDead>
	<ranks>
		<Item href="Spell01.xdb" />
		<Item href="Spell02.xdb" />
		<Item href="Spell03.xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>true</triggersGlobalCooldown>
	<ignoreGlobalCooldown>false</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>true</needInFront>
	<mechanics>
		<cooldown>
			<stage>Launch</stage>
			<duration var="duration" />
			<group href="" />
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateHasAnyPsionicContact">
				<hideText>false</hideText>
				<spellTarget>false</spellTarget>
			</Item>
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceMana">
				<hideText>false</hideText>
				<mana var="mana" />
				<scaleByWeaponSpeed>false</scaleByWeaponSpeed>
				<source>Mainhand</source>
				<manaType>
					<Item>Mana</Item>
				</manaType>
			</Item>
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.AffectPsionicContact">
				<contactType>Normal</contactType>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactsIf">
						<predicate type="gameMechanics.elements.predicates.PredicateAffectGroup">
							<affectGroup>Enemies</affectGroup>
						</predicate>
						<impactsIf>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff hrefvar="buff" />
								<durationScaler type="gameMechanics.elements.scalers.ScalerIf">
									<binaryCondition type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateAffectedByMasterContact">
												<checkContactType>true</checkContactType>
												<contactType>Crude</contactType>
											</Item>
											<Item type="gameMechanics.constructor.basicElements.BinaryPredicateAnd">
												<predicates>
													<Item type="gameMechanics.elements.predicates.PredicateAffectedByMasterContact">
														<checkContactType>true</checkContactType>
													</Item>
													<Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
														<onMaster type="gameMechanics.elements.predicates.PredicateHasAbility">
															<ability href="/Mechanics/Spells/PsionicNew/Abilities/SameContacts/Ability02.xdb" />
															<anyRank>false</anyRank>
														</onMaster>
														<onSlave type="gameMechanics.constructor.basicElements.PredicateTrue" />
													</Item>
												</predicates>
											</Item>
										</predicates>
									</binaryCondition>
									<scalerIf type="gameMechanics.elements.scalers.LinearScaler">
										<multiplier>1.15</multiplier>
									</scalerIf>
									<scalerElse type="gameMechanics.elements.scalers.ScalerIf">
										<binaryCondition type="gameMechanics.constructor.basicElements.BinaryPredicateAnd">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateAffectedByMasterContact">
													<checkContactType>true</checkContactType>
												</Item>
												<Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
													<onMaster type="gameMechanics.elements.predicates.PredicateHasAbility">
														<ability href="/Mechanics/Spells/PsionicNew/Abilities/SameContacts/Ability01.xdb" />
														<anyRank>false</anyRank>
													</onMaster>
													<onSlave type="gameMechanics.constructor.basicElements.PredicateTrue" />
												</Item>
											</predicates>
										</binaryCondition>
										<scalerIf type="gameMechanics.elements.scalers.LinearScaler">
											<multiplier>1.1</multiplier>
										</scalerIf>
										<scalerElse type="gameMechanics.elements.scalers.TrivialScaler" />
									</scalerElse>
								</durationScaler>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactActivateAggro" />
							<Item type="gameMechanics.elements.impacts.ImpactPvpAction" />
							<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
								<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
								<data href="/Spells/VisScripts/Psionic/Fascinate.(ClientData).xdb" />
								<calcers>
									<addressEntries>
										<Item>
											<name>caster</name>
											<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
										</Item>
										<Item>
											<name>target</name>
											<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
										</Item>
									</addressEntries>
								</calcers>
							</Item>
						</impactsIf>
					</Item>
				</impacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.AffectPsionicContact">
				<contactType>Crude</contactType>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactsIf">
						<predicate type="gameMechanics.elements.predicates.PredicateAffectGroup">
							<affectGroup>Enemies</affectGroup>
						</predicate>
						<impactsIf>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff hrefvar="bu_1" />
								<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
									<multiplier>1.15</multiplier>
								</durationScaler>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactActivateAggro" />
							<Item type="gameMechanics.elements.impacts.ImpactPvpAction" />
							<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
								<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
								<data href="/Spells/VisScripts/Psionic/Fascinate.(ClientData).xdb" />
								<calcers>
									<addressEntries>
										<Item>
											<name>caster</name>
											<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
										</Item>
										<Item>
											<name>target</name>
											<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
										</Item>
									</addressEntries>
								</calcers>
							</Item>
						</impactsIf>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
	</mechanics>
	<speed>0</speed>
	<isAE>false</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
