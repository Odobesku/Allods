    <effects>
        <Item type="gameMechanics.elements.effects.LayeredHealthTrigger">
            <layers>
                <Item>
                    <percent>0.0105</percent>
                    <mechanics>
                        <impactsOn>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="PartyKnockdown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
