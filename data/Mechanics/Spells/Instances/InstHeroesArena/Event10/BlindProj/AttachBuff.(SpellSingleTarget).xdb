<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739918150</resourceId>
	</Header>
	<Name href="Project.(ProjectileResource).Name.txt" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>50</value>
	</range>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>15000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.map.variables.PredicateMapVariableGreater">
				<variableResource href="/Maps/Inst_HeroesArena/ScriptZones/WaveNumberNew.xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
				<minValue type="gameMechanics.elements.calcers.FloatData">
					<value>34.5</value>
				</minValue>
			</Item>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
					<rule href="/Mechanics/Spells/Instances/InstHeroesArena/DeactivateNewSpells.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
				</predicate>
			</Item>
		</casterConditions>
		<targetImpacts>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="BlindTarget.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
				<delay>500</delay>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
						<projectileData>
							<moveType type="gameMechanics.world.projectile.MoveTypePursuitSpellTarget" />
							<resource href="Project.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
						</projectileData>
					</Item>
				</impacts>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
