<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>518053</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Event/TalonGold.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <source>Vendor</source>
    <notForItemMall>true</notForItemMall>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <functionalPart type="itemService.avatar.itemBag.ItemTakeActions">
        <actions>
            <Item type="itemService.avatar.itemBag.GiveMoneyTakeAction">
                <multiplier type="itemService.elements.avatarstuffcalcer.StuffLinearCalcer">
                    <mul>0.222223</mul>
                    <mulCalcer type="itemService.elements.avatarstuffcalcer.StuffCalcerGold">
                        <level type="itemService.elements.avatarstuffcalcer.StuffCalcerLevel" />
                    </mulCalcer>
                </multiplier>
            </Item>
        </actions>
    </functionalPart>
    <stackLimit>100</stackLimit>
    <quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <prices type="gameMechanics.constructor.schemes.item.prices.AltCurrenciesItem">
        <currencies>
            <Item>
                <currency href="/Mechanics/AlternativeCurrencies/BGPoints.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                <value>20</value>
            </Item>
        </currencies>
    </prices>
    <binding>BindOnPickup</binding>
    <lifeLengthCap>86400000</lifeLengthCap>
    <name href="TicketGoldNew.(ItemResource).Name.txt" />
    <description href="TicketGoldNew.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/Consumables/Special.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
</gameMechanics.constructor.schemes.item.ItemResource>