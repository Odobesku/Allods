<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>208361</resourceId>
    </Header>
    <name href="HealingSphere.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/Healing_Sphere_Blue.(VisObjectTemplate).xdb" />
    <altitude>1.4</altitude>
    <speed>0.002</speed>
    <lifeLengthCap>30000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.StaticEntityAura">
            <radius>2</radius>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                                    <level>1</level>
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBaseMana">
                                        <baseMana>1</baseMana>
                                    </predicate>
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                    <predicates>
                                        <Item type="gameMechanics.world.pet.PredicateHasPet" />
                                        <Item type="gameMechanics.elements.predicates.PredicateToPet">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                                                    <level>0.9</level>
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </predicates>
                                </Item>
                            </predicates>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.DirectHeal">
                                    <heal>1</heal>
                                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                            <multiplier>0.3</multiplier>
                                        </mulCalcer>
                                    </scalerTarget>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="HealingSphere_HoT.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateManaCaster">
                                            <manaType>Mana</manaType>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.IncrementManaBase">
                                            <manaType>Mana</manaType>
                                            <factor>0.3</factor>
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.IncrementManaBase">
                                            <manaType>Energy</manaType>
                                            <factor>0.5</factor>
                                        </Item>
                                    </impactsElse>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.world.pet.PredicateHasPet" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactHealAll" />
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ReturningImpactsGeneric">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>