<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739931729</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
	</groups>
	<Name href="Exhaust.(SpellArea).Name.txt" />
	<Description href="Exhaust.(SpellArea).Description.txt" />
	<descVars>
		<Item>
			<name>dmg</name>
			<value var="damage" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>WeaponScaler</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Engineer/Exhaust.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Engineer/Exhaust.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>10</value>
	</range>
	<targetType>STTSelf</targetType>
	<ranks>
		<Item href="Exhaust01.(SpellArea).xdb" />
		<Item href="Exhaust02.(SpellArea).xdb" />
		<Item href="Exhaust03.(SpellArea).xdb" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>10000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateVariableGreatThan">
						<resource href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateVariableLessThan">
						<resource href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
					</Item>
				</predicates>
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.MarkedImpact">
				<mark href="ExhaustOrBlowOnCaster.(MarkResource).xdb" />
			</Item>
			<Item type="gameMechanics.elements.impacts.MarkedImpact">
				<mark href="ExhaustOnCaster.(MarkResource).xdb" />
			</Item>
			<Item type="gameMechanics.elements.impacts.PostponedImpacts">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactVariableReset">
						<variable href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateVariableGreatThan">
								<resource href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
							</Item>
						</predicates>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
								<impactsOnHitTarget>
									<Item type="gameMechanics.elements.impacts.MarkedImpact">
										<mark href="BlowOrExhaustOnTarget.(MarkResource).xdb" />
									</Item>
									<Item type="gameMechanics.elements.impacts.MarkedImpact">
										<mark href="ExhaustOnTarget.(MarkResource).xdb" />
									</Item>
								</impactsOnHitTarget>
								<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
									<scalers>
										<Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
										<Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
										<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
											<mulCalcer type="gameMechanics.elements.calcers.VariableValueCalcer">
												<variable href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
												<mul>0.01</mul>
												<sum>1</sum>
											</mulCalcer>
										</Item>
									</scalers>
								</scaler>
								<minDamage var="damage" />
								<maxDamage var="damage" />
							</Item>
						</impacts>
						<elseImpacts>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff hrefvar="buff" />
								<impactsOnAttach>
									<Item type="gameMechanics.elements.impacts.MarkedImpact">
										<mark href="BlowOrExhaustOnTarget.(MarkResource).xdb" />
									</Item>
									<Item type="gameMechanics.elements.impacts.MarkedImpact">
										<mark href="ExhaustOnTarget.(MarkResource).xdb" />
									</Item>
								</impactsOnAttach>
							</Item>
						</elseImpacts>
					</Item>
				</impacts>
				<groupRepeaters>true</groupRepeaters>
			</Item>
		</targetImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
