<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirected</Item>
				</animations>
				<advanced>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>250</delay>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownAstral.(VisObjectTemplate).xdb" />
						<scale>1.2</scale>
						<locator>Slot_Global</locator>
						<offset z="-1" />
					</Item>
					<Item>
						<delay>250</delay>
						<effectFx href="/Spells/FX/Mobs/WormGlacial_CorruptionCleave_Decal.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<scale>6</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<offset y="1.25" />
					</Item>
					<Item>
						<delay>250</delay>
						<effectFx href="/Spells/FX/Mobs/WormGlacial_CorruptionCleave_Decal.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<scale>6</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<offset y="1.25" z="-1.25" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>250</time>
			</Item>
			<Item type="CreatureRotateToCastPointAction">
				<visActionID>WormRotationLock</visActionID>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/WormGlacial_CorruptionCleaveCast.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<scale>3</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>3000</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>WormRotationLock</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
