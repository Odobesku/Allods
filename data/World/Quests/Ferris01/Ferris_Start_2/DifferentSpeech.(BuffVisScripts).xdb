<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionLoopAction">
		<actionToLoop type="CreatureAnimationAction">
			<use>USE_RANDOM_FROM_LIST</use>
			<animations>
				<Item>emoteSpeech</Item>
				<Item>emoteSayYes</Item>
				<Item>emoteSayNo</Item>
				<Item>emoteBoring</Item>
				<Item>emoteFacepalm</Item>
				<Item>emoteShrug</Item>
			</animations>
			<channel>CHANNEL_KNOCKDOWN</channel>
			<advanced>
				<denyAutoHasten>true</denyAutoHasten>
			</advanced>
		</actionToLoop>
	</action>
</BuffVisScripts>
