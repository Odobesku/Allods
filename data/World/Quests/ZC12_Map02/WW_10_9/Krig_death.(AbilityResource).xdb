<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739967937</resourceId>
    </Header>
    <visualScript type="VisActionList">
        <elements>
            <Item type="CreatureReplaceAnimationsAction">
                <onTop>
                    <animationsReplacements>
                        <Item>
                            <play>special</play>
                            <forAnimations>
                                <Item>idle</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onTop>
                <onBottom>
                    <animationsReplacements>
                        <Item>
                            <play>special</play>
                            <forAnimations>
                                <Item>idle</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onBottom>
            </Item>
            <Item type="CreatureReplaceAnimationsAction">
                <onTop>
                    <animationsReplacements>
                        <Item>
                            <play>special</play>
                            <forAnimations>
                                <Item>ready</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onTop>
                <onBottom>
                    <animationsReplacements>
                        <Item>
                            <play>special</play>
                            <forAnimations>
                                <Item>ready</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onBottom>
            </Item>
        </elements>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>3000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="ArchitectTrip.(BuffResource).xdb" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                        <modifiers>
                                                            <Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
                                                                <alternatives>
                                                                    <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                                        <radius type="gameMechanics.elements.calcers.FloatData">
                                                                            <value>25</value>
                                                                        </radius>
                                                                    </Item>
                                                                </alternatives>
                                                            </Item>
                                                        </modifiers>
                                                    </destination>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                            <delay>240000</delay>
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                                            </impacts>
                                                        </Item>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="/World/Quests/ZC12/WW_1_8/Arc_plane.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                    <object href="/Creatures/ArchitectBossCaster/Instances/ZC12_Map02/WW_10_9_Savant.(MobWorld).xdb" />
                                                    <pool href="TripPool.(SummonPool).xdb" />
                                                    <isPersonalPool>true</isPersonalPool>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                    <data href="Heal.(ClientData).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>2</multiplier>
                    </durationScaler>
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/Creatures/ArchitectSiege/ZC12_Map02/109_Krig.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impactsIf>
                </Item>
            </onLeave>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellCastTrigger">
                    <conditionalImpacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Creatures/ArchitectSiege/ZC12_Map02/DelayedProjectile.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>2</multiplier>
                                    </durationScaler>
                                </Item>
                            </impacts>
                            <conditions>
                                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                    <spells>
                                        <Item href="/Mechanics/Creatures/ArchitectSiege/ZC12_Map02/109_KrigCleave.(SpellArea).xdb" />
                                    </spells>
                                </Item>
                            </conditions>
                        </Item>
                    </conditionalImpacts>
                    <stages>
                        <Item>Start</Item>
                    </stages>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatStamina" />
            <multiplier>1.75</multiplier>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>