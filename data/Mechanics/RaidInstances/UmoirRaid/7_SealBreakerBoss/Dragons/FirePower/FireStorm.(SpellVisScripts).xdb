<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>ready</Item>
		</animations>
		<channel>CHANNEL_KNOCKDOWN</channel>
		<channelOverrideScript />
		<advanced>
			<offendType>EVERYKEY_ALLOFFENDS</offendType>
		</advanced>
	</actionBarStart>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Mobs/Dragons_FireStorm_Ready.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<effectAlias href="" />
				<locator>Head</locator>
				<offendTime />
			</Item>
		</visualEffects>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Dragons_FireStorm_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<locator>Head</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
