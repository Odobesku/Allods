                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="Spell01.xdb" />
                            </spells>
                        </Item>
                    </predicates>
                </predicate>
            </predicate>
        </Item>
    </effects>
    <duration>0</duration>
    <stackLimit>1</stackLimit>
