<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>739918268</resourceId>
    </Header>
    <name href="ToArchitectWorld.(Cue).Name.txt" />
    <text href="ToArchitectWorld.(Cue).Text.txt" />
    <conditions>
        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/FerrisRaid_Part4.(ContentKey).xdb" />
        </Item>
    </conditions>
    <additionalConditions>
        <Item type="gameMechanics.elements.predicates.PredicateInRaid">
            <policy>Small</policy>
        </Item>
    </additionalConditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
            <destination type="gameMechanics.map.destination.DestinationLocator">
                <locator>
                    <scriptID>FR4_Start_Portal</scriptID>
                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                </locator>
                <yaw type="constructor.basicElements.AngleDegrees">
                    <value>5</value>
                </yaw>
            </destination>
            <finishImpacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ToArchitectKick.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
                </Item>
            </finishImpacts>
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>