<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739923861</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <element>HOLY</element>
    <Name href="SymbolOfLight.(SpellArea).Name.txt" />
    <Description href="SymbolOfLight.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>MagicScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Paladin/LightInfusionUpgrade.(UISingleTexture).xdb" />
    <visualScripts href="SymbolOfLight.(SpellVisScripts).xdb" />
    <prepareDuration>0</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <ranks>
        <Item href="SymbolOfLight01.(SpellArea).xdb" />
        <Item href="SymbolOfLight02.(SpellArea).xdb" />
        <Item href="SymbolOfLight03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration var="cd" />
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Paladin63/Abilities/Canons/LightCanon.(VariableResource).xdb" />
                <sub>1</sub>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff hrefvar="buff" />
            </Item>
            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                <mark href="SymbolStartCastSelf.(MarkResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>15</radius>
    <stopOnNoTargets>false</stopOnNoTargets>
</gameMechanics.constructor.schemes.spell.area.SpellArea>