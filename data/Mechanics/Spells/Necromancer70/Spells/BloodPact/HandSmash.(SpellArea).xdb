<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>198751</resourceId>
    </Header>
    <Name href="HandSmash.(SpellArea).Name.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerDarkPower.(UISingleTexture).xdb" />
    <visualScripts href="HandSmash.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>3000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>SHADOW</element>
                <damage>35</damage>
                <impactsOnHitCaster>
                    <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                        <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCasterMaster" />
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Hand.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impactsOnHitCaster>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.RectangularRay">
        <width>4</width>
        <topPlane>3</topPlane>
        <bottomPlane>-3</bottomPlane>
    </shape>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>5</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>