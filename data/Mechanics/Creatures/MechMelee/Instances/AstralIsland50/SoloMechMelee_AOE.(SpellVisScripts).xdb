<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes2/Mob_Instant.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FixPointTarget>true</FixPointTarget>
			<Trail />
			<ShakeParams>/Spells/FX/InterfaceFX/CameraShakeVert1.(CameraShakeParameters).xdb#xpointer(/CameraShakeParameters)</ShakeParams>
			<FxOnTarget />
			<LocatorNameOnCaster />
			<LocatorOnTarget />
			<DelayCasterFX>0</DelayCasterFX>
			<HitDelay>0</HitDelay>
			<Enchant />
			<FixPointCaster>true</FixPointCaster>
			<FxOnHands />
			<LocatorNameOnTarget />
			<FxOnCaster>/Spells/FX/Mobs/Yeti_AOEFear.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnCaster>
			<HitPostFxOnTarget>/Spells/VisScripts/HitPostFxOnTarget/HitMeleeHard.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</HitPostFxOnTarget>
			<Animation>spellCastOmni</Animation>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction" />
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
				<advanced>
					<turnToTarget>TURN_DEFAULT</turnToTarget>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<scale>3</scale>
							</Item>
						</visualEffects>
					</Item>
					<Item skiped="" />
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
