    </effects>
    <duration>5000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <ranks>
        <Item href="PurgePainGroupShield01.(BuffResource).xdb" />
        <Item href="PurgePainGroupShield02.(BuffResource).xdb" />
        <Item href="PurgePainGroupShield03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
