<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>501031</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="AstralSkilledItemBox.(SpellSingleTarget).Name.txt" />
    <prepareDuration>3000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateActiveItemSlotType">
                <slotType>ItemBag</slotType>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="itemService.avatar.itemBag.ImpactGiveSkilledItem">
                <level type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                <quality hrefvar="quality" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>