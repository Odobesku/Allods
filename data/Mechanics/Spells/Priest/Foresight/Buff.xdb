<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>203370</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Spells/Priest/Providence.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffects>
        <Item>
            <delay>0</delay>
            <effectFx href="/Spells/FX/Spells/Priest_Providence_03.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <effectAlias href="" />
            <fixPoint>false</fixPoint>
            <lockScale>false</lockScale>
            <scale>0.45</scale>
            <fadeInTime>300</fadeInTime>
            <fadeOutTime>300</fadeOutTime>
            <locator>Slot_TopFX</locator>
            <member>Default_Member</member>
            <locatorName />
            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
        </Item>
    </visualEffects>
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <damageType>Damage</damageType>
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
            </predicates>
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.StackBuff">
                                <buff hrefvar="buff" />
                                <resetTimer>false</resetTimer>
                                <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                <delta type="gameMechanics.elements.calcers.FloatData">
                                    <value>-1</value>
                                </delta>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
                            <radius>85</radius>
                        </distributor>
                        <data href="/Spells/ClientData/TrinketGTHealing.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactHeal">
                        <heal var="heal" />
                        <threatMultiplier>1</threatMultiplier>
                        <scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
                    </Item>
                </casterToTarget>
            </impacts>
            <scaleImpactsByDamage>false</scaleImpactsByDamage>
        </Item>
    </effects>
    <duration>30000</duration>
    <isStackable>true</isStackable>
    <stackLimit>12</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff03.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
    </ranks>
    <canBeSaved>true</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ClassChangeBuffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>