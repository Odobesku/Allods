<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>rangedAttack</Item>
        </animations>
        <channel>CHANNEL_KNOCKDOWN</channel>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Spells/NecromancerElf_Heal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <explosionFx href="/Spells/FX/Spells/NecromancerElf_Heal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </pointOnCaster>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>