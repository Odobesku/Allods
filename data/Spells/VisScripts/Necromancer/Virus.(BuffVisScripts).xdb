<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionLoopAction">
		<actionToLoop type="VisActionList">
			<play>Simultaneously</play>
			<playWhile type="VisActionDelay">
				<time>1000</time>
			</playWhile>
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/HitDisease.(VisObjectTemplate).xdb" />
							<scale>1.5</scale>
							<offset z="0.5" />
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</actionToLoop>
	</action>
	<postAction type="VisActionList">
		<playWhile type="VisActionDelay">
			<time>1000</time>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/NecromancerBloodPlague_Dot.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<scale>1.2</scale>
						<locator>Slot_FX</locator>
						<offendTime />
						<offset z="-0.3" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
