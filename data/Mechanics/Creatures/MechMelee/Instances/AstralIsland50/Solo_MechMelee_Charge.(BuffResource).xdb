                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="Solo_MechMelee_Enrage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                    <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                    <minDamage>10</minDamage>
                                    <maxDamage>10</maxDamage>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOnLand>
                    <distance>5</distance>
                </Item>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="CooldownBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <buff href="Solo_MechMelee_Charge.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            <speedFactor>6</speedFactor>
            <pathChecker type="space.pathfinding.pathChecker.PathDeviationLimited">
                <angle>0.5236</angle>
            </pathChecker>
        </Item>
        <Item type="gameMechanics.elements.effects.Aura">
            <affectGroup>Enemies</affectGroup>
            <radius>5</radius>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="Solo_MechMelee_Enrage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                            <time>1000</time>
                            <impactsOnLand>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="KnockDown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                    <impactsOnHitTarget>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="KnockDown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier>0.5</multiplier>
                                            </durationScaler>
                                        </Item>
                                    </impactsOnHitTarget>
                                    <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                    <minDamage>10</minDamage>
                                    <maxDamage>10</maxDamage>
                                </Item>
                            </impactsOnLand>
                            <distance>5</distance>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.tools.SelectorParticular">
                        <index>0</index>
                    </selector>
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
