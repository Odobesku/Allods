<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>313287680</resourceId>
	</Header>
	<element>FIRE</element>
	<Name href="Shelling.(SpellArea).Name.txt" />
	<visualScripts href="ShellingFire.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>2000</prepareDuration>
	<immutablePrepareDuration>true</immutablePrepareDuration>
	<needLos>false</needLos>
	<targetType>STTPoint</targetType>
	<isAggro>false</isAggro>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<needInFront>false</needInFront>
	<mechanics>
		<cooldown>
			<duration>7000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</predicate>
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
				</predicates>
			</Item>
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
				<projectileData>
					<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
					<resource href="TatrgetProj.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
				</projectileData>
			</Item>
		</targetImpacts>
	</mechanics>
	<speed>20</speed>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>60</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
