<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<DelayTime>300</DelayTime>
			<ArrowThrowDuration>500</ArrowThrowDuration>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<visActionID>RapidFire</visActionID>
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionLoopAction">
				<visActionID>MeleeCombo</visActionID>
				<actionToLoop type="VisActionList">
					<visActionID />
					<play>Simultaneously</play>
					<playWhile />
					<elements>
						<Item type="CreatureAnimationAction">
							<visActionID />
							<mode>DIE</mode>
							<use>USE_CURRENT_ATTACK</use>
							<channel>CHANNEL_ABILITY</channel>
							<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
							<channelOverrideScript />
							<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
							<specialController />
							<advanced>
								<speed>0</speed>
								<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
								<offendType>NO_OFFEND</offendType>
								<animationKeysAction>
									<Item>
										<action type="VisActionList">
											<play>Simultaneously</play>
											<playWhile type="PredicateCreatureFlagAction">
												<flagName>MeleeComboFireDmg</flagName>
											</playWhile>
											<preconditional>true</preconditional>
											<elements>
												<Item type="CreatureTrailAction">
													<mainHandTrail href="/Spells/FX/InterfaceFX/TrailFire.(TrailTemplate).xdb" />
													<offHandTrail href="" />
													<creatureTrail href="" />
												</Item>
											</elements>
										</action>
									</Item>
								</animationKeysAction>
								<turnToTarget>BEFORE_ANIMATIONEND</turnToTarget>
							</advanced>
						</Item>
					</elements>
				</actionToLoop>
				<totalTime>0</totalTime>
				<repeat>0</repeat>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting />
	<actionBarComplite />
	<actionBarCancel type="VisActionStopAction">
		<stoppedActionID>MeleeCombo</stoppedActionID>
	</actionBarCancel>
	<precastType>PRECAST_DEFAULT</precastType>
	<launch />
	<playOnTargets>
		<specialAction />
	</playOnTargets>
</SpellVisScripts>
