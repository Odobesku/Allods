	</Header>
	<name href="PortalProjectile.(ProjectileResource).Name.txt" />
	<visObject href="/Spells/FX/Spells/DemonicPortal_smoll.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<altitude>2.7</altitude>
	<lifeLengthCap>30000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.Aura">
			<checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
			<affectGroup>Enemies</affectGroup>
			<radius>15</radius>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="Portal_PlaneBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</predicate>
						</Item>
					</predicates>
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Portal_ContextBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
			</impactsIn>
