<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownFire.(VisObjectTemplate).xdb" />
                        <lockScale>true</lockScale>
                        <scale>3</scale>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Red_R8.(VisObjectTemplate).xdb" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>300</delay>
                        <effectFx href="/Spells/FX/Mobs/GT_7Boss_FireBall_Hit.(VisObjectTemplate).xdb" />
                        <fixPoint>true</fixPoint>
                        <lockScale>true</lockScale>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>