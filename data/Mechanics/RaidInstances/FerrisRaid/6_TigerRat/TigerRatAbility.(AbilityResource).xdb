<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739900554</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
			</predicates>
			<effectsElse>
				<Item type="gameMechanics.elements.effects.EffectNoAggroChecks" />
			</effectsElse>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
											<value>1</value>
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
											<zone href="FightZone.(ScriptZone).xdb" />
										</Item>
									</predicates>
									<impactsElse>
										<Item type="gameMechanics.elements.impacts.ImpactTeleport">
											<destination type="gameMechanics.map.destination.DestinationLocatorSpread">
												<locator>
													<scriptID>FR_6_Entrance</scriptID>
													<map href="/Maps/FerrisRaid/MapResource.xdb" />
												</locator>
												<horizontalSpread>5</horizontalSpread>
											</destination>
											<finishImpacts>
												<Item type="gameMechanics.elements.abilities.ImpactClearTimeLapseHistory" />
											</finishImpacts>
										</Item>
									</impactsElse>
								</Item>
								<Item type="gameMechanics.elements.abilities.ImpactClearTimeLapseHistory" />
							</impacts>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>FR_6_Door_In</scriptID>
						<map href="/Maps/FerrisRaid/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Close</switchType>
						</Item>
					</impacts>
				</Item>
			</onEnter>
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
									<group href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>FR_6_Door_In</scriptID>
						<map href="/Maps/FerrisRaid/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Open</switchType>
						</Item>
					</impacts>
				</Item>
			</onLeave>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectsDeferred">
					<delay>8000</delay>
					<effects>
						<Item type="gameMechanics.elements.effects.EffectsIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
								</Item>
							</predicates>
							<effectsElse>
								<Item type="gameMechanics.elements.effects.ImpactsOverTime">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
													<impacts>
														<Item type="gameMechanics.elements.impacts.BuffDetacher">
															<buff href="Chase/TargetBuff.(BuffResource).xdb" />
														</Item>
													</impacts>
												</Item>
											</impacts>
										</Item>
									</impacts>
									<tick>30000</tick>
								</Item>
							</effectsElse>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.map.destination.SelfPosDestination" />
								</moveType>
								<resource href="Wave/WaveProjectile.(ProjectileResource).xdb" />
							</projectileData>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="Wave/WaveSpell.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
			<stages>
				<Item>Start</Item>
			</stages>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
							<addresseeFinder type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="JumpSeries/JumpTargetVisual.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="JumpSeries/JumpSpell.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
			<stages>
				<Item>Start</Item>
			</stages>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
					<impacts>
						<Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
							<variable href="TigerRat.(MapVariableResource).xdb" />
							<summand>1</summand>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
							<device>
								<scriptID>6_chest_hm</scriptID>
								<map href="/Maps/FerrisRaid/MapResource.xdb" />
							</device>
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
							<device>
								<scriptID>6_chest</scriptID>
								<map href="/Maps/FerrisRaid/MapResource.xdb" />
							</device>
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>FR_6_Door_Out_1</scriptID>
						<map href="/Maps/FerrisRaid/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Open</switchType>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>FR_6_Door_Out_2</scriptID>
						<map href="/Maps/FerrisRaid/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Open</switchType>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>FR_6_Door_In</scriptID>
						<map href="/Maps/FerrisRaid/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Open</switchType>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectMobStatQuality">
			<quality href="/Mechanics/RaidInstances/FerrisRaid/Other/Part2_Stats.(MobStatQuality).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
							<addresseeFinder type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="JumpSeries/JumpTargetVisual.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="Heed/HeedJump.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
			<stages>
				<Item>Start</Item>
			</stages>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
									<addresseeFinder type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="Chase/TargetBuff.(BuffResource).xdb" />
											<impactsOnAttach>
												<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
													<impacts>
														<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
															<impacts>
																<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
																	<predicates>
																		<Item type="gameMechanics.elements.resources.ResourceBuff">
																			<buff href="Chase/TargetBuff.(BuffResource).xdb" />
																		</Item>
																	</predicates>
																	<impactsElse>
																		<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																			<buff href="Unworthy.(BuffResource).xdb" />
																			<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
																				<multiplier>100</multiplier>
																			</durationScaler>
																		</Item>
																	</impactsElse>
																</Item>
															</impacts>
														</Item>
													</impacts>
												</Item>
											</impactsOnAttach>
											<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
												<multiplier>100</multiplier>
											</durationScaler>
										</Item>
										<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
											<impacts>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="Chase/BossReadyBuff.(BuffResource).xdb" />
													<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
														<multiplier>1.5</multiplier>
													</durationScaler>
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
									<addresseeFinder type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="Chase/TargetBuff.(BuffResource).xdb" />
											<impactsOnAttach>
												<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
													<impacts>
														<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
															<impacts>
																<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
																	<predicates>
																		<Item type="gameMechanics.elements.resources.ResourceBuff">
																			<buff href="Chase/TargetBuff.(BuffResource).xdb" />
																		</Item>
																	</predicates>
																	<impactsElse>
																		<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																			<buff href="Unworthy.(BuffResource).xdb" />
																		</Item>
																	</impactsElse>
																</Item>
															</impacts>
														</Item>
													</impacts>
												</Item>
											</impactsOnAttach>
										</Item>
										<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
											<impacts>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="Chase/BossReadyBuff.(BuffResource).xdb" />
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
							</impactsElse>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="Chase/ChaseSpell.(SpellArea).xdb" />
								<Item href="Chase/ChaseSpell1.(SpellArea).xdb" />
								<Item href="Chase/ChaseSpell2.(SpellArea).xdb" />
								<Item href="Chase/ChaseSpell3.(SpellArea).xdb" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
			<stages>
				<Item>Start</Item>
			</stages>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.SpellPrepareDurationModifier">
					<spell href="Chase/ChaseSpell.(SpellArea).xdb" />
					<factor>0.5</factor>
				</Item>
				<Item type="gameMechanics.elements.effects.SpellPrepareDurationModifier">
					<spell href="Chase/ChaseSpell1.(SpellArea).xdb" />
					<factor>0.5</factor>
				</Item>
				<Item type="gameMechanics.elements.effects.SpellPrepareDurationModifier">
					<spell href="Chase/ChaseSpell2.(SpellArea).xdb" />
					<factor>0.5</factor>
				</Item>
				<Item type="gameMechanics.elements.effects.SpellPrepareDurationModifier">
					<spell href="Chase/ChaseSpell3.(SpellArea).xdb" />
					<factor>0.5</factor>
				</Item>
			</effectsIf>
		</Item>
		<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>0.3</coeff>
			</scaler>
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
