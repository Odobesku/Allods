<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpellDirectedEngineer</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visActionID>tur</visActionID>
				<visualEffects>
					<Item>
						<effectFx href="/Creatures/EngineerGadgets/EngineerTurret/EngineerTurret.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations>
							<animations>
								<Item>special</Item>
								<Item>idle01</Item>
							</animations>
						</effectAnimations>
						<lockScale>true</lockScale>
						<locator>Slot_Global</locator>
						<member>Mount</member>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>2000</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>tur</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
