<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.CreatureSetFlagVisAction">
        <visualFlag href="/World/Quests/HuntingGround3/AO11_Town04/AO11_Town04_GuardAura.(VisualFlag).xdb#xpointer(/client.Replica.VisualFlag)" />
        <mainAvatarOnly>false</mainAvatarOnly>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.VisActionDelay">
            <time>3000</time>
          </Item>
          <Item type="client.SLON.WeatherCreatureVisAction">
            <params>
              <ambientSoundImpact>Nothing</ambientSoundImpact>
              <areaEffect href="/Maps/Umoir/ZoneLights/Night_Fly_Fluff.(AreaEffect).xdb#xpointer(/client.VisualConstructor.AreaEffect)" />
              <colorGradingSettings />
              <fadeTime>1</fadeTime>
              <light>
                <AmbientColor>-13610862</AmbientColor>
                <AmbientFactor>0.5</AmbientFactor>
                <ContourColor>-10503217</ContourColor>
                <DiffuseColor>-14402439</DiffuseColor>
                <FadeEnd>450</FadeEnd>
                <FadeStart>350</FadeStart>
                <FogColor>-16184553</FogColor>
                <FogEnd>200</FogEnd>
                <FogStart>30</FogStart>
                <GrassContourColorMultiplier>-1</GrassContourColorMultiplier>
                <PointLightColor>-678261</PointLightColor>
                <SelfIllumColor>-4468001</SelfIllumColor>
                <SpecularColor>-11241836</SpecularColor>
                <SpecularWaterColor>726023</SpecularWaterColor>
                <SunLightPitch>45</SunLightPitch>
                <SunLightYaw>45</SunLightYaw>
                <TerrainContourColor>-16380390</TerrainContourColor>
                <TerrainContourPower>3</TerrainContourPower>
                <TerrainSpecularColor>-11437684</TerrainSpecularColor>
                <WaterGradientEnd>-12694612</WaterGradientEnd>
                <WaterGradientStart>-14790840</WaterGradientStart>
                <desaturation>0</desaturation>
                <minAmbientOcclusionValue>0</minAmbientOcclusionValue>
                <objectsLightmapBias>0.0125</objectsLightmapBias>
                <terrainLightmapBias>0.01</terrainLightmapBias>
              </light>
              <postEffectParams href="/Maps/Umoir/ZoneLights/Umoir_Forest_Night.(PostEffectParams).xdb#xpointer(/client.VisualConstructor.PostEffectParams)" />
              <posteffectFogSettings>
                <brightness>1</brightness>
                <color>-1</color>
                <colorUp>-1</colorUp>
                <densityDown>0</densityDown>
                <densityUp>0</densityUp>
                <distanceSettings>
                  <falloff>0.5</falloff>
                  <maxDistance>400</maxDistance>
                  <minDistance>0</minDistance>
                </distanceSettings>
                <heightSettingsDown>
                  <falloff>0.5</falloff>
                  <maxDistance>50</maxDistance>
                  <minDistance>-50</minDistance>
                </heightSettingsDown>
                <heightSettingsUp>
                  <falloff>0.5</falloff>
                  <maxDistance>50</maxDistance>
                  <minDistance>-50</minDistance>
                </heightSettingsUp>
                <sunSettings>
                  <brightness>0.2</brightness>
                </sunSettings>
                <use>false</use>
              </posteffectFogSettings>
              <priority>LOW</priority>
              <skyMesh href="/World/Sky/Umoir_Forest_Night.(SkyMesh).xdb#xpointer(/client.VisualConstructor.SkyMesh)" />
              <hasLight>true</hasLight>
              <playInBuildings>false</playInBuildings>
            </params>
          </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>