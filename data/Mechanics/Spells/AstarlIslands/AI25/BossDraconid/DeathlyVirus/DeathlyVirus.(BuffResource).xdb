                                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                                                </Item>
                                                            </predicates>
                                                        </Item>
                                                    </filters>
                                                </filter>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impactsPerTick>
                    </parameters>
                    <element>DISEASE</element>
                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                    </scaler>
