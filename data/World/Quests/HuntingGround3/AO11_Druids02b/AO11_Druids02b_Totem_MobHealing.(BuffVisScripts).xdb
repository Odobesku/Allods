<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.CreatureEffectsAction">
        <category>EFFECT_DEFAULT</category>
        <visualEffects>
          <Item>
            <delay>0</delay>
            <effectAnimations>
              <mode>DIE</mode>
            </effectAnimations>
            <effectFx href="/Creatures/NotCreatures/TreantRoots/TreantRootsGround.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <fadeInTime>0</fadeInTime>
            <fadeOutTime>0</fadeOutTime>
            <scale>1</scale>
            <fixPoint>false</fixPoint>
            <lockScale>false</lockScale>
            <muteFxSounds>false</muteFxSounds>
            <ignoreParentRotation>true</ignoreParentRotation>
            <locator>Global</locator>
            <member>Default_Member</member>
            <offset x="0" y="0" z="0" />
            <rotation x="0" y="0" z="0" w="0" />
            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
          </Item>
        </visualEffects>
        <dontFade>false</dontFade>
        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
        <stopOnDeath>false</stopOnDeath>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <postAction type="client.SLON.CreatureIndependentFxAction">
    <lifeTime>1</lifeTime>
    <offset x="0" y="0" z="0" />
    <rotation x="0" y="0" z="0" />
    <scale>1</scale>
    <visEventPointIndex>-1</visEventPointIndex>
    <visObject href="/Spells/FX/Spells/Druid70_TreantDruidSummon.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
    <isRelative>true</isRelative>
    <useCastPoint>false</useCastPoint>
  </postAction>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>