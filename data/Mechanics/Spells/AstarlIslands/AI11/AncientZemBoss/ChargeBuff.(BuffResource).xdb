<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739870012</resourceId>
	</Header>
	<Name href="ChargeBuff.(BuffResource).Name.txt" />
	<image href="/Interface/Icons/Spells/Warrior/WarriorCharge.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visScript href="/Spells/VisScripts/Creatures/Rhino/Charge.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<nameTemplate href="ChargeBuff.(BuffResource)_Name.txt.template" />
	<effects>
		<Item type="gameMechanics.elements.effects.Charge">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ForceAggro" />
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
									<level>0.5</level>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Stan.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>4</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
							<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
							<minDamage>40</minDamage>
							<maxDamage>40</maxDamage>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
							<time>200</time>
							<distance>6</distance>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
									<mobs>
										<Item href="/Characters/Undead_male/Instances/AstralIsle11/ZemyGuardian.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									</mobs>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactKill" />
							</impactsIf>
						</Item>
					</impacts>
					<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									</Item>
									<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
										<mobs>
											<Item href="/Characters/Undead_male/Instances/AstralIsle11/ZemyGuardian.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
										</mobs>
									</Item>
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								</predicates>
							</Item>
						</predicates>
					</filter>
				</Item>
			</impacts>
			<buff href="ChargeBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			<speedFactor>3</speedFactor>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="LastPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.PostponedImpacts">
							<impacts>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.PreciseAura">
			<radius>2</radius>
			<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateOr">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
							<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
								<mobs>
									<Item href="/Characters/Undead_male/Instances/AstralIsle11/ZemyGuardian.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
								</mobs>
							</Item>
						</predicates>
					</Item>
				</predicates>
			</filter>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
					<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
					<minDamage>30</minDamage>
					<maxDamage>30</maxDamage>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
					<time>200</time>
					<distance>6</distance>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="/Characters/Undead_male/Instances/AstralIsle11/ZemyGuardian.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							</mobs>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactKill" />
					</impactsIf>
				</Item>
			</impactsIn>
		</Item>
	</effects>
	<duration>5000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
