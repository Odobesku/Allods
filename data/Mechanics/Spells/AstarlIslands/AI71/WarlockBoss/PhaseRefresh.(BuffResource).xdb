<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>188339</resourceId>
    </Header>
    <Name href="PhaseRefresh.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                            <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                <range min="0" max="1" />
                                <withinRange>false</withinRange>
                                <minCandidatesCount>2</minCandidatesCount>
                                <targetCount>2</targetCount>
                            </selector>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                        </predicates>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </filter>
                            <impacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                            <projectileData>
                                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                        <modifiers>
                                                            <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                                                        </modifiers>
                                                    </destination>
                                                </moveType>
                                                <resource href="PlaugePuddle.(ProjectileResource).xdb" />
                                            </projectileData>
                                            <pool href="/Mechanics/Spells/AstarlIslands/AI71/Common/AI71Pool.(SummonPool).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                                    <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
                                                </Item>
                                            </predicates>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/AstarlIslands/AI71/Common/PlagueCarrier/PlagueDOT.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <impactsNotSelected>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/AstarlIslands/AI71/Common/PlagueCarrier/PlagueDOT.(BuffResource).xdb" />
                                </Item>
                            </impactsNotSelected>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>10000</tick>
            <initialDelay>4000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
