<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>253150</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="/Mechanics/Spells/ItemMall/AvatarDonate/ArmorComplectSpell.(SpellSingleTarget).Name.txt" />
    <Description href="/Mechanics/Spells/ItemMall/AvatarDonate/ArmorComplectSpell.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb" />
    <prepareDuration>10000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/AvatarDonate65Unlock.(UnlockResource).xdb" />
                </predicate>
                <clientData href="/Mechanics/Spells/ItemMall/AvatarDonate/isAvatarDonate60ClientData.(ClientData).xdb" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.elements.predicates.PredicateCanTake">
                    <item href="/Items/QuestItems/Inst_GurluhsorTower/GT_key/GT_key.(ItemResource).xdb" />
                    <stackCount>3</stackCount>
                </predicate>
                <clientData href="/Mechanics/Spells/ItemMall/AvatarDonate/canTake3ItemsClientData.(ClientData).xdb" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/ReadInstructions65.(UnlockResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactDevelopRecommendedTalents" />
            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                <impactsResource href="/ItemMall/Services/AvatarDonate/GiveQuests.(ImpactListResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAddFairyExperience">
                <experience>22394</experience>
            </Item>
            <!-- <Item type="gameMechanics.elements.impacts.ImpactGiveItem"> -->
            <!-- <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider"> -->
            <!-- <item hrefvar="item" /> -->
            <!-- </item> -->
            <!-- <count>17</count> -->
            <!-- </Item> -->
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateUnlock">
                        <unlock href="/Mechanics/Unlocks/EpicIsle/Key.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </Item>
                </predicates>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                        <unlock href="/Mechanics/Unlocks/EpicIsle/Key.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </Item>
                </elseImpacts>
            </Item>
            <!-- Открываем астрал -->
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateUnlock">
                        <unlock href="/Mechanics/Unlocks/AltCurrencies/AstralKeys.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </Item>
                </predicates>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                        <unlock href="/Mechanics/Unlocks/AltCurrencies/AstralKeys.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </Item>
                </elseImpacts>
            </Item>
            <!-- Открываем рейд -->
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateUnlock">
                        <unlock href="/Mechanics/Unlocks/Quest/GT_EntranceUnlock/ArchBase_Entrance.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </Item>
                </predicates>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                        <unlock href="/Mechanics/Unlocks/Quest/GT_EntranceUnlock/ArchBase_Entrance.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateUnlock">
                        <unlock href="/Mechanics/Unlocks/SecondaryDressUnlock.xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </Item>
                </predicates>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                        <unlock href="/Mechanics/Unlocks/SecondaryDressUnlock.xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                <currency href="/Mechanics/AlternativeCurrencies/AstralTicket.(AlternativeCurrency).xdb" />
                <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>42</value>
                </sumCalcer>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateUnlock">
                        <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/ReadInstructions65.(UnlockResource).xdb" />
                    </Item>
                </predicates>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                        <unlock href="/Mechanics/Spells/ItemMall/AvatarDonate/ReadInstructions65.(UnlockResource).xdb" />
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>