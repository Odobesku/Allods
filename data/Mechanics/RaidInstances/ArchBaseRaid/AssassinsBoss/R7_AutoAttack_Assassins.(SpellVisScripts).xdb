<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>1000</time>
		</playWhile>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>attackCharge</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<animationKeysAction />
					<animationKeysSound />
					<animationKeysActionPeriod />
					<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
				</advanced>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Mobs/TripodPortal_TransformingRay_Head.(VisObjectTemplate).xdb" />
				<fxLength>1</fxLength>
				<startPoint type="VisPointLocator">
					<shift z="-0.8" />
					<locator>Slot_Hand_R</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Architect_Swarm_Split_Ground_Cast.(VisObjectTemplate).xdb" />
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>