<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>1200</delay>
						<effectFx href="/Spells/FX/Mobs/Gamayun_Fall.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Spine1</locatorName>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>1000</time>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>CLAMP</mode>
						<animations>
							<Item>special02</Item>
						</animations>
						<channelOverrideScript />
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>special01</Item>
						</animations>
						<channelOverrideScript />
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Mobs/Gamayun_Fall_End.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<scale>2</scale>
				<lifeTime>3</lifeTime>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
