<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739895486</resourceId>
	</Header>
	<Name href="DarkLight_Friend.(BuffResource).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.PostponedImpacts">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactHeal">
							<heal>17.13</heal>
							<scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
								<buff href="DarkLight_Friend.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								<anyRank>true</anyRank>
								<onlyFromMaster>true</onlyFromMaster>
								<mul>-0.2</mul>
								<sum>2</sum>
							</scalerTarget>
							<scalerCaster type="gameMechanics.constructor.basicElements.ScalerMultiple">
								<scalers>
									<Item type="gameMechanics.constructor.basicElements.ScalerMultiple">
										<scalers>
											<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="gameMechanics.elements.calcers.SpellRankCalcer">
													<spell href="DarkLight01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
													<mul>1</mul>
												</mulCalcer>
											</Item>
										</scalers>
									</Item>
									<Item type="gameMechanics.elements.scalers.HealScaler" />
								</scalers>
							</scalerCaster>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectJumpOnDetach">
			<jumps type="gameMechanics.elements.calcers.LongData">
				<value>5</value>
			</jumps>
			<buff href="DarkLight_Friend.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			<autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.FriendWithMinHPAutotarget">
				<filter>Raid</filter>
				<radius>6</radius>
				<allowFullHp>true</allowFullHp>
			</autotarget>
			<onBehalfOfCaster>true</onBehalfOfCaster>
			<radius>6</radius>
			<inCasterRange>false</inCasterRange>
			<keepTrack>false</keepTrack>
			<renewingEffects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOff>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="DarkLight.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
							<calcers>
								<addressEntries>
									<Item>
										<name>caster</name>
										<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
									</Item>
									<Item>
										<name>target</name>
										<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
									</Item>
								</addressEntries>
							</calcers>
						</Item>
					</impactsOff>
				</Item>
			</renewingEffects>
		</Item>
	</effects>
	<duration>75</duration>
	<stackLimit>6</stackLimit>
	<isHelpful>true</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<isClientReplicated>false</isClientReplicated>
	<groups>
		<Item href="/Mechanics/Spells/Groups/HealingSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
