<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureIndependentFxAction">
						<visObject href="CleaveRed_120_R10.(VisObjectTemplate).xdb" />
						<lifeTime>3</lifeTime>
					</Item>
					<Item type="CreatureLockRotationAction" />
				</elements>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readyUnarmed</Item>
				</animations>
				<channel>CHANNEL_TURNSPECIAL</channel>
			</Item>
			<Item type="VisActionList">
				<playWhile type="VisActionDelay">
					<time>3000</time>
				</playWhile>
				<elements>
					<Item type="CreatureEnchantWeaponAction">
						<enchant href="/Spells/FX/InterfaceFX/MeleeRed.(EnchantTemplate).xdb" />
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<precastType>PRECAST_NONE</precastType>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<channel>CHANNEL_TURNSPECIAL</channel>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureTrailAction">
						<mainHandTrail href="/Spells/FX/InterfaceFX/TrailCleave.(TrailTemplate).xdb" />
					</Item>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/WarriorCleaveAbility.(VisObjectTemplate).xdb" />
						<offset z="0.25" />
						<lifeTime>3</lifeTime>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<locator>Slot_FX</locator>
								<offendTime type="EffectOffendConstDelay" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
