            </scaler>
        </Item>
        <Item>
            <name>rt_radius</name>
            <value var="rt_radius" />
            <text href="/Mechanics/Ships/TextFragments/RepairRadius.txt" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>RatingFiveStars</formula>
            </scaler>
        </Item>
        <Item>
