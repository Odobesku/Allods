<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureChangeVisItemsAction">
				<items>
					<Item>
						<newItem href="/Items/VisualItems/Weapon/2HSword/Sword_2H_Longsword_B_01_R4.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						<slot>TWOHANDED</slot>
					</Item>
					<Item>
						<newItem href="/Items/VisualItems/Armor/Leather_D_57GladiatorSwordArmor.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						<slot>ARMOR</slot>
					</Item>
					<Item>
						<newItem href="/Items/VisualItems/Mantle/Shoulder_Leather_D_57GladiatorSword.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						<slot>MANTLE</slot>
					</Item>
					<Item>
						<newItem href="/Items/VisualItems/Helm/Helm_Leather_D_57GladiatorSword.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						<slot>HELM</slot>
					</Item>
				</items>
				<isGfxCondition>false</isGfxCondition>
				<leaveWeapons>false</leaveWeapons>
				<notForDolls>false</notForDolls>
				<removeAllItems>true</removeAllItems>
			</Item>
		</elements>
		<play>InSequence</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>