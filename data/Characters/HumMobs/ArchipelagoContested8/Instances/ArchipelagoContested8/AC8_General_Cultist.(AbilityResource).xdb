                            <data href="AC8_player_buff.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
