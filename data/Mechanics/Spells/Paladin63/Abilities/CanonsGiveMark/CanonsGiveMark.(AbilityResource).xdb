<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>206469</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="CanonsGiveMark.(AbilityResource).Name.txt" />
    <description href="CanonsGiveMark.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value>8.2</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>WeaponScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Paladin/PaladinPrayer.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="/Mechanics/Spells/Paladin63/Abilities/Canons/CanonGained.(MarkResource).xdb" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value var="value" />
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/Paladin63/Abilities/WrathGiveMark/AddPhysDamageMark.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
    <ranks>
        <Item href="CanonsGiveMark01.(AbilityResource).xdb" />
        <Item href="CanonsGiveMark02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>