<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.SLON.CreatureSetOvertipAction">
				<overtip href="/Interface/Ingame/ContextRelatedTextures/Emoticons/Surp.(UITexture).xdb#xpointer(/UITexture)" />
				<showOnMainAvatar>false</showOnMainAvatar>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<postAction type="client.Replica.VisActionList">
		<elements>
			<Item type="client.SLON.CreatureSetOvertipAction">
				<overtip href="/Interface/Ingame/ContextRelatedTextures/Emoticons/Biggreen.(UITexture).xdb#xpointer(/UITexture)" />
				<showOnMainAvatar>false</showOnMainAvatar>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<playWhile type="client.Replica.VisActionDelay">
			<time>5000</time>
		</playWhile>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</postAction>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>