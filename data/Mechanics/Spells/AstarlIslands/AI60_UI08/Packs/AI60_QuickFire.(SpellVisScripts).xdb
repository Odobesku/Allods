<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Spells/BattleStation_FireRay.(VisObjectTemplate).xdb" />
                <fxLength>14</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>Slot_Hand_R</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </endPoint>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb" />
                        <locator>Slot_Hand_L</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb" />
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
</SpellVisScripts>