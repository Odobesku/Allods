<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>readySpellDirected</PreCastAnimation>
			<CastAnimation>attack</CastAnimation>
			<FixPointCaster>false</FixPointCaster>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<FXOnCaster>/Spells/FX/Mobs/WormGlacial_SpellCastBodySlam.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<FxOnHands>/Spells/FX/Mobs/WormGlacial_ReadySpellBodySlam.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<FixPointTarget>false</FixPointTarget>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<lockScale>true</lockScale>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
