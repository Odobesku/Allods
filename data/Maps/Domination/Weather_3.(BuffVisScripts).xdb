<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="WeatherCreatureVisAction">
				<params>
					<skyMesh href="/World/Sky/AstralIsle_15_Night.(SkyMesh).xdb#xpointer(/SkyMesh)" />
					<light>
						<FogStart>-10</FogStart>
						<FogEnd>340</FogEnd>
						<AmbientColor>3482696</AmbientColor>
						<SelfIllumColor>2028626944</SelfIllumColor>
						<DiffuseColor>1450633</DiffuseColor>
						<PointLightColor>2021205760</PointLightColor>
						<FogColor>3093</FogColor>
						<SpecularColor>8421504</SpecularColor>
						<ContourColor>8421504</ContourColor>
						<WaterGradientStart>-16704991</WaterGradientStart>
						<WaterGradientEnd>-11374489</WaterGradientEnd>
						<TerrainSpecularColor>4254949</TerrainSpecularColor>
						<TerrainContourColor>131855</TerrainContourColor>
						<TerrainContourPower>4</TerrainContourPower>
					</light>
					<hasLight>true</hasLight>
					<ambientSoundImpact>Stop</ambientSoundImpact>
				</params>
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Music/Music.(FMODProject).xdb#xpointer(/FMODProject)" />
