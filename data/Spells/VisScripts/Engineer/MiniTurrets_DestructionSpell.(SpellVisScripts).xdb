<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<LocatorOnCaster>FROM_LOCATOR_NAME</LocatorOnCaster>
			<LocatorOnTargets>FROM_LOCATOR_NAME</LocatorOnTargets>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Engeneer_MiniTurrets_Destruction_Ready.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.2</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special01</locatorName>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/Engeneer_MiniTurrets_DestructionChannel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fxLength>10</fxLength>
				<startPoint type="VisPointLocator">
					<locator var="LocatorOnCaster" />
					<locatorName>Slot_Special01</locatorName>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator var="LocatorOnTargets" />
					<locatorName>Slot_Special01</locatorName>
				</endPoint>
				<fadeInTime>200</fadeInTime>
				<fadeOutTime>200</fadeOutTime>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>specialCast</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<advanced>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
