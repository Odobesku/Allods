<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureEffectsAction">
				<category>EFFECT_DEFAULT</category>
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectAlias href="" />
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<effectFx href="/Spells/FX/Spells/Warlock_Form_Chargen.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<scale>1.3</scale>
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<muteFxSounds>false</muteFxSounds>
						<ignoreParentRotation>false</ignoreParentRotation>
						<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
						<locator>Slot_Global</locator>
						<member>Default_Member</member>
						<offset x="0" y="0" z="0" />
						<rotation x="0" y="0" z="0" />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
				</visualEffects>
				<dontFade>false</dontFade>
				<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
				<stopOnDeath>false</stopOnDeath>
			</Item>
			<Item type="client.SLON.IfAction">
				<condition type="client.SLON.IfVisualMount">
					<mountsList>
						<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton.(VisualMount).xdb#xpointer(/VisualMount)" />
						<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton01Red.(VisualMount).xdb#xpointer(/VisualMount)" />
						<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton01Green.(VisualMount).xdb#xpointer(/VisualMount)" />
						<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton01Yellow.(VisualMount).xdb#xpointer(/VisualMount)" />
					</mountsList>
					<checkIsInTheList>true</checkIsInTheList>
					<checkOnStartOnly>true</checkOnStartOnly>
				</condition>
				<elseAction type="client.Replica.VisActionList">
					<elements>
						<Item type="client.Replica.VisActionList">
							<elements>
								<Item type="client.Replica.CreatureChangeVisItemsAction">
									<items>
										<Item>
											<newItem href="/Items/Costumes/VisItems/Set/Special/UnholyInquisitorSet_Dark.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
											<slot>LIFESTYLESUIT</slot>
										</Item>
									</items>
									<isGfxCondition>false</isGfxCondition>
									<leaveWeapons>true</leaveWeapons>
									<notForDolls>true</notForDolls>
									<removeAllItems>false</removeAllItems>
								</Item>
							</elements>
							<play>Simultaneously</play>
							<preconditional>false</preconditional>
							<restartOnVisualChange>true</restartOnVisualChange>
							<stopOnDeath>false</stopOnDeath>
							<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
						</Item>
						<Item type="client.Replica.VisActionList">
							<elements>
								<Item type="client.Replica.CreatureChangeVisItemsAction">
									<items>
										<Item>
											<newItem href="/Items/Costumes/VisItems/Back/Special/UnholyInquisitorBack_Dark.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
											<slot>LIFESTYLEBACK</slot>
										</Item>
									</items>
									<isGfxCondition>false</isGfxCondition>
									<leaveWeapons>true</leaveWeapons>
									<notForDolls>true</notForDolls>
									<removeAllItems>false</removeAllItems>
								</Item>
							</elements>
							<play>Simultaneously</play>
							<preconditional>false</preconditional>
							<restartOnVisualChange>true</restartOnVisualChange>
							<stopOnDeath>false</stopOnDeath>
							<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
						</Item>
						<Item type="client.Replica.VisActionList">
							<elements>
								<Item type="client.Replica.CreatureChangeVisItemsAction">
									<items>
										<Item>
											<newItem href="/Items/Costumes/VisItems/Shoulder/Special/UnholyInquisitorShoulder_Dark.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
											<slot>LIFESTYLESHOULDER</slot>
										</Item>
									</items>
									<isGfxCondition>false</isGfxCondition>
									<leaveWeapons>true</leaveWeapons>
									<notForDolls>true</notForDolls>
									<removeAllItems>false</removeAllItems>
								</Item>
							</elements>
							<play>Simultaneously</play>
							<preconditional>false</preconditional>
							<restartOnVisualChange>true</restartOnVisualChange>
							<stopOnDeath>false</stopOnDeath>
							<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
						</Item>
						<Item type="client.Replica.VisActionList">
							<elements>
								<Item type="client.Replica.CreatureChangeVisItemsAction">
									<items>
										<Item>
											<newItem href="/Items/Costumes/VisItems/Head/Special/UnholyInquisitorHead_Dark.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
											<slot>LIFESTYLEHEAD</slot>
										</Item>
									</items>
									<isGfxCondition>false</isGfxCondition>
									<leaveWeapons>true</leaveWeapons>
									<notForDolls>true</notForDolls>
									<removeAllItems>false</removeAllItems>
								</Item>
							</elements>
							<play>Simultaneously</play>
							<preconditional>false</preconditional>
							<restartOnVisualChange>true</restartOnVisualChange>
							<stopOnDeath>false</stopOnDeath>
							<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
						</Item>
					</elements>
					<play>InSequence</play>
					<preconditional>false</preconditional>
					<restartOnVisualChange>true</restartOnVisualChange>
					<stopOnDeath>false</stopOnDeath>
					<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
				</elseAction>
				<onBreak>
					<breakEnabled>false</breakEnabled>
				</onBreak>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>true</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<postAction type="client.Replica.CreatureEffectsAction">
		<category>EFFECT_DEFAULT</category>
		<visualEffects>
			<Item>
				<delay>0</delay>
				<effectAlias href="" />
				<effectAnimations>
					<mode>DIE</mode>
				</effectAnimations>
				<effectFx href="/Spells/FX/Spells/MEV6Base_Start.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fadeInTime>0</fadeInTime>
				<fadeOutTime>0</fadeOutTime>
				<scale>1.3</scale>
				<fixPoint>true</fixPoint>
				<lockScale>false</lockScale>
				<muteFxSounds>false</muteFxSounds>
				<ignoreParentRotation>false</ignoreParentRotation>
				<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
				<locator>Slot_TopFX</locator>
				<member>Default_Member</member>
				<offset x="0" y="0" z="0.09999999" />
				<rotation x="0" y="0" z="0" />
				<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
			</Item>
		</visualEffects>
		<dontFade>false</dontFade>
		<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
		<stopOnDeath>true</stopOnDeath>
	</postAction>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>