<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>310533</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="WW_10_9.xdb" />
            <counterId href="/Creatures/ArchitectBot/Instances/ZC12_Map02/WW_10_9_Architect_bot.(MobWorld).xdb" />
            <condition type="constructor.elements.LongEquals">
                <value>3</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>3000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="ArchitectTrip.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                                            <impact type="gameMechanics.elements.impacts.ImpactSummon">
                                                <destination type="gameMechanics.map.destination.DestinationModified">
                                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                    <modifiers>
                                                        <Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
                                                            <alternatives>
                                                                <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                                    <radius type="gameMechanics.elements.calcers.FloatData">
                                                                        <value>25</value>
                                                                    </radius>
                                                                </Item>
                                                            </alternatives>
                                                        </Item>
                                                    </modifiers>
                                                </destination>
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                        <delay>300000</delay>
                                                        <impacts>
                                                            <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                                        </impacts>
                                                    </Item>
                                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                        <buff href="/World/Quests/ZC12/WW_1_8/Arc_plane.(BuffResource).xdb" />
                                                    </Item>
                                                </impacts>
                                                <object href="/Creatures/ArchitectMele/Instances/ZC12_Map02/WW_10_9_Architect_melee.(MobWorld).xdb" />
                                                <pool href="TripPool.(SummonPool).xdb" />
                                                <isPersonalPool>true</isPersonalPool>
                                            </impact>
                                            <count type="gameMechanics.elements.calcers.FloatData">
                                                <value>2</value>
                                            </count>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                    <data href="Heal.(ClientData).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="WW_10_9.xdb" />
            <counterId href="/Creatures/ArchitectBot/Instances/ZC12_Map02/WW_10_9_Architect_bot.(MobWorld).xdb" />
            <condition type="constructor.elements.LongEquals">
                <value>5</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>3000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="ArchitectTrip.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                            <destination type="gameMechanics.map.destination.DestinationModified">
                                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                <modifiers>
                                                    <Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
                                                        <alternatives>
                                                            <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                                <radius type="gameMechanics.elements.calcers.FloatData">
                                                                    <value>25</value>
                                                                </radius>
                                                            </Item>
                                                        </alternatives>
                                                    </Item>
                                                </modifiers>
                                            </destination>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                    <delay>300000</delay>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                                    </impacts>
                                                </Item>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/World/Quests/ZC12/WW_1_8/Arc_plane.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <object href="/Creatures/ArchitectSiege/Instances/ZC12_Map02/WW_10_9_Architect_siege.(MobWorld).xdb" />
                                            <pool href="TripPool.(SummonPool).xdb" />
                                            <isPersonalPool>true</isPersonalPool>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                    <data href="Heal.(ClientData).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                <quest href="WW_10_9.xdb" />
                                <counterResource href="Counter2.(QuestCountId).xdb" />
                            </predicate>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                            <quest href="WW_10_9.xdb" />
                            <counterResource href="Counter1.(QuestCountId).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="Counter1.(QuestCountId).xdb" />
                            <value>-1</value>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>