<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>488432</resourceId>
        <Prototype href="/Items/InteractiveObjects/Templates/Exploit.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <image href="/Interface/Icons/Misc/Food/EggBird.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="/Items/InteractiveObjects/Templates/Gather.(ExploitVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <isExploit>true</isExploit>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>3</value>
    </range>
    <prepareDuration>3000</prepareDuration>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Everyone</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="/World/Quests/ElementalPlateu/Snow/Bird_Egg.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <status>Started</status>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                            <value>0.4</value>
                        </chanceCalcer>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                    <item href="/Items/QuestItems/ElementalPlateu/Snow/Snow_Egg.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                </item>
                            </Item>
                        </impacts>
                        <impactsLose>
                            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                    <base type="gameMechanics.map.destination.SelfPosDestination" />
                                    <offset>6</offset>
                                </destination>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Items/InteractiveObjects/ElementalPlateu/FishNet/Suicide_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impacts>
                                <object href="/Creatures/Harpy/Instances/ElementalPlateu/Harpy_EP.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                <data href="/World/Quests/ElementalPlateu/Snow/Harpy_Data.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                <impactsResource href="/Mechanics/Mounts/Prototypes/ExoAntiDismount.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                            </Item>
                        </impactsLose>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.device.DeviceDie" />
            <Item type="gameMechanics.elements.device.DeviceOpenLootBag" />
        </targetImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>