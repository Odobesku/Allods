<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739965965</resourceId>
    </Header>
    <name href="RD_Elemental_Boss3_BombExplosion.(ProjectileResource).Name.txt" />
    <visObject href="RD_Elemental_Boss3_BombExplosion.(VisObjectTemplate).xdb" />
    <altitude>0.4</altitude>
    <lifeLengthCap>2000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <radius>4</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>FIRE</element>
                            <damage>1</damage>
                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                    <Item type="gameMechanics.elements.scalers.ScalerIf">
                                        <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                            <quality href="/Mechanics/MobQualities/Elite.xdb" />
                                        </condition>
                                        <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
                                            </mulCalcer>
                                        </scalerIf>
                                        <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                            <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                                <quality href="/Mechanics/MobQualities/Boss.xdb" />
                                            </condition>
                                            <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageElite.(CalcerFloatResource).xdb" />
                                                </mulCalcer>
                                            </scalerIf>
                                            <scalerElse type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageBoss.(CalcerFloatResource).xdb" />
                                                </mulCalcer>
                                            </scalerElse>
                                        </scalerElse>
                                    </Item>
                                </scalers>
                            </scaler>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                            <time>700</time>
                            <impactsOnLand>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>2</multiplier>
                                    </durationScaler>
                                </Item>
                            </impactsOnLand>
                            <distance>6</distance>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>