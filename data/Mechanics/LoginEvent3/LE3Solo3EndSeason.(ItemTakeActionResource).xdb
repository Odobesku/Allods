<?xml version="1.0" encoding="UTF-8"?>
<itemService.avatar.itemBag.ItemTakeActionResource>
	<Header>
		<resourceId>739967505</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<actions>
		<Item type="itemService.elements.components.ItemTakeActionImpacts">
			<impacts>
				<Item type="gameMechanics.elements.impacts.RepeatedImpactStack">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
									<lhs type="itemService.serverVariables.CalcerServerVariable">
										<variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
									</lhs>
									<rhs type="gameMechanics.elements.calcers.LongData">
										<value var="Season" />
									</rhs>
								</Item>
								<Item type="gameMechanics.constructor.basicElements.PredicateExternal">
									<predicateResource hrefvar="gs1" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
									<id href="LE3SoloQuest03.(QuestCountId).xdb" />
								</Item>
							</impactsIf>
							<impactsElse />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</actions>
</itemService.avatar.itemBag.ItemTakeActionResource>