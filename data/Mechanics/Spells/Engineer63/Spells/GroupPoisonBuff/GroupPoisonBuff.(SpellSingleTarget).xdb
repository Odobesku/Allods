<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739932784</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
	</groups>
	<element>ACID</element>
	<Name href="GroupPoisonBuff.(SpellSingleTarget).Name.txt" />
	<Description href="GroupPoisonBuff.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="multiplier" />
		</Item>
		<Item>
			<name>dmg</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>MagicScaler</formula>
					</Item>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Modifiers/ThePoisonousCloud.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Engineer/GroupPoisonBuff.(SpellVisScripts).xdb" />
	<targetType>STTSelf</targetType>
	<isAggro>false</isAggro>
	<ranks>
		<Item href="GroupPoisonBuff01.(SpellSingleTarget).xdb" />
		<Item href="GroupPoisonBuff02.(SpellSingleTarget).xdb" />
		<Item href="GroupPoisonBuff03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<cooldown>
			<duration var="duration" />
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIsolator">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
						<radius>40</radius>
						<affectPets>false</affectPets>
						<impacts>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff hrefvar="buff" />
								<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
									<multiplier var="multiplier" />
								</durationScaler>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.PostponedImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
								<group href="/Mechanics/Spells/Groups/EngineerCommonBuffTrigger.(ActionGroup).xdb" />
							</Item>
						</impacts>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
	</mechanics>
	<isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
