<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>317061</resourceId>
    </Header>
    <Name href="HeartStoneShard.(SpellSingleTarget).Name.txt" />
    <Description href="HeartStoneShard.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Bosses/TZ_1Boss/Teleportation.xdb" />
    <prepareDuration>10000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInZone">
                    <zone href="/Maps/Inst_ZoneContested12_Start/Zones/Inst_ZoneContested12_Start/Inst_ZoneContested12_Start.(ZoneResource).xdb" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                        <quest href="WW_Prologue_3_E.xdb" />
                        <status>Active</status>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                        <quest href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_3_L/WW_Prologue_3_L.xdb" />
                        <status>Active</status>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                <destination type="gameMechanics.map.destination.DestinationLocator">
                    <locator>
                        <scriptID>Inst_ZC12_start</scriptID>
                        <map href="/Maps/Inst_ZoneContested12_Start/MapResource.xdb" />
                    </locator>
                </destination>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateFaction">
                        <faction href="/World/Factions/Empire.xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                            <quest href="WW_Prologue_3_E.xdb" />
                            <counterResource href="Counter1.(QuestCountId).xdb" />
                        </predicate>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                        <id href="Counter1.(QuestCountId).xdb" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                    <quest href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_3_L/WW_Prologue_3_L.xdb" />
                                    <counterResource href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_3_L/Counter1.(QuestCountId).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                <id href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_3_L/Counter1.(QuestCountId).xdb" />
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>