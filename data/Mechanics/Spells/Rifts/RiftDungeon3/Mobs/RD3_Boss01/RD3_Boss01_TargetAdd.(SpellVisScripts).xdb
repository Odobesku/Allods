<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/CannonArchitect_Target.(VisObjectTemplate).xdb" />
                        <lockScale>true</lockScale>
                        <locator>Slot_TopFX</locator>
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Ice.(VisObjectTemplate).xdb" />
                        <lockScale>true</lockScale>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>ready</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/CannonArchitect_RaedySpell.(VisObjectTemplate).xdb" />
                        <locator>Slot_Head</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="CreatureVisActionStartThrow" />
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Mobs/ArchitectMinibossCombo_Projectile_01.(VisObjectTemplate).xdb" />
                <explosionFx href="/Spells/FX/Mobs/Architect_Explosion_R5.(VisObjectTemplate).xdb" />
                <theGe>6</theGe>
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_Head</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator" />
            </Item>
        </elements>
    </launch>
</SpellVisScripts>