<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>197264</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
    </groups>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Spell00.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/StalkerBallsOfSteel.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Stalker/BallsOfSteel_70.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <targetType>STTPoint</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Spell01.(SpellArea).xdb" />
        <Item href="Spell02.(SpellArea).xdb" />
        <Item href="Spell03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration var="cooldown" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Stalker63/Abilities/MaterielResource/MaterielResource.(VariableResource).xdb" />
                <sub>5</sub>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    </moveType>
                    <resource href="Balls.(ProjectileResource).xdb" />
                </projectileData>
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>10</speed>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>7</radius>
    <stopOnNoTargets>false</stopOnNoTargets>
</gameMechanics.constructor.schemes.spell.area.SpellArea>