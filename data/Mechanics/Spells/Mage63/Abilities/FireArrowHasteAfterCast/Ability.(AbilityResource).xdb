<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739921971</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>perc</name>
			<value var="value" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Psionic/PsionicMindFire.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
			<mark href="Mark.(MarkResource).xdb" />
			<impacts>
				<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
					<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
						<value var="value" />
					</chanceCalcer>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Mechanics/Spells/Mage63/Abilities/IcyRayHasteAfterCast/SpeedCast.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/Mage63/Abilities/IcyRayHasteAfterCast/SpeedCast.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.SpellCastTrigger">
					<conditionalImpacts>
						<Item>
							<impacts>
								<Item type="gameMechanics.elements.impacts.PostponedImpacts">
									<impacts>
										<Item type="gameMechanics.elements.impacts.StackBuff">
											<buff href="/Mechanics/Spells/Mage63/Abilities/IcyRayHasteAfterCast/SpeedCast.(BuffResource).xdb" />
											<delta type="gameMechanics.elements.calcers.FloatData">
												<value>-3</value>
											</delta>
										</Item>
									</impacts>
								</Item>
							</impacts>
							<conditions>
								<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
									<spells>
										<Item href="/Mechanics/Spells/Mage63/Spells/FireBall/Spell01.(SpellArea).xdb" />
									</spells>
								</Item>
							</conditions>
						</Item>
					</conditionalImpacts>
					<stages>
						<Item>Launch</Item>
					</stages>
				</Item>
				<Item type="gameMechanics.elements.effects.EffectModifySpellCastTime">
					<group href="/Mechanics/Spells/Groups/MageFireballSpeedcast.(ActionGroup).xdb" />
					<factor>-0.334</factor>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
