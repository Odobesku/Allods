<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>474021</resourceId>
    </Header>
    <Name href="NayanArtefact.(SpellSingleTarget).Name.txt" />
    <visualScripts href="IllusionMaker_Charged.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>4000</prepareDuration>
    <targetType>STTSelf</targetType>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="/World/Quests/UmoirIsland04/UI04_Q03/UI04_Q03_03.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <status>Active</status>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                <zone href="/Maps/UmoirIsland04/ScriptZones/NT_TM_Floor.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
            </Item>
        </casterConditions>
        <channelingMechanics>
            <channelingBuff href="NayanArtefact.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            <finishImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>tm_transit_back</scriptID>
                            <map href="/Maps/UmoirIsland04/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </locator>
                    </destination>
                </Item>
            </finishImpacts>
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                        <device>
                            <scriptID>TimeMachineTower</scriptID>
                            <map href="/Maps/UmoirIsland04/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </device>
                    </Item>
                </impactsOn>
                <impactsOff>
                    <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                        <spawn>
                            <scriptID>TimeMachineTower</scriptID>
                            <map href="/Maps/UmoirIsland04/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </spawn>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="/Items/InteractiveObjects/UmoirIsland04/TeleportWhiteFade.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsOff>
            </Item>
            <Item type="gameMechanics.elements.effects.EffectsDeferred">
                <delay>2000</delay>
                <effects>
                    <Item type="gameMechanics.elements.effects.Switch">
                        <impactsOn>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Items/InteractiveObjects/UmoirIsland04/TeleportWhiteFade.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsOn>
                    </Item>
                </effects>
            </Item>
        </casterChannelingEffects>
    </mechanics>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>