<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionList">
			<elements>
				<Item type="VisActionDelay">
					<time>1000</time>
				</Item>
				<Item type="VisActionChangeVisObject">
					<newVisMob href="/Characters/Hadagan_male/E1_Hadagan_Oficer_1.(VisualMob).xdb#xpointer(/VisualMob)" />
					<getDress>false</getDress>
				</Item>
				<Item type="CreatureChangeVisItemsAction">
					<items>
						<Item>
							<slot>GLOVES</slot>
							<newItem href="/Items/VisualItems/Gloves/Cloth_C_01HadaganMilitaryGloves.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						</Item>
						<Item>
							<slot>BELT</slot>
							<newItem href="/Items/VisualItems/Belt/Cloth_C_01HadaganMilitaryBelt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						</Item>
						<Item>
							<slot>SHIRT</slot>
							<newItem href="/Items/VisualItems/Shirt/Cloth_A_05WhiteShirt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						</Item>
						<Item>
							<slot>HELM</slot>
							<newItem href="/Items/VisualItems/Helm/Helm_Cloth_C_01HadaganMilitary.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						</Item>
						<Item>
							<slot>MANTLE</slot>
							<newItem href="/Items/VisualItems/Mantle/Shoulder_Cloth_C_01HadaganMilitary.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						</Item>
						<Item>
							<slot>ARMOR</slot>
							<newItem href="/Items/VisualItems/Armor/Cloth_C_01HadaganMilitaryArmor.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						</Item>
						<Item>
							<slot>BOOTS</slot>
							<newItem href="/Items/VisualItems/Boots/Cloth_C_01HadaganMilitaryBoots.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						</Item>
						<Item>
							<slot>PANTS</slot>
							<newItem href="/Items/VisualItems/Pants/Cloth_C_01HadaganMilitaryPants.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						</Item>
					</items>
				</Item>
			</elements>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/CreaturesTransform.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
	</action>
	<postAction type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/CreaturesTransform.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
			</Item>
		</visualEffects>
	</postAction>
</BuffVisScripts>
