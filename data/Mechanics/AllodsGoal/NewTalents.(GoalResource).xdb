<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.elements.goals.GoalResource>
    <Header>
        <resourceId>261436</resourceId>
    </Header>
    <title href="NewTalents.(GoalResource).Title.txt" />
    <description href="NewTalents.(GoalResource).Description.txt" />
    <shortDescription href="NewTalents.(GoalResource).ShortDescription.txt" />
    <finishPredicates>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateGreater">
                    <lhs type="gameMechanics.elements.calcers.FloatData">
                        <value>1</value>
                    </lhs>
                    <rhs type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
                        <currency href="/Mechanics/AlternativeCurrencies/TalentPoint.xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                    </rhs>
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                    <minLevel type="gameMechanics.formulas.MaxLevelConstant" />
                </Item>
            </predicates>
        </Item>
    </finishPredicates>
    <targetLevel>4</targetLevel>
</gameMechanics.elements.goals.GoalResource>