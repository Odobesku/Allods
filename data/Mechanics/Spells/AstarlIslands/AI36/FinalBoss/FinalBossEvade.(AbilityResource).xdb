                <Item type="gameMechanics.elements.impacts.ImpactMobMorph">
                    <newMobWorld href="/Creatures/Banshee/Instances/AstralIsle36/AI36_FinalBoss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
