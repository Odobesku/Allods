<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739933562</resourceId>
    </Header>
    <Name href="SharePain_00.(SpellSingleTarget).Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateDistance">
                            <range min="0" max="40" />
                        </predicate>
                    </predicate>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="SharePain_00.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="CountBuff.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ConditionalDamageSuppressor">
            <damageCondition type="constructor.elements.FloatGreaterOrEquals">
                <value type="gameMechanics.elements.calcers.FullHealthCalcer">
                    <multiplier>0.05</multiplier>
                </value>
            </damageCondition>
            <damagePredicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                        <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                        </Item>
                    </predicates>
                </Item>
            </damagePredicates>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.PureDamage">
                            <damage>1</damage>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.StackBuff">
                            <buff href="SharePain_00.(BuffResource).xdb" />
                            <resetTimer>false</resetTimer>
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>-1</value>
                            </delta>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                <onSlave type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="SharePain_00.(BuffResource).xdb" />
                                        <consumeStacks>1</consumeStacks>
                                    </predicate>
                                </onSlave>
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="CountBuff.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <scaleImpactsByDamage>true</scaleImpactsByDamage>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>