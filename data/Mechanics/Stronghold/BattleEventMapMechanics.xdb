<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.battleground.BattleEventMapMechanics>
    <Header>
        <resourceId>739826509</resourceId>
    </Header>
    <mechanicsType>SUMMERBOSS</mechanicsType>
    <map href="/Maps/PlayerIsle_Dungeon/Pillage_MapResource.xdb#xpointer(/mapLoader.MapResource)"/>
    <winCounter>1</winCounter>
    <duration>
        <hour>1</hour>
    </duration>
    <prepareTime>
        <minute>1</minute>
    </prepareTime>
    <assignWinnerOnDraw>false</assignWinnerOnDraw>
    <impactsOnEarlyExit>
        <Item type="itemService.avatar.stronghold.ResetUnlockedCategory"/>
    </impactsOnEarlyExit>
    <impactsOnWinners>
        <Item type="itemService.avatar.stronghold.IncreaseUnlockedCategory"/>
    </impactsOnWinners>
    <impactsOnLosers>
        <Item type="itemService.avatar.stronghold.ResetUnlockedCategory"/>
    </impactsOnLosers>
    <entrances>
        <Item>
            <mark href="Pillagers.xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)"/>
            <entrances>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>start</scriptID>
                        <map href="/Maps/PlayerIsle_Dungeon/Pillage_MapResource.xdb#xpointer(/mapLoader.MapResource)"/>
                    </pointer>
                </Item>
            </entrances>
        </Item>
    </entrances>
    <achievements>
        <Item>
            <resource href="BossCounter.xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)"/>
            <count>1</count>
            <finalWeight>1</finalWeight>
        </Item>
        <Item>
            <resource href="MobsWeight.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)"/>
        </Item>
    </achievements>
</gameMechanics.battleground.BattleEventMapMechanics>
