                    <rhs type="gameMechanics.elements.calcers.FloatData">
                        <value>9</value>
                    </rhs>
                </Item>
            </predicates>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
