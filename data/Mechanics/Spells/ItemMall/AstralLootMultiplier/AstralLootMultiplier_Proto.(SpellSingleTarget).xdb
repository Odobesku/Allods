<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>211656</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <element>ASTRAL</element>
    <Name href="AstralLootMultiplier_Proto.(SpellSingleTarget).Name.txt" />
    <Description hrefvar="Description" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                    <buff hrefvar="SelfBuff" />
                    <range>
                        <min var="MinRangeInt" />
                        <max var="MaxRangeInt" />
                    </range>
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                    <groups>
                        <Item href="MultiplierBlocker.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                    </groups>
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceAltCurrency">
                                <currency href="/Mechanics/AlternativeCurrencies/AstralTicket.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                                <count var="AstralTicketCount" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateGreater">
                                <lhs type="gameMechanics.elements.calcers.ItemsCalcer">
                                    <item hrefvar="ActiveItem" />
                                </lhs>
                                <rhs type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                    <buff hrefvar="SelfBuff" />
                                </rhs>
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceItem">
                            <item hrefvar="ActiveItem" />
                        </predicate>
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff hrefvar="AnotherBuff1" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff hrefvar="AnotherBuff2" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff hrefvar="AnotherBuff3" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff hrefvar="AnotherBuff4" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Buff_01_FreeKeys.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff hrefvar="SelfBuff" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSaveAvatar" />
        </casterImpacts>
    </mechanics>
    <speed>50</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>