<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellOmni</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AstralToxin.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.4</scale>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AstralToxin.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.4</scale>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>150</delay>
                        <effectFx href="/Spells/FX/Mobs/AstralShadow_ToInvise.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>1.5</scale>
                        <offset z="0.5" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>