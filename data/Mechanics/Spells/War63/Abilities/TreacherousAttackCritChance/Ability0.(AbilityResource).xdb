<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739921560</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability0.(AbilityResource).Name.txt" />
	<description href="Ability0.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="chance" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Equipment/Sword/SwordDivineRapier.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.SpellsModifier">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
					<spells>
						<Item href="/Mechanics/Spells/War63/Spells/TreacherousAttack/Spell01.(SpellSingleTarget).xdb" />
						<Item href="/Mechanics/Spells/War63/Spells/TreacherousAttack/Spell02.(SpellSingleTarget).xdb" />
						<Item href="/Mechanics/Spells/War63/Spells/TreacherousAttack/Spell03.(SpellSingleTarget).xdb" />
					</spells>
				</Item>
			</predicates>
			<modifiers>
				<Item type="gameMechanics.elements.spell.SpellEnvelopeTargetModifier">
					<effects>
						<Item type="gameMechanics.elements.effects.EffectsIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
									<groups>
										<Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
										<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
										<Item href="/Mechanics/Spells/Groups/DisableMovement.(ActionGroup).xdb" />
									</groups>
								</Item>
							</predicates>
							<effectsIf>
								<Item type="gameMechanics.elements.effects.IncomingCritProbabilitySummand">
									<summand type="gameMechanics.elements.calcers.FloatData">
										<value var="chance" />
									</summand>
								</Item>
							</effectsIf>
							<effectsElse>
								<Item type="gameMechanics.elements.effects.EffectsIfCaster">
									<predicates>
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
										</Item>
									</predicates>
									<effectsIf>
										<Item type="gameMechanics.elements.effects.IncomingCritProbabilitySummand">
											<summand type="gameMechanics.elements.calcers.FloatData">
												<value var="chance" />
											</summand>
										</Item>
									</effectsIf>
								</Item>
							</effectsElse>
						</Item>
					</effects>
					<onBehalfOfHolder>true</onBehalfOfHolder>
				</Item>
			</modifiers>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
