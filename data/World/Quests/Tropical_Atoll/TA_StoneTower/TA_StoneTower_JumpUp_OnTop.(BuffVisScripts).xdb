<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<visActionID>script</visActionID>
		<elements>
			<Item type="client.SLON.IfAction">
				<condition type="client.SLON.IfCreatureVisCharacter">
					<visCharList>
						<Item href="/Characters/Giberling_Group/GiberlingGroup.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
					</visCharList>
					<checkIsInTheList>true</checkIsInTheList>
					<checkOnStartOnly>true</checkOnStartOnly>
				</condition>
				<elseAction type="client.Replica.CreatureAttachSelfAction">
					<attachTo>Caster</attachTo>
					<locatorName>Slot_TopFX</locatorName>
					<playAttachTo type="client.Replica.VisActionList">
						<elements>
							<Item type="client.Replica.VisActionDelay">
								<time>1000</time>
							</Item>
							<Item type="client.Replica.CreatureEffectsAction">
								<category>EFFECT_DEFAULT</category>
								<visualEffects>
									<Item>
										<delay>0</delay>
										<effectAnimations>
											<mode>DIE</mode>
										</effectAnimations>
										<effectFx href="/Spells/FX/World/WaterBubble.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<fadeInTime>0</fadeInTime>
										<fadeOutTime>0</fadeOutTime>
										<scale>1.8</scale>
										<fixPoint>false</fixPoint>
										<lockScale>false</lockScale>
										<muteFxSounds>false</muteFxSounds>
										<ignoreParentRotation>false</ignoreParentRotation>
										<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
										<locator>Slot_TopFX</locator>
										<member>Default_Member</member>
										<offset x="0" y="0" z="1.5" />
										<rotation x="0" y="0" z="0" />
										<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
									</Item>
								</visualEffects>
								<dontFade>false</dontFade>
								<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
								<stopOnDeath>false</stopOnDeath>
							</Item>
						</elements>
						<play>InSequence</play>
						<preconditional>false</preconditional>
						<restartOnVisualChange>false</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
					</playAttachTo>
					<playOnSelf type="client.Replica.VisActionList">
						<elements>
							<Item type="client.Replica.CreatureDisableSpecialIdlesAction" />
							<Item type="client.SLON.CreatureDisableEmotesAction" />
							<Item type="client.Replica.CreatureAnimationAction">
								<advanced>
									<autoHasten>
										<mode>AUTOHASTEN_NONE</mode>
										<timeToBeLeft>0</timeToBeLeft>
									</autoHasten>
									<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
									<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
									<offendType>NO_OFFEND</offendType>
									<speed>0</speed>
									<turnToTarget>TURN_DEFAULT</turnToTarget>
									<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
									<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
									<denyAutoHasten>false</denyAutoHasten>
									<disableRandomFirstFrame>true</disableRandomFirstFrame>
									<eventPlaybackEnd>false</eventPlaybackEnd>
									<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
									<stopIfMoved>false</stopIfMoved>
									<stopIfRotated>false</stopIfRotated>
								</advanced>
								<animations>
									<Item>jumpEnd</Item>
									<Item>specialSitGround</Item>
								</animations>
								<channel>CHANNEL_DEFAULT</channel>
								<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
								<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
								<mode>LOOP</mode>
								<use>USE_ANIMATIONS</use>
								<dontFreezePrecast>false</dontFreezePrecast>
							</Item>
						</elements>
						<play>Simultaneously</play>
						<preconditional>false</preconditional>
						<restartOnVisualChange>false</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
					</playOnSelf>
					<notifyCamera>false</notifyCamera>
				</elseAction>
				<onBreak>
					<breakEnabled>false</breakEnabled>
				</onBreak>
				<thenAction type="client.Replica.CreatureAttachSelfAction">
					<attachTo>Caster</attachTo>
					<locatorName>Slot_Special11</locatorName>
					<memberLocatorName>
						<Item>Slot_Special12</Item>
						<Item>Slot_Special13</Item>
					</memberLocatorName>
					<playAttachTo type="client.Replica.VisActionList">
						<elements>
							<Item type="client.Replica.VisActionDelay">
								<time>1000</time>
							</Item>
							<Item type="client.Replica.CreatureEffectsAction">
								<category>EFFECT_DEFAULT</category>
								<visualEffects>
									<Item>
										<delay>0</delay>
										<effectAnimations>
											<mode>DIE</mode>
										</effectAnimations>
										<effectFx href="/Spells/FX/World/WaterBubble.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<fadeInTime>0</fadeInTime>
										<fadeOutTime>0</fadeOutTime>
										<scale>1.8</scale>
										<fixPoint>false</fixPoint>
										<lockScale>false</lockScale>
										<muteFxSounds>false</muteFxSounds>
										<ignoreParentRotation>false</ignoreParentRotation>
										<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
										<locator>Slot_TopFX</locator>
										<member>Default_Member</member>
										<offset x="0" y="0" z="1.5" />
										<rotation x="0" y="0" z="0" />
										<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
									</Item>
								</visualEffects>
								<dontFade>false</dontFade>
								<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
								<stopOnDeath>false</stopOnDeath>
							</Item>
						</elements>
						<play>InSequence</play>
						<preconditional>false</preconditional>
						<restartOnVisualChange>false</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
					</playAttachTo>
					<playOnSelf type="client.Replica.VisActionList">
						<elements>
							<Item type="client.Replica.CreatureDisableSpecialIdlesAction" />
							<Item type="client.SLON.CreatureDisableEmotesAction" />
							<Item type="client.Replica.CreatureAnimationAction">
								<advanced>
									<autoHasten>
										<mode>AUTOHASTEN_NONE</mode>
										<timeToBeLeft>0</timeToBeLeft>
									</autoHasten>
									<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
									<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
									<offendType>NO_OFFEND</offendType>
									<speed>0</speed>
									<turnToTarget>TURN_DEFAULT</turnToTarget>
									<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
									<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
									<denyAutoHasten>false</denyAutoHasten>
									<disableRandomFirstFrame>true</disableRandomFirstFrame>
									<eventPlaybackEnd>false</eventPlaybackEnd>
									<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
									<stopIfMoved>false</stopIfMoved>
									<stopIfRotated>false</stopIfRotated>
								</advanced>
								<animations>
									<Item>jumpEnd</Item>
									<Item>specialSitGround</Item>
								</animations>
								<channel>CHANNEL_DEFAULT</channel>
								<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
								<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
								<mode>LOOP</mode>
								<use>USE_ANIMATIONS</use>
								<dontFreezePrecast>false</dontFreezePrecast>
							</Item>
						</elements>
						<play>Simultaneously</play>
						<preconditional>false</preconditional>
						<restartOnVisualChange>false</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
					</playOnSelf>
					<notifyCamera>false</notifyCamera>
				</thenAction>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>true</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<postAction type="client.Replica.CreatureAnimationAction">
		<advanced>
			<autoHasten>
				<mode>AUTOHASTEN_NONE</mode>
				<timeToBeLeft>0</timeToBeLeft>
			</autoHasten>
			<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
			<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
			<offendType>NO_OFFEND</offendType>
			<speed>0</speed>
			<turnToTarget>TURN_DEFAULT</turnToTarget>
			<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
			<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
			<denyAutoHasten>false</denyAutoHasten>
			<disableRandomFirstFrame>true</disableRandomFirstFrame>
			<eventPlaybackEnd>false</eventPlaybackEnd>
			<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
			<stopIfMoved>false</stopIfMoved>
			<stopIfRotated>false</stopIfRotated>
		</advanced>
		<animations>
			<Item>jumpEnd</Item>
		</animations>
		<channel>CHANNEL_DEFAULT</channel>
		<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
		<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
		<mode>DIE</mode>
		<use>USE_ANIMATIONS</use>
		<dontFreezePrecast>false</dontFreezePrecast>
	</postAction>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>