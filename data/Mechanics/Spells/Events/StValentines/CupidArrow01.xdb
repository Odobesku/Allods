<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>210389</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Events/EventSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="CupidArrow01_Name.txt" />
    <Description href="CupidArrow01_Desc.txt" />
    <image href="/Interface/Icons/Misc/Event/StValentinesArrows.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="/Spells/VisScripts/Events/StValentines/CupidArrow.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <level>4</level>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Everyone</iffPolicy>
    <mechanics>
        <cooldown>
            <stage>Start</stage>
            <duration>2000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                <rule href="/Mechanics/Rules/StValentines/StValentinesDay.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="CupidArrowTimeout.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="CupidArrowLimitMob.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                </predicate>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>8</value>
                </minLevel>
            </Item>
        </targetConditions>
        <conditions>
            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
                                <affectGroup>Enemies</affectGroup>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                <onMaster type="gameMechanics.elements.predicates.PredicateWrapClientData">
                                    <predicate type="gameMechanics.constructor.basicElements.PredicateTrue" />
                                    <clientData href="NotEnemy.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </onMaster>
                                <onSlave type="gameMechanics.elements.predicates.PredicateWrapClientData">
                                    <predicate type="gameMechanics.elements.predicates.PredicateIsMob" />
                                    <clientData href="NotEnemy.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </onSlave>
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateLevelLess">
                                <delta>-3</delta>
                                <equalsOk>true</equalsOk>
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                        <onMaster type="gameMechanics.elements.predicates.PredicateWrapClientData">
                                            <predicate type="gameMechanics.elements.predicates.PredicateCharacterSex">
                                                <sex href="/Mechanics/Sex/Male.xdb#xpointer(/gameMechanics.world.avatar.CharacterSex)" />
                                            </predicate>
                                            <clientData href="NotEnemy.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </onMaster>
                                        <onSlave type="gameMechanics.elements.predicates.PredicateWrapClientData">
                                            <predicate type="gameMechanics.elements.predicates.PredicateCharacterSex">
                                                <sex href="/Mechanics/Sex/Female.xdb#xpointer(/gameMechanics.world.avatar.CharacterSex)" />
                                            </predicate>
                                            <clientData href="NotEnemy.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </onSlave>
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                        <onMaster type="gameMechanics.elements.predicates.PredicateWrapClientData">
                                            <predicate type="gameMechanics.elements.predicates.PredicateCharacterSex">
                                                <sex href="/Mechanics/Sex/Female.xdb#xpointer(/gameMechanics.world.avatar.CharacterSex)" />
                                            </predicate>
                                            <clientData href="NotEnemy.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </onMaster>
                                        <onSlave type="gameMechanics.elements.predicates.PredicateWrapClientData">
                                            <predicate type="gameMechanics.elements.predicates.PredicateCharacterSex">
                                                <sex href="/Mechanics/Sex/Male.xdb#xpointer(/gameMechanics.world.avatar.CharacterSex)" />
                                            </predicate>
                                            <clientData href="NotEnemy.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </onSlave>
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                        <onMaster type="gameMechanics.constructor.basicElements.PredicateExternal">
                                            <predicateResource href="/World/Quests/ZoneHadagan1/ZH1_Wedding/PredicatesHomo.(PredicateResource).xdb#xpointer(/gameMechanics.constructor.basicElements.PredicateResource)" />
                                        </onMaster>
                                        <onSlave type="gameMechanics.constructor.basicElements.PredicateExternal">
                                            <predicateResource href="/World/Quests/ZoneHadagan1/ZH1_Wedding/PredicatesHomo.(PredicateResource).xdb#xpointer(/gameMechanics.constructor.basicElements.PredicateResource)" />
                                        </onSlave>
                                    </Item>
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                <onMaster type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                <onSlave type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
        </conditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="CupidArrowTimeout.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                            <value>0.02</value>
                        </chanceCalcer>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                                <quest href="/World/Quests/ZoneLeague1/StValentines/KaniaQuestBlindedStart.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                                <status>Finished</status>
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                                <quest href="/World/Quests/ZoneHadagan1/StValentines/HadaganQuestBlindedStart.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                                <status>Finished</status>
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                                <impactsElse>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="BlindedByLove.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                            <value>0.2</value>
                        </chanceCalcer>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                            <item href="/Items/QuestItems/StValentines/Endearment/Endearment.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                        </item>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="AvatarTarget.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                    <item href="/Items/QuestItems/StValentines/SmallValentine.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                </item>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                                <quest href="/World/Quests/ZoneLeague1/StValentines/KaniaQuestStart.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                                <quest href="/World/Quests/ZoneHadagan1/StValentines/HadaganQuestStart.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                        <id href="/World/Quests/ZoneLeague1/StValentines/QuestStart.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="CupidArrowLimitMob.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsElse>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>20</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>