<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739870904</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="AddPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<isPersonalPool>true</isPersonalPool>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</onLeave>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectsDeferred">
					<delay>30000</delay>
					<effects>
						<Item type="gameMechanics.elements.effects.ImpactsOverTime">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="VampireTransform.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
							<tick>60000</tick>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
