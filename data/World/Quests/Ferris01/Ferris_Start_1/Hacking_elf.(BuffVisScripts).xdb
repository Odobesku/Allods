<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>InSequence</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>1500</time>
				</playWhile>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>useControlLoop</Item>
						</animations>
						<channelOverrideScript />
						<channelOverrideControllers>TOP_ONLY</channelOverrideControllers>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Quests/Elf_UseSpeciaSivilla_Start.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>1</scale>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>useSpecialLoop</Item>
						</animations>
						<channelOverrideScript />
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Quests/Elf_UseSpeciaSivilla.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<scale>1</scale>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
	<postAction />
</BuffVisScripts>
