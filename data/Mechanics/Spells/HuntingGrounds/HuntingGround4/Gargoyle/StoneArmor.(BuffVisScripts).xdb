<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureVisCharacterAction">
					<visCharList>
						<Item href="/Creatures/Mammoth/Mammoth.(VisCharacterTemplate).xdb" />
						<Item href="/Creatures/Colossus/Colossus.(VisCharacterTemplate).xdb" />
					</visCharList>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReflectionDamage.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>3.2</scale>
								<locator>Slot_Global</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureVisCharacterAction">
					<visCharList>
						<Item href="/Creatures/Mammoth/Mammoth.(VisCharacterTemplate).xdb" />
						<Item href="/Creatures/Colossus/Colossus.(VisCharacterTemplate).xdb" />
					</visCharList>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReflectionDamage.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>1</scale>
								<locator>Slot_Global</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
