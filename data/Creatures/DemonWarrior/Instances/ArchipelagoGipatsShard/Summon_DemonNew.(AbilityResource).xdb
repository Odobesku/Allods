<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>130314370</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/Items/InteractiveObjects/ArchipelagoGipatsShard/Magic_stele_01/Stele_1_plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                    <mobs>
                        <Item href="DemonWarrior_Single.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    </mobs>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.DeathTrigger">
                    <impactsToKiller>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>1000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                            <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                                <base type="gameMechanics.map.destination.RelativePos">
                                                    <yaw type="constructor.basicElements.AngleRadians" />
                                                </base>
                                                <offset>10</offset>
                                            </destination>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                    <delay>600000</delay>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                                    </impacts>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="/Items/InteractiveObjects/ArchipelagoGipatsShard/Magic_stele_01/AddResolvStele1.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                            <predicates>
                                                                <Item type="gameMechanics.world.pet.PredicateHasPet" />
                                                            </predicates>
                                                            <impactsIf>
                                                                <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                            <buff href="/Items/InteractiveObjects/ArchipelagoGipatsShard/Magic_stele_01/AddResolvStele1.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impactsIf>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                    <delay>1000</delay>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                            <object href="/Creatures/DemonMageNewBreed/Instances/ArchipelagoGipatsShard/DemonMageNewBreed_Single.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsToKiller>
                </Item>
            </effectsIf>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>