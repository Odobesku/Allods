	<groups>
		<Item href="/Mechanics/ProceduralDungeon/Groups/Lightning.(ActionGroupElement).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroupElement)" />
	</groups>
	<element>LIGHTNING</element>
	<Name href="Lightning_Jump.(SpellSingleTarget).Name.txt" />
	<visualScripts href="Lightning_Jump.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>3000</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>6000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
				</predicates>
			</Item>
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
						<time>1000</time>
						<impactsOnLand>
							<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
								<impacts>
									<Item type="gameMechanics.elements.impacts.PostponedImpacts">
										<impacts>
											<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
												<radius>9</radius>
												<affectGroup>Enemies</affectGroup>
												<affectHolder>false</affectHolder>
												<impacts>
													<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
														<element>LIGHTNING</element>
														<damage>35</damage>
														<scaler type="gameMechanics.elements.scalers.MagicScaler" />
													</Item>
												</impacts>
												<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
													<predicates>
														<Item type="gameMechanics.constructor.basicElements.PredicateOr">
															<predicates>
																<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
																<Item type="gameMechanics.elements.resources.ResourceBuff">
																	<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
																</Item>
																<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
															</predicates>
														</Item>
													</predicates>
												</filter>
											</Item>
											<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
												<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
												<data href="Jump_Data.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
											</Item>
										</impacts>
									</Item>
								</impacts>
							</Item>
						</impactsOnLand>
						<destination type="gameMechanics.map.destination.RelativePos" />
						<keepOnGround>false</keepOnGround>
					</Item>
				</impacts>
			</Item>
