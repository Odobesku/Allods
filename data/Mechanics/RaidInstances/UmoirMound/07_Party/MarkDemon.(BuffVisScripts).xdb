<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Demon_TargetMark.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<lockScale>true</lockScale>
						<scale>1.55</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_TopFX</locator>
						<offendTime />
