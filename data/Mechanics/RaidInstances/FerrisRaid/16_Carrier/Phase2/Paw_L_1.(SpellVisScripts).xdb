<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialIdleStart</Item>
				</animations>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialIdle</Item>
				</animations>
				<advanced>
					<speed>2</speed>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Mobs/Carrier_Tentacle_ReadySpell.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<lockScale>true</lockScale>
				<locator>FROM_LOCATOR_NAME</locator>
				<locatorName>joint15</locatorName>
			</Item>
		</visualEffects>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialIdleEnd</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>450</time>
				</playWhile>
				<elements>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="ChannelingComponent">
								<channelingFx href="/Spells/FX/Mobs/Carrier_Tentacle_CastSpel_Project.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fxLength>30</fxLength>
								<startPoint>
									<locator>FROM_LOCATOR_NAME</locator>
									<locatorName>joint15</locatorName>
								</startPoint>
								<endPoint>
									<locator>FROM_LOCATOR_NAME</locator>
									<locatorName>Slot_Special70</locatorName>
									<shift x="-5" y="0" z="-4" />
								</endPoint>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
