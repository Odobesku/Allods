<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<animations>
			<Item>throwWeapon</Item>
		</animations>
		<channel>CHANNEL_ATTACK</channel>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2000</time>
		</playWhile>
		<elements>
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/ThrowBottlePoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Spells/ThrowBottlePoison_Hit_Small.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<theGe>10</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
				</pointOnCaster>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectPoisonWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
