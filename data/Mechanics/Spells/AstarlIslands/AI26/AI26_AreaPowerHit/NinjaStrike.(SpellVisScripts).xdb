<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<playWhile type="VisActionDelay">
			<time>1500</time>
		</playWhile>
		<elements>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>jumpAttack</play>
							<forAnimations>
								<Item>jump</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpAttackStart</play>
							<forAnimations>
								<Item>jumpStart</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>recoilJumpEnd</play>
							<forAnimations>
								<Item>jumpEnd</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>jumpAttack</play>
							<forAnimations>
								<Item>jump</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>jumpAttackStart</play>
							<forAnimations>
								<Item>jumpStart</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>recoilJumpEnd</play>
							<forAnimations>
								<Item>jumpEnd</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
				<member>Group</member>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
