<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.battleground.BattleEventMapMechanics>
    <Header>
        <resourceId>242468</resourceId>
    </Header>
    <score href="MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
    <mechanicsType>BATTLEGROUND</mechanicsType>
    <map href="/Maps/MW_RaidIsle01/MapResource.xdb" />
    <waitBuff href="/Mechanics/InstancedEventResource/MW_01/MW_WaitBuff02.(BuffResource).xdb" />
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.ImpactEnableBunchEffects">
            <enable>true</enable>
        </Item>
        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactUpdateEventAchievementGeneric">
            <achievement href="/Mechanics/InstancedEventResource/MW_01/DefaultWinner.(BattleEventAchievementResource).xdb" />
            <summand type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </summand>
            <mark href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
        </Item>
        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactUpdateEventAchievementGeneric">
            <achievement href="MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
            <summand type="gameMechanics.elements.calcers.FloatData">
                <value>10800</value>
            </summand>
            <mark href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
        </Item>
    </impactsOnStart>
    <impactsOnFinish>
        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/MegaWar/Assistants/CanSummonMegaPet.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/MWRaid/DeathTrigger.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </impactsOnFinish>
    <startAnnounce href="/Mechanics/InstancedEventResource/MM_BG01/StartAnnounce.(ClientData).xdb" />
    <impactsOnAvatars>
        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactUpdateEventAchievement">
            <achievement href="/Mechanics/InstancedEventResource/MW_01/PlayersCounter.(BattleEventAchievementResource).xdb" />
            <summand>1</summand>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactLogAvatarStats">
            <resource href="MegaWarRaidMW5.(InstancedEventResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                    <key href="/System/ContentKeys/GoodPVP.(ContentKey).xdb" />
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/InstancedEventResource/CommonMechanics/GoodPVP.(BuffResource).xdb" />
                </Item>
            </impactsIf>
        </Item>
    </impactsOnAvatars>
    <impactsOnReconnect>
        <Item type="gameMechanics.elements.impacts.ImpactKillAndRespawn" />
    </impactsOnReconnect>
    <assignWinnerOnDraw>false</assignWinnerOnDraw>
    <impactsOnEarlyExit>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="/Mechanics/InstancedEventResource/CommonMechanics/GoodPVP.(BuffResource).xdb" />
        </Item>
    </impactsOnEarlyExit>
    <impactsOnWinners>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="/Mechanics/InstancedEventResource/CommonMechanics/GoodPVP.(BuffResource).xdb" />
        </Item>
    </impactsOnWinners>
    <impactsOnLosers>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="/Mechanics/InstancedEventResource/CommonMechanics/GoodPVP.(BuffResource).xdb" />
        </Item>
    </impactsOnLosers>
    <entrances>
        <Item>
            <mark href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
            <entrances>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>Point02</scriptID>
                        <map href="/Maps/MW_RaidIsle01/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>270</value>
                    </yaw>
                </Item>
            </entrances>
        </Item>
        <Item>
            <mark href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
            <entrances>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>Start_red</scriptID>
                        <map href="/Maps/MW_RaidIsle01/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>90</value>
                    </yaw>
                </Item>
            </entrances>
        </Item>
    </entrances>
    <prepareTime>
        <minute>2</minute>
    </prepareTime>
    <duration>
        <minute>20</minute>
    </duration>
    <achievements>
        <Item>
            <resource href="MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
            <count>14400</count>
            <weight>1</weight>
            <finalWeight>100</finalWeight>
        </Item>
        <Item>
            <showInTable>true</showInTable>
            <resource href="/Mechanics/InstancedEventResource/Achievements/Kills.(BattleEventAchievementResource).xdb" />
        </Item>
        <Item>
            <showInTable>true</showInTable>
            <resource href="/Mechanics/InstancedEventResource/Achievements/Deaths.(BattleEventAchievementResource).xdb" />
        </Item>
        <Item>
            <showInTable>true</showInTable>
            <resource href="/Mechanics/InstancedEventResource/Achievements/TotalDamageDone.(BattleEventAchievementResource).xdb" />
        </Item>
        <Item>
            <showInTable>true</showInTable>
            <resource href="/Mechanics/InstancedEventResource/Achievements/TotalHealDone.(BattleEventAchievementResource).xdb" />
        </Item>
        <Item>
            <resource href="/Mechanics/InstancedEventResource/MW_01/HasTabard.(BattleEventAchievementResource).xdb" />
        </Item>
        <Item>
            <resource href="/Mechanics/InstancedEventResource/MW_01/DefaultWinner.(BattleEventAchievementResource).xdb" />
            <finalWeight>10</finalWeight>
        </Item>
        <Item>
            <resource href="/Mechanics/InstancedEventResource/MW_01/PlayersCounter.(BattleEventAchievementResource).xdb" />
            <finalWeight>1</finalWeight>
        </Item>
    </achievements>
</gameMechanics.battleground.BattleEventMapMechanics>