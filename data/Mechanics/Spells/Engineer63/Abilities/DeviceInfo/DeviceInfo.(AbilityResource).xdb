<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739934083</resourceId>
    </Header>
    <name href="DeviceInfo.(AbilityResource).Name.txt" />
    <description href="DeviceInfo.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Misc/HadaganCannon.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <groups>
                <Item href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
            </groups>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Engineer63/Spells/Titan/TitanInvisPlane.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/Engineer63/Abilities/DeviceLimit/DeviceLimitTrigger.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.StackBuff">
                                            <buff href="/Mechanics/Spells/Engineer63/Abilities/DeviceLimit/DeviceLimitTrigger.(BuffResource).xdb" />
                                            <resetTimer>false</resetTimer>
                                            <delta type="gameMechanics.elements.calcers.FloatData">
                                                <value>-1</value>
                                            </delta>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOff>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Engineer63/Spells/Titan/TitanInvisPlane.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/Engineer63/Abilities/DeviceLimit/DeviceLimitTrigger.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOff>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>