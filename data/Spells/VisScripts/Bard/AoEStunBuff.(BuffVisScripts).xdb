					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownDisease.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<fadeInTime>400</fadeInTime>
						<fadeOutTime>400</fadeOutTime>
