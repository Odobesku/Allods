	<image href="/Interface/Icons/Misc/Buffs/BuffURShadowFire.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<interfaceHighPriority>true</interfaceHighPriority>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
					<mobs>
						<Item href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Phase2Summons/Phase2Fire.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
					</mobs>
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
					<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
						<coeff>0.15</coeff>
					</scaler>
				</Item>
			</effectsIf>
			<effectsElse>
				<Item type="gameMechanics.elements.effects.EffectsIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Phase2Summons/Phase2Shadow.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							</mobs>
						</Item>
					</predicates>
					<effectsIf>
						<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
							<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
								<coeff>-0.05</coeff>
							</scaler>
						</Item>
					</effectsIf>
				</Item>
			</effectsElse>
		</Item>
	</effects>
	<duration>12000</duration>
	<stackLimit>100</stackLimit>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
