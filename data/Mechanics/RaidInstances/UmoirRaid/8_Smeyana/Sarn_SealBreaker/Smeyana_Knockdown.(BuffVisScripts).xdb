<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>knockdownStart</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>knockdownLoop</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
		</elements>
	</action>
	<postAction type="CreatureAnimationAction">
		<animations>
			<Item>knockdownEnd</Item>
		</animations>
		<channel>CHANNEL_KNOCKDOWN</channel>
		<advanced>
			<offendType>EVERYKEY_ALLOFFENDS</offendType>
		</advanced>
	</postAction>
</BuffVisScripts>
