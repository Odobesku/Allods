<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739919962</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <element>LIGHTNING</element>
    <Name href="Spell00.(SpellArea).Name02.txt" />
    <Description href="Spell00.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
        <Item>
            <name>dur</name>
            <value var="dur" />
        </Item>
        <Item>
            <name>dot</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer href="DotDmg.(CalcerFloatResource).xdb" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>MagicScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Priest/PriestHeavenlyStrike.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Priest/HeavenlyStrike.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <ranks>
        <Item href="Spell01.(SpellArea).xdb" />
        <Item href="Spell02.(SpellArea).xdb" />
        <Item href="Spell03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>30000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>LIGHTNING</element>
                        <forceAE>true</forceAE>
                        <damage var="value" />
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="HeavenlyStrike.(BuffResource).xdb" />
                <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                        <summands>
                            <Item type="gameMechanics.elements.calcers.FloatData">
                                <value var="dur" />
                            </Item>
                            <Item type="gameMechanics.elements.calcers.AbilityRankCalcer">
                                <ability href="/Mechanics/Spells/Priest63/Abilities/CleansingFireElemental/Ability01.(AbilityResource).xdb" />
                                <mul>2</mul>
                            </Item>
                        </summands>
                    </mulCalcer>
                </durationScaler>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>