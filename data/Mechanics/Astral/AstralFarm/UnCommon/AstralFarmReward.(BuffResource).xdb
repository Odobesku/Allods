<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>236805</resourceId>
        <Prototype href="/Mechanics/Astral/AstralFarm/Prototypes/AstralFarmReward.Prototype.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Variables>
            <Rewardbuff>AstralFarmReward.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)</Rewardbuff>
            <Reward>AstralFarmReward.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)</Reward>
        </Variables>
    </Header>
    <Name href="AstralFarmReward.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                            <lhs type="gameMechanics.elements.calcers.LongData">
                                <value>1</value>
                            </lhs>
                            <rhs type="itemService.serverVariables.CalcerServerVariable">
                                <variableResource href="/Mechanics/ServerUnlock/ServerUnlock.(ServerVariableResource).xdb#xpointer(/itemService.basicInterfaces.ServerVariableResource)" />
                            </rhs>
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
                            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                <item href="/Mechanics/ServerUnlock/Items/ServerUnlock.Common.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                            </item>
                            <count type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                <calcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                    <buff href="AstralFarmReward.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </calcer>
                            </count>
                        </Item>
                    </impacts>
                    <elseImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                    <lhs type="gameMechanics.elements.calcers.LongData">
                                        <value>2</value>
                                    </lhs>
                                    <rhs type="itemService.serverVariables.CalcerServerVariable">
                                        <variableResource href="/Mechanics/ServerUnlock/ServerUnlock.(ServerVariableResource).xdb#xpointer(/itemService.basicInterfaces.ServerVariableResource)" />
                                    </rhs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
                                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                        <item href="/Mechanics/ServerUnlock/Items/ServerUnlock.UnCommon.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                    </item>
                                    <count type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                        <calcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                            <buff href="AstralFarmReward.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </calcer>
                                    </count>
                                </Item>
                            </impactsIf>
                        </Item>
                    </elseImpacts>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.buff.BuffResource>