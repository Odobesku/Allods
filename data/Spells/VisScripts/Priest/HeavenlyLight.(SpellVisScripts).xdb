<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmniCure</Item>
				</animations>
				<advanced>
					<speed>0.8</speed>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Priest63_HeavenlyLight_01.(VisObjectTemplate).xdb" />
						<locator>Slot_FX</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/Priest63_HeavenlyLight.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
					<name>spells/Priest/Lightning</name>
				</sound>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
