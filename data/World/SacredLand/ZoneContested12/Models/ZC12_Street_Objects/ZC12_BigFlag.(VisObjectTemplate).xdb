<?xml version="1.0" encoding="UTF-8"?>
<VisObjectTemplate>
	<defaultState>
		<sound>
			<creationRadius>-1</creationRadius>
		</sound>
		<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
		<playSoundOnKeys>true</playSoundOnKeys>
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>0</fadeInMS>
	<fadeOutMS>0</fadeOutMS>
	<geometry href="ZC12_BigFlag.(Geometry).xdb#xpointer(/Geometry)" />
	<replaceDistance>-1</replaceDistance>
	<scale>0.4</scale>
	<sound>
		<creationRadius>-1</creationRadius>
	</sound>
	<states>
		<Item>
			<sound>
				<creationRadius>-1</creationRadius>
			</sound>
			<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
			<playSoundOnKeys>true</playSoundOnKeys>
			<animation href="/World/Dungeons/UmoirRaid/Models/Animations/Umoir_Raid_Ship_FlagCenter.Idle.(SkeletalAnimation).xdb#xpointer(/SkeletalAnimation)" />
			<isNecessaryAnim>false</isNecessaryAnim>
		</Item>
		<Item>
			<sound>
				<creationRadius>-1</creationRadius>
			</sound>
			<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
			<playSoundOnKeys>true</playSoundOnKeys>
			<animation href="/World/Dungeons/UmoirRaid/Models/Animations/Umoir_Raid_Ship_FlagCenter.Run.(SkeletalAnimation).xdb#xpointer(/SkeletalAnimation)" />
			<isNecessaryAnim>false</isNecessaryAnim>
		</Item>
		<Item>
			<sound>
				<creationRadius>-1</creationRadius>
			</sound>
			<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
			<playSoundOnKeys>true</playSoundOnKeys>
			<animation href="/World/Dungeons/UmoirRaid/Models/Animations/Umoir_Raid_Ship_FlagCenter.Run01.(SkeletalAnimation).xdb#xpointer(/SkeletalAnimation)" />
			<isNecessaryAnim>false</isNecessaryAnim>
		</Item>
	</states>
	<visObjComponents>
		<Item type="client.VisualConstructor.AnimationFromParentComponent">
			<animationsReplacements>
				<Item>
					<forAnimations>
						<Item>idle</Item>
						<Item>idleOffline</Item>
						<Item>shuffleLeft</Item>
						<Item>shuffleRight</Item>
						<Item>run</Item>
					</forAnimations>
					<play>idle</play>
				</Item>
				<Item>
					<forAnimations>
						<Item>run01</Item>
						<Item>shuffleLeft01</Item>
						<Item>shuffleRight01</Item>
					</forAnimations>
					<play>run</play>
				</Item>
				<Item>
					<forAnimations>
						<Item>run02</Item>
						<Item>shuffleLeft02</Item>
						<Item>shuffleRight02</Item>
					</forAnimations>
					<play>run01</play>
				</Item>
			</animationsReplacements>
			<ifAnimationNotExistsRun>idle</ifAnimationNotExistsRun>
			<skipBlendOptimization>false</skipBlendOptimization>
			<synchronizeAnimationPosition>false</synchronizeAnimationPosition>
