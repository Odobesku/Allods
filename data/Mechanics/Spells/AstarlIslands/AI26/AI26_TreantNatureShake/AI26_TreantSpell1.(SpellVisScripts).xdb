<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureIndependentFxAction">
                <visObject href="/Spells/FX/Spells/AOEAura_Acid_R10.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <lifeTime>3.6</lifeTime>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="CreatureAnimationAction">
        <animations>
            <Item>readySpellDirected</Item>
            <Item>specialCast</Item>
        </animations>
        <channel>CHANNEL_KNOCKDOWN</channel>
    </wholeCasting>
    <precastType>PRECAST_DEFAULT</precastType>
    <launch type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Spells/DemonForm_Earthquake.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <fixPoint>true</fixPoint>
                <scale>2</scale>
            </Item>
        </visualEffects>
    </launch>
</SpellVisScripts>