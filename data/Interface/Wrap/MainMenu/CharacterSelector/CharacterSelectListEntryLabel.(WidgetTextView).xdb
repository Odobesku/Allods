<?xml version="1.0" encoding="UTF-8" ?>
<WidgetTextView>
    <Name>CharacterEntryLabel</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <HighPos>138</HighPos>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Sizing>WIDGET_SIZING_INTERNAL</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing></reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>false</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>true</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <DefaultTag></DefaultTag>
    <FormatFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/CharacterSelectListEntryLabel.txt"/>
    <TextStyle>
        <Align>ALIGNY_DEFAULT</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>true</multiline>
        <showClippedLine>false</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextValues>
        <Item>
            <Tag>name</Tag>
            <TagValueFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/CharacterSelectListEntryLabelName.txt"/>
        </Item>
        <Item>
            <Tag>class</Tag>
            <TagValueFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/CharacterSelectListEntryLabelClass.txt"/>
        </Item>
        <Item>
            <Tag>level</Tag>
            <TagValueFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/CharacterSelectListEntryLabelLevel.txt"/>
        </Item>
        <Item>
            <Tag>zone</Tag>
            <TagValueFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/CharacterSelectListEntryLabelZone.txt"/>
        </Item>
        <Item>
            <Tag>subzone</Tag>
            <TagValueFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/CharacterSelectListEntryLabelSubzone.txt"/>
        </Item>
        <Item>
            <Tag>rename</Tag>
            <TagValueFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/texts/Rename.txt"/>
        </Item>
        <Item>
            <Tag>alt</Tag>
            <TagValueFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/texts/HaveAltCharacters.txt"/>
        </Item>
        <Item>
            <Tag>redefineRace</Tag>
            <TagValueFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/texts/RedefineRace.txt"/>
        </Item>
    </TextValues>
    <isHtmlEscaping>false</isHtmlEscaping>
    <pickObjectsOnly>false</pickObjectsOnly>
</WidgetTextView>
