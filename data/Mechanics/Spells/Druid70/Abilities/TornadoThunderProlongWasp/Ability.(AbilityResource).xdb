			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIncrementBuffDuration">
					<buff href="/Mechanics/Spells/Druid70/Spells/Wasps/Buff01.(BuffResource).xdb" />
					<casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
					<delta type="gameMechanics.elements.calcers.FloatData">
						<value>300</value>
					</delta>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
			<mark href="TornadoAOE.(MarkResource).xdb" />
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
								<spell href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisable.(SpellSingleTarget).xdb" />
							</predicate>
						</Item>
					</predicates>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>15</radius>
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>LIGHTNING</element>
									<damage>1</damage>
									<impactsOnHitTarget>
										<Item type="gameMechanics.elements.impacts.MarkedImpact">
											<mark href="StormWasps.(MarkResource).xdb" />
										</Item>
									</impactsOnHitTarget>
									<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
										<scalers>
											<Item type="gameMechanics.elements.scalers.MagicScaler" />
											<Item type="gameMechanics.elements.scalers.LinearScaler">
												<multiplier>0.5</multiplier>
											</Item>
											<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="gameMechanics.elements.calcers.CalcerIf">
													<predicate type="gameMechanics.elements.predicates.PredicateHasSpell">
														<spell href="/Mechanics/Spells/Druid70/Spells/Tornado/Spell03.(SpellSingleTarget).xdb" />
													</predicate>
													<calcerIf type="constructor.elements.CalcerFloatExternal">
														<externalCalcer href="/Mechanics/Spells/Druid70/Spells/Tornado/Calcer3.(CalcerFloatResource).xdb" />
													</calcerIf>
													<calcerElse type="gameMechanics.elements.calcers.CalcerIf">
														<predicate type="gameMechanics.elements.predicates.PredicateHasSpell">
															<spell href="/Mechanics/Spells/Druid70/Spells/Tornado/Spell02.(SpellSingleTarget).xdb" />
														</predicate>
														<calcerIf type="constructor.elements.CalcerFloatExternal">
															<externalCalcer href="/Mechanics/Spells/Druid70/Spells/Tornado/Calcer2.(CalcerFloatResource).xdb" />
														</calcerIf>
														<calcerElse type="constructor.elements.CalcerFloatExternal">
															<externalCalcer href="/Mechanics/Spells/Druid70/Spells/Tornado/Calcer1.(CalcerFloatResource).xdb" />
														</calcerElse>
													</calcerElse>
												</mulCalcer>
											</Item>
										</scalers>
									</scaler>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
