<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739855876</resourceId>
    </Header>
    <visObject href="/Mechanics/Spells/AstarlIslands/AI44/Boss03/AE2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0.1</altitude>
    <lifeLengthCap>3000</lifeLengthCap>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <radius>3</radius>
            <affectGroup>Enemies</affectGroup>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>FIRE</element>
                    <damage>20</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="StoneForm.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </filter>
        </Item>
    </impactsOnStart>
</gameMechanics.world.projectile.ProjectileResource>