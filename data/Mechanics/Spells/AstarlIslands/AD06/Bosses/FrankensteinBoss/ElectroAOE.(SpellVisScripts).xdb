                    <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
                    <name>spells/FX/World/AD06/ElectroAOE</name>
                </sound>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>