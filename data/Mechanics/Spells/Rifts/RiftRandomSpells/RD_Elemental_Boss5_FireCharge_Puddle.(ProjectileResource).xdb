<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>209129</resourceId>
    </Header>
    <name href="RD_Elemental_Boss5_FireCharge_Puddle.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/World/FirePuddle_2.(VisObjectTemplate).xdb" />
    <altitude>0.2</altitude>
    <lifeLengthCap>10000</lifeLengthCap>
    <impactsOnDeath>
        <Item type="gameMechanics.elements.impacts.ImpactSummon">
            <destination type="gameMechanics.map.destination.RelativePos" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                    </impacts>
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <object href="/Mechanics/Spells/Rifts/RiftRandomMobs/RD_Elemental_AE2.(MobWorld).xdb" />
            <pool href="/Mechanics/Spells/Rifts/Abilities/RD_BossSummonPool.(SummonPool).xdb" />
            <isPersonalPool>true</isPersonalPool>
        </Item>
    </impactsOnDeath>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <tick>1000</tick>
                    <affectGroup>All</affectGroup>
                    <radius>3</radius>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="RD_PuddlesDebuff_FireDamage.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="RD_PuddlesDebuff_FireDamage.(BuffResource).xdb" />
                        </Item>
                    </impactsIn>
                </Item>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <affectGroup>All</affectGroup>
                    <radius>3</radius>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="RD_PuddlesDebuff_FireDamage.(BuffResource).xdb" />
                        </Item>
                    </impactsOut>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>