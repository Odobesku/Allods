<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Omni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationOmniWand.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastAnimation>
			<CastAnimation>battleRoar</CastAnimation>
			<FXOnCaster>/Spells/FX/Spells/WarriorPriden_CryAncestors.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<FXWand />
			<FXOnTargets>/Spells/FX/Spells/WarriorPriden_CryAncestors_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<LocatorOnTargets>Global</LocatorOnTargets>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item skiped="" />
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="CastAnimation" />
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item skiped="" />
							<Item skiped="" />
							<Item>
								<effectFx href="/Spells/FX/Spells/WarriorEvasiveStrike_BodyGlow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>0.5</scale>
								<locator>Slot_Hand_L</locator>
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/WarriorEvasiveStrike_BodyGlow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<scale>0.5</scale>
								<locator>Slot_Hand_R</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/WarriorPriden_CryAncestors_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<locator var="LocatorOnTargets" />
						</Item>
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
