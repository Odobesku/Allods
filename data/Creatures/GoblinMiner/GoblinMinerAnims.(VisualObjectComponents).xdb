<?xml version ="1.0" encoding="UTF-8" ?>
<VisualObjectComponents>
    <components>
        <Item type="AnimationFromParentComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <animationsReplacements>
                <Item>
                    <forAnimations>
                        <Item>idle</Item>
                    </forAnimations>
                    <play>idle</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>walk</Item>
                    </forAnimations>
                    <play>walk</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>invalid</Item>
                    </forAnimations>
                    <play>invalid</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>death</Item>
                    </forAnimations>
                    <play>death</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>special01</Item>
                        <Item>special</Item>
                    </forAnimations>
                    <play>special</play>
                </Item>
            </animationsReplacements>
            <ifAnimationNotExistsRun>idle</ifAnimationNotExistsRun>
            <skipBlendOptimization>false</skipBlendOptimization>
            <synchronizeAnimationPosition>false</synchronizeAnimationPosition>
        </Item>
    </components>
</VisualObjectComponents>
