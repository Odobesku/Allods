<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739868624</resourceId>
	</Header>
	<name href="Rogue_ImmuntityTaunts.(AbilityResource).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Rogue_ImmuntityTaunts.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<tick>6000</tick>
			<affectGroup>Enemies</affectGroup>
			<radius>60</radius>
			<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateOr">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</predicates>
					</Item>
				</predicates>
			</filter>
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateHealthLower">
					<level>0.5</level>
				</Item>
			</predicates>
			<conditions>
				<Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
					<onMaster type="gameMechanics.constructor.basicElements.PredicateAnd">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="Rogue_Finisher.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</predicate>
							</Item>
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="Rogue_EscapeAggro.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</predicate>
							</Item>
						</predicates>
					</onMaster>
					<onSlave type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Rogue_FinisherTarger.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</predicate>
					</onSlave>
				</Item>
			</conditions>
			<impactsIn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Rogue_FinisherTarger.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Rogue_Finisher.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
			</impactsIn>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOnStrike">
			<impactsToTarget>
				<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
					<element>POISON</element>
					<damage>10</damage>
					<scaler type="gameMechanics.elements.scalers.MagicScaler" />
				</Item>
			</impactsToTarget>
		</Item>
		<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.4</coeff>
			</scaler>
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDamageTrigger">
			<predicates>
				<Item type="gameMechanics.elements.predicates.offender.PredicateDistance">
					<maxDistToOffender>8</maxDistToOffender>
				</Item>
			</predicates>
			<impacts>
				<casterToTarget>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="Rogue_EscapeCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</predicates>
						<impactsElse>
							<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
								<spell href="Rogue_Escape.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
							</Item>
						</impactsElse>
					</Item>
				</casterToTarget>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
