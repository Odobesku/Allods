<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739852058</resourceId>
    </Header>
    <Name href="Fireball.(SpellArea).Name.txt" />
    <visualScripts href="Fireball.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>0</value>
    </range>
    <prepareDuration>6250</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTPoint</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="FireBall.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.map.destination.DestinationModified">
                            <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                            <modifiers>
                                <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                    <verticalRange min="1" max="1" />
                                    <horizontalRange min="0" max="0" />
                                </Item>
                                <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                            </modifiers>
                        </destination>
                    </moveType>
                    <resource href="/Mechanics/RaidInstances/UmoirRaid/3_LandingBoss/FirePool.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                </projectileData>
                <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>0.5</value>
                </chanceCalcer>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/RaidInstances/UmoirRaid/3_LandingBoss/Voice/Voice23.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                        <impactsElse>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/RaidInstances/UmoirRaid/3_LandingBoss/Voice/Voice23.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsElse>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>25</speed>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>