<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Direct.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation />
			<LocatorNameOnTargets />
			<FXOnTargets>/Spells/FX/Spells/PriestBlind.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<CastAnimation>spellCastOmni</CastAnimation>
			<FixPointTarget>true</FixPointTarget>
			<FXOnCaster />
			<LocatorOnTargets>Slot_Head</LocatorOnTargets>
			<LocatorNameOnCaster />
			<PreCastFX />
			<FXWand>/Spells/FX/Spells/ReadySpellDirectHolyWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXWand>
			<FixPointCaster>false</FixPointCaster>
			<FXPocket />
			<HitPostFXOnTargets />
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item skiped="" />
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<advanced>
					<offendType>EVERYKEY_ALLOFFENDS</offendType>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item skiped="" />
							<Item>
								<delay>0</delay>
								<effectFx hrefvar="FXWand" />
								<effectAlias href="" />
								<effectAnimations>
									<mode>DIE</mode>
									<animations />
								</effectAnimations>
								<fixPoint>true</fixPoint>
								<lockScale>false</lockScale>
								<scale>1</scale>
								<fadeInTime>0</fadeInTime>
								<fadeOutTime>0</fadeOutTime>
								<locator>Slot_Hand_R</locator>
								<member>Default_Member</member>
								<locatorName />
								<offendTime />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
