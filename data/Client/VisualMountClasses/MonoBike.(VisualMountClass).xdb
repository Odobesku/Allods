  <controlParameters>
    <speedFactorBackward>
      <startTime>0</startTime>
      <startVelocity>3</startVelocity>
      <stopTime>0</stopTime>
      <stopVelocity>0</stopVelocity>
    </speedFactorBackward>
    <speedFactorForward>
      <startTime>200</startTime>
      <startVelocity>12</startVelocity>
      <stopTime>150</stopTime>
      <stopVelocity>2</stopVelocity>
    </speedFactorForward>
  </controlParameters>
  <dismountAnimation>jumpEnd</dismountAnimation>
  <fxSettings>
    <mountLocators>
      <Item>Slot_FX</Item>
      <Item>Slot_Global</Item>
      <Item>Global</Item>
    </mountLocators>
  </fxSettings>
  <hiddenDressSlots>
    <Item>CLOAK</Item>
  </hiddenDressSlots>
  <jumpSettings>
    <jumpMinVelocity>6</jumpMinVelocity>
    <specialJump href="/Client/VisualMountClasses/SpecialJump.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
    <specialJumpPause>3100</specialJumpPause>
    <useJump>RUN_FORWARD</useJump>
  </jumpSettings>
  <levelChangedScript href="/Spells/VisScripts/Commands/LevelUp_Mount.(CreatureVisActionResource).xdb#xpointer(/client.VisualConstructor.CreatureVisActionResource)" />
  <pitchParameters>
    <maxPitch>30</maxPitch>
    <minStepDeltaT>150</minStepDeltaT>
    <minStepDeltaTMainAvatar>20</minStepDeltaTMainAvatar>
    <minTurnRadius>15</minTurnRadius>
    <minVelocity>6</minVelocity>
    <minVelocityPitch>1</minVelocityPitch>
    <pitchMaxVelocity>60</pitchMaxVelocity>
    <topVelocity>10</topVelocity>
    <topVelocityPitch>30</topVelocityPitch>
  </pitchParameters>
  <reinsSettings>
    <disablingAnimations href="/Client/VisualMountClasses/Horse/DisableReins.(CharacterAnimationsGroup).xdb#xpointer(/client.VisualConstructor.CharacterAnimationsGroup)" />
    <handBone>Slot_Hand_L</handBone>
    <handBone01>Slot_Hand_R</handBone01>
    <member>Assaulter</member>
    <reinsBone>Slot_Reins</reinsBone>
    <reinsBone01>Slot_Reins01</reinsBone01>
    <use>true</use>
  </reinsSettings>
  <riderOrientation>All_FromMountSlot</riderOrientation>
  <sitAnimation>mountRideSit</sitAnimation>
  <skinChangedScript href="/Spells/VisScripts/Commands/ChangeSkin.(CreatureVisActionResource).xdb#xpointer(/client.VisualConstructor.CreatureVisActionResource)" />
  <summonVisualScript href="/Spells/VisScripts/Mount/SummonCommonHorse.(SpellVisScripts).xdb#xpointer(/client.VisualConstructor.SpellVisScripts)" />
  <nonDismountable>false</nonDismountable>
  <useRiderSpineTurn>false</useRiderSpineTurn>
</VisualMountClass>