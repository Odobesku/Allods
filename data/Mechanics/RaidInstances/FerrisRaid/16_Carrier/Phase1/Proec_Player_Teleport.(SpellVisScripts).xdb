<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<PreCastAnimation />
			<PreCastFX />
			<FXPocket />
			<FXProjectile>/Spells/FX/World/Empty.(VisObjectTemplate).xdb</FXProjectile>
			<FXProjectileHit>/Spells/FX/Spells/Carrier_PlayerTeleport_FX.(VisObjectTemplate).xdb</FXProjectileHit>
			<CastAnimation>instantSpellCastOmniWand</CastAnimation>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<FXWand>/Spells/FX/Spells/ReadySpellDirectHolyWand_Cast.(VisObjectTemplate).xdb</FXWand>
			<ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
			<FXHands>/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb</FXHands>
		</Variables>
	</Header>
	<actionBarStart />
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FXHands" />
						<effectAlias href="" />
						<locator>Slot_Hand_L</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<visActionID />
		<play>InSequence</play>
		<playWhile />
		<preconditional>false</preconditional>
		<elements>
			<Item type="CreatureAnimationAction">
				<visActionID />
				<mode>DIE</mode>
				<use>USE_ANIMATIONS</use>
				<animations>
					<Item var="CastAnimation" />
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
				<channelOverrideScript />
				<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
				<specialController />
				<advanced>
					<speed>0</speed>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ABILITY</channelAfterFirstKey>
					<offendType>NO_OFFEND</offendType>
					<stopIfRotated>false</stopIfRotated>
					<stopIfMoved>false</stopIfMoved>
					<autoHasten>
						<mode>AUTOHASTEN_NONE</mode>
						<timeToBeLeft>0</timeToBeLeft>
					</autoHasten>
					<denyAutoHasten>false</denyAutoHasten>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<animationKeysAction />
					<animationKeysSound />
					<animationKeysActionPeriod />
					<turnToTarget>TURN_DEFAULT</turnToTarget>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
					<disableRandomFirstFrame>true</disableRandomFirstFrame>
					<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<visActionID />
				<play>Simultaneously</play>
				<playWhile />
				<preconditional>false</preconditional>
				<elements>
					<Item type="CreatureEffectsAction">
						<visActionID />
						<visualEffects>
							<Item>
								<delay>0</delay>
								<effectFx hrefvar="FXWand" />
								<effectAlias href="" />
								<effectAnimations>
									<mode>DIE</mode>
									<animations />
								</effectAnimations>
								<fixPoint>true</fixPoint>
								<lockScale>false</lockScale>
								<scale>1</scale>
								<fadeInTime>0</fadeInTime>
								<fadeOutTime>0</fadeOutTime>
								<locator>Wand_Slot_FX</locator>
								<member>Default_Member</member>
								<locatorName />
								<offendTime />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
								<offset x="0" y="0" z="0" />
								<rotation x="0" y="0" z="0" />
								<ignoreParentRotation>false</ignoreParentRotation>
							</Item>
						</visualEffects>
						<stopOnDeath>false</stopOnDeath>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
						<category>EFFECT_DEFAULT</category>
					</Item>
					<Item type="VisActionList">
						<visActionID />
						<play>InSequence</play>
						<playWhile />
						<preconditional>false</preconditional>
						<elements>
							<Item type="CreatureVisActionStartThrow">
								<visActionID />
							</Item>
							<Item type="CreatureProjectileAction">
								<visActionID />
								<projectileFx hrefvar="FXProjectile" />
								<explosionFx hrefvar="FXProjectileHit" />
								<isMultyProjectile>false</isMultyProjectile>
								<theGe>0</theGe>
								<pointOnCaster type="VisPointLocator">
									<shift x="0" y="0" z="0" />
									<locator var="LocatorOnCaster" />
									<member>Default_Member</member>
									<locatorName />
									<from>FROM_DEFALUT</from>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<shift x="0" y="0" z="0" />
									<locator var="ProjectileLocatorOnTarget" />
									<member>Default_Member</member>
									<locatorName />
									<from>FROM_DEFALUT</from>
								</pointOnTarget>
								<isInverted>false</isInverted>
								<offendTime type="EffectOffendConstDelay">
									<delay>0</delay>
								</offendTime>
								<optionalSpeed>0</optionalSpeed>
							</Item>
						</elements>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
						<restartOnVisualChange>false</restartOnVisualChange>
					</Item>
				</elements>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
				<restartOnVisualChange>false</restartOnVisualChange>
			</Item>
		</elements>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
		<restartOnVisualChange>false</restartOnVisualChange>
	</launch>
	<charged />
</SpellVisScripts>
