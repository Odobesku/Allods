<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>222385</resourceId>
    </Header>
    <Name href="Jump.(SpellSingleTarget).Name.txt" />
    <Description href="Jump.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/GetOnTheShip.(UISingleTexture).xdb" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                        <zone href="JumpZone_L.(ScriptZone).xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactAvatarJump">
                        <destination type="gameMechanics.map.destination.DestinationLocator">
                            <locator>
                                <scriptID>13_JumpDestRight</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </locator>
                        </destination>
                        <speed>20</speed>
                        <impactsOnLand>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Boss/SidePanels/LeftZoneVictim.(BuffResource).xdb" />
                            </Item>
                        </impactsOnLand>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                <zone href="JumpZone_R.(ScriptZone).xdb" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactAvatarJump">
                                <destination type="gameMechanics.map.destination.DestinationLocator">
                                    <locator>
                                        <scriptID>13_JumpDestLeft</scriptID>
                                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                    </locator>
                                </destination>
                                <speed>20</speed>
                                <impactsOnLand>
                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                        <buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Boss/SidePanels/LeftZoneVictim.(BuffResource).xdb" />
                                    </Item>
                                </impactsOnLand>
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsElse>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Boss/SidePanels/LeftZoneVictim.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>