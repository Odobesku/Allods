    <actions>
        <Item type="itemService.avatar.itemBag.IfTakeAction">
            <predicate type="itemService.mail.predicates.PredicateAnd">
                <predicates>
                    <Item type="itemService.mail.predicates.PredicateAltCurrencyGE">
                        <currency href="/Mechanics/InstancedEventResource/CommonMechanics/WipeKeysWarning.(AlternativeCurrency).xdb" />
                        <value>1</value>
