<?xml version="1.0" encoding="UTF-8" ?>
<basement.server.config.ServerBuild>
    <Header>
        <resourceId>122637370</resourceId>
    </Header>
    <name>cork</name>
    <oneThread>false</oneThread>
    <checkLocaleReferences>false</checkLocaleReferences>
    <allowNotIndexedResources>false</allowNotIndexedResources>
    <restrictedMapsLoading>false</restrictedMapsLoading>
    <isIndexUploadEnabled>false</isIndexUploadEnabled>
    <clientStatsPeriodSeconds>600</clientStatsPeriodSeconds>
    <fixAvatarPositionOnEnter>true</fixAvatarPositionOnEnter>
    <UIChunkFrequencyHandlerSettings>
        <switchingPeriodLongCount>2000000</switchingPeriodLongCount>
        <switchingPeriodLongSec>2</switchingPeriodLongSec>
        <switchingPeriodShortCount>1000000</switchingPeriodShortCount>
        <switchingPeriodShortSec>1</switchingPeriodShortSec>
        <switchingOffPeriodSec>0</switchingOffPeriodSec>
    </UIChunkFrequencyHandlerSettings>
</basement.server.config.ServerBuild>