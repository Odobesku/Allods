<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Carrier_Shield.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Mobs/Carrier_Shield_Aoe.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<offset z="-0.5" />
				<scale>1</scale>
				<lifeTime>3</lifeTime>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
