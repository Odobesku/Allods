<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<defaultVisAction type="DeviceVisActionList">
		<elements>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="TrainVisible.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptLoop type="DeviceAnimationAction">
					<mode>LOOP</mode>
					<channelId>1</channelId>
					<animations>
						<Item>idle</Item>
					</animations>
					<advanced />
				</visScriptLoop>
			</Item>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="NoTrain.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptLoop type="DeviceVisActionChangeModel" />
			</Item>
		</elements>
	</defaultVisAction>
</DeviceVisScripts>
