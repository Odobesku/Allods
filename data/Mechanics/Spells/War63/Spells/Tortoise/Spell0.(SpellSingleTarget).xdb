            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="CauterizationOfWounds.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateHasAbility">
                            <ability href="/Mechanics/Spells/War63/Abilities/TortoiseCanMove/Ability01.(AbilityResource).xdb" />
                        </predicate>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Stun.(BuffResource).xdb" />
                    </Item>
