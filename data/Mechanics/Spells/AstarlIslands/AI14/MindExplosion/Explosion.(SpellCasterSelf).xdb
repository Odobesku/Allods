    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="/Mechanics/Spells/AstarlIslands/AI14/Sacrifice/PowerCharge.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterConditions>
        <casterImpacts>
