<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>187789424</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>SL_Boss5Door</scriptID>
                        <map href="/Maps/Inst_SecretLab/astral_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Close</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="/Maps/Inst_SecretLab/ScriptZones/astral_DemonAggro.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                    <disable>true</disable>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                    <spawn>
                                        <scriptID>DemonBoss</scriptID>
                                        <map href="/Maps/Inst_SecretLab/astral_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                    </spawn>
                                    <onBehalfOfTarget>true</onBehalfOfTarget>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                            <value>10</value>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>