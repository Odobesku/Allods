			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
					<mark href="/Mechanics/Spells/Priest63/Spells/Intervention/InterventionAfterTP.(MarkResource).xdb" />
					<instantiateOnUse>false</instantiateOnUse>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactClientData">
							<data href="AE_heal_CD.(ClientData).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
									<radius>5</radius>
									<affectGroup>Group</affectGroup>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactHeal">
											<heal var="value" />
											<scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
										</Item>
										<Item type="gameMechanics.elements.impacts.ReturningImpact">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
													<impacts>
														<Item type="gameMechanics.elements.impacts.PostponedImpacts">
															<impacts>
																<Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
																	<spell href="/Mechanics/Spells/Priest63/Spells/Intervention/Spell03.(SpellArea).xdb" />
																	<factor type="gameMechanics.elements.scalers.LinearScaler">
																		<multiplier>1</multiplier>
																	</factor>
																	<sum type="gameMechanics.elements.calcers.LongData">
																		<value var="cd" />
																	</sum>
																</Item>
															</impacts>
														</Item>
													</impacts>
												</Item>
											</impacts>
										</Item>
									</impacts>
									<filter type="gameMechanics.world.creature.AvatarFilter" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
