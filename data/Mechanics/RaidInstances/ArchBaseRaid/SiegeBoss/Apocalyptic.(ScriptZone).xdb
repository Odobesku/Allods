<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>223691</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Normal_Mode_1.(BuffResource).xdb" />
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="Apocalyptic.(ScriptZone).xdb" />
                </Item>
            </impactsIf>
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="Artillery_Anons2.(BuffResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="Artillery_Anons.(BuffResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Hard_Mode_1.(BuffResource).xdb" />
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnCell">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Apocalyptic_HM.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="/Mechanics/RaidInstances/ArchBaseRaid/Other/R7_Veronica_Start.(SpawnTable).xdb" />
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Apocalyptic_Check_Buff_HM.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="Apocalyptic.(ScriptZone).xdb" />
                </Item>
            </impactsIf>
        </Item>
        <Item type="gameMechanics.elements.impacts.EntitytFindSpawnTable">
            <impacts>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impacts>
            <spawnResource href="/Mechanics/RaidInstances/ArchBaseRaid/Other/Apocalyptic_Door.(SpawnTable).xdb" />
        </Item>
    </impactsIn>
</gameMechanics.map.scriptZone.ScriptZone>