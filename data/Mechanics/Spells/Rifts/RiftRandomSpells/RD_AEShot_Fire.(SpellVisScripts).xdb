<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>ready</Item>
				</animations>
				<advanced>
					<speed>2</speed>
				</advanced>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpellDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownFire.(VisObjectTemplate).xdb" />
						<scale>1.5</scale>
						<locator>Slot_Global</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb" />
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb" />
						<locator>Slot_Hand_R</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb" />
						<scale>3</scale>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/AOEAura_Red_R5.(VisObjectTemplate).xdb" />
						<useCastPoint>true</useCastPoint>
						<lifeTime>2</lifeTime>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="CreatureRotateToCastPointAction" />
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>500</time>
			</Item>
			<Item type="CreatureLockRotationAction">
				<visActionID>LockRotation</visActionID>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/MageFireballAbility.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Spells/HitFireball.(VisObjectTemplate).xdb" />
						<theGe>6</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnCaster>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>600</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>LockRotation</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>