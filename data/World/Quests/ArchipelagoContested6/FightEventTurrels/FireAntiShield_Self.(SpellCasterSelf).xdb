    <Name href="FireAntiShieldName.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerAcidBolt.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>400</value>
    </range>
    <prepareDuration>0</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.world.device.cannon.DeviceHasUser" />
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.world.ship.parts.PredicateCannonTargetable" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="CritHit.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                <data href="/Mechanics/Ships/Cannon/CannonAttack.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
            <Item type="gameMechanics.world.device.cannon.ImpactSendLaunchEvent">
                <clientData href="FireAntiShield_ClientData.xdb#xpointer(/gameMechanics.world.device.cannon.AstralSpell)" />
                <fromDestination type="gameMechanics.map.destination.SelfPosDestination" />
                <targetDestination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierShiftForward">
                            <radius type="gameMechanics.elements.calcers.FloatData">
                                <value>400</value>
                            </radius>
                        </Item>
                    </modifiers>
                </targetDestination>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.world.device.cannon.ImpactCannonDamage">
                <damage type="gameMechanics.constructor.basicElements.ScalerCalcer">
                    <scaler type="gameMechanics.elements.scalers.ScalerMax">
                        <scaler1 type="gameMechanics.elements.scalers.TrivialScaler" />
                        <scaler2 type="gameMechanics.elements.scalers.ScalerBuff">
                            <buff href="CritHit.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
