<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpellDirectedWand</Item>
				</animations>
			</Item>
			<Item type="CreatureChangeVisItemsAction">
				<items>
					<Item>
						<slot>MAINHAND</slot>
						<newItem href="/Items/VisualItems/Weapon/Wand/Wand_1H_E_38_Praiden.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
					</Item>
				</items>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/World/AC7_Runed_Quest_Stone_Fog_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectLightningWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Wand_Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/World/AC7_Runed_Quest_Stone_Rune03_FX_Camera.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<isRelative>true</isRelative>
				<offset y="0" z="3" />
				<rotation x="0" y="0" />
				<scale>3</scale>
				<lifeTime>15</lifeTime>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
