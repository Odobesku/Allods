<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<defaultVisAction type="DeviceVisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="Flag_IceBarrier2_visible.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptLoop type="DeviceAnimationAction">
					<mode>LOOP</mode>
					<channelId>1</channelId>
					<animations>
						<Item>idle</Item>
					</animations>
					<advanced />
				</visScriptLoop>
			</Item>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="Flag_IceBarrier2_broken.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptLoop type="DeviceVisActionList">
					<play>Simultaneously</play>
					<elements>
						<Item type="DeviceVisActionChangeModel">
							<visObj href="/World/Generic/Caves/Models/ZC10_IceCave/ZC10_Ice_Barrier.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<collision href="/World/Generic/Caves/Models/ZC10_IceCave/ZC10_Ice_Barrier_AI_off.(Collision).xdb#xpointer(/Collision)" />
						</Item>
						<Item type="DeviceAnimationAction">
							<mode>LOOP</mode>
							<channelId>1</channelId>
							<animations>
								<Item>dead</Item>
							</animations>
						</Item>
						<Item type="DeviceVisEffectsAction">
							<visualEffects>
								<Item>
									<effectFx href="/Spells/FX/World/Ferris_IceBarrier_Dead_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								</Item>
							</visualEffects>
						</Item>
					</elements>
				</visScriptLoop>
			</Item>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="Flag_IceBarrier2_destruction.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptStart type="DeviceAnimationAction">
					<animations>
						<Item>special</Item>
					</animations>
				</visScriptStart>
			</Item>
		</elements>
	</defaultVisAction>
</DeviceVisScripts>
