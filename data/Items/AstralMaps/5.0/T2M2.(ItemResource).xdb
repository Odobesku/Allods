<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>520126</resourceId>
        <Prototype href="/Items/AstralMaps/Prototypes/Map.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
        <Variables>
            <money>1</money>
            <tierName>/Items/AstralMaps/Names/Map2.txt</tierName>
            <sectorName>/Items/AstralMaps/Names/Tier2.txt</sectorName>
            <maxMult>1.45</maxMult>
        </Variables>
    </Header>
    <functionalPart type="itemService.avatar.itemBag.UseOnItemAndTakeActions">
        <usages>
            <Item>
                <itemPredicate type="gameMechanics.elements.item.ItemPredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.constructor.schemes.item.ItemPredicateOneOf">
                            <items>
                                <Item href="T2M2.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                            </items>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.item.ItemPredicateGreater">
                            <lhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                                <value var="maxMult" />
                            </lhs>
                            <rhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerAstralMapMult" />
                        </Item>
                    </predicates>
                </itemPredicate>
                <useActions>
                    <Item type="itemService.avatar.itemBag.MergeAstralMap">
                        <range max="0.2" min="0.02" />
                        <max var="maxMult" />
                    </Item>
                </useActions>
                <consumeUsedItem>1</consumeUsedItem>
                <consumeTargetItem>1</consumeTargetItem>
                <usedItemPredicate type="gameMechanics.constructor.schemes.item.ItemPredicateGreater">
                    <lhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                        <value var="maxMult" />
                    </lhs>
                    <rhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerAstralMapMult" />
                </usedItemPredicate>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.constructor.basicElements.PredicateTrue" />
        </predicates>
    </functionalPart>
    <quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <name href="T2M2.(ItemResource).Name.txt" />
</gameMechanics.constructor.schemes.item.ItemResource>