    <mechanics>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormHole/WormHole.(MobWorld).xdb" />
