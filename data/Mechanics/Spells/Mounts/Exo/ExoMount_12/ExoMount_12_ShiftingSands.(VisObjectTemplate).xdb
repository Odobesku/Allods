<?xml version="1.0" encoding="UTF-8"?>
<VisObjectTemplate>
	<defaultState>
		<sound>
			<creationRadius>-1</creationRadius>
		</sound>
		<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
		<playSoundOnKeys>true</playSoundOnKeys>
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>150</fadeInMS>
	<fadeOutMS>150</fadeOutMS>
	<geometry href="/Spells/FX/Spells/Parts/Dummy.(Geometry).xdb#xpointer(/Geometry)" />
	<replaceDistance>-1</replaceDistance>
	<scale>1</scale>
	<sound>
		<creationRadius>-1</creationRadius>
	</sound>
	<visObjComponents>
		<Item type="client.Scene.DelayComponent">
			<component type="client.Scene.AttachedVisObjectComponent">
				<offset x="0" y="0" z="0" />
				<priority>0</priority>
				<rotation x="0" y="0" z="0" w="1" />
				<scale>1</scale>
				<visObject href="/Spells/FX/Mobs/MEV12Ability_02_CastSpellAoe.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
				<isPortraitEnabled>true</isPortraitEnabled>
				<lockScale>true</lockScale>
				<scaleFromGlobal>false</scaleFromGlobal>
				<skipSound>false</skipSound>
			</component>
			<timeMax>1.2</timeMax>
			<timeMin>1.2</timeMin>
			<skipLoading>true</skipLoading>
		</Item>
	</visObjComponents>
	<drawBehindCamera>false</drawBehindCamera>
	<softReplace>false</softReplace>
</VisObjectTemplate>