	<effects>
		<Item type="gameMechanics.elements.effects.NotStackableEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.MagicDoT">
					<parameters>
						<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
							<mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
								<calcers>
									<Item type="gameMechanics.constructor.basicElements.ScalerCalcer">
										<scaler type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
											<buff href="Buff001.xdb" />
											<anyRank>true</anyRank>
											<onlyFromMaster>true</onlyFromMaster>
											<mul>1</mul>
										</scaler>
										<value>1</value>
									</Item>
									<Item type="constructor.elements.CalcerFloatExternal">
										<externalCalcer hrefvar="externalCalcerBonus" />
									</Item>
								</calcers>
							</mulCalcer>
							<sum>1</sum>
						</scalerTarget>
						<scaleOnTick>true</scaleOnTick>
						<tickLength>1000</tickLength>
						<damagePerTick>1</damagePerTick>
						<impactsPerTick>
							<Item type="gameMechanics.elements.impacts.StackBuff">
