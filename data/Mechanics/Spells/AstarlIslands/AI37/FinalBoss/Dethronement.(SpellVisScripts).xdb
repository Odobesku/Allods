<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect02Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>emoteDance</Item>
                </animations>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>battleRoar</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <delay>1000</delay>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectDiseaseWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_FX</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>