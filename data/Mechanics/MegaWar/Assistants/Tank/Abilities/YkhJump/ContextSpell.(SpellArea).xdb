<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>227714</resourceId>
    </Header>
    <Name href="ContextSpell.(SpellArea).Name.txt" />
    <image href="/Interface/Icons/Special/Emotions/Welcome.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>30000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                <impacts>
                    <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                                <time>650</time>
                                <impactsOnLand>
                                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                        <data href="/Spells/ClientData/HowlingStrike.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                                <radius>10</radius>
                                                <affectGroup>Enemies</affectGroup>
                                                <impacts>
                                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                        <buff href="Howling.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                    </Item>
                                                </impacts>
                                                <filter type="gameMechanics.world.creature.AliveFilter" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impactsOnLand>
                                <destination type="gameMechanics.map.destination.DestinationModified">
                                    <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                                    <modifiers>
                                        <Item type="gameMechanics.map.destination.modifier.ModifierIfCheckPath">
                                            <pathChecker type="space.pathfinding.pathChecker.PathLenghtLimited">
                                                <maxLength>70</maxLength>
                                            </pathChecker>
                                            <modifierElse type="gameMechanics.map.destination.modifier.ModifierTrailFrom">
                                                <from type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                                            </modifierElse>
                                        </Item>
                                    </modifiers>
                                </destination>
                            </Item>
                        </impacts>
                        <assistantResource href="/Mechanics/MegaWar/Assistants/Tank/AssistantResource.xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="ContextBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>5</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>