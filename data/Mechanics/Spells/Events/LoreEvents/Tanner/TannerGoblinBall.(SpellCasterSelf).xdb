<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>368793606</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Events/EventSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
	<Name href="TannerGoblinBall.(SpellCasterSelf).Name.txt" />
	<Description href="TannerGoblinBall.(SpellCasterSelf).Description.txt" />
	<targetType>STTSelf</targetType>
	<mechanics>
		<cooldown>
			<duration>60000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateMobNear">
					<radius>20</radius>
					<mobs>
						<Item href="GoblinOnTheBall.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
					</mobs>
				</predicate>
			</Item>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
					<rule href="/Mechanics/Rules/NoFunItems.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
				</predicate>
			</Item>
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceActiveItem" />
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactSummon">
				<destination type="gameMechanics.map.destination.RelativeTrailPos">
					<center type="gameMechanics.map.destination.RelativePos">
						<yaw type="constructor.basicElements.AngleRadians" />
					</center>
					<offset x="2" y="2" z="0" />
				</destination>
				<object href="GoblinOnTheBall.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
			</Item>
		</casterImpacts>
	</mechanics>
	<iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
