<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>204663</resourceId>
    </Header>
    <Name href="Bleeding.txt" />
    <Description href="Bleeding.Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorRend.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.PhysicalDoT">
            <parameters>
                <scalerTarget type="gameMechanics.elements.scalers.ScalerIf">
                    <condition type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.predicates.PredicateMounted" />
                        </predicates>
                    </condition>
                    <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>2</multiplier>
                    </scalerIf>
                    <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>1</multiplier>
                    </scalerElse>
                </scalerTarget>
                <scaleOnTick>true</scaleOnTick>
                <damagePerTick>1</damagePerTick>
            </parameters>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>0.02</mul>
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer href="/Mechanics/GameRoot/Mount/MountBaseDamageCalcer.(CalcerFloatResource).xdb#xpointer(/constructor.elements.CalcerFloatResource)" />
                </mulCalcer>
            </scaler>
            <considerOutgoingModifiers>false</considerOutgoingModifiers>
        </Item>
    </effects>
    <duration>6000</duration>
    <stackLimit>3</stackLimit>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>