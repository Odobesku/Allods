<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>479029</resourceId>
        <Prototype href="DefenceEssence.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
        <Variables>
            <budget>10</budget>
            <consumeUsedItem>0</consumeUsedItem>
            <category>/Items/MetaItems/700+Sets/NonReforge.(ItemCategoryTerminal).xdb</category>
        </Variables>
    </Header>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <functionalPart type="itemService.avatar.itemBag.UseOnItemAndTakeActions">
        <usages>
            <Item>
                <useActions>
                    <Item type="itemService.avatar.itemBag.ChangeBudgetModTakeAction">
                        <delta>
                            <min>1</min>
                            <max>1</max>
                        </delta>
                        <trimResultBudgetMod>
                            <min>50</min>
                            <max>100</max>
                        </trimResultBudgetMod>
                        <budgetType>DefenceBudget</budgetType>
                    </Item>
                </useActions>
                <consumeUsedItem>1</consumeUsedItem>
            </Item>
        </usages>
    </functionalPart>
    <quality href="/Mechanics/ItemQualities/Legendary.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <binding>BindOnPickup</binding>
    <lifeLengthCap>2592000000</lifeLengthCap>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="DefenceEssence.(ItemResource).Name.txt" />
    <description href="DefenceEssence.(ItemResource).Description.txt" />
</gameMechanics.constructor.schemes.item.ItemResource>