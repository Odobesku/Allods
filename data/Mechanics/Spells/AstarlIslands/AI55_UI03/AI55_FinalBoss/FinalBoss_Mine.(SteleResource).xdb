<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
    <Header>
        <resourceId>739857016</resourceId>
    </Header>
    <persistentParts>
        <Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>2000</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.TickableEntityAura">
                            <tick>1000</tick>
                            <affectGroup>All</affectGroup>
                            <radius>1</radius>
                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                <filters>
                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                    <Item type="gameMechanics.constructor.basicElements.FilterNot">
                                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="BuffKnockDown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                        </filter>
                                    </Item>
                                </filters>
                            </filter>
                            <impactsIn>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        </moveType>
                                        <resource href="MineTriggeredExplosion.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                    </projectileData>
                                </Item>
                            </impactsIn>
                            <holderImpactsIn>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>300</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.device.DeviceDie" />
                                    </impacts>
                                </Item>
                            </holderImpactsIn>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>25000</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        </moveType>
                                        <resource href="MineTriggeredExplosion.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                    </projectileData>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>300</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.device.DeviceDie" />
                                    </impacts>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </persistentParts>
    <name href="FinalBoss_Mine.(SteleResource).Name.txt" />
    <visObj href="MineProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <collisionObject>false</collisionObject>
    <interactiveObject>true</interactiveObject>
    <exploitingText href="FinalBoss_Mine.(SteleResource).ExploitingText.txt" />
    <spell href="FinalBoss_Mine.(Exploit).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
