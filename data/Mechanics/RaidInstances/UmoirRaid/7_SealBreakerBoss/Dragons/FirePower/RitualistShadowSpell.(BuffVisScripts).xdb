<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownDisease.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.5</scale>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectDisease.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectDisease.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<visActionID>Loop</visActionID>
				<mode>LOOP</mode>
				<animations>
					<Item>readyCast</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>4000</time>
					</Item>
					<Item type="VisActionList">
						<elements>
							<Item type="VisActionStopAction">
								<stoppedActionID>Loop</stoppedActionID>
							</Item>
							<Item type="CreatureAnimationAction">
								<animations>
									<Item>spellCastOmni</Item>
								</animations>
								<advanced>
									<speed>0.8</speed>
								</advanced>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
