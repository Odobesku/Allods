<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <FXProjectile>/Spells/FX/Mobs/IceElemental.SpecialCast_Projectile02.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
            <FXProjectileHit>/Spells/FX/Spells/HitIce.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
            <ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
            <Ge>0</Ge>
            <LocatorOnCaster>Slot_Hand_R</LocatorOnCaster>
            <PreCastAnimation>spellCastDirected</PreCastAnimation>
            <FxOnHands>/Spells/FX/Spells/PocketSpellIce01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
        </Variables>
    </Header>
    <wholeCasting type="VisActionList">
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx hrefvar="FxOnHands" />
                        <scale>4</scale>
                    </Item>
                    <Item>
                        <scale>2</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <play>InSequence</play>
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item skiped="" />
                    <Item type="VisActionList">
                        <elements>
                            <Item skiped="" />
                            <Item type="CreatureProjectileAction">
                                <pointOnCaster type="VisPointLocator">
                                    <locator var="LocatorOnCaster" />
                                </pointOnCaster>
                                <isInverted>false</isInverted>
                            </Item>
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>