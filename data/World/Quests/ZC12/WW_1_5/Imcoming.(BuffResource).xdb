<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739975285</resourceId>
	</Header>
	<Name href="Imcoming.(BuffResource).Name.txt" />
	<Description href="Imcoming.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Quest/BlackMark.(UISingleTexture).xdb" />
	<visScript href="Incoming.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="Smoke.(BuffResource).xdb" />
							</predicate>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
									<spawn>
										<scriptID>ShootPoint</scriptID>
										<map href="/Maps/ZC12/MapResource.xdb" />
									</spawn>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
											<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
											<data href="ThatGodDamnedNotWorkingClientData.(ClientData).xdb" />
											<calcers>
												<addressEntries>
													<Item>
														<name>target</name>
														<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
													</Item>
													<Item>
														<name>caster</name>
														<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
													</Item>
												</addressEntries>
											</calcers>
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_7/FirstHit.(BuffResource).xdb" />
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactKill" />
									</impactsIf>
									<impactsElse>
										<Item type="gameMechanics.elements.impacts.DirectDamage">
											<damage>1</damage>
											<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
													<multiplier>0.85</multiplier>
												</mulCalcer>
											</scalerTarget>
										</Item>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_7/FirstHit.(BuffResource).xdb" />
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactDismount" />
									</impactsElse>
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
											<spawn>
												<scriptID>ShootPoint</scriptID>
												<map href="/Maps/ZC12/MapResource.xdb" />
											</spawn>
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
													<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
													<data href="ThatGodDamnedNotWorkingClientData.(ClientData).xdb" />
													<calcers>
														<addressEntries>
															<Item>
																<name>target</name>
																<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
															</Item>
															<Item>
																<name>caster</name>
																<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
															</Item>
														</addressEntries>
													</calcers>
												</Item>
											</impacts>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactKill" />
									</impacts>
								</Item>
							</impactsElse>
						</Item>
					</impactsIf>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.BuffInterceptor">
			<impactsOnAttach>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>ShootPoint</scriptID>
						<map href="/Maps/ZC12/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
							<data href="ShotMiss1.(ClientData).xdb" />
							<calcers>
								<addressEntries>
									<Item>
										<name>target</name>
										<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
									</Item>
									<Item>
										<name>caster</name>
										<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
									</Item>
								</addressEntries>
							</calcers>
						</Item>
					</impacts>
				</Item>
			</impactsOnAttach>
			<detachType>DetachOnly</detachType>
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.PredicateBuffEquals">
					<buff href="Smoke.(BuffResource).xdb" />
				</Item>
			</predicates>
		</Item>
	</effects>
	<duration>3000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
