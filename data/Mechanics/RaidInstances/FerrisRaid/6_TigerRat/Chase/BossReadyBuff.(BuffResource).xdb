<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222652</resourceId>
    </Header>
    <Name href="BossReadyBuff.(BuffResource).Name.txt" />
    <Description href="BossReadyBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorInnerRage.chn.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="BossChaseBuff.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>100</multiplier>
                            </durationScaler>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="BossChaseBuff.(BuffResource).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectForcedAggroLeader" />
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/RaidInstances/Phase4.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="BossChaseBuff.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.RandomImpactGeneric">
                                            <entries>
                                                <Item>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                                            <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                                                <range min="0" max="1" />
                                                                <withinRange>false</withinRange>
                                                                <minCandidatesCount>3</minCandidatesCount>
                                                                <targetCount>3</targetCount>
                                                            </selector>
                                                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                                <predicates>
                                                                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                                                        <predicates>
                                                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/6_TigerRat/JumpSeries/JumpTarget.(BuffResource).xdb" />
                                                                                </predicate>
                                                                            </Item>
                                                                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                                                        </predicates>
                                                                    </Item>
                                                                </predicates>
                                                            </filter>
                                                            <impacts>
                                                                <Item>
                                                                    <impacts>
                                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/6_TigerRat/JumpSeries/JumpTarget.(BuffResource).xdb" />
                                                                        </Item>
                                                                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                                                            <impacts>
                                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/6_TigerRat/JumpSeries/JumpResource.(BuffResource).xdb" />
                                                                                </Item>
                                                                            </impacts>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                                <Item>
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/6_TigerRat/Howl/HowlPrepare.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </entries>
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ChaseHMCooldown.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/6_TigerRat/Unworthy.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                    <spell href="ChaseSpell.(SpellArea).xdb" />
                    <duration>
                        <hour>1</hour>
                    </duration>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                    <spell href="ChaseSpell1.(SpellArea).xdb" />
                    <duration>
                        <hour>1</hour>
                    </duration>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                    <spell href="ChaseSpell2.(SpellArea).xdb" />
                    <duration>
                        <hour>1</hour>
                    </duration>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                    <spell href="ChaseSpell3.(SpellArea).xdb" />
                    <duration>
                        <hour>1</hour>
                    </duration>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/Taunt.xdb" />
            </groups>
        </Item>
    </effects>
    <duration>3000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/RaidInstances/UmoirMound/07_Party/RemoveableByScroll.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>