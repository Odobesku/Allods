<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>323520654</resourceId>
    </Header>
    <Name href="DeepRoar.(SpellArea)_Name.txt" />
    <Description href="DeepRoar.(SpellArea)_Desc.txt" />
    <visualScripts href="Roar.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="DeepRoar.(SpellArea)_Name.txt.template" />
    <descTemplate href="DeepRoar.(SpellArea)_Desc.txt.template" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <prepareDuration>1000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>40000000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                <spell href="CrabClear.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                <pool href="BlackSeeManPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                <impacts>
                    <Item type="gameMechanics.elements.impacts.Disintegrate" />
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                        <time>1000</time>
                        <impactsOnLand>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="CrabForm.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsOnLand>
                        <distance>30</distance>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ForceAggro" />
                        </impacts>
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <maxTargets>6</maxTargets>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>50</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>