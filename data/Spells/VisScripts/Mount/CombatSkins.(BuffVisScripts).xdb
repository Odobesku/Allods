						<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton03Purple.(VisualMount).xdb#xpointer(/VisualMount)" />
						<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton04Base.(VisualMount).xdb#xpointer(/VisualMount)" />
						<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton04Lion.(VisualMount).xdb#xpointer(/VisualMount)" />
						<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton04Raid.(VisualMount).xdb#xpointer(/VisualMount)" />
