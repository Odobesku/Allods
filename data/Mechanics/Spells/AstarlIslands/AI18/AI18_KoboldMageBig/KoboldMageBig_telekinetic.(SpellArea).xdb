<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>194269</resourceId>
    </Header>
    <Name href="KoboldMageBig_telekinetic.(SpellArea).Name.txt" />
    <visualScripts href="KoboldMageBig_telekinetic.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <needLos>false</needLos>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>20000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                <spell href="KoboldMageBig_fireball.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>1000</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactStartSpell">
                        <spell href="KoboldMageBig_fireball.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                        <spellTarget type="gameMechanics.elements.addresseeFinders.AddresseeFinderNearestTarget">
                            <radius>40</radius>
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                    <onSlave type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="KoboldMageBig_telekinetic.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/AstarlIslands/AI18/AI18_knockdown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                        </predicates>
                                    </onSlave>
                                </Item>
                            </predicates>
                        </spellTarget>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="KoboldMageBig_telekinetic.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </targetImpacts>
    </mechanics>
    <radius>20</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>