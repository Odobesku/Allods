<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>250645</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="AutoAttack.(SpellSingleTarget).Name.txt" />
    <image href="/Interface/Icons/Spells/AutoAttack.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="AutoAttack.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <sysName>MeeleeAttack</sysName>
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <iffPolicy>Enemies</iffPolicy>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>1</duration>
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            <scaler type="gameMechanics.elements.scalers.WeaponSpeedScaler" />
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>12.5</mana>
                <scaleByWeaponSpeed>true</scaleByWeaponSpeed>
                <manaType>
                    <Item>Energy</Item>
                </manaType>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateManaCaster">
                                <manaType>Mana</manaType>
                            </Item>
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                                <impactsOnHitCaster>
                                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                        <mark href="/Mechanics/Spells/Marks/WarriorStrike.xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
                                    </Item>
                                </impactsOnHitCaster>
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                <avgDamage>5.775</avgDamage>
                            </Item>
                        </impacts>
                        <elseImpacts>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                                <impactsOnHitCaster>
                                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                        <mark href="/Mechanics/Spells/Marks/WarriorStrike.xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
                                    </Item>
                                </impactsOnHitCaster>
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                <avgDamage>8.75</avgDamage>
                            </Item>
                        </elseImpacts>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                        <avgDamage>25</avgDamage>
                    </Item>
                </elseImpacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>