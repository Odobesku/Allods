<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739877440</resourceId>
		<Prototype href="/Items/InteractiveObjects/Templates/Exploit.xdb" />
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
	</groups>
	<isExploit>true</isExploit>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>5</value>
	</range>
	<prepareDuration>1000</prepareDuration>
	<targetType>STTCurrentTargetNotSelf</targetType>
	<iffPolicy>Everyone</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateCanTake">
								<item href="/Items/QuestItems/UmoirMound/UM_Q02_SwordHandle/UM_Q02_SwordHandle.(ItemResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
								<quest href="/World/Quests/UmoirMound/UM_Q02/UM_Q02.xdb" />
								<status>Started</status>
							</Item>
						</predicates>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ImpactGiveItem">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="/Items/QuestItems/UmoirMound/UM_Q02_SwordHandle/UM_Q02_SwordHandle.(ItemResource).xdb" />
						</item>
					</Item>
				</impactsIf>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.device.DeviceDie" />
			<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
				<visualState>1</visualState>
			</Item>
		</targetImpacts>
	</mechanics>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
