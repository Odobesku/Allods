<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>219165</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <descVars>
        <Item>
            <name>var0</name>
            <value var="multiplier" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent1MinusAbs</formula>
            </scaler>
        </Item>
        <Item>
            <name>var2</name>
            <value var="factor" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent1MinusAbs</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Equipment/Shield/ShieldKania01.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Ability_Name.txt.template" />
    <descTemplate href="Ability_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/WarriorV3/Toughness/Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.effects.ImpactHealDamageThreshold">
                                    <heal>1</heal>
                                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                            <multiplier var="multiplier" />
                                        </mulCalcer>
                                    </scaler>
                                    <resource href="/Mechanics/Spells/WarriorV3/Toughness/Toughness.(DamageThresholdResource).xdb#xpointer(/gameMechanics.elements.effects.DamageThresholdResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.PureHeal">
                            <heal>1</heal>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.5</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier var="multiplier" />
                                </mulCalcer>
                            </scalerTarget>
                            <scalerCaster type="gameMechanics.elements.scalers.TrivialScaler" />
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
            <tick>4000</tick>
            <initialDelay>2000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
            <spell href="/Mechanics/Spells/WarriorV3/ToughSpells/Reset.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            <factor var="factor" />
        </Item>
        <Item type="gameMechanics.elements.effects.BuffDurationModifier">
            <buffs>
                <Item href="/Mechanics/Spells/WarriorV3/ToughSpells/Reset.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </buffs>
            <multiplier type="gameMechanics.elements.calcers.FloatData">
                <value var="value" />
            </multiplier>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability02.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability03.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>