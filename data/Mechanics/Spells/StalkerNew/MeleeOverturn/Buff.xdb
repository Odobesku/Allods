<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>218520</resourceId>
    </Header>
    <Name href="Buff_Name.txt" />
    <Description href="Buff_Desc.txt" />
    <image href="/Interface/Icons/Spells/Stalker/StalkerOverturn.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Stalker/Overturn.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/StalkerNew/ActiveDefence/Defence.(BuffResource).xdb" />
                    <stacks type="gameMechanics.elements.calcers.FloatData">
                        <value>2</value>
                    </stacks>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectForceMove">
            <destinations>
                <Item type="gameMechanics.elements.calcers.DestinationSpellTargetThrust">
                    <maxDist>4</maxDist>
                </Item>
            </destinations>
            <impactsOnPathNotFound>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactResetActiveAction">
                            <cause>NoPath</cause>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnPathNotFound>
            <baseSpeedFactor>4</baseSpeedFactor>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllSpells">
            <doReset>false</doReset>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <stackLimit>1</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>false</isDetachableOnWill>
    <isMultiple>false</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>