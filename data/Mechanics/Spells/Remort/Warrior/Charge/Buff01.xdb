    <image href="/Interface/Icons/Spells/Warrior/WarriorCharge.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/VisScripts/Warrior/Charge.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.Charge">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                    <impactsOnHitTarget>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="/Spells/ClientData/Charge.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impactsOnHitTarget>
                    <scaler type="gameMechanics.elements.scalers.ScalerMax">
                        <scaler1 type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                                <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                            </scalers>
                        </scaler1>
                        <scaler2 type="gameMechanics.elements.scalers.MagicScaler" />
                    </scaler>
                    <avgDamage>23.5</avgDamage>
                </Item>
            </impacts>
            <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            <speedFactor>3</speedFactor>
            <predicate type="gameMechanics.elements.predicates.PredicateReachTarget" />
            <pathChecker type="space.pathfinding.pathChecker.PathDeviationLimited">
                <angle>0.5236</angle>
            </pathChecker>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
            <predicate type="gameMechanics.constructor.basicElements.PredicateGenericNot">
                <predicate type="gameMechanics.constructor.basicElements.PredicateGenericOr">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                            <group href="/Mechanics/Spells/Groups/VoiceSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                            </spells>
                        </Item>
                    </predicates>
                </predicate>
            </predicate>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.EffectList">
            <effectsResource href="/Mechanics/Spells/CommonBuffs/Immunity/CrowdControlImmunityAttach.(EffectListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.EffectListResource)" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/Knockdowns.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/Fears.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/Blinds.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/Disarms.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/Silence.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/Stuns.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                    </groups>
                </Item>
            </predicates>
        </Item>
    </effects>
    <duration>6000</duration>
    <isStackable>false</isStackable>
    <stackLimit>1</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>false</isDetachableOnWill>
    <isMultiple>false</isMultiple>
