<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmniMindShield</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>200</delay>
						<effectFx href="/Spells/FX/Spells/Paladin63_GroupBuff.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>400</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb" />
								<locator>Slot_Hand_L</locator>
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb" />
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
					<name>spells/Paladin/Paladin63/Paladin63GroupBuff</name>
				</sound>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
