<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>313612</resourceId>
    </Header>
    <visObject href="/Spells/FX/Spells/Projectile_Bones.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0.5</altitude>
    <lifeLengthCap>60000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <useIFFOwnerInfluence>true</useIFFOwnerInfluence>
            <affectGroup>All</affectGroup>
            <radius>5</radius>
            <filter type="gameMechanics.world.creature.MobFilter" />
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="/Creatures/SnowFolk/Instances/Ferris/Snowfolk_Ferris_1_event.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                <Item href="/Creatures/SnowFolk/Instances/Ferris/Snowfolk_ranger_Ferris_1_event.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                <Item href="/Creatures/SnowFolk/Instances/Ferris/Snowfolk_Ferris_event_1_rule.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                <Item href="/Creatures/SnowFolk/Instances/Ferris/Snowfolk_ranger_ferris_event_1_rule.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Knockdown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <holderImpactsIn>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </holderImpactsIn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>