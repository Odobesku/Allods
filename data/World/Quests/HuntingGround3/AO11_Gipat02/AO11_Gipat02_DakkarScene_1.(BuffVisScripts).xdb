<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionChangeVisObject">
        <newVisMob href="/Creatures/NotCreatures/EmptyMob/EmptyMob.(VisualMob).xdb#xpointer(/client.VisualConstructor.VisualMob)" />
        <getBody>true</getBody>
        <getDress>true</getDress>
      </Item>
      <Item type="client.Replica.VisActionDelay">
        <time>100</time>
      </Item>
      <Item type="client.SLON.CreatureIndependentFxAction">
        <lifeTime>1</lifeTime>
        <offset x="0" y="0" z="0" />
        <rotation x="0" y="0" z="0" />
        <scale>1</scale>
        <visEventPointIndex>-1</visEventPointIndex>
        <visObject href="/Spells/FX/Spells/PetTeleportFx.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
        <isRelative>true</isRelative>
        <useCastPoint>false</useCastPoint>
      </Item>
    </elements>
    <play>InSequence</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>