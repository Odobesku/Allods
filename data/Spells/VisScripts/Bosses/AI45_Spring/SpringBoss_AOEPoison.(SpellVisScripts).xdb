<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>6000</time>
				</playWhile>
				<elements>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Creatures/Spring/SpringDragon.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<rotation x="0" y="0" z="0" w="1" />
								<scale>0.5</scale>
								<locatorName>Slot_Global</locatorName>
								<lockScale>true</lockScale>
							</Item>
						</visObjComponents>
					</Item>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Creatures/Spring/SpringDragon.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<rotation z="1" w="0" />
								<scale>0.5</scale>
								<locatorName>Slot_Global</locatorName>
								<lockScale>true</lockScale>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
		</elements>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>800</time>
					</Item>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Mobs/SpringDragon_Flash01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>3</scale>
								<offset z="10" />
								<locatorName>Slot_Global</locatorName>
								<lockScale>true</lockScale>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
