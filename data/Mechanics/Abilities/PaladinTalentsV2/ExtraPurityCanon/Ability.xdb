                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                            <group href="/Mechanics/Spells/Groups/MeleeAttacks.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
