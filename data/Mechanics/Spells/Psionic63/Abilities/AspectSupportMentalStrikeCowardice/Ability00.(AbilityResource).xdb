    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Psionic/PsionicMindLeechUpgrade.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIf">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                            <onSlave type="gameMechanics.elements.predicates.PredicateHasSpell">
                                <spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Cowardice/Cowardice1.(SpellSingleTarget).xdb" />
                            </onSlave>
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                            <targetImpacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Cowardice/Cowardice.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.ScalerIf">
                                        <condition type="gameMechanics.elements.predicates.PredicateHasSpell">
                                            <spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Cowardice/Cowardice1.(SpellSingleTarget).xdb" />
                                            <anyRank>false</anyRank>
                                        </condition>
                                        <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>0.7</multiplier>
                                        </scalerIf>
                                        <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                            <condition type="gameMechanics.elements.predicates.PredicateHasSpell">
                                                <spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Cowardice/Cowardice2.(SpellSingleTarget).xdb" />
                                                <anyRank>false</anyRank>
                                            </condition>
                                            <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier>1.4</multiplier>
                                            </scalerIf>
                                            <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                                <condition type="gameMechanics.elements.predicates.PredicateHasSpell">
                                                    <spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Cowardice/Cowardice3.(SpellSingleTarget).xdb" />
                                                    <anyRank>false</anyRank>
                                                </condition>
                                                <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier>2</multiplier>
                                                </scalerIf>
                                                <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier>0</multiplier>
                                                </scalerElse>
                                            </scalerElse>
                                        </scalerElse>
                                    </durationScaler>
                                </Item>
                            </targetImpacts>
                            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                                <spells>
                                    <Item href="/Mechanics/Spells/Psionic63/Spells/MentalStrike/Spell01.(SpellSingleTarget).xdb" />
                                    <Item href="/Mechanics/Spells/Psionic63/Spells/PsychicAttack/Spell01.(SpellSingleTarget).xdb" />
                                    <Item href="/Mechanics/Spells/Psionic63/Spells/PsychicBurn/Spell02.(SpellSingleTarget).xdb" />
                                </spells>
                            </destination>
                        </Item>
                    </effectsIf>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>