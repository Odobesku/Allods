<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>215428</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="GuitarAoE.(BuffResource).Name.txt" />
    <Description href="GuitarAoE.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Bard/Healsong.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Bard/GuitarAoE.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <tickLength>1000</tickLength>
                <damagePerTick>1</damagePerTick>
                <affectOnStartTick>true</affectOnStartTick>
                <affectedByDoubleAttack>true</affectedByDoubleAttack>
            </parameters>
            <element>DISEASE</element>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                            <summands>
                                <Item type="gameMechanics.elements.calcers.LinearCalcer">
                                    <mul>3</mul>
                                    <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                        <dressSlot>AMMO</dressSlot>
                                    </mulCalcer>
                                    <sum>0</sum>
                                </Item>
                                <Item type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="externalCalcer" />
                                </Item>
                            </summands>
                        </mulCalcer>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="GuitarAoE01.(BuffResource).xdb" />
        <Item href="GuitarAoE02.(BuffResource).xdb" />
        <Item href="GuitarAoE03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>