	<visScript href="/Spells/VisScripts/Warrior/Tortoise.(BuffVisScripts).xdb" />
	<interfaceHighPriority>true</interfaceHighPriority>
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>FormulaPercent</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<effects>
		<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
			<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
				<coeff>-1</coeff>
				<calcer type="gameMechanics.elements.calcers.CalcerIf">
					<predicate type="gameMechanics.elements.predicates.PredicateHasAbility">
						<ability href="/Mechanics/Spells/War63/Abilities/TortoiseCanMove/Ability01.(AbilityResource).xdb" />
					</predicate>
					<calcerIf type="gameMechanics.elements.calcers.CalcerSum">
						<summands>
							<Item type="gameMechanics.elements.calcers.AbilityRankCalcer">
								<ability href="/Mechanics/Spells/War63/Abilities/TortoiseCanMove/Ability01.(AbilityResource).xdb" />
								<mul>0.04</mul>
							</Item>
							<Item type="constructor.elements.CalcerFloatExternal">
								<externalCalcer hrefvar="externalCalcer" />
							</Item>
						</summands>
					</calcerIf>
					<calcerElse type="constructor.elements.CalcerFloatExternal">
						<externalCalcer hrefvar="externalCalcer" />
					</calcerElse>
				</calcer>
			</scaler>
		</Item>
	</effects>
	<duration>5000</duration>
	<isHelpful>true</isHelpful>
	<ranks>
