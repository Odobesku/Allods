<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>222819</resourceId>
    </Header>
    <name href="Rocket_Nomal.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Rocket_ScaledDamage.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>30</radius>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="Rocket_Visual.(ClientData).xdb" />
                                    <calcers>
                                        <addressEntries>
                                            <Item>
                                                <name>caster</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                            </Item>
                                            <Item>
                                                <name>target</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                            </Item>
                                        </addressEntries>
                                    </calcers>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/RaidInstances/FerrisRaid/11_Clone_Elf/Tank/Rocket.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/Mechanics/RaidInstances/UmoirRaid/2_KtulhuBoss/NoTargeting.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>1800</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.TickableEntityAura">
                    <affectGroup>All</affectGroup>
                    <radius>1.25</radius>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <blinking>true</blinking>
                    <holderImpactsIn>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <radius>5</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>5</radius>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>FIRE</element>
                                            <damage>125</damage>
                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/11_Clone_Elf/Tank/Rocket.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiatingWithAddressee">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
                                                <radius>60</radius>
                                            </distributor>
                                            <data href="/Mechanics/Spells/HuntingGrounds/HG_HitFireball.(ClientData).xdb" />
                                        </Item>
                                    </impacts>
                                    <consumeAddress type="gameMechanics.elements.addresseeFinders.AddresseeFinderTarget" />
                                </Item>
                            </impacts>
                            <finalImpactsOnHolder>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </finalImpactsOnHolder>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                            <targetsLimit>1</targetsLimit>
                        </Item>
                    </holderImpactsIn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>