<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.QuestResource>
	<Header>
		<resourceId>739866115</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<checkText href="GuildQuest_Proto.(QuestResource).CheckText.txt" />
	<finishText href="GuildQuest_Proto.(QuestResource).FinishText.txt" />
	<finisher type="gameMechanics.elements.quest.QuestFinisherMob">
		<mobWorld hrefvar="questFinisher" />
	</finisher>
	<startConditions>
		<Item type="gameMechanics.elements.predicates.PredicateHasGuildProgress" />
		<Item type="gameMechanics.constructor.basicElements.PredicateNot">
			<predicate type="gameMechanics.elements.predicates.PredicateCreatureLevel">
				<minLevel type="gameMechanics.formulas.IntConstantValue">
					<value var="maxQuestLevel" />
				</minLevel>
			</predicate>
		</Item>
	</startConditions>
	<reward>
		<experience>2</experience>
		<mandatoryItems>
			<Item>
				<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
					<item href="/Items/QuestItems/ZoneHadagan1/MobToken/MobToken.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
				</item>
				<number>1</number>
			</Item>
		</mandatoryItems>
		<guildLoyaltyCalcer type="gameMechanics.elements.calcers.FloatData">
			<value>1</value>
		</guildLoyaltyCalcer>
		<guildAuthorityScaler type="gameMechanics.elements.scalers.LinearScaler">
			<multiplier>10</multiplier>
		</guildAuthorityScaler>
	</reward>
	<repeatPolicy type="gameMechanics.constructor.schemes.quest.RepeatPolicyDelayed" />
	<lowPriority>true</lowPriority>
	<zone hrefvar="zone" />
	<canBeSkipped>false</canBeSkipped>
	<skippedExp>1</skippedExp>
	<requiredLevel type="gameMechanics.formulas.IntConstantValue">
		<value var="minQuestLevel" />
	</requiredLevel>
	<level type="gameMechanics.formulas.IntConstantValue">
		<value var="minQuestLevel" />
	</level>
</gameMechanics.constructor.schemes.quest.QuestResource>
