<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>226211</resourceId>
    </Header>
    <Name href="Buff01.(BuffResource).Name.txt" />
    <Description href="Buff01.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/AccumulationPowerSparks.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>8</radius>
                            <conditions>
                                <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                    <onSlave type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    </onSlave>
                                </Item>
                            </conditions>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                <mobs>
                                                    <Item href="/Mechanics/RaidInstances/UmoirRaid/4_GoblinTrioBoss/Goblin01Boss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                </mobs>
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Buff02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <stackLimit>30</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>