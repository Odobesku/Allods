<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visActionID>Effect</visActionID>
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Trace_R_01</locatorName>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>kick</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>1200</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>Effect</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
