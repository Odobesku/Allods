<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureRotateToCastPointAction">
						<immediateTurn>true</immediateTurn>
					</Item>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/Cone_Decal_30_45.(VisObjectTemplate).xdb" />
										<lockScale>true</lockScale>
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionList">
						<playWhile type="VisActionDelay">
							<time>2700</time>
						</playWhile>
						<elements>
							<Item type="CreatureAnimationAction">
								<animations>
									<Item>readySpell</Item>
								</animations>
								<channel>CHANNEL_ATTACK</channel>
							</Item>
						</elements>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastDirected</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<playWhile type="VisActionDelay">
					<time>3500</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>1950</delay>
								<effectFx href="/Spells/FX/Spells/YakGlacialChief_Ice_Spikes_FX.(VisObjectTemplate).xdb" />
								<fixPoint>true</fixPoint>
								<lockScale>true</lockScale>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<playWhile type="VisActionDelay">
			<time>2000</time>
		</playWhile>
		<elements>
			<Item type="CreatureLockRotationAction" />
		</elements>
	</launch>
</SpellVisScripts>
