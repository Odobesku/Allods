<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221557</resourceId>
    </Header>
    <Name href="HMAcidDOT.(BuffResource).Name.txt" />
    <Description href="HMAcidDOT.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerAcidBolt.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Mobs/Gamayun_AcidDot.(VisObjectTemplate).xdb" />
            <locator>Slot_Global</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.MagicDoT">
                    <parameters>
                        <damagePerTick>1</damagePerTick>
                    </parameters>
                    <element>ACID</element>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.PureDamageDoT">
                    <parameters>
                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                <multiplier>0.00375</multiplier>
                            </mulCalcer>
                        </scalerTarget>
                        <damagePerTick>1</damagePerTick>
                    </parameters>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <duration>15000</duration>
    <stackLimit>20</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>