                                                                                <variable href="/Maps/UmoirIsland06/Variables/UI06_Var_MF_Forest.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                                                                                <summand>1</summand>
                                                                            </Item>
                                                                        </impactsIf>
