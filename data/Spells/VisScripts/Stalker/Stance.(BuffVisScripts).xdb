<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Aspect_DD</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Stance_DD.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<locator>Slot_Global</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
				<stopOnDeath>false</stopOnDeath>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Aspect_Tank</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Stance_Tank.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<locator>Slot_Global</locator>
								<offendTime />
								<offset z="0" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
