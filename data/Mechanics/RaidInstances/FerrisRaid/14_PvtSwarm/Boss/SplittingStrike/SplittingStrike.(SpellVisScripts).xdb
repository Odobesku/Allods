<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack02</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<animationKeysAction>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureIndependentFxAction">
										<visObject href="/Spells/FX/Mobs/Architect_Swarm_Split_Ground_Cast.(VisObjectTemplate).xdb" />
										<lifeTime>6</lifeTime>
									</Item>
									<Item type="Sound3DAction">
										<sound>
											<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
											<name>spells/FX/Spells/ArchitectorFX/SplittingStrike</name>
										</sound>
									</Item>
								</elements>
							</action>
							<stopIfAnimationStoped>false</stopIfAnimationStoped>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
