<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739921174</resourceId>
    </Header>
    <element>FIRE</element>
    <Name href="DemonBoss03_projectile.(SpellSingleTarget).Name.txt" />
    <visualScripts href="DemonBoss03_projectile.(SpellVisScripts).xdb" />
    <prepareDuration>1000</prepareDuration>
    <needLos>false</needLos>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>8000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>0.5</value>
                </chanceCalcer>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                        <spell href="DemonBoss03_projectile.(SpellSingleTarget).xdb" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>10</radius>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                        <time>1000</time>
                        <distance>6</distance>
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellGroupCooldown">
                <group href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftAutoattack.(ActionGroup).xdb" />
                <duration>1500</duration>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeDestination">
                        <receiver>Caster</receiver>
                        <to type="gameMechanics.elements.calcers.DestinationSpellTargetThrust">
                            <maxDist>8</maxDist>
                        </to>
                    </moveType>
                    <resource href="DemonBoss03_projectile1.(ProjectileResource).xdb" />
                </projectileData>
                <pool href="DemonBoss03_summons.(SummonPool).xdb" />
            </Item>
        </targetImpacts>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>