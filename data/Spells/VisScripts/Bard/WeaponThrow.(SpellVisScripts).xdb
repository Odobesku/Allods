<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<use>USE_ANIMATIONS</use>
				<animations>
					<Item>readySpellOmniBard</Item>
				</animations>
				<channel>CHANNEL_ACTIONBAR</channel>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect01DownMusic.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<fadeOutTime>500</fadeOutTime>
						<locator>Slot_Global</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<playWhile />
		<elements>
			<Item type="CreatureVisActionIgnoreDisarm">
				<visActionID>IgnoreDisarm</visActionID>
			</Item>
			<Item type="CreatureAnimationAction">
				<use>USE_CURRENT_THROWING</use>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
				</advanced>
			</Item>
			<Item type="CreatureThrowArrowAction">
				<arrow href="" />
				<useMeleeWeapon>true</useMeleeWeapon>
				<theGe>10</theGe>
				<additionalEffectFx href="/Spells/FX/Spells/WarriorWeaponThrow.(VisObjectTemplate).xdb" />
				<effectBone>Slot_Enchant0</effectBone>
				<offendTime type="EffectOffendConstDelay" />
			</Item>
			<Item type="VisActionStopAction">
				<stoppedActionID>IgnoreDisarm</stoppedActionID>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
