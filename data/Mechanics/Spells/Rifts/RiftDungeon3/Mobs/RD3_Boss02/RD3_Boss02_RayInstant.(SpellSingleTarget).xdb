<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>208124</resourceId>
    </Header>
    <Name href="RD3_Boss02_RayInstant.(SpellSingleTarget).Name.txt" />
    <visualScripts href="RD3_Boss02_RayInstant.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss02/DemonBoss02_RayMob.(MobWorld).xdb" />
                </mobs>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                <data href="RD3_Boss02_RayInstant.(ClientData).xdb" />
                <calcers>
                    <addressEntries>
                        <Item>
                            <name>caster</name>
                            <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                        </Item>
                        <Item>
                            <name>target</name>
                            <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                        </Item>
                    </addressEntries>
                </calcers>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>1</radius>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>LIGHTNING</element>
                        <damage>1</damage>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageElite.(CalcerFloatResource).xdb" />
                                    </mulCalcer>
                                </Item>
                            </scalers>
                        </scaler>
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>1000</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="RD3_Boss02_ChannelRay.(BuffResource).xdb" />
                                        </predicate>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                        <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderNearestTarget">
                                            <radius>1</radius>
                                            <predicates>
                                                <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                                    <onSlave type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                </Item>
                                            </predicates>
                                        </addresseeFinder>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>