<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>195655</resourceId>
    </Header>
    <name href="Lightning.(ProjectileResource).Name.txt" />
    <visObject href="ElFloorV.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0</altitude>
    <lifeLengthCap>1500</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>500</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <shape type="gameMechanics.constructor.schemes.spell.area.CylinderWithHeight">
                                <topPlane>8</topPlane>
                            </shape>
                            <radius>100</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>LIGHTNING</element>
                                    <damage>300</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>