<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739891505</resourceId>
    </Header>
    <name href="IceBlock.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/FerrisRaid_IceSpike_Dynamic.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>8000</lifeLengthCap>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
            <delay>4000</delay>
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>4</radius>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                            <time>500</time>
                            <impactsOnLand>
                                <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                    <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                    <minDamage>100</minDamage>
                                    <maxDamage>100</maxDamage>
                                </Item>
                            </impactsOnLand>
                            <distance>5</distance>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
        </Item>
    </impactsOnStart>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>4000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>1</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                    <object href="IceBlock.(SteleResource).xdb" />
                                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>