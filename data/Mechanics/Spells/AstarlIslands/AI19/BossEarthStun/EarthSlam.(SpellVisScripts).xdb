<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="VisActionDelay">
                <time>500</time>
            </Item>
            <Item type="CreatureIndependentFxAction">
                <visObject href="/Spells/FX/Spells/AoeAuraRed35.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <lifeTime>2.5</lifeTime>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectAstral_scale1_67.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_Hand_L</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>ready</Item>
                </animations>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialCast</Item>
                </animations>
                <advanced>
                    <offendType>EVERYKEY_OFFEND</offendType>
                </advanced>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/GT_7Boss_TeleportExplosion_BlueHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.5</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>