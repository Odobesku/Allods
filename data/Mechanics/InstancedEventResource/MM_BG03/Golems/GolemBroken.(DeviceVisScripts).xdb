<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<defaultVisAction type="DeviceVisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="DeviceVisActionList">
				<elements>
					<Item type="DeviceAnimationAction">
						<mode>CLAMP</mode>
						<animations>
							<Item>death</Item>
						</animations>
					</Item>
					<Item type="DeviceVisEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/GolemRed_End.(VisObjectTemplate).xdb" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="Sound3DActionDevice">
				<sound>
					<project href="/SFX/Creatures/Creatures_G.(FMODProject).xdb" />
					<name>Creatures/GolemJunes/GolemJunesCracked/death</name>
				</sound>
			</Item>
		</elements>
	</defaultVisAction>
</DeviceVisScripts>
