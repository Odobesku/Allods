<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.UsableDeviceResource>
	<Header>
		<resourceId>739855124</resourceId>
	</Header>
	<parts>
		<Item type="InteractionAnimationPart">
			<interactionStartAction type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>useStandingStart</Item>
					<Item>useStandingLoop</Item>
				</animations>
			</interactionStartAction>
			<interactionEndAction type="CreatureAnimationAction">
				<animations>
					<Item>useStandingEnd</Item>
				</animations>
			</interactionEndAction>
		</Item>
	</parts>
	<persistentParts>
		<Item type="gameMechanics.world.cellReplication.MapWideReplicated" />
		<Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
			<effects>
				<Item type="gameMechanics.world.device.parts.ImpactsOnUserGeneric">
					<userImpactsOnStartUse>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="MWRaid_Cannon02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
							<addresseeFinder type="gameMechanics.world.device.AddresseeFinderUsingDevice" />
							<impacts>
								<Item type="gameMechanics.elements.bunchImpacts.ImpactCopyIFF" />
							</impacts>
						</Item>
					</userImpactsOnStartUse>
					<userImpactsOnFinishUse>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="MWRaid_Cannon02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							<anyRank>false</anyRank>
						</Item>
					</userImpactsOnFinishUse>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.world.entity.EntityZoneTrackerResource">
			<trackData href="/Interface/TrackData/MWCannon.(TrackDataResource).xdb#xpointer(/gameMechanics.world.avatar.TrackDataResource)" />
		</Item>
	</persistentParts>
	<name href="MWRaid_Cannon02.(UsableDeviceResource).Name.txt" />
	<corpulence>2</corpulence>
	<collisionObject>true</collisionObject>
	<interactiveObject>true</interactiveObject>
	<exploitingText href="MWRaid_Cannon02.(UsableDeviceResource).ExploitingText.txt" />
	<spell href="MWRaid_Cannon01.(Exploit).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
	<viewSight>
		<isBinding>true</isBinding>
		<position y="-40" z="30" />
		<rotation y="0.35" />
		<distance>0.1</distance>
		<camera href="MWRaid_Cannon02.(ObjectCameraSettings).xdb#xpointer(/ObjectCameraSettings)" />
	</viewSight>
	<deviceSpells>
		<Item href="MWRaid_Cannon02.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
	</deviceSpells>
	<castFromAvatar>true</castFromAvatar>
</gameMechanics.world.device.UsableDeviceResource>
