<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
	<Header>
		<resourceId>739910643</resourceId>
	</Header>
	<persistentParts>
		<Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.TickableEntityAura">
					<affectGroup>All</affectGroup>
					<radius>2</radius>
					<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
						</predicates>
					</filter>
					<impactsIn>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Hacker_A.(BuffResource).xdb" />
						</Item>
					</impactsIn>
					<impactsOut>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Combination/Difficulty.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="CombinationFailed.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="SuccessfulHacksCount.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
							<radius>20</radius>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateDevice">
											<deviceResources>
												<Item href="HackIndicator_A.(SteleResource).xdb" />
											</deviceResources>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
											<visualState>5</visualState>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
							<group href="/Mechanics/Spells/Groups/FerrisRaid_Hacking.(ActionGroup).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="Hacker_A.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="Hacker_A.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="Hacker_A_Succeeded.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ReturningImpact">
