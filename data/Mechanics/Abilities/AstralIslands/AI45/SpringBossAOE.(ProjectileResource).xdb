<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>237342</resourceId>
    </Header>
    <name href="SpringBossAOE.(ProjectileResource).Name.txt" />
