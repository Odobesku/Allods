				</visualEffects>
			</Item>
			<Item type="CreatureColorAction">
				<priority>1000</priority>
				<colorValue>-1</colorValue>
				<timeOn>0.2</timeOn>
				<timeOff>0.2</timeOff>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
