<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>CLAMP</mode>
				<animations>
					<Item>sleepDown</Item>
					<Item>sleep</Item>
				</animations>
				<channel>CHANNEL_DEATH</channel>
			</Item>
			<Item type="PostEffectVisAction">
				<userPostEffect href="Fade.(UserPostEffect).xdb#xpointer(/UserPostEffect)" />
			</Item>
		</elements>
	</action>
</BuffVisScripts>
