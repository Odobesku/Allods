<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739950160</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/MountSpeedBoosts.(ActionGroup).xdb" />
    </groups>
    <Name href="TrialSpell.(SpellSingleTarget).Name.txt" />
    <Description href="TrialSpell.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/WingBuffet.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mount/Drake_WingBuffet.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>8</value>
    </range>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>120000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMounted" />
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/Mounts/Prototypes/AntiNormalMountCC.(BuffResource).xdb" />
                </predicate>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>5</radius>
                <affectGroup>Enemies</affectGroup>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Mounts/Prototypes/AntiNormalMountCC.(BuffResource).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                                <impactsOnAttach>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Mounts/Prototypes/AntiNormalMountCC.(BuffResource).xdb" />
                                    </Item>
                                </impactsOnAttach>
                            </Item>
                        </impactsIf>
                        <impactsElse />
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.CreatureFilter" />
            </Item>
        </targetImpacts>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>