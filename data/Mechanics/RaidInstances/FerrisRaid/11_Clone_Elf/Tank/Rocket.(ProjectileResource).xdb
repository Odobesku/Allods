<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>222806</resourceId>
    </Header>
    <name href="Rocket.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Mobs/MountGolem_RocketSquall_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <speed>0.015</speed>
    <lifeLengthCap>10000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <tick>1000</tick>
            <affectGroup>Enemies</affectGroup>
            <radius>3</radius>
            <height>3</height>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <holderImpactsIn>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <radius>5</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiatingWithAddressee">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
                                        <radius>60</radius>
                                    </distributor>
                                    <data href="/Spells/ClientData/FireballHit.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </Item>
                            </impacts>
                            <consumeAddress type="gameMechanics.elements.addresseeFinders.AddresseeFinderTarget" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>15</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>FIRE</element>
                                    <damage>250</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                    <finalImpactsOnHolder>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </finalImpactsOnHolder>
                    <filter type="gameMechanics.constructor.basicElements.FilterOr">
                        <filters>
                            <Item type="gameMechanics.world.creature.AvatarFilter" />
                            <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                        </filters>
                    </filter>
                    <targetsLimit>1</targetsLimit>
                </Item>
            </holderImpactsIn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>