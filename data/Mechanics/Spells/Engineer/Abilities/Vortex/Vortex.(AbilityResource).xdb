<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739895625</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Vortex.(AbilityResource).Name.txt" />
	<description href="Vortex.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>radius</name>
			<value var="radius" />
		</Item>
		<Item>
			<name>target2</name>
			<value var="target2" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Necromancer/NecromancerBloodpact.chn.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/Engineer/CarnivorousMantrap/TrapPoxy.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius var="radius" />
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Vortex.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									<impactsOnAttach>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.ImpactPvpAction" />
											</impactsIf>
											<impactsElse>
												<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
													<value>1</value>
												</Item>
											</impactsElse>
										</Item>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</impactsOnAttach>
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.CreatureFilter" />
							<targetsLimit var="target" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data hrefvar="data" />
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Vortex01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Vortex02.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Vortex03.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
