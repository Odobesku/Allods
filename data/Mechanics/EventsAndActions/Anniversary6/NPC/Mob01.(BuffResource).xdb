            <effects>
                <Item type="gameMechanics.elements.effects.EffectStackTrigger">
                    <count>5</count>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/EventsAndActions/Anniversary6/Fun/Brawl.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/EventsAndActions/Anniversary6/Fun/Aggr.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/EventsAndActions/Anniversary6/NPC/Mob01.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/EventsAndActions/Anniversary6/Fun/Brawl.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/EventsAndActions/Anniversary6/NPC/Mob01.(BuffResource).xdb" />
                                </Item>
