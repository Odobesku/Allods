<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>206630</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Preparation.(AbilityResource).Name.txt" />
    <description href="Preparation.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>dur</name>
            <value var="dur" />
        </Item>
        <Item>
            <name>stack</name>
            <value var="stack" />
        </Item>
        <Item>
            <name>stack2</name>
            <value var="stack2" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Paladin/PaladinInspireCourage.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/Paladin63/Abilities/WrathGiveMark/AddPhysDamageMark.(BuffResource).xdb" />
                            <stacks type="gameMechanics.elements.calcers.FloatData">
                                <value var="stack2" />
                            </stacks>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
                            <conditionalImpacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="PreparationCD.(BuffResource).xdb" />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier var="dur" />
                                            </durationScaler>
                                        </Item>
                                    </impacts>
                                    <conditions>
                                        <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                                            <group href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
                                        </Item>
                                    </conditions>
                                </Item>
                            </conditionalImpacts>
                        </Item>
                        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="PreparationCD.(BuffResource).xdb" />
                                                </Item>
                                            </predicates>
                                            <impactsElse>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/Paladin63/Abilities/WrathGiveMark/AddPhysDamageMark.(BuffResource).xdb" />
                                                    <stacks type="gameMechanics.elements.calcers.FloatData">
                                                        <value var="stack" />
                                                    </stacks>
                                                </Item>
                                            </impactsElse>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <tick>3000</tick>
                            <initialDelay>3000</initialDelay>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Preparation01.(AbilityResource).xdb" />
        <Item href="Preparation02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>