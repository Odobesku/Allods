                                    <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblinRange/AI66_WildGoblinRange.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblin/AI66_WildGoblin_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                </mobs>
