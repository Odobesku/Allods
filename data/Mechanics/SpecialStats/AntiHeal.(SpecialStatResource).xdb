													</Item>
													<Item type="constructor.elements.CalcerFloatExternal">
														<externalCalcer href="AntiHeal.(CalcerFloatResource).xdb" />
													</Item>
												</calcers>
											</mulCalcer>
											<sum>0</sum>
										</summand>
									</Item>
								</impactsIf>
								<impactsElse>
									<Item type="gameMechanics.elements.impacts.ImpactSummandHealAbsorbPool">
										<summand type="gameMechanics.elements.calcers.LinearCalcer">
											<mul>0.025</mul>
											<mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
												<calcers>
													<Item type="constructor.elements.CalcerFloatExternal">
