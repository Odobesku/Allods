<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739915764</resourceId>
    </Header>
    <name href="ExoAuto.(AbilityResource).Name.txt" />
    <description href="ExoAuto.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/MountExoskelet.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <descTemplate href="ExoAuto.(AbilityResource).DescTemplate.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                    <group href="/Mechanics/Mounts/Groups/ExoMounts.(MountGroupResource).xdb#xpointer(/gameMechanics.constructor.schemes.mount.MountGroupResource)" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.BuffInterceptor">
                    <impactsOnAttach>
                        <Item type="gameMechanics.constructor.basicElements.ImpactNull" />
                    </impactsOnAttach>
                    <impactsOnDetach>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Mounts/Skins/ExoMounts/ExoCustomBuff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsOnDetach>
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/GameRoot/Mount/MountBuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                </Item>
            </effectsIf>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>