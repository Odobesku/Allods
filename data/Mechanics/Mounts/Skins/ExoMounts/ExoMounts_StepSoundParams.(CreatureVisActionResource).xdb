<?xml version="1.0" encoding="UTF-8"?>
<CreatureVisActionResource>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureWaitReadyAction" />
			<Item type="client.Replica.VisActionDelay">
				<time>500</time>
			</Item>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.VisActionList">
						<elements>
							<Item type="client.Replica.VisActionList">
								<elements>
									<Item type="client.SLON.CreatureStepSoundParamAction">
										<param>
											<parameter href="ExoFootstepV3.(SoundParameter).xdb#xpointer(/SoundParameter)" />
											<value>0.2</value>
										</param>
										<onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
									</Item>
								</elements>
								<play>Simultaneously</play>
								<preconditional>false</preconditional>
								<restartOnVisualChange>true</restartOnVisualChange>
								<stopOnDeath>false</stopOnDeath>
								<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
							</Item>
						</elements>
						<play>Simultaneously</play>
						<playWhile type="client.SLON.PredicateVisualMountAction">
							<mountsList>
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton03Base.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton03Fire.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton03Purple.(VisualMount).xdb#xpointer(/VisualMount)" />
