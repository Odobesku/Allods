<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
	<Header>
		<resourceId>297674763</resourceId>
	</Header>
	<name href="RefundSupplyCrate.txt" />
	<text href="RefundSupplyCrate.Text.txt" />
	<data>
		<Item type="CueDataMoney">
			<alias>Price</alias>
			<calcer type="constructor.elements.CalcerLongExternal">
				<externalCalcer href="Calcers/LoadSupply.(CalcerLongResource).xdb" />
			</calcer>
		</Item>
	</data>
	<conditions>
		<Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
			<lhs type="gameMechanics.world.ship.elements.calcers.CalcerTreasureChestCount">
				<chestType href="/Mechanics/Rules/Astral/Caravans/Chests/SupplyChest.(AstralChestType).xdb" />
			</lhs>
			<rhs type="gameMechanics.elements.calcers.LongData">
				<value>0</value>
			</rhs>
		</Item>
		<Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
			<key href="/System/ContentKeys/AstralCaravans.(ContentKey).xdb" />
		</Item>
		<Item type="gameMechanics.world.ship.elements.PredicateOnBoundShip">
			<predicates>
				<Item type="gameMechanics.world.ship.elements.PredicateShipOwner" />
				<Item type="gameMechanics.elements.predicates.PredicateOnSameMap" />
			</predicates>
		</Item>
	</conditions>
	<additionalConditions>
		<Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
			<minLevel type="gameMechanics.formulas.MaxLevelConstant">
				<summand>-3</summand>
			</minLevel>
		</Item>
	</additionalConditions>
	<impacts>
		<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
			<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderBoundShip" />
			<impacts>
				<Item type="itemService.elements.astral.ImpactRemoveChest">
					<chestCount type="gameMechanics.world.ship.elements.calcers.CalcerTreasureChestCount">
						<chestType href="/Mechanics/Rules/Astral/Caravans/Chests/SupplyChest.(AstralChestType).xdb" />
					</chestCount>
					<chestType href="/Mechanics/Rules/Astral/Caravans/Chests/SupplyChest.(AstralChestType).xdb" />
					<scalableImpactsOnAvatarPerChest>
						<Item type="gameMechanics.elements.impacts.ImpactsIf">
							<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
								<onSlave type="gameMechanics.world.ship.elements.PredicateOnBoundShip">
									<predicates>
										<Item type="gameMechanics.world.ship.elements.PredicateShipOwner" />
										<Item type="gameMechanics.elements.predicates.PredicateOnSameMap" />
									</predicates>
								</onSlave>
							</predicate>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactAddMoney">
									<sumCalcer type="constructor.elements.CalcerLongExternal">
										<externalCalcer href="Calcers/LoadSupply.(CalcerLongResource).xdb" />
									</sumCalcer>
								</Item>
							</impactsIf>
						</Item>
					</scalableImpactsOnAvatarPerChest>
				</Item>
			</impacts>
		</Item>
	</impacts>
	<nextCues>
		<Item href="LoadSupplyCrateEvent.(Cue).xdb" />
		<Item href="LoadSupplyCrateEventNoSpace.(Cue).xdb" />
		<Item href="LoadSupplyCrate.(Cue).xdb" />
		<Item href="LoadSupplyCrateNoShip.(Cue).xdb" />
	</nextCues>
</gameMechanics.world.mob.interaction.Cue>
