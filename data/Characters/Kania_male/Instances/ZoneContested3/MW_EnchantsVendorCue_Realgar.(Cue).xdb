<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>77225</resourceId>
    </Header>
    <name href="MW_EnchantsVendorCue_Realgar.(Cue).Name.txt" />
    <text href="MW_EnchantsVendorCue_Realgar.(Cue).Text.txt" />
    <conditions>
        <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
            <rule href="/Mechanics/Rules/MegaWar/RewardQuestRule.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateJoinGuildTimeAgo">
            <time>
                <ms>1</ms>
            </time>
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateGreater">
            <lhs type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
                <currency href="/Mechanics/AlternativeCurrencies/MWrewardCurrency.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
            </lhs>
            <rhs type="gameMechanics.constructor.basicElements.FloatZero" />
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateHasGuildTabardRight">
                            <tabardType>Champion</tabardType>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateResourceReady">
                            <resource href="/Items/GuildItems/GuildChampionTabard.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </Item>
                    </predicates>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateHasGuildTabardRight">
                            <tabardType>Common</tabardType>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateResourceReady">
                            <resource href="/Items/GuildItems/GuildTabard.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateResourceReady">
                            <resource href="/Items/GuildItems/GuildChampionTabard.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
        </Item>
    </conditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasGuildTabardRight">
                    <tabardType>Champion</tabardType>
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateResourceReady">
                    <resource href="/Items/GuildItems/GuildChampionTabard.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                        <item href="/Items/Agents/ShiningFragment5.0.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                    </item>
                    <count type="gameMechanics.elements.calcers.FloatToLongCalcer">
                        <calcer type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
                                    <currency href="/Mechanics/AlternativeCurrencies/MWrewardCurrency.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                                </Item>
                                <Item type="gameMechanics.elements.calcers.FloatData">
                                    <value>2.5</value>
                                </Item>
                            </calcers>
                        </calcer>
                    </count>
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateHasGuildTabardRight">
                            <tabardType>Common</tabardType>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateResourceReady">
                            <resource href="/Items/GuildItems/GuildTabard.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateResourceReady">
                            <resource href="/Items/GuildItems/GuildChampionTabard.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
                            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                <item href="/Items/Agents/ShiningFragment5.0.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                            </item>
                            <count type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                <calcer type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
                                    <currency href="/Mechanics/AlternativeCurrencies/MWrewardCurrency.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                                </calcer>
                            </count>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsElse>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactResourceCooldown">
            <binding>Soul</binding>
            <resource href="MW_EnchantsVendorCue_Realgar.(Cue).xdb#xpointer(/gameMechanics.world.mob.interaction.Cue)" />
            <cooldownInDays type="gameMechanics.elements.calcers.CalcerLongSum">
                <calcers>
                    <Item type="gameMechanics.elements.calcers.CalcerLongDiv">
                        <dividend type="gameMechanics.elements.calcers.TimeTableCalcer">
                            <timeTable href="/Mechanics/GameRoot/ResetDay.(TimeTable).xdb#xpointer(/timetables.TimeTable)" />
                        </dividend>
                        <divisor type="gameMechanics.elements.calcers.LongData">
                            <value>86400000</value>
                        </divisor>
                    </Item>
                    <Item type="gameMechanics.elements.calcers.LongData">
                        <value>1</value>
                    </Item>
                </calcers>
            </cooldownInDays>
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>