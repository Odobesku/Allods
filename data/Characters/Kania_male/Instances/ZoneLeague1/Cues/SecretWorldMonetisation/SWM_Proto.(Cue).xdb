<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>76208</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="SWM_Proto.(Cue).name.txt" />
    <conditions>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                <unlock hrefvar="NotPredicateUnlock" />
            </predicate>
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
            <minLevel type="gameMechanics.formulas.IntConstantValue">
                <value var="PredicateLevel" />
            </minLevel>
        </Item>
    </conditions>
    <additionalConditions>
        <Item type="gameMechanics.elements.resources.ResourceItem">
            <item href="/ItemMall/Services/Quest/SecretWorldMiniUnlocker.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            <number var="CountItem" />
        </Item>
    </additionalConditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
            <unlock hrefvar="GrantUnlock" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
            <item href="/ItemMall/Services/Quest/SecretWorldMiniUnlocker.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            <count var="CountItem" />
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>