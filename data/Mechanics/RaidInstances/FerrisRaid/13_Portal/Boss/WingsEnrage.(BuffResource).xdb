    <Name href="TimeEnrage.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                                    <zone href="/Maps/FerrisRaid/Zones/RaidFerris4.(ZoneResource).xdb" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                                                            <damage>1</damage>
                                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                                            </scalerTarget>
                                                        </Item>
                                                    </impactsIf>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>13_Blast</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </device>
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>13_BlastLeft</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </device>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
