														<multiplier>2</multiplier>
													</durationScaler>
												</Item>
											</impacts>
											<filter type="gameMechanics.world.creature.AliveFilter" />
											<targetsLimit>6</targetsLimit>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
						</Item>
					</casterPreImpacts>
					<destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
						<spells>
							<Item href="/Mechanics/Spells/Psionic63/Spells/Projection/OrderExplode.(SpellSingleTarget).xdb" />
						</spells>
					</destination>
				</Item>
			</effects>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
