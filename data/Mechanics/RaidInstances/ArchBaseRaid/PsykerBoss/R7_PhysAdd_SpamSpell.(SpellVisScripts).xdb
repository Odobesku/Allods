<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>1500</time>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="CreatureAnimationAction">
					<animations>
						<Item>spellCastDirected</Item>
					</animations>
					<channel>CHANNEL_KNOCKDOWN</channel>
					<advanced>
						<speed>1.8</speed>
						<animationKeysAction />
						<animationKeysSound />
						<animationKeysActionPeriod />
						<disableRandomFirstFrame>false</disableRandomFirstFrame>
					</advanced>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>100</delay>
								<effectFx href="/Spells/FX/Mobs/TripodPortal_DesintegrationRay.(VisObjectTemplate).xdb" />
								<lockScale>true</lockScale>
								<scale>2</scale>
								<locator>Slot_BodyFX</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>