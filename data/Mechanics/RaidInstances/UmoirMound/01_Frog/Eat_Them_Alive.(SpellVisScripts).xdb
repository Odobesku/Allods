<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/UmoirMound_Frog_EatThemAlive.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>1</scale>
						<locator>Slot_BodyFX</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>specialAttack</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>1500</time>
				</playWhile>
				<elements>
					<Item type="CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Mobs/UmoirMound_Frog_EatChannel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fxLength>10</fxLength>
						<startPoint type="VisPointLocator">
							<locator>Slot_FX</locator>
							<member>Default_Member</member>
							<from>FROM_DEFALUT</from>
						</startPoint>
						<endPoint type="VisPointLocator">
							<locator>Slot_FX</locator>
							<from>FROM_DEFALUT</from>
						</endPoint>
						<offendTime />
						<secondaryTargetParams>
							<channelingFx href="" />
							<offendTime />
						</secondaryTargetParams>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
