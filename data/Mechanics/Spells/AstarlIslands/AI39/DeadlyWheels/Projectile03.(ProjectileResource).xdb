    <visObject href="/Spells/FX/Spells/HitFireball2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0</altitude>
    <lifeLengthCap>5000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Aura">
            <checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
            <affectGroup>Enemies</affectGroup>
            <radius>6</radius>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>FIRE</element>
