<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>193595</resourceId>
    </Header>
    <Name href="AI38_Add_TargetSelect.(BuffResource).Name.txt" />
    <Description href="AI38_Add_TargetSelect.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/IMFireworkTarget.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/OpFirework_TargetSkull.(VisObjectTemplate).xdb" />
            <lockScale>true</lockScale>
            <scale>1.2</scale>
            <locator>Slot_TopFX</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="AI38_TurtleTount.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="AI38_BossAdd01.(MobWorld).xdb" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>