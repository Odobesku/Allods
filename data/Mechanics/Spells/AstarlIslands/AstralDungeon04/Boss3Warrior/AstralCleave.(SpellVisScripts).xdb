<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
				<advanced>
					<speed>1</speed>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>2250</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="VisActionDelay">
							<time>5000</time>
						</playWhile>
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<delay>750</delay>
										<effectFx href="/Spells/FX/Mobs/GT_5Boss_Cleave.(VisObjectTemplate).xdb" />
										<lockScale>true</lockScale>
										<scale>2</scale>
										<fadeInTime>300</fadeInTime>
										<fadeOutTime>400</fadeOutTime>
										<locator>Slot_Global</locator>
										<offendTime type="EffectOffendConstDelay" />
										<offset y="-2" z="0.125" />
									</Item>
								</visualEffects>
							</Item>
							<Item type="VisActionList">
								<elements>
									<Item type="VisActionDelay">
										<time>150</time>
									</Item>
									<Item type="CreatureAnimationAction">
										<animations>
											<Item>spellCastDirected</Item>
										</animations>
										<channel>CHANNEL_ATTACK</channel>
									</Item>
								</elements>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>3250</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Cone_Decal_10_90_red.(VisObjectTemplate).xdb" />
								<lockScale>true</lockScale>
								<scale>2</scale>
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownAstral.(VisObjectTemplate).xdb" />
								<scale>1.25</scale>
								<fadeInTime>750</fadeInTime>
								<fadeOutTime>400</fadeOutTime>
								<locator>Slot_Global</locator>
								<offendTime type="EffectOffendConstDelay" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureLockRotationAction" />
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>3000</time>
		</playWhile>
	</launch>
</SpellVisScripts>
