<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.PostEffectVisAction">
            <userPostEffect href="/Spells/FX/InterfaceFX/Black_Middle.(UserPostEffect).xdb#xpointer(/client.VisualConstructor.UserPostEffect)" />
          </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="client.Replica.VisActionDelay">
          <time>500</time>
        </playWhile>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.VisActionDelay">
            <time>500</time>
          </Item>
          <Item type="client.Replica.VisActionList">
            <elements>
              <Item type="client.Replica.VisActionChangeVisObject">
                <newVisMob href="/Creatures/GoblinWarrior/GoblinWarrior.(VisualMob).xdb#xpointer(/client.VisualConstructor.VisualMob)" />
                <getBody>true</getBody>
                <getDress>true</getDress>
              </Item>
              <Item type="client.Replica.CreatureSetFlagVisAction">
                <visualFlag href="/World/Quests/HuntingGround3/AO11_Outpost02/AO11_Outpost02_SarnautHero_CopyAppearance.(VisualFlag).xdb#xpointer(/client.Replica.VisualFlag)" />
                <mainAvatarOnly>true</mainAvatarOnly>
              </Item>
            </elements>
            <play>Simultaneously</play>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
          </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>