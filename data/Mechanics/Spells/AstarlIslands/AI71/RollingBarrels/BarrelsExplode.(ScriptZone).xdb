<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
	<Header>
		<resourceId>739937006</resourceId>
	</Header>
	<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
		<predicates>
			<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
				<mobs>
					<Item href="BarrelMob.(MobWorld).xdb" />
				</mobs>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
		</predicates>
	</filter>
	<impactsIn>
		<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
					<projectileData>
						<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
						<resource href="BarrelExplosion.(ProjectileResource).xdb" />
					</projectileData>
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
					<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>15</multiplier>
					</durationScaler>
				</Item>
			</impacts>
		</Item>
	</impactsIn>
	<considerAsWhole>true</considerAsWhole>
</gameMechanics.map.scriptZone.ScriptZone>
