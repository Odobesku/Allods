<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ArchitectMiniboss_Shield.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<locator>Slot_FX</locator>
						<ignoreParentRotation>true</ignoreParentRotation>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirected</Item>
				</animations>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
