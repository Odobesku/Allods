<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<precastType>PRECAST_DEFAULT</precastType>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmniShield</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>300</time>
				</playWhile>
				<preconditional>false</preconditional>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb" />
								<fadeInTime>300</fadeInTime>
								<fadeOutTime>1000</fadeOutTime>
								<locator>Slot_Hand_L</locator>
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<fadeInTime>300</fadeInTime>
								<fadeOutTime>1000</fadeOutTime>
								<locator>Slot_Hand_R</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>1000</time>
				</playWhile>
				<preconditional>false</preconditional>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Priest63_BarrierBubble_Slot.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<locator>Slot_Global</locator>
								<offendTime />
								<offset z="1" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
