<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/Cone_Decal_10_60_Red.(VisObjectTemplate).xdb" />
				<lockScale>true</lockScale>
				<scale>1.5</scale>
			</Item>
		</visualEffects>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
				<advanced>
					<speed>2</speed>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>1000</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="VisActionDelay">
							<time>5000</time>
						</playWhile>
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<delay>1500</delay>
										<effectFx href="/Spells/FX/Mobs/R7_PhysPsyker_Cleave.(VisObjectTemplate).xdb" />
										<lockScale>true</lockScale>
										<scale>1</scale>
										<fadeInTime>300</fadeInTime>
										<fadeOutTime>400</fadeOutTime>
										<offendTime type="EffectOffendConstDelay" />
									</Item>
								</visualEffects>
							</Item>
							<Item type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureAnimationAction">
										<animations>
											<Item>attack01</Item>
										</animations>
										<channel>CHANNEL_ATTACK</channel>
									</Item>
								</elements>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2250</time>
		</playWhile>
		<elements>
			<Item type="CreatureLockRotationAction" />
		</elements>
	</launch>
</SpellVisScripts>
