	<descTemplate href="Spell_Desc.txt.template" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<level>32</level>
	<prepareDuration>2000</prepareDuration>
	<immutablePrepareDuration>false</immutablePrepareDuration>
