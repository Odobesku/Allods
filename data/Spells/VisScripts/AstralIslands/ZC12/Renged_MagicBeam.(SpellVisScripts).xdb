<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ArchitectRanger_PrecastFx.(VisObjectTemplate).xdb" />
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Mobs/ArchitectBot_BodyFX.(VisObjectTemplate).xdb" />
				<scale>5</scale>
				<fadeInTime>3000</fadeInTime>
				<fadeOutTime>300</fadeOutTime>
				<locator>Slot_Head</locator>
				<offset y="-0.6" z="-0.9" />
			</Item>
		</visualEffects>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>1000</time>
		</playWhile>
		<preconditional>false</preconditional>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<eventPlaybackEnd>true</eventPlaybackEnd>
				</advanced>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Mobs/ArchitectBossCaster_SuffocateChannel.(VisObjectTemplate).xdb" />
				<startPoint type="VisPointLocator">
					<shift z="-0.8" />
					<locator>Slot_Head</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</endPoint>
				<alternativeEndPoint type="VisPointLocator" />
				<offendTime type="EffectOffendConstDelay" />
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
					<name>spells/FX/Spells/ArchitectSiege/ArchitectRanger_Channel</name>
				</sound>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/PortalBoss_Discharge_Hit.(VisObjectTemplate).xdb" />
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<playWhile type="VisActionDelay">
				<time>2000</time>
			</playWhile>
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/Hit_Architect.(VisObjectTemplate).xdb" />
							<scale>1.1</scale>
							<locator>Slot_BodyFX</locator>
						</Item>
					</visualEffects>
				</Item>
				<Item type="Sound3DAction">
					<sound>
						<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
						<name>spells/Hits/HitLightning</name>
					</sound>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
