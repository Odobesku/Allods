<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="CreatureAnimationAction">
			<mode>LOOP</mode>
			<animations>
				<Item>gathering</Item>
			</animations>
		</playWhile>
		<elements>
			<Item type="VisActionList">
				<playWhile type="VisActionDelay">
					<time>1900</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/DotFire.(VisObjectTemplate).xdb" />
								<fixPoint>true</fixPoint>
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
