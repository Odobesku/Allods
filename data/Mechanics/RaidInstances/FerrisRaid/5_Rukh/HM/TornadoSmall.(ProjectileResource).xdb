<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739902566</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<visObject href="TornadoSmall_R4.(VisObjectTemplate).xdb" />
	<speed var="ProjectileSpeed" />
	<lifeLengthCap>0</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
							<shape type="gameMechanics.constructor.schemes.spell.area.CylinderWithHeight">
								<topPlane>30</topPlane>
								<bottomPlane>-10</bottomPlane>
							</shape>
							<radius>3.75</radius>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
											<spawn>
												<scriptID>5_Rukh</scriptID>
												<map href="/Maps/FerrisRaid/MapResource.xdb" />
											</spawn>
											<impacts>
												<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
													<impacts>
														<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
															<element>ASTRAL</element>
															<damage>12.5</damage>
															<scaler type="gameMechanics.elements.scalers.MagicScaler" />
														</Item>
														<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
															<buff href="TornadoHitCooldown.(BuffResource).xdb" />
														</Item>
													</impacts>
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterAnd">
								<filters>
									<Item type="gameMechanics.world.creature.AvatarFilter" />
									<Item type="gameMechanics.world.creature.AliveFilter" />
									<Item type="gameMechanics.constructor.basicElements.FilterNot">
										<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
											<predicates>
												<Item type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="TornadoHitCooldown.(BuffResource).xdb" />
												</Item>
											</predicates>
										</filter>
									</Item>
								</filters>
							</filter>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>500</tick>
			<initialDelay>3000</initialDelay>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
