<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739857792</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>dmg</name>
			<value var="damage" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>MagicScaler</formula>
			</scaler>
		</Item>
		<Item>
			<name>coeff</name>
			<value var="coeff" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Misc/Event/ShieldCarrier.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/Engineer/LifeGuard/LifeGuard01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
									<radius>7</radius>
									<affectGroup>Enemies</affectGroup>
									<affectHolder>false</affectHolder>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
											<element>LIGHTNING</element>
											<damage var="damage" />
											<scaler type="gameMechanics.elements.scalers.MagicScaler" />
										</Item>
									</impacts>
									<filter type="gameMechanics.world.creature.AliveFilter" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
									<data href="/Spells/ClientData/Engineer_ProtectShieldAoe.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
								</Item>
							</impacts>
						</Item>
					</impactsOn>
				</Item>
				<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
					<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
						<coeff var="coeff" />
					</scaler>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Ability02.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Ability03.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
