<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739919654</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Papers/LetterSealed.(UISingleTexture).xdb" />
	<itemClass href="/Mechanics/ItemClasses/Other.xdb" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<useAmount>0</useAmount>
		<usages>
			<Item>
				<predicate type="itemService.mail.predicates.PredicateNot">
					<predicate type="itemService.mail.predicates.PredicateIsRuleActive">
						<rule href="/Mechanics/Rules/Strongbox/December_2015/Rule.(RuleResource).xdb" />
					</predicate>
				</predicate>
				<actions>
					<Item type="itemService.elements.components.ItemTakeActionImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactClientData">
								<data href="/Mechanics/LFG/Quests/RuleQuests/ruleEnded.(ClientData).xdb" />
							</Item>
						</impacts>
					</Item>
				</actions>
				<consumeItems>0</consumeItems>
			</Item>
		</usages>
	</functionalPart>
	<level>70</level>
	<requiredLevel>70</requiredLevel>
	<quality href="/Mechanics/ItemQualities/Common.xdb" />
	<prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
	<interactions>
		<availableQuests>
			<Item href="EmpireGoToNPC.(QuestResource).xdb" />
			<Item href="LeagueGoToNPC.(QuestResource).xdb" />
		</availableQuests>
	</interactions>
	<binding>BindOnPickup</binding>
	<itemMallType>ITEMMALLABLE</itemMallType>
	<name href="QuestLetter.(ItemResource).Name.txt" />
	<description href="QuestLetter.(ItemResource).Description.txt" />
</gameMechanics.constructor.schemes.item.ItemResource>
