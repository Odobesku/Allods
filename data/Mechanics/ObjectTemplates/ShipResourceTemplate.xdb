								<Item type="gameMechanics.world.ship.elements.ImpactCoolReactor" />
								<Item type="gameMechanics.world.ship.ImpactAddInsight">
									<count>999</count>
								</Item>
							</impactsOn>
						</Item>
						<Item type="gameMechanics.world.ship.elements.effects.EffectAllDevices">
							<effects>
