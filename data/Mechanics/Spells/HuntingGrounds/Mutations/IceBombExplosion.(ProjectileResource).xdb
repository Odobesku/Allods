<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739851519</resourceId>
	</Header>
	<name href="IceBombExplosion.(ProjectileResource).Name.txt" />
	<visObject href="/Spells/FX/Spells/IceBomb_Main.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<altitude>0</altitude>
	<lifeLengthCap>6000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.Aura">
			<checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
			<affectGroup>Enemies</affectGroup>
			<radius>10</radius>
			<impactsIn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="IceBombWarn.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsIn>
			<impactsOut>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="IceBombWarn.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOut>
			<filter type="gameMechanics.world.creature.AvatarFilter" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>5000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOff>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="IceBombExplosion.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
							<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
							<radius>8</radius>
							<affectGroup>Enemies</affectGroup>
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="IceBombFreeze.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
						</Item>
					</impactsOff>
				</Item>
			</effects>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
