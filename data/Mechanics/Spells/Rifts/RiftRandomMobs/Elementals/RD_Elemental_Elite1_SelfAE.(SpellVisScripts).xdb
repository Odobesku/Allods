<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect02Down.(VisObjectTemplate).xdb" />
                        <scale>2</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Spells/AOEAura_Red_R10.(VisObjectTemplate).xdb" />
                <lockScale>true</lockScale>
                <scale>1</scale>
            </Item>
        </visualEffects>
    </wholeCasting>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>300</delay>
                        <effectFx href="/Spells/FX/Spells/HitLightning_big_01_ShakeCamera.(VisObjectTemplate).xdb" />
                        <fixPoint>true</fixPoint>
                        <lockScale>true</lockScale>
                        <scale>1.5</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>