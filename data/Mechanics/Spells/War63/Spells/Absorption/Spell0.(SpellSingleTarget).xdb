<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739920589</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
	</groups>
	<Name href="Spell0.(SpellSingleTarget).Name.txt" />
	<Description href="Spell0.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer href="Absorb.(CalcerFloatResource).xdb" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>FormulaPercent</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Warrior/WarriorToughie.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Warrior/AdrenalineRush.(SpellVisScripts).xdb" />
	<targetType>STTSelf</targetType>
	<ranks>
		<Item href="Spell01.(SpellSingleTarget).xdb" />
		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<needInFront>false</needInFront>
	<mechanics>
		<cooldown>
			<duration var="cd_duration" />
		</cooldown>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceMana">
				<mana>25</mana>
				<manaType>
					<Item>Energy</Item>
				</manaType>
			</Item>
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
						<lhs type="gameMechanics.elements.calcers.CalcerDamagePoolBarrier" />
						<rhs type="gameMechanics.elements.calcers.LongData">
							<value>0</value>
						</rhs>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ImpactRetriveDamageFromPoolBarrier">
						<damage type="gameMechanics.elements.calcers.FloatToLongCalcer">
							<calcer type="gameMechanics.elements.calcers.CalcerMul">
								<calcers>
									<Item type="gameMechanics.elements.calcers.FullHealthCalcer" />
									<Item type="constructor.elements.CalcerFloatExternal">
										<externalCalcer href="Absorb.(CalcerFloatResource).xdb" />
									</Item>
								</calcers>
							</calcer>
						</damage>
					</Item>
				</impactsIf>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
