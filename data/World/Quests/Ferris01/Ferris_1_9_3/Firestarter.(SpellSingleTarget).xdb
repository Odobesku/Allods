<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739885097</resourceId>
	</Header>
	<Name href="Firestarter.(SpellSingleTarget).Name.txt" />
	<Description href="Firestarter.(SpellSingleTarget).Description.txt" />
	<image href="/Interface/Icons/Spells/Engineer/EngineerFireShot.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualScripts href="/Spells/VisScripts/Exploits/UseStanding.(ExploitVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>5000</prepareDuration>
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<isAggro>false</isAggro>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
				<id href="Counter2.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
						<zone href="/Maps/Ferris/ScriptZones/Ferris_1_9_3_House01.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ImpactSummon">
						<destination type="gameMechanics.map.destination.DestinationLocator">
							<locator>
								<scriptID>Ferris_1_9_3_house1</scriptID>
								<map href="/Maps/Ferris/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
							</locator>
						</destination>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
								<delay>30000</delay>
								<impacts>
									<Item type="gameMechanics.elements.impacts.Disintegrate" />
								</impacts>
							</Item>
						</impacts>
						<impactsFromTarget>
							<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
								<impacts>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="Fire1_vis.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									</Item>
								</impacts>
							</Item>
						</impactsFromTarget>
						<object href="/Items/InteractiveObjects/Ferris/Ferris_01/Ferris_1_9_3_Fire1/Ferris_1_9_3_Fire1.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
					</Item>
				</impactsIf>
				<impactsElse>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
								<zone href="/Maps/Ferris/ScriptZones/Ferris_1_9_3_House02.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.ImpactSummon">
								<destination type="gameMechanics.map.destination.DestinationLocator">
									<locator>
										<scriptID>Ferris_1_9_3_house2</scriptID>
										<map href="/Maps/Ferris/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
									</locator>
								</destination>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
										<delay>30000</delay>
										<impacts>
											<Item type="gameMechanics.elements.impacts.Disintegrate" />
										</impacts>
									</Item>
								</impacts>
								<impactsFromTarget>
									<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
										<impacts>
											<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
												<buff href="Fire2_vis.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											</Item>
										</impacts>
									</Item>
								</impactsFromTarget>
								<object href="/Items/InteractiveObjects/Ferris/Ferris_01/Ferris_1_9_3_Fire2/Ferris_1_9_3_Fire2.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
							</Item>
						</impactsIf>
					</Item>
				</impactsElse>
			</Item>
			<Item type="gameMechanics.elements.impacts.BuffDetacher">
				<buff href="FireForHouse.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
				<id href="/World/Quests/Ferris01/Ferris_1_9_3_rep/Counter3.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
