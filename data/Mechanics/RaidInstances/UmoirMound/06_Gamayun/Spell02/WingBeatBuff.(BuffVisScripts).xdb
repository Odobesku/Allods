<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>InSequence</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>CLAMP</mode>
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
				<channelOverrideScript />
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>channelCastOmni</Item>
						</animations>
						<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
						<channelOverrideScript />
					</Item>
					<Item type="VisActionList">
						<playWhile type="VisActionDelay">
							<time>9000</time>
						</playWhile>
						<elements>
							<Item type="CreatureEffectsAction">
								<visActionID>Gamajun_Aoe_WingBeat_234r2</visActionID>
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Mobs/Gamajun_Aoe_WingBeat.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<effectAlias href="" />
										<lockScale>true</lockScale>
										<scale>2.16</scale>
										<fadeInTime>300</fadeInTime>
										<fadeOutTime>800</fadeOutTime>
										<offendTime />
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
