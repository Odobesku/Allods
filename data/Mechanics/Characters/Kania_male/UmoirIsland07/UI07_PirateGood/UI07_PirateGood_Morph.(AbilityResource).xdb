<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739855678</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.HealthTrigger">
			<healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
				<multiplier>0.2</multiplier>
			</healthOn>
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
					<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
						<value>0.75</value>
					</chanceCalcer>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactMobMorph">
							<newMobWorld href="/Characters/Kania_male/Instances/UmoirIsland07/UI07_PirateGood/UI07_PirateGood_NPC.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="/Mechanics/Spells/CommonBuffs/Fear/Buff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
					<impactsLose>
						<Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
							<ability href="UI07_PirateGood_Morph.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
						</Item>
					</impactsLose>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.LifeGuard">
			<level>0.1</level>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
