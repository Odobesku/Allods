<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Description href="/Spells/VisScripts/Prototypes/Parts/Base.Description.txt" />
    <actionBarStart type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.CreatureRunVisActionResource">
                <resource href="/Spells/VisScripts/Prototypes/PreCastAnimationOmniShield.(CreatureVisActionResource).xdb#xpointer(/client.VisualConstructor.CreatureVisActionResource)" />
            </Item>
            <Item type="client.Replica.CreatureRunVisActionResource">
                <resource href="/Spells/VisScripts/Prototypes/PreCastFXNatureWand.(CreatureVisActionResource).xdb#xpointer(/client.VisualConstructor.CreatureVisActionResource)" />
            </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </actionBarStart>
    <precastType>PRECAST_DEFAULT</precastType>
    <wholeCasting type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.CreatureRunVisActionResource" />
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </wholeCasting>
    <charged type="client.Replica.CreatureChargedSpellAction">
        <effectFx href="/Spells/FX/Spells/PocketSpellNature01.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
        <effectLocator>Wand_Slot_FX</effectLocator>
        <fadeInTime>0</fadeInTime>
        <fadeOutTime>0</fadeOutTime>
    </charged>
    <launch type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.Sound3DAction">
                <locator>FROM_LOCATOR_NAME</locator>
                <sound>
                    <creationRadius>-1</creationRadius>
                    <name>spells/Druid/DruidCallOfTheWild</name>
                    <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
                </sound>
                <forcedSoundStop>false</forcedSoundStop>
                <onlyForMainAvatar>false</onlyForMainAvatar>
            </Item>
            <Item type="client.Replica.VisActionList">
                <elements>
                    <Item type="client.Replica.CreatureEffectsAction">
                        <category>EFFECT_DEFAULT</category>
                        <visualEffects>
                            <Item>
                                <delay>0</delay>
                                <effectAnimations>
                                    <mode>DIE</mode>
                                </effectAnimations>
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <scale>1</scale>
                                <fixPoint>false</fixPoint>
                                <lockScale>false</lockScale>
                                <muteFxSounds>false</muteFxSounds>
                                <ignoreParentRotation>true</ignoreParentRotation>
                                <locator>Global</locator>
                                <member>Default_Member</member>
                                <offset x="0" y="0" z="0" />
                                <rotation x="0" y="0" z="0" w="0" />
                                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                            </Item>
                            <Item>
                                <delay>0</delay>
                                <effectAnimations>
                                    <mode>DIE</mode>
                                </effectAnimations>
                                <effectFx href="/Spells/FX/Spells/ReadySpellDirectNatureWand_Cast.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <scale>1</scale>
                                <fixPoint>true</fixPoint>
                                <lockScale>false</lockScale>
                                <muteFxSounds>false</muteFxSounds>
                                <ignoreParentRotation>true</ignoreParentRotation>
                                <locator>Global</locator>
                                <member>Default_Member</member>
                                <offset x="0" y="0" z="0" />
                                <rotation x="0" y="0" z="0" w="0" />
                                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                            </Item>
                        </visualEffects>
                        <dontFade>false</dontFade>
                        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                        <stopOnDeath>false</stopOnDeath>
                    </Item>
                </elements>
                <play>Simultaneously</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </launch>
    <ownKillingParams>
        <probabilityNoOverkill>0.2</probabilityNoOverkill>
        <probabilityWithOverkill>1</probabilityWithOverkill>
    </ownKillingParams>
    <playOnTargets>
        <specialAction type="client.Replica.VisActionList">
            <elements>
                <Item type="client.Replica.CreatureEffectsAction">
                    <category>EFFECT_DEFAULT</category>
                    <visualEffects>
                        <Item>
                            <delay>0</delay>
                            <effectAnimations>
                                <mode>DIE</mode>
                            </effectAnimations>
                            <fadeInTime>0</fadeInTime>
                            <fadeOutTime>0</fadeOutTime>
                            <scale>1</scale>
                            <fixPoint>false</fixPoint>
                            <lockScale>true</lockScale>
                            <muteFxSounds>false</muteFxSounds>
                            <ignoreParentRotation>false</ignoreParentRotation>
                            <locator>Global</locator>
                            <member>Default_Member</member>
                            <offset x="0" y="0" z="0" />
                            <rotation x="0" y="0" z="0" w="0" />
                            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                        </Item>
                    </visualEffects>
                    <dontFade>false</dontFade>
                    <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                    <stopOnDeath>false</stopOnDeath>
                </Item>
                <Item type="client.Replica.CreatureRunVisActionResource" />
            </elements>
            <play>Simultaneously</play>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
        </specialAction>
        <skipBloodFx>false</skipBloodFx>
        <skipHitAnimations>false</skipHitAnimations>
    </playOnTargets>
    <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>