<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>227252</resourceId>
    </Header>
    <Name href="DeathExplosion.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Spells/Psionic/PsionicMindBlast.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>6000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="DeathExplosion.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>250</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <affectGroup>Enemies</affectGroup>
                                    <affectHolder>false</affectHolder>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
                                            <phantom href="/Mechanics/RaidInstances/UmoirMound/04_Jaga_Hexe/04_Witch_Yaga.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                    <element>SHADOW</element>
                                                    <damage>50</damage>
                                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.world.creature.AvatarFilter">
                                        <withPet>true</withPet>
                                    </filter>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                    <impactsResource href="/Mechanics/RaidInstances/UmoirMound/04_Jaga_Hexe/Spell02/DeathRelesaingBallsImpacts.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.2</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>1</level>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>10000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="DeathExplosion.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="BallsCollected.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>