<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739916796</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
					<key href="/System/ContentKeys/HGTest.(ContentKey).xdb" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.CombatStateTrigger">
					<onEnter>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
									<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
										<value>0.03</value>
									</chanceCalcer>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
											<impacts>
												<Item type="gameMechanics.elements.impacts.AttachAbility">
													<ability href="/Mechanics/HuntingGround/Ghosting/HGTemporaryMob.(AbilityResource).xdb" />
												</Item>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/HuntingGround/Ghosting/ExtendedLoot.(BuffResource).xdb" />
												</Item>
												<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
													<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
														<radius>55</radius>
													</distributor>
													<data href="/Mechanics/HuntingGround/MiniBosses/DemonLiarTransform.(ClientData).xdb" />
												</Item>
												<Item type="gameMechanics.elements.impacts.ImpactMobMorph">
													<newMobWorld href="/Creatures/Colossus/Instances/HuntingGround8/HG8_TastyCollosusGeneral.(MobWorld).xdb" />
												</Item>
											</impacts>
										</Item>
									</impacts>
									<impactsLose>
										<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
													<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
														<value>0.03</value>
													</chanceCalcer>
													<impacts>
														<Item type="gameMechanics.elements.impacts.ImpactSummon">
															<destination type="gameMechanics.map.destination.RelativeRotatePos">
																<base type="gameMechanics.map.destination.SelfPosDestination" />
																<offset>5</offset>
															</destination>
															<impacts>
																<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
																	<impacts>
																		<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
																			<projectileData>
																				<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
																					<destination type="gameMechanics.map.destination.SelfPosDestination" />
																				</moveType>
																				<resource href="/Mechanics/HuntingGround/MiniBosses/HGAddSummon.(ProjectileResource).xdb" />
																			</projectileData>
																		</Item>
																	</impacts>
																</Item>
																<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																	<buff href="/Mechanics/HuntingGround/Ghosting/HGSummonedWeakness.(BuffResource).xdb" />
																</Item>
																<Item type="gameMechanics.elements.impacts.AttachAbility">
																	<ability href="/Mechanics/HuntingGround/Ghosting/HGTemporaryMob.(AbilityResource).xdb" />
																</Item>
																<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																	<buff href="/Mechanics/HuntingGround/Ghosting/ExtendedLoot.(BuffResource).xdb" />
																</Item>
																<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
															</impacts>
															<object href="/Creatures/Spider/Instances/HuntingGround8/HG8_SpiderArch_Friend.(MobWorld).xdb" />
														</Item>
													</impacts>
												</Item>
											</impacts>
										</Item>
									</impactsLose>
								</Item>
							</impacts>
						</Item>
					</onEnter>
				</Item>
				<Item type="gameMechanics.elements.effects.DeathTrigger">
					<impactsToKiller>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
									<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
										<value>0.03</value>
