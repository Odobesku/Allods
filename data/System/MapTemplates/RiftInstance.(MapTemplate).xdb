<?xml version="1.0" encoding="UTF-8" ?>
<mapLoader.MapTemplate>
    <Header>
        <resourceId>739921677</resourceId>
    </Header>
    <hasPatches>true</hasPatches>
    <headParts>
        <parts>
            <Item type="mapLoader.parts.PlayerCountResource" />
            <Item type="mapLoader.parts.MapDestroyerResource">
                <instanceLifeTime>1000</instanceLifeTime>
            </Item>
            <Item type="gameMechanics.map.basicElements.MapSpecificEffects">
                <effects>
                    <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                        </predicates>
                        <effectsIf>
                            <Item type="gameMechanics.world.mob.behaviour.components.effects.EffectCanBeAggred" />
                        </effectsIf>
                    </Item>
                    <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                        <effectsIf>
                            <Item type="gameMechanics.constructor.basicElements.EffectList">
                                <effectsResource href="/Mechanics/Mounts/Prototypes/InstanceDismount.(EffectListResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.effects.EffectSetDisconnectTimeout">
                                <disconnectTime>300000</disconnectTime>
                            </Item>
                        </effectsIf>
                    </Item>
                </effects>
            </Item>
        </parts>
    </headParts>
    <cellParts>
        <parts>
            <Item type="gameMechanics.world.mob.MobCellCountResource">
                <limit>40</limit>
                <softLimit>25</softLimit>
            </Item>
            <Item type="gameMechanics.map.spawn.SummonPoolManager">
                <globalPool href="/System/GlobalSummonPools/SummonPoolPersonalInstance.xdb" />
            </Item>
            <Item type="gameMechanics.map.basicElements.MapEvacuatorResource">
                <evacuator type="gameMechanics.map.basicElements.StoredPosAvatarMapEvacuator" />
            </Item>
        </parts>
    </cellParts>
    <entrance type="gameMechanics.map.instance.PersonalInstanceEntrance" />
    <pathfinderSettings>
        <superJumpMode>true</superJumpMode>
    </pathfinderSettings>
    <mechanicsSettings>
        <requireExit>true</requireExit>
        <forDwellersOnly>true</forDwellersOnly>
        <evadeMob>false</evadeMob>
        <prohibitWorldDrop>true</prohibitWorldDrop>
        <allowInvites>false</allowInvites>
    </mechanicsSettings>
</mapLoader.MapTemplate>