<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>211889</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                        <Item type="gameMechanics.elements.predicates.PredicateMobClass">
                            <mobClass href="/Mechanics/MobClasses/HGLethaler.(MobClass).xdb#xpointer(/gameMechanics.world.mob.MobClass)" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.CombatStateTrigger">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                            <radius>10</radius>
                                            <affectGroup>Friends</affectGroup>
                                            <affectHolder>false</affectHolder>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="HG_Enrage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impacts>
                                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                <predicates>
                                                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                                        <predicates>
                                                            <Item type="gameMechanics.elements.predicates.PredicateMobClass">
                                                                <mobClass href="/Mechanics/MobClasses/HGLethaler.(MobClass).xdb#xpointer(/gameMechanics.world.mob.MobClass)" />
                                                            </Item>
                                                            <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                                                        </predicates>
                                                    </Item>
                                                </predicates>
                                            </filter>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <tick>5000</tick>
                            <initialDelay>5000</initialDelay>
                        </Item>
                    </effects>
                </Item>
            </effectsIf>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>