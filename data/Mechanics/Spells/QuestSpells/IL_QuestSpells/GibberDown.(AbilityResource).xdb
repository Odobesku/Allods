<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>201869</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0</multiplier>
            </healthOn>
            <healthOff type="gameMechanics.constructor.basicElements.FloatZero" />
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>5000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>Gibberling_Floor4</scriptID>
                                <map href="/Maps/Inst_LeagueStart/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <onBehalfOfTarget>true</onBehalfOfTarget>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="GibberWounded.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <scalerTarget type="gameMechanics.elements.scalers.TrivialScaler" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>