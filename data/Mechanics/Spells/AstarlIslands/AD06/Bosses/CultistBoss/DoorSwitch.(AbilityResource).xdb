<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739824708</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Boss3Door1</scriptID>
						<map href="/Maps/AstralDungeon06/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Close</switchType>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Boss3Door2</scriptID>
						<map href="/Maps/AstralDungeon06/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Close</switchType>
						</Item>
					</impacts>
				</Item>
			</onEnter>
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Boss3Door1</scriptID>
						<map href="/Maps/AstralDungeon06/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Open</switchType>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Boss3Door2</scriptID>
						<map href="/Maps/AstralDungeon06/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Open</switchType>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateProjectile" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</onLeave>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
