<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<FXDown>/Spells/FX/Mobs/WormGlacial_ReadySpell_GreaterAcid.(VisObjectTemplate).xdb</FXDown>
			<FXWand>/Spells/FX/Mobs/WormGlacial_ReadySpell_GreaterAcid.(VisObjectTemplate).xdb</FXWand>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx hrefvar="FXWand" />
				<effectAlias href="" />
				<fadeOutTime>200</fadeOutTime>
				<locator>FROM_LOCATOR_NAME</locator>
				<locatorName>Hand_R</locatorName>
				<offendTime />
			</Item>
			<Item>
				<effectFx hrefvar="FXWand" />
				<effectAlias href="" />
				<fadeOutTime>200</fadeOutTime>
				<locator>FROM_LOCATOR_NAME</locator>
				<locatorName>Hand_L</locatorName>
				<offendTime />
			</Item>
		</visualEffects>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
