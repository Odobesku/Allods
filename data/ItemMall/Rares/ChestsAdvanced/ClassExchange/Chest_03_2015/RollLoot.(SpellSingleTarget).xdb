<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>140996</resourceId>
    </Header>
    <Name href="RollLoot.(SpellSingleTarget).Name.txt" />
    <Description href="RollLoot.(SpellSingleTarget).Description.txt" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                <currency href="/Mechanics/AlternativeCurrencies/ItemMall/CasualToken.xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>1</value>
                </sumCalcer>
            </Item>
            <Item type="itemService.elements.ImpactContestIncrease">
                <contestResource href="/Mechanics/Rules/BoxContest/03_2015_ClassExchangeContest/Contest.(OpenBoxContestResource).xdb#xpointer(/itemService.rules.components.contest.OpenBoxContestResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceAltCurrency">
                                            <currency href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/Guarantee_AC/TUC_recieved1.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                                            <count>1</count>
                                        </predicate>
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceAltCurrency">
                                            <currency href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/Guarantee_AC/Chest_counter1.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                                            <count>400</count>
                                        </predicate>
                                    </Item>
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.elements.resources.ResourceAltCurrency">
                                <currency href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/Guarantee_AC/TUC_recieved1.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                                <count>1</count>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.RandomImpact">
                        <entries>
                            <Item>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                            <item href="/ItemMall/Services/Avatar/RemortClassExchange_Universal_temp.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                        </item>
                                        <worldNotification href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/WorldNotify/ClassExchangeBoxOpenNotify1.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        <worldNotificationWithGuild href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/WorldNotify/ClassExchangeBoxOpenNotifyWithGuild1.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                                        <currency href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/Guarantee_AC/TUC_recieved1.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                                        <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                                            <value>1</value>
                                        </sumCalcer>
                                    </Item>
                                </impacts>
                                <chance>0.001</chance>
                            </Item>
                            <Item>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactDropLoot">
                                        <rolls type="gameMechanics.elements.calcers.FloatData">
                                            <value>1</value>
                                        </rolls>
                                        <lootTable href="DefaultLoot.(LootTableResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.LootTableResource)" />
                                    </Item>
                                </impacts>
                                <chance>0.999</chance>
                            </Item>
                        </entries>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                        <currency href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/Guarantee_AC/Chest_counter1.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                        <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                            <value>1</value>
                        </sumCalcer>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.RandomImpact">
                        <entries>
                            <Item>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                            <item href="/ItemMall/Services/Avatar/RemortClassExchange_Universal_temp.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                        </item>
                                        <worldNotification href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/WorldNotify/ClassExchangeBoxOpenNotify1.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        <worldNotificationWithGuild href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/WorldNotify/ClassExchangeBoxOpenNotifyWithGuild1.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                                        <currency href="/ItemMall/Rares/ChestsAdvanced/ClassExchange/Guarantee_AC/TUC_recieved1.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                                        <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                                            <value>1</value>
                                        </sumCalcer>
                                    </Item>
                                </impacts>
                                <chance>0.05</chance>
                            </Item>
                            <Item>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactDropLoot">
                                        <rolls type="gameMechanics.elements.calcers.FloatData">
                                            <value>1</value>
                                        </rolls>
                                        <lootTable href="DefaultLoot.(LootTableResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.LootTableResource)" />
                                    </Item>
                                </impacts>
                                <chance>0.95</chance>
                            </Item>
                        </entries>
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>