<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/DotShadow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Creatures/ParasiteShadow/ParasiteShadowFx.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations>
							<animations>
								<Item>special</Item>
							</animations>
						</effectAnimations>
						<lockScale>true</lockScale>
						<scale>1.4</scale>
						<fadeInTime>300</fadeInTime>
						<locator>Slot_BodyFX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
	<postAction type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Creatures/ParasiteShadow/ParasiteShadowFx.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<effectAnimations>
					<animations>
						<Item>special01</Item>
					</animations>
				</effectAnimations>
				<lockScale>true</lockScale>
				<scale>1.4</scale>
				<fadeInTime>200</fadeInTime>
				<locator>Slot_BodyFX</locator>
			</Item>
		</visualEffects>
	</postAction>
</BuffVisScripts>
