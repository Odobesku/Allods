<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>313584</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Hmyk_Ferris_1_9_3_add_plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMaster">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                                    <quest href="Ferris_1_9_3_add.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Aura">
            <radius>20</radius>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Hmyk_assistant_visibilty.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>1000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                        <value>0.5</value>
                                    </chanceCalcer>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Hmyk_assistant_visibilty.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="/Creatures/SnowFolk/Instances/Ferris/Snowfolk_Ferris_1_9_3.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            <Item href="/Creatures/SnowFolk/Instances/Ferris/Snowfolk_ranger_Ferris_1_9_3.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            <Item href="/Creatures/SnowFolk/Instances/Ferris/Snowfolk_scout.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            <Item href="/Creatures/SnowFolk/Instances/Ferris/Snowfolk_scout_ranger.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </mobs>
                    </Item>
                </predicates>
            </filter>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>