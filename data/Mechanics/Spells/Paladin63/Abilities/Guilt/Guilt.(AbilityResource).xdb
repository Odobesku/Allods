<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>206473</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Guilt.(AbilityResource).Name.txt" />
    <description href="Guilt.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>coeff</name>
            <value var="coeff" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Paladin/Fervor.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Paladin63/Abilities/WrathGiveMark/AddPhysDamageMark.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.NotStackableEffects">
                    <effects>
                        <Item type="gameMechanics.elements.effects.SpellsModifier">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                    <spells>
                                        <Item href="/Mechanics/Spells/Paladin63/Spells/CleansingHit/CleansingHit01.(SpellSingleTarget).xdb" />
                                    </spells>
                                </Item>
                            </predicates>
                            <modifiers>
                                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                                    <effects>
                                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                                <coeff var="coeff" />
                                                <calcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                                    <buff href="/Mechanics/Spells/Paladin63/Abilities/WrathGiveMark/AddPhysDamageMark.(BuffResource).xdb" />
                                                    <forAllRanks>true</forAllRanks>
                                                </calcer>
                                            </scaler>
                                        </Item>
                                    </effects>
                                    <onBehalfOfHolder>true</onBehalfOfHolder>
                                </Item>
                            </modifiers>
                        </Item>
                        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
                            <conditionalImpacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="/Mechanics/Spells/Paladin63/Abilities/WrathGiveMark/AddPhysDamageMark.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                    <conditions>
                                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                            <spells>
                                                <Item href="/Mechanics/Spells/Paladin63/Spells/CleansingHit/CleansingHit01.(SpellSingleTarget).xdb" />
                                            </spells>
                                        </Item>
                                    </conditions>
                                </Item>
                            </conditionalImpacts>
                            <stages>
                                <Item>Launch</Item>
                            </stages>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Guilt01.(AbilityResource).xdb" />
        <Item href="Guilt02.(AbilityResource).xdb" />
        <Item href="Guilt03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>