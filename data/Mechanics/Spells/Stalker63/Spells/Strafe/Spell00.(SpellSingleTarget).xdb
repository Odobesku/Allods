<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739932023</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/AmmoSpells.(ActionGroup).xdb" />
	</groups>
	<Name href="Spell00.(SpellSingleTarget).Name.txt" />
	<Description href="Spell00.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="targets" />
		</Item>
		<Item>
			<name>var1</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer href="CalcerDamage.(CalcerFloatResource).xdb" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>RangedWeaponScaler</formula>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerIf">
						<condition type="gameMechanics.elements.predicates.PredicateEquipped">
							<dressType>AMMO</dressType>
						</condition>
						<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
							<mul>0.15</mul>
							<mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
								<summands>
									<Item type="gameMechanics.elements.calcers.ItemQualityCalcer">
										<dressSlot>AMMO</dressSlot>
									</Item>
									<Item type="gameMechanics.elements.calcers.FloatData">
										<value>-5</value>
									</Item>
								</summands>
							</mulCalcer>
							<sum>1</sum>
						</scalerIf>
						<scalerElse type="gameMechanics.elements.scalers.TrivialScaler" />
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Stalker/VolleyOfArrows.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Stalker/Strafe.(SpellVisScripts).xdb" />
	<prepareDuration>6000</prepareDuration>
	<immutablePrepareDuration>true</immutablePrepareDuration>
	<targetType>STTSelf</targetType>
	<ranks>
		<Item href="Spell01.(SpellSingleTarget).xdb" />
		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>1000</duration>
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mulCalcer type="gameMechanics.elements.calcers.CalcerIf">
					<predicate type="gameMechanics.elements.predicates.PredicateEquipped">
						<dressType>AMMO</dressType>
					</predicate>
					<calcerIf type="gameMechanics.elements.calcers.LinearCalcer">
						<mul>-25</mul>
						<mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
							<dressSlot>AMMO</dressSlot>
						</mulCalcer>
						<sum>0</sum>
					</calcerIf>
					<calcerElse type="gameMechanics.elements.calcers.FloatData">
						<value>0</value>
					</calcerElse>
				</mulCalcer>
				<sum>300</sum>
			</scaler>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateEquipped">
				<dressType>RANGED</dressType>
				<weaponRequired>true</weaponRequired>
			</Item>
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceIf">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateEquipped">
						<dressType>AMMO</dressType>
						<itemClass href="/Mechanics/ItemClasses/Other_InfiniteTeardrop.(ItemClass).xdb" />
					</Item>
				</predicates>
				<resourceIf type="gameMechanics.constructor.basicElements.ResourceUniversal" />
				<resourceElse type="gameMechanics.elements.resources.ResourceDressItem">
					<slot>AMMO</slot>
					<count>5</count>
				</resourceElse>
			</Item>
		</casterResources>
		<channelingMechanics>
			<channelingBuff hrefvar="channelingBuff" />
		</channelingMechanics>
		<casterChannelingEffects>
			<Item type="gameMechanics.elements.effects.Switch">
				<impactsOff>
					<Item type="gameMechanics.elements.impacts.BuffDetacher">
						<buff href="Buff01.(BuffResource).xdb" />
					</Item>
				</impactsOff>
			</Item>
		</casterChannelingEffects>
	</mechanics>
	<speed>35</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
