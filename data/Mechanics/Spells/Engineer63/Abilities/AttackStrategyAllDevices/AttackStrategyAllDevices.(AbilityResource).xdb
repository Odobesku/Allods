                                </Item>
                            </conditions>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="/Mechanics/Spells/Engineer63/Abilities/SelfDestroy/DoNotExplode.(MarkResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                                    <radius>10</radius>
                                                    <affectGroup>Enemies</affectGroup>
                                                    <affectHolder>false</affectHolder>
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="/Mechanics/Spells/Engineer63/Spells/Strategies/Bleeding.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                            <projectileData>
                                                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                                                <resource href="/Mechanics/Spells/Engineer63/Spells/Strategies/ExplosionVisual.(ProjectileResource).xdb" />
                                                            </projectileData>
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </casterImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
