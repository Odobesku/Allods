<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>100</time>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/AOEAura_Red.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<useCastPoint>true</useCastPoint>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>ready</Item>
						</animations>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
