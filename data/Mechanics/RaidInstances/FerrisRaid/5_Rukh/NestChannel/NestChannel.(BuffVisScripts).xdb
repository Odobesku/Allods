<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/DemonCrabBoss_ReadySpellDirectDown.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<scale>2.3</scale>
						<offset z="0.3" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>idle</Item>
				</animations>
				<advanced>
					<speed>2</speed>
				</advanced>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/JagaAdd_DeathExplosion.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<scale>1.5</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
					<name>spells/FX/Mobs/RukhBoss/ChannelSpell</name>
				</sound>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
