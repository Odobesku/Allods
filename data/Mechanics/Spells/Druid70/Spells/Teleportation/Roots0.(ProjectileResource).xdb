<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739923679</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <visObject href="/Spells/FX/Spells/DruidEntanglingRootsAbility.(VisObjectTemplate).xdb" />
    <lifeLengthCap>6000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <tick>1000</tick>
            <affectGroup>Enemies</affectGroup>
            <radius>10</radius>
            <filter type="gameMechanics.world.creature.CreatureFilter" />
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>POISON</element>
                    <damage>1</damage>
                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                        <additionalMultiplier>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </additionalMultiplier>
                    </scaler>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>4</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Slowness/Slowness.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>0</multiplier>
                            </durationScaler>
                        </Item>
                    </impacts>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Slowness/Slowness.(BuffResource).xdb" />
                </Item>
            </impactsOut>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>