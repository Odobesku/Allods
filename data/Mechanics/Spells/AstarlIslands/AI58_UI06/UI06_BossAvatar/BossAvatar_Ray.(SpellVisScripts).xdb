<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Spells/BossAvatar_Ray.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <startPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </endPoint>
                <fadeInTime>100</fadeInTime>
                <fadeOutTime>200</fadeOutTime>
                <velocity>50</velocity>
                <offendTime type="EffectOffendConstDelay" />
            </Item>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <delay>230</delay>
                        <effectFx href="/Spells/FX/Spells/BossAvatar_Explosion.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                        <scale>0.75</scale>
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>500</fadeOutTime>
                        <locator>Slot_Global</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </actionBarStart>
    <wholeCasting />
</SpellVisScripts>