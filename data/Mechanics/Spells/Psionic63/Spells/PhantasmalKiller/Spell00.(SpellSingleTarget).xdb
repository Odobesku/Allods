<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>220115</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Spell00.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="calcerDamage" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>MagicScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>100</mul>
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer hrefvar="calcerHP" />
                </mulCalcer>
            </scaler>
        </Item>
        <Item>
            <name>var3</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer href="CalcerDuration.(CalcerFloatResource).xdb" />
                </mulCalcer>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Psionic/PsionicPhantasmalKiller.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Psionic/PhantasmalKiller.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>1500</prepareDuration>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration var="cooldown" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIncVariable">
                <variable href="/Mechanics/Spells/Psionic63/Abilities/StressResource/StressResource.(VariableResource).xdb" />
                <inc>25</inc>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                <value>10</value>
            </Item>
            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                <impacts>
                    <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                        <destination type="gameMechanics.elements.calcers.DestinationBehind">
                            <comfortRange>1</comfortRange>
                            <maxSteps>1</maxSteps>
                        </destination>
                        <calcDestinationOnTarget>false</calcDestinationOnTarget>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="AggroLeader.(BuffResource).xdb" />
                                <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer href="CalcerDuration.(CalcerFloatResource).xdb" />
                                    </mulCalcer>
                                </durationScaler>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactsToMaster">
                                                <impacts>
                                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                        <buff href="Owner00.(BuffResource).xdb" />
                                                        <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                <externalCalcer href="CalcerDuration.(CalcerFloatResource).xdb" />
                                                            </mulCalcer>
                                                        </durationScaler>
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.world.changeappearance.ImpactCopyAppearance" />
                        </impacts>
                        <plane href="/Mechanics/Planes/TwinPlane.xdb" />
                        <assistantResource href="Killer.(AssistantResource).xdb" />
                        <mobResource hrefvar="mobResource" />
                        <level type="gameMechanics.elements.calcers.CalcerLevel" />
                        <linkMode>ModifiedHealth</linkMode>
                        <planeSyncStrategy>Sync</planeSyncStrategy>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                <impacts>
                                    <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactCopyFaction" />
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff hrefvar="buffKiller" />
                                                <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                        <externalCalcer href="CalcerDuration.(CalcerFloatResource).xdb" />
                                                    </mulCalcer>
                                                </durationScaler>
                                            </Item>
                                        </impacts>
                                        <assistantResource href="Killer.(AssistantResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>