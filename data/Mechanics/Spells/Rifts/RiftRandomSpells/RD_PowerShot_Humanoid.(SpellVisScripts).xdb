<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/MageIceCometAbility.(VisObjectTemplate).xdb" />
				<explosionFx href="/Spells/FX/Spells/HitIce.(VisObjectTemplate).xdb" />
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_FX</locator>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</pointOnTarget>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>