						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Owner.(BuffResource).xdb" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.PostponedImpacts">
							<impacts>
								<Item type="gameMechanics.elements.impacts.StackBuff">
									<buff href="MercOwner.(BuffResource).xdb" />
									<resetTimer>false</resetTimer>
									<delta type="gameMechanics.elements.calcers.FloatData">
										<value>-1</value>
									</delta>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Owner.(BuffResource).xdb" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.world.social.group.mercs.EffectMerc" />
		<Item type="gameMechanics.elements.effects.EffectDamageTrigger">
			<impacts>
				<casterToTarget>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="NoRegenSignaled.(BuffResource).xdb" />
								</predicate>
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
										<affectGroup>Friends</affectGroup>
										<impacts>
											<Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
												<group href="/Mechanics/Spells/Groups/MercRegen.(ActionGroup).xdb" />
