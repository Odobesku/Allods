<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart />
	<wholeCasting />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="VisActionList">
				<playWhile />
				<elements>
					<Item type="VisActionDelay">
						<time>400</time>
					</Item>
					<Item type="VisActionList">
						<playWhile />
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Mobs/WormGlacial_Projectilel_SlimeBall.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<explosionFx href="/Spells/FX/Mobs/WormGlacial_Aoe_SlimeBal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<theGe>15</theGe>
								<pointOnCaster type="VisPointLocator">
									<locator>Slot_Mouth</locator>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator>Slot_Global</locator>
								</pointOnTarget>
								<offendTime />
							</Item>
							<Item type="VisActionStopAction">
								<stoppedActionID>precast_fx</stoppedActionID>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
