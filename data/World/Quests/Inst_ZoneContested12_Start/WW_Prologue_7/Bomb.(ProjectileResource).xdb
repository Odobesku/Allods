<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739922952</resourceId>
    </Header>
    <visObject href="/Spells/FX/Mobs/SiegeBoss_ArtilleryFireAOE.(VisObjectTemplate).xdb" />
    <lifeLengthCap>2600</lifeLengthCap>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
            <delay>300</delay>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>20</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="FirstHit.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.DirectDamage">
                                    <damage>1</damage>
                                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                            <multiplier>0.85</multiplier>
                                        </mulCalcer>
                                    </scalerTarget>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="FirstHit.(BuffResource).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
        </Item>
    </impactsOnStart>
</gameMechanics.world.projectile.ProjectileResource>