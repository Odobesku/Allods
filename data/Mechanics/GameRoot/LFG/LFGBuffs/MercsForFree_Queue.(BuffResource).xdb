<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739918024</resourceId>
    </Header>
    <Name href="MercsForFree_Queue.(BuffResource).Name.txt" />
    <Description href="MercsForFree_Queue.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/MercenariesBerserker.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.world.ship.elements.EffectMapChanged">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
                        <Item type="gameMechanics.map.instance.astralIsland.PredicateOnAstralIsland" />
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventMember" />
                        <Item type="gameMechanics.elements.scenarios.predicates.PredicateIsOnEventScenarioMap" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>60000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="MercsForFree_Queue.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGroupTrigger">
            <impactsOnLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="MercsForFree_Queue.(BuffResource).xdb" />
                </Item>
            </impactsOnLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="MercsForFree_Queue2.(BuffResource).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="MercsForFree_Queue2.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>