<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739900362</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.map.destination.DestinationModified">
										<destination type="gameMechanics.map.destination.SelfPosDestination" />
										<modifiers>
											<Item type="gameMechanics.map.destination.modifier.SpreadModifier">
												<verticalRange min="-1" max="-1" />
												<horizontalRange min="0" max="0" />
											</Item>
										</modifiers>
									</destination>
								</moveType>
								<resource href="StasisSwitchOn.(ProjectileResource).xdb" />
							</projectileData>
							<pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>5.75</radius>
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="StasisBuff.(BuffResource).xdb" />
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
						</Item>
					</impactsOn>
				</Item>
				<Item type="gameMechanics.elements.effects.TickableAura">
					<affectGroup>All</affectGroup>
					<radius>6</radius>
					<filter type="gameMechanics.world.creature.AvatarFilter" />
					<impactsOut>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="StasisBuff.(BuffResource).xdb" />
							<casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
						</Item>
					</impactsOut>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactActivateAggro" />
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>100</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
