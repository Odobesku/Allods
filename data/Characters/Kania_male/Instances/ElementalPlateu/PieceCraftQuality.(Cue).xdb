<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
	<Header>
		<resourceId>739952432</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="PieceCraftQuality.(Cue).Name.txt" />
	<text href="PieceCraftQuality.(Cue).Text.txt" />
	<conditions>
		<Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
			<lhs type="itemService.serverVariables.CalcerServerVariable">
				<variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
			</lhs>
			<rhs type="gameMechanics.elements.calcers.LongData">
				<value var="valueSeason" />
			</rhs>
		</Item>
	</conditions>
	<impacts>
		<Item type="gameMechanics.elements.impacts.ImpactShowVendorTable">
			<vendorTable hrefvar="vendorTable" />
		</Item>
	</impacts>
</gameMechanics.world.mob.interaction.Cue>
