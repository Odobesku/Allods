<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityIce_Precast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2.5</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_BodyFX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ElementalBoss_VolcanoStart_Main.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>spells/FX/World/AI66_Volcano/Splash</name>
				</sound>
				<forcedSoundStop>true</forcedSoundStop>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ElementalBoss_VolcanoEnd_Main.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/World/World.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>World/Zones/AI66/EarthQuake</name>
				</sound>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
