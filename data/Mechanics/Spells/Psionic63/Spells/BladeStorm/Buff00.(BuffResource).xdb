<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739924011</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Buff00.(BuffResource).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorFlurryOfBlows.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Psionic/BladeStorm.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>15</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>PHYSICAL</element>
                                    <damage>1</damage>
                                    <impactsOnHitTarget>
                                        <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                            <mark href="/Mechanics/Spells/Psionic63/Abilities/MentalAssault/DotTick.(MarkResource).xdb" />
                                        </Item>
                                    </impactsOnHitTarget>
                                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
                                            <calcers>
                                                <Item type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer hrefvar="externalCalcer" />
                                                </Item>
                                                <Item type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                    <value>1</value>
                                                </Item>
                                            </calcers>
                                        </mulCalcer>
                                    </scaler>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="BladeStorm.(MarkResource).xdb" />
                                </Item>
                            </impacts>
                            <groupRepeaters>true</groupRepeaters>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AliveFilter" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>8000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>