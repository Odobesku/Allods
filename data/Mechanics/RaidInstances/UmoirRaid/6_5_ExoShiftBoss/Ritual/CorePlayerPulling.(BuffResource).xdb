                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="CorePullingAura.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
