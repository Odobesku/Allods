<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222583</resourceId>
    </Header>
    <Name href="Feasted.(BuffResource).Name.txt" />
    <Description href="Feasted.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Food/MeatRaw.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
                    <spell href="HungerHM.(SpellSingleTarget).xdb" />
                    <factor>100</factor>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="RunAndSmash02.(BuffResource).xdb" />
                        </Item>
                    </impactsOff>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ChargeResource.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                    <spell href="HungerHM.(SpellSingleTarget).xdb" />
                    <duration>
                        <hour>1</hour>
                    </duration>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                    <spell href="PreyHM.(SpellSingleTarget).xdb" />
                    <duration>
                        <hour>1</hour>
                    </duration>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>1</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>