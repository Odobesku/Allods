<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739895411</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Darkness.(AbilityResource).Name.txt" />
	<description href="Darkness.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>stack</name>
			<value var="stack" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Necromancer/Bloodshield.chn.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.HealthTrigger">
			<healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
				<multiplier>0.6</multiplier>
			</healthOn>
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="Darkness_CD.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									</predicate>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Darkness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									<stacks type="gameMechanics.elements.calcers.FloatData">
										<value var="stack" />
									</stacks>
								</Item>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Darkness_CD.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<ranks>
		<Item href="Darkness01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Darkness02.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Darkness03.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
