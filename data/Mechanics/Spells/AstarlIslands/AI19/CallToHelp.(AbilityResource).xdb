<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739889573</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.map.variables.ImpactIfMapVariable">
					<variable href="MapVariables/EarthBoss.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
					<predicates>
						<Item type="gameMechanics.map.variables.PredicateMapVariableEqualsGeneric">
							<variableResource href="MapVariables/EarthBoss.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
							<expectedValue type="gameMechanics.elements.calcers.FloatData">
								<value>0</value>
							</expectedValue>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="Alarm.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>3000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactSummon">
									<destination type="gameMechanics.map.destination.RelativeRotatePos">
										<base type="gameMechanics.map.destination.SelfPosDestination" />
										<offset>1</offset>
									</destination>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="SpecialBuffs/TeleportVisual.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
									</impacts>
									<object href="/Characters/Undead_male/Instances/AstralIsle19/EarthGuard.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									<pool href="Guards.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
									<isPersonalPool>true</isPersonalPool>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactSummon">
									<destination type="gameMechanics.map.destination.RelativeRotatePos">
										<base type="gameMechanics.map.destination.SelfPosDestination" />
										<offset>1</offset>
									</destination>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="SpecialBuffs/TeleportVisual.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
									</impacts>
									<object href="/Characters/Undead_male/Instances/AstralIsle19/EarthGuard.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									<pool href="Guards.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
									<isPersonalPool>true</isPersonalPool>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</onEnter>
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
							<pool href="Guards.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
							<isPersonalPool>true</isPersonalPool>
							<impacts>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</onLeave>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
