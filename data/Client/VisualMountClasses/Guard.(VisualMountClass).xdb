<?xml version="1.0" encoding="UTF-8" ?>
<VisualMountClass>
	<animationSettings>
		<playOnRiderTopOnly href="" />
		<playOnRider href="" />
		<playOnMount href="Horse/PlayOnMountOnly.(AnimationsGroup).xdb#xpointer(/AnimationsGroup)" />
		<complexAnimations>
			<Item>
				<animation>loot</animation>
				<playOnRiderTop>mountGuardIdle</playOnRiderTop>
				<playOnRiderBottom>mountGuardIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>lootLoop</animation>
				<playOnRiderTop>mountGuardIdle</playOnRiderTop>
				<playOnRiderBottom>mountGuardIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>idle</animation>
				<playOnRiderTop>mountGuardIdle</playOnRiderTop>
				<playOnRiderBottom>mountGuardIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>jump</animation>
				<playOnRiderTop>mountGuardJump</playOnRiderTop>
				<playOnRiderBottom>mountGuardJump</playOnRiderBottom>
				<playOnMount>jump</playOnMount>
			</Item>
			<Item>
				<animation>jumpEnd</animation>
				<playOnRiderTop>mountGuardJumpLandRun</playOnRiderTop>
				<playOnRiderBottom>mountGuardJumpLandRun</playOnRiderBottom>
				<playOnMount>jumpEnd</playOnMount>
			</Item>
			<Item>
				<animation>jumpLandRun</animation>
				<playOnRiderTop>mountGuardJumpEnd</playOnRiderTop>
				<playOnRiderBottom>mountGuardJumpEnd</playOnRiderBottom>
				<playOnMount>jumpLandRun</playOnMount>
			</Item>
			<Item>
				<animation>jumpStart</animation>
				<playOnRiderTop>mountGuardJumpStart</playOnRiderTop>
				<playOnRiderBottom>mountGuardJumpStart</playOnRiderBottom>
				<playOnMount>jumpStart</playOnMount>
			</Item>
			<Item>
				<animation>specialCast</animation>
				<playOnRiderTop>mountGuardSpecialCast</playOnRiderTop>
				<playOnRiderBottom>mountGuardSpecialCast</playOnRiderBottom>
				<playOnMount>specialCast</playOnMount>
			</Item>
			<Item>
				<animation>death</animation>
				<playOnRiderTop>mount</playOnRiderTop>
				<playOnRiderBottom>mount</playOnRiderBottom>
				<playOnMount>death</playOnMount>
			</Item>
			<Item>
				<animation>run</animation>
				<playOnRiderTop>mountGuardRun</playOnRiderTop>
				<playOnRiderBottom>mountGuardRun</playOnRiderBottom>
				<playOnMount>run</playOnMount>
			</Item>
			<Item>
				<animation>runCharge</animation>
				<playOnRiderTop>mountGuardRun</playOnRiderTop>
				<playOnRiderBottom>mountGuardRun</playOnRiderBottom>
				<playOnMount>runCharge</playOnMount>
			</Item>
			<Item>
				<animation>shuffleLeft</animation>
				<playOnRiderTop>mount</playOnRiderTop>
				<playOnRiderBottom>mount</playOnRiderBottom>
				<playOnMount>shuffleLeft</playOnMount>
			</Item>
			<Item>
				<animation>shuffleRight</animation>
				<playOnRiderTop>mount</playOnRiderTop>
				<playOnRiderBottom>mount</playOnRiderBottom>
				<playOnMount>shuffleRight</playOnMount>
			</Item>
			<Item>
				<animation>walkBackwards</animation>
				<playOnRiderTop>mount</playOnRiderTop>
				<playOnRiderBottom>mount</playOnRiderBottom>
				<playOnMount>walkBackwards</playOnMount>
			</Item>
		</complexAnimations>
	</animationSettings>
	<fxSettings>
		<mountLocators>
			<Item>Slot_FX</Item>
			<Item>Slot_Global</Item>
			<Item>Global</Item>
		</mountLocators>
	</fxSettings>
	<controlParameters>
		<speedFactorForward>
			<startVelocity>12</startVelocity>
			<stopVelocity>2</stopVelocity>
			<startTime>200</startTime>
			<stopTime>150</stopTime>
		</speedFactorForward>
		<speedFactorBackward>
			<startVelocity>3</startVelocity>
			<stopVelocity>0</stopVelocity>
			<startTime>0</startTime>
			<stopTime>0</stopTime>
		</speedFactorBackward>
	</controlParameters>
	<pitchParameters>
		<minVelocity>6</minVelocity>
		<minVelocityPitch>1</minVelocityPitch>
		<topVelocity>10</topVelocity>
		<topVelocityPitch>15</topVelocityPitch>
		<minStepDeltaTMainAvatar>20</minStepDeltaTMainAvatar>
		<minStepDeltaT>150</minStepDeltaT>
		<minTurnRadius>5</minTurnRadius>
		<pitchMaxVelocity>40</pitchMaxVelocity>
		<maxPitch>20</maxPitch>
	</pitchParameters>
	<jumpSettings>
		<useJump>ALWAIS</useJump>
	</jumpSettings>
	<reinsSettings>
		<use>false</use>
	</reinsSettings>
	<skinChangedScript href="/Spells/VisScripts/Commands/ChangeSkin.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<levelChangedScript href="/Spells/VisScripts/Commands/LevelUp_Mount.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<summonVisualScript href="/Spells/VisScripts/Mount/SummonCommonHorse.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<riderOrientation>All_FromMountSlot</riderOrientation>
	<useRiderSpineTurn>false</useRiderSpineTurn>
</VisualMountClass>
