<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739827123</resourceId>
	</Header>
	<Name href="GiantBang.(SpellArea).Name.txt" />
	<nameTemplate href="GiantBang.(SpellArea).Name.txt" />
	<prepareDuration>30000</prepareDuration>
	<element>FIRE</element>
	<targetType>STTSelf</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<needInFront>false</needInFront>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="/Mechanics/Spells/AstralMobs/AstralBoss2/HoldBigBang.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</predicate>
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.world.ship.elements.PredicateIsShip" />
		</targetConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="CanCastGiantBang.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
		</casterResources>
		<channelingMechanics>
			<channelingBuff href="BigBangPrepare.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			<finishImpacts>
				<Item type="gameMechanics.world.device.cannon.ImpactCannonDamage">
					<damage type="gameMechanics.elements.calcers.CalcerMul">
						<calcers>
							<Item type="gameMechanics.elements.calcers.AstralMobImpactDamageCalcer">
								<damage>10500</damage>
							</Item>
							<Item type="gameMechanics.elements.calcers.AstralTLCalcer">
								<value type="gameMechanics.elements.calcers.FloatData">
									<value>1.33</value>
								</value>
							</Item>
							<Item type="gameMechanics.elements.calcers.AstralMobStrengthModCalcer" />
						</calcers>
					</damage>
					<hitCalcType type="gameMechanics.world.projectile.StaticCalcType" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ReturningImpactsGeneric">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactClientData">
							<data href="BigBangEffect.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
						</Item>
					</impacts>
				</Item>
			</finishImpacts>
		</channelingMechanics>
		<casterChannelingEffects>
			<Item type="gameMechanics.elements.effects.EffectDisableAct">
				<rooted>true</rooted>
				<actions>
					<Item>Move</Item>
				</actions>
			</Item>
		</casterChannelingEffects>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>1000</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
