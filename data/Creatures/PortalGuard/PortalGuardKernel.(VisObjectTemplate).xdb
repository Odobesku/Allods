<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>0</fadeOutMS>
    <geometry href="/Creatures/PortalGuard/PortalGuardKernel.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <scale>1</scale>
    <sound />
    <states>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
