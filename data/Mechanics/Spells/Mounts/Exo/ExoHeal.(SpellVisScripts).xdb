                                            <timeOff>0.075</timeOff>
                                            <timeOn>0.075</timeOn>
                                            <proceduralEffect href="/Spells/FX/InterfaceFX/LightningExoskeleton02.(ProceduralEffect).xdb#xpointer(/ProceduralEffect)" />
