<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>special</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>3100</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/Cyclop_Clew_End.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<lockScale>true</lockScale>
								<fadeOutTime>300</fadeOutTime>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>4000</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/Cyclop_Clew_EndSpark.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<lockScale>true</lockScale>
								<fadeOutTime>300</fadeOutTime>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
