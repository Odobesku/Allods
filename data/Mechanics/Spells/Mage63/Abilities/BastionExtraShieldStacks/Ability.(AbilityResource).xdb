<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739922295</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>perc</name>
			<value var="value" />
		</Item>
		<Item>
			<name>tar</name>
			<value var="targetsLimit" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Mage/ResistElements.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/Mage63/Abilities/Citadel/Buff.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectInstantiating">
					<effects>
						<Item type="gameMechanics.elements.effects.SpellExtraImpacts">
							<targetImpacts>
								<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
									<radius>15</radius>
									<affectGroup>Enemies</affectGroup>
									<affectHolder>false</affectHolder>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/Mechanics/Spells/CommonBuffs/Disorient/Buff00.(BuffResource).xdb" />
											<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
												<multiplier>1.5</multiplier>
											</durationScaler>
										</Item>
									</impacts>
									<filter type="gameMechanics.world.creature.AliveFilter" />
									<targetsLimit var="targe" />
								</Item>
							</targetImpacts>
							<destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
								<spells>
									<Item href="/Mechanics/Spells/Mage63/Spells/Conflagrate/Spell03.(SpellSingleTarget).xdb" />
								</spells>
							</destination>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
