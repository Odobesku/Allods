<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>196989</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="heal" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>HealScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Itemmall/IMFatalityLotteryPower.(UISingleTexture).xdb" />
    <visualScript type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Spells/Stalker70_AspectTankMaterielHeal.(VisObjectTemplate).xdb" />
                <locator>Slot_FX</locator>
            </Item>
        </visualEffects>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.DodgeTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>40</radius>
                                    <affectGroup>Friends</affectGroup>
                                    <affectHolder>false</affectHolder>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactHeal">
                                                    <heal var="heal" />
                                                    <scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                        <filters>
                                            <Item type="gameMechanics.world.creature.AvatarFilter" />
                                            <Item type="gameMechanics.world.creature.AliveFilter" />
                                        </filters>
                                    </filter>
                                    <targetsLimit>1</targetsLimit>
                                    <sorting type="gameMechanics.elements.targetSelector.sorts.SortByHealthInjury" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>