<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>212948</resourceId>
    </Header>
    <name href="Spike.(ProjectileResource).Name.txt" />
    <visObject href="Spikes.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0.3</altitude>
    <lifeLengthCap>5000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <radius>15</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>COLD</element>
                            <damage>25</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                    </filter>
                </Item>
            </impacts>
            <initialDelay>2000</initialDelay>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>