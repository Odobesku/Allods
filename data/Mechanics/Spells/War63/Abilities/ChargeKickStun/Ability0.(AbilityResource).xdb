<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>216448</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.LongToFloatCalcer">
                            <calcer type="gameMechanics.elements.calcers.LongData">
                                <value var="dmg" />
                            </calcer>
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>HealScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Mounts/SpellsMounts/MountBearMightySlap.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <casterImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                                    <lhs type="gameMechanics.elements.calcers.CalcerDamagePoolBarrier" />
                                    <rhs type="gameMechanics.elements.calcers.LongData">
                                        <value>0</value>
                                    </rhs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactHeal">
                                    <heal>1</heal>
                                    <scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="gameMechanics.elements.calcers.CalcerMin">
                                            <calcers>
                                                <Item type="gameMechanics.elements.calcers.LongToFloatCalcer">
                                                    <calcer type="gameMechanics.elements.calcers.CalcerLongMulFloat">
                                                        <calcerLong type="gameMechanics.elements.calcers.LongData">
                                                            <value var="dmg" />
                                                        </calcerLong>
                                                        <calcerFloat type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                                            <scaler type="gameMechanics.elements.scalers.HealScaler" />
                                                            <value>1</value>
                                                        </calcerFloat>
                                                    </calcer>
                                                </Item>
                                                <Item type="gameMechanics.elements.calcers.LongToFloatCalcer">
                                                    <calcer type="gameMechanics.elements.calcers.CalcerDamagePoolBarrier" />
                                                </Item>
                                            </calcers>
                                        </mulCalcer>
                                    </scalerCaster>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactRetriveDamageFromPoolBarrier">
                                    <damage type="gameMechanics.elements.calcers.CalcerLongMulFloat">
                                        <calcerLong type="gameMechanics.elements.calcers.LongData">
                                            <value var="dmg" />
                                        </calcerLong>
                                        <calcerFloat type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                            <scaler type="gameMechanics.elements.scalers.HealScaler" />
                                            <value>1</value>
                                        </calcerFloat>
                                    </damage>
                                </Item>
                            </impactsIf>
                        </Item>
                    </casterImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                        <spells>
                            <Item href="/Mechanics/Spells/War63/Spells/Kick/Spell01.(SpellSingleTarget).xdb" />
                        </spells>
                    </destination>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/War63/Spells/Charge/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <tick>1000</tick>
                    <affectGroup>Enemies</affectGroup>
                    <radius>3</radius>
                    <filter type="gameMechanics.world.creature.CreatureFilter" />
                    <blinking>true</blinking>
                    <impactsIn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                        </Item>
                    </impactsIn>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>