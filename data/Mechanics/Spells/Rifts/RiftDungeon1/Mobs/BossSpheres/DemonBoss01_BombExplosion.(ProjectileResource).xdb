<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739921854</resourceId>
	</Header>
	<name href="DemonBoss01_BombExplosion.(ProjectileResource).Name.txt" />
	<visObject href="/Spells/FX/Mobs/WormGlacial_CorruptionBomb_Aoe.(VisObjectTemplate).xdb" />
	<altitude>0.4</altitude>
	<lifeLengthCap>2000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
							<phantom href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss01/DemonBoss01.(MobWorld).xdb" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
									<radius>5</radius>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
											<element>ASTRAL</element>
											<damage>1</damage>
											<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
												<scalers>
													<Item type="gameMechanics.elements.scalers.MagicScaler" />
													<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
														<mulCalcer type="constructor.elements.CalcerFloatExternal">
															<externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageBoss.(CalcerFloatResource).xdb" />
														</mulCalcer>
													</Item>
												</scalers>
											</scaler>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
											<time>700</time>
											<impactsOnLand>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
													<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
														<multiplier>2</multiplier>
													</durationScaler>
												</Item>
											</impactsOnLand>
											<distance>6</distance>
										</Item>
									</impacts>
									<filter type="gameMechanics.world.creature.AvatarFilter" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
