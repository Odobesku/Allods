<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>80</delay>
						<effectFx href="/Spells/FX/Mobs/Smeyana_SpearFire_Projectile_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>false</lockScale>
						<scale>1.4</scale>
						<fadeInTime>150</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>knockdownStart</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>knockdownLoop</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Smeyana_SpearFire_Projectile_03.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.4</scale>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>knockdownEnd</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
