<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739886843</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="RootPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<affectGroup>Enemies</affectGroup>
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="/Mechanics/Spells/AstarlIslands/AI26/AI26_TreantCatch/Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateOr">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											</Item>
										</predicates>
									</Item>
								</predicates>
							</filter>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="RootPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Mechanics/Spells/Instances/InstNewTkaRika/Buffs/EventIce/DontMoveCleave.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
								<multiplier>1.2</multiplier>
							</durationScaler>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
							<spell href="/Mechanics/Spells/AstarlIslands/AI26/AI26_TreantCatch/Spell01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
							<factor type="gameMechanics.elements.scalers.LinearScaler">
								<multiplier>2</multiplier>
							</factor>
							<canStartCooldown>true</canStartCooldown>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="/Mechanics/Spells/AstarlIslands/AI26/AI26_TreantNatureShake/Spell01.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
			<stages>
				<Item>Start</Item>
			</stages>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
