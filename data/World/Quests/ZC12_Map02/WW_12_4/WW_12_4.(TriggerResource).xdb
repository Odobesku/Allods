<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>739952289</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
            <impactsOnLeave>
                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                    <assistantResource href="/World/Quests/ZC12_Map02/WW_12_1/WW_12_1_eskort.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="WW_12_4_Escort.(BuffResource).xdb" />
                </Item>
            </impactsOnLeave>
            <timeout>900000</timeout>
            <activeZone href="/Maps/IllusionWorld/Zones/ZC6_IllusionWorld_10.(ZoneResource).xdb" />
            <checkTopLevelZonesOnly>false</checkTopLevelZonesOnly>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                    <quest href="WW_12_4.xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                    <assistantResource href="/World/Quests/ZC12_Map02/WW_12_1/WW_12_1_eskort.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="WW_12_4_Escort.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                            <zone href="/Maps/ZC12_Map02/ScriptZones/WW_12_2_NPC.(ScriptZone).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/World/Quests/ZC12_Map02/WW_12_1/WW_12_1_NPC.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="WW_12_4.xdb" />
            <counterId href="/Creatures/ArchitectRanger/Instances/ZC12_Map02/ZC12_ArchitectQuest_Boss_Plane.(MobWorld).xdb" />
            <condition type="constructor.elements.LongEquals">
                <value>1</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                    <assistantResource href="/World/Quests/ZC12_Map02/WW_12_1/WW_12_1_eskort.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="WW_12_4_Escort.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/World/Quests/ZC12_Map02/WW_12_3/ZC12_Architector_Colossus.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/World/Quests/ZC12_Map02/WW_12_3/WW_12_3_NPC_Final.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                    <quest href="WW_12_4.xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>