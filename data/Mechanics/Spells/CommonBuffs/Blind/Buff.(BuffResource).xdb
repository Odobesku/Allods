<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739923959</resourceId>
	</Header>
	<Name href="Buff.(BuffResource).Name.txt" />
	<Description href="Buff.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Priest/Blind.(UISingleTexture).xdb" />
	<visScript href="/Spells/BuffVisScripts/Blind.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisorient">
			<radius>3</radius>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.EffectDisablePassiveThreat" />
				<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
			</effectsIf>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
			<groups>
				<Item href="/Mechanics/Spells/Groups/FairySpells.xdb" />
				<Item href="/Mechanics/Spells/Groups/MindControlBreakers.xdb" />
			</groups>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
					<value>1</value>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<duration>1000</duration>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
		<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/Blinds.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
