<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>96741</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateFaction">
                            <faction href="/World/Factions/Ferris_Historians.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impactsIf>
                        </Item>
                    </impactsElse>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>120000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/World/Quests/Ferris03/Ferris_3_2_4/Ferris_3_2_4_Plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                    <ability href="TepCultist_Ferris_65_quest_mob.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>