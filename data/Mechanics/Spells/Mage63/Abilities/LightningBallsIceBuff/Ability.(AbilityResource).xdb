        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.(AbilityResource).Name.txt" />
    <description href="Ability.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>perc</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value>13.5</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Priest/PriestPurify.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.OverrideOutgoingSubElement">
            <impactProducer href="/Mechanics/Spells/Mage63/Spells/LightningBalls/Damage01.(BuffResource).xdb" />
            <newElement>ASTRAL</newElement>
        </Item>
        <Item type="gameMechanics.elements.effects.OverrideOutgoingSubElement">
            <impactProducer href="/Mechanics/Spells/Mage63/Spells/LightningBallsUpgrade/Damage01.(BuffResource).xdb" />
            <newElement>ASTRAL</newElement>
        </Item>
        <Item type="gameMechanics.elements.effects.OverrideOutgoingSubElement">
            <impactProducer href="/Mechanics/Spells/Mage63/Spells/LightningBalls/Spell01.(SpellSingleTarget).xdb" />
            <newElement>ASTRAL</newElement>
        </Item>
        <Item type="gameMechanics.elements.effects.OverrideOutgoingSubElement">
            <impactProducer href="/Mechanics/Spells/Mage63/Spells/LightningBallsUpgrade/Spell01.(SpellSingleTarget).xdb" />
            <newElement>ASTRAL</newElement>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
                    <mark href="/Mechanics/Spells/Mage63/Abilities/LightningBallsAstralAoE/Mark.(MarkResource).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value var="value" />
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Buff.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
