<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MeleeAttack.(SpellVisScripts).xdb" />
		<Variables>
			<Trail>/Spells/FX/InterfaceFX/TrailFire.(TrailTemplate).xdb#xpointer(/TrailTemplate)</Trail>
			<FxOnTargets>/Spells/FX/Spells/HitMelee.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTargets>
			<Enchant>/Spells/FX/InterfaceFX/Fire.(EnchantTemplate).xdb#xpointer(/EnchantTemplate)</Enchant>
			<UseAnimation>USE_ANIMATIONS</UseAnimation>
			<Animation>crusaderStrike</Animation>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureAnimationAction">
				<use var="UseAnimation" />
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
