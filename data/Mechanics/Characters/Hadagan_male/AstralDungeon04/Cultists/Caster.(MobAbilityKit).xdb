                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="AcidTorrentTarget.(BuffResource).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>2500</min>
                <max>5000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="AcidTorrent.(SpellArea).xdb" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByDistance" />
                <targetPosModifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                    <verticalRange min="0" max="1.5" />
                    <horizontalRange min="0" max="1.5" />
                    <randomVerticalDirection>false</randomVerticalDirection>
                </targetPosModifier>
                <targetConditionChecks>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        </predicates>
                        <binaryPredicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                                <buff href="AcidTorrentTarget.(BuffResource).xdb" />
                            </Item>
                        </binaryPredicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>666666</min>
                <max>666666</max>
            </cooldowns>
        </Item>
        <Item>
