<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>249264</resourceId>
    </Header>
    <name href="Bomb.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/BombFireHG.(VisObjectTemplate).xdb" />
    <lifeLengthCap>6500</lifeLengthCap>
    <impactsOnDeath>
        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <radius>15</radius>
            <affectGroup>Enemies</affectGroup>
            <affectHolder>false</affectHolder>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>FIRE</element>
                    <damage>35</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
            </impacts>
            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                <filters>
                    <Item type="gameMechanics.world.creature.AliveFilter" />
                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                </filters>
            </filter>
        </Item>
    </impactsOnDeath>
</gameMechanics.world.projectile.ProjectileResource>