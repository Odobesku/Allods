<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>492835</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/IMPowerWeaponBlue.(UISingleTexture).xdb" />
    <slot>HIDDENPOWER</slot>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Necromancer.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Psionic.xdb" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.SummandStat">
                    <stat type="gameMechanics.elements.stat.SpecialStat">
                        <stat href="/Mechanics/SpecialStats/CritChance.(SpecialStatResource).xdb" />
                    </stat>
                    <value>1</value>
                    <scaler type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>20</multiplier>
                    </scaler>
                    <overrideLifeTime>
                        <lifeTime>ShortTerm</lifeTime>
                    </overrideLifeTime>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.EffectsIfCaster">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                    <characterClass href="/Mechanics/Classes/Bard.xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                    <characterClass href="/Mechanics/Classes/Druid.xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                    <characterClass href="/Mechanics/Classes/Warrior.xdb" />
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.SummandStat">
                            <stat type="gameMechanics.elements.stat.SpecialStat">
                                <stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
                            </stat>
                            <value>1</value>
                            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>20</multiplier>
                            </scaler>
                            <overrideLifeTime>
                                <lifeTime>ShortTerm</lifeTime>
                            </overrideLifeTime>
                        </Item>
                    </effectsIf>
                    <effectsElse>
                        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                            <characterClass href="/Mechanics/Classes/Engineer.xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                            <characterClass href="/Mechanics/Classes/Stalker.xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                            <characterClass href="/Mechanics/Classes/Paladin.xdb" />
                                        </Item>
                                    </predicates>
                                </Item>
                            </predicates>
                            <effectsIf>
                                <Item type="gameMechanics.elements.effects.SummandStat">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/ColldownDecreaser.(SpecialStatResource).xdb" />
                                    </stat>
                                    <value>1</value>
                                    <scaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>20</multiplier>
                                    </scaler>
                                    <overrideLifeTime>
                                        <lifeTime>ShortTerm</lifeTime>
                                    </overrideLifeTime>
                                </Item>
                            </effectsIf>
                            <effectsElse>
                                <Item type="gameMechanics.elements.effects.EffectsIfCaster">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                                    <characterClass href="/Mechanics/Classes/Priest.xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                                    <characterClass href="/Mechanics/Classes/Mage.xdb" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </predicates>
                                    <effectsIf>
                                        <Item type="gameMechanics.elements.effects.SummandStat">
                                            <stat type="gameMechanics.elements.stat.SpecialStat">
                                                <stat href="/Mechanics/SpecialStats/DoubleHitChance.(SpecialStatResource).xdb" />
                                            </stat>
                                            <value>1</value>
                                            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier>20</multiplier>
                                            </scaler>
                                            <overrideLifeTime>
                                                <lifeTime>ShortTerm</lifeTime>
                                            </overrideLifeTime>
                                        </Item>
                                    </effectsIf>
                                </Item>
                            </effectsElse>
                        </Item>
                    </effectsElse>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <quality href="/Mechanics/ItemQualities/Rare.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <binding>BindOnPickup</binding>
    <lifeLengthCap>15552000000</lifeLengthCap>
    <onExpire type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
        <item href="TemporaryPower_Inactive.(ItemResource).xdb" />
    </onExpire>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="TemporaryPower.(ItemResource).Name.txt" />
    <category href="/Mechanics/ItemCategories/LifeStyle/LSBack.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>