<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>188291</resourceId>
    </Header>
    <Name href="PierceArmor.(SpellSingleTarget).Name.txt" />
    <visualScripts href="PierceArmor.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <prepareDuration>250</prepareDuration>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>20000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                        <spell href="PierceArmor.(SpellSingleTarget).xdb" />
                        <duration>
                            <second>20</second>
                        </duration>
                    </Item>
                </impacts>
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="Raider.(MobWorld).xdb" />
                            </mobs>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                    </predicates>
                </filter>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <impactsOnHitTarget>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="PiercedArmorDebuff.(BuffResource).xdb" />
                    </Item>
                </impactsOnHitTarget>
                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                <minDamage>25</minDamage>
                <maxDamage>25</maxDamage>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>