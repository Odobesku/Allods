    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>0</fadeOutMS>
    <geometry href="/Spells/FX/Spells/HitMeleeHard.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <scale>1</scale>
    <sound />
    <states>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
