                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="/Maps/ZC12_RiftInstance2/SpawnTables/ZC12_RI2_Defence_Enemies1.(SpawnTable).xdb" />
                </Item>
