<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739879353</resourceId>
	</Header>
	<name href="NairaAbility.(AbilityResource).Name.txt" />
	<nameTemplate href="NairaAbility.(AbilityResource).NameTemplate.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
					<ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="NairaBallsPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="NairaCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="Evade.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
								<Item href="PoisonedShot.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
								<Item href="NairaMultishot.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
								<Item href="NairaSpamshot.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
