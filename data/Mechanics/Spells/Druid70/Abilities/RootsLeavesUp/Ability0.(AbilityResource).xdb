<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739923244</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability0.(AbilityResource).Name.txt" />
	<description href="Ability0.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="scaler_damage" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Misc/Crafting/Aloe.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.SpellsModifier">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
					<spells>
						<Item href="/Mechanics/Spells/Druid70/Spells/SharpLeaves/Spell01.(SpellArea).xdb" />
					</spells>
				</Item>
			</predicates>
			<modifiers>
				<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
					<effects>
						<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
							<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
								<coeff var="scaler_damage" />
							</scaler>
						</Item>
					</effects>
					<onBehalfOfHolder>true</onBehalfOfHolder>
				</Item>
			</modifiers>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCostModifier">
			<spell href="/Mechanics/Spells/Druid70/Spells/SpikedRoots/Spell03.(SpellArea).xdb" />
			<factor var="mana" />
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCostModifier">
			<spell href="/Mechanics/Spells/Druid70/Spells/SharpLeaves/Spell03.(SpellArea).xdb" />
			<factor var="mana" />
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
