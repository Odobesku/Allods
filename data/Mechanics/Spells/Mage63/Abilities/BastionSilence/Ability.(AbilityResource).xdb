<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>207860</resourceId>
    </Header>
    <name href="Ability.(AbilityResource).Name.txt" />
    <description href="Ability.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageInvisibility.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Mage63/Abilities/Citadel/Buff.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <casterPreImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>10</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/SilenceDisarm/SilenceDisarm.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>2</multiplier>
                                    </durationScaler>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="Visual.(ClientData).xdb" />
                        </Item>
                    </casterPreImpacts>
                    <casterImpacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/Spells/Mage63/Abilities/Citadel/Buff.(BuffResource).xdb" />
                        </Item>
                    </casterImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                        <spells>
                            <Item href="/Mechanics/Spells/Mage63/Spells/Invisiblity/Spell03.(SpellSingleTarget).xdb" />
                        </spells>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.effects.HealthTrigger">
                    <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                        <multiplier>0.3</multiplier>
                    </healthOn>
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="CD.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="CD.(BuffResource).xdb" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>