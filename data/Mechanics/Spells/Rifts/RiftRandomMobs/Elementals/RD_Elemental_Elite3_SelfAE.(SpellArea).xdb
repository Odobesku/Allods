<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>208776</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/ElementalSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftEliteSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="RD_Elemental_Elite3_SelfAE.(SpellArea).Name.txt" />
    <visualScripts href="RD_Elemental_Elite3_SelfAE.(SpellVisScripts).xdb" />
    <prepareDuration>4500</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>16000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                <spell href="RD_Elemental_Elite3_PersuitProjectile.(SpellSingleTarget).xdb" />
                <duration>3000</duration>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/Rifts/Abilities/StopBuff.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>COLD</element>
                <damage>1</damage>
                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                        <Item type="gameMechanics.elements.scalers.ScalerIf">
                            <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                <quality href="/Mechanics/MobQualities/Elite.xdb" />
                            </condition>
                            <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
                                </mulCalcer>
                            </scalerIf>
                            <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                    <quality href="/Mechanics/MobQualities/Boss.xdb" />
                                </condition>
                                <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageElite.(CalcerFloatResource).xdb" />
                                    </mulCalcer>
                                </scalerIf>
                                <scalerElse type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageBoss.(CalcerFloatResource).xdb" />
                                    </mulCalcer>
                                </scalerElse>
                            </scalerElse>
                        </Item>
                    </scalers>
                </scaler>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
            </Item>
        </targetImpacts>
    </mechanics>
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>