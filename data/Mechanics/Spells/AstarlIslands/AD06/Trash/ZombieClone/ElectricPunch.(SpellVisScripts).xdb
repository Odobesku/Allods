<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MeleeAttack.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FxOnTargets>/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTargets>
			<FxOnCaster />
			<LocatorOnCaster>Slot_Glove_R</LocatorOnCaster>
			<UseAnimation>USE_CURRENT_BASE_ATTACK</UseAnimation>
			<Animation>attackUnarmed01</Animation>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx hrefvar="FxOnCaster" />
								<locator var="LocatorOnCaster" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
