<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>readySpellDirected</PreCastAnimation>
			<LocatorOnCaster>Slot_Hand_L</LocatorOnCaster>
			<FxOnHands>/Spells/FX/Spells/PocketSpellLightning01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<FXOnCaster>/Spells/FX/Spells/Engineer_DroneProjectile_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<CastAnimation>spellCastDirected</CastAnimation>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectFx hrefvar="FxOnHands" />
						<effectAlias href="" />
						<effectAnimations>
							<mode>DIE</mode>
							<animations />
						</effectAnimations>
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<scale>1</scale>
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>333</fadeOutTime>
						<locator>Slot_Hand_L</locator>
						<member>Default_Member</member>
						<locatorName />
						<offendTime />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
					<Item>
						<fadeOutTime>333</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<scale>1.5</scale>
								<locator var="LocatorOnCaster" />
							</Item>
							<Item>
								<effectFx hrefvar="FXOnCaster" />
								<effectAlias href="" />
								<scale>1.5</scale>
								<locator var="LocatorOnCaster" />
								<offendTime type="EffectOffendConstDelay" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
