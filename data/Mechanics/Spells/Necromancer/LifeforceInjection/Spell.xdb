                        <Item type="gameMechanics.elements.scalers.AbilityRankScaler">
                            <ability href="/Mechanics/Abilities/NecromancerTalents/BloodCirculation/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                            <mul>0.04</mul>
                        </Item>
                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mul>0.25</mul>
                            <mulCalcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                <buff href="/Mechanics/Abilities/NecromancerTalents/DeferredHeal/ChainHealing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <forAllRanks>true</forAllRanks>
                            </mulCalcer>
                            <sum>1</sum>
                        </Item>
                    </scalers>
                </scalerCaster>
