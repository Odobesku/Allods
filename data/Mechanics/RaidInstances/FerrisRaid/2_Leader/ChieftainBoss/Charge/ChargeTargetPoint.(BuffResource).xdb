<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739890683</resourceId>
	</Header>
	<Name href="ChargeTargetPoint.(BuffResource).Name.txt" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>2000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectForceMove">
					<destinations>
						<Item type="gameMechanics.map.destination.RelativeRotatePos">
							<base type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
							<offset>2</offset>
							<yaw type="constructor.basicElements.AngleDegrees" />
						</Item>
					</destinations>
					<impactsOnArrived>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ChargeTargetPoint.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>500</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="ChargeDamageAura.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>10</radius>
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
									<impactsOnHitTarget>
										<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
											<time>800</time>
											<distance>10</distance>
										</Item>
									</impactsOnHitTarget>
									<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
									<minDamage>30</minDamage>
									<maxDamage>30</maxDamage>
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterOr">
								<filters>
									<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
												<mobs>
													<Item href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChampionMelee/ChampionMelee.(MobWorld).xdb" />
													<Item href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChampionRange/ChampionRange.(MobWorld).xdb" />
													<Item href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChampionShaman/ChampionShaman.(MobWorld).xdb" />
												</mobs>
											</Item>
										</predicates>
									</Item>
									<Item type="gameMechanics.constructor.basicElements.FilterAnd">
										<filters>
											<Item type="gameMechanics.world.creature.AvatarFilter" />
											<Item type="gameMechanics.constructor.basicElements.FilterNot">
												<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
													<predicates>
														<Item type="gameMechanics.elements.resources.ResourceBuff">
															<buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Horn/Horn_User.(BuffResource).xdb" />
														</Item>
													</predicates>
												</filter>
											</Item>
										</filters>
									</Item>
								</filters>
							</filter>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
							<pool href="TargetDecales.(SummonPool).xdb" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="ChargeHitFX.(ClientData).xdb" />
						</Item>
					</impactsOnArrived>
				</Item>
				<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
					<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
						<coeff>1.6</coeff>
					</effectScaler>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectNoAggro" />
	</effects>
	<duration>12000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
