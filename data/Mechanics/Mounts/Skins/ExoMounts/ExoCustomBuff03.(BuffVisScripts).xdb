						<playWhile type="PredicateCreatureVisCharacterAction">
							<visCharList>
								<Item href="/Characters/Elf_female/ElfFemale.(VisCharacterTemplate).xdb" />
							</visCharList>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="CreatureScaleAction">
								<scale var="Scale_ElfFemale" />
							</Item>
						</elements>
					</Item>
