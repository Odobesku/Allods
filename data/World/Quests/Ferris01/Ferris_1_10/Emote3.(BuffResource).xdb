				<Item href="QuestionOfDanger.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
