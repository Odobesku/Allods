<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>188259</resourceId>
    </Header>
    <Name href="CleansingFire.(SpellSingleTarget).Name.txt" />
    <visualScripts href="CleansingFire.(SpellVisScripts).xdb" />
    <prepareDuration>1000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="CleansingFire.(BuffResource).xdb" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>3</multiplier>
                </durationScaler>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="FireRay.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                        <spell href="FireRayBoss.(SpellSingleTarget).xdb" />
                        <duration>
                            <second>3</second>
                        </duration>
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                        <buff href="CleansingFire.(BuffResource).xdb" />
                        <range>
                            <min>1</min>
                            <max>1</max>
                        </range>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.StackBuff">
                        <buff href="CleansingFire.(BuffResource).xdb" />
                        <delta type="gameMechanics.elements.calcers.FloatData">
                            <value>-1</value>
                        </delta>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.StackBuff">
                        <buff href="CleansingFire.(BuffResource).xdb" />
                        <delta type="gameMechanics.elements.calcers.FloatData">
                            <value>-1</value>
                        </delta>
                    </Item>
                </impactsElse>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>5</radius>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>FIRE</element>
                        <damage>100</damage>
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/AstarlIslands/AI71/Flamethrower/FireDOT.(BuffResource).xdb" />
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impacts>
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="CleansingFireMeleeAura.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                </filter>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>