<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<FXHands>/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb</FXHands>
			<CastAnimation>instantSpellCastOmniWand</CastAnimation>
			<FXWand>/Spells/FX/Spells/ReadySpellDirectHolyWand_Cast.(VisObjectTemplate).xdb</FXWand>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FXHands" />
						<effectAlias href="" />
						<locator>Slot_Hand_L</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="CastAnimation" />
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ABILITY</channelAfterFirstKey>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FXWand" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<locator>Wand_Slot_FX</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
