<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ReadySpell_Nihil_Damage_Lighting.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2</scale>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<advanced>
					<channelAfterFirstKey>CHANNEL_KNOCKDOWN</channelAfterFirstKey>
					<offendType>EVERYKEY_OFFEND</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Spells/AstralTurret_Projectile_NoRing.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.8</scale>
						<locator>Slot_Global</locator>
						<offset y="-4.5" z="1.75" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visActionID>0</visActionID>
				<visualEffects>
					<Item>
						<delay>400</delay>
						<effectFx href="/Spells/FX/Mobs/Danas_StrikeHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.5</scale>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
