            <Item>
                <lootTable type="gameMechanics.constructor.schemes.item.LootTableSingleItem">
                    <itemProvider type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                        <item hrefvar="PartAstral" />
                    </itemProvider>
