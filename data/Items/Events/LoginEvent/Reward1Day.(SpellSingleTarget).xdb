<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739873772</resourceId>
    </Header>
    <Name href="Reward1Day.(SpellSingleTarget).Name.txt" />
    <Description href="Reward1Day.(SpellSingleTarget).Description.txt" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                        <minLevel type="gameMechanics.formulas.IntConstantValue">
                            <value>52</value>
                        </minLevel>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceItem">
                                    <item href="/ItemMall/Services/InfiniteTeardrop/TeardropUncommon.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateItemEquipped">
                                    <resource href="/ItemMall/Services/InfiniteTeardrop/TeardropUncommon.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                </Item>
                            </predicates>
                        </predicate>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.RandomImpact">
                        <entries>
                            <Item>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactDropLoot">
                                        <lootTable href="Reward1Day_Myrrh.(LootTableResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.LootTableResource)" />
                                    </Item>
                                </impacts>
                            </Item>
                            <Item>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactDropLoot">
                                        <lootTable href="Reward1Day_Ammo.(LootTableResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.LootTableResource)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </entries>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactDropLoot">
                        <lootTable href="Reward1Day_Myrrh.(LootTableResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.LootTableResource)" />
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>