<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739885594</resourceId>
    </Header>
    <Name href="IsHM.(BuffResource).Name.txt" />
    <Description href="IsHM.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/IMFatalityLotteryDomination.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/Raids_NoHM.(ActionGroup).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.75</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectIncreaseHealth">
            <bonusHealthPercent>1</bonusHealthPercent>
            <increaseHealth>false</increaseHealth>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                    <ability href="/Mechanics/Abilities/Bosses/RaidKillsLogger.xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactHealAll" />
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.world.mob.KillsLoggerResource">
            <loggerType>HardRaidBoss</loggerType>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>1</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="IsHM.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.AttachAbility">
                                    <ability href="/Mechanics/Abilities/Bosses/RaidKillsLogger.xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="FerrisRaid/13_Portal/Boss/PortalBoss.(MobWorld).xdb" />
                            <Item href="FerrisRaid/11_Clone_Elf/ElfOnTank/ElfOnTank.(MobWorld).xdb" />
                        </mobs>
                    </predicate>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.Enlarge">
                    <factor>1.1</factor>
                </Item>
            </effectsIf>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>