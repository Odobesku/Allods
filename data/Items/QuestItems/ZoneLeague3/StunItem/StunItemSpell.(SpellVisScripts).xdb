<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>ready1H</Item>
		</animations>
		<channel>CHANNEL_HITCRITICAL</channel>
	</actionBarStart>
	<wholeCasting type="CreatureChangeVisItemsAction">
		<items>
			<Item>
				<slot>MAINHAND</slot>
				<newItem href="/Items/VisualItems/Weapon/1HDagger/Dagger_1H_D_10KaniaSteel.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
			</Item>
		</items>
	</wholeCasting>
	<actionBarComplite type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="CreatureAnimationAction">
			<animations>
				<Item>specialAttack1H</Item>
			</animations>
			<channel>CHANNEL_HITCRITICAL</channel>
		</playWhile>
		<elements>
			<Item type="CreatureChangeVisItemsAction">
				<items>
					<Item>
						<slot>MAINHAND</slot>
						<newItem href="/Items/VisualItems/Weapon/1HDagger/Dagger_1H_D_10KaniaSteel.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
					</Item>
				</items>
			</Item>
		</elements>
	</actionBarComplite>
	<playOnTargets>
		<specialAction type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/HitMeleeHard.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<locator>Slot_FX</locator>
				</Item>
			</visualEffects>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
