<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222350</resourceId>
    </Header>
    <image href="/Interface/Icons/Spells/Necromancer/PetModePassive.(UISingleTexture).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>3000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactStopTalk" />
                    </impactsOn>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="Rysina.(MobWorld).xdb" />
                            </mobs>
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                                    <table href="RaysSM.(SpawnTable).xdb" />
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="RysinaCasts.(BuffResource).xdb" />
                                </Item>
                            </impactsOn>
                        </Item>
                        <Item type="gameMechanics.elements.effects.EffectsDeferred">
                            <delay>3000</delay>
                            <effects>
                                <Item type="gameMechanics.elements.effects.Switch">
                                    <impactsOn>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                            <spawn>
                                                <scriptID>13_PortalBoss</scriptID>
                                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                            </spawn>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Boss/BossActivating.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsOn>
                                </Item>
                            </effects>
                        </Item>
                    </effectsIf>
                    <effectsElse>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="DiArderCasts.(BuffResource).xdb" />
                                </Item>
                            </impactsOn>
                        </Item>
                    </effectsElse>
                </Item>
            </effects>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>