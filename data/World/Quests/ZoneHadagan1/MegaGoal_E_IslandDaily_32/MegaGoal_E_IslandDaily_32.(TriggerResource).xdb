<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
	<Header>
		<resourceId>739903576</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.KillTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInZone">
							<zone href="/Maps/ElementalPlateu/Zones/ElementalPlateu/ElementalPlateu.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="EP_Kills_E.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateInZone">
									<zone href="/Maps/Domination/Zones/Domination/Domination.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateInZone">
									<zone href="/Maps/Domination02/Zones/Domination02/Domination02.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateInZone">
									<zone href="/Maps/Domination03/Zones/Domination03/Domination03.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateInZone">
									<zone href="/Maps/MM_Pvp_Arena/Zones/MM_Pvp_Arena/MM_Pvp_Arena.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateInZone">
									<zone href="/Maps/Domination04/Zones/Domination04/Domination.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
								</Item>
							</predicates>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="MM_Kills_E.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
						</Item>
					</impactsIf>
				</Item>
			</impacts>
			<affects>Avatars</affects>
		</Item>
		<Item type="gameMechanics.elements.effects.QuestCounterTrigger">
			<quest href="MegaGoal_E_IslandDaily_32.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
			<counterId href="MM_Kills_E.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
			<condition type="constructor.elements.LongGreaterOrEquals">
				<value>15</value>
			</condition>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
					<quest href="MegaGoal_E_IslandDaily_32.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
					<counterResource href="CountId_1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
					<quest href="MegaGoal_E_IslandDaily_32.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
					<counterResource href="EP_Kills_E.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.QuestCounterTrigger">
			<quest href="MegaGoal_E_IslandDaily_32.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
			<counterId href="EP_Kills_E.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
			<condition type="constructor.elements.LongGreaterOrEquals">
				<value>5</value>
			</condition>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
					<quest href="MegaGoal_E_IslandDaily_32.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
					<counterResource href="CountId_1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
					<quest href="MegaGoal_E_IslandDaily_32.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
					<counterResource href="MM_Kills_E.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
