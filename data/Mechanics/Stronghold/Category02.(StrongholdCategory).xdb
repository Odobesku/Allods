        <Prototype
                href="CategoryPrototype.(StrongholdCategory).xdb#xpointer(/gameMechanics.world.stronghold.StrongholdCategory)"/>
    </Header>
    <name href="Category02.(StrongholdCategory).Name.txt"/>
    <initialRuneLevel>0</initialRuneLevel>
    <maxRuneLevel type="gameMechanics.elements.calcers.CalcerIf">
        <predicate type="gameMechanics.elements.predicates.PredicateGreater">
            <rhs type="gameMechanics.elements.calcers.FloatData">
                <value>4</value>
            </rhs>
            <lhs type="gameMechanics.elements.calcers.LongToFloatCalcer">
                <calcer type="itemService.serverVariables.CalcerServerVariable">
                    <variableResource
                            href="/Mechanics/ServerUnlock/ServerUnlock.(ServerVariableResource).xdb#xpointer(/itemService.basicInterfaces.ServerVariableResource)"/>
                </calcer>
            </lhs>
        </predicate>
        <calcerIf type="gameMechanics.elements.calcers.FloatData">
            <value>21</value>
        </calcerIf>
        <calcerElse type="gameMechanics.elements.calcers.TableFunctionCalcer">
            <source type="gameMechanics.elements.calcers.LongToFloatCalcer">
                <calcer type="itemService.serverVariables.CalcerServerVariable">
                    <variableResource
                            href="/Mechanics/ServerUnlock/ServerUnlock.(ServerVariableResource).xdb#xpointer(/itemService.basicInterfaces.ServerVariableResource)"/>
                </calcer>
            </source>
            <mapping>
                <Item>
                    <x>0</x>
                    <y>8</y>
                </Item>
                <Item>
                    <x>1</x>
                    <y>8</y>
                </Item>
                <Item>
                    <x>2</x>
                    <y>12</y>
                </Item>
                <Item>
                    <x>3</x>
                    <y>16</y>
                </Item>
                <Item>
                    <x>4</x>
                    <y>21</y>
                </Item>
            </mapping>
        </calcerElse>
    </maxRuneLevel>
    <productionEfficiency>1.1</productionEfficiency>
    <weight>0.3</weight>
</gameMechanics.world.stronghold.StrongholdCategory>
