<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>192510</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                    <spawnResource href="/Maps/AstralIsle68/SpawnTables/BossSpirit.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="/Mechanics/Spells/AstarlIslands/AI68/AI68_Zone/FinalBoss_killed.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <summand>1</summand>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>totem</scriptID>
                        <map href="/Maps/AstralIsle68/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                            <visualState>5</visualState>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>5000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>3000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                                    <zone href="/Maps/AstralIsle68/Zones/AstralIsle68/AstralIsle68.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/AstarlIslands/AI68/AI68_Zone/VictorySky.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/Spells/AstarlIslands/AI68/AI68_Zone/AI68_crater_sound.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>Spirit</scriptID>
                        <map href="/Maps/AstralIsle68/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                            <visualState>3</visualState>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>