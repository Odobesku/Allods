<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>228029</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.GroupAura">
            <affectSelf>true</affectSelf>
            <radius>50</radius>
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
            </predicates>
            <onBehalfOfHolder>true</onBehalfOfHolder>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="GroupBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.StackBuff">
                    <buff href="GroupBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <resetTimer>false</resetTimer>
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>-1</value>
                    </delta>
                </Item>
            </impactsOut>
            <raid>true</raid>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>