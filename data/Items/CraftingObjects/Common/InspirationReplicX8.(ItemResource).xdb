<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>501422</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/IMReplicator01.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <itemMallDescription href="InspirationReplicX8.(ItemResource).ItemMallDescription.txt" />
    <source>FixedDrop</source>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.elements.components.ItemTakeActionImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="InspirationReplicX8.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.StackBuff">
                                        <buff href="InspirationReplicX8.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <delta type="gameMechanics.elements.calcers.FloatData">
                                            <value>10</value>
                                        </delta>
                                    </Item>
                                </impacts>
                                <elseImpacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="InspirationReplicX8.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <stacks type="gameMechanics.elements.calcers.FloatData">
                                            <value>10</value>
                                        </stacks>
                                    </Item>
                                </elseImpacts>
                            </Item>
                        </impacts>
                    </Item>
                </actions>
                <consumeItems>1</consumeItems>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <hideText>true</hideText>
                <predicate type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                    <buff href="InspirationReplicX8.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <range>
                        <max>90</max>
                    </range>
                </predicate>
                <clientData href="InspirationReplicWarning.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasSkill">
                        <skill href="/Mechanics/Skills/BlacksmithV2/Blacksmith.(DiceCraftSkillResource).xdb#xpointer(/gameMechanics.elements.skills.diceCraft.DiceCraftSkillResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateHasSkill">
                        <skill href="/Mechanics/Skills/LeatheringV2/Leathering.(DiceCraftSkillResource).xdb#xpointer(/gameMechanics.elements.skills.diceCraft.DiceCraftSkillResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateHasSkill">
                        <skill href="/Mechanics/Skills/TailoringV2/Tailoring.(DiceCraftSkillResource).xdb#xpointer(/gameMechanics.elements.skills.diceCraft.DiceCraftSkillResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateHasSkill">
                        <skill href="/Mechanics/Skills/WeaponsmithV2/Weaponsmith.(DiceCraftSkillResource).xdb#xpointer(/gameMechanics.elements.skills.diceCraft.DiceCraftSkillResource)" />
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="InspirationReplic.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </predicate>
                </predicate>
                <clientData href="InspirationReplicWarning2.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
        </predicates>
    </functionalPart>
    <stackLimit>100</stackLimit>
    <quality href="/Mechanics/ItemQualities/Rare.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
    </prices>
    <lifeLengthCap>2592000000</lifeLengthCap>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="InspirationReplicX8.(ItemResource).Name.txt" />
    <description href="InspirationReplicX8.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/ItemMall.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
</gameMechanics.constructor.schemes.item.ItemResource>