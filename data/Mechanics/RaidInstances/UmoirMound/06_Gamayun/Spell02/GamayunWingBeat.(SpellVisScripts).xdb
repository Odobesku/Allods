<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FixPointCaster>false</FixPointCaster>
			<FixPointTarget>true</FixPointTarget>
			<LocatorNameOnCaster />
			<LocatorNameOnTargets />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<FxOnHands />
			<HitPostFXOnTargets />
			<FXOnCaster />
			<CastAnimation>spellCastOmni</CastAnimation>
			<FXOnTargets />
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/BossAvatar_Explosion.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<lockScale>true</lockScale>
						<scale>1.4</scale>
						<fadeInTime>333</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<offendTime />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/DemonCrabBoss_HeadFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<lockScale>true</lockScale>
						<scale>2</scale>
						<fadeInTime>333</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<offendTime />
					</Item>
				</visualEffects>
				<stopOnDeath>false</stopOnDeath>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
