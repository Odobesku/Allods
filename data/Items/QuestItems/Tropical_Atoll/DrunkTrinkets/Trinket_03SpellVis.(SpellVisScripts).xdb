<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<RightHandItem>/Spells/FX/Spells/SE_GlassDrinkOrange.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</RightHandItem>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureHoldWeaponAction">
				<hold>WEAPON_NONE</hold>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
