<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222710</resourceId>
    </Header>
    <Name href="JumpTarget.(BuffResource).Name.txt" />
    <Description href="JumpTarget.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Ships/VisorAbilitiesAnalysisPurposes.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                    <spawn>
                        <scriptID>6_TigerRat</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.StackBuff">
                            <buff href="JumpResource.(BuffResource).xdb" />
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>-1</value>
                            </delta>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="JumpTarget.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.RepeatedImpactsGeneric">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/6_TigerRat/Heed/HeedStrength.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <count type="gameMechanics.elements.calcers.FloatToLongCalcer">
                        <calcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/6_TigerRat/Heed/AvatarSpellCastCount.(BuffResource).xdb" />
                        </calcer>
                    </count>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="JumpTargetVisual.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>30000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
