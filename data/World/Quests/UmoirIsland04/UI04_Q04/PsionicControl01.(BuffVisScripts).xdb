<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirected</Item>
				</animations>
				<channel>CHANNEL_IDLE</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PsionicSuffocateAbilityHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
