<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
				<advanced>
					<offendType>EVERYKEY_OFFEND</offendType>
				</advanced>
			</Item>
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="DelayComponent">
						<timeMin>0.9</timeMin>
						<timeMax>0.9</timeMax>
						<component type="AttachedVisObjectComponent">
							<visObject href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<offset x="0" y="0" z="-1" />
							<locatorName>Slot_Hand_R</locatorName>
						</component>
					</Item>
				</visObjComponents>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
