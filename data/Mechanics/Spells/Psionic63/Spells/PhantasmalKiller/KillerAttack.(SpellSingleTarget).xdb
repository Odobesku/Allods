<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739924344</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="KillerAttack.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Psionic/KillerAttack.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>2500</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>PHYSICAL</element>
                        <damage>1</damage>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer hrefvar="externalCalcer" />
                                    </mulCalcer>
                                </Item>
                            </scalers>
                        </scaler>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsIf">
                <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                        <buff href="Victim.(BuffResource).xdb" />
                        <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                    </predicate>
                </predicate>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Victim.(BuffResource).xdb" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer href="CalcerDuration.(CalcerFloatResource).xdb" />
                            </mulCalcer>
                        </durationScaler>
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>