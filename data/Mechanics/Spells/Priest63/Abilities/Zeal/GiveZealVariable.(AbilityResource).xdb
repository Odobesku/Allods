    <name href="GiveZealVariable.(AbilityResource).Name.txt" />
    <description href="GiveZealVariable.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestZeal.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectVariable">
            <resource href="Zeal.(VariableResource).xdb" />
            <impactsOnChange>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
