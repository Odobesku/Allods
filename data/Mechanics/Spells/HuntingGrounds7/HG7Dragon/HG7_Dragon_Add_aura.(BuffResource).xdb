<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739900231</resourceId>
	</Header>
	<Name href="HG7_Dragon_Add_aura.(BuffResource).Name.txt" />
	<Description href="HG7_Dragon_Add_aura.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Mage/MageLightningBallsUpgrade.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visScript href="HG7_Dragon_SphereDecalAura.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.PureDamage">
					<damage>1</damage>
					<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
							<multiplier>0.025</multiplier>
						</mulCalcer>
					</scalerTarget>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
			<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.5</coeff>
			</effectScaler>
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>11</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>LIGHTNING</element>
									<damage>20</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
									<data href="HG7_Dragon_Add_aura.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>700</tick>
		</Item>
	</effects>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
