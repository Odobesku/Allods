<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureChangeVisItemsAction">
				<items>
					<Item>
						<newItem href="/Items/VisualItems/Shirt/Cloth_A_68ScientistShirt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						<slot>SHIRT</slot>
					</Item>
					<Item>
						<newItem href="/Items/VisualItems/Belt/Leather_B_01BrownBelt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						<slot>BELT</slot>
					</Item>
				</items>
				<isGfxCondition>false</isGfxCondition>
				<leaveWeapons>true</leaveWeapons>
				<notForDolls>false</notForDolls>
				<removeAllItems>true</removeAllItems>
			</Item>
		</elements>
		<play>InSequence</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>