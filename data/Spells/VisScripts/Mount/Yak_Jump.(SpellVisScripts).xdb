<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2000</time>
		</playWhile>
		<elements>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>special01</play>
							<forAnimations>
								<Item>jumpStart</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>special02</play>
							<forAnimations>
								<Item>jump</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>special03</play>
							<forAnimations>
								<Item>jumpEnd</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>special04</play>
							<forAnimations>
								<Item>jumpLandRun</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
					<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>special01</play>
							<forAnimations>
								<Item>jumpStart</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>special02</play>
							<forAnimations>
								<Item>jump</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>special03</play>
							<forAnimations>
								<Item>jumpEnd</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>special04</play>
							<forAnimations>
								<Item>jumpLandRun</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
				<member>Mount</member>
				<restartOnVisualChange>false</restartOnVisualChange>
			</Item>
			<Item type="CreatureSetFlagAction">
				<flagName>Flag_MountNeeded</flagName>
				<timeOut>0.5</timeOut>
			</Item>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Flag_Emote</flagName>
				</playWhile>
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
