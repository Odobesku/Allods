                    <table href="/Maps/UmoirIsland04/SpawnTables/Shurik.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                    <table href="/Maps/UmoirIsland04/SpawnTables/UI04_Q03_TM_TowerMages.(SpawnTable).xdb" />
