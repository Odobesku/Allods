<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>226180</resourceId>
    </Header>
    <Name href="Buff02.(BuffResource).Name.txt" />
    <Description href="Buff02.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/FireElementalHeart.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="GoblinTrioBoss_Damage.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                    <mobs>
                        <Item href="/Mechanics/RaidInstances/UmoirRaid/4_GoblinTrioBoss/Goblin02Boss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    </mobs>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.constructor.basicElements.EffectNull" />
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>0.35</coeff>
                    </scaler>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <duration>3000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>