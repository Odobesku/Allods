<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityIce_Precast.(VisObjectTemplate).xdb" />
						<scale>2</scale>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityIce_Precast01.(VisObjectTemplate).xdb" />
						<scale>2</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_AOE_FatalityIce.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<scale>2</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
