<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>CheckBox</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Pos>4</Pos>
            <Size>26</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Size>24</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>250</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>check_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_DEFAULT</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag></TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/Contextructor/CheckBoxes/CheckBoxStoneHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            <PushedOffset x="0" y="0"/>
            <Reaction>check</Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled>
                <LayerMain href="/Interface/Ingame/Contextructor/CheckBoxes/CheckBoxStoneDisabled.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateDisabled>
            <StateHighlighted/>
            <StateNormal>
                <LayerMain href="/Interface/Ingame/Contextructor/CheckBoxes/CheckBoxStone.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <reactionDblClick></reactionDblClick>
            <soundPress href="/Interface/Ingame/Contextructor/CheckBoxes/SoundPressed.(UIWidgetSound).xdb#xpointer(/client.UIState.UIWidgetSound)"/>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
