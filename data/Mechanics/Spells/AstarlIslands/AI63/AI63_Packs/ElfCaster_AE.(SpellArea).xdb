<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>187599</resourceId>
    </Header>
    <Name href="ElfCaster_AE.(SpellArea).Name.txt" />
    <visualScripts href="ElfCaster_AE.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>SHADOW</element>
                <damage>40</damage>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="VampireFem_SleepStacks.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <consumeStacks>3</consumeStacks>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="ElfCaster_AE_DoT.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <radius>40</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>