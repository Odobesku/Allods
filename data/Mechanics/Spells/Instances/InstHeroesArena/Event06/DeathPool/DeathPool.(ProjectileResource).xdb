<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>241167404</resourceId>
    </Header>
    <visObject href="/Spells/FX/Mobs/Mantis_DeathPool_Cloud.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0.1</altitude>
    <lifeLengthCap>25000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <affectGroup>All</affectGroup>
            <radius>8</radius>
            <filter type="gameMechanics.world.creature.CreatureFilter" />
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="/Creatures/MantisWarrior/Instances/Inst_HeroesArena/MantisAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="/Creatures/MantisWarrior/Instances/Inst_HeroesArena/MantisAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <anyRank>false</anyRank>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <affectGroup>All</affectGroup>
            <radius>8</radius>
            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                <filters>
                    <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="PoisionCloud.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                </filters>
            </filter>
            <predicates>
                <Item type="gameMechanics.map.variables.PredicateMapVariableGreater">
                    <variableResource href="/Maps/Inst_HeroesArena/ScriptZones/WaveNumberNew.xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <minValue type="gameMechanics.elements.calcers.FloatData">
                        <value>12.5</value>
                    </minValue>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                        <rule href="/Mechanics/Spells/Instances/InstHeroesArena/DeactivateNewSpells.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                    </predicate>
                </Item>
            </predicates>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="CloudPoisionAttacher.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="CloudPoisionAttacher.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>8</radius>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="PoisionCloud.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                        <filters>
                            <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="PoisionCloud.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.world.creature.AvatarFilter" />
                        </filters>
                    </filter>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>