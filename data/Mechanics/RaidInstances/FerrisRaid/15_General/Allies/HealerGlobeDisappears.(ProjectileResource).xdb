                                                <Item href="HealerGlobe.(ProjectileResource).xdb" />
                                                <Item href="HealerGlobeActive.(ProjectileResource).xdb" />
                                            </resources>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>