    <lifeLengthCap>0</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.UltimateVisibility" />
        <Item type="gameMechanics.elements.effects.EntityWaitNoneOrSomeAround">
            <radius>70</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsOnNone>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
                    <delay>30000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>QuestDemonicPortal</scriptID>
