<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739940617</resourceId>
    </Header>
    <parts />
    <persistentParts />
    <name href="RD_SingleProjectile_Fire2.(ProjectileResource).Name.txt" />
    <visObject href="/Mechanics/Characters/Undead_male/AstralIsle50/HitFireball_small.(VisObjectTemplate).xdb" />
    <lifeLengthCap>5000</lifeLengthCap>
    <impactsOnDeath />
    <impactsOnHit />
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>3</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>FIRE</element>
                            <damage>1</damage>
                            <impactsOnHitTarget />
                            <impactsOnHitCaster />
                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                    <Item type="gameMechanics.elements.scalers.ScalerIf">
                                        <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                            <quality href="/Mechanics/MobQualities/Elite.xdb" />
                                        </condition>
                                        <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageCommon.(CalcerFloatResource).xdb" />
                                            </mulCalcer>
                                        </scalerIf>
                                        <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                            <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                                <quality href="/Mechanics/MobQualities/Boss.xdb" />
                                            </condition>
                                            <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageElite.(CalcerFloatResource).xdb" />
                                                </mulCalcer>
                                            </scalerIf>
                                            <scalerElse type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageBoss.(CalcerFloatResource).xdb" />
                                                </mulCalcer>
                                            </scalerElse>
                                        </scalerElse>
                                    </Item>
                                </scalers>
                            </scaler>
                        </Item>
                    </impacts>
                    <finalImpactsOnHolder />
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
        </Item>
    </impactsOnStart>
    <effects />
    <impactsToTarget />
</gameMechanics.world.projectile.ProjectileResource>