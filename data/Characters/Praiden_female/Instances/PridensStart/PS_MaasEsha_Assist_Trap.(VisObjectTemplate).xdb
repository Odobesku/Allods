<?xml version="1.0" encoding="UTF-8"?>
<VisObjectTemplate>
	<defaultState>
		<sound>
			<creationRadius>-1</creationRadius>
		</sound>
		<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
		<playSoundOnKeys>true</playSoundOnKeys>
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>100</fadeInMS>
	<fadeOutMS>400</fadeOutMS>
	<geometry href="/Spells/FX/Spells/DruidLightningRodAbility.(Geometry).xdb#xpointer(/Geometry)" />
	<particle href="/Spells/FX/Spells/DruidLightningRodAbility.(ParticleAnimation).xdb#xpointer(/ParticleAnimation)" />
	<replaceDistance>-1</replaceDistance>
	<scale>0.5</scale>
	<sound>
		<creationRadius>-1</creationRadius>
		<name>spells/Champions/TWarChampionsVengeance</name>
		<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
	</sound>
	<states>
		<Item>
			<sound>
				<creationRadius>-1</creationRadius>
				<name>spells/Hits/HitLightningBig</name>
				<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
			</sound>
			<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
			<playSoundOnKeys>true</playSoundOnKeys>
			<animation href="/Spells/FX/Spells/DruidLightningRodAbility.(SkeletalAnimation).xdb#xpointer(/SkeletalAnimation)" />
			<isNecessaryAnim>false</isNecessaryAnim>
		</Item>
	</states>
	<drawBehindCamera>false</drawBehindCamera>
	<softReplace>false</softReplace>
</VisObjectTemplate>