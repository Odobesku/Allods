<?xml version="1.0" encoding="UTF-8" ?>
<WidgetEditLine>
	<Name>Editline</Name>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>10</Pos>
			<HighPos>10</HighPos>
			<Size>0</Size>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>3</Pos>
			<HighPos>4</HighPos>
			<Size>0</Size>
		</Y>
	</Placement>
	<TabOrder>2</TabOrder>
	<Cursor1Layer href="/Interface/Common/Elements/Editline/Cursor1Layer.(WidgetLayerSimpleTexture).xdb#xpointer(/WidgetLayerSimpleTexture)" />
	<Cursor2Layer href="/Interface/Common/Elements/Editline/Cursor2Layer.(WidgetLayerSimpleTexture).xdb#xpointer(/WidgetLayerSimpleTexture)" />
	<ReactionEsc>editline_esc_pressed</ReactionEsc>
	<ReactionChanged>editline_changed</ReactionChanged>
	<reactionFocusChanged>editline_focus_changed</reactionFocusChanged>
	<maxSymbolsCount>40</maxSymbolsCount>
	<globalClassName>EditLineGlobal</globalClassName>
	<selectionClassName>EditLineSelection</selectionClassName>
	<selectionLayer href="/Interface/Common/Elements/Editline/SelectionLayer.(WidgetLayerSimpleTexture).xdb#xpointer(/WidgetLayerSimpleTexture)" />
