            <characterClass>/Mechanics/Classes/Necromancer.xdb#xpointer(/gameMechanics.world.avatar.CharacterClass)</characterClass>
        </Variables>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsToPet">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Necromancer/PetNecromancerFatality.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Necromancer/PetNecromancerFatality.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsOff>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectIfOverTime">
            <predicates>
                <Item type="gameMechanics.world.pet.PredicateHasPet" />
                <Item type="gameMechanics.elements.predicates.PredicateToPet">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Necromancer/PetNecromancerFatality.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Necromancer/PetNecromancerFatality.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsElse>
            <tick type="gameMechanics.elements.calcers.FloatData">
                <value>5000</value>
            </tick>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.buff.BuffResource>