<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>739868665</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EventTrigger">
            <conditionalEvents>
                <Item>
                    <obj>gameMechanics.elements.events.EventEmoteProcess</obj>
                    <predicate type="gameMechanics.elements.predicates.PredicateEmoteProcess">
                        <clientData href="/Client/SlashCommands/EmoteDanceAnniversary.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </predicate>
                </Item>
            </conditionalEvents>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                    <quest href="EventAnniversaryEmote.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                    <counterResource href="CheckEmote.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>