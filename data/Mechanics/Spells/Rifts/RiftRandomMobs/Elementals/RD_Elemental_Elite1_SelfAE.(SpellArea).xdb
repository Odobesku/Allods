    <mechanics>
        <cooldown>
            <duration>16000</duration>
        </cooldown>
        <casterConditions />
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <conditions />
        <casterResources />
        <casterChannelingEffects />
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/Rifts/Abilities/StopBuff.(BuffResource).xdb" />
                <impactsOnAttach />
