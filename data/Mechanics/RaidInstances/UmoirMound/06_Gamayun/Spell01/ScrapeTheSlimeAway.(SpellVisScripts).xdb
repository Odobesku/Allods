<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Description href="" />
	<wholeCasting type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readySpellDirected</Item>
		</animations>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Mobs/Gamayun_AcidBolt.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<theGe>25</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
