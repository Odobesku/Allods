<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>249450</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/Taunt.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.5</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/HuntingGround/Bosses/HuntingGround3/OgreBoss/AddSelfHeal.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/HuntingGround/Bosses/HuntingGround3/OgreBoss/AddPassiveRegen.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/HuntingGround/Bosses/HuntingGround3/OgreBoss/AddPassiveRegen.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectGroup>Friends</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/HuntingGround/Bosses/HuntingGround3/OgreBoss/AddEnrage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                <filters>
                                    <Item type="gameMechanics.world.creature.MobFilter" />
                                    <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                <mobs>
                                                    <Item href="/Mechanics/HuntingGround/Bosses/HuntingGround3/OgreBoss/OgreBoss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                </mobs>
                                            </Item>
                                        </predicates>
                                    </Item>
                                </filters>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.LayeredHealthTrigger">
            <layers>
                <Item>
                    <percent>0.4</percent>
                    <mechanics>
                        <impactsOn>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/HuntingGround/Bosses/HuntingGround3/OgreBoss/AddEnrage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                        <buff href="/Mechanics/HuntingGround/Bosses/HuntingGround3/OgreBoss/AddSelfHeal.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOn>
                    </mechanics>
                </Item>
                <Item>
                    <percent>0.5</percent>
                    <mechanics>
                        <impactsOff>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="/Mechanics/HuntingGround/Bosses/HuntingGround3/OgreBoss/AddEnrage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsOff>
                    </mechanics>
                </Item>
            </layers>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>