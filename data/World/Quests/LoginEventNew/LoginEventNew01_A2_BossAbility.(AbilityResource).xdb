<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739913729</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.DeathTrigger">
					<impactsToKiller>
						<Item type="gameMechanics.elements.impacts.ImpactIsolator">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
									<affectPets>false</affectPets>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
													<id href="/World/Quests/LoginEventNew/LoginEventNew01_A2.(QuestCountId).xdb" />
												</Item>
											</impactsIf>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsToKiller>
				</Item>
			</effectsIf>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>