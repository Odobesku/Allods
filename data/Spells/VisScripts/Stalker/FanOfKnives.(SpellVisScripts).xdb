<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantFire</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureSetFlagAction">
						<flagName>FireKnives</flagName>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantPoison</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureSetFlagAction">
						<flagName>PoisonKnives</flagName>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantCold</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureSetFlagAction">
						<flagName>ColdKnives</flagName>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>InSequence</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="PredicateCreatureFlagAction">
							<flagName>EnchantFire</flagName>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="CreatureSetFlagAction">
								<flagName>FireKnives</flagName>
							</Item>
						</elements>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="PredicateCreatureFlagAction">
							<flagName>EnchantPoison</flagName>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="CreatureSetFlagAction">
								<flagName>PoisonKnives</flagName>
							</Item>
						</elements>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="PredicateCreatureFlagAction">
							<flagName>EnchantCold</flagName>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="CreatureSetFlagAction">
								<flagName>ColdKnives</flagName>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>instantSpellCastDirected</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<waitRealEvent>NO_WAIT</waitRealEvent>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>FireKnives</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/Stalker70_FanOfKnives_Fire.(VisObjectTemplate).xdb" />
						<offset z="1" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>ColdKnives</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/Stalker70_FanOfKnives_Cold.(VisObjectTemplate).xdb" />
						<offset z="1" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>PoisonKnives</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/Stalker70_FanOfKnives_Poison.(VisObjectTemplate).xdb" />
						<offset z="1" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>FireKnives</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="PredicateCreatureFlagAction">
							<flagName>ColdKnives</flagName>
							<checkIsSet>false</checkIsSet>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="VisActionList">
								<playWhile type="PredicateCreatureFlagAction">
									<flagName>PoisonKnives</flagName>
									<checkIsSet>false</checkIsSet>
								</playWhile>
								<preconditional>true</preconditional>
								<elements>
									<Item type="CreatureIndependentFxAction">
										<visObject href="/Spells/FX/Spells/StalkerHadagan2.(VisObjectTemplate).xdb" />
										<offset z="1" />
									</Item>
								</elements>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureSetFlagAction">
						<flagName>FireKnives</flagName>
						<isSet>false</isSet>
					</Item>
					<Item type="CreatureSetFlagAction">
						<flagName>ColdKnives</flagName>
						<isSet>false</isSet>
					</Item>
					<Item type="CreatureSetFlagAction">
						<flagName>PoisonKnives</flagName>
						<isSet>false</isSet>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
