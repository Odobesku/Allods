<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.battleground.BattleEventMapMechanics>
	<Header>
		<resourceId>739826493</resourceId>
	</Header>
	<score href="MM_BG02.(InstancedEventAchievementResource).xdb" />
	<mechanicsType>BATTLEGROUND</mechanicsType>
	<map href="/Maps/Domination02/MapResource.xdb" />
	<winCounter>2500</winCounter>
	<waitBuff href="/Mechanics/InstancedEventResource/MM_Pvp_Arena/Arena_wait/Buff01.xdb" />
	<impactsOnStart>
		<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
			<spawn>
				<scriptID>Blue_Door_01</scriptID>
				<map href="/Maps/Domination02/MapResource.xdb" />
			</spawn>
			<impacts>
				<Item type="gameMechanics.elements.device.DoorSwitch" />
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
			<spawn>
				<scriptID>Red_Door_03</scriptID>
				<map href="/Maps/Domination02/MapResource.xdb" />
			</spawn>
			<impacts>
				<Item type="gameMechanics.elements.device.DoorSwitch" />
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactEnableBunchEffects">
			<enable>true</enable>
		</Item>
	</impactsOnStart>
	<impactsOnFinish>
		<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Mechanics/InstancedEventResource/MM_BG01/Afk_Disabler_finish.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</impactsOnFinish>
	<startAnnounce href="StartAnnounce.(ClientData).xdb" />
	<impactsOnAvatars>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/ZoneHadagan1/BG1_Tutor/Count4.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/ArchipelagoLeague1/BG1_Tutor/Count2.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
			<buff href="/Mechanics/InstancedEventResource/MM_BG01/Afk_Disabler.(BuffResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
					<key href="/System/ContentKeys/GoodPVP.(ContentKey).xdb" />
				</Item>
			</predicates>
			<impactsIf>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/InstancedEventResource/CommonMechanics/GoodPVP.(BuffResource).xdb" />
				</Item>
			</impactsIf>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
			<delay>5000</delay>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.battleground.map.PredicateBattleMemberMark">
							<mark href="/Maps/Domination02/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="DeathTriggerBlue.(BuffResource).xdb" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.battleground.map.PredicateBattleMemberMark">
							<mark href="/Maps/Domination02/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="DeathTriggerRed.(BuffResource).xdb" />
						</Item>
					</impactsIf>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
			<delay>15000</delay>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
							<data href="LearningCurve_BG02.(ClientData).xdb" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
					<key href="/System/ContentKeys/BG_Up_to_Rare.(ContentKey).xdb" />
				</Item>
			</predicates>
			<impactsIf>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/FairGSonMM/MainUpBuff.(BuffResource).xdb" />
				</Item>
			</impactsIf>
		</Item>
	</impactsOnAvatars>
	<assignWinnerOnDraw>false</assignWinnerOnDraw>
	<ignoreWinCounterOnTimeout>true</ignoreWinCounterOnTimeout>
	<impactsOnEarlyExit>
		<Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactAddInstancedEventVisits">
			<event href="MM_BG02.(InstancedEventResource).xdb" />
			<summand>1</summand>
		</Item>
		<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
			<buff href="/Mechanics/InstancedEventResource/MM_BG01/LeaverDebuff.(BuffResource).xdb" />
			<durationScaler type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
				<buff href="/Mechanics/InstancedEventResource/MM_BG01/LeaverDebuffCounter.(BuffResource).xdb" />
				<anyRank>true</anyRank>
				<onlyFromMaster>true</onlyFromMaster>
				<mul>3</mul>
				<sum>1</sum>
			</durationScaler>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactLogAvatarStats">
			<resource href="MM_BG02Fair.(InstancedEventResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.BuffDetacher">
			<buff href="/Mechanics/InstancedEventResource/CommonMechanics/GoodPVP.(BuffResource).xdb" />
		</Item>
	</impactsOnEarlyExit>
	<impactsOnWinners>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/ZoneHadagan1/MegaGoal_E_IslandDaily_03/CountId_01.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/ZoneLeague1/MegaGoal_L_IslandDaily_03/CountId_01.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactLogAvatarStats">
			<resource href="MM_BG02Fair.(InstancedEventResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.BuffDetacher">
			<buff href="/Mechanics/InstancedEventResource/CommonMechanics/GoodPVP.(BuffResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/LoginEventNew/LoginEventNew03_A1.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/ZoneHadagan1/StrongboxRule/BGCounter.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/Mechanics/LoginEvent3/LE3SoloQuest02.(QuestCountId).xdb" />
		</Item>
	</impactsOnWinners>
	<impactsOnLosers>
		<Item type="gameMechanics.elements.impacts.ImpactLogAvatarStats">
			<resource href="MM_BG02Fair.(InstancedEventResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.BuffDetacher">
			<buff href="/Mechanics/InstancedEventResource/CommonMechanics/GoodPVP.(BuffResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/ZoneHadagan1/MegaGoal_E_IslandDaily_03/CountId_01.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/ZoneLeague1/MegaGoal_L_IslandDaily_03/CountId_01.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/ZoneHadagan1/StrongboxRule/BGCounter.(QuestCountId).xdb" />
		</Item>
	</impactsOnLosers>
	<entrances>
		<Item>
			<mark href="/Maps/Domination02/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
			<entrances>
				<Item type="mapLoader.pointer.MapPointerPos">
					<pointer>
						<scriptID>Blue_enter_01</scriptID>
						<map href="/Maps/Domination02/MapResource.xdb" />
					</pointer>
				</Item>
			</entrances>
		</Item>
		<Item>
			<mark href="/Maps/Domination02/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
			<entrances>
				<Item type="mapLoader.pointer.MapPointerPos">
					<pointer>
						<scriptID>Red_enter_01</scriptID>
						<map href="/Maps/Domination02/MapResource.xdb" />
					</pointer>
				</Item>
			</entrances>
		</Item>
	</entrances>
	<prepareTime>
		<minute>2</minute>
	</prepareTime>
	<duration>
		<minute>20</minute>
	</duration>
	<achievements>
		<Item>
			<resource href="MM_BG02.(InstancedEventAchievementResource).xdb" />
			<count>2500</count>
			<weight>1</weight>
			<finalWeight>1</finalWeight>
		</Item>
		<Item>
			<showInTable>true</showInTable>
			<resource href="/Mechanics/InstancedEventResource/Achievements/Kills.(BattleEventAchievementResource).xdb" />
		</Item>
		<Item>
			<showInTable>true</showInTable>
			<resource href="/Mechanics/InstancedEventResource/Achievements/Deaths.(BattleEventAchievementResource).xdb" />
		</Item>
		<Item>
			<showInTable>true</showInTable>
			<resource href="/Mechanics/InstancedEventResource/Achievements/TotalDamageDone.(BattleEventAchievementResource).xdb" />
		</Item>
		<Item>
			<showInTable>true</showInTable>
			<resource href="/Mechanics/InstancedEventResource/Achievements/TotalHealDone.(BattleEventAchievementResource).xdb" />
		</Item>
