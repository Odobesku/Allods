<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>204472</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectAngularVelocityTrigger">
            <angleDelta type="constructor.basicElements.AngleDegrees">
                <value>30</value>
            </angleDelta>
            <impacts>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.StackBuff">
                            <buff href="Acceleration01.xdb" />
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>-1</value>
                            </delta>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.StackBuff">
                            <buff href="TechAcceleration01.xdb" />
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>-1</value>
                            </delta>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Acceleration01.xdb" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="TechAcceleration01.xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateMounted" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="AngleMeasure01.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Acceleration01.xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMountTrigger">
            <onBeforeDismount>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="AngleMeasure01.xdb" />
                        </Item>
                    </impacts>
                </Item>
            </onBeforeDismount>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMounted">
                                        <specificGroup href="/Mechanics/Mounts/Groups/ManaBikes.(MountGroupResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateMounted">
                                        <specificGroup href="/Mechanics/Mounts/Groups/ManaBikeTemp5Grade.(MountGroupResource).xdb" />
                                    </Item>
                                </predicates>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="TechAcceleration01.xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>