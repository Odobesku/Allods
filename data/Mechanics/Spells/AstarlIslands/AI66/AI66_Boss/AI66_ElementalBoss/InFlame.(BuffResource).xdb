<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>187265</resourceId>
    </Header>
    <Name href="InFlame.(BuffResource).Name.txt" />
    <Description href="InFlame.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Special/Talents/Mage/ImproveFire.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="InFlame.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>Volcano</scriptID>
                            <map href="/Maps/AstralIsle66/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </locator>
                    </destination>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllAggro" />
                    </impacts>
                    <object href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_ArmoredTroll/TargetDummy.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    <pool href="ElementalBossPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                    <spell href="Volcano.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>Volcano</scriptID>
                            <map href="/Maps/AstralIsle66/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </locator>
                    </destination>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                <resource href="IceBlow.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                            </projectileData>
                            <pool href="ElementalBossPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="IceChains.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </predicate>
                            </Item>
                        </predicates>
                    </filter>
                    <targetsLimit>3</targetsLimit>
                </Item>
            </impacts>
            <tick>10000</tick>
            <initialDelay>10000</initialDelay>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>