<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>196729</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/RaceClassSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/SpeedBoosts.xdb" />
        <Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
    </groups>
    <Name href="Spell01.(SpellSingleTarget).Name.txt" />
    <Description href="Spell01.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Terrarium/Web.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Stalker/RecoilJump.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <iffPolicy>Enemies</iffPolicy>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>60000</duration>
            <group href="/Mechanics/Spells/Groups/RaceClassSpells.xdb" />
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAvatarJump">
                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                    <base type="gameMechanics.map.destination.RelativePos">
                        <yaw type="constructor.basicElements.AngleRadians" />
                        <faceSourcePos>false</faceSourcePos>
                    </base>
                    <offset>20</offset>
                    <yaw type="constructor.basicElements.AngleRadians">
                        <value>3.14</value>
                    </yaw>
                </destination>
                <speed>20</speed>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>15</radius>
                <affectGroup>Enemies</affectGroup>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>3</multiplier>
                        </durationScaler>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                        <value>10</value>
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.AliveFilter" />
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>20</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>