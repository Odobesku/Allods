<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Cyclop_GoldBuff.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<scale>0.5</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Back_LC</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
	</action>
	<postAction type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Cyclop_GoldBuff_End.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.7</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Back_LC</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
