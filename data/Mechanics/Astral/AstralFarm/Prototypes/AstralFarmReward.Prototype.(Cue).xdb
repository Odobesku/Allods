                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                <item hrefvar="Reward" />
            </item>
            <count type="gameMechanics.elements.calcers.FloatToLongCalcer">
                <calcer type="gameMechanics.elements.calcers.CalcerMul">
                    <calcers>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value>1.4451</value>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                            <buff hrefvar="Rewardbuff" />
                        </Item>
                        <Item type="gameMechanics.elements.calcers.CalcerExp">
                            <base>2.71828</base>
                            <powCalc type="gameMechanics.elements.calcers.CalcerExp">
                                <base>1.02</base>
                                <powCalc type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                    <buff hrefvar="Rewardbuff" />
                                </powCalc>
                            </powCalc>
                        </Item>
                    </calcers>
                </calcer>
            </count>
        </Item>
        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
