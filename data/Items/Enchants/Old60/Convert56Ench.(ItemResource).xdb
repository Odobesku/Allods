    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <binding>BindOnPickup</binding>
    <name href="Convert56Ench.(ItemResource).Name.txt" />
    <description href="Convert56Ench.(ItemResource).Description.txt" />
