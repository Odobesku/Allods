<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222699</resourceId>
    </Header>
    <Name href="BlueDebuff.(BuffResource).Name.txt" />
    <Description href="BlueDebuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/CurseAstral.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ReviveTrigger">
            <impactsOnRevive>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                            <spawn>
                                <scriptID>6_TigerRat</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="BlueDebuff.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnRevive>
        </Item>
        <Item type="gameMechanics.elements.effects.OutgoingHealModifier">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.5</coeff>
            </scaler>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>