<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>319316</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn />
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>1000</delay>
                    <limit>1</limit>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>SingleWolf</scriptID>
                                <map href="/Maps/ArchipelagoGipatsShard/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <onBehalfOfTarget>true</onBehalfOfTarget>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impacts>
                    <useSpellEnvelopeTargetEffects>false</useSpellEnvelopeTargetEffects>
                </Item>
            </impactsOff>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>