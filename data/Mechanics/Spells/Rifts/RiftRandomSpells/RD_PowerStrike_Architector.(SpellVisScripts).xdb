<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<animations>
			<Item>ready</Item>
		</animations>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="CreatureAnimationAction">
					<animations>
						<Item>hitCritical</Item>
					</animations>
					<channel>CHANNEL_HITCRITICAL</channel>
				</Item>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/HitMeleeCrit.(VisObjectTemplate).xdb" />
							<locator>Slot_BodyFX</locator>
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
