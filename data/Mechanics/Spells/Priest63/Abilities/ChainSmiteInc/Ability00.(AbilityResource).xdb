		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability00.(AbilityResource).Name.txt" />
	<description href="Ability00.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="value" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Priest/ChainSmite.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
							<variable href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
							<summand>-1</summand>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="/Mechanics/Spells/Priest63/Spells/ChainSmite/Spell01.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
		</Item>
		<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
			<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
				<coeff>0.01</coeff>
				<calcer type="gameMechanics.elements.calcers.CalcerIf">
					<predicate type="gameMechanics.elements.predicates.PredicateVariableGreatThan">
						<resource href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
						<minValue>1</minValue>
					</predicate>
					<calcerIf type="gameMechanics.elements.calcers.FloatData">
						<value var="big" />
					</calcerIf>
					<calcerElse type="gameMechanics.elements.calcers.FloatData">
						<value var="value" />
					</calcerElse>
				</calcer>
			</scaler>
			<group href="/Mechanics/Spells/Groups/ChainSmite63.(ActionGroup).xdb" />
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
