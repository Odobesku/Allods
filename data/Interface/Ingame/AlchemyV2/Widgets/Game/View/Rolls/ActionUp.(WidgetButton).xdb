        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag></TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/AlchemyV2/Textures/Game/View/Rolls/AlchemyRollTubeButtonUpHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            <PushedOffset x="0" y="0"/>
            <Reaction>up_pressed</Reaction>
            <ReactionRightClick></ReactionRightClick>
