<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/WideScreen.(UserPostEffect).xdb" />
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureCutSceneAction" />
				</elements>
			</Item>
			<Item type="CameraTrackAction">
				<cameraPoints />
				<targetPoints />
				<cameraRoute href="/Maps/ArchBase_Raid/GlobalObjects/Routes/R7_2th_death_intro_Flow.(Route).xdb" />
				<targetRoute href="/Maps/ArchBase_Raid/GlobalObjects/Routes/R7_2th_Death_intro_Camera.(Route).xdb" />
			</Item>
		</elements>
		<stopOnDeath>true</stopOnDeath>
	</action>
</BuffVisScripts>
