<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>219978</resourceId>
    </Header>
    <Name href="MeditationBuff.(BuffResource).Name.txt" />
    <Description href="MeditationBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Psionic/PsionicMeditation.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/Psionic70_Meditation.(VisObjectTemplate).xdb" />
            <fadeInTime>200</fadeInTime>
            <fadeOutTime>200</fadeOutTime>
        </Item>
    </visualEffects>
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.ImpactsOverTime">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                <variable href="/Mechanics/Spells/Psionic63/Abilities/StressResource/StressResource.(VariableResource).xdb" />
                                <summand>-5</summand>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <tick>1000</tick>
            </effect>
            <ticksCount>5</ticksCount>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>