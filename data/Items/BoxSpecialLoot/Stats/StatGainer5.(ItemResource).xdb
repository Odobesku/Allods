<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>492946</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/ApocryphPerfection.(UISingleTexture).xdb" />
    <source>Vendor</source>
    <showItemContextAction>Never</showItemContextAction>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <warningUseText href="/Items/BoxSpecialLoot/ShureToUse.txt" />
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.avatar.itemBag.GrantUnlockTakeAction">
                        <unlock href="/Mechanics/Unlocks/AltCurrencies/IM_Stat_05_Unlock.(UnlockResource).xdb" />
                    </Item>
                </actions>
                <consumeItems>1</consumeItems>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="/Mechanics/Unlocks/AltCurrencies/IM_Stat_05_Unlock.(UnlockResource).xdb" />
                </predicate>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>4</value>
                </minLevel>
            </Item>
        </predicates>
    </functionalPart>
    <requiredLevel>4</requiredLevel>
    <stackLimit>1000</stackLimit>
    <quality href="/Mechanics/ItemQualities/Epic.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>100000</money>
        </cost>
    </prices>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="StatGainer5.(ItemResource).Name.txt" />
    <description href="StatGainer5.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/ItemMall.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>