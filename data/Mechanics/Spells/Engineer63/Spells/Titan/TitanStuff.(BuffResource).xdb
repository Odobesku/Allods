<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>216034</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="TitanStuff.(BuffResource).Name.txt" />
    <Description href="TitanStuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/EngineerTtitan.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="TitanLifetime.(BuffResource).xdb" />
                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                <coeff>1</coeff>
                <calcer type="gameMechanics.elements.calcers.CalcerSum">
                    <summands>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value>-1</value>
                        </Item>
                        <Item type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </Item>
                    </summands>
                </calcer>
            </scaler>
            <group href="/Mechanics/Spells/Groups/AssistantSpells.(ActionGroup).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <affectsPureHeal>true</affectsPureHeal>
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
            <predicate type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
            </predicate>
        </Item>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatFullHealth" />
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.LinearCalcer">
                    <mul>0</mul>
                    <sum var="hpmultiplier" />
                </mulCalcer>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.4</coeff>
            </effectScaler>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="TitanStuff01.(BuffResource).xdb" />
        <Item href="TitanStuff02.(BuffResource).xdb" />
        <Item href="TitanStuff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/EngineerAttackDevices.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>