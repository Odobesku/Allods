    <ignoreGlobalCooldown>false</ignoreGlobalCooldown>
    <launchWhenReady>false</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                        <buff href="/Mechanics/Abilities/NecromancerTalents/DeferredHeal/ChainHealing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <range>
                            <min>3</min>
                            <max>3</max>
                        </range>
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.elements.resources.ResourceVariable">
                    <variable href="/Mechanics/Spells/Necromancer/BloodPool/BloodPool.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
                    <ability href="/Mechanics/Spells/Necromancer/BloodPool/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                    <sub>4</sub>
                </resourceIf>
                <resourceElse type="gameMechanics.elements.resources.ResourceIf">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                            <buff href="/Mechanics/Abilities/NecromancerTalents/DeferredHeal/ChainHealing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <range>
                                <min>2</min>
                                <max>2</max>
                            </range>
                        </Item>
                    </predicates>
                    <resourceIf type="gameMechanics.elements.resources.ResourceVariable">
                        <variable href="/Mechanics/Spells/Necromancer/BloodPool/BloodPool.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
                        <ability href="/Mechanics/Spells/Necromancer/BloodPool/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        <sub>3</sub>
                    </resourceIf>
                    <resourceElse type="gameMechanics.elements.resources.ResourceIf">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                <buff href="/Mechanics/Abilities/NecromancerTalents/DeferredHeal/ChainHealing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <range>
                                    <min>1</min>
                                    <max>1</max>
                                </range>
                            </Item>
                        </predicates>
                        <resourceIf type="gameMechanics.elements.resources.ResourceVariable">
                            <variable href="/Mechanics/Spells/Necromancer/BloodPool/BloodPool.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
                            <ability href="/Mechanics/Spells/Necromancer/BloodPool/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                            <sub>2</sub>
                        </resourceIf>
                        <resourceElse type="gameMechanics.elements.resources.ResourceVariable">
                            <variable href="/Mechanics/Spells/Necromancer/BloodPool/BloodPool.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
                            <ability href="/Mechanics/Spells/Necromancer/BloodPool/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                            <sub>1</sub>
                        </resourceElse>
                    </resourceElse>
                </resourceElse>
            </Item>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>39</mana>
                <rawManaScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mul>0.25</mul>
                    <mulCalcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
