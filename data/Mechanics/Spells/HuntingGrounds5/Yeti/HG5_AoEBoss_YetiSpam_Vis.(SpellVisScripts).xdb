<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readySpell</Item>
		</animations>
		<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
	</actionBarStart>
	<launch type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/World/IceArena_Explosion_Final.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fixPoint>true</fixPoint>
				<lockScale>true</lockScale>
				<locator>Slot_Global</locator>
			</Item>
		</visualEffects>
	</launch>
</SpellVisScripts>
