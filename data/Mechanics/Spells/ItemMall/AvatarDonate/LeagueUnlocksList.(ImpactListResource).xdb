				<Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
					<unlock href="/Mechanics/Unlocks/Quest/GT_EntranceUnlock/ArchBase_Entrance.(UnlockResource).xdb" />
				</Item>
			</elseImpacts>
		</Item>
	</impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>
