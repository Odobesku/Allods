<?xml version="1.0" encoding="UTF-8" ?>
<UIAddon>
	<Name>ChoiceFaction</Name>
	<AutoStart>true</AutoStart>
	<ScriptFileRefs>
		<Item href="/Interface/Common/Script/ScriptStandardExtension.lua" />
		<Item href="/Interface/Common/Script/ScriptCommonUtility.lua" />
		<Item href="/Interface/Common/Script/ScriptMultipleEventHandlers.lua" />
		<Item href="/Interface/Common/Script/ScriptWidgetEffectSequence.lua" />
		<Item href="/Interface/Ingame/ContextLayoutManager/ScriptEscapeSequenceManagerPlugIn.lua" />
		<Item href="/Interface/Ingame/ContextLayoutManager/ScriptContextLayoutManagerPlugIn.lua" />
		<Item href="/Interface/Common/Script/ScriptClassesImplementation.lua" />
		<Item href="/Interface/Common/Script/ScriptAdvancedEventHandlers.lua" />
		<Item href="/Interface/Common/Script/ScriptAdvancedReactionHandlers.lua" />
		<Item href="/Interface/Common/Script/ScriptWidgetFactory.lua" />
		<Item href="/Interface/Common/Script/ScriptWidgetCore.lua" />
		<Item href="/Interface/Common/Script/ScriptAdvancedWidgetBasicElement.lua" />
		<Item href="/Interface/Common/Script/ScriptAdvancedUIBasicElement.lua" />
		<Item href="Scripts/ClassFaction.lua" />
		<Item href="Scripts/ClassChoiceFaction.lua" />
		<Item href="Scripts/ScriptMain.lua" />
	</ScriptFileRefs>
	<MainFormId>Main</MainFormId>
	<Forms>
		<Item>
			<Id>Main</Id>
			<Form href="Widgets/ChoiceFaction.(WidgetForm).xdb#xpointer(/WidgetForm)" />
		</Item>
	</Forms>
	<texts href="Texts/UIRelatedTexts.(UIRelatedTexts).xdb#xpointer(/UIRelatedTexts)" />
	<textsGroups>
		<Item>
			<groupName>FactionDesc</groupName>
			<texts href="Texts/FactionDesc.(UIRelatedTexts).xdb#xpointer(/UIRelatedTexts)" />
		</Item>
		<Item>
			<groupName>FactionName</groupName>
			<texts href="Texts/FactionName.(UIRelatedTexts).xdb#xpointer(/UIRelatedTexts)" />
		</Item>
	</textsGroups>
	<texturesGroups>
		<Item>
			<groupName>FactionIcon</groupName>
			<textures href="Textures/FactionIcon.(UIRelatedTextures).xdb#xpointer(/UIRelatedTextures)" />
		</Item>
	</texturesGroups>
</UIAddon>
