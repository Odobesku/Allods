							</projectileData>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>30</radius>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
											<spawn>
												<scriptID>14_SoldierBoss</scriptID>
												<map href="/Maps/FerrisRaid/MapResource.xdb" />
											</spawn>
											<impacts>
												<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
													<impacts>
														<Item type="gameMechanics.elements.impacts.DirectDamage">
															<damage>1</damage>
															<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
																<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
																	<multiplier>0.9</multiplier>
																</mulCalcer>
															</scalerTarget>
														</Item>
													</impacts>
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
									<time>1000</time>
									<distance>12</distance>
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								</predicates>
							</filter>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.DirectDamage">
					<damage>1</damage>
					<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
							<multiplier>0.5</multiplier>
						</mulCalcer>
					</scalerTarget>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>14_SoldierBoss</scriptID>
						<map href="/Maps/FerrisRaid/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Boss/ChargeTheBoss.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.DispelInterceptor">
			<holderImpacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
