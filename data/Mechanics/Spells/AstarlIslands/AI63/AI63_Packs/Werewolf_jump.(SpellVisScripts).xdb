<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>200</time>
					</Item>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/AOEAura_Red.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<useCastPoint>true</useCastPoint>
						<lifeTime>2</lifeTime>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
