<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739931406</resourceId>
	</Header>
	<isExploit>true</isExploit>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>8</value>
	</range>
	<needLos>false</needLos>
	<targetType>STTCurrentTargetNotSelf</targetType>
	<iffPolicy>Everyone</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
				<quest href="WW_1_1.xdb" />
				<status>Started</status>
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="Cannon_Malfunction.(BuffResource).xdb" />
				</predicate>
			</Item>
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
								<quest href="WW_1_1.xdb" />
								<status>Started</status>
							</Item>
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
									<quest href="WW_1_1.xdb" />
									<counterResource href="Counter1.(QuestCountId).xdb" />
								</predicate>
							</Item>
						</predicates>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
						<id href="Counter1.(QuestCountId).xdb" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactSummon">
						<destination type="gameMechanics.map.destination.DestinationLocator">
							<locator>
								<scriptID>architect_cruiser</scriptID>
								<map href="/Maps/Inst_ZoneContested12_Start/Astral_MapResource.(MapResource).xdb" />
							</locator>
						</destination>
						<impacts>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="MoveByTour.(BuffResource).xdb" />
							</Item>
						</impacts>
						<object href="/Creatures/ArchitectSiege/Instances/ZC12/Architect_ship.(MobWorld).xdb" />
					</Item>
				</impactsIf>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.world.ship.device.ExploitUseShipDevice" />
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="ShootCount.(BuffResource).xdb" />
			</Item>
		</targetImpacts>
	</mechanics>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
