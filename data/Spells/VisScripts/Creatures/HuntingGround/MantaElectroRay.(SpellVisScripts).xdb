<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<offendType>EVERYKEY_ALLOFFENDS</offendType>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
				</advanced>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/Mage_LitShield_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<startPoint type="VisPointLocator">
					<locator>FROM_LOCATOR_NAME</locator>
					<locatorName>bahram</locatorName>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
				<offendTime />
				<secondaryTargetParams>
					<channelingFx href="" />
					<offendTime />
				</secondaryTargetParams>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<locator>Slot_FX</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
