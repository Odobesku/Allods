<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739901686</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
			<impactsIn>
				<impactsFromCaster>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.resources.ResourceAnyBuff">
									<buffs>
										<Item href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakMount/MountRider_A.(BuffResource).xdb" />
										<Item href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakMount/MountRider_B.(BuffResource).xdb" />
										<Item href="/Mechanics/RaidInstances/FerrisRaid/7_Yak/YakMount/MountRider_C.(BuffResource).xdb" />
									</buffs>
								</predicate>
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="ElectroDebuffStackable.(BuffResource).xdb" />
							</Item>
						</impactsIf>
					</Item>
				</impactsFromCaster>
			</impactsIn>
			<impactsOut>
				<impactsFromCaster>
					<Item type="gameMechanics.elements.impacts.StackBuff">
						<buff href="ElectroDebuffStackable.(BuffResource).xdb" />
						<delta type="gameMechanics.elements.calcers.FloatData">
							<value>-1</value>
						</delta>
					</Item>
				</impactsFromCaster>
			</impactsOut>
			<maxLength>85</maxLength>
			<reconnect>true</reconnect>
			<height>8</height>
			<width>3.25</width>
			<filter type="gameMechanics.world.creature.AvatarFilter" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="EnergyRayBuff.(BuffResource).xdb" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.StackBuff">
					<buff href="EnergyRayBuff.(BuffResource).xdb" />
					<delta type="gameMechanics.elements.calcers.FloatData">
						<value>-1</value>
					</delta>
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>
