<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739904393</resourceId>
	</Header>
	<Name href="ChainBuff_HM.(BuffResource).Name.txt" />
	<Description href="ChainBuff_HM.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Buffs/ChainViolet.(UISingleTexture).xdb" />
	<visScript href="/Spells/BuffVisScripts/DotLightniing.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ChainBuff_HM.(BuffResource).xdb" />
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.NotStackableEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
							<phantom href="RoboGuard2.(MobWorld).xdb" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>LIGHTNING</element>
									<damage>10</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impacts>
						</Item>
					</impacts>
					<tick>1000</tick>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.PostponedImpacts">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
									<radius>60</radius>
									<affectGroup>Friends</affectGroup>
									<affectHolder>false</affectHolder>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/ChainBuff2_HM_jump.(BuffResource).xdb" />
										</Item>
									</impacts>
									<impactsOnNoTargets>
										<Item type="gameMechanics.elements.impacts.BuffDetacher">
											<buff href="ChainBuff_HM.(BuffResource).xdb" />
										</Item>
									</impactsOnNoTargets>
									<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="ChainBuff_HM.(BuffResource).xdb" />
												</predicate>
											</Item>
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="ChainBuff2_HM.(BuffResource).xdb" />
												</predicate>
											</Item>
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/ChainBuff2_HM_jump.(BuffResource).xdb" />
												</predicate>
											</Item>
											<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="/Mechanics/RaidInstances/Tank.(BuffResource).xdb" />
												</predicate>
											</Item>
											<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
										</predicates>
									</filter>
									<targetsLimit>1</targetsLimit>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/ChainsCount.(BuffResource).xdb" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<eventClasses>
				<Item>gameMechanics.elements.events.EventDeath</Item>
			</eventClasses>
			<impacts>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ChainBuff2_HM.(BuffResource).xdb" />
				</Item>
			</impacts>
			<eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
