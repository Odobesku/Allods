<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>TabOwner</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Pos>160</Pos>
            <Size>160</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <Size>40</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>tab_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>false</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>true</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>value</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextAuction/AuctionTabHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="2" y="-2"/>
            <Reaction>tab_pressed</Reaction>
            <ReactionRightClick>tab_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextAuction/AuctionTabSelected.txt"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextAuction/AuctionTabNormal.txt"/>
                <LayerMain href="/Interface/Ingame/ContextAuction/AuctionTabNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <FormatFileRef href="/Interface/Ingame/ContextAuction/AuctionTabSelected.txt"/>
                <LayerMain href="/Interface/Ingame/ContextAuction/AuctionTabSelected.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextAuction/AuctionTabSelected.txt"/>
            </StatePushedHighlighted>
            <TextFileRef href="/Interface/Ingame/ContextAuction/AuctionTabOwner.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextAuction/AuctionTabHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="0"/>
            <StateDisabled/>
            <StateHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextAuction/AuctionTabSelected.txt"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextAuction/AuctionTabSelected.txt"/>
                <LayerMain href="/Interface/Ingame/ContextAuction/AuctionTabSelected.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <FormatFileRef href="/Interface/Ingame/ContextAuction/AuctionTabNormal.txt"/>
                <LayerMain href="/Interface/Ingame/ContextAuction/AuctionTabNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextAuction/AuctionTabSelected.txt"/>
            </StatePushedHighlighted>
            <TextFileRef href="/Interface/Ingame/ContextAuction/AuctionTabOwner.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
