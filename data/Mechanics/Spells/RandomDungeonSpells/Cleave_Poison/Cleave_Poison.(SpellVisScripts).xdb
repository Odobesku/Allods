<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/UmoirMound_Frog_Cleave.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>200</time>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>attack02</Item>
						</animations>
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
						</advanced>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
