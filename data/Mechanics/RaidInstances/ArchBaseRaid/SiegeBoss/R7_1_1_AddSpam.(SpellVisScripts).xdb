<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>2000</time>
				</playWhile>
				<elements>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Mobs/CannonArchitect_RaedySpell.(VisObjectTemplate).xdb" />
								<scale>0.39</scale>
								<offset y="-0.55" />
								<locatorName>Slot_Special01</locatorName>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>run</Item>
				</animations>
				<advanced>
					<speed>2</speed>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>knockdownEnd</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Mobs/PortalBoss_PanelBeam_CastSpellBom_Small.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Mobs/PortalBoss_Discharge_Hit.(VisObjectTemplate).xdb" />
						<theGe>15</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnTarget>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>2000</time>
				</playWhile>
				<elements>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Mobs/CannonArchitect_RaedySpell_Out.(VisObjectTemplate).xdb" />
								<scale>0.3</scale>
								<offset y="-0.55" />
								<locatorName>Slot_Special01</locatorName>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
