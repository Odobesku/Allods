                <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                    <currency href="/Mechanics/AlternativeCurrencies/AstralTicket.(AlternativeCurrency).xdb" />
                    <multiplier>-1</multiplier>
                    <multiplierCalcer type="itemService.elements.avatarstuffcalcer.StuffCalcerSum">
                        <calcers>
                            <Item type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                                <value>-14</value>
