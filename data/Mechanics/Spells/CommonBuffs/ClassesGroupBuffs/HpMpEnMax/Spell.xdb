    <ranks>
        <Item href="Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.group.SpellGroup)" />
        <Item href="Spell02.xdb#xpointer(/gameMechanics.constructor.schemes.spell.group.SpellGroup)" />
        <Item href="Spell03.xdb#xpointer(/gameMechanics.constructor.schemes.spell.group.SpellGroup)" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>true</triggersGlobalCooldown>
    <ignoreGlobalCooldown>false</ignoreGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateManaCaster">
                        <manaType>Mana</manaType>
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.elements.resources.ResourceMana">
                    <mana>169</mana>
                </resourceIf>
                <resourceElse type="gameMechanics.elements.resources.ResourceMana">
                    <mana>50</mana>
                </resourceElse>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff hrefvar="buff" />
                                <anyRank>false</anyRank>
                                <consumeStacks var="consumeStacks" />
                            </Item>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff hrefvar="buff02" />
                                <anyRank>false</anyRank>
                                <consumeStacks var="consumeStacks02" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
                <impactsElse>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff hrefvar="buff03" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff hrefvar="buff04" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/MagDmg/Buff_02_02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
