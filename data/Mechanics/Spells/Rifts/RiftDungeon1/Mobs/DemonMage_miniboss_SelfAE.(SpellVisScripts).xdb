<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>knockdownStart</Item>
                        </animations>
                        <channel>CHANNEL_KNOCKDOWN</channel>
                    </Item>
                    <Item type="CreatureAnimationAction">
                        <mode>LOOP</mode>
                        <animations>
                            <Item>knockdownLoop</Item>
                        </animations>
                        <channel>CHANNEL_KNOCKDOWN</channel>
                    </Item>
                </elements>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Red_R10.(VisObjectTemplate).xdb" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>300</delay>
                        <effectFx href="/Spells/FX/Spells/HitManaball.(VisObjectTemplate).xdb" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>