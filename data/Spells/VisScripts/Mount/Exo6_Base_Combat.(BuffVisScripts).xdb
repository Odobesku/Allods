<?xml version ="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <visActionID></visActionID>
        <play>Simultaneously</play>
        <playWhile type="PredicateExoVisualAllowedAction">
            <visActionID></visActionID>
            <checkIsNotSet>false</checkIsNotSet>
            <checkMainAvatarOnly>true</checkMainAvatarOnly>
        </playWhile>
        <preconditional>true</preconditional>
        <restartOnVisualChange>true</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </action>
    <postAction type="CreatureEffectsAction">
        <visActionID></visActionID>
        <category>EFFECT_DEFAULT</category>
        <visualEffects>
            <Item>
                <delay>0</delay>
                <effectAnimations>
                    <mode>DIE</mode>
                </effectAnimations>
                <effectFx href="/Spells/FX/Spells/MEV6Base_End.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                <fadeInTime>0</fadeInTime>
                <fadeOutTime>0</fadeOutTime>
                <scale>1</scale>
                <fixPoint>true</fixPoint>
                <lockScale>false</lockScale>
                <muteFxSounds>false</muteFxSounds>
                <ignoreParentRotation>false</ignoreParentRotation>
                <locator>Slot_TopFX</locator>
                <locatorName></locatorName>
                <member>Default_Member</member>
                <offset x="0" y="0" z="-1"/>
                <rotation x="0" y="0" z="0" w="0"/>
                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
            </Item>
        </visualEffects>
        <dontFade>false</dontFade>
        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
        <stopOnDeath>false</stopOnDeath>
    </postAction>
