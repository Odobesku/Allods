						</predicates>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
								<element>ASTRAL</element>
								<damage var="damage" />
								<impactsOnHitTarget>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="FireDot.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										<stacks type="gameMechanics.elements.calcers.CalcerMul">
											<calcers>
												<Item type="gameMechanics.elements.calcers.InverseCalcer">
													<value type="gameMechanics.elements.calcers.FloatData">
														<value>20</value>
