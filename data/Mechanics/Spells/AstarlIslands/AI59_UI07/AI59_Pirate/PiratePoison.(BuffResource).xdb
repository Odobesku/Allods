    <descTemplate href="PiratePoison.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <scaleOnTick>true</scaleOnTick>
                <damagePerTick>10</damagePerTick>
            </parameters>
            <element>POISON</element>
