<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.MobAbilityKit>
    <Header>
        <resourceId>739858363</resourceId>
    </Header>
    <spellEntries>
        <Item>
            <spell href="Charge.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort">
                    <avatarsFirst>true</avatarsFirst>
                </sortTargets>
            </targetSelector>
        </Item>
        <Item>
            <spell href="AoeSlow.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort" />
                <targetConditionChecks>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                        <binaryPredicates>
                            <Item type="gameMechanics.elements.predicates.PredicateDistance">
                                <range min="6" max="30" />
                            </Item>
                        </binaryPredicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>6000</min>
                <max>6000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="PoisonOrb.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByAggro">
                    <startFrom>1</startFrom>
                    <shuffle>true</shuffle>
                </sortTargets>
                <targetConditionChecks>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>10000</min>
                <max>10000</max>
            </cooldowns>
        </Item>
    </spellEntries>
</gameMechanics.world.mob.MobAbilityKit>