<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739920272</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/LimitOfFaith.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Priest/Mercy.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.DamageThreshold">
            <healthCalcer type="gameMechanics.elements.calcers.CalcerSum">
                <summands>
                    <Item type="constructor.elements.CalcerFloatExternal">
                        <externalCalcer hrefvar="externalCalcer" />
                    </Item>
                    <Item type="gameMechanics.elements.calcers.CalcerMul">
                        <calcers>
                            <Item type="gameMechanics.elements.calcers.FloatData">
                                <value>5</value>
                            </Item>
                            <Item type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                <dressSlot>AMMO</dressSlot>
                            </Item>
                        </calcers>
                    </Item>
                </summands>
            </healthCalcer>
            <targetBaseHealthFactor type="gameMechanics.elements.calcers.LinearCalcer">
                <mul>0.01</mul>
                <mulCalcer type="gameMechanics.elements.calcers.CalcerDiff">
                    <minuend type="gameMechanics.elements.calcers.FullHealthCalcer" />
                    <subtrahend type="gameMechanics.elements.calcers.HealthCalcer" />
                </mulCalcer>
                <sum>0</sum>
            </targetBaseHealthFactor>
            <outOfCombatPolicy>Reset</outOfCombatPolicy>
            <ownerDamageFactor type="gameMechanics.elements.calcers.FloatData">
                <value>0</value>
            </ownerDamageFactor>
            <barrierDamageFactor type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </barrierDamageFactor>
        </Item>
    </effects>
    <duration>12000</duration>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ClassChangeBuffs.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>