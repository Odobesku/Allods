								<Item>shuffleRight</Item>
								<Item>ready1H</Item>
								<Item>ready1HSpear</Item>
								<Item>readyUnarmed</Item>
								<Item>readyBow</Item>
								<Item>readyCrossbow</Item>
								<Item>readyCast</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
