<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Mammoth_ReadySpitting.(VisObjectTemplate).xdb" />
						<scale>1.5</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>specialIdle</Item>
				</animations>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
					<name>spells/FX/Spells/MammothBoss/ReadySpitting</name>
				</sound>
				<forcedSoundStop>true</forcedSoundStop>
			</Item>
		</elements>
	</action>
	<postAction type="CreatureAnimationAction">
		<animations>
			<Item>spellCastOmni</Item>
		</animations>
	</postAction>
</BuffVisScripts>
