<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739921409</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="multiplier" />
		</Item>
		<Item>
			<name>cd</name>
			<value var="cd" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent1MinusAbs</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Mage/IceStorm.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
			<mark href="Mark.(MarkResource).xdb" />
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
					<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier var="multiplier" />
					</durationScaler>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellsModifier">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
					<spells>
						<Item href="/Mechanics/Spells/Mage63/Spells/Cyclon/Spell01.(SpellArea).xdb" />
					</spells>
				</Item>
			</predicates>
			<modifiers>
				<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
					<effects>
						<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
							<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
								<coeff var="dmg" />
							</scaler>
						</Item>
					</effects>
					<onBehalfOfHolder>true</onBehalfOfHolder>
				</Item>
			</modifiers>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
			<spell href="/Mechanics/Spells/Mage63/Spells/Cyclon/Spell01.(SpellArea).xdb" />
			<factor var="cd" />
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
