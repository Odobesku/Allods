<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739910187</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactKill" />
			</onLeave>
			<effects>
				<Item type="gameMechanics.elements.effects.Aura">
					<affectGroup>Enemies</affectGroup>
					<radius>5</radius>
					<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
					<impactsIn>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Poison_Add_1.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ReturningImpact">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactKill" />
							</impacts>
						</Item>
					</impactsIn>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.Enlarge">
			<factor>0.8</factor>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Poison_Add_2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Poison_Add_2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
						<radius>55</radius>
					</distributor>
					<data href="/Mechanics/Spells/HuntingGrounds06/TermiteQueenCorrupted/Termite_queen_Add_Data.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
