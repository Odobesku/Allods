<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>226540</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>Frog_Boss</scriptID>
                                <map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="Jumping_Sequence.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactResetActiveAction" />
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Caviar_Jump_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                                            <spell href="Caviar_Jump.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                                            <spell href="Demolishing_AE/Demolishing_AE.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                                            <duration>60000</duration>
                                            <scaler type="gameMechanics.elements.scalers.ScalerMax">
                                                <scaler1 type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier>0.1</multiplier>
                                                </scaler1>
                                                <scaler2 type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                    <mul>0.1</mul>
                                                    <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                                                        <summands>
                                                            <Item type="gameMechanics.elements.calcers.FloatData">
                                                                <value>10</value>
                                                            </Item>
                                                            <Item type="gameMechanics.elements.calcers.CalcerMul">
                                                                <calcers>
                                                                    <Item type="gameMechanics.elements.calcers.FloatData">
                                                                        <value>-1</value>
                                                                    </Item>
                                                                    <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                                                        <buff href="Demolishing_AE/Demolishing_AE_Cooldown_Controller.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                    </Item>
                                                                </calcers>
                                                            </Item>
                                                        </summands>
                                                    </mulCalcer>
                                                </scaler2>
                                            </scaler>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <impactsToKiller>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Caviar_Destroyer.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsToKiller>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                    <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.9</coeff>
            </scaler>
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsAE" />
            </predicates>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>