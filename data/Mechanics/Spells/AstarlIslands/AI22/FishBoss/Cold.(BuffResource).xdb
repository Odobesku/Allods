<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>194005</resourceId>
    </Header>
    <Name href="Cold.(BuffResource).Name.txt" />
    <Description href="Cold.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Event/TrinketIceSculpture.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                    <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectStackTrigger">
                    <count>100</count>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                            <damage>1</damage>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                            </scalerTarget>
                            <offends>true</offends>
                        </Item>
                    </impacts>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.005</coeff>
            </effectScaler>
        </Item>
    </effects>
    <duration>60000</duration>
    <stackLimit>100</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>