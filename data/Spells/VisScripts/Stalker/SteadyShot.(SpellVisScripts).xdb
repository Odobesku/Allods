<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/RangedAttack.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FxProjectile>/Spells/FX/Weapon/WeaponEnchantFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxProjectile>
			<AttackAnimation>USE_CURRENT_RANGED_ATTACK</AttackAnimation>
			<LocatorNameOnArrow>Slot_FX</LocatorNameOnArrow>
			<FxOnHands />
			<LoadHoldMode>LOOP</LoadHoldMode>
			<LoadHoldAnimation>USE_CURRENT_RANGED_LOADHOLD</LoadHoldAnimation>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<advanced>
					<speed>2</speed>
				</advanced>
			</Item>
			<Item skiped="" />
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="VisActionStopAction">
				<stoppedActionID>AttachString</stoppedActionID>
			</Item>
			<Item skiped="" />
			<Item type="CreatureAnimationAction">
				<advanced>
					<speed>0</speed>
				</advanced>
			</Item>
			<Item skiped="" />
			<Item skiped="" />
		</elements>
	</launch>
</SpellVisScripts>
