<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.elements.goals.GoalResource>
    <Header>
        <resourceId>739891779</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <title href="GearScore.Prototype.(GoalResource).Title.txt" />
    <description href="GearScore.Prototype.(GoalResource).Description.txt" />
    <shortDescription href="GearScore.Prototype.(GoalResource).ShortDescription.txt" />
    <showPredicates>
        <Item type="gameMechanics.elements.predicates.PredicateGoalIsCompleted">
            <goal hrefvar="goal" />
        </Item>
    </showPredicates>
    <finishPredicates>
        <Item type="gameMechanics.elements.predicates.PredicateGreater">
            <lhs type="gameMechanics.elements.calcers.CalcerGearScore" />
            <rhs type="gameMechanics.elements.calcers.FloatData">
                <value var="GearScore" />
            </rhs>
        </Item>
    </finishPredicates>
    <targetLevel var="targetLevel" />
    <isHideCompleted>true</isHideCompleted>
</gameMechanics.elements.goals.GoalResource>