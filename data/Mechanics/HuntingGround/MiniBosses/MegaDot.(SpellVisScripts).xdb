<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/MageFireballUpgrade_projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Spells/HitFireball.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
