<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>188374</resourceId>
    </Header>
    <Name href="Execute.(SpellSingleTarget).Name.txt" />
    <visualScripts href="Execute.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>5</value>
    </range>
    <prepareDuration>6000</prepareDuration>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>666666</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>2</multiplier>
                </durationScaler>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Phase2Refresh.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                <selector type="gameMechanics.tools.SelectorShuffle" />
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                </filter>
                <impacts>
                    <Item>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="ExecuteTargetAlly.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>5</radius>
                <affectGroup>Enemies</affectGroup>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                        <minDamage>225</minDamage>
                        <maxDamage>225</maxDamage>
                    </Item>
                </impacts>
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                </filter>
                <perTargetScaling>Divide</perTargetScaling>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="ExecuteTarget.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
