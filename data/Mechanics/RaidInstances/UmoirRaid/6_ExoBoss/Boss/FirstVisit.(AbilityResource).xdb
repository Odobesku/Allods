<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>225670</resourceId>
    </Header>
    <visualScript type="CreatureAnimationAction">
        <animations>
            <Item>special</Item>
        </animations>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.map.variables.ImpactIfMapVariable">
                    <variable href="/Mechanics/RaidInstances/UmoirRaid/6_ExoBoss/ExoBossFirstVisit.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <predicates>
                        <Item type="gameMechanics.map.variables.PredicateMapVariableLessGeneric">
                            <variableResource href="/Mechanics/RaidInstances/UmoirRaid/6_ExoBoss/ExoBossFirstVisit.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                            <maxValue type="gameMechanics.elements.calcers.FloatData">
                                <value>1</value>
                            </maxValue>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="FirstVisit.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                            <ability href="FirstVisit.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        </Item>
                    </impactsElse>
                    <summandIf>1</summandIf>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/Mechanics/RaidInstances/UmoirRaid/2_KtulhuBoss/NoTargeting.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectNoAggro" />
        <Item type="gameMechanics.elements.effects.ImmunityToHarmfulSpells" />
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>