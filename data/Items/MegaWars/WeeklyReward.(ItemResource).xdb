											<calcers>
												<Item type="itemService.elements.avatarstuffcalcer.StuffCalcerAlternativeCurrency">
													<currency href="/Mechanics/AlternativeCurrencies/RealgarRate.(AlternativeCurrency).xdb" />
												</Item>
												<Item type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
													<value>-1</value>
												</Item>
											</calcers>
										</Item>
										<Item type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
											<value>100</value>
