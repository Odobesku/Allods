<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>199191</resourceId>
    </Header>
    <name href="NotKiteMe.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <impacts>
                <targetToOffender>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                <buff href="DamageFromMove.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <range>
                                    <min>2</min>
                                    <max>20</max>
                                </range>
                            </Item>
                        </predicates>
                        <impactsElse>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="DamageFromMove.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsElse>
                    </Item>
                </targetToOffender>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="NotKiteMeInform.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="NotKiteMeInform.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>