<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>specialIdleStart</Item>
						</animations>
						<channelOverrideScript />
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>specialIdle</Item>
						</animations>
						<channelOverrideScript />
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/FerrisRaid_HeedBuff_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
