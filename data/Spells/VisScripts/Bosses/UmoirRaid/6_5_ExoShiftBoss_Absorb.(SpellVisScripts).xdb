<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<speed>1</speed>
					<autoHasten>
						<mode>AUTOHASTEN_NONE</mode>
					</autoHasten>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="VisActionList">
						<elements>
							<Item type="VisActionList">
								<play>Simultaneously</play>
								<playWhile type="VisActionDelay">
									<time>8700</time>
								</playWhile>
								<elements>
									<Item type="CreatureAnimationAction">
										<mode>LOOP</mode>
										<animations>
											<Item>channelCastOmni</Item>
										</animations>
										<channelOverrideScript />
									</Item>
								</elements>
							</Item>
							<Item type="CreatureAnimationAction">
								<mode>DIE</mode>
								<animations>
									<Item>special01</Item>
								</animations>
								<channelOverrideScript />
							</Item>
						</elements>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/ExoShiftBoss_AbsorbAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fixPoint>true</fixPoint>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<actionBarComplite />
	<launch />
</SpellVisScripts>
