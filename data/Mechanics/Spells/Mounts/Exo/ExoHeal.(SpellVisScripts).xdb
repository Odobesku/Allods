                            <Item>
                                <delay>500</delay>
                                <effectFx href="/Spells/FX/Spells/Exoskeleton_Spell02_Electro01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Back_Special</locatorName>
                            </Item>
                            <Item>
