<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureChannelDirectAction">
		<channelingFx href="/Spells/FX/Mobs/Saw_ChannelHeal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
		<startPoint type="VisPointLocator">
			<locator>Slot_Head</locator>
		</startPoint>
		<endPoint type="VisPointLocator">
			<locator>Slot_FX</locator>
		</endPoint>
	</actionBarStart>
	<launch type="CreatureEffectsAction">
