<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739923794</resourceId>
    </Header>
    <Name href="Spell0.(SpellSingleTarget).Name.txt" />
    <Description href="Buff0.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidTreantForm.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                    <destination type="gameMechanics.elements.calcers.DestinationBehind">
                        <comfortRange>3</comfortRange>
                        <maxSteps>1</maxSteps>
                    </destination>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllEnemies">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                    <value>1</value>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                    <useMasterEnemies>true</useMasterEnemies>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="AggroBuffAssistant.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <impactsFromTarget />
                    <traceDown>true</traceDown>
                    <assistantResource href="Assistant.(AssistantResource).xdb" />
                    <mobResource href="Treant.(MobWorld).xdb" />
                    <level type="gameMechanics.elements.calcers.CalcerLevel" />
                    <linkMode>Stats</linkMode>
                    <planeSyncStrategy>Sync</planeSyncStrategy>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactCaseGeneric">
                    <cases>
                        <Item>
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/CommonBuffs/Aspects/DD/Buff01.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="DDTreant.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <assistantResource href="Assistant.(AssistantResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item>
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/CommonBuffs/Aspects/Heal/Buff01.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="HealTreant.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <assistantResource href="Assistant.(AssistantResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item>
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="SupportTreant.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <assistantResource href="Assistant.(AssistantResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </cases>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                    <assistantResource href="Assistant.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="AggroBuffAssistant.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsToAssistant">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectStatSetter">
                    <stat type="gameMechanics.elements.stat.StatFullHealth" />
                    <valueCalcer type="gameMechanics.elements.calcers.CalcerMul">
                        <calcers>
                            <Item type="gameMechanics.elements.calcers.LinearCalcer">
                                <mul>0.05</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                    <dressSlot>AMMO</dressSlot>
                                </mulCalcer>
                                <sum>0.2</sum>
                            </Item>
                            <Item type="gameMechanics.elements.calcers.FullHealthCalcer" />
                        </calcers>
                    </valueCalcer>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
                    <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
                </Item>
            </effects>
            <assistantResources>
                <Item href="Assistant.(AssistantResource).xdb" />
            </assistantResources>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/DD/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
