<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739913867</resourceId>
	</Header>
	<image href="/Interface/Icons/Spells/Necromancer/SummonSkeleton.chn.(UISingleTexture).xdb" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>2000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
									<spawn>
										<scriptID>15_GeneralBoss</scriptID>
										<map href="/Maps/FerrisRaid/MapResource.xdb" />
									</spawn>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="AvatarCount.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
							</impactsIf>
						</Item>
					</impactsOn>
					<impactsOff>
						<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
							<spawn>
								<scriptID>15_GeneralBoss</scriptID>
								<map href="/Maps/FerrisRaid/MapResource.xdb" />
							</spawn>
							<impacts>
								<Item type="gameMechanics.elements.impacts.StackBuff">
									<buff href="AvatarCount.(BuffResource).xdb" />
									<delta type="gameMechanics.elements.calcers.FloatData">
										<value>-1</value>
									</delta>
								</Item>
							</impacts>
						</Item>
					</impactsOff>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsIf">
					<predicate type="gameMechanics.elements.predicates.BinaryPredicateSwitchActors">
						<predicate type="gameMechanics.elements.predicates.PredicateMasterBehindSlave" />
					</predicate>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Backstabber.(BuffResource).xdb" />
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Backstabber.(BuffResource).xdb" />
						</Item>
					</impactsElse>
				</Item>
			</impacts>
			<tick>500</tick>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<isClientReplicated>false</isClientReplicated>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
