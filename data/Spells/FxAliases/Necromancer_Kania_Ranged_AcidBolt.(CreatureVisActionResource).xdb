<?xml version="1.0" encoding="UTF-8" ?>
<CreatureVisActionResource>
	<Header>
		<Variables>
			<Animation>rangedAttack</Animation>
		</Variables>
	</Header>
	<action type="VisActionList">
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="Animation" />
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<autoHasten>
						<timeToBeLeft>500</timeToBeLeft>
					</autoHasten>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
				</advanced>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/NecromancerAcidBoltAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<theGe>8</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
					<locatorName>Weapon_Joint</locatorName>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_FX</locator>
				</pointOnTarget>
				<offendTime type="EffectOffendConstDelay" />
			</Item>
		</elements>
	</action>
</CreatureVisActionResource>
