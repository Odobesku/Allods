<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>channelCastDirected</Item>
		</animations>
		<channel>CHANNEL_ATTACK</channel>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/Engineer_ElectricityProjectile_Turr.(VisObjectTemplate).xdb" />
				<explosionFx href="/Spells/FX/Mobs/TurretNihil_ProjectileHit.(VisObjectTemplate).xdb" />
				<theGe>3</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>FROM_LOCATOR_NAME</locator>
					<member>Mount</member>
					<locatorName>Slot_Special01</locatorName>
				</pointOnCaster>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
