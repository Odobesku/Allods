<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.WeatherCreatureVisAction">
        <params>
          <ambientSoundImpact>Nothing</ambientSoundImpact>
          <areaEffect href="/Spells/FX/World/SandDust.(AreaEffect).xdb#xpointer(/client.VisualConstructor.AreaEffect)" />
          <colorGradingSettings />
          <fadeTime>5</fadeTime>
          <light>
            <AmbientColor>-12634026</AmbientColor>
            <AmbientFactor>0.5</AmbientFactor>
            <ContourColor>0</ContourColor>
            <DiffuseColor>-7173573</DiffuseColor>
            <FadeEnd>1000</FadeEnd>
            <FadeStart>500</FadeStart>
            <FogColor>-10336720</FogColor>
            <FogEnd>450</FogEnd>
            <FogStart>-50</FogStart>
            <GrassContourColorMultiplier>-1</GrassContourColorMultiplier>
            <PointLightColor>-16747922</PointLightColor>
            <SelfIllumColor>2017861120</SelfIllumColor>
            <SpecularColor>0</SpecularColor>
            <SpecularWaterColor>-16746381</SpecularWaterColor>
            <SunLightPitch>0</SunLightPitch>
            <SunLightYaw>45</SunLightYaw>
            <TerrainContourColor>796</TerrainContourColor>
            <TerrainContourPower>3</TerrainContourPower>
            <TerrainSpecularColor>13791038</TerrainSpecularColor>
            <WaterGradientEnd>-16765156</WaterGradientEnd>
            <WaterGradientStart>-14630764</WaterGradientStart>
            <animatedDiffuseColor href="/World/Quests/Suslanger/ZoneMechanics/Event/SandStorm/AO12_SandStorm_AnimateDiffuseColor.(AnimatedLight).xdb#xpointer(/client.Scene3D.AnimatedLight)" />
            <desaturation>0</desaturation>
            <minAmbientOcclusionValue>0</minAmbientOcclusionValue>
            <objectsLightmapBias>0.0125</objectsLightmapBias>
            <terrainLightmapBias>0.01</terrainLightmapBias>
          </light>
          <postEffectParams href="/Maps/Suslanger/ZoneLights/SuslangerSkyBase_Storm.(PostEffectParams).xdb#xpointer(/client.VisualConstructor.PostEffectParams)" />
          <posteffectFogSettings>
            <brightness>1</brightness>
            <color>-1</color>
            <colorUp>-1</colorUp>
            <densityDown>0</densityDown>
            <densityUp>0</densityUp>
            <distanceSettings>
              <falloff>0.5</falloff>
              <maxDistance>400</maxDistance>
              <minDistance>0</minDistance>
            </distanceSettings>
            <heightSettingsDown>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsDown>
            <heightSettingsUp>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsUp>
            <sunSettings>
              <brightness>0.2</brightness>
            </sunSettings>
            <use>false</use>
          </posteffectFogSettings>
          <priority>HIGH</priority>
          <skyMesh href="/World/Sky/SuslangerSkyBase_Storm.(SkyMesh).xdb#xpointer(/client.VisualConstructor.SkyMesh)" />
