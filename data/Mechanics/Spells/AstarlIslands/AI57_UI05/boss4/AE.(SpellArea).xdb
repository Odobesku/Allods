<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>189496</resourceId>
    </Header>
    <element>FIRE</element>
    <Name href="AE.(SpellArea).Name.txt" />
    <visualScripts href="/Mechanics/Spells/AstarlIslands/AI57_UI05/boss2/DirectedCast.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="AE.(SpellArea).NameTemplate.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>70</value>
    </range>
    <prepareDuration>1500</prepareDuration>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>7000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                <level>0.6</level>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="StoneForm.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.map.destination.RelativePos" />
                    </moveType>
                    <resource href="AE1.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                </projectileData>
            </Item>
        </targetImpacts>
    </mechanics>
    <maxTargets>1</maxTargets>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>85</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>