<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<FixPointTarget>true</FixPointTarget>
			<LocatorNameOnTargets />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<CastAnimation>levelUp</CastAnimation>
			<FxOnHands />
			<HitPostFXOnTargets />
			<FXOnTargets />
		</Variables>
	</Header>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>2530</delay>
						<effectFx href="/Spells/FX/Spells/MountDrake_JumpEnd_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
