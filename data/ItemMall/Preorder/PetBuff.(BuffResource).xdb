<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739948285</resourceId>
    </Header>
    <Name href="PetBuff.(BuffResource).Name.txt"/>
    <visScript href="/Spells/VisScripts/Items/PetPreorder7.0.(BuffVisScripts).xdb"/>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                            <spell href="Preorder7BuffSpell.(SpellSingleTarget).xdb"/>
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellActivate">
                            <spell href="Preorder7BuffSpell.(SpellSingleTarget).xdb"/>
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                            <spell href="Preorder7BuffSpell.(SpellSingleTarget).xdb"/>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
                            <spell href="Preorder7BuffSpell.(SpellSingleTarget).xdb"/>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
            <rerunOnLoad>true</rerunOnLoad>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb"/>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb"/>
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
