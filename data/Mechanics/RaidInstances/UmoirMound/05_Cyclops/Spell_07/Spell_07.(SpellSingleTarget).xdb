<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>227431</resourceId>
    </Header>
    <Name href="Spell_07.(SpellSingleTarget).NameTemplate.txt" />
    <visualScripts href="/Spells/VisScripts/Bosses/UmoirCyclop/Damage_All.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>1800</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                <buff href="/Mechanics/RaidInstances/UmoirMound/05_Cyclops/Spell_00/Spell_02_Approve.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <range>
                    <min>3</min>
                    <max>3</max>
                </range>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="/Mechanics/RaidInstances/UmoirMound/05_Cyclops/Spell_00/Spell_02_Approve.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                    <range min="0" max="1" />
                    <withinRange>false</withinRange>
                    <minCandidatesCount>0</minCandidatesCount>
                    <targetCount>0</targetCount>
                </selector>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
                <impacts>
                    <Item>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                                <time>1000</time>
                                <impactsOnLand>
                                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                        </impacts>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                        <element>PHYSICAL</element>
                                        <damage>50</damage>
                                    </Item>
                                </impactsOnLand>
                                <destination type="gameMechanics.map.destination.DestinationLocator">
                                    <locator>
                                        <scriptID>05_Cyclops</scriptID>
                                        <map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                    </locator>
                                </destination>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.DirectDamage">
                        <damage>1</damage>
                        <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                <multiplier>0.1</multiplier>
                            </mulCalcer>
                        </scalerTarget>
                    </Item>
                </impacts>
                <spawnResource href="/Maps/UmoirMound/SpawnTables/05_Cyclops_balkon.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>