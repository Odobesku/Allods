<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739912721</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<image href="/Interface/Icons/Misc/Chests/SkilledItemsBoxOrange.(UISingleTexture).xdb" />
	<source>Vendor</source>
	<forceShowQuality>true</forceShowQuality>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<warningUseText href="GreenExchangeBoxProt.(ItemResource).WarningUseText.txt" />
		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
						<currency href="/Mechanics/AlternativeCurrencies/AstralTicket.(AlternativeCurrency).xdb" />
						<multiplier>-1</multiplier>
					</Item>
					<Item type="itemService.avatar.itemBag.DropLootTakeAction">
						<lootTable hrefvar="lootTable" />
						<multiplier var="multiplier" />
					</Item>
					<Item type="itemService.avatar.itemBag.DropLootTakeAction">
						<lootTable hrefvar="lootTableAdd" />
					</Item>
				</actions>
				<consumeItems>1</consumeItems>
			</Item>
		</usages>
		<predicates>
			<Item type="gameMechanics.elements.resources.ResourceAltCurrency">
				<currency href="/Mechanics/AlternativeCurrencies/AstralTicket.(AlternativeCurrency).xdb" />
				<count>1</count>
			</Item>
		</predicates>
	</functionalPart>
	<level>65</level>
	<requiredLevel>65</requiredLevel>
	<stackLimit>100</stackLimit>
	<quality href="/Mechanics/ItemQualities/Epic.xdb" />
	<prices type="gameMechanics.constructor.schemes.item.prices.ExchangeItem" />
	<binding>BindOnPickup</binding>
	<description href="EpicExchangeBoxProt.(ItemResource).Description.txt" />
</gameMechanics.constructor.schemes.item.ItemResource>
