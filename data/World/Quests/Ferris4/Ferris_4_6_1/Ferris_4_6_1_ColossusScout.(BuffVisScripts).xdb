<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PriestSilenceAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionChangeVisObject">
				<visActionID>Willowisp</visActionID>
				<newVisMob href="/Creatures/Colossus/ColossusScout_CutScene_0.7.(VisualMob).xdb#xpointer(/VisualMob)" />
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>Ambience/OtherWorldMain</name>
				</sound>
				<actionType>Music</actionType>
			</Item>
			<Item type="PostEffectVisAction">
				<userPostEffect href="/Mechanics/RaidInstances/FerrisRaid/CutScene/Ferris_Cutscene.(UserPostEffect).xdb#xpointer(/UserPostEffect)" />
			</Item>
		</elements>
	</action>
</BuffVisScripts>
