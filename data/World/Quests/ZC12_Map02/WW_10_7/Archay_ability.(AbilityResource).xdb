                            <delay>3000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Archay_vis.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/World/Quests/ZC12_Map02/WW_10_7_1/Archay_visual.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                                    <pool href="/World/Quests/ZC12_Map02/WW_15_5/Archont.(SummonPool).xdb" />
                                    <isPersonalPool>true</isPersonalPool>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Mechanics/Creatures/ArchitectSiege/ZC12_Start/TimeLapseArchitectFinish.(ClientData).xdb" />
