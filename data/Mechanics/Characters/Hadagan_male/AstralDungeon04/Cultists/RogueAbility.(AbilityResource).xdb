<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739952102</resourceId>
    </Header>
    <name href="RogueAbility.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/Characters/Hadagan_male/AstralDungeon04/AD04.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </onLeave>
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                                    <groups>
                                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                        <Item href="/Mechanics/Spells/Groups/Knockdowns.xdb" />
                                        <Item href="/Mechanics/Spells/Groups/Fears.xdb" />
                                        <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
                                        <Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
                                    </groups>
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                    <selector type="gameMechanics.tools.SelectorRandomNotLess">
                                        <minIndex>0</minIndex>
                                    </selector>
                                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                                <predicates>
                                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                                    </Item>
                                                </predicates>
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                        </predicates>
                                    </filter>
                                    <impacts>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                                    <projectileData>
                                                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                                                            <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                                                                <base type="gameMechanics.map.destination.SelfPosDestination" />
                                                                                <offset>1.25</offset>
                                                                            </destination>
                                                                        </moveType>
                                                                        <resource href="AstralBombSummon.(ProjectileResource).xdb" />
                                                                    </projectileData>
                                                                    <isPersonalPool>true</isPersonalPool>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                    <tick>4000</tick>
                    <initialDelay>4000</initialDelay>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>