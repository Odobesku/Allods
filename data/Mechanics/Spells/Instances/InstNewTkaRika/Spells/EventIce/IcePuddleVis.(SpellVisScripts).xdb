<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
                <advanced>
                    <speed>0.75</speed>
                    <offendType>EVERYKEY_OFFEND</offendType>
                    <turnToTarget>NO_TURN</turnToTarget>
                </advanced>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectIce.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>4</scale>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectIce.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>4</scale>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <actionBarComplite type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/Ice_Spikes_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fixPoint>true</fixPoint>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarComplite>
</SpellVisScripts>