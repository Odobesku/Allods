<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>CLAMP</mode>
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<elements>
					<Item type="VisActionDelay">
						<time>1500</time>
					</Item>
					<Item type="CreatureSetTransparencyAction">
						<transparency>0</transparency>
						<priority>1</priority>
						<fadeMult>1</fadeMult>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Mobs/Warlock_In.(VisObjectTemplate).xdb" />
				<lifeTime>5</lifeTime>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Mobs/Warlock_Out.(VisObjectTemplate).xdb" />
				<offset z="1" />
				<scale>1.1</scale>
				<lifeTime>5</lifeTime>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>1000</time>
				</playWhile>
				<elements>
					<Item type="CreatureSetTransparencyAction">
						<transparency>0</transparency>
						<priority>1000</priority>
					</Item>
				</elements>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
