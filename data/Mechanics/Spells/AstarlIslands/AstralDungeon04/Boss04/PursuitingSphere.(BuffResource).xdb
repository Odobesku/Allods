<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739951945</resourceId>
	</Header>
	<Name href="PursuitingSphere.(BuffResource).Name.txt" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectNoAggroChecks" />
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="PursuitTarget.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="PursuitTarget.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.Disintegrate" />
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="/Mechanics/Spells/AstarlIslands/AstralDungeon04/Boss02/Pursuing.(Plane).xdb" />
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
