				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateFaction">
						<faction href="/World/Factions/League.xdb" />
					</Item>
				</predicates>
				<impacts>
					<Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
						<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
