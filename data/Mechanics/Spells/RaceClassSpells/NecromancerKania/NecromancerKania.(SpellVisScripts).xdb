<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<FXOnCaster>/Spells/FX/Spells/ReadySpellDirectDiseaseWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<LocatorOnCaster>Slot_Hand_L</LocatorOnCaster>
			<FXWand>/Spells/FX/Spells/ReadySpellDirectDiseaseWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXWand>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>1000</time>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FXOnCaster" />
						<effectAlias href="" />
						<locator var="LocatorOnCaster" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>InSequence</play>
		<playWhile type="VisActionDelay">
			<time>10000</time>
		</playWhile>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>instantSpellCastOmniWand</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx hrefvar="FXWand" />
								<effectAlias href="" />
								<fixPoint>true</fixPoint>
								<locator>Slot_Hand_L</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
