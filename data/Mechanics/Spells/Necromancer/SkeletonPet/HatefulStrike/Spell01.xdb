    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>false</ignoreGlobalCooldown>
    <launchWhenReady>false</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <stage>Launch</stage>
            <duration>5000</duration>
            <group href="" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <hideText>false</hideText>
                <mana>40</mana>
                <scaleByWeaponSpeed>false</scaleByWeaponSpeed>
                <source>Mainhand</source>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                <impactsOnHitTarget>
                    <Item type="gameMechanics.elements.impacts.ImpactsIf">
                        <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                            <buff href="/Mechanics/Abilities/NecromancerTalents/VampireStudent/DarkMark.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCasterMaster" />
                        </predicate>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                        <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                        <element>SHADOW</element>
                                                        <scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                                            <buff href="/Mechanics/Abilities/NecromancerTalents/VampireStudent/DarkMark.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                            <anyRank>true</anyRank>
                                                            <onlyFromMaster>true</onlyFromMaster>
                                                            <mul>1</mul>
                                                        </scalerTarget>
                                                        <damage>5.13</damage>
                                                        <impactsOnHitTarget>
                                                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                                                <impacts>
                                                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                                        <buff href="/Mechanics/Abilities/NecromancerTalents/VampireStudent/DarkMark.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                        <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                                                    </Item>
                                                                </impacts>
                                                            </Item>
                                                        </impactsOnHitTarget>
                                                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                            <scalers>
                                                                <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                                <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                    <mulCalcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
                                                                        <ability href="/Mechanics/Abilities/NecromancerTalents/VampireStudent/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                                                        <mul>1</mul>
                                                                    </mulCalcer>
                                                                </Item>
                                                            </scalers>
                                                        </scaler>
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsOnHitTarget>
                <scaleByDamageImpactsOnHit>false</scaleByDamageImpactsOnHit>
                <threatMultiplier>6</threatMultiplier>
                <avgDamage>34.2</avgDamage>
                <source>Mainhand</source>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <hideText>false</hideText>
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <hideText>false</hideText>
                                <buff href="/Mechanics/Spells/Necromancer/DarkMight/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <anyRank>true</anyRank>
                                <consumeStacks>0</consumeStacks>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <hideText>false</hideText>
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <hideText>false</hideText>
                                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <anyRank>true</anyRank>
                                    <consumeStacks>0</consumeStacks>
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <allowOverrideCaster>false</allowOverrideCaster>
                        <impactsOnAttach>
                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                                <hideText>false</hideText>
                                                <predicates>
                                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                        <hideText>false</hideText>
                                                        <buff href="/Mechanics/Spells/Necromancer/DarkMight/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                        <anyRank>true</anyRank>
                                                        <consumeStacks>0</consumeStacks>
                                                    </Item>
                                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                        <hideText>false</hideText>
                                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                            <hideText>false</hideText>
                                                            <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                            <anyRank>true</anyRank>
                                                            <consumeStacks>0</consumeStacks>
                                                        </predicate>
                                                    </Item>
                                                </predicates>
                                            </Item>
                                        </predicates>
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                <allowOverrideCaster>false</allowOverrideCaster>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnAttach>
                        <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mul>0.3</mul>
                            <mulCalcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                <buff href="/Mechanics/Spells/Necromancer/DarkMight/Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <forAllRanks>false</forAllRanks>
                            </mulCalcer>
                            <sum>1.2</sum>
                        </durationScaler>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>0</speed>
    <isAE>false</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>