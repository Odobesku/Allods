<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>226203</resourceId>
    </Header>
    <Name href="Spell01.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Bosses/UmoirRaid_GoblinTrioBoss/GoblinBossBooby_SelfDestruction.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>28000</prepareDuration>
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                <level>0.5</level>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Buff02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <channelingMechanics>
            <channelingBuff href="Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            <finishImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.DirectDamage">
                                    <damage>1</damage>
                                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                    </scalerTarget>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                            <table href="/Mechanics/RaidInstances/UmoirRaid/4_GoblinTrioBoss/GoblinBossSpawn.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>UR_GoblinRoomDoor_Enter</scriptID>
                                <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.device.DoorSwitch">
                                    <switchType>Open</switchType>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </finishImpacts>
        </channelingMechanics>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>