<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="CreatureAnimationAction">
            <mode>LOOP</mode>
            <animations>
                <Item>channelCastDirected</Item>
            </animations>
            <channel>CHANNEL_KNOCKDOWN</channel>
        </playWhile>
        <elements>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Spells/BattleStation_LightningRay.(VisObjectTemplate).xdb" />
                <fxLength>14</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>Slot_Hand_R</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </endPoint>
                <secondaryTargetParams>
                    <fxLength>20</fxLength>
                    <offendTime type="EffectOffendConstDelay" />
                </secondaryTargetParams>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>