<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXProjectile>/Spells/FX/Spells/AstralToxin.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<FXOnTargets />
			<CastAnimation>spellCastOmni</CastAnimation>
			<LocatorOnTargets>Slot_BodyFX</LocatorOnTargets>
			<ProjectileLocatorOnTarget>Slot_BodyFX</ProjectileLocatorOnTarget>
			<FxOnHands>/Spells/FX/Spells/ReadySpellDirectDisease.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<HitPostFXOnTargets />
			<LocatorOnCaster>Slot_FX</LocatorOnCaster>
			<FXProjectileHit>/Spells/FX/Spells/HitAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<Ge>0</Ge>
		</Variables>
	</Header>
	<actionBarStart />
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<scale>3</scale>
					</Item>
					<Item>
						<scale>3</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="CastAnimation" />
				</animations>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item type="VisActionList" />
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
