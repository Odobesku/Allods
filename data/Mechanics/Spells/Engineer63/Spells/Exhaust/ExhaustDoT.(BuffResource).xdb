<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739931751</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="ExhaustDoT.(BuffResource).Name.txt" />
    <Description href="ExhaustDoT.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/Exhaust.(UISingleTexture).xdb" />
    <visScript href="/Spells/BuffVisScripts/DoTPoison.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <damagePerTick>1</damagePerTick>
                <affectOnStartTick>true</affectOnStartTick>
                <affectedByDoubleAttack>true</affectedByDoubleAttack>
            </parameters>
            <element>POISON</element>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>0.2</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.VariableValueCalcer">
                                    <variable href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
                                    <mul>-0.01</mul>
                                    <sum>1</sum>
                                </Item>
                                <Item type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="externalCalcer" />
                                </Item>
                            </calcers>
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>0.25</multiplier>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </effects>
    <duration>10000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="ExhaustDoT01.(BuffResource).xdb" />
        <Item href="ExhaustDoT02.(BuffResource).xdb" />
        <Item href="ExhaustDoT03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Poisons.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>