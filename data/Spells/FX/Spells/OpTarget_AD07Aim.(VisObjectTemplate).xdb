<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound>
            <name></name>
        </sound>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>200</fadeInMS>
    <fadeOutMS>200</fadeOutMS>
    <geometry href="/Spells/FX/Spells/OpTarget_Aim.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)"/>
    <scale>1</scale>
    <sound>
        <name>World/Zones/AD07/warning</name>
        <project href="/SFX/World/World.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)"/>
    </sound>
    <states>
        <Item>
            <sound>
                <name></name>
            </sound>
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/Spells/OpTarget_Aim.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)"/>
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>
