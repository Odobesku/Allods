<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739881177</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/IMEpic.(UISingleTexture).xdb#xpointer(/UISingleTexture)"/>
    <itemMallDescription href="UniversalUpgraderUncommon60.(ItemResource).ItemMallDescription.txt"/>
    <source>FixedDrop</source>
    <descVars>
        <Item>
            <name>varfull</name>
            <text href="UniversalUpgraderUncommon60.(ItemResource).Text.txt"/>
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                    <rule href="/Mechanics/Rules/FullUniversalUpgrader60.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)"/>
                </condition>
            </scaler>
        </Item>
        <Item>
            <name>var</name>
            <text href="UniversalUpgraderUncommon60.(ItemResource).Text02.txt"/>
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                        <rule href="/Mechanics/Rules/FullUniversalUpgrader60.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)"/>
                    </predicate>
                </condition>
            </scaler>
        </Item>
    </descVars>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)"/>
    <functionalPart type="gameMechanics.constructor.schemes.item.meta.UltimateMetaUpgrader">
        <upgradeCondition type="gameMechanics.elements.item.ItemPredicateAnd">
            <predicates>
                <Item type="gameMechanics.elements.item.ItemPredicateLevel">
                    <range>
                        <max>60</max>
                    </range>
                </Item>
                <Item type="gameMechanics.elements.item.ItemPredicateNot">
                    <predicate type="gameMechanics.elements.item.ItemPredicateEnchant"/>
                </Item>
            </predicates>
        </upgradeCondition>
    </functionalPart>
    <requiredLevel>10</requiredLevel>
    <stackLimit>100</stackLimit>
    <quality href="/Mechanics/ItemQualities/Legendary.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)"/>
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
    </prices>
    <binding>BindOnPickup</binding>
    <lifeLengthCap>2592000000</lifeLengthCap>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="UniversalUpgraderUncommon60.(ItemResource).Name.txt"/>
    <description href="UniversalUpgraderUncommon60.(ItemResource).Description.txt"/>
    <category href="/Mechanics/ItemCategories/ItemMall.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)"/>
</gameMechanics.constructor.schemes.item.ItemResource>
