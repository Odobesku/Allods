	<effects>
		<Item type="gameMechanics.elements.effects.Enlarge">
			<factor>1.2</factor>
		</Item>
		<Item type="gameMechanics.elements.effects.WeaponSpeedMultiplier">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.33</coeff>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.SummandStat">
			<stat type="gameMechanics.elements.stat.InnateStat">
				<stat>Will</stat>
			</stat>
			<value>-50</value>
			<scaler type="gameMechanics.elements.scalers.LinearScaler">
				<multiplier>10</multiplier>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="/Mechanics/Spells/CommonBuffs/WillImmunity/Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="/Mechanics/Spells/CommonBuffs/WillImmunity/Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<duration>25000</duration>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
