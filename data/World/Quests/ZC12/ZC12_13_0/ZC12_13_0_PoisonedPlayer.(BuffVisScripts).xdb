<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/Otherworld.(UserPostEffect).xdb" />
			</Item>
			<Item type="Sound2DAction">
				<visActionID>sound</visActionID>
				<sound>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb" />
					<name>Ambience/PoisonedPlayer</name>
				</sound>
				<forcedSoundStop>true</forcedSoundStop>
				<musicSourceParameters />
				<resetGlobalParamsOnStop>false</resetGlobalParamsOnStop>
				<onlyForMainAvatar>true</onlyForMainAvatar>
			</Item>
		</elements>
		<stopOnDeath>true</stopOnDeath>
	</action>
	<postAction type="VisActionStopAction">
		<stoppedActionID>sound</stoppedActionID>
	</postAction>
</BuffVisScripts>
