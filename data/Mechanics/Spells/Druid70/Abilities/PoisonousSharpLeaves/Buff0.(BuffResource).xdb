<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739924115</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Ability0.(AbilityResource).Name.txt" />
	<Description href="Buff0.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Druid/DruidNaturalBalance.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.MagicDoT">
			<parameters>
				<scaleOnTick>true</scaleOnTick>
				<tickLength>1000</tickLength>
				<damagePerTick>1</damagePerTick>
				<impactsPerTick>
					<Item type="gameMechanics.elements.impacts.MarkedImpact">
						<mark href="/Mechanics/Spells/Druid70/Abilities/PoisonTornado/PoisonWatcher.(MarkResource).xdb" />
					</Item>
				</impactsPerTick>
				<affectedByDoubleAttack>true</affectedByDoubleAttack>
			</parameters>
			<element>POISON</element>
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mulCalcer type="constructor.elements.CalcerFloatExternal">
					<externalCalcer hrefvar="Calcer_Damage" />
				</mulCalcer>
				<additionalMultiplier>
					<scaler type="gameMechanics.elements.scalers.MagicScaler" />
				</additionalMultiplier>
			</scaler>
		</Item>
	</effects>
	<duration>1000</duration>
	<isStackable>false</isStackable>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<ranks>
		<Item href="Buff01.(BuffResource).xdb" />
		<Item href="Buff02.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
		<Item href="/Mechanics/Spells/Groups/DruidPoison.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
