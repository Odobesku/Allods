<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>222486</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
    </groups>
    <Name href="PowerStrike.(SpellSingleTarget).Name.txt" />
    <visualScripts href="PowerStrike.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <prepareDuration>2000</prepareDuration>
    <needLos>false</needLos>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChieftainBoss/SummonWarningVisual.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>7.5</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                <minDamage>50</minDamage>
                                <maxDamage>50</maxDamage>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterOr">
                            <filters>
                                <Item type="gameMechanics.world.creature.AvatarFilter" />
                                <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChampionMelee/ChampionMelee.(MobWorld).xdb" />
                                                <Item href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChampionRange/ChampionRange.(MobWorld).xdb" />
                                                <Item href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChampionShaman/ChampionShaman.(MobWorld).xdb" />
                                                <Item href="/Mechanics/Spells/IMTurret/LvL1Turret/LvL1Turret.xdb" />
                                                <Item href="/Mechanics/Spells/IMTurret/LvL2Turret/LvL2Turret.xdb" />
                                                <Item href="/Mechanics/Spells/IMTurret/Lvl3Turret/LvL3Turret.xdb" />
                                                <Item href="/Mechanics/Spells/IMTurret/LvL4Turret/LvL4Turret.xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                </Item>
                            </filters>
                        </filter>
                        <perTargetScaling>Divide</perTargetScaling>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>666</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="AOEHit.(ClientData).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                        <minDamage>25</minDamage>
                        <maxDamage>25</maxDamage>
                    </Item>
                </elseImpacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>