<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<advanced>
					<offendType>EVERYKEY_OFFEND</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>800</delay>
						<effectFx href="/Spells/FX/Mobs/Champions_BattleRoarAoe.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<scale>0.7</scale>
						<locator>Slot_Global</locator>
						<offset x="0" y="-4" z="-1" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<delay>800</delay>
						<effectFx href="/Spells/FX/Spells/HitIce.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_FX</locator>
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
