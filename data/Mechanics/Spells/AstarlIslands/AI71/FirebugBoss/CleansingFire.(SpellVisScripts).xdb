<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>150</time>
			</Item>
			<Item type="VisActionList">
				<playWhile type="VisActionDelay">
					<time>3000</time>
				</playWhile>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>specialAttack</Item>
						</animations>
						<advanced>
							<speed>1.6</speed>
						</advanced>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>250</delay>
								<effectFx href="/Spells/FX/Spells/PsionicPyrokinesisUpgrade.(VisObjectTemplate).xdb" />
								<fixPoint>true</fixPoint>
								<scale>1.5</scale>
								<fadeOutTime>500</fadeOutTime>
								<offendTime type="EffectOffendConstDelay">
									<delay>250</delay>
								</offendTime>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
