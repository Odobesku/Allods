<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>225385</resourceId>
    </Header>
    <Name href="FireFatality.(SpellCasterSelf).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Bosses/UmoirRaid/Guard_FatalityFire.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="FireFatality.(SpellCasterSelf).Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>0</value>
    </range>
    <prepareDuration>7000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>90000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="FireActivation.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>160</radius>
                <affectGroup>Enemies</affectGroup>
                <affectHolder>false</affectHolder>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/IceGuard/IceBallFreeze.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/IceGuard/IceBallFreeze.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/IceGuard/IceBallImmunity.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>FIRE</element>
                                <damage>50</damage>
                                <impactsOnHitTarget>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="FireStrike.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <stacks type="gameMechanics.elements.calcers.FloatData">
                                            <value>5</value>
                                        </stacks>
                                    </Item>
                                </impactsOnHitTarget>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                        </impactsElse>
                    </Item>
                </impacts>
                <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                    <filters>
                        <Item type="gameMechanics.world.creature.AliveFilter" />
                        <Item type="gameMechanics.world.creature.AvatarFilter" />
                    </filters>
                </filter>
            </Item>
            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>100</radius>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/IceGuard/IceBlock.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </mobs>
                                </Item>
                            </predicates>
                        </filter>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>