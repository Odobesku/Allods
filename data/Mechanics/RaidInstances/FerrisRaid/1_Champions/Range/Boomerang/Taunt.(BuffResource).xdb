<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739885708</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectForcedAggroLeader" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Target.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="PrePuller.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Target.(BuffResource).xdb" />
                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <affectGroup>Enemies</affectGroup>
                    <radius>3</radius>
                    <blinking>true</blinking>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                                <buff href="Target.(BuffResource).xdb" />
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="Taunt.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Target.(BuffResource).xdb" />
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/Shroud.xdb" />
                    </groups>
                </Item>
            </predicates>
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <ignoreLevelDelta>true</ignoreLevelDelta>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>