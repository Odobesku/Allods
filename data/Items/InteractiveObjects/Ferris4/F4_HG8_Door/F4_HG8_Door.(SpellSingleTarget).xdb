                                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                                    <unlock href="/Mechanics/Unlocks/Locations/HuntingGround8/HG8_PortalQuest.(UnlockResource).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                        <impactsIf>
