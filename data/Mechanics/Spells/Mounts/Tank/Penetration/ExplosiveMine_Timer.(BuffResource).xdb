<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>204281</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>20</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                    <value>1</value>
                                </Item>
                            </impactsIf>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="ExplosiveMine_Disorient.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.2</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.MountLevelCalcer">
                                    <mount href="/Mechanics/Mounts/6thGrade/Mounts/TankBase.(MountResource).xdb#xpointer(/gameMechanics.constructor.schemes.mount.MountResource)" />
                                </mulCalcer>
                                <sum>1</sum>
                            </durationScaler>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>500</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                        <resource href="ExplosiveMine_Bang.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>true</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>