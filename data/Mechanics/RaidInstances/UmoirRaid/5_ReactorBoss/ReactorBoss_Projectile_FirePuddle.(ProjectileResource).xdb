<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>225150</resourceId>
    </Header>
    <name href="ReactorBoss_Projectile_FirePuddle.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Mobs/ReactorBoss_01_DecalFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0.05</altitude>
    <lifeLengthCap>200000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <radius>4</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>FIRE</element>
                                    <damage>10</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>2000</initialDelay>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>