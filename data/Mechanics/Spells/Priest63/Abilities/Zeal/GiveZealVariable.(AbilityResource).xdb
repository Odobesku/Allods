                        <minuend type="gameMechanics.elements.calcers.CalcerVariableMaxValue">
                            <variable href="Zeal.(VariableResource).xdb" />
                        </minuend>
                        <subtrahend type="gameMechanics.elements.calcers.FloatData">
                            <value>1</value>
                        </subtrahend>
                    </value>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                            <lhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                                <calcer type="gameMechanics.elements.calcers.VariableValueCalcer">
                                                    <variable href="Faith.(VariableResource).xdb" />
                                                </calcer>
                                            </lhs>
                                            <rhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                                <calcer type="gameMechanics.elements.calcers.CalcerVariableMaxValue">
                                                    <variable href="Faith.(VariableResource).xdb" />
                                                </calcer>
                                            </rhs>
                                        </Item>
                                    </predicates>
