<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739922265</resourceId>
	</Header>
	<name href="R7_1_1_Add_Shield_HM.(AbilityResource).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="R7_1_1_Add_Shield_HM.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="R7_1_1_Add_Enrage_HM.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="R7_Drone_Stomping.(BuffResource).xdb" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="R7_Add_Neutral_Shield_Check.(BuffResource).xdb" />
							</predicate>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.map.destination.SelfPosDestination" />
								</moveType>
								<resource href="/Mechanics/RaidInstances/ArchBaseRaid/TrashPacks/RangerAndTank/DroneSelfdestructWarning.(ProjectileResource).xdb" />
							</projectileData>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>30</radius>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>LIGHTNING</element>
									<damage>40</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
								<radius>40</radius>
							</distributor>
							<data href="R7_Drone_SelfDestruction.(ClientData).xdb" />
						</Item>
					</impactsIf>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.Disintegrate" />
			</onLeave>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
