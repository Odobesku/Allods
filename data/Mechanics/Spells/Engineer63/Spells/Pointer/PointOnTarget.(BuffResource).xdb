<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>216050</resourceId>
    </Header>
    <Name href="PointOnTarget.(BuffResource).Name.txt" />
    <Description href="PointOnTarget.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/IMFireworkTarget.(UISingleTexture).xdb" />
    <visScript href="/Mechanics/Spells/HuntingGrounds/HuntingGround4/HG4_Boss_CrystalElem/Target.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EventTrigger">
            <conditionalEvents>
                <Item>
                    <obj>gameMechanics.elements.events.EventSpellLaunched</obj>
                    <predicate type="gameMechanics.elements.predicates.PredicateEventSpellLaunched">
                        <spell href="Pointer.(SpellSingleTarget).xdb" />
                    </predicate>
                </Item>
            </conditionalEvents>
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="PointOnTarget.(BuffResource).xdb" />
                </Item>
            </impacts>
            <eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>