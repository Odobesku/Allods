<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
	<Header>
		<resourceId>739821859</resourceId>
	</Header>
	<filter type="gameMechanics.world.creature.AvatarFilter" />
	<impactsIn>
		<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
			<spawn>
				<scriptID>SL_Boss1SpawnPoint</scriptID>
				<map href="/Maps/Inst_SecretLab/heroic_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
			</spawn>
			<onBehalfOfTarget>true</onBehalfOfTarget>
			<impacts>
				<Item type="gameMechanics.elements.impacts.AttachAbility">
					<ability href="PlaneHeroic_ScriptZone.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
			<zone href="PlaneHeroic.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
		</Item>
	</impactsIn>
	<considerAsWhole>true</considerAsWhole>
</gameMechanics.map.scriptZone.ScriptZone>
