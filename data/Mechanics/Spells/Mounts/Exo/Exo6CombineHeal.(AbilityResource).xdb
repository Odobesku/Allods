                                                            <delta type="gameMechanics.elements.calcers.FloatData">
                                                                <value>-1</value>
                                                            </delta>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
