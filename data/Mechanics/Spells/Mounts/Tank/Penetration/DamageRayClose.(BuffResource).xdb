<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739869043</resourceId>
    </Header>
    <Name href="DamageRayClose.(BuffResource).Name.txt" />
    <Description href="DamageRayClose.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Ships/HighEnergyConsume.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="SlowMovement.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="SlowMovement.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.PartiallyScaledMagicDamage">
                    <element>ASTRAL</element>
                    <damage>1</damage>
                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>0.05</mul>
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer href="/Mechanics/GameRoot/Mount/MountBaseDamageCalcer.(CalcerFloatResource).xdb#xpointer(/constructor.elements.CalcerFloatResource)" />
                        </mulCalcer>
                    </scaler>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>1000</initialDelay>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>