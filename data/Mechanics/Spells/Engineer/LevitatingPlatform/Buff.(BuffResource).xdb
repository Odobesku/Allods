<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>219817</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Buff.(BuffResource).Name.txt" />
    <Description href="Buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/PlatformDowngrade_sm.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Engineer/LevitatingPlatform.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
            <predicate type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                <group href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
            </predicate>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Jump</Item>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableSpellsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/EngineerLevitatingSpells.(ActionGroup).xdb" />
                <Item href="/Mechanics/Spells/Groups/FairySpells.xdb" />
                <Item href="/Mechanics/Spells/Groups/AlchemyPots.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
            <predicate type="gameMechanics.elements.predicates.PredicateIsMountAction" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/Knockdowns.xdb" />
                    </groups>
                </Item>
            </predicates>
            <removeExistingBuffs>false</removeExistingBuffs>
        </Item>
        <Item type="gameMechanics.elements.effects.Hover" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAuto.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.clientCommands.ImpactRideMount">
                            <mount href="/Mechanics/Mounts/6thGrade/Mounts/ExoMount01Base.(MountResource).xdb" />
                            <skin href="/Mechanics/Mounts/Skins/ExoMounts/ExoMount01Base.(MountSkin).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAutoRed.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.clientCommands.ImpactRideMount">
                            <mount href="/Mechanics/Mounts/6thGrade/Mounts/ExoMount01Base.(MountResource).xdb" />
                            <skin href="/Mechanics/Mounts/Skins/ExoMounts/ExoMount01Red.(MountSkin).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAutoGreen.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.clientCommands.ImpactRideMount">
                            <mount href="/Mechanics/Mounts/6thGrade/Mounts/ExoMount01Base.(MountResource).xdb" />
                            <skin href="/Mechanics/Mounts/Skins/ExoMounts/ExoMount01Green.(MountSkin).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAutoYellow.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.clientCommands.ImpactRideMount">
                            <mount href="/Mechanics/Mounts/6thGrade/Mounts/ExoMount01Base.(MountResource).xdb" />
                            <skin href="/Mechanics/Mounts/Skins/ExoMounts/IMExo.(MountSkin).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1TempSkinAutoYellow.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.clientCommands.ImpactRideMount">
                            <mount href="/Mechanics/Mounts/6thGrade/Mounts/IMExo.(MountResource).xdb" />
                            <skin href="/Mechanics/Mounts/Skins/ExoMounts/IMExo.(MountSkin).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>