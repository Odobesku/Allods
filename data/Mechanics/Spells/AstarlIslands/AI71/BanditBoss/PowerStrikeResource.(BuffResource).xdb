<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739936144</resourceId>
    </Header>
    <Name href="PowerStrikeResource.(BuffResource).Name.txt" />
    <Description href="PowerStrikeResource.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/FireElementalHeart.(UISingleTexture).xdb" />
    <visScript href="PowerStrikeResource.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                                    <level>0.5</level>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                                    <spell href="CrushingBlow.(SpellSingleTarget).xdb" />
                                    <duration>
                                        <hour>1</hour>
                                    </duration>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                                    <spell href="ChargeSpell.(SpellArea).xdb" />
                                    <duration>
                                        <second>2</second>
                                    </duration>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                    <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                        <range min="0" max="50" />
                                        <withinRange>true</withinRange>
                                        <minCandidatesCount>3</minCandidatesCount>
                                        <targetCount>3</targetCount>
                                    </selector>
                                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                                <predicates>
                                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                                    </Item>
                                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                </predicates>
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="ChargeTarget.(BuffResource).xdb" />
                                                </predicate>
                                            </Item>
                                        </predicates>
                                    </filter>
                                    <impacts>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="ChargeTarget.(BuffResource).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="ChargeResource.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>4</multiplier>
                                    </durationScaler>
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Phase2.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="PhaseChangeWatcher.(BuffResource).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>