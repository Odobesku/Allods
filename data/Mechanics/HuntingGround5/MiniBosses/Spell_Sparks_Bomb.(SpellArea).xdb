<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>248998</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/AcidSpells.xdb" />
    </groups>
    <Name href="Spell_Sparks_Bomb.(SpellArea).Name.txt" />
    <visualScripts href="/Mechanics/Spells/HuntingGrounds/HG2_Boss_MantisMage/Bomb00.(SpellVisScripts).xdb" />
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>16000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    </moveType>
                    <resource href="Sparks_Bomb_Attention_Projectile.(ProjectileResource).xdb" />
                </projectileData>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateCreature" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ACID</element>
                        <threatMultiplier>0</threatMultiplier>
                        <damage>40</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>