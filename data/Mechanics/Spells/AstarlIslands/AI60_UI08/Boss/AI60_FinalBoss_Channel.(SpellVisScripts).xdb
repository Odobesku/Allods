<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="CreatureAnimationAction">
			<mode>LOOP</mode>
			<animations>
				<Item>specialCast</Item>
			</animations>
			<channel>CHANNEL_DEATH</channel>
			<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
		</playWhile>
		<elements>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/TrinketChannelShadow.(VisObjectTemplate).xdb" />
				<startPoint type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
				<secondaryTargetParams>
					<offendTime type="EffectOffendConstDelay" />
				</secondaryTargetParams>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
