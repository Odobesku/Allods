<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>216555</resourceId>
    </Header>
    <Name href="StackBuff.(BuffResource).Name.txt" />
    <Description href="StackBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Mace/MaceCarpenter.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.constructor.basicElements.HighStackEffect">
                    <effect type="gameMechanics.elements.effects.SpellExtraImpacts">
                        <casterImpacts>
                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                        <buff href="StackBuff.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </casterImpacts>
                        <targetImpacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                                <durationScaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                    <scalers>
                                        <Item type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                            <buff href="StackBuff.(BuffResource).xdb" />
                                            <anyRank>true</anyRank>
                                            <onlyFromMaster>true</onlyFromMaster>
                                            <mul>1</mul>
                                        </Item>
                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
                                                <ability href="Root01.(AbilityResource).xdb" />
                                                <mul>0.25</mul>
                                            </mulCalcer>
                                        </Item>
                                    </scalers>
                                </durationScaler>
                            </Item>
                        </targetImpacts>
                        <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                            <spells>
                                <Item href="/Mechanics/Spells/War63/Spells/PowerAttack/Spell03.(SpellSingleTarget).xdb" />
                                <Item href="/Mechanics/Spells/War63/Spells/PowerAttackUpgrade/Spell03.(SpellSingleTarget).xdb" />
                            </spells>
                        </destination>
                    </effect>
                    <stackCountTrigger>5</stackCountTrigger>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>10000</duration>
    <stackLimit>10</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>