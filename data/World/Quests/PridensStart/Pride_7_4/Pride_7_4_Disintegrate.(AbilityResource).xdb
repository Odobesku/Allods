<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>309992</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>5000</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impactsIf>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Pride_7_4_GhostPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            <personalPlane>true</personalPlane>
        </Item>
        <Item type="gameMechanics.elements.effects.AddParticularVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Outgoing</vector>
                <direction>Outgoing</direction>
                <plane href="Pride_7_4_GhostPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
            <resolventsFor>
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCasterPet" />
            </resolventsFor>
        </Item>
        <Item type="gameMechanics.elements.effects.AddParticularVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Outgoing</direction>
                <plane href="Pride_7_4_GhostPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
            <resolventsFor>
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCasterPet" />
            </resolventsFor>
        </Item>
        <Item type="gameMechanics.elements.effects.AddParticularVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Outgoing</direction>
                <plane href="Pride_7_4_GhostPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
            <resolventsFor>
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCasterPet" />
            </resolventsFor>
        </Item>
        <Item type="gameMechanics.elements.effects.AddParticularVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Incoming</vector>
                <direction>Incoming</direction>
                <plane href="Pride_7_4_GhostPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
            <resolventsFor>
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCasterPet" />
            </resolventsFor>
        </Item>
        <Item type="gameMechanics.elements.effects.AddParticularVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Incoming</vector>
                <direction>Incoming</direction>
                <plane href="Pride_7_4_GhostPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
            <resolventsFor>
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCasterPet" />
            </resolventsFor>
        </Item>
        <Item type="gameMechanics.elements.effects.AddParticularVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Incoming</vector>
                <direction>Incoming</direction>
                <plane href="Pride_7_4_GhostPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
            <resolventsFor>
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                <Item type="gameMechanics.elements.addresseeFinders.AddresseeFinderCasterPet" />
            </resolventsFor>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>