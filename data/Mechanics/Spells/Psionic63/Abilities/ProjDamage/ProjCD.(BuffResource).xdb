    <image href="/Interface/Icons/Spells/Psionic/PsionicDominate.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                                    <spell href="/Mechanics/Spells/Psionic63/Spells/Projection/Spell01.(SpellSingleTarget).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="ProjCD.(BuffResource).xdb" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Psionic63/Spells/Projection/Spell03.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Launch</Item>
            </stages>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateSpellCooldownReady">
                                            <spell href="/Mechanics/Spells/Psionic63/Spells/Projection/Spell01.(SpellSingleTarget).xdb" />
                                            <checkNonGlobalOnly>true</checkNonGlobalOnly>
                                        </Item>
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                                            <spell href="/Mechanics/Spells/Psionic63/Spells/Projection/Spell01.(SpellSingleTarget).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.StackBuff">
                                            <buff href="ProjCD.(BuffResource).xdb" />
                                            <delta type="gameMechanics.elements.calcers.FloatData">
                                                <value>-1</value>
                                            </delta>
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>8000</duration>
    <stackLimit>3</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>