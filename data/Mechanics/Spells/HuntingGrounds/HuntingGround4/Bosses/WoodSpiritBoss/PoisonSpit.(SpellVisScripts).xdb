<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>rangedAttack</Item>
        </animations>
    </actionBarStart>
    <launch type="CreatureProjectileAction">
        <projectileFx href="/Spells/FX/Spells/Umoir_Acid_Shot.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
        <explosionFx href="/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
        <pointOnCaster type="VisPointLocator">
            <locator>Slot_Mouth</locator>
        </pointOnCaster>
        <pointOnTarget type="VisPointLocator">
            <locator>Slot_FX</locator>
        </pointOnTarget>
    </launch>
</SpellVisScripts>