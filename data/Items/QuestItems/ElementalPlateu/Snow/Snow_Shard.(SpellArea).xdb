	<image href="/Interface/Icons/Misc/Itemmall/IMFireworkLantern01.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualScripts href="/Items/QuestItems/ElementalPlateu/FireEssence/FireEssence.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>6</value>
	</range>
	<prepareDuration>2000</prepareDuration>
	<targetType>STTPoint</targetType>
	<iffPolicy>Everyone</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>5000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateInZone">
