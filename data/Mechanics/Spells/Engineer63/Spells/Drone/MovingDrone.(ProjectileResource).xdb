<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739932217</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="MovingDrone.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Mobs/Engineer63_DronRun.(VisObjectTemplate).xdb" />
    <altitude>0.05</altitude>
    <speed>0.0065</speed>
    <lifeLengthCap>10000</lifeLengthCap>
    <impactsOnHit>
