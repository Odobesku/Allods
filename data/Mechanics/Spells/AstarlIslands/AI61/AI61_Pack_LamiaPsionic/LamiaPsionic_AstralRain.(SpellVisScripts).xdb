<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXProjectile>/Spells/FX/Spells/EssenceThought_Psionic_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<FXOnTargets />
			<CastAnimation>spellCastDirected</CastAnimation>
			<FXOnCaster />
			<LocatorOnTargets>Slot_BodyFX</LocatorOnTargets>
			<FXProjectileHit>/Spells/FX/Spells/HitAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<ProjectileLocatorOnTarget>Slot_BodyFX</ProjectileLocatorOnTarget>
			<Ge>9</Ge>
			<FxOnHands>/Spells/FX/Spells/ReadySpellDirectAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<MulyProjectile>true</MulyProjectile>
			<LocatorOnCaster>Slot_Hand_L</LocatorOnCaster>
			<PreCastAnimation>ready</PreCastAnimation>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item skiped="" />
					<Item type="VisActionList">
						<playWhile type="VisActionDelay">
							<time>1000</time>
						</playWhile>
						<elements>
							<Item type="CreatureVisObjectComponentsAction">
								<visObjComponents>
									<Item type="AttachedVisObjectComponent">
										<visObject href="/Spells/FX/Spells/ReadySpellDirectAstralWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<scale>0.5</scale>
										<locatorName>Slot_Hand_L</locatorName>
									</Item>
								</visObjComponents>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
