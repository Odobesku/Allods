<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Spells/StalkerCamouflageAbility.(VisObjectTemplate).xdb" />
				<isRelative>true</isRelative>
				<lifeTime>3</lifeTime>
			</Item>
			<Item type="CreatureSetTransparencyAction">
				<transparency>0.5</transparency>
			</Item>
			<Item type="CreatureReplaceAnimationsAction">
