<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>205038</resourceId>
    </Header>
    <Name href="Buff_Name.txt" />
    <Description href="Buff_Desc.txt" />
    <image href="/Interface/Icons/Misc/Quest/AstralEssence.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>80</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value>100</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>ManaLevelScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <effects>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatResistance">
                <element>EDIVINE</element>
            </stat>
            <multiplier>0.9</multiplier>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>ASTRAL</element>
                    <threatMultiplier>1</threatMultiplier>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler"></scaler>
                    <damage>80</damage>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <hideText>false</hideText>
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <hideText>false</hideText>
                                <buff href="Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <anyRank>true</anyRank>
                                <consumeStacks>0</consumeStacks>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <allowOverrideCaster>false</allowOverrideCaster>
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
                        <radius>85</radius>
                    </distributor>
                    <data href="/Spells/ClientData/HitContactBreak.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.IncrementMana">
                    <manaType>Mana</manaType>
                    <amount>-100</amount>
                    <threatMultiplier>1</threatMultiplier>
                    <scaler type="gameMechanics.elements.scalers.ManaLevelScaler" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar">
                            <hideText>false</hideText>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.IncrementMana">
                            <manaType>Energy</manaType>
                            <amount>-40</amount>
                            <threatMultiplier>1</threatMultiplier>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.IncrementMana">
                            <manaType>Energy</manaType>
                            <amount>-10</amount>
                            <threatMultiplier>1</threatMultiplier>
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOff>
            <rerunOnLoad>false</rerunOnLoad>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectIfOverTime">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <hideText>false</hideText>
                    <buff href="Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <anyRank>true</anyRank>
                    <consumeStacks>0</consumeStacks>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                    <anyRank>true</anyRank>
                </Item>
            </impactsIf>
            <runImpactsOnEachTick>true</runImpactsOnEachTick>
            <affectOnStartTick>false</affectOnStartTick>
            <tick type="gameMechanics.elements.calcers.FloatData">
                <value>1500</value>
            </tick>
        </Item>
    </effects>
    <duration>1</duration>
    <isStackable>false</isStackable>
    <stackLimit>1</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>false</isHelpful>
    <isDetachableOnWill>false</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>