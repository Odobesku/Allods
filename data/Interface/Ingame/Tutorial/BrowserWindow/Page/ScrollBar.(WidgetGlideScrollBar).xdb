<?xml version="1.0" encoding="UTF-8" ?>
<WidgetGlideScrollBar>
	<Name>PageScrollBar</Name>
	<BackLayer href="/Interface/Ingame/Contextructor/ScrollBar/textures/ScrollVertical.(WidgetLayerTiledTexture).xdb#xpointer(/WidgetLayerTiledTexture)" />
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_HIGH</Align>
			<Pos>0</Pos>
			<HighPos>-2</HighPos>
			<Size>24</Size>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>3</Pos>
			<HighPos>-10</HighPos>
			<Size>0</Size>
		</Y>
	</Placement>
	<PickChildrenOnly>true</PickChildrenOnly>
	<clipContent>false</clipContent>
	<decButton href="ScrollDec.(WidgetButton).xdb#xpointer(/WidgetButton)" />
	<incButton href="ScrollInc.(WidgetButton).xdb#xpointer(/WidgetButton)" />
	<slider href="Slider.(WidgetGlideSlider).xdb#xpointer(/WidgetGlideSlider)" />
</WidgetGlideScrollBar>
