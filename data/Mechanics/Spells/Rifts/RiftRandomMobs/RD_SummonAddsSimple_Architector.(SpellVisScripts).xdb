<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellOmni</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Architect_Swarm_ReadySpellHand.(VisObjectTemplate).xdb" />
                        <scale>2</scale>
                        <locator>Slot_FX</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="CreatureAnimationAction">
        <animations>
            <Item>spellCastOmni</Item>
        </animations>
        <channel>CHANNEL_ATTACK</channel>
    </launch>
</SpellVisScripts>