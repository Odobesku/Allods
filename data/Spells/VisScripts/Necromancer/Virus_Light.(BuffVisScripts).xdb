<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionLoopAction">
    <actionToLoop type="client.Replica.VisActionList">
      <elements>
        <Item type="client.Replica.CreatureEffectsAction">
          <category>EFFECT_DEFAULT</category>
          <visualEffects>
            <Item>
              <delay>0</delay>
              <effectAnimations>
                <mode>DIE</mode>
              </effectAnimations>
              <effectFx href="/Spells/FX/Spells/HitDisease_01.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
              <fadeInTime>0</fadeInTime>
              <fadeOutTime>0</fadeOutTime>
              <scale>1.3</scale>
              <fixPoint>false</fixPoint>
              <lockScale>true</lockScale>
              <muteFxSounds>false</muteFxSounds>
              <ignoreParentRotation>true</ignoreParentRotation>
              <locator>Global</locator>
              <member>Default_Member</member>
              <offset x="0" y="0" z="0" />
              <rotation x="0" y="0.799999952" z="0" w="0" />
              <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
            </Item>
          </visualEffects>
          <dontFade>false</dontFade>
          <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
          <stopOnDeath>false</stopOnDeath>
        </Item>
      </elements>
      <play>Simultaneously</play>
      <playWhile type="client.Replica.VisActionDelay">
        <time>1000</time>
      </playWhile>
      <preconditional>false</preconditional>
      <restartOnVisualChange>false</restartOnVisualChange>
      <stopOnDeath>false</stopOnDeath>
      <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </actionToLoop>
    <repeat>0</repeat>
    <totalTime>0</totalTime>
  </action>
  <postAction type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.CreatureEffectsAction">
        <category>EFFECT_DEFAULT</category>
        <visualEffects>
          <Item>
            <delay>0</delay>
            <effectAnimations>
              <mode>DIE</mode>
            </effectAnimations>
            <effectFx href="/Spells/FX/Spells/NecromancerBloodPlague_Dot.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <fadeInTime>0</fadeInTime>
            <fadeOutTime>0</fadeOutTime>
            <scale>1.19999993</scale>
            <fixPoint>false</fixPoint>
            <lockScale>false</lockScale>
            <muteFxSounds>false</muteFxSounds>
            <ignoreParentRotation>false</ignoreParentRotation>
            <locator>Global</locator>
            <member>Default_Member</member>
            <offset x="0" y="0" z="0" />
            <rotation x="0" y="-0.299999982" z="0" w="0" />
            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
          </Item>
        </visualEffects>
        <dontFade>false</dontFade>
        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
        <stopOnDeath>false</stopOnDeath>
