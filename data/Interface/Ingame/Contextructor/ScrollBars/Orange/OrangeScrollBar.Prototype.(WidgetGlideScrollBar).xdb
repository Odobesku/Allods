<?xml version="1.0" encoding="UTF-8" ?>
<WidgetGlideScrollBar>
	<Header>
		<isPrototype>true</isPrototype>
	</Header>
	<Name>ScrollBar</Name>
	<BackLayer href="ScrollBack.(WidgetLayerTiledTexture).xdb#xpointer(/WidgetLayerTiledTexture)" />
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_HIGH</Align>
			<Pos>0</Pos>
			<HighPos>7</HighPos>
			<Size>30</Size>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>5</Pos>
			<HighPos>5</HighPos>
		</Y>
	</Placement>
	<decButton href="ScrollUp.(WidgetButton).xdb#xpointer(/WidgetButton)" />
	<incButton href="ScrollDown.(WidgetButton).xdb#xpointer(/WidgetButton)" />
	<slider href="Slider.(WidgetGlideSlider).xdb#xpointer(/WidgetGlideSlider)" />
</WidgetGlideScrollBar>
