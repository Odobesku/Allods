<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
	<Header>
		<resourceId>739933019</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateFaction">
					<faction href="/World/Factions/Empire.xdb" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.QuestCounterTrigger">
					<quest href="/Mechanics/EventsAndActions/Anniversary6/Quests/1Stage_Tame_E.(QuestResource).xdb" />
					<counterId href="/Mechanics/EventsAndActions/Anniversary6/Demons/1Stage_Tame.(QuestCountId).xdb" />
					<condition type="constructor.elements.LongEquals">
						<value>5</value>
					</condition>
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="/Mechanics/EventsAndActions/Anniversary6/Quests/Visibility.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</effectsIf>
			<effectsElse>
				<Item type="gameMechanics.elements.effects.EffectsIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateFaction">
							<faction href="/World/Factions/League.xdb" />
						</Item>
					</predicates>
					<effectsIf>
						<Item type="gameMechanics.elements.effects.QuestCounterTrigger">
							<quest href="/Mechanics/EventsAndActions/Anniversary6/Quests/1Stage_Tame_L.(QuestResource).xdb" />
							<counterId href="/Mechanics/EventsAndActions/Anniversary6/Demons/1Stage_Tame.(QuestCountId).xdb" />
							<condition type="constructor.elements.LongEquals">
								<value>5</value>
							</condition>
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="/Mechanics/EventsAndActions/Anniversary6/Quests/Visibility.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</effectsIf>
				</Item>
			</effectsElse>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>