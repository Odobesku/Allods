<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>488464</resourceId>
    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateGenericAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateRecapturableState">
                            <state>Captured</state>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateRecapturableOwner">
                            <owner href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactUpdateEventAchievementGeneric">
                            <achievement href="/Mechanics/InstancedEventResource/MWRaid_01/MegaWarRaid_01.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
                            <summand type="gameMechanics.elements.calcers.FloatData">
                                <value>30</value>
                            </summand>
                            <mark href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummandGeneric">
                    <variable href="/Mechanics/MegaWar/Variables/PointsCaptured2ndRound.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <summand>1</summand>
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateRecapturableState">
                            <state>UnderAssault</state>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <radius>85</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Mechanics/MWRaid/MWRaid_TurretRed01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                <Item href="/Mechanics/MWRaid/MWRaid_TurretBlue01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllAggro" />
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/MWRaid/MWRaid_TurretDebuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.MobFilter" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateRecapturableState">
                            <state>Free</state>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <radius>85</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Mechanics/MWRaid/MWRaid_TurretRed01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                <Item href="/Mechanics/MWRaid/MWRaid_TurretBlue01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="/Mechanics/MWRaid/MWRaid_TurretDebuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.MobFilter" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsElse>
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>