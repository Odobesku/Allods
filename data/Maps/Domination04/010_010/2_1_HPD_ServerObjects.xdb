			<achievementResource href="/Mechanics/InstancedEventResource/MM_BG04/MM_BG04.(BattleEventAchievementResource).xdb" />
			<achievementCount type="gameMechanics.elements.calcers.LongData">
				<value>1</value>
			</achievementCount>
			<periodicUpdateTick>1000</periodicUpdateTick>
		</Item>
