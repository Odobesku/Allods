<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>214906</resourceId>
    </Header>
    <element>ACID</element>
    <Name href="Aoe_Swip.(SpellArea).Name.txt" />
    <visualScripts href="/Mechanics/Spells/HuntingGrounds/HG_AciderKick.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                <time>500</time>
                <impactsOnLand>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Aoe_Swip_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsOnLand>
                <distance>5</distance>
            </Item>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                <minDamage>40</minDamage>
                <maxDamage>40</maxDamage>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>45</value>
        </angle>
    </shape>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>