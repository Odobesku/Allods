                <Item href="/Mechanics/Ships/Rudder/Remote/RudderRight.(SpellCasterSelf).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <Item href="/Mechanics/Ships/Rudder/Remote/RudderFullRight.(SpellCasterSelf).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <Item href="/Mechanics/Ships/Engine/Remote/Speed3.(SpellCasterSelf).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <Item href="/Mechanics/Ships/Engine/Remote/Speed2.(SpellCasterSelf).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <Item href="/Mechanics/Ships/Engine/Remote/Speed1.(SpellCasterSelf).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
