<?xml version="1.0" encoding="UTF-8"?>
<VisObjectTemplate>
	<defaultState>
		<sound>
			<creationRadius>-1</creationRadius>
			<project href="" />
		</sound>
		<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
		<playSoundOnKeys>true</playSoundOnKeys>
		<animation href="" />
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>200</fadeInMS>
	<fadeOutMS>500</fadeOutMS>
	<geometry href="WarriorWhirlwind.(Geometry).xdb#xpointer(/Geometry)" />
	<particle href="" />
	<questHighlight href="" />
	<replaceDistance>-1</replaceDistance>
	<replacement href="" />
	<scale>1.2</scale>
	<sound>
		<creationRadius>-1</creationRadius>
		<name>spells/Warrior/WarriorWhirlwind</name>
		<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
	</sound>
	<states>
		<Item>
			<sound>
				<creationRadius>-1</creationRadius>
				<project href="" />
			</sound>
			<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
			<playSoundOnKeys>true</playSoundOnKeys>
			<animation href="WarriorWhirlwind.(SkeletalAnimation).xdb#xpointer(/SkeletalAnimation)" />
			<isNecessaryAnim>false</isNecessaryAnim>
		</Item>
	</states>
	<visObjComponents>
		<Item type="client.Scene.DelayComponent">
			<component type="client.Scene.AttachedVisObjectComponent">
				<locatorName>VisualSceneNode</locatorName>
				<offset x="0" y="0" z="0" />
				<priority>0</priority>
				<rotation x="0" y="0" z="0" w="1" />
				<scale>1.2</scale>
				<visObject href="WarriorWhirlwind_Part.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
				<isPortraitEnabled>true</isPortraitEnabled>
				<lockScale>false</lockScale>
				<scaleFromGlobal>false</scaleFromGlobal>
				<skipSound>false</skipSound>
			</component>
			<timeMax>0.2</timeMax>
			<timeMin>0.2</timeMin>
			<skipLoading>true</skipLoading>
		</Item>
		<Item type="client.Scene.VisualSettingsComponent">
			<fogFactor>-1</fogFactor>
			<lods>
				<Item>
					<autoLevel>0</autoLevel>
					<maxDistance>40</maxDistance>
					<minDistance>40</minDistance>
					<visObject href="WarriorWhirlwind_LOD2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				</Item>
			</lods>
			<maxSettings>
				<fadeDistanceEnd>90</fadeDistanceEnd>
				<fadeDistanceStart>80</fadeDistanceStart>
			</maxSettings>
			<minSettings>
				<fadeDistanceEnd>90</fadeDistanceEnd>
				<fadeDistanceStart>80</fadeDistanceStart>
			</minSettings>
			<lodsUniformScaling>true</lodsUniformScaling>
			<sizeIndependentFade>false</sizeIndependentFade>
		</Item>
	</visObjComponents>
	<drawBehindCamera>false</drawBehindCamera>
	<softReplace>false</softReplace>
