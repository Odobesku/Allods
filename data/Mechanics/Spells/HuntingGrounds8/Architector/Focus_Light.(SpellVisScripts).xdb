<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellSimple.(VisObjectTemplate).xdb" />
                        <scale>0.8</scale>
                        <locator>Slot_FX</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <visActionID>effchn</visActionID>
                <channelingFx href="/Spells/FX/Mobs/UmoirMirrorBoss_Ray.(VisObjectTemplate).xdb" />
                <startPoint type="VisPointLocator">
                    <shift />
                    <locator>Slot_FX</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </endPoint>
                <velocity>40</velocity>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirectedWand</Item>
                </animations>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>4625</time>
                    </Item>
                    <Item type="VisActionStopAction">
                        <stoppedActionID>effchn</stoppedActionID>
                    </Item>
                </elements>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>