<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>221831</resourceId>
    </Header>
    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
        <predicates>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
        </predicates>
    </filter>
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>14_SoldierBoss</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Combination/LockDifficulty.(BuffResource).xdb" />
                                            <stacks type="gameMechanics.elements.calcers.FloatData">
                                                <value>3</value>
                                            </stacks>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Combination/LockDifficulty.(BuffResource).xdb" />
                                            <stacks type="gameMechanics.elements.calcers.FloatData">
                                                <value>2</value>
                                            </stacks>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </impactsIn>
    <impactsOut>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="Combination/LockDifficulty.(BuffResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="Hacker_A_Succeeded.(BuffResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="Hacker_B_Succeeded.(BuffResource).xdb" />
        </Item>
    </impactsOut>
</gameMechanics.map.scriptZone.ScriptZone>