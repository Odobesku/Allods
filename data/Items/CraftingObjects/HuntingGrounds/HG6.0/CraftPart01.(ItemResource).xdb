<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739901356</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<image href="/Interface/Icons/Misc/Crafting/Kindling12.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<source>FixedDrop</source>
	<forceShowQuality>true</forceShowQuality>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.RepeatStackTakeAction">
						<actions>
							<Item type="itemService.avatar.itemBag.RandomTakeAction">
								<entries>
									<Item>
										<actions>
											<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
												<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
													<item hrefvar="item1" />
												</item>
												<modifiers>
													<Item type="itemService.avatar.itemBag.TransferCurseModifier" />
												</modifiers>
											</Item>
										</actions>
									</Item>
									<Item>
										<actions>
											<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
												<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
													<item hrefvar="item2" />
												</item>
												<modifiers>
													<Item type="itemService.avatar.itemBag.TransferCurseModifier" />
												</modifiers>
											</Item>
										</actions>
									</Item>
									<Item>
										<actions>
											<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
												<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
													<item hrefvar="item3" />
												</item>
												<modifiers>
													<Item type="itemService.avatar.itemBag.TransferCurseModifier" />
												</modifiers>
											</Item>
										</actions>
									</Item>
								</entries>
							</Item>
						</actions>
					</Item>
				</actions>
				<consumeItems>100</consumeItems>
			</Item>
		</usages>
		<useStack>true</useStack>
	</functionalPart>
	<stackLimit>10000</stackLimit>
	<quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
	<prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
	<binding>BindOnPickup</binding>
	<name href="CraftPart01.(ItemResource).Name02.txt" />
	<description href="CraftPart01.(ItemResource).Description02.txt" />
</gameMechanics.constructor.schemes.item.ItemResource>
