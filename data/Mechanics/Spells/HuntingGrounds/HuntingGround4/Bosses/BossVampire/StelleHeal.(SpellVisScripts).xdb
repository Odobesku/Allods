<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialCast</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/NecromancerBloodshieldAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/TrinketChannelShadow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<startPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/HitShadow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
