									<id href="CountId_1.xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
									<value>-1</value>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
			<impactsOnLeave>
