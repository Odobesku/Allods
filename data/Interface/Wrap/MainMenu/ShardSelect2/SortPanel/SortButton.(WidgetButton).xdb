<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>Button</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <Size>50</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <Size>50</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>sort_button_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag>label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Wrap/MainMenu/ShardSelect2/SortPanel/SortButtonHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="1" y="1"/>
            <Reaction>sort_button_pressed</Reaction>
            <ReactionRightClick>sort_button_pressed</ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Wrap/MainMenu/ShardSelect2/RelatedTexts/SortButtonDisabled.txt"/>
            </StateDisabled>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Wrap/MainMenu/ShardSelect2/RelatedTexts/SortButton.txt"/>
                <LayerMain href="/Interface/Wrap/MainMenu/ShardSelect2/SortPanel/SortButtonNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Wrap/MainMenu/ShardSelect2/SortPanel/SortButtonPressed.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Wrap/MainMenu/ShardSelect2/RelatedTexts/SortButtonLabel.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
