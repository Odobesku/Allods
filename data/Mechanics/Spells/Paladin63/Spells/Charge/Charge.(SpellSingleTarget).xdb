<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>206695</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
        <Item href="/Mechanics/Spells/Groups/SpeedBoosts.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="Charge.(SpellSingleTarget).Name.txt" />
    <Description href="Charge.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>WeaponScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Paladin/PaladinBladeJustice.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Paladin/BladeOfJustice.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Charge01.(SpellSingleTarget).xdb" />
        <Item href="Charge02.(SpellSingleTarget).xdb" />
        <Item href="Charge03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateUsesWeapon" />
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/DisableMovement.(ActionGroup).xdb" />
                    </groups>
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff hrefvar="buff" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsIf">
                <predicate type="gameMechanics.elements.predicates.PredicateDistance">
                    <range min="0" max="8" />
                </predicate>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="MeleeChargeTrigger.(BuffResource).xdb" />
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>