<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>194283</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DirectHeal">
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="gameMechanics.elements.calcers.FullHealthCalcer">
                                            <multiplier>0.01</multiplier>
                                        </Item>
                                        <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                            <buff href="HealthBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <forAllRanks>true</forAllRanks>
                                        </Item>
                                    </calcers>
                                </mulCalcer>
                            </scalerTarget>
                            <heal>1</heal>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>12000</tick>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>