<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>ready</PreCastAnimation>
			<FxOnHands>/Spells/FX/Mobs/DustGround.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<FXOnCaster />
			<CastAnimation>specialAttack</CastAnimation>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<LocatorNameOnCaster>Slot_Special91</LocatorNameOnCaster>
			<FXOnTargets />
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item skiped="" />
			<Item type="ProceduralEffectVisAction">
				<timeOff>0.33</timeOff>
				<timeOn>0.33</timeOn>
				<proceduralEffect href="Charging.(ProceduralEffect).xdb#xpointer(/ProceduralEffect)" />
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>1666</delay>
						<effectFx hrefvar="FxOnHands" />
						<scale>2</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special92</locatorName>
					</Item>
					<Item>
						<delay>1666</delay>
						<effectFx hrefvar="FxOnHands" />
						<effectAlias href="" />
						<scale>2</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special93</locatorName>
						<offendTime />
					</Item>
					<Item>
						<delay>2000</delay>
						<effectFx hrefvar="FxOnHands" />
						<effectAlias href="" />
						<scale>2</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special92</locatorName>
						<offendTime />
					</Item>
					<Item>
						<delay>2000</delay>
						<effectFx hrefvar="FxOnHands" />
						<effectAlias href="" />
						<scale>2</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special93</locatorName>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx hrefvar="FXOnCaster" />
								<scale>1</scale>
								<locator var="LocatorOnCaster" />
								<locatorName var="LocatorNameOnCaster" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
