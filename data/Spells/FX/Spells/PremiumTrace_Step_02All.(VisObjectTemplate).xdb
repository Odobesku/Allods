<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>300</fadeInMS>
    <fadeOutMS>300</fadeOutMS>
    <geometry href="/Spells/FX/Spells/PremiumTrace_Step_02All.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <scale>0.4</scale>
    <sound />
    <visObjComponents>
        <Item type="EmitterVisObjComponent">
            <delay>0</delay>
            <locatorName>Slot_Special01</locatorName>
            <maxAngles x="0" y="0" z="0" />
            <maxScale>1</maxScale>
            <minAngles x="0" y="0" z="0" />
            <minScale>1</minScale>
            <offset x="0.5" y="0.5" z="0" />
            <rate>2</rate>
            <visObjects>
                <Item href="/Spells/FX/Spells/PremiumTrace_Step_02L.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            </visObjects>
            <fixedPoint>true</fixedPoint>
        </Item>
        <Item type="DelayComponent">
            <component type="EmitterVisObjComponent">
                <delay>0</delay>
                <locatorName>Slot_Special01</locatorName>
                <maxAngles x="0" y="0" z="0" />
                <maxScale>1</maxScale>
                <minAngles x="0" y="0" z="0" />
                <minScale>1</minScale>
                <offset x="-0.5" y="-0.5" z="0" />
                <rate>2</rate>
                <visObjects>
                    <Item href="/Spells/FX/Spells/PremiumTrace_Step_02R.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                </visObjects>
                <fixedPoint>true</fixedPoint>
            </component>
            <timeMax>0.25</timeMax>
            <timeMin>0.25</timeMin>
            <skipLoading>true</skipLoading>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
