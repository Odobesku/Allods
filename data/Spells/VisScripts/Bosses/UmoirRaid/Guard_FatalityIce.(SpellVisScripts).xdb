<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityIce_Precast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.8</scale>
						<fadeInTime>2000</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<locator>Slot_Global</locator>
					</Item>
					<Item>
						<delay>200</delay>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityIce_PrecastHands.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<scale>2</scale>
						<fadeInTime>200</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special01</locatorName>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>special</Item>
					<Item>readySpellOmni</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>7300</time>
		</playWhile>
		<preconditional>true</preconditional>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>200</delay>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityIce_Precast01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<fadeOutTime>300</fadeOutTime>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Spear</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_AOE_FatalityIce.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<scale>0.95</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
