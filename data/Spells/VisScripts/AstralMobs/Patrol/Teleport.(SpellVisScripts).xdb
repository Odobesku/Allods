<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectLightning_AstralMobs.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<scale>1.5</scale>
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectLightning_AstralMobs.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<scale>1.5</scale>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="CreatureAnimationAction">
		<animations>
			<Item>spellCastOmni</Item>
		</animations>
		<channel>CHANNEL_ABILITY</channel>
	</launch>
	<playOnTargets>
		<specialAction type="CreatureEffectsOnTarget">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/ReadyAstralSpellAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<locator>Slot_Head</locator>
					<useVisObjectSettings>FROM_TARGET</useVisObjectSettings>
				</Item>
			</visualEffects>
			<direction>DIR_TO_TARGET</direction>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
