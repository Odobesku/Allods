    <visualScripts href="/Mechanics/Characters/Hadagan_male/AstralDungeon04/Cultists/AcidTorrent.(SpellVisScripts).xdb" />
    <prepareDuration>200</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="/Mechanics/Characters/Hadagan_male/AstralDungeon04/Cultists/AcidBombsChannelBuff.(BuffResource).xdb" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.StackBuff">
                <buff href="/Mechanics/Characters/Hadagan_male/AstralDungeon04/Cultists/AcidBombsChannelBuff.(BuffResource).xdb" />
                <delta type="gameMechanics.elements.calcers.FloatData">
                    <value>-1</value>
                </delta>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ACID</element>
                        <damage>35</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="/Characters/Hadagan_male/Instances/AstralDungeon04/Boss04/SmallDemon.(MobWorld).xdb" />
                                </mobs>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                <projectileData>
                                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                    <resource href="AcidPuddle.(ProjectileResource).xdb" />
                                </projectileData>
                                <pool href="/Mechanics/Characters/Hadagan_male/AstralDungeon04/AD04.(SummonPool).xdb" />
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsElse>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>28</speed>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>3</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>