<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739913499</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="Ferris_4_2_4_mob.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
							<ability href="Ferris_4_2_4_mob.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
						</Item>
					</impactsElse>
				</Item>
			</onLeave>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
