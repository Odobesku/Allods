<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739933232</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
		<Item href="/Mechanics/Spells/Groups/Escapes.xdb" />
	</groups>
	<element>SHADOW</element>
	<Name href="Spell0_Name.txt" />
	<Description href="Spell0_Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="buff_duration" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Necromancer/NecromancerGhostlyVeil.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Necromancer/GhostWorld.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>30</value>
	</range>
	<ranks>
		<Item href="Spell01.(SpellSingleTarget).xdb" />
		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>90000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="Buff.(BuffResource).xdb" />
				</predicate>
			</Item>
		</targetConditions>
		<conditions>
			<Item type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
						<affectGroup>Group</affectGroup>
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
						<affectGroup>Raid</affectGroup>
					</Item>
				</predicates>
			</Item>
			<Item type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
				<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateAnd">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
							<predicate type="gameMechanics.elements.predicates.PredicateNotMaster" />
						</Item>
						<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
							<buff href="Watcher.(BuffResource).xdb" />
							<from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
						</Item>
					</predicates>
				</predicate>
			</Item>
		</conditions>
		<targetImpacts>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="Buff.(BuffResource).xdb" />
				<impactsOnAttach>
					<Item type="gameMechanics.elements.impacts.ReturningImpact">
						<impacts>
							<Item type="gameMechanics.elements.impacts.PostponedImpacts">
								<impacts>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="Watcher.(BuffResource).xdb" />
									</Item>
								</impacts>
							</Item>
						</impacts>
					</Item>
				</impactsOnAttach>
				<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
					<multiplier var="buff_duration" />
				</durationScaler>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
