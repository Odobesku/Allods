<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureRotateToCastPointAction" />
							<Item type="CreatureIndependentFxAction">
								<visObject href="/Spells/FX/Spells/AOEAura_Red.(VisObjectTemplate).xdb" />
								<useCastPoint>true</useCastPoint>
								<lifeTime>2</lifeTime>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionList">
						<playWhile type="VisActionDelay">
							<time>500</time>
						</playWhile>
						<elements>
							<Item type="CreatureAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>readySpell</Item>
								</animations>
								<channel>CHANNEL_ATTACK</channel>
							</Item>
						</elements>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureAnimationAction">
								<animations>
									<Item>rangedAttack</Item>
								</animations>
								<channel>CHANNEL_ATTACK</channel>
							</Item>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<delay>400</delay>
										<effectFx href="/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb" />
										<scale>3</scale>
										<locator>Slot_TopFX</locator>
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>InSequence</play>
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/MageFireballAbilityBig.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Spells/HitFireball2.(VisObjectTemplate).xdb" />
						<theGe>6</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_TopFX</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureLockRotationAction">
						<visActionID>LockRotation</visActionID>
					</Item>
					<Item type="VisActionDelay">
						<time>600</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>LockRotation</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>