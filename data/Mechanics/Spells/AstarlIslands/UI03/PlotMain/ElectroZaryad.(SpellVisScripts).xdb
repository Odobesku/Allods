<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <PreCastAnimation>specialCast</PreCastAnimation>
            <FXProjectile>/Spells/FX/Spells/MageLightningArrowAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
            <FXOnTargets />
            <CastAnimation>spellCastDirected01</CastAnimation>
            <LocatorOnTargets>Slot_FX</LocatorOnTargets>
            <FXProjectileHit>/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
            <ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
            <FxOnHands>/Spells/FX/Spells/ReadySpellDirectLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
            <LocatorOnCaster>Slot_FX</LocatorOnCaster>
        </Variables>
    </Header>
    <wholeCasting type="VisActionList">
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <scale>2</scale>
                    </Item>
                    <Item>
                        <scale>2</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <playOnTargets>
        <specialAction type="VisActionList">
            <elements>
                <Item type="CreatureEffectsAction">
                    <visualEffects>
                        <Item>
                            <delay>0</delay>
                        </Item>
                    </visualEffects>
                </Item>
                <Item skiped="" />
            </elements>
        </specialAction>
    </playOnTargets>
</SpellVisScripts>