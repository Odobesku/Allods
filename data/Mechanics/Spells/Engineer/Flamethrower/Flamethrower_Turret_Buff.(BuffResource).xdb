                                <ability href="/Mechanics/Spells/Engineer/Abilities/MechDamageUpg/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                <mul>0.07</mul>
                            </Item>
                        </scalers>
                    </scaler>
                </Item>
            </impacts>
            <length>15</length>
            <width>2</width>
            <height>10</height>
            <tick>500</tick>
            <affectGroup>Enemies</affectGroup>
        </Item>
    </effects>
    <duration>13000</duration>
    <isHelpful>false</isHelpful>
    <ranks>
