								<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
									<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
										<coeff>3</coeff>
									</scaler>
									<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
								</Item>
								<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
									<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
										<coeff>3</coeff>
									</scaler>
									<group href="/Mechanics/Spells/Groups/AutoAttackSharedMagic.(ActionGroup).xdb" />
								</Item>
							</effectsIf>
							<effectsElse>
								<Item type="gameMechanics.elements.effects.MultiplyStat">
									<stat type="gameMechanics.elements.stat.StatStamina" />
									<multiplier>1.25</multiplier>
								</Item>
								<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
									<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
										<coeff>6</coeff>
									</scaler>
									<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
								</Item>
								<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
									<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
										<coeff>6</coeff>
									</scaler>
									<group href="/Mechanics/Spells/Groups/AutoAttackSharedMagic.(ActionGroup).xdb" />
								</Item>
							</effectsElse>
						</Item>
						<Item type="gameMechanics.elements.effects.EffectsIf">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
									<onMaster type="gameMechanics.elements.predicates.PredicateHasContentKey">
										<key href="/System/ContentKeys/P2P_shard/P2P_shard_Server.(ContentKey).xdb" />
