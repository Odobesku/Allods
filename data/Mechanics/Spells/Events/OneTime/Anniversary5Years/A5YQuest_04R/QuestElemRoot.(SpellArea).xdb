    </interruptsActionGroups>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ActionBarChange.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="QuestElemRoot.(SpellArea).Name.txt" />
    <Description href="QuestElemRoot.(SpellArea).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/Fishnet.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="/Spells/VisScripts/Bard/WeaponThrow.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <sysName>B3</sysName>
    <range type="gameMechanics.elements.calcers.FloatData">
