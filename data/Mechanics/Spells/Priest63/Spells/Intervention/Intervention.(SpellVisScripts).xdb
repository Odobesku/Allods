<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownHoly.(VisObjectTemplate).xdb" />
                        <locator>Slot_Global</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb" />
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="VisActionList">
                <play>InSequence</play>
                <elements>
                    <Item type="VisActionList">
                        <play>Simultaneously</play>
                        <playWhile type="VisActionDelay">
                            <time>1500</time>
                        </playWhile>
                        <elements>
                            <Item type="CreatureAnimationAction">
                                <mode>LOOP</mode>
                                <animations>
                                    <Item>readySpellOmni</Item>
                                </animations>
                            </Item>
                        </elements>
                    </Item>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>spellCastOmni</Item>
                        </animations>
                    </Item>
                </elements>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="CreatureIndependentFxAction">
        <visObject href="/Spells/FX/Spells/Priest_Intervention_Out.(VisObjectTemplate).xdb" />
        <lifeTime>2</lifeTime>
    </launch>
</SpellVisScripts>