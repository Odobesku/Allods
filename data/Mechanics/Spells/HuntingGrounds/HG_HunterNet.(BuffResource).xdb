<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739842976</resourceId>
    </Header>
    <Name href="HG_HunterNet.(BuffResource).Name.txt" />
    <Description href="HG_HunterNet.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/SslowBoss06.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="HG_HunterNet.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                    </groups>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.PhysicalDoT">
            <parameters>
                <damagePerTick>8</damagePerTick>
            </parameters>
            <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectPull">
            <puller type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <speedFactor type="gameMechanics.elements.calcers.FloatData">
                <value>5</value>
            </speedFactor>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="HG_HunterNet.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    <calcers>
                        <addressEntries>
                            <Item>
                                <name>target</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                            </Item>
                            <Item>
                                <name>caster</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </Item>
                        </addressEntries>
                    </calcers>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="HG_HunterSelfFear.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>30000</duration>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
