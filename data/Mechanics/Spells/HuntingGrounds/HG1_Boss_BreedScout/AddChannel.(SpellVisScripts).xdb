<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes2/Channeling.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FadeInTime>100</FadeInTime>
			<FxOnCaster>/Spells/FX/Spells/ReadySpellDirect_Nihil_ElectoBlade.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnCaster>
			<FxOnTarget>/Spells/FX/Spells/PsionicSuffocateAbilityHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTarget>
			<LocatorNameOnCaster />
			<RayVelocity>0</RayVelocity>
			<LocatorNameOnTarget />
			<LocatorOnCaster>Slot_Mouth</LocatorOnCaster>
			<MultyTargetMode>FromCaster</MultyTargetMode>
			<FxOnHands />
			<LocatorOnTarget>Slot_BodyFX</LocatorOnTarget>
			<FxChanneling>/Spells/FX/Spells/PsionicSuffocateAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxChanneling>
			<FadeOutTime>100</FadeOutTime>
			<Animation>spellCastDirected</Animation>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item skiped="" />
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<scale>1.5</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FxOnCaster" />
						<scale>2</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="" />
				<effectAnimations>
					<mode>LOOP</mode>
					<animations>
						<Item>readySpell</Item>
					</animations>
				</effectAnimations>
			</Item>
			<Item>
				<effectFx hrefvar="FxOnHands" />
			</Item>
		</visualEffects>
	</wholeCasting>
</SpellVisScripts>
