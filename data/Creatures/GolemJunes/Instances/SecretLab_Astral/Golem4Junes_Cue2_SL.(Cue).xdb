<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>187789412</resourceId>
    </Header>
    <conditions />
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
            <spawn>
                <scriptID>SL_Golem4</scriptID>
                <map href="/Maps/Inst_SecretLab/astral_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
            </spawn>
            <onBehalfOfTarget>true</onBehalfOfTarget>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Creatures/GolemJunes/PlayTransformAnimation.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2030</delay>
                    <limit>1</limit>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/SecretLab/GolemSpells/MountGolem/Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <useSpellEnvelopeTargetEffects>false</useSpellEnvelopeTargetEffects>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsToInterlocutor">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactStopTalk" />
            </impacts>
        </Item>
    </impacts>
    <nextCues />
    <name href="Chat_name.txt" />
    <text href="" />
</gameMechanics.world.mob.interaction.Cue>