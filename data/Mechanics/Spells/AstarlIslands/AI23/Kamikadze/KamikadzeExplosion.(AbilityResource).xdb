<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>194452</resourceId>
    </Header>
    <name href="AbilityName.txt" />
    <visualScript type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Mobs/WillowispFlame.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <scale>1.2</scale>
                <fadeInTime>250</fadeInTime>
                <fadeOutTime>250</fadeOutTime>
                <locator>Slot_Global</locator>
                <offset z="1" />
            </Item>
        </visualEffects>
    </visualScript>
    <nameTemplate href="AbilityName.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                <verticalRange min="0.75" max="0.75" />
                                                <horizontalRange min="0" max="0" />
                                            </Item>
                                        </modifiers>
                                    </destination>
                                </moveType>
                                <resource href="ExplosionDecale.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                            </projectileData>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                <verticalRange min="-1.25" max="-1.25" />
                                                <horizontalRange min="0" max="0" />
                                            </Item>
                                        </modifiers>
                                    </destination>
                                </moveType>
                                <resource href="ExplosionDecale.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                            </projectileData>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="EnlargmentBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="KamikazePlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>