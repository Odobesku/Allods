<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>37210</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                            <quest href="/World/Quests/UmoirIsland07/UI07_Quest3/UI07_Quest3.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                            <counterResource href="/World/Quests/UmoirIsland07/UI07_Quest3/CountId_2.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                            <quest href="/World/Quests/UmoirIsland07/UI07_Quest3/UI07_Quest3.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                            <status>Finished</status>
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>UI07_BarkasAcademy</scriptID>
                        <map href="/Maps/UmoirIsland07/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                            <visualState>2</visualState>
                        </Item>
                    </impacts>
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>UI07_BarkasAcademy</scriptID>
                        <map href="/Maps/UmoirIsland07/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                            <visualState>1</visualState>
                        </Item>
                    </impacts>
                </Item>
            </impactsElse>
        </Item>
    </impactsIn>
    <impactsOut />
</gameMechanics.map.scriptZone.ScriptZone>