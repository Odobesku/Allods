		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="/World/Quests/ZoneLeague1/MegaGoal_L_IslandDaily_03/CountId_03.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
