    </Header>
    <Name href="GraveSummonSombie.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Bosses/UmoirViy/GraveSummonZombie.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>1000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="BigZombiePlease.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="BigZombiePlease.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.map.destination.RelativePos">
                            <yaw type="constructor.basicElements.AngleDegrees" />
                        </destination>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                        </impacts>
                        <object href="Zombie_Big_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <pool href="Spell_01_Pool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.map.destination.RelativePos">
                            <yaw type="constructor.basicElements.AngleDegrees" />
                        </destination>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                        </impacts>
                        <object href="Zombie_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <pool href="Spell_01_Pool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                        <spawn>
                            <scriptID>Boss_02</scriptID>
                            <map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                        </spawn>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                                        <level>0.2</level>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="BigZombiePlease.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>