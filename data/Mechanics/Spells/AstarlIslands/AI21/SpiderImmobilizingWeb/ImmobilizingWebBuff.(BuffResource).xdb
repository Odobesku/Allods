<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>189078</resourceId>
    </Header>
    <Name href="ImmobilizingWebBuff.(BuffResource).Name.txt" />
    <Description href="ImmobilizingWebBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Terrarium/Web.(UISingleTexture).xdb" />
    <visScript href="ImmobilizingWebBuff.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisablePassiveThreat" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="WebProtectingBuff.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ClenchTheNates/Clenched.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Loosen/LoosenWeb.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/RaidInstances/Phase1.(ActionGroup).xdb" />
                <Item href="/Mechanics/Spells/Groups/MercControl.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <damagePerTick>15</damagePerTick>
            </parameters>
            <element>ACID</element>
            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
        </Item>
        <Item type="gameMechanics.elements.effects.SpellRepelTypeModifier">
            <spells>
                <Item href="Loosen/LoosenTheWeb.(SpellSingleTarget).xdb" />
                <Item href="BreakTheWeb/BreakTheWeb.(SpellSingleTarget).xdb" />
                <Item href="ClenchTheNates/ClenchTheNates.(SpellSingleTarget).xdb" />
            </spells>
            <repelType>IGNORE</repelType>
            <probability>1</probability>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectAddContextActions">
                    <actions>
                        <Item href="Loosen/LoosenTheWeb.(SpellSingleTarget).xdb" />
                        <Item href="BreakTheWeb/BreakTheWeb.(SpellSingleTarget).xdb" />
                        <Item href="ClenchTheNates/ClenchTheNates.(SpellSingleTarget).xdb" />
                    </actions>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>12000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
        <Item href="/Mechanics/InstanceModifiers/Addon5/Not_Astral_Modifiers.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>