	<visObject href="/Spells/FX/Spells/AcidPuddle.(VisObjectTemplate).xdb" />
	<altitude>0</altitude>
	<lifeLengthCap>10000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
			<delay>2000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
							<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
							<radius>3</radius>
							<affectGroup>Enemies</affectGroup>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>ACID</element>
									<damage>35</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterOr">
								<filters>
									<Item type="gameMechanics.world.creature.AvatarFilter" />
									<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
										<predicates>
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
											</Item>
										</predicates>
									</Item>
								</filters>
							</filter>
						</Item>
					</impacts>
				</Item>
			</effects>
		</Item>
	</effects>
	<impactsToTarget>
		<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
			<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
			<data href="/Mechanics/Spells/AstarlIslands/AI29/HarpyBossPuddle/HarpyBossPuddleData.(ClientData).xdb" />
