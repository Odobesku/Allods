	<image href="/Interface/Icons/Misc/Itemmall/RuneExtractorImproved.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visScript href="/Spells/VisScripts/Engineer/Disability.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<effects>
