                            <ability href="/Mechanics/Spells/Engineer63/Abilities/SupportDronePull/SupportDronePull03.(AbilityResource).xdb" />
                            <anyRank>false</anyRank>
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.TickableAura">
                            <tick>1000</tick>
