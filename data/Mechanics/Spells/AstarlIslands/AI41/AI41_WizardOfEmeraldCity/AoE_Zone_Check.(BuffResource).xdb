	<Name href="AoE_Zone_Check.(BuffResource).Name.txt" />
	<Description href="AoE_Zone_Check.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Mage/IceStorm.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<nameTemplate href="AoE_Zone_Check.(BuffResource)_Name.txt.template" />
	<descTemplate href="AoE_Zone_Check.(BuffResource)_Desc.txt.template" />
	<effects>
		<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
					<element>COLD</element>
					<damage>40</damage>
					<scaler type="gameMechanics.elements.scalers.MagicScaler" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="Fire.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									</predicate>
								</Item>
								<Item type="gameMechanics.constructor.basicElements.PredicateOr">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</predicates>
								</Item>
							</predicates>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Frost.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<isForthright>true</isForthright>
	<isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>
