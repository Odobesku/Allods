<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>739940278</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                            <quest href="WW_6_15.xdb" />
                            <status>Active</status>
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                <quest href="WW_6_15.xdb" />
                                <status>Completed</status>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="WW_6_15.xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleLeaveMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/ZC12/Zones/ZC12/ZC12.(ZoneResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="WW_6_15.(SummonPool).xdb" />
                            <isPersonalPool>true</isPersonalPool>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="WW_6_15.xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>