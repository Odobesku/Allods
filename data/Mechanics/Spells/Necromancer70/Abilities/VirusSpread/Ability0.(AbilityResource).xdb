                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateHasSpell">
                                                    <spell href="/Mechanics/Spells/Necromancer70/Spells/Virus/Spell02.(SpellSingleTarget).xdb" />
                                                    <anyRank>false</anyRank>
