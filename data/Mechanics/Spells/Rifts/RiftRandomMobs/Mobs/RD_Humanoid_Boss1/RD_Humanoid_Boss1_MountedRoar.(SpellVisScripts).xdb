<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="CreatureRotateToCastPointAction">
						<immediateTurn>true</immediateTurn>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="VisActionDelay">
							<time>1000</time>
						</playWhile>
						<elements>
							<Item type="CreatureAnimationAction">
								<animations>
									<Item>ready</Item>
								</animations>
								<channel>CHANNEL_ATTACK</channel>
							</Item>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/ReadySpellSimple.(VisObjectTemplate).xdb" />
										<lockScale>true</lockScale>
										<scale>1.5</scale>
										<locator>Slot_Mouth</locator>
										<member>Mount</member>
									</Item>
									<Item>
										<effectFx href="/Spells/FX/Spells/ReadySpellSimple.(VisObjectTemplate).xdb" />
										<scale>1.5</scale>
										<locator>Slot_Mouth</locator>
										<member>Default_Member</member>
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>specialCast</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>