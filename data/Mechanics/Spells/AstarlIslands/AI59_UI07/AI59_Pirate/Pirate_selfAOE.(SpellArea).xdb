<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>187979</resourceId>
    </Header>
    <Name href="Pirate_selfAOE.(SpellArea).Name.txt" />
    <visualScripts href="Pirate_selfAOE.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>600000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                        <minDamage>40</minDamage>
                        <maxDamage>40</maxDamage>
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>