<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739935304</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.5</coeff>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.MultiplyStat">
			<stat type="gameMechanics.elements.stat.StatStamina" />
			<multiplier>0.75</multiplier>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<effects>
				<Item type="gameMechanics.elements.effects.EffectsIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateHasAbility">
							<ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
						</Item>
					</predicates>
					<effectsIf>
						<Item type="gameMechanics.elements.effects.Switch">
							<impactsOn>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="SteelBeak.(BuffResource).xdb" />
								</Item>
							</impactsOn>
						</Item>
					</effectsIf>
				</Item>
			</effects>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
