<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739948085</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="SupportAcousticBarrierGroup.(BuffResource).Name.txt" />
    <Description href="SupportAcousticBarrierGroup.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/ResistanceAstral.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.PureHeal">
                        <heal>1</heal>
                        <scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer hrefvar="externalCalcer" />
                            </mulCalcer>
                        </scalerCaster>
                    </Item>
                </casterToTarget>
                <targetToOffender>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.PureDamage">
                                <damage>1</damage>
                                <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer hrefvar="externalCalcer" />
                                    </mulCalcer>
                                </scaler>
                            </Item>
                        </impactsIf>
                    </Item>
                </targetToOffender>
            </impacts>
            <scaleImpactsByDamage>true</scaleImpactsByDamage>
        </Item>
    </effects>
    <duration>5000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="SupportAcousticBarrierGroup01.(BuffResource).xdb" />
        <Item href="SupportAcousticBarrierGroup02.(BuffResource).xdb" />
        <Item href="SupportAcousticBarrierGroup03.(BuffResource).xdb" />
        <Item href="SupportAcousticBarrierGroup04.(BuffResource).xdb" />
        <Item href="SupportAcousticBarrierGroup05.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>