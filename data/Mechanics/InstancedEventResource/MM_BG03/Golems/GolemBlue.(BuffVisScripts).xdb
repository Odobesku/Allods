<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<visActionID>GolemVis</visActionID>
						<time>600</time>
					</Item>
					<Item type="VisActionChangeVisObject">
						<visActionID>GolemVis</visActionID>
						<newVisMob href="/Creatures/GolemJunes/GolemJunes.(VisualMob).xdb#xpointer(/VisualMob)" />
					</Item>
				</elements>
			</Item>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Mobs/GolemBlue_In.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<offset z="0.2" />
				<lifeTime>3</lifeTime>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="VisActionDelay">
						<visActionID>GolemColorBlue12</visActionID>
						<time>600</time>
					</Item>
					<Item type="CreatureColorAction">
						<visActionID>GolemColorBlue12</visActionID>
						<colorValue>-13392908</colorValue>
						<useOn>Rider</useOn>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>1000</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visActionID>0</visActionID>
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/GolemBlue_Glow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>1.1</scale>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Spine1</locatorName>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureSetOvertipAction">
				<overtip href="/Interface/Ingame/ContextRelatedTextures/OvertipMarks/MarkBlueSkull.(UITexture).xdb#xpointer(/UITexture)" />
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Mobs/GolemBlue_Out.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<offset z="0.2" />
				<lifeTime>3</lifeTime>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
