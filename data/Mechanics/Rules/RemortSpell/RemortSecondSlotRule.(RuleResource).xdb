<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.rules.RuleResource>
    <Header>
        <resourceId>230650</resourceId>
    </Header>
    <name href="RemortSecondSlotRule.(RuleResource).Name.txt" />
    <description href="RemortSecondSlotRule.(RuleResource).Description.txt" />
    <level>4</level>
    <rating>5</rating>
    <reward>
        <mandatoryItems>
            <Item>
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="/ItemMall/Services/RemortSpells/RemortSecondSlotItem.(ItemResource).xdb" />
                </item>
                <number>1</number>
            </Item>
            <Item>
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="/ItemMall/Services/AvatarDonate/AvatarRemortComplect1.(ItemResource).xdb" />
                </item>
                <number>1</number>
            </Item>
            <Item>
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="/ItemMall/Services/Avatar/RemortSecondAdd.(ItemResource).xdb" />
                </item>
                <number>1</number>
            </Item>
        </mandatoryItems>
    </reward>
    <hideInactive>true</hideInactive>
    <ruleKind>IngameNotification</ruleKind>
    <notification href="RemortSecondSlotNotif.(RuleNotification).xdb" />
    <predicates>
        <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/ItemmallService.(ContentKey).xdb" />
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateHasContentKey">
                <key href="/System/ContentKeys/IM_Steam.(ContentKey).xdb" />
            </predicate>
        </Item>
    </predicates>
    <timeTable href="RemortSecondSlotTimeTable.(TimePeriodTable).xdb" />
    <canBeDisabled>true</canBeDisabled>
</gameMechanics.world.rules.RuleResource>