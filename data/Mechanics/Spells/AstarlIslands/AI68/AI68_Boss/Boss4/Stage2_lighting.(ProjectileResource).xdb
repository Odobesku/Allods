<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739912859</resourceId>
	</Header>
	<visObject href="/Spells/FX/Mobs/AI68_Idol_Toad_Aoe_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<lifeLengthCap>2500</lifeLengthCap>
	<impactsOnStart>
		<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
			<radius>10</radius>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</predicates>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>LIGHTNING</element>
							<damage>50</damage>
							<scaler type="gameMechanics.elements.scalers.MagicScaler" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="Stage2_mob.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							</mobs>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.DirectDamage">
							<damage>1</damage>
							<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
									<multiplier>0.37</multiplier>
								</mulCalcer>
							</scalerTarget>
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="HitLightning.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				</Item>
			</impacts>
		</Item>
	</impactsOnStart>
</gameMechanics.world.projectile.ProjectileResource>
