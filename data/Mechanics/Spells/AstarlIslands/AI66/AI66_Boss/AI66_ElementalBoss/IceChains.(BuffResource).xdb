<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739884223</resourceId>
    </Header>
    <Name href="IceChains.(BuffResource).Name.txt" />
    <Description href="IceChains.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageIceTomb.(UISingleTexture).xdb" />
    <visScript href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Elementals/AI66_FrostElemental/FrostPrison.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Elementals/AI66_FireElemental/AI66_FireElemental_add.(MobWorld).xdb" />
                        </mobs>
                    </predicate>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>COLD</element>
                            <damage>20</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <initialDelay>2000</initialDelay>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>25</coeff>
                    </scaler>
                </Item>
            </effectsElse>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="RoadToInferno.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/KnockdownBreakers.xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/InstanceModifiers/Addon5/Not_Astral_Modifiers.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>