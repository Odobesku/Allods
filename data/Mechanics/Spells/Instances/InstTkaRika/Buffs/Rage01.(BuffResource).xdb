<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>195535</resourceId>
    </Header>
    <Name href="Rage01.txt" />
    <Description href="Rage01.Description.txt" />
    <image href="/Interface/Icons/Spells/BloodLust01.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.HighStackEffect">
            <effect type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                                <key href="/System/ContentKeys/NewTkaRika.(ContentKey).xdb" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                        <spawn>
                                            <scriptID>BombDemon</scriptID>
                                            <map href="/Maps/Inst_TkaRika/New_MapResource.xdb" />
                                        </spawn>
                                        <onBehalfOfTarget>true</onBehalfOfTarget>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactMobMorph">
                                                <newMobWorld href="/Creatures/DemonCrabBoss/Instances/Inst_TkaRika/DemonCrabBoss02.(MobWorld).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.impacts.ImpactHealAll" />
                                        </impacts>
                                    </Item>
                                </impacts>
                                <mob>
                                    <scriptID>BombDemon</scriptID>
                                    <map href="/Maps/Inst_TkaRika/New_MapResource.xdb" />
                                </mob>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="/Mechanics/Spells/Instances/InstNewTkaRika/ClientData/Massacre2Boss.(ClientData).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                <table href="/Maps/Inst_TkaRika/SpawnTables/Inst_TkaRika/ChildsEvent.(SpawnTable).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                <table href="/Maps/Inst_TkaRika/SpawnTables/Inst_TkaRika/ChildsEvent01.(SpawnTable).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                <table href="/Maps/Inst_TkaRika/SpawnTables/Inst_TkaRika/ChildsEvent02.(SpawnTable).xdb" />
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                                <mob>
                                    <scriptID>BombDemon</scriptID>
                                    <map href="/Maps/Inst_TkaRika/New_MapResource.xdb" />
                                </mob>
                            </Item>
                        </impactsElse>
                    </Item>
                </impactsOn>
            </effect>
            <stackCountTrigger>10</stackCountTrigger>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                    <zone href="/Maps/Inst_TkaRika/Zones/Inst_TkaRika/TkaRika.(ZoneResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Rage01.(BuffResource).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>4000</tick>
        </Item>
    </effects>
    <stackLimit>10</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>