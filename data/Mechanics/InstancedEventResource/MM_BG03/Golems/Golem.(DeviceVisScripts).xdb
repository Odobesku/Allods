<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<defaultVisAction type="DeviceVisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>special01</Item>
				</animations>
			</Item>
			<Item type="DeviceVisEffectsAction">
				<visualEffects>
					<Item>
						<locatorName>Global</locatorName>
						<effectFx href="/Spells/FX/Mobs/GolemRed_Spark.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<scale>1.1</scale>
						<lockScale>true</lockScale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</defaultVisAction>
</DeviceVisScripts>
