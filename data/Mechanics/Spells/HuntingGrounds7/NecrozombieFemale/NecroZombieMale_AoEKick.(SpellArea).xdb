<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739899031</resourceId>
    </Header>
    <element>ASTRAL</element>
    <Name href="NecroZombieMale_AoEKick.(SpellArea).Name.txt" />
    <visualScripts href="/Mechanics/Spells/AstarlIslands/AI48/Trash/ZombieMage/MagicKick.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ASTRAL</element>
                        <damage>40</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                        <time>1000</time>
                        <impactsOnLand>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Skip_Aggro.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsOnLand>
                        <distance>20</distance>
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>45</value>
        </angle>
    </shape>
    <radius>20</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>