		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>2000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectForceMove">
					<destinations>
						<Item type="gameMechanics.map.destination.DestinationLocator">
							<locator>
								<scriptID var="SteleLoc" />
								<map href="/Maps/FerrisRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
							</locator>
						</Item>
					</destinations>
					<impactsOnArrived>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff hrefvar="BuffDetachedOnArrive" />
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="MissedStun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ChargeDamageAura.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="ChieftainChargeMissDebuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
							<spawn>
								<scriptID var="DestroyedSteleID" />
								<map href="/Maps/FerrisRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
							</spawn>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
