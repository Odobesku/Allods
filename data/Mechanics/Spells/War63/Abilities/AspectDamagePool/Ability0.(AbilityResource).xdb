<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739921609</resourceId>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorShieldBlock.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectsDeferred">
                            <delay>1000</delay>
                            <effects>
                                <Item type="gameMechanics.elements.abilities.DamagePoolBarrier">
                                    <damagePoolLimit type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                        <calcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                            <multiplier>3</multiplier>
                                        </calcer>
                                    </damagePoolLimit>
                                    <toDamagePoolPercent>0.7</toDamagePoolPercent>
                                    <fromDamagePoolPercent>0.1</fromDamagePoolPercent>
                                    <fromDamagePoolMinValue type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                        <calcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                            <multiplier>0.04</multiplier>
                                        </calcer>
                                    </fromDamagePoolMinValue>
                                    <resolveTime>
                                        <second>3</second>
                                    </resolveTime>
                                </Item>
                            </effects>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.CombatStateTrigger">
                    <onLeave>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>5000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                            </predicates>
                                            <impactsElse>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                                                            <lhs type="gameMechanics.elements.calcers.CalcerDamagePoolBarrier" />
                                                            <rhs type="gameMechanics.elements.calcers.LongData">
                                                                <value>0</value>
                                                            </rhs>
                                                        </Item>
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.elements.impacts.ImpactRetriveDamageFromPoolBarrier">
                                                            <damage type="gameMechanics.elements.calcers.CalcerDamagePoolBarrier" />
                                                        </Item>
                                                    </impactsIf>
                                                </Item>
                                            </impactsElse>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </onLeave>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>