<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>222826</resourceId>
    </Header>
    <visObject href="/Spells/FX/Mobs/NihazSphereArchitect_In.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>5000</lifeLengthCap>
    <plane href="FullyAccessiblePlane.(Plane).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <radius>85</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="Drone/Drone.(MobWorld).xdb" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.EntitytFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                            <spawnResource href="Drones.(SpawnTable).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>