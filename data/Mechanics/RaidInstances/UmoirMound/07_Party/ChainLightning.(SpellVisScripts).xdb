<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobRay_Instant.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>ready</PreCastAnimation>
			<FXOnTargets>/Spells/FX/Spells/HitLightning_big.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<CastAnimation>spellCastDirected</CastAnimation>
			<RayMaxTime>700</RayMaxTime>
			<LocatorOnTargets>Slot_Global</LocatorOnTargets>
			<FXRay>/Spells/FX/Spells/Mage_LitShield_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXRay>
			<FxOnHands>/Spells/FX/Spells/ReadySpellDirectLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<LocatorOnCaster>Slot_Hand_L</LocatorOnCaster>
		</Variables>
	</Header>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<delay>200</delay>
						</Item>
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
