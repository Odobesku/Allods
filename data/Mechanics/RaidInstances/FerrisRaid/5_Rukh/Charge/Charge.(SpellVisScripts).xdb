		<animations>
			<Item>ready</Item>
		</animations>
		<advanced>
			<speed>1</speed>
			<animationKeysAction />
		</advanced>
	</actionBarStart>
	<wholeCasting />
	<precastType>PRECAST_DEFAULT</precastType>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
				<advanced>
					<speed>1.75</speed>
				</advanced>
			</Item>
			<Item type="VisActionDelay">
