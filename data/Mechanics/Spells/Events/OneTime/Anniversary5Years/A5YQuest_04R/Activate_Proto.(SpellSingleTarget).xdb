                                                                <buff href="ElemGivePlane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                </impactsIf>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                                <object hrefvar="summonMob" />
                                <level type="gameMechanics.elements.calcers.CalcerLevel" />
                                <pool hrefvar="summonPool" />
                                <isPersonalPool>true</isPersonalPool>
                            </Item>
                        </impacts>
                        <elseImpacts>
