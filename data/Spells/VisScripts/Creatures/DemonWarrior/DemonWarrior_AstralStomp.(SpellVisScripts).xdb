<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>death</PreCastAnimation>
			<FXOnCaster>/Spells/FX/Spells/HitLightning_big.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<LocatorOnCaster>Global</LocatorOnCaster>
			<FixPointCaster>true</FixPointCaster>
			<LocatorNameOnCaster />
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="PreCastAnimation" />
				</animations>
				<channelOverrideScript />
				<advanced>
					<speed>0.7</speed>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects />
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>2.8</scale>
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<locator>Slot_Global</locator>
						<offendTime />
					</Item>
					<Item>
						<delay>0</delay>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>3</scale>
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<locator>Slot_Global</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<play>InSequence</play>
				<elements>
					<Item type="VisActionDelay">
						<time>600</time>
					</Item>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject hrefvar="FXOnCaster" />
								<offset x="-0.7" y="-2.3" />
								<locatorName>Slot_Global</locatorName>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
