<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739904856</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image hrefvar="image" />
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <functionalPart type="itemService.avatar.itemBag.ItemTakeActions">
        <actions>
            <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                <item type="gameMechanics.constructor.schemes.item.LevelItemProvider">
                    <item type="gameMechanics.constructor.schemes.item.QualityItemProvider">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item hrefvar="item" />
                        </item>
                        <quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
                    </item>
                    <level var="level" />
                </item>
                <binding>ForceBind</binding>
            </Item>
        </actions>
    </functionalPart>
    <level var="level" />
    <requiredLevel>6</requiredLevel>
    <spell href="/Mechanics/Ships/ConvertDeviceItem.(Spell).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
    <quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <binding>BindOnPickup</binding>
    <name hrefvar="name" />
    <description hrefvar="description" />
</gameMechanics.constructor.schemes.item.ItemResource>