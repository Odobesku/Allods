<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>238651</resourceId>
    </Header>
    <Name href="Buff_02_02_70.(BuffResource).Name.txt" />
    <Description href="Buff_02_02_70.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/Insurance.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Other/Insurance_Buff.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.common.HealOverTime">
            <healPerTick type="gameMechanics.elements.calcers.FloatData">
                <value>7.107</value>
            </healPerTick>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.OverLevelPenaltyCalcer">
                            <level>9</level>
                            <exponent>1</exponent>
                            <multiplier>0.03</multiplier>
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerIf">
                        <condition type="gameMechanics.elements.predicates.PredicateManaCaster">
                            <manaType>Mana</manaType>
                        </condition>
                        <scalerIf type="gameMechanics.elements.scalers.HealScaler" />
                        <scalerElse type="gameMechanics.elements.scalers.HealSlotScaler">
                            <slot>MAINHAND</slot>
                        </scalerElse>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.OffensiveRunesScaler" />
                </scalers>
            </scaler>
            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer href="LevelDiminishing70.(CalcerFloatResource).xdb" />
                </mulCalcer>
            </scalerTarget>
            <tick>1000</tick>
            <considerOutgoingModifiers>false</considerOutgoingModifiers>
        </Item>
    </effects>
    <duration>6000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>