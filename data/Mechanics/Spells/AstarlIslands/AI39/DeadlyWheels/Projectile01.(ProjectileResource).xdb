<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>189592</resourceId>
    </Header>
    <persistentParts>
        <Item type="gameMechanics.constructor.commonBunchParts.ImportantObjectResource" />
    </persistentParts>
    <visObject href="AI39_AoEBlue.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0</altitude>
    <lifeLengthCap>10500</lifeLengthCap>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.EntityImpactsDeferred">
            <delay>10000</delay>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.RelativePos" />
                        </moveType>
                        <resource href="Projectile02.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                </Item>
            </impacts>
        </Item>
    </impactsOnStart>
    <effects>
        <Item type="gameMechanics.elements.effects.Aura">
            <radius>6</radius>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <anyRank>false</anyRank>
                </Item>
            </impactsOut>
            <checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </filter>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Aura">
                    <affectGroup>Friends</affectGroup>
                    <radius>6</radius>
                    <impactsIn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="SelfBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="SelfBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <anyRank>false</anyRank>
                        </Item>
                    </impactsOut>
                    <checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
                    <filter type="gameMechanics.world.creature.CreatureFilter" />
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>