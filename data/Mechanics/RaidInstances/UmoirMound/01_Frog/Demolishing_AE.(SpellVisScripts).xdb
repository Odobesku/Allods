<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>specialCast</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/UmoirMound_Frog_ReadyDown.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>6</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<stopOnDeath>false</stopOnDeath>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/UmoirMound_Frog_Demolishing.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<scale>3</scale>
						<locator>Slot_BodyFX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
