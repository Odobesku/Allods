<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739870599</resourceId>
	</Header>
	<Name href="Acid.(BuffResource).Name.txt" />
	<visScript href="/Spells/VisScripts/Necromancer/CorrosiveAcid.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.world.device.ImpactDeviceDamagePercent">
					<percent>0.02</percent>
				</Item>
				<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
					<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
						<value>0.1</value>
					</chanceCalcer>
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Acid.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>5000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<conditionalEvents>
				<Item>
					<obj>gameMechanics.elements.events.EventHealReceived</obj>
					<predicate type="gameMechanics.elements.predicates.PredicateDevice" />
				</Item>
			</conditionalEvents>
			<impacts>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Acid.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impacts>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
