<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureReplaceAnimationsAction">
                <onTop>
                    <animationsReplacements>
                        <Item>
                            <play>hit01</play>
                            <forAnimations>
                                <Item>hit</Item>
                                <Item>hitCritical</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onTop>
                <onBottom>
                    <animationsReplacements>
                        <Item>
                            <play>hit01</play>
                            <forAnimations>
                                <Item>hit</Item>
                                <Item>hitCritical</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onBottom>
            </Item>
            <Item type="CreatureReplaceAnimationsAction">
                <onTop>
                    <animationsReplacements>
                        <Item>
                            <play>idle01</play>
                            <forAnimations>
                                <Item>ready</Item>
                                <Item>readySpellDirected</Item>
                                <Item>readySpellOmni</Item>
                                <Item>readyUnarmed</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onTop>
                <onBottom>
                    <animationsReplacements>
                        <Item>
                            <play>idle01</play>
                            <forAnimations>
                                <Item>ready</Item>
                                <Item>readySpellDirected</Item>
                                <Item>readySpellOmni</Item>
                                <Item>readyUnarmed</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onBottom>
            </Item>
            <Item type="CreatureReplaceAnimationsAction">
                <onTop>
                    <animationsReplacements>
                        <Item>
                            <play>attack01</play>
                            <forAnimations>
                                <Item>attack</Item>
                                <Item>attack01</Item>
                                <Item>attack02</Item>
                                <Item>attack03</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onTop>
                <onBottom>
                    <animationsReplacements>
                        <Item>
                            <play>attack01</play>
                            <forAnimations>
                                <Item>attack</Item>
                                <Item>attack01</Item>
                                <Item>attack02</Item>
                                <Item>attack03</Item>
                            </forAnimations>
                        </Item>
                    </animationsReplacements>
                </onBottom>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>CLAMP</mode>
                <animations>
                    <Item>special</Item>
                </animations>
                <channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
            </Item>
        </elements>
    </action>
</BuffVisScripts>