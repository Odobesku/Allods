<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>readySpell</PreCastAnimation>
			<CastAnimation>spellCastOmni</CastAnimation>
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<FixPointCaster>false</FixPointCaster>
			<FixPointTarget>true</FixPointTarget>
			<LocatorNameOnCaster />
			<LocatorNameOnTargets />
			<LocatorOnTargets>Slot_Global</LocatorOnTargets>
			<LocatorOnCaster>Slot_TopFX</LocatorOnCaster>
			<FxOnHands>/Spells/FX/Spells/ReadySpellDirectAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<HitPostFXOnTargets />
			<FXOnCaster>/Spells/FX/Spells/ReadySpellDirectCurseWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<FXOnTargets>/Spells/FX/Mobs/Demonl_TargetHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item skiped="" />
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureEffectsOnTarget">
				<visActionID>TARGETFX</visActionID>
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Demonl_TargetReady.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>1.2</scale>
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>250</fadeOutTime>
						<locator>Slot_Global</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>4000</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>TARGETFX</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
