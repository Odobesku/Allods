<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739904416</resourceId>
    </Header>
    <name href="Bomb.(ProjectileResource).Name.txt" />
    <visObject href="/Mechanics/InstanceModifiers/Addon5/Bombs/Hard/Bomb.(VisObjectTemplate).xdb" />
    <lifeLengthCap>3000</lifeLengthCap>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
            <delay>2500</delay>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.RelativePos" />
                        </moveType>
                        <resource href="BombExplosion.(ProjectileResource).xdb" />
                    </projectileData>
                </Item>
            </impacts>
        </Item>
    </impactsOnStart>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <tick>1000</tick>
            <affectGroup>All</affectGroup>
            <radius>5</radius>
            <height>2</height>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="BombInfo.(BuffResource).xdb" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="BombInfo.(BuffResource).xdb" />
                </Item>
            </impactsOut>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>