<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Tep_Dust.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fixPoint>true</fixPoint>
                        <locator>Slot_Global</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>400</time>
                    </Item>
                    <Item type="VisActionChangeVisObject">
                        <newVisMob href="/Creatures/DruidPets/GoblinPrihlop/GoblinPrihlop03.(VisualMob).xdb#xpointer(/VisualMob)" />
                    </Item>
                </elements>
            </Item>
        </elements>
    </action>
</BuffVisScripts>