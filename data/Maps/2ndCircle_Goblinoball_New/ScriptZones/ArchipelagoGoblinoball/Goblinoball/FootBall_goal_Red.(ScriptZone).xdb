<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
	<Header>
		<resourceId>318147673</resourceId>
	</Header>
	<filter type="gameMechanics.world.creature.CreatureFilter" />
	<blinking>true</blinking>
	<conditionsIn>
		<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
			<mobs>
				<Item href="/Creatures/Slime/Instances/ArchipelagoEmpire2/SlimeBall.(MobWorld).xdb" />
			</mobs>
		</Item>
	</conditionsIn>
	<impactsIn>
		<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="/Mechanics/Spells/QuestSpells/Football_New/RedTeam_hit.(BuffResource).xdb" />
				</Item>
			</predicates>
			<impactsIf>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>RedOfsaid</scriptID>
							<map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
						</locator>
					</destination>
				</Item>
			</impactsIf>
			<impactsElse>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>SlimeReferee</scriptID>
						<map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
					</spawn>
					<onBehalfOfTarget>true</onBehalfOfTarget>
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Mechanics/Spells/QuestSpells/Football_New/Goal_Blue.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
					<impacts>
						<Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactUpdateEventAchievementGeneric">
							<achievement href="/Mechanics/InstancedEventResource/MM_Football/MM_Football.(BattleEventAchievementResource).xdb" />
							<summand type="gameMechanics.elements.calcers.FloatData">
								<value>1</value>
							</summand>
							<mark href="/Maps/2ndCircle_Goblinoball_New/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
							<variableResource href="/Mechanics/Spells/QuestSpells/Football_New/FootballDrawVariable.(MapVariableResource).xdb" />
							<expectedValue type="gameMechanics.elements.calcers.FloatData">
								<value>1</value>
							</expectedValue>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>1000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
									<impacts>
										<Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactFinishInstancedEventGeneric" />
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="/Mechanics/Spells/QuestSpells/Football_New/StrikeAndGoalCounterBuff.(BuffResource).xdb" />
				</Item>
			</impactsElse>
		</Item>
	</impactsIn>
	<considerAsWhole>true</considerAsWhole>
</gameMechanics.map.scriptZone.ScriptZone>
