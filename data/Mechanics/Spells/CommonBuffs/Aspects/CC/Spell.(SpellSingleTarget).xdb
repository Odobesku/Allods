<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739921332</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/CommonAspects.(ActionGroup).xdb" />
	</groups>
	<Name href="Spell.(SpellSingleTarget).Name.txt" />
	<Description href="Spell.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>perc</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>FormulaPercent</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/CommonState/Aspect_Control.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Priest/AspectOfLight.(SpellVisScripts).xdb" />
	<prepareDuration>5000</prepareDuration>
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<isAggro>false</isAggro>
	<isWorkOnDead>true</isWorkOnDead>
	<ranks>
		<Item href="Spell01.(SpellSingleTarget).xdb" />
		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="ProxyBuff2.(BuffResource).xdb" />
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.BuffDetacher">
						<buff href="ProxyBuff2.(BuffResource).xdb" />
					</Item>
				</impactsIf>
				<impactsElse>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
								<groups>
									<Item href="/Mechanics/Spells/Groups/CommonAspects.(ActionGroup).xdb" />
								</groups>
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
								<group href="/Mechanics/Spells/Groups/CommonAspects.(ActionGroup).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.PostponedImpacts">
								<impacts>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="ProxyBuff2.(BuffResource).xdb" />
									</Item>
								</impacts>
							</Item>
						</impactsIf>
						<impactsElse>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="ProxyBuff2.(BuffResource).xdb" />
							</Item>
						</impactsElse>
					</Item>
				</impactsElse>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
