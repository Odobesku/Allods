<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739920767</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/FireSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MageFireSpeedcast.(ActionGroup).xdb" />
    </groups>
    <element>FIRE</element>
    <Name href="Spell.(SpellSingleTarget).Name.txt" />
    <Description href="Spell.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Mage/MageFireArrow.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mage/FireArrow.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                        <mark href="/Mechanics/Spells/Mage63/Abilities/FireArrowHasteAfterCast/Mark.(MarkResource).xdb" />
                    </Item>
                </impacts>
                <groupRepeaters>true</groupRepeaters>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>FIRE</element>
                        <damage var="damage" />
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="/Mechanics/Spells/Mage63/Abilities/FireArrowStupefaction/Mark.(MarkResource).xdb" />
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                <Item type="gameMechanics.elements.scalers.ScalerIf">
                                    <condition type="gameMechanics.elements.predicates.PredicateItemEquipped">
                                        <resource href="/Items/Relic/70/bracers_2_Lethality.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                    </condition>
                                    <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>1.06</multiplier>
                                    </scalerIf>
                                </Item>
                            </scalers>
                        </scaler>
                    </Item>
                </impacts>
                <groupRepeaters>true</groupRepeaters>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>25</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>