<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739954998</resourceId>
	</Header>
	<description href="R7_Invansion_Launch_Prokectile.(AbilityResource).Description.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.Disintegrate" />
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
			<groups>
				<Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
			</groups>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item skiped="" />
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
					<projectileData>
						<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
							<destination type="gameMechanics.map.destination.SelfPosDestination" />
						</moveType>
						<resource href="R7_Invansion_SelfDestruction.(ProjectileResource).xdb" />
					</projectileData>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactGoTo">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>R7_Veronica_Invansion</scriptID>
							<map href="/Maps/ArchBase_Raid/MapResource.xdb" />
						</locator>
					</destination>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
					<groups>
						<Item href="/Mechanics/Spells/Groups/Knockdowns.xdb" />
						<Item href="/Mechanics/Spells/Groups/Fears.xdb" />
						<Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
						<Item href="/Mechanics/Spells/Groups/Blinds.xdb" />
						<Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
						<Item href="/Mechanics/Spells/Groups/Silence.xdb" />
						<Item href="/Mechanics/Spells/Groups/Disarms.xdb" />
						<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
						<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
						<Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
					</groups>
				</Item>
			</predicates>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
