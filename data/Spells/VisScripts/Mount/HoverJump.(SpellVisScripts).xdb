<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<precastType>PRECAST_DEFAULT</precastType>
	<launch type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.CreatureEffectsAction">
						<category>EFFECT_DEFAULT</category>
						<visualEffects>
							<Item>
								<delay>0</delay>
								<effectAlias href="" />
								<effectAnimations>
									<mode>DIE</mode>
								</effectAnimations>
								<effectFx href="/Spells/FX/Spells/HoverJump_Wings.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fadeInTime>0</fadeInTime>
								<fadeOutTime>0</fadeOutTime>
								<scale>1</scale>
								<fixPoint>false</fixPoint>
								<lockScale>false</lockScale>
								<muteFxSounds>false</muteFxSounds>
								<ignoreParentRotation>false</ignoreParentRotation>
								<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Slot_Special91</locatorName>
								<member>Mount</member>
								<offset x="0.5" y="0" z="0" />
								<rotation x="0" y="0" z="0" />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
							</Item>
							<Item>
								<delay>0</delay>
								<effectAlias href="" />
								<effectAnimations>
									<mode>DIE</mode>
								</effectAnimations>
								<effectFx href="/Spells/FX/Spells/HoverJump_Wings.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fadeInTime>0</fadeInTime>
								<fadeOutTime>0</fadeOutTime>
								<scale>1</scale>
								<fixPoint>false</fixPoint>
								<lockScale>false</lockScale>
								<muteFxSounds>false</muteFxSounds>
								<ignoreParentRotation>false</ignoreParentRotation>
								<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Slot_Special92</locatorName>
								<member>Mount</member>
								<offset x="-1" y="0" z="0" />
								<rotation x="0" y="0" z="0" />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
							</Item>
						</visualEffects>
						<dontFade>false</dontFade>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
						<stopOnDeath>false</stopOnDeath>
					</Item>
				</elements>
				<play>Simultaneously</play>
				<playWhile type="client.SLON.PredicateVisualMountAction">
					<mountsList>
						<Item href="/Client/VisualMounts/Hover/Hover.(VisualMount).xdb#xpointer(/VisualMount)" />
					</mountsList>
					<checkIsInTheList>true</checkIsInTheList>
					<checkOnStartOnly>true</checkOnStartOnly>
				</playWhile>
				<preconditional>true</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.CreatureEffectsAction">
						<category>EFFECT_DEFAULT</category>
						<visualEffects>
							<Item>
								<delay>0</delay>
								<effectAlias href="" />
								<effectAnimations>
									<mode>DIE</mode>
								</effectAnimations>
								<effectFx href="/Spells/FX/Spells/HoverJump_Wings.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fadeInTime>0</fadeInTime>
								<fadeOutTime>0</fadeOutTime>
								<scale>1</scale>
								<fixPoint>false</fixPoint>
								<lockScale>false</lockScale>
								<muteFxSounds>false</muteFxSounds>
								<ignoreParentRotation>false</ignoreParentRotation>
								<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>TopWing_R</locatorName>
								<member>Mount</member>
								<offset x="-1.3" y="0" z="-0.15" />
								<rotation x="0" y="0" z="0" />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
							</Item>
							<Item>
								<delay>0</delay>
								<effectAlias href="" />
								<effectAnimations>
									<mode>DIE</mode>
								</effectAnimations>
								<effectFx href="/Spells/FX/Spells/HoverJump_Wings.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fadeInTime>0</fadeInTime>
								<fadeOutTime>0</fadeOutTime>
								<scale>1</scale>
								<fixPoint>false</fixPoint>
								<lockScale>false</lockScale>
								<muteFxSounds>false</muteFxSounds>
								<ignoreParentRotation>false</ignoreParentRotation>
								<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>TopWing_L</locatorName>
								<member>Mount</member>
								<offset x="0.8" y="0" z="-0.15" />
								<rotation x="0" y="0" z="0" />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
							</Item>
						</visualEffects>
						<dontFade>false</dontFade>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
						<stopOnDeath>false</stopOnDeath>
					</Item>
				</elements>
				<play>Simultaneously</play>
				<playWhile type="client.SLON.PredicateVisualMountAction">
					<mountsList>
						<Item href="/Client/VisualMounts/Hover/HoverTop.(VisualMount).xdb#xpointer(/VisualMount)" />
					</mountsList>
					<checkIsInTheList>true</checkIsInTheList>
					<checkOnStartOnly>true</checkOnStartOnly>
				</playWhile>
				<preconditional>true</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<playWhile type="client.Replica.VisActionDelay">
			<time>2000</time>
		</playWhile>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</launch>
	<ownKillingParams>
		<probabilityNoOverkill>0.2</probabilityNoOverkill>
		<probabilityWithOverkill>1</probabilityWithOverkill>
	</ownKillingParams>
	<playOnTargets>
		<skipBloodFx>false</skipBloodFx>
		<skipHitAnimations>false</skipHitAnimations>
	</playOnTargets>
	<useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>