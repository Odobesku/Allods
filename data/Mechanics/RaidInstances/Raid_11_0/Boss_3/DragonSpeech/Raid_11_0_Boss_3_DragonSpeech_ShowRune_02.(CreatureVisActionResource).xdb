<?xml version="1.0" encoding="UTF-8" ?>
<CreatureVisActionResource>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.IfAction">
        <condition type="client.SLON.IfBuffAttached">
          <buff href="/Mechanics/RaidInstances/Raid_11_0/Boss_3/DragonSpeech/Raid_11_0_Boss_3_DragonSpeech_Rune_02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
          <checkOnMainAvatar>false</checkOnMainAvatar>
        </condition>
        <onBreak>
          <breakEnabled>false</breakEnabled>
        </onBreak>
        <thenAction type="client.Replica.CreatureEffectsAction">
          <category>EFFECT_DEFAULT</category>
          <visualEffects>
            <Item>
              <delay>0</delay>
              <effectAnimations>
                <mode>DIE</mode>
              </effectAnimations>
              <effectFx href="/Spells/FX/Mobs/FireDragonNihazBoss_EmoteSpeech_Rune_02.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
              <fadeInTime>150</fadeInTime>
              <fadeOutTime>50</fadeOutTime>
              <scale>4</scale>
              <fixPoint>true</fixPoint>
              <lockScale>false</lockScale>
              <muteFxSounds>false</muteFxSounds>
              <ignoreParentRotation>true</ignoreParentRotation>
              <locator>Global</locator>
              <member>Default_Member</member>
              <offset x="0" y="0" z="0" />
              <rotation x="-10" y="0" z="0" w="0" />
              <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
            </Item>
          </visualEffects>
          <dontFade>false</dontFade>
          <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
          <stopOnDeath>false</stopOnDeath>
        </thenAction>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
</CreatureVisActionResource>