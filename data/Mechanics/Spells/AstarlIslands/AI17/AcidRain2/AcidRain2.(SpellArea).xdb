<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>183999</resourceId>
    </Header>
    <Name href="AcidRain2.txt" />
    <visualScripts href="AcidRain2Visual.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>1000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics type="gameMechanics.constructor.schemes.spell.SpellMechanics">
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>ACID</element>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                <damage>15</damage>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.StackBuffGeneric">
                <buff href="AcidDot.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <delta type="gameMechanics.elements.calcers.FloatData">
                    <value>1</value>
                </delta>
                <attachIfNotExist>true</attachIfNotExist>
            </Item>
        </targetImpacts>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
    </mechanics>
    <speed>20</speed>
    <maxTargets>6</maxTargets>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>40</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>