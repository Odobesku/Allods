<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<use>USE_RANDOM_FROM_LIST</use>
				<animations>
					<Item>attack</Item>
					<Item>attack01</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>100</delay>
						<effectFx href="/Spells/FX/Spells/WarriorCleaveAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<precastType>PRECAST_NONE</precastType>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="VisActionDelay">
					<time>150</time>
				</Item>
				<Item type="VisActionList">
					<play>Simultaneously</play>
					<elements>
						<Item type="CreatureEffectsAction">
							<visualEffects>
								<Item>
									<effectFx href="/Spells/FX/Spells/HitMelee.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								</Item>
							</visualEffects>
						</Item>
						<Item type="CreatureAnimationAction">
							<animations>
								<Item>hit</Item>
							</animations>
						</Item>
						<Item type="CreatureRunVisActionResource">
							<resource href="/Spells/VisScripts/HitPostFxOnTarget/HitFireShader.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
						</Item>
					</elements>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
