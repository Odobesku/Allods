<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readyUnarmed</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureColorAction">
						<colorValue>-1002356</colorValue>
						<ignoreDisable>true</ignoreDisable>
					</Item>
					<Item type="CreatureEnchantWeaponAction">
						<enchant href="/Spells/FX/InterfaceFX/MeleeRed.(EnchantTemplate).xdb" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<playWhile type="VisActionDelay">
					<time>3000</time>
				</playWhile>
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
					<Item type="CreatureLockRotationAction" />
					<Item type="VisActionList">
						<playWhile type="VisActionDelay">
							<time>750</time>
						</playWhile>
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/AI26_ChargeTarget.(VisObjectTemplate).xdb" />
										<scale>0.75</scale>
									</Item>
									<Item>
										<effectFx href="/Spells/FX/Spells/AI26_ChargeTarget.(VisObjectTemplate).xdb" />
										<scale>0.75</scale>
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<playWhile type="VisActionDelay">
			<time>2000</time>
		</playWhile>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>throwWeapon</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<advanced>
					<animationKeysAction>
						<Item>
							<action type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<offendTime type="EffectOffendConstDelay">
											<delay>500</delay>
										</offendTime>
									</Item>
								</visualEffects>
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
