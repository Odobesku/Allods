<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedPyro</Item>
				</animations>
				<advanced>
					<offendType>EVERYKEY_OFFEND</offendType>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>1500</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb" />
								<locator>Slot_Hand_L</locator>
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand.(VisObjectTemplate).xdb" />
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
					<name>spells/Paladin/Paladin63/Paladin63HolyGround_Start</name>
				</sound>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
