<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739932956</resourceId>
	</Header>
	<Name href="Shield.(BuffResource).Name.txt" />
	<Description href="Shield.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Mounts/SpellsMounts/ProtectTank.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Engineer/ProtectShield.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.DamageThreshold">
					<healthCalcer type="gameMechanics.elements.calcers.VariableValueCalcer">
						<variable href="ShieldAmount.(VariableResource).xdb" />
						<mul>0.5</mul>
					</healthCalcer>
					<outOfCombatPolicy>Nothing</outOfCombatPolicy>
					<barrierDamageFactor type="gameMechanics.elements.calcers.FloatData">
						<value>1</value>
					</barrierDamageFactor>
					<priority>ManaShield</priority>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.PostponedImpacts">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactVariableReset">
							<variable href="ShieldAmount.(VariableResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<duration>6000</duration>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
