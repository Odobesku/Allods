                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                                <quest href="/World/Quests/ZoneHadagan1/Quest_Lern_TropicalAtoll/Quest_Learn_TropicalAtoll2.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                <counterResource href="/World/Quests/ZoneHadagan1/Quest_Lern_TropicalAtoll/Quest_Learn_TropicalAtoll2.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                            </Item>
