	</Header>
	<image href="/Interface/Icons/Misc/Itemmall/CommonToken.(UISingleTexture).xdb" />
	<source>Vendor</source>
	<showItemContextAction>Never</showItemContextAction>
	<forceShowQuality>true</forceShowQuality>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb" />
	<functionalPart type="itemService.avatar.itemBag.UseItemChoice">
		<usages>
			<Item>
				<desc href="/Items/BoxSpecialLoot/Use.txt" />
				<image href="/Interface/Icons/Misc/Itemmall/CommonToken.(UISingleTexture).xdb" />
				<givenUnlock href="/Mechanics/Unlocks/DressSlots/Earring2Unlock1.xdb" />
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.constructor.basicElements.PredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateUnlock">
									<unlock href="/Mechanics/Unlocks/DressSlots/Earring2Unlock2.xdb" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateUnlock">
									<unlock href="/Mechanics/Unlocks/DressSlots/Earring2Unlock3.xdb" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateUnlock">
									<unlock href="/Mechanics/Unlocks/DressSlots/Earring2Unlock4.xdb" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateUnlock">
									<unlock href="/Mechanics/Unlocks/DressSlots/Earring2Unlock1.xdb" />
								</Item>
							</predicates>
						</predicate>
					</Item>
				</predicates>
				<actions>
					<Item type="itemService.avatar.itemBag.GrantUnlockTakeAction">
						<unlock href="/Mechanics/Unlocks/DressSlots/Earring2Unlock1.xdb" />
					</Item>
				</actions>
				<consumeItems>1</consumeItems>
				<maxStack>1</maxStack>
			</Item>
			<Item>
				<desc href="/Items/BoxSpecialLoot/Exchange.txt" />
				<image href="/Interface/Icons/Misc/Itemmall/UncommonToken.(UISingleTexture).xdb" />
				<givenItem href="UncommonTokenEar.xdb" />
				<resultItem type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
					<item href="UncommonTokenEar.xdb" />
				</resultItem>
				<actions>
					<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="UncommonTokenEar.xdb" />
						</item>
						<count type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
							<value>1</value>
						</count>
						<binding>Transfer</binding>
					</Item>
				</actions>
				<consumeItems>10</consumeItems>
			</Item>
		</usages>
		<predicates>
			<Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
				<minLevel type="gameMechanics.formulas.IntConstantValue">
					<value>4</value>
				</minLevel>
			</Item>
		</predicates>
		<useStack>true</useStack>
	</functionalPart>
	<requiredLevel>4</requiredLevel>
	<stackLimit>20</stackLimit>
	<quality href="/Mechanics/ItemQualities/Common.xdb" />
	<prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
