<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739852199</resourceId>
    </Header>
    <name href="AstralBombProjectile.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/AstralBomb.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>5000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Aura">
            <checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
            <radius>10</radius>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ExplosionWarning.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ExplosionWarning.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                </moveType>
                                <resource href="AstralBombExplosion.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                            </projectileData>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>