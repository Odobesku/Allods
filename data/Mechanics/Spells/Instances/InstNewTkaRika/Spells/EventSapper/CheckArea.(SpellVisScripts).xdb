<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/Omni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationOmniWand.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastAnimation>
            <LocatorNameOnTargets />
            <FXOnTargets />
            <CastAnimation>spellCastOmniWand</CastAnimation>
            <FixPointTarget>true</FixPointTarget>
            <LocatorOnTargets>Slot_FX</LocatorOnTargets>
            <LocatorNameOnCaster />
            <PreCastFX />
            <FixPointCaster>true</FixPointCaster>
            <FXPocket />
            <HitPostFXOnTargets />
        </Variables>
    </Header>
    <launch type="VisActionList">
        <elements>
            <Item skiped="" />
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/StalkerFlourBagAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <fixPoint var="FixPointCaster" />
                                <lockScale>true</lockScale>
                                <scale>1.33</scale>
                                <locator>Slot_Global</locator>
                                <locatorName var="LocatorNameOnCaster" />
                                <offendTime type="EffectOffendConstDelay" />
                            </Item>
                        </visualEffects>
                        <stopOnDeath>false</stopOnDeath>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>