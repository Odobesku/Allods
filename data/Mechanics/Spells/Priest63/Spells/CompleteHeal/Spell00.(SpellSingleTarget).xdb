<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739920002</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/InsuranceHealTrigger.xdb" />
		<Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
	<element>HOLY</element>
	<Name href="Spell00.(SpellSingleTarget).Name.txt" />
	<Description href="Spell00.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="value" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>HealScaler</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Priest/PriestAspectHeal.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Priest/CureWound.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>30</value>
	</range>
	<prepareDuration>3000</prepareDuration>
	<ranks>
		<Item href="Spell01.(SpellSingleTarget).xdb" />
		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceIf">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateVariableGreatThan">
						<resource href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
					</Item>
				</predicates>
				<resourceIf type="gameMechanics.elements.resources.ResourceVariable">
					<variable href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
					<sub>1</sub>
				</resourceIf>
				<resourceElse type="gameMechanics.elements.resources.ResourceVariable">
					<variable href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
					<sub>0</sub>
				</resourceElse>
			</Item>
		</casterResources>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactHeal">
						<heal var="value" />
						<scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
					</Item>
				</impacts>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
