<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.VisActionDelay">
						<visActionID>GolemVis</visActionID>
						<time>600</time>
					</Item>
					<Item type="client.Replica.VisActionChangeVisObject">
						<visActionID>GolemVis</visActionID>
						<newVisMob href="/Creatures/DemonTerminatorKirah/DemonTerminatorKirah_Scale1_5.(VisualMob).xdb#xpointer(/VisualMob)" />
						<getBody>true</getBody>
						<getDress>true</getDress>
					</Item>
					<Item type="client.SLON.WeatherCreatureVisAction">
						<params>
							<ambientSoundImpact>Nothing</ambientSoundImpact>
							<fadeTime>1</fadeTime>
							<light>
								<AmbientColor>-14859413</AmbientColor>
								<AmbientFactor>0.5</AmbientFactor>
								<ContourColor>-15396577</ContourColor>
								<DiffuseColor>-12710644</DiffuseColor>
								<FadeEnd>500</FadeEnd>
								<FadeStart>400</FadeStart>
								<FogColor>-16050139</FogColor>
								<FogEnd>400</FogEnd>
								<FogStart>-20</FogStart>
								<GrassContourColorMultiplier>-12639437</GrassContourColorMultiplier>
								<PointLightColor>-6858228</PointLightColor>
								<SelfIllumColor>-14867671</SelfIllumColor>
								<SpecularColor>-16777216</SpecularColor>
								<SpecularWaterColor>-16777216</SpecularWaterColor>
								<SunLightPitch>90</SunLightPitch>
								<SunLightYaw>45</SunLightYaw>
								<TerrainContourColor>-13886950</TerrainContourColor>
								<TerrainContourPower>7</TerrainContourPower>
								<TerrainSpecularColor>-15856114</TerrainSpecularColor>
								<WaterGradientEnd>-1</WaterGradientEnd>
								<WaterGradientStart>-1</WaterGradientStart>
								<desaturation>0</desaturation>
								<minAmbientOcclusionValue>0</minAmbientOcclusionValue>
								<objectsLightmapBias>0.0125</objectsLightmapBias>
								<terrainLightmapBias>0.01</terrainLightmapBias>
							</light>
							<posteffectFogSettings>
								<brightness>1</brightness>
								<color>-1</color>
								<colorUp>-1</colorUp>
								<densityDown>0</densityDown>
								<densityUp>0</densityUp>
								<distanceSettings>
									<falloff>0.5</falloff>
									<maxDistance>400</maxDistance>
									<minDistance>0</minDistance>
								</distanceSettings>
								<heightSettingsDown>
									<falloff>0.5</falloff>
									<maxHeight>50</maxHeight>
									<minHeight>-50</minHeight>
								</heightSettingsDown>
								<heightSettingsUp>
									<falloff>0.5</falloff>
									<maxHeight>50</maxHeight>
									<minHeight>-50</minHeight>
								</heightSettingsUp>
								<sunSettings>
									<brightness>0.2</brightness>
								</sunSettings>
								<use>false</use>
							</posteffectFogSettings>
							<priority>HIGH</priority>
							<skyMesh href="/World/Sky/Sky_Zone_9.0.2.(SkyMesh).xdb#xpointer(/SkyMesh)" />
							<hasLight>true</hasLight>
							<playInBuildings>false</playInBuildings>
						</params>
					</Item>
				</elements>
				<play>InSequence</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
			<Item type="client.Replica.Sound2DAction">
				<actionType>Simple</actionType>
				<musicSourceMaxRadius>0</musicSourceMaxRadius>
				<sound>
					<name>Ambience/OtherWorldMain</name>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/FMODProject)" />
				</sound>
				<forcedSoundStop>false</forcedSoundStop>
				<onlyForMainAvatar>false</onlyForMainAvatar>
				<resetGlobalParamsOnStop>true</resetGlobalParamsOnStop>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>