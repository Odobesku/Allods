<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Projectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationDirect.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastAnimation>
			<FXProjectile>/Spells/FX/Spells/AstralComet2_ProjectileRoot2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<LocatorNameOnTargets />
			<FXOnTargets />
			<CastAnimation>spellCastDirected</CastAnimation>
			<FixPointTarget>true</FixPointTarget>
			<LocatorNameOnCaster />
			<FXOnCaster />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<FXProjectileHit>/Spells/FX/Spells/HitAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
			<PreCastFX>/Spells/VisScripts/Prototypes/PreCastFXAstral.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastFX>
			<FixPointCaster>false</FixPointCaster>
			<FXWand>/Spells/FX/Spells/ReadySpellDirectAstralWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXWand>
			<FXPocket>/Spells/FX/Spells/PocketSpellAstral01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXPocket>
			<Ge>0</Ge>
			<HitPostFXOnTargets>/Spells/VisScripts/HitPostFxOnTarget/HitManaBurnShader.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</HitPostFXOnTargets>
			<MulyProjectile>true</MulyProjectile>
			<LocatorOnCaster>Slot_Hand_R</LocatorOnCaster>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureRunVisActionResource">
				<resource hrefvar="PreCastAnimation" />
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureRunVisActionResource">
				<resource hrefvar="PreCastFX" />
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="CastAnimation" />
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item type="VisActionList">
						<elements>
							<Item skiped="" />
							<Item type="CreatureProjectileAction">
								<pointOnCaster type="VisPointLocator">
									<locator var="LocatorOnCaster" />
								</pointOnCaster>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
