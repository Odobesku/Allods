<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>223006</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.CombatStateTrigger">
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectsDeferred">
                            <delay>4000</delay>
                            <delayExtensionMax>6000</delayExtensionMax>
                            <effects>
                                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="CleaveRes.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                    <tick>20000</tick>
                                </Item>
                            </effects>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <affectGroup>All</affectGroup>
                    <radius>20</radius>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="ColossusAssassin.(MobWorld).xdb" />
                                </mobs>
                            </Item>
                        </predicates>
                    </filter>
                    <holderImpactsIn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="ColossusUnity.(BuffResource).xdb" />
                        </Item>
                    </holderImpactsIn>
                    <holderImpactsOut>
                        <Item type="gameMechanics.elements.impacts.StackBuff">
                            <buff href="ColossusUnity.(BuffResource).xdb" />
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>-1</value>
                            </delta>
                        </Item>
                    </holderImpactsOut>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
            <quality href="/Mechanics/RaidInstances/FerrisRaid/Other/Part4_Stats.(MobStatQuality).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectNoAggroChecks" />
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>