<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>219755</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="Spell.(SpellSingleTarget).Name.txt" />
    <Description href="Spell.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/IMFireworkTarget.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <isAggro>false</isAggro>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>30000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.world.avatar.assistants.PredicateHasAssistant">
                <assistantResource href="/Mechanics/Spells/Engineer/MiniTurrets/MiniTurret.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicatesToAssistant">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                </predicates>
                <assistantResource href="/Mechanics/Spells/Engineer/MiniTurrets/MiniTurret.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
            </Item>
        </casterConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                        <impacts>
                            <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactsIf">
                                        <predicate type="gameMechanics.elements.predicates.PredicateIsAggroLeader" />
                                        <impactsElse>
                                            <Item type="gameMechanics.elements.impacts.ImpactResetActiveAction" />
                                        </impactsElse>
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impacts>
                                <assistantResource href="/Mechanics/Spells/Engineer/MiniTurrets/MiniTurret.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="TargetBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>