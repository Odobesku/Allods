<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739965387</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/ElementalSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftEliteSpells.(ActionGroup).xdb" />
    </groups>
    <element>FIRE</element>
    <Name href="RD_Elemental_Elite2_FireBall.(SpellArea).Name.txt" />
    <visualScripts href="RD_Elemental_Elite2_FireBall.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <minRange type="gameMechanics.elements.calcers.FloatData">
        <value>10</value>
    </minRange>
    <prepareDuration>1800</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>8000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>0.4</value>
                </chanceCalcer>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                        <spell href="RD_Elemental_Elite2_FireBall.(SpellArea).xdb" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/Rifts/Abilities/StopBuff.(BuffResource).xdb" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>FIRE</element>
                <damage>1</damage>
                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                        <Item type="gameMechanics.elements.scalers.ScalerIf">
                            <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                <quality href="/Mechanics/MobQualities/Elite.xdb" />
                            </condition>
                            <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
                                </mulCalcer>
                            </scalerIf>
                            <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                    <quality href="/Mechanics/MobQualities/Boss.xdb" />
                                </condition>
                                <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageElite.(CalcerFloatResource).xdb" />
                                    </mulCalcer>
                                </scalerIf>
                                <scalerElse type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageBoss.(CalcerFloatResource).xdb" />
                                    </mulCalcer>
                                </scalerElse>
                            </scalerElse>
                        </Item>
                    </scalers>
                </scaler>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>18</speed>
    <radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>