<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739934808</resourceId>
    </Header>
    <Name href="Pulling.(BuffResource).Name.txt" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/Engineer63_Pulling.(VisObjectTemplate).xdb" />
            <scale>0.8</scale>
            <locator>Slot_FX</locator>
            <offset x="0" y="0.1" />
        </Item>
    </visualEffects>
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpeedSetter">
            <speed>0.015</speed>
            <isExternal>true</isExternal>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectForcePull">
            <destination type="gameMechanics.map.destination.SelfPosDestination" />
            <impactsOnArrived>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Pulling.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>3</multiplier>
                            </durationScaler>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnArrived>
        </Item>
    </effects>
    <duration>2000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>