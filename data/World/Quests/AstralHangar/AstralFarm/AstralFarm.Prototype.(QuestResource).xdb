				<number>20</number>
			</Item>
			<Item>
				<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
					<item href="/Mechanics/Astral/AstralFarm/UnCommon/AstralFarmReward70.(ItemResource).xdb" />
				</item>
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
						<rule href="/Mechanics/Rules/HighEnd7/Season2.(RuleResource).xdb" />
					</Item>
				</predicates>
				<number>20</number>
			</Item>
			<Item>
				<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
					<item href="/Mechanics/Astral/AstralFarm/Rare/AstralFarmReward70.(ItemResource).xdb" />
				</item>
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
						<rule href="/Mechanics/Rules/HighEnd7/Season3.(RuleResource).xdb" />
					</Item>
				</predicates>
				<number>20</number>
			</Item>
			<Item>
				<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
					<item href="/Mechanics/Astral/AstralFarm/Epic/AstralFarmReward70.(ItemResource).xdb" />
