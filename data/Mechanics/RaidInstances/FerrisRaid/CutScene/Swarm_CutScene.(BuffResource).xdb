<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739911779</resourceId>
    </Header>
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/Camera_CutScene.(VisObjectTemplate).xdb" />
        </Item>
    </visualEffects>
    <visScript href="Swarm_CutScene.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.AddVisibilityRule">
                    <visibilityRule>
                        <channel>Visibility</channel>
                        <vector>Outgoing</vector>
                        <direction>Incoming</direction>
                        <plane href="InvisibleInCutscenes.(Plane).xdb" />
                        <action>DENY</action>
                    </visibilityRule>
                </Item>
                <Item type="gameMechanics.elements.effects.AddVisibilityRule">
                    <visibilityRule>
                        <channel>Influence</channel>
                        <vector>Outgoing</vector>
                        <direction>Incoming</direction>
                        <plane href="InvisibleInCutscenes.(Plane).xdb" />
                        <action>DENY</action>
                    </visibilityRule>
                </Item>
                <Item type="gameMechanics.elements.effects.AddVisibilityRule">
                    <visibilityRule>
                        <channel>Select</channel>
                        <vector>Outgoing</vector>
                        <direction>Incoming</direction>
                        <plane href="InvisibleInCutscenes.(Plane).xdb" />
                        <action>DENY</action>
                    </visibilityRule>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="InterfaceActive.(ClientData).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>FR_14</scriptID>
                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                </locator>
                                <yaw type="constructor.basicElements.AngleDegrees">
                                    <value>323</value>
                                </yaw>
                            </destination>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Projectile_Plane.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <object href="Swarm_Portal.(ProjectileResource).xdb" />
                            <pool href="CutScenePool.(SummonPool).xdb" />
                            <isPersonalPool>true</isPersonalPool>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/SwarmBuff.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Swarm_CutScene_1part.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>1405</scriptID>
                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                </locator>
                            </destination>
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="InterfaceDeactive.(ClientData).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Swarm_CutScene_1part.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Swarm_CutScene_2part.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Swarm_CutScene_3part.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Swarm_CutScene_4part.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Swarm_CutScene_5part.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Swarm_CutScene_6part.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="Cooldown_SwarmIntro.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Cooldown_SwarmIntro.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>1</multiplier>
                                    </durationScaler>
                                </Item>
                            </impactsElse>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>14_SoldierBoss</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Boss/AvatarsWatchingCutScene.(BuffResource).xdb" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobNear">
                                    <radius>10</radius>
                                    <mobs>
                                        <Item href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Allies/Rysina.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/SwarmBuff.(BuffResource).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="CutScenePool.(SummonPool).xdb" />
                            <isPersonalPool>true</isPersonalPool>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.DestinationLocator">
                                    <locator>
                                        <scriptID>14_RysinaLoc</scriptID>
                                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                    </locator>
                                </destination>
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                        <verticalRange min="0" max="0" />
                                        <horizontalRange min="1" max="5" />
                                    </Item>
                                </modifiers>
                            </destination>
                        </Item>
                    </impactsOff>
                </Item>
                <Item type="gameMechanics.elements.effects.AddPlane">
                    <plane href="Portal_CutScene_Plane.(Plane).xdb" />
                    <personalPlane>true</personalPlane>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>71500</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>