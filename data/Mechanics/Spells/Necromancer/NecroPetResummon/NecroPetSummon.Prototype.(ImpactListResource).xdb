<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>211043</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <SummonNecroPetHadagan />
            <SummonNecroPetUndead />
            <SummonNecroPetElf />
        </Variables>
    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactMatch">
            <cases>
                <Item>
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterRace">
                            <race href="/Mechanics/Races/Hadagan.xdb#xpointer(/gameMechanics.world.avatar.CharacterRace)" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource hrefvar="SummonNecroPetHadagan" />
                        </Item>
                    </impacts>
                </Item>
                <Item>
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterRace">
                            <race href="/Mechanics/Races/Undead.xdb#xpointer(/gameMechanics.world.avatar.CharacterRace)" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource hrefvar="SummonNecroPetUndead" />
                        </Item>
                    </impacts>
                </Item>
                <Item>
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterRace">
                            <race href="/Mechanics/Races/Elf.xdb#xpointer(/gameMechanics.world.avatar.CharacterRace)" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource hrefvar="SummonNecroPetElf" />
                        </Item>
                    </impacts>
                </Item>
                <Item>
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCharacterRace">
                            <race href="/Mechanics/Races/Kania.xdb#xpointer(/gameMechanics.world.avatar.CharacterRace)" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource hrefvar="SummonNecroPetKania" />
                        </Item>
                    </impacts>
                </Item>
            </cases>
            <defaultImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Groups/PetRelogEnforcer.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                </Item>
            </defaultImpacts>
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>