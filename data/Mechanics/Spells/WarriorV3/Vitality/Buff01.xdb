<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>219180</resourceId>
    </Header>
    <Name href="Buff_Name.txt" />
    <Description href="Buff_Desc.txt" />
    <image href="/Interface/Icons/Misc/Mobparts/HeartAnimal.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectIfOverTime">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                    <hideText>false</hideText>
                    <level>0.9</level>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.DirectHeal">
                    <heal>1</heal>
                    <threatMultiplier>1</threatMultiplier>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.05</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
                <Item type="gameMechanics.elements.impacts.StackBuff">
                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <resetTimer>false</resetTimer>
                    <anyRank>true</anyRank>
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>-1</value>
                    </delta>
                </Item>
            </impactsIf>
            <runImpactsOnEachTick>true</runImpactsOnEachTick>
            <affectOnStartTick>false</affectOnStartTick>
            <tick type="gameMechanics.elements.calcers.FloatData">
                <value>1000</value>
            </tick>
        </Item>
    </effects>
    <duration>0</duration>
    <isStackable>true</isStackable>
    <stackLimit>20</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>false</isMultiple>
    <canBeSaved>true</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ClassChangeBuffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>