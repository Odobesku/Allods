<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes2/Projectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationDirect.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastAnimation>
			<FxProjectile>/Spells/FX/Spells/MageFireballAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxProjectile>
			<FxOnTarget>/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTarget>
			<LocatorNameOnCaster />
			<LocatorOnTarget>Slot_FX</LocatorOnTarget>
			<PreCastFX>/Spells/VisScripts/Prototypes2/PreCastFX.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastFX>
			<DelayCasterFX>0</DelayCasterFX>
			<HitDelay>0</HitDelay>
			<FixPointCaster>false</FixPointCaster>
			<FXPocket />
			<Ge>0</Ge>
			<FxOnHands>/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<LocatorNameOnTarget />
			<FxOnCaster />
			<HitPostFxOnTarget />
			<LocatorOnCaster>Slot_Hand_L</LocatorOnCaster>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack02</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
			</Item>
			<Item type="CreatureProjectileAction">
				<pointOnCaster type="VisPointLocator">
					<locator>FROM_LOCATOR_NAME</locator>
					<locatorName>Hips</locatorName>
				</pointOnCaster>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
