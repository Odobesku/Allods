<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states>
		<Item>
			<action type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>idle</Item>
						</animations>
					</Item>
				</elements>
			</action>
		</Item>
		<Item>
			<action type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceVisActionChangeModel">
								<visObj href="/World/SacredLand/ZoneContested12/Models/ZC12_Doors.(VisObjectTemplate).xdb" />
							</Item>
						</elements>
					</Item>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceAnimationAction">
								<animations>
									<Item>death</Item>
								</animations>
							</Item>
						</elements>
					</Item>
					<Item type="DeviceVisActionList">
						<elements>
							<Item type="DeviceVisActionDelay">
								<time>2030</time>
							</Item>
							<Item type="DeviceAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>dead</Item>
								</animations>
							</Item>
						</elements>
					</Item>
				</elements>
			</action>
		</Item>
		<Item>
			<action type="DeviceVisActionList">
				<elements>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceVisActionChangeModel">
								<visObj href="/World/SacredLand/ZoneContested12/Models/ZC12_Doors.(VisObjectTemplate).xdb" />
							</Item>
						</elements>
					</Item>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>dead</Item>
								</animations>
							</Item>
						</elements>
					</Item>
				</elements>
			</action>
		</Item>
	</states>
	<defaultVisAction type="DeviceAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>idle</Item>
		</animations>
	</defaultVisAction>
</DeviceVisScripts>
