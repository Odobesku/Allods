        <Item>
            <delay>1200</delay>
            <effectFx href="/Spells/FX/Spells/WarriorCrueltyAbility_Eye.(VisObjectTemplate).xdb" />
            <locator>FROM_LOCATOR_NAME</locator>
            <locatorName>Slot_Eye_R</locatorName>
        </Item>
    </visualEffects>
    <visualPostEffects />
    <visualEffectsIncCount />
    <visualEffectsDecCount />
    <uiComponents />
    <descVars />
    <gainSpells />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectVariable">
                    <resource href="/Mechanics/Spells/CommonBuffs/Taunt/DamageCalcer.(VariableResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.effects.AbonentLostWatcher">
                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/Taunt/Taunt.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
                    <eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateOffenderIsOwner" />
                    </predicates>
                    <impacts>
                        <casterToTarget>
                            <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                <variable href="/Mechanics/Spells/CommonBuffs/Taunt/DamageCalcer.(VariableResource).xdb" />
                                <summand>-1</summand>
                            </Item>
                        </casterToTarget>
                        <casterToOffender />
                        <targetToOffender />
                    </impacts>
                    <scaleImpactsByDamage>true</scaleImpactsByDamage>
                </Item>
                <Item type="gameMechanics.elements.effects.ScalerOutDmgTargetDependent">
                    <scaler type="gameMechanics.elements.scalers.ScalerIf">
                        <binaryCondition type="gameMechanics.elements.predicates.PredicateNotMaster" />
                        <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>0.5</multiplier>
                        </scalerIf>
                    </scaler>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactSetTarget">
                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                        </Item>
                    </impactsOn>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                    </impactsOn>
                    <impactsOff />
                </Item>
                <Item type="gameMechanics.elements.effects.EffectForcedAggroLeader" />
            </effectsElse>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
