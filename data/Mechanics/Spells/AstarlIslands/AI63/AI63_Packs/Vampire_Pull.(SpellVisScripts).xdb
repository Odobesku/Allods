<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
                <channel>CHANNEL_HITCRITICAL</channel>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Spells/TrinketChannelShadow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <startPoint type="VisPointLocator">
                    <locator>Slot_Hand_R</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </endPoint>
            </Item>
            <Item type="CreatureRunActionOnSpellTargets">
                <targetAction type="CreatureEffectsAction">
                    <visualEffects>
                        <Item>
                            <effectFx href="/Spells/FX/Spells/TrinketChannelShadow_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                            <scale>0.5</scale>
                            <locator>Slot_BodyFX</locator>
                        </Item>
                    </visualEffects>
                </targetAction>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visActionID>Aura_White</visActionID>
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_White_R6m.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fadeOutTime>4</fadeOutTime>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>4000</delay>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Astral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    </Item>
                </visualEffects>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>4000</time>
                    </Item>
                    <Item type="VisActionStopAction">
                        <stoppedActionID>Aura_White</stoppedActionID>
                    </Item>
                </elements>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/HelpArrowMarker_Purple.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                        <scale>0.5</scale>
                        <offset x="0" y="-2" z="-1" />
                        <rotation y="25" z="90" />
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/HelpArrowMarker_Purple.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                        <scale>0.5</scale>
                        <offset y="2" z="-1" />
                        <rotation x="180" y="25" z="90" />
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/HelpArrowMarker_Purple.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                        <scale>0.5</scale>
                        <offset x="2" z="-1" />
                        <rotation x="90" y="25" z="90" />
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/HelpArrowMarker_Purple.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                        <scale>0.5</scale>
                        <offset x="-2" z="-1" />
                        <rotation x="270" y="25" z="90" />
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>