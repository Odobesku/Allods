<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739952539</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemortSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="Spell01.(SpellArea).Name.txt" />
    <Description href="Spell01.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>15</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>HealScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Engineer/EngineerTumba.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Engineer/RemortEngineer_Turret.(SpellVisScripts).xdb" />
    <sysName>CategoryRemort</sysName>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <targetType>STTPoint</targetType>
    <iffPolicy>Everyone</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>1000</duration>
            <scaler type="gameMechanics.elements.scalers.ScalerExternal">
                <scalerResource href="Turret.(ScalerResource).xdb" />
            </scaler>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHasPath">
                <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                <maxLength>85</maxLength>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateFaction">
                        <faction href="/World/Factions/League.xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Buff00.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>15</radius>
                                <affectGroup>Group</affectGroup>
                                <affectHolder>false</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.DispelMagic">
                                        <magics href="/Mechanics/Spells/Groups/Magics.xdb" />
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.world.creature.AliveFilter" />
                            </Item>
                        </impacts>
                        <assistantResource href="Healstation.(AssistantResource).xdb" />
                        <mobResource href="LeagueHealstation.(MobWorld).xdb" />
                        <level type="gameMechanics.elements.calcers.CalcerLevel" />
                        <linkMode>ModifiedHealth</linkMode>
                        <planeSyncStrategy>Sync</planeSyncStrategy>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Buff00.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>15</radius>
                                <affectGroup>Group</affectGroup>
                                <affectHolder>false</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.DispelMagic">
                                        <magics href="/Mechanics/Spells/Groups/Magics.xdb" />
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.world.creature.AliveFilter" />
                            </Item>
                        </impacts>
                        <assistantResource href="Healstation.(AssistantResource).xdb" />
                        <mobResource href="EmpireHealstation.(MobWorld).xdb" />
                        <level type="gameMechanics.elements.calcers.CalcerLevel" />
                        <linkMode>ModifiedHealth</linkMode>
                        <planeSyncStrategy>Sync</planeSyncStrategy>
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                <impactsResource href="/Mechanics/Spells/Remort/RemortSpellsCD.(ImpactListResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>