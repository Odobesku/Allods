<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>212506</resourceId>
    </Header>
    <name href="Ice_Stone_Projectile.(ProjectileResource).Name.txt" />
    <visObject href="Ice_Stone_Projectile_Vis.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0.01</altitude>
    <lifeLengthCap>8000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
                    <delay>7000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                            <radius>8</radius>
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>COLD</element>
                                    <damage>60</damage>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Ice_Stone_Freezing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Ice_Stone_Debuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>