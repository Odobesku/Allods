<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastOmni</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/PocketSpellIce01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<scale>2</scale>
				<fadeInTime>400</fadeInTime>
				<fadeOutTime>400</fadeOutTime>
				<locator>Slot_Hand_L</locator>
			</Item>
			<Item>
				<effectFx href="/Spells/FX/Spells/PocketSpellIce01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<scale>2</scale>
				<locator>Slot_Hand_R</locator>
			</Item>
		</visualEffects>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/ThrowBottleGas.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Spells/IceCometSmallExplosion.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<theGe>10</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator" />
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
