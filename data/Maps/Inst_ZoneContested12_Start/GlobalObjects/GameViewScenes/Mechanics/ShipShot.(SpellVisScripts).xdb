<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/AstralDirectDamage_Channel_Blue.(VisObjectTemplate).xdb" />
				<fxLength>160</fxLength>
				<startPoint type="VisPointLocator">
					<locator>Slot_TopFX</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<shift x="-30" y="-100" z="30" />
					<locator>Slot_Global</locator>
				</endPoint>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
