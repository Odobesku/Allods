<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739954953</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
        <Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/HumanoidSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftBossSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="RD_Humanoid_Boss1_MountedRoar.(SpellArea).Name.txt" />
    <visualScripts href="RD_Humanoid_Boss1_MountedRoar.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Rifts/RiftRandomMobs/HumanoidBoss1_Mounted.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="RD_Humanoid_Boss1_DinoAdd.(MobWorld).xdb" />
                        </mobs>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>SHADOW</element>
                <damage>1</damage>
                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageBoss.(CalcerFloatResource).xdb" />
                            </mulCalcer>
                        </Item>
                    </scalers>
                </scaler>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="RD_Humanoid_Boss1_MountedRoar_Debuff.(BuffResource).xdb" />
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>30</value>
        </angle>
    </shape>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>8</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>