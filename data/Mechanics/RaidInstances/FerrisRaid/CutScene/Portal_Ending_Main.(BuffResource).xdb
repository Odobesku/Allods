<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739918814</resourceId>
	</Header>
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Spells/Camera_CutScene.(VisObjectTemplate).xdb" />
		</Item>
	</visualEffects>
	<visScript href="Portal_Ending_Main.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Rotate</Item>
				<Item>Jump</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="Portal_CutScene_Plane.(Plane).xdb" />
			<personalPlane>true</personalPlane>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Portal_Ending.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="InterfaceActive.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>FR4_Start</scriptID>
							<map href="/Maps/FerrisRaid/MapResource.xdb" />
						</locator>
					</destination>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="InterfaceDeactive.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Portal_Ending.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Portal_Ending_CutScene_Part2.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Portal_Ending_CutScene_Part3.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Portal_Ending_CutScene_Part4.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="CutScenePool.(SummonPool).xdb" />
					<isPersonalPool>true</isPersonalPool>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Visibility</channel>
				<vector>Outgoing</vector>
				<direction>Incoming</direction>
				<plane href="InvisibleInCutscenes.(Plane).xdb" />
				<action>DENY</action>
			</visibilityRule>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Influence</channel>
				<vector>Outgoing</vector>
				<direction>Incoming</direction>
				<plane href="InvisibleInCutscenes.(Plane).xdb" />
				<action>DENY</action>
			</visibilityRule>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Select</channel>
				<vector>Outgoing</vector>
				<direction>Incoming</direction>
				<plane href="InvisibleInCutscenes.(Plane).xdb" />
				<action>DENY</action>
			</visibilityRule>
		</Item>
	</effects>
	<duration>44000</duration>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
