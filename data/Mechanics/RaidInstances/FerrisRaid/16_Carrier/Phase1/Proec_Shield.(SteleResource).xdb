<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
    <Header>
        <resourceId>221155</resourceId>
    </Header>
    <persistentParts>
        <Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.TickableEntityAura">
                    <affectGroup>All</affectGroup>
                    <radius>5</radius>
                    <filter type="gameMechanics.world.creature.CreatureFilter" />
                    <impactsIn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Proec_Player_Shield.(BuffResource).xdb" />
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Proec_Player_Shield.(BuffResource).xdb" />
                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                        </Item>
                    </impactsOut>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>5000</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.device.DeviceDie" />
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </persistentParts>
    <name href="Proec_Shield.(SteleResource).Name.txt" />
    <visObj href="/Spells/FX/Mobs/Nihil_Boss_ProtectiveDome.(VisObjectTemplate).xdb" />
    <interactiveObject>false</interactiveObject>
    <corpseDuration>300</corpseDuration>
    <corpseEmptyDuration>120</corpseEmptyDuration>
    <dropsPublicLoot>false</dropsPublicLoot>
</gameMechanics.world.device.SteleResource>