    <effects>
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>4</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <tick>1000</tick>
            <affectGroup>All</affectGroup>
            <radius>10</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        <Item type="gameMechanics.elements.predicates.PredicateMounted" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Mounts/Prototypes/ExoAntiDismount.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        <Item type="gameMechanics.elements.predicates.PredicateMounted" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                            <impactsResource href="/Mechanics/Mounts/Prototypes/ExoAntiDismount.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOut>
