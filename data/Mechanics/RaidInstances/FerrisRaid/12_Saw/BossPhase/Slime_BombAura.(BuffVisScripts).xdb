<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionLoopAction">
				<actionToLoop type="VisActionList">
					<play>InSequence</play>
					<playWhile type="VisActionDelay">
						<time>100</time>
					</playWhile>
					<elements>
						<Item type="VisActionList">
							<playWhile type="VisActionDelay">
								<time>50</time>
							</playWhile>
							<elements>
								<Item type="CreatureScaleAction">
									<scale>1.08</scale>
								</Item>
							</elements>
						</Item>
					</elements>
				</actionToLoop>
			</Item>
			<Item type="CreatureColorAction">
				<colorValue>-1130102</colorValue>
				<timeOn>0.3</timeOn>
				<timeOff>0.3</timeOff>
				<blendMode>DEFAULT</blendMode>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Slime_Danger.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_Global</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/AOEAura_Physical_4.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
