<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739814483</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
					</impacts>
					<spawnResource href="/Maps/AstralIsle46/SpawnTables/AstralIsle46/SummonSpy.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateHasAbility">
									<ability href="/Mechanics/Spells/AstarlIslands/AI46/Tresh/NoDamage.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
									<ability href="/Mechanics/Spells/AstarlIslands/AI46/Tresh/NoDamage.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<spawnResource href="/Maps/AstralIsle46/SpawnTables/AstralIsle46/SummonSpy.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
				</Item>
			</onEnter>
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactKill" />
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
										<mobs>
											<Item href="/Creatures/DemonScout/Instances/AstralIsle46/46_Add_Boss02.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
											<Item href="/Characters/Hadagan_male/Instances/AstralIsle46/DemonSpy.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
										</mobs>
									</Item>
								</predicates>
							</filter>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="SummonPool_46Boss02.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="Buff04.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="Buff03.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateOr">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											</Item>
										</predicates>
									</Item>
								</predicates>
							</filter>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>4000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
									<affectHolder>false</affectHolder>
									<impacts>
										<Item type="gameMechanics.elements.impacts.BuffDetacher">
											<buff href="Buff04.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
										<Item type="gameMechanics.elements.impacts.BuffDetacher">
											<buff href="Buff03.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</impacts>
									<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
										<predicates>
											<Item type="gameMechanics.constructor.basicElements.PredicateOr">
												<predicates>
													<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
													<Item type="gameMechanics.elements.resources.ResourceBuff">
														<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
													</Item>
												</predicates>
											</Item>
										</predicates>
									</filter>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactKill" />
					</impacts>
					<spawnResource href="/Maps/AstralIsle46/SpawnTables/AstralIsle46/SummonSpy.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
