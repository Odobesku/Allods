<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>idle</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideMode>OVERRIDE_STOP</channelOverrideMode>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>special</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
