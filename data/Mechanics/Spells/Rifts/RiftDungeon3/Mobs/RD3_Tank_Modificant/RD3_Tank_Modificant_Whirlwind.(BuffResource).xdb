<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739925015</resourceId>
    </Header>
    <Name href="RD3_Tank_Modificant_Whirlwind.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorWhirlwindUpgrade.(UISingleTexture).xdb" />
    <visScript href="RD3_Tank_Modificant_Whirlwind.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.5</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>8</radius>
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                        <scalers>
                                            <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageCommon.(CalcerFloatResource).xdb" />
                                                </mulCalcer>
                                            </Item>
                                        </scalers>
                                    </scaler>
                                    <minDamage>1</minDamage>
                                    <maxDamage>1</maxDamage>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>-1</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftAutoattack.(ActionGroup).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                    <spell href="RD3_Tank_Modificant_Whirlwind.(SpellArea).xdb" />
                    <duration>12000</duration>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>6000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>