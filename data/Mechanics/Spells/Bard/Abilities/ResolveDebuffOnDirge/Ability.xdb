<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>197402</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.Name.txt" />
    <description href="Ability.Description.txt" />
    <descVars>
        <Item>
            <name>time</name>
            <value var="time" />
        </Item>
        <Item>
            <name>coeff</name>
            <value var="coeff" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/Dirge.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerOutputDamageChannel">
            <element>SHADOW</element>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff var="coeff" />
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="/Mechanics/Spells/Marks/BardConsumeMagicFinish.xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff hrefvar="buff" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <majorEffect>-1</majorEffect>
    <level>1</level>
    <ranks>
        <Item href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability02.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability03.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
    <disableWhileDead>false</disableWhileDead>
    <saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>