<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>208912</resourceId>
    </Header>
    <visualScript type="CreatureAnimationAction">
        <animations>
            <Item>sleepUp</Item>
        </animations>
        <channel>CHANNEL_KNOCKDOWN</channel>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="RD2_Boss02_Plane.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>5000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                            <ability href="RD2_Boss02_Appears.(AbilityResource).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>