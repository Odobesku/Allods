<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>188239</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
            <impactsToTarget>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactPPM">
                                    <impact type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                            <value>0.25</value>
                                        </chanceCalcer>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                                <addresseeFinder type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
                                                <impacts>
                                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                        <buff href="PlagueDOT.(BuffResource).xdb" />
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </impact>
                                    <ppm>1</ppm>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsToTarget>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>