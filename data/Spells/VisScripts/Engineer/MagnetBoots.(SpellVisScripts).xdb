<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastOmni</Item>
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<advanced>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
							<offendType>EVERYKEY_ALLOFFENDS</offendType>
						</advanced>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Artillery</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastOmniEngineer</Item>
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<advanced>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
							<offendType>EVERYKEY_ALLOFFENDS</offendType>
						</advanced>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
