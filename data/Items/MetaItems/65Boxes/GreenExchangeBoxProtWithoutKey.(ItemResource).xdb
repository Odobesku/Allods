<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739906800</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<image href="/Interface/Icons/Misc/Chests/SkilledItemsBox.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<source>Vendor</source>
	<forceShowQuality>true</forceShowQuality>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.DropLootTakeAction">
						<lootTable hrefvar="lootTable" />
						<multiplier var="multiplier" />
					</Item>
					<Item type="itemService.avatar.itemBag.DropLootTakeAction">
						<lootTable hrefvar="lootTableAdd" />
					</Item>
				</actions>
				<consumeItems>1</consumeItems>
			</Item>
		</usages>
		<useStack>true</useStack>
	</functionalPart>
	<level>65</level>
	<requiredLevel>65</requiredLevel>
	<stackLimit>100</stackLimit>
	<quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
	<prices type="gameMechanics.constructor.schemes.item.prices.ExchangeItem" />
	<binding>BindOnPickup</binding>
	<description href="GreenExchangeBoxProtWithoutKey.(ItemResource).Description.txt" />
</gameMechanics.constructor.schemes.item.ItemResource>
