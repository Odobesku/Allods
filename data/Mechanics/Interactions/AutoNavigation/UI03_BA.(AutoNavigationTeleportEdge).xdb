        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                    <quest href="/World/Quests/UmoirIsland03/UI03_Quest02_1/UI03_Quest02_1.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                    <status>Started</status>
