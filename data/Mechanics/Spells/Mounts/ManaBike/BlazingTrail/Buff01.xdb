<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>204487</resourceId>
    </Header>
    <Name href="Buff01.Name.txt" />
    <Description href="Buff01.Description.txt" />
    <image href="/Interface/Icons/Mounts/ManaBikeTrail.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectMountSpeedModifier">
                    <effectScaler type="gameMechanics.elements.scalers.ExponentialEffectScaler">
                        <base>0.75</base>
                    </effectScaler>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.ExponentialEffectScaler">
                <base>0.5</base>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>FIRE</element>
                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>0.02</mul>
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer href="/Mechanics/GameRoot/Mount/MountBaseDamageCalcer.(CalcerFloatResource).xdb#xpointer(/constructor.elements.CalcerFloatResource)" />
                        </mulCalcer>
                    </scaler>
                    <damage>1</damage>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
    </effects>
    <duration>4000</duration>
    <isHelpful>false</isHelpful>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>