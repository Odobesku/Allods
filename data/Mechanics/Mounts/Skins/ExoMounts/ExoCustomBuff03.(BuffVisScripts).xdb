<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<Header>
		<Variables>
			<Scale_ElfFemale>1.2</Scale_ElfFemale>
			<Scale_ElfMale>1.1</Scale_ElfMale>
			<Scale_HadaganFemale>1.2</Scale_HadaganFemale>
			<Scale_HadaganMale>1.2</Scale_HadaganMale>
			<Scale_KaniaFemale>1.2</Scale_KaniaFemale>
			<Scale_KaniaMale>1.2</Scale_KaniaMale>
