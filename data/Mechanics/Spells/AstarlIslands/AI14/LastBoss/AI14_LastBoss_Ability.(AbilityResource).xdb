<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>193857</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>DoorLast1</scriptID>
                        <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Close</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>DoorLast2</scriptID>
                        <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Close</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>DoorLast3</scriptID>
                        <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Close</switchType>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="SP.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="AI14_Buffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>FakeBoss</scriptID>
                        <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllAggro" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>DoorLast2</scriptID>
                        <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Open</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>DoorLast1</scriptID>
                        <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Open</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>DoorLast3</scriptID>
                        <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.device.DoorSwitch">
                            <switchType>Open</switchType>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHeads">
                            <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                    <table href="/Maps/AstralIsle14/SpawnTables/AstralIsle14/LastSpawn.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </onLeave>
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.RandomDestination">
                                        <destinations>
                                            <Item type="gameMechanics.map.destination.DestinationLocator">
                                                <locator>
                                                    <scriptID>LastBossAdd1</scriptID>
                                                    <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                                </locator>
                                            </Item>
                                            <Item type="gameMechanics.map.destination.DestinationLocator">
                                                <locator>
                                                    <scriptID>LastBossAdd2</scriptID>
                                                    <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                                </locator>
                                            </Item>
                                            <Item type="gameMechanics.map.destination.DestinationLocator">
                                                <locator>
                                                    <scriptID>LastBossAdd3</scriptID>
                                                    <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                                </locator>
                                            </Item>
                                            <Item type="gameMechanics.map.destination.DestinationLocator">
                                                <locator>
                                                    <scriptID>LastBossAdd4</scriptID>
                                                    <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                                </locator>
                                            </Item>
                                        </destinations>
                                    </destination>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                    </impacts>
                                    <object href="LastBossAddElem.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <pool href="SP.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>30000</tick>
                    <initialDelay>15000</initialDelay>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>FakeBoss</scriptID>
                        <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>teleport</scriptID>
                        <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </device>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>