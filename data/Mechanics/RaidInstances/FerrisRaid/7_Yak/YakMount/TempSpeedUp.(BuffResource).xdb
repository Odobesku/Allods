<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739901633</resourceId>
    </Header>
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpeedSetter">
            <speed>0.0065</speed>
            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>0.09</mul>
                <mulCalcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                    <buff href="MountSpeedStackable.(BuffResource).xdb" />
                </mulCalcer>
                <sum>1</sum>
            </scalerTarget>
            <useMountSpeedLimit>true</useMountSpeedLimit>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="TempSpeedUp.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>1450</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>