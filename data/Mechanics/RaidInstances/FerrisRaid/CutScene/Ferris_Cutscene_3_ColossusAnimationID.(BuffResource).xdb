<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739916708</resourceId>
	</Header>
	<visScript href="Ferris_Cutscene_3_ColossusAnimation.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="Portal_CutScene_Plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
			<personalPlane>true</personalPlane>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>7000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
							<device>
								<scriptID>CutScene_portal_Ferris</scriptID>
								<map href="/Maps/Ferris4/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
							</device>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.map.destination.RelativePos" />
								</moveType>
								<resource href="CutScene_PortalOpeningID.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
							</projectileData>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Ferris_Cutscene_3.5_ColossusAnimationID.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impacts>
		</Item>
	</effects>
	<duration>15000</duration>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
