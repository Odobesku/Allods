<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739866179</resourceId>
    </Header>
    <Name href="Pulse.(BuffResource).Name.txt" />
    <Description href="Pulse.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffURGoldenPulse.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="Pulse.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                    <impact type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>11</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>HOLY</element>
                                <damage>7</damage>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.creature.AvatarFilter" />
                    </impact>
                    <count type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                        <buff href="Pulse.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <forAllRanks>true</forAllRanks>
                    </count>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Pulse.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onLeave>
        </Item>
    </effects>
    <duration>8000</duration>
    <stackLimit>50</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>