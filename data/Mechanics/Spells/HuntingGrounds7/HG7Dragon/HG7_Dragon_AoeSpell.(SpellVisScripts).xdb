<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="HG7_Dragon_AoeDecal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>2.5</scale>
                    </Item>
                    <Item>
                        <effectFx href="HG7_Dragon_aoe_precastAura.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>2.5</scale>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>readySpell</Item>
                </animations>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/GorinichSmall_Corrupted_SpellCastOmni_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>1.5</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>