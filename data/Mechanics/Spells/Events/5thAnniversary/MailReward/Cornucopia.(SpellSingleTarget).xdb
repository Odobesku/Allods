<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739883927</resourceId>
    </Header>
    <Name href="Cornucopia.(SpellSingleTarget).Name.txt" />
    <Description href="Cornucopia.(SpellSingleTarget).Description.txt" />
    <visualScripts href="Cornucopia.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>1000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>72000000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>4</value>
                </minLevel>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                        <minLevel type="gameMechanics.formulas.MaxLevelConstant" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactStartQuiz">
                        <question href="Cornucopia.(Question).xdb#xpointer(/gameMechanics.world.quiz.Question)" />
                        <participants type="gameMechanics.elements.addresseeFinders.AddressesCalcerSingle">
                            <calcer type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                        </participants>
                        <resultsHandler type="gameMechanics.elements.common.SingleResultHandler">
                            <impactsOnSuccess>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                                            <lhs type="gameMechanics.elements.calcers.CalcerLongParam">
                                                <paramName>choice</paramName>
                                            </lhs>
                                            <rhs type="gameMechanics.elements.calcers.LongData">
                                                <value>0</value>
                                            </rhs>
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateHasItemsCount">
                                            <items>
                                                <Item href="Cornucopia.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                            </items>
                                            <totalCount>1</totalCount>
                                            <checkDress>false</checkDress>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                            <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                                                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                                    <item href="/Items/Mechanics/Ammo/AmmoEpicIM.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                                </item>
                                            </item>
                                            <count>1000</count>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
                                            <item href="Cornucopia.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                                            <spell href="Cornucopia.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impactsOnSuccess>
                            <impactsOnFail>
                                <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                                    <spell href="Cornucopia.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                                </Item>
                            </impactsOnFail>
                        </resultsHandler>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                <item href="PowerFood_Present.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                            </item>
                        </item>
                        <count>20</count>
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>