<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739855136</resourceId>
    </Header>
    <Name href="BonusBox60LvL.(SpellSingleTarget).Name.txt" />
    <Description href="BonusBox60LvL.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Fairy/Prayer.(SpellVisScripts).xdb" />
    <prepareDuration>3000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.MaxLevelConstant" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                        <key href="/System/ContentKeys/P2P_shard/P2P_shard_Server.(ContentKey).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/Items/IMCurrencies/WorldChat/IMWorldChat_P2P.(ItemResource).xdb" />
                        </item>
                        <count>3</count>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/ItemMall/Scrolls/Rituals/Myrrh1000.xdb" />
                        </item>
                        <count>265</count>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
                        <item href="BonusBoxMaxLevel.(ItemResource).xdb" />
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/ItemMall/Sales/Box/Item/05_2012_Coupon_Box.(ItemResource).xdb" />
                        </item>
                        <count>50</count>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>1000</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                <data href="SkilledBox/ThisItemNotForever.(ClientData).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactFeedFairy">
                        <foodItem href="BonusBoxMaxLevel.(ItemResource).xdb" />
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>