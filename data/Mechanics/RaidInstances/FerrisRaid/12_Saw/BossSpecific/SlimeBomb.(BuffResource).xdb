<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739907599</resourceId>
    </Header>
    <Name href="SlimeBomb.(BuffResource).Name.txt" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>3000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.TickableEntityAura">
                    <affectGroup>Enemies</affectGroup>
                    <radius>4</radius>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <blinking>true</blinking>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                                <buff href="SlimeTarget.(BuffResource).xdb" />
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                            <radius>10</radius>
                                            <affectGroup>Enemies</affectGroup>
                                            <affectHolder>false</affectHolder>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.PureDamage">
                                                    <damage>1</damage>
                                                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                            <multiplier>0.9</multiplier>
                                                        </mulCalcer>
                                                    </scalerTarget>
                                                </Item>
                                            </impacts>
                                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                            <data href="/Mechanics/RaidInstances/FerrisRaid/12_Saw/BossPhase/HitPoisonBig.(ClientData).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIn>
                </Item>
            </effects>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>