<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureHoldWeaponAction">
				<hold>WEAPON_NONE</hold>
			</Item>
			<Item type="CreatureHideMountVisAction" />
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ElfNecklace_root.(VisObjectTemplate).xdb" />
						<locator>Slot_Hand_R</locator>
						<member>Caster</member>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/GadgetChannel.(VisObjectTemplate).xdb" />
				<startPoint type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
					<member>Caster</member>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_TopFX</locator>
				</endPoint>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/DrinkPotion.(VisObjectTemplate).xdb" />
						<scale>0.6</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureVisActionPlayOnUsedDevice">
				<action type="DeviceVisActionList">
					<play>Simultaneously</play>
					<elements>
						<Item type="DeviceVisEffectsAction">
							<visualEffects>
								<Item>
									<effectFx href="/Spells/FX/Spells/DrinkPotion.(VisObjectTemplate).xdb" />
								</Item>
							</visualEffects>
						</Item>
						<Item type="DeviceChannelAction">
							<channelingFx href="/Spells/FX/Spells/GadgetChannel.(VisObjectTemplate).xdb" />
							<startPoint type="VisPointLocator">
								<locator>Slot_TopFX</locator>
							</startPoint>
							<endPoint type="VisPointFromEventClientDataPlus">
								<fromTarget>true</fromTarget>
							</endPoint>
						</Item>
					</elements>
				</action>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
