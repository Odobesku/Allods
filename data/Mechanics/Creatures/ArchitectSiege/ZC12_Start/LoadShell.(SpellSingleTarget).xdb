<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739922120</resourceId>
    </Header>
    <Name href="LoadShell.(SpellSingleTarget).Name.txt" />
    <Description href="LoadShell.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/AstralIslands/ZC12/Siege_LoadShell.(SpellVisScripts).xdb" />
    <prepareDuration>1000</prepareDuration>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="ReadyToFire.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="ShellLoaded.(BuffResource).xdb" />
                        <consumeStacks>5</consumeStacks>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="ReadyToFire.(BuffResource).xdb" />
                        <stacks type="gameMechanics.elements.calcers.FloatData">
                            <value>1</value>
                        </stacks>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="ShellLoaded.(BuffResource).xdb" />
                        <stacks type="gameMechanics.elements.calcers.FloatData">
                            <value>1</value>
                        </stacks>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                            <value>0.25</value>
                        </chanceCalcer>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="ReadyToFire.(BuffResource).xdb" />
                                <stacks type="gameMechanics.elements.calcers.FloatData">
                                    <value>1</value>
                                </stacks>
                            </Item>
                        </impacts>
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>