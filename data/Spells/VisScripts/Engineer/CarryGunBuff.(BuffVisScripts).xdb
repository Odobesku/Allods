<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="CreatureReplaceAnimationsAction">
		<onTop>
			<animationsReplacements>
				<Item>
					<play>spellCastDirectedEngineer</play>
					<forAnimations>
						<Item>spellCastDirected</Item>
					</forAnimations>
				</Item>
				<Item>
					<play>walkBackwardsEngineer</play>
					<forAnimations>
						<Item>walkBackwards</Item>
					</forAnimations>
				</Item>
				<Item>
					<play>readySpellDirectedEngineer</play>
					<forAnimations>
						<Item>readySpellDirected</Item>
					</forAnimations>
				</Item>
				<Item>
					<play>walkEngineer</play>
					<forAnimations>
						<Item>walk</Item>
					</forAnimations>
				</Item>
				<Item>
					<play>jumpLandRunEngineer</play>
