<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readySpellDirected</Item>
		</animations>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/MageLightningBallsAbility.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb" />
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_BodyFX</locator>
						</pointOnTarget>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>