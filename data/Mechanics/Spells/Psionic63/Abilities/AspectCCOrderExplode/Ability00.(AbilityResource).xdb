<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739925150</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability00.(AbilityResource).Name.txt" />
	<description href="Ability00.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="duration" />
		</Item>
		<Item>
			<name>var1</name>
			<value>-100</value>
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mul>-1</mul>
				<mulCalcer type="gameMechanics.elements.calcers.FloatData">
					<value>1</value>
				</mulCalcer>
				<sum var="factor" />
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Psionic/EssenceOfThought.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/CC/Buff01.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
					<spell href="/Mechanics/Spells/Psionic63/Spells/Projection/Spell01.(SpellSingleTarget).xdb" />
					<factor var="factor" />
				</Item>
				<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
					<mark href="/Mechanics/Spells/Psionic63/Spells/Projection/ExplodeDamage.(MarkResource).xdb" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
							<impacts>
