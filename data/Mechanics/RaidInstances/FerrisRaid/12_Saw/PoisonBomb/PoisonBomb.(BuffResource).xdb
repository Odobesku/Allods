<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739906087</resourceId>
	</Header>
	<Name href="PoisonBomb.(BuffResource).Name.txt" />
	<Description href="PoisonBomb.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Potions/Poison04.(UISingleTexture).xdb" />
	<visualEffects />
	<visScript href="PoisonBomb.(BuffVisScripts).xdb" />
	<interfaceHighPriority>true</interfaceHighPriority>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>10</radius>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.constructor.basicElements.PredicateNot">
													<predicate type="gameMechanics.elements.resources.ResourceBuff">
														<buff href="SlimePoison.(BuffResource).xdb" />
													</predicate>
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
													<impacts>
														<Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
															<spawn>
																<scriptID>FR_12_Boss</scriptID>
																<map href="/Maps/FerrisRaid/MapResource.xdb" />
															</spawn>
															<impacts>
																<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
																	<impacts>
																		<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
																			<element>POISON</element>
																			<damage>20</damage>
																			<impactsOnHitTarget>
																				<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
																					<predicates>
																						<Item type="gameMechanics.elements.resources.ResourceBuff">
																							<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
																						</Item>
																					</predicates>
																					<impacts>
																						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																							<buff href="PoisonBomb.(BuffResource).xdb" />
																						</Item>
																					</impacts>
																				</Item>
																			</impactsOnHitTarget>
																			<scaler type="gameMechanics.elements.scalers.MagicScaler" />
																		</Item>
																	</impacts>
																</Item>
															</impacts>
														</Item>
													</impacts>
												</Item>
											</impactsIf>
											<impactsElse>
												<Item type="gameMechanics.elements.impacts.BuffDetacher">
													<buff href="SlimePoison.(BuffResource).xdb" />
												</Item>
											</impactsElse>
										</Item>
									</impactsIf>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
											<mobs>
												<Item href="/Mechanics/RaidInstances/FerrisRaid/12_Saw/SawBoss.(MobWorld).xdb" />
											</mobs>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
											<predicates>
												<Item type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
												</Item>
											</predicates>
											<impacts>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="PoisonBuff_HM.(BuffResource).xdb" />
												</Item>
											</impacts>
											<elseImpacts>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="PoisonBuff.(BuffResource).xdb" />
												</Item>
											</elseImpacts>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.CreatureFilter" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="PoisonExplosion.(ClientData).xdb" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsIfCaster">
			<predicates>
				<Item type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.MagicDoT">
					<parameters>
						<tickLength>1000</tickLength>
						<damagePerTick>15</damagePerTick>
						<affectOnStartTick>true</affectOnStartTick>
					</parameters>
					<element>POISON</element>
					<scaler type="gameMechanics.elements.scalers.MagicScaler" />
				</Item>
			</effectsIf>
		</Item>
	</effects>
	<duration>6000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<isAE>true</isAE>
	<groups>
		<Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
