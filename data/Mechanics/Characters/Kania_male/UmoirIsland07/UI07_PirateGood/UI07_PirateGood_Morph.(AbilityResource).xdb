					<buff href="/Mechanics/Spells/CommonBuffs/Fear/Buff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>5</multiplier>
					</durationScaler>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="/World/Quests/UmoirIsland07/UI07_Quest3/UI07_MadPirate.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				</Item>
			</onEnter>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
