                    <time>1500</time>
                </playWhile>
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visActionID>eff</visActionID>
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/Paladin63_SymbolOfLight_Hand.(VisObjectTemplate).xdb" />
                                <effectAlias href="" />
                                <lockScale>true</lockScale>
                                <locator>Slot_Hand_L</locator>
                                <offendTime />
                            </Item>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/Paladin63_SymbolOfLight_Hand.(VisObjectTemplate).xdb" />
                                <effectAlias href="" />
                                <lockScale>true</lockScale>
                                <locator>Slot_Hand_R</locator>
                                <offendTime />
                            </Item>
                        </visualEffects>
                    </Item>
                    <Item type="CreatureRunVisActionResource">
                        <alias href="" />
                        <resource href="/Spells/VisScripts/Prototypes/PreCastAnimationOmni.(CreatureVisActionResource).xdb" />
                    </Item>
