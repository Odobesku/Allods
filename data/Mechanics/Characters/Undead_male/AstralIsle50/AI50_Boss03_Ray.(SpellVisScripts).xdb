<?xml version ="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <visActionID></visActionID>
        <elements>
            <Item type="CreatureAnimationAction">
                <visActionID></visActionID>
                <advanced>
                    <autoHasten>
                        <mode>AUTOHASTEN_NONE</mode>
                        <timeToBeLeft>0</timeToBeLeft>
                    </autoHasten>
                    <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                    <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                    <offendType>NO_OFFEND</offendType>
                    <turnToTarget>TURN_DEFAULT</turnToTarget>
                    <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                    <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
                    <denyAutoHasten>false</denyAutoHasten>
                    <disableRandomFirstFrame>true</disableRandomFirstFrame>
                    <eventPlaybackEnd>false</eventPlaybackEnd>
                    <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                    <stopIfMoved>false</stopIfMoved>
                    <stopIfRotated>false</stopIfRotated>
                </advanced>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
                <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                <mode>LOOP</mode>
                <specialController></specialController>
                <use>USE_ANIMATIONS</use>
                <dontFreezePrecast>true</dontFreezePrecast>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <visActionID></visActionID>
                <channelingFx href="/Spells/FX/Spells/BattleStation_FireRay.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                <endPoint type="VisPointLocator">
                    <from>FROM_DEFALUT</from>
                    <locator>Slot_FX</locator>
                    <locatorName></locatorName>
                    <member>Default_Member</member>
                </endPoint>
                <fadeInTime>0</fadeInTime>
                <fadeOutTime>0</fadeOutTime>
                <fxLength>14</fxLength>
                <multyTargetMode>FromCaster</multyTargetMode>
                <offendTime type="EffectOffendConstDelay">
                    <delay>0</delay>
                </offendTime>
                <secondaryTargetParams>
                    <fadeInTime>0</fadeInTime>
                    <fadeOutTime>0</fadeOutTime>
                    <fxLength>2</fxLength>
                    <scaleTextureU>false</scaleTextureU>
                    <scaleTextureV>false</scaleTextureV>
                </secondaryTargetParams>
                <startPoint type="VisPointLocator">
                    <from>FROM_DEFALUT</from>
                    <locator>Slot_Mouth</locator>
                    <locatorName></locatorName>
                    <member>Default_Member</member>
                </startPoint>
                <velocity>50</velocity>
                <scaleTextureU>false</scaleTextureU>
                <scaleTextureV>false</scaleTextureV>
            </Item>
            <Item type="CreatureEffectsOnTarget">
                <visActionID></visActionID>
                <category>EFFECT_DEFAULT</category>
                <visualEffects>
                    <Item>
                        <delay>230</delay>
                        <effectAnimations>
                            <mode>DIE</mode>
                        </effectAnimations>
                        <effectFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>500</fadeOutTime>
                        <scale>0.75</scale>
                        <fixPoint>false</fixPoint>
                        <lockScale>true</lockScale>
                        <muteFxSounds>false</muteFxSounds>
                        <ignoreParentRotation>false</ignoreParentRotation>
                        <locator>Slot_FX</locator>
                        <locatorName></locatorName>
                        <member>Default_Member</member>
                        <offset x="0" y="0" z="0"/>
                        <rotation x="0" y="0" z="0" w="0"/>
                        <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                    </Item>
                </visualEffects>
                <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                <stopOnDeath>false</stopOnDeath>
                <direction></direction>
            </Item>
            <Item type="CreatureFixedTimeProjectileAction">
                <visActionID></visActionID>
                <explosionFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                <pointOnCaster type="VisPointLocator">
                    <from>FROM_DEFALUT</from>
                    <locator>Global</locator>
                    <locatorName></locatorName>
                    <member>Mount</member>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <from>FROM_DEFALUT</from>
                    <locator>Slot_FX</locator>
                    <locatorName></locatorName>
                    <member>Default_Member</member>
                </pointOnTarget>
                <projectileFx href="/Spells/FX/Mobs/GlowYellowWeak.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                <isInverted>false</isInverted>
                <isMultyProjectile>false</isMultyProjectile>
                <count>33</count>
                <throwDuration>0</throwDuration>
                <waitDuration>600</waitDuration>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </actionBarStart>
    <precastType>PRECAST_DEFAULT</precastType>
    <ownKillingParams>
        <probabilityNoOverkill>0.2</probabilityNoOverkill>
        <probabilityWithOverkill>1</probabilityWithOverkill>
    </ownKillingParams>
    <playOnTargets>
        <skipBloodFx>false</skipBloodFx>
        <skipHitAnimations>false</skipHitAnimations>
    </playOnTargets>
    <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>
