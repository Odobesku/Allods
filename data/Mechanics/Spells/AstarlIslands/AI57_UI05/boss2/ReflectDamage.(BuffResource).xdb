<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739857183</resourceId>
	</Header>
	<Name href="ReflectDamage.(BuffResource).Name.txt" />
	<Description href="ReflectDamage.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Bard/IncreaseDamageOnCC.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<nameTemplate href="ReflectDamage.(BuffResource).Name.txt" />
	<descTemplate href="ReflectDamage.(BuffResource).Description.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDamageTrigger">
			<impacts>
				<targetToOffender>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="BalanceDamageVisual.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.PureDamage">
								<damage>1</damage>
								<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
									<scalers>
										<Item type="gameMechanics.elements.scalers.LinearScaler">
											<multiplier>2</multiplier>
										</Item>
									</scalers>
								</scaler>
								<scalerTarget type="gameMechanics.elements.scalers.TrivialScaler" />
							</Item>
						</impactsIf>
					</Item>
				</targetToOffender>
			</impacts>
			<scaleImpactsByDamage>true</scaleImpactsByDamage>
		</Item>
	</effects>
	<duration>10000</duration>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
