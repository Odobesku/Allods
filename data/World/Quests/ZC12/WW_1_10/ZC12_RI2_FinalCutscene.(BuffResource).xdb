                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="/Maps/ZC12_RiftInstance2/SpawnTables/ZC12_RI2_Defence_Enemies2.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="/Maps/ZC12_RiftInstance2/SpawnTables/ZC12_RI2_ZemEngineer2.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="/Maps/ZC12_RiftInstance2/SpawnTables/ZC12_RI2_MinersCutscene.(SpawnTable).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>1000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                                            <destination type="gameMechanics.map.destination.DestinationLocatorSpread">
                                                <locator>
                                                    <scriptID>ZC12_RI2_Path12</scriptID>
                                                    <map href="/Maps/ZC12_RiftInstance2/MapResource.xdb" />
                                                </locator>
                                                <horizontalSpread>10</horizontalSpread>
                                            </destination>
                                            <runningMode>true</runningMode>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>WW_Rift2_exit</scriptID>
                            <map href="/Maps/ZC12/MapResource.xdb" />
                        </locator>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="ZC12_RI2_FinalCutsceneExplosion.(ClientData).xdb" />
                            <locators>
                                <Item>
                                    <scriptID>ZC12_RI2_MinersGoMiddle</scriptID>
                                    <map href="/Maps/ZC12_RiftInstance2/MapResource.xdb" />
                                </Item>
                            </locators>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="ZC12_RI2_FinalCutsceneExplosion.(ClientData).xdb" />
                            <locators>
                                <Item>
                                    <scriptID>ZC12_RI2_MinersGoLeft</scriptID>
                                    <map href="/Maps/ZC12_RiftInstance2/MapResource.xdb" />
                                </Item>
                            </locators>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="ZC12_RI2_FinalCutsceneExplosion.(ClientData).xdb" />
                            <locators>
                                <Item>
                                    <scriptID>ZC12_RI2_MinersGoRight</scriptID>
                                    <map href="/Maps/ZC12_RiftInstance2/MapResource.xdb" />
                                </Item>
                            </locators>
                        </Item>
                    </impactsOn>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>500</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                    <spawn>
                                        <scriptID>ZC12_RI2_CoastDoor</scriptID>
                                        <map href="/Maps/ZC12_RiftInstance2/MapResource.xdb" />
                                    </spawn>
                                    <impacts>
                                        <Item type="gameMechanics.elements.device.DoorSwitch">
                                            <switchType>Open</switchType>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>ZC12_RI2_MinersGoMiddle</scriptID>
                                    <map href="/Maps/ZC12_RiftInstance2/MapResource.xdb" />
                                </locator>
                            </destination>
                            <finishImpacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>500</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
