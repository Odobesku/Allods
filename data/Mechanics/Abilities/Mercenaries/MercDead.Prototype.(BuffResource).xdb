<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739821953</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <MercDead />
            <ImpactListResummonCombat />
        </Variables>
    </Header>
    <image href="" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
            <delay>0</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateAssistantInhabits">
                                    <assistant hrefvar="assistant" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff hrefvar="MercDead" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                    <impactsResource hrefvar="ImpactListResummonCombat" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.ReviveTrigger">
            <impactsOnRevive>
                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                    <impactsResource hrefvar="ImpactListResummonCombat" />
                </Item>
            </impactsOnRevive>
        </Item>
    </effects>
    <duration>0</duration>
    <isStackable>false</isStackable>
    <stackLimit>1</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>false</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <canBeSaved>true</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>