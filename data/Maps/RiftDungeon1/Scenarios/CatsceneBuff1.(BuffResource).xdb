<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739922047</resourceId>
    </Header>
    <visScript href="CatsceneBuff1.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>