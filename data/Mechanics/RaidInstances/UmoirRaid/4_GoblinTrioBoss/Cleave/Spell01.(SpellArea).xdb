												<Item href="/Mechanics/RaidInstances/UmoirRaid/4_GoblinTrioBoss/Goblin03Boss.(MobWorld).xdb" />
											</mobs>
										</predicate>
									</Item>
									<Item type="gameMechanics.elements.predicates.PredicateCreature" />
								</predicates>
								<impactsIf>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="Buff01.(BuffResource).xdb" />
										<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
											<multiplier>4</multiplier>
										</durationScaler>
									</Item>
								</impactsIf>
							</Item>
						</impactsElse>
					</Item>
				</impacts>
				<shape type="gameMechanics.constructor.schemes.spell.area.Cone">
					<angle type="constructor.basicElements.AngleDegrees">
