<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739854767</resourceId>
    </Header>
    <name href="FireAoE.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/World/FirePuddle_2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0.01</altitude>
    <lifeLengthCap>15000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <affectGroup>Enemies</affectGroup>
            <radius>6</radius>
            <delayIn>2000</delayIn>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </filter>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="DamageBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="DamageBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="DamageBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>