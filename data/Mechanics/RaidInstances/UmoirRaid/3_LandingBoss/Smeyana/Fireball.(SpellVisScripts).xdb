<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<scale>2</scale>
			</Item>
			<Item>
				<effectFx href="/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<scale>2.5</scale>
				<locator>Slot_Hand_L</locator>
			</Item>
		</visualEffects>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>special01</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Fireball_AOE_projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="/Spells/FX/Spells/HitFireball.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<theGe>8</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_L</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
