<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739930176</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="ShieldBuff.(BuffResource).Name.txt" />
	<Description href="ShieldBuff.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Paladin/PaladinBlessedShield.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Spells/PaladinLightInfusionAbility.(VisObjectTemplate).xdb" />
			<fadeInTime>200</fadeInTime>
			<fadeOutTime>400</fadeOutTime>
			<locator>FROM_LOCATOR_NAME</locator>
			<locatorName>Slot_BodyFX</locatorName>
		</Item>
	</visualEffects>
	<effects>
		<Item type="gameMechanics.elements.effects.DamageAbsorber">
			<elements>
				<Item>PHYSICAL</Item>
				<Item>SHADOW</Item>
				<Item>FIRE</Item>
				<Item>COLD</Item>
				<Item>LIGHTNING</Item>
				<Item>HOLY</Item>
				<Item>ASTRAL</Item>
				<Item>POISON</Item>
				<Item>DISEASE</Item>
				<Item>ACID</Item>
			</elements>
			<absorb>1</absorb>
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
					<calcers>
						<Item type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</Item>
						<Item type="constructor.elements.CalcerFloatExternal">
							<externalCalcer href="/Mechanics/Spells/Paladin63/Abilities/EndurePainHeal/BiggestBarrierDamageAmount.(CalcerFloatResource).xdb" />
						</Item>
					</calcers>
				</mulCalcer>
			</scaler>
			<buff hrefvar="buff" />
			<scaledByCasterStats>true</scaledByCasterStats>
		</Item>
	</effects>
	<duration>5000</duration>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<ranks>
		<Item href="ShieldBuff01.(BuffResource).xdb" />
		<Item href="ShieldBuff02.(BuffResource).xdb" />
		<Item href="ShieldBuff03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
