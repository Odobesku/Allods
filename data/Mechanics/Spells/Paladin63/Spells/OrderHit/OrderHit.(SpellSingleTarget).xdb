								</Item>
								<Item type="gameMechanics.elements.scalers.ScalerIf">
									<condition type="gameMechanics.elements.predicates.PredicateVariableGreatThan">
										<resource href="/Mechanics/Spells/Paladin63/Abilities/Canons/PurityCanon.(VariableResource).xdb" />
									</condition>
									<scalerIf type="gameMechanics.elements.scalers.LinearScaler">
										<multiplier>1</multiplier>
									</scalerIf>
									<scalerElse type="gameMechanics.elements.scalers.LinearScaler">
										<multiplier>0.5</multiplier>
									</scalerElse>
								</Item>
							</scalers>
						</scaler>
						<avgDamage>1</avgDamage>
					</Item>
				</impacts>
				<groupRepeaters>true</groupRepeaters>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
