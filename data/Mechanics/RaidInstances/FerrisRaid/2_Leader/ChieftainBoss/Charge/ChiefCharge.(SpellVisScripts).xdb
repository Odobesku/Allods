<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>2250</time>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>special</Item>
				</animations>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
