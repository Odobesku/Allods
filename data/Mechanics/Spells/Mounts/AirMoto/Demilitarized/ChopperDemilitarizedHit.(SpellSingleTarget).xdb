<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739965614</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/TwoSeaterMount.(ActionGroup).xdb" />
    </groups>
    <Name href="ChopperDemilitarizedHit.(SpellSingleTarget).Name.txt" />
    <Description href="ChopperDemilitarizedHit.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/EngineerFireShot.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mount/BattleStation_FireRay.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>3000</prepareDuration>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Everyone</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>60000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateOnAddressee">
                                <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateTrue" />
                                </predicates>
                                <assertOnCantFind>false</assertOnCantFind>
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateBinaryWrapper">
                                <master type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
                                <slave type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                                <binary type="gameMechanics.elements.predicates.PredicateNotMaster" />
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateOnAddressee">
                            <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateTrue" />
                            </predicates>
                            <assertOnCantFind>false</assertOnCantFind>
                        </predicate>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Hit.(BuffResource).xdb" />
                </predicate>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Hit.(BuffResource).xdb" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>