			<collisionUncommon>/Ships/Components/InternalShield_01A/InternalShield_01A.(Collision).xdb#xpointer(/Collision)</collisionUncommon>
			<visObjRare>/Ships/Components/InternalShield_01B/InternalShield_01B.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</visObjRare>
			<collisionRare>/Ships/Components/InternalShield_01B/InternalShield_01B.(Collision).xdb#xpointer(/Collision)</collisionRare>
