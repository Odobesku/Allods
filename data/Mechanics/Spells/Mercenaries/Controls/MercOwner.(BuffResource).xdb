<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>295255046</resourceId>
    </Header>
    <Name href="MercOwner.(BuffResource)_Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <nameTemplate href="MercOwner.(BuffResource)_Name.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectAddContextActions">
            <actions>
                <Item href="Attack/Attack.(SpellSingleTarget).xdb" />
                <Item href="Retreat/Retreat.(SpellArea).xdb" />
                <Item href="Move/Move.(SpellArea).xdb" />
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="Retreat/MercRetreatPlane.(Plane).xdb" />
                <personalPlane>true</personalPlane>
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="Retreat/MercRetreatPlane.(Plane).xdb" />
                <personalPlane>true</personalPlane>
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="Retreat/MercRetreatPlane.(Plane).xdb" />
                <personalPlane>true</personalPlane>
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="NoRegenSignaled.(BuffResource).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                        <affectGroup>Friends</affectGroup>
                                        <affectHolder>false</affectHolder>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                                <group href="/Mechanics/Spells/Groups/MercRegen.(ActionGroup).xdb" />
                                            </Item>
                                        </impacts>
                                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="MercUnderControl.(BuffResource).xdb" />
                                                </Item>
                                            </predicates>
                                        </filter>
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="NoRegenSignaled.(BuffResource).xdb" />
                            </Item>
                        </impactsIf>
                    </Item>
                </casterToTarget>
            </impacts>
        </Item>
    </effects>
    <stackLimit>5</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>