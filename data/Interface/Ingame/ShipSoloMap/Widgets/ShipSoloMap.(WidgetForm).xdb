<?xml version="1.0" encoding="UTF-8" ?>
<WidgetForm>
	<Name>ShipSoloMap</Name>
	<Children>
		<Item href="Map.(WidgetPanel).xdb" />
		<Item href="Sign.(WidgetTextView).xdb" />
		<Item href="Ship.(WidgetPanel).xdb" />
		<Item href="Object.(WidgetPanel).xdb" />
		<Item href="ModArea.(WidgetPanel).xdb" />
	</Children>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<HighPos>50</HighPos>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<HighPos>40</HighPos>
		</Y>
	</Placement>
	<PickChildrenOnly>true</PickChildrenOnly>
	<clipContent>false</clipContent>
</WidgetForm>
