<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>199739</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/Resurrection.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <element>SHADOW</element>
    <Name href="Spell.(SpellSingleTarget).Name.txt" />
    <Description href="Spell.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Paladin/PaladinCleanse.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Druid/Revival.(SpellVisScripts).xdb" />
    <nameTemplate href="Spell.(SpellSingleTarget).NameTemplate.txt" />
    <descTemplate href="Spell.(SpellSingleTarget).DescTemplate.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <level>2</level>
    <prepareDuration>10000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <isAggro>false</isAggro>
    <isWorkOnDead>true</isWorkOnDead>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            <Item type="gameMechanics.elements.predicates.PredicateIsDead" />
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateResurrectActive" />
            </Item>
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>184</mana>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.Resurrect">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactBaseHealth">
                        <healthMultiplier>0.6</healthMultiplier>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactBaseMana">
                        <manaMultiplier>0.6</manaMultiplier>
                        <customManaMultipliers>
                            <Item>
                                <manaType>Energy</manaType>
                                <multiplier>0.6</multiplier>
                            </Item>
                        </customManaMultipliers>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Buff.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="/Mechanics/Spells/CommonSpells/TeleportToResurrecter/Druid.(ImpactListResource).xdb" />
                    </Item>
                </impacts>
                <timeOut>30000</timeOut>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>