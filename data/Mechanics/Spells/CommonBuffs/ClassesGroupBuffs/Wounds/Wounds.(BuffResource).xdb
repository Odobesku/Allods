<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>200418</resourceId>
    </Header>
    <Name href="Wounds.(BuffResource).Name.txt" />
    <Description href="Wounds.(BuffResource).Description02.txt" />
    <image href="/Interface/Icons/CommonState/Debuff_Wounds.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/ClassesGroupBuffs/Wounds.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <affectsPureHeal>true</affectsPureHeal>
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.4</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                    <value>1</value>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsToPet">
            <effects>
                <Item type="gameMechanics.elements.effects.IncomingHealModifier">
                    <affectsPureHeal>true</affectsPureHeal>
                    <priority>Multiplier</priority>
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>-0.4</coeff>
                    </scaler>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsToAllAssistants">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
                            <affectsPureHeal>true</affectsPureHeal>
                            <priority>Multiplier</priority>
                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                <coeff>-0.4</coeff>
                            </scaler>
                        </Item>
                    </effectsIf>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CommonDebuffs.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/Wounds.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>