<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739931771</resourceId>
	</Header>
	<visualScripts href="/Spells/VisScripts/Exploits/UseStanding.(ExploitVisScripts).xdb" />
	<isExploit>true</isExploit>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>5</value>
	</range>
	<prepareDuration>3000</prepareDuration>
	<targetType>STTCurrentTargetNotSelf</targetType>
	<iffPolicy>Everyone</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
								<quest href="WW_1_5.xdb" />
								<status>Started</status>
							</Item>
							<Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
								<quest href="WW_1_5.xdb" />
								<counterResource href="Counter1.(QuestCountId).xdb" />
							</Item>
						</predicates>
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
						<quest href="WW_1_5.xdb" />
						<status>Completed</status>
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
						<quest href="WW_1_5.xdb" />
						<status>Finished</status>
					</Item>
				</predicates>
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactTeleport">
				<destination type="gameMechanics.map.destination.DestinationLocator">
					<locator>
						<scriptID>WW_1_5_Tower</scriptID>
						<map href="/Maps/ZC12/MapResource.xdb" />
					</locator>
				</destination>
				<finishImpacts>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
								<quest href="WW_1_5.xdb" />
								<status>Started</status>
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
								<id href="Counter1_1.(QuestCountId).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactSummon">
								<destination type="gameMechanics.map.destination.DestinationLocator">
									<locator>
										<scriptID>WW_1_5_mob</scriptID>
										<map href="/Maps/ZC12/MapResource.xdb" />
									</locator>
								</destination>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
										<impacts>
											<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
												<buff href="Sniper_vis.(BuffResource).xdb" />
											</Item>
											<Item type="gameMechanics.elements.impacts.ImpactIsolator">
												<impacts>
													<Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
														<impacts>
															<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																<buff href="Sniper_vis.(BuffResource).xdb" />
															</Item>
														</impacts>
														<assistantResource href="Quest_assistant.(AssistantResource).xdb" />
													</Item>
												</impacts>
											</Item>
										</impacts>
									</Item>
									<Item type="gameMechanics.elements.impacts.ForceAggro" />
								</impacts>
								<object href="/Creatures/ArchitectSiege/Instances/ZC12/WW_1_5_Architect_sniper.(MobWorld).xdb" />
								<pool href="Sniper.(SummonPool).xdb" />
								<isPersonalPool>true</isPersonalPool>
							</Item>
						</impactsIf>
					</Item>
				</finishImpacts>
			</Item>
		</casterImpacts>
	</mechanics>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
