<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739932962</resourceId>
    </Header>
    <visualScript type="VisActionList">
        <elements>
            <Item type="CreatureReplaceAnimationAction">
                <action>RUN</action>
                <newAnimation>runEngineer</newAnimation>
            </Item>
            <Item type="CreatureReplaceAnimationAction">
                <action>IDLE_SPECIAL</action>
                <newAnimation>idleEngineer</newAnimation>
            </Item>
        </elements>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectModifyHealthRegen" />
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>Enemies</affectGroup>
            <radius>30</radius>
            <filter type="gameMechanics.world.creature.MobFilter" />
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/Wild.xdb" />
                </Item>
            </predicates>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                            <value>100</value>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value>0.3</value>
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactMobChat">
                                    <msg href="/Maps/RiftDungeon3/Scenarios/RiftDungeon3_Scenario_goal6_Engineers.(TextMessage).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Mechanics/Spells/Rifts/RiftDungeon3/Mobs/RD3_Engineer/RD3_Engineer_Death.(ClientData).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>