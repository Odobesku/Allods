    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDoesNotAggro" />
        <Item type="gameMechanics.elements.effects.EffectNoAggro" />
        <Item type="gameMechanics.elements.effects.EffectNoAggroChecks" />
        <Item type="gameMechanics.elements.effects.LifeGuard">
