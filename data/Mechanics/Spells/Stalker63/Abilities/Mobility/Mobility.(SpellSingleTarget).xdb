<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739975735</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Mobility.(SpellSingleTarget).Name.txt" />
    <Description href="Mobility.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>range</name>
            <value var="range" />
        </Item>
        <Item>
            <name>cast1</name>
            <value var="cast1" />
        </Item>
        <Item>
            <name>dmg</name>
            <value var="dmg" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Stalker/Rush.(UISingleTexture).xdb" />
    <targetType>STTSelf</targetType>
    <isWorkOnDead>true</isWorkOnDead>
    <ranks>
        <Item href="Mobility01.xdb" />
        <Item href="Mobility02.xdb" />
        <Item href="Mobility03.xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                        <spell href="Mobility01.xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
                        <spell href="Mobility01.xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="Save.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellActivate">
                        <spell hrefvar="spell" />
                        <effects>
                            <Item type="gameMechanics.constructor.basicElements.EffectList">
                                <effectsResource hrefvar="effectsResource" />
                            </Item>
                        </effects>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Save.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
                <spell href="/Mechanics/Spells/Stalker63/Spells/Targeting/Spell01.(SpellSingleTarget).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                <spell href="/Mechanics/Spells/Stalker63/Spells/Targeting/Spell01.(SpellSingleTarget).xdb" />
                <duration>5000</duration>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="/Mechanics/Spells/Stalker63/Spells/Targeting/Save.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>