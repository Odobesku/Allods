<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739906486</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                    <data href="/Mechanics/RaidInstances/FerrisRaid/Voice/11_Clone_Elf/20_TankSummoned.(ClientData).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/Voice/VoiceCooldown.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>7000</multiplier>
                                    </durationScaler>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <spawnResource href="/Maps/FerrisRaid/SpawnTables/11_ElfCloneMan.(SpawnTable).xdb" />
                </Item>
            </onEnter>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.5</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>ElfClone_FinalFaze</scriptID>
                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                    <finishImpacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                            <delay>750</delay>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impacts>
                                        </Item>
                                    </finishImpacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>ElfClone_FinalFaze</scriptID>
                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                    <object href="/Mechanics/RaidInstances/FerrisRaid/11_Clone_Elf/ElfOnTank/ElfOnTank.(MobWorld).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                                <locator>
                                                    <scriptID>ElfClone_FinalFaze</scriptID>
                                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                </locator>
                                            </destination>
                                            <finishImpacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                    <delay>750</delay>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </finishImpacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <spawnResource href="/Maps/FerrisRaid/SpawnTables/11_ElfCloneMan.(SpawnTable).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>5000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="TeleportVisual.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>45000</tick>
                    <initialDelay>45000</initialDelay>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsIfTargetGeneric">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
                            <conditionalImpacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/Voice/VoiceCooldown.(BuffResource).xdb" />
                                                        </Item>
                                                    </predicates>
                                                    <impactsElse>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                                                            <impacts>
                                                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                                                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                                                    <data href="/Mechanics/RaidInstances/FerrisRaid/Voice/11_Clone_Elf/40_DeathRay.(ClientData).xdb" />
                                                                                </Item>
                                                                            </impacts>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/Voice/VoiceCooldown.(BuffResource).xdb" />
                                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                        <multiplier>7000</multiplier>
                                                                    </durationScaler>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impactsElse>
                                                </Item>
                                            </impacts>
                                            <spawnResource href="/Maps/FerrisRaid/SpawnTables/11_ElfCloneMan.(SpawnTable).xdb" />
                                        </Item>
                                    </impacts>
                                    <conditions>
                                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                            <spells>
                                                <Item href="Ray.(SpellSingleTarget).xdb" />
                                            </spells>
                                        </Item>
                                    </conditions>
                                </Item>
                            </conditionalImpacts>
                            <stages>
                                <Item>Start</Item>
                            </stages>
                        </Item>
                    </effectsIf>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.51</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/Voice/VoiceCooldown.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>1.2e+006</multiplier>
                                    </durationScaler>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <spawnResource href="/Maps/FerrisRaid/SpawnTables/11_ElfCloneMan.(SpawnTable).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="PrepareRay.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="PrepareRay.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Start</Item>
            </stages>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>