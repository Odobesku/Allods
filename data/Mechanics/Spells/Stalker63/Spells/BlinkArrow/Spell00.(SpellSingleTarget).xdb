<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739931985</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
    </groups>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Spell00.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/BlinkArrow.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Stalker/BlinkArrow.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>0</prepareDuration>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration var="cooldown" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateEquipped">
                <dressType>RANGED</dressType>
                <weaponRequired>true</weaponRequired>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Stalker63/Abilities/MaterielResource/MaterielResource.(VariableResource).xdb" />
                <sub>4</sub>
            </Item>
        </casterResources>
        <casterImpacts />
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                        <destination type="gameMechanics.map.destination.DestinationModified">
                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                            <modifiers>
                                <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                    <verticalRange min="1" max="2" />
                                    <horizontalRange min="0" max="1" />
                                    <randomVerticalDirection>false</randomVerticalDirection>
                                </Item>
                                <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                            </modifiers>
                        </destination>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>40</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>