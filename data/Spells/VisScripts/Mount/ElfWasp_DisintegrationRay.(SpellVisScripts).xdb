<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>InSequence</play>
		<elements>
			<Item type="CreatureSetFlagAction">
				<flagName>Flag_MountNeeded</flagName>
				<timeOut>0.5</timeOut>
			</Item>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Flag_Emote</flagName>
				</playWhile>
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<elements>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureAnimationAction">
								<use>USE_ANIMATIONS</use>
								<animations>
									<Item>attack</Item>
								</animations>
								<channel>CHANNEL_DEFAULT</channel>
								<advanced>
									<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
									<offendType>NO_OFFEND</offendType>
									<stopIfMoved>true</stopIfMoved>
									<eventPlaybackEnd>true</eventPlaybackEnd>
									<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
								</advanced>
							</Item>
							<Item type="VisActionList">
								<play>Simultaneously</play>
								<playWhile type="VisActionDelay">
									<time>2000</time>
								</playWhile>
								<elements>
									<Item type="CreatureChannelDirectAction">
										<channelingFx href="/Spells/FX/Mobs/MountWasp_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<fxLength>20</fxLength>
										<startPoint type="VisPointLocator">
											<locator>FROM_LOCATOR_NAME</locator>
											<member>Mount</member>
											<locatorName>Slot_Special03</locatorName>
										</startPoint>
										<endPoint type="VisPointLocator">
											<locator>Slot_FX</locator>
											<member>Assaulter</member>
										</endPoint>
										<offendTime type="EffectOffendConstDelay">
											<delay>300</delay>
										</offendTime>
										<multyTargetMode>Umbrella</multyTargetMode>
										<secondaryTargetParams>
											<fxLength>20</fxLength>
											<offendTime type="EffectOffendConstDelay" />
										</secondaryTargetParams>
									</Item>
								</elements>
							</Item>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Mobs/MountWasp_ChannelCast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<scale>1.2</scale>
										<locator>FROM_LOCATOR_NAME</locator>
										<member>Mount</member>
										<locatorName>Hips</locatorName>
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/HitFireball.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<fixPoint>true</fixPoint>
					<lockScale>true</lockScale>
					<locator>Slot_Global</locator>
					<member>Assaulter</member>
				</Item>
			</visualEffects>
			<stopOnDeath>false</stopOnDeath>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
