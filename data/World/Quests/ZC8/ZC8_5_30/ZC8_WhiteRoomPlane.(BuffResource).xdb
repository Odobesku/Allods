<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>320175</resourceId>
    </Header>
    <Name href="ZC8_WhiteRoomPlane.(BuffResource)_Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <nameTemplate href="ZC8_WhiteRoomPlane.(BuffResource)_Name.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="ZC8_WhiteRoomPlane.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>ZC8_OutsideTemple</scriptID>
                                    <map href="/Maps/IllusionWorld/MapResource.xdb" />
                                </locator>
                            </destination>
                            <finishImpacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ZC8_WhiteRoomPlane.(BuffResource).xdb" />
                                </Item>
                            </finishImpacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
            <impactsOnLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ZC8_WhiteRoomPlane.(BuffResource).xdb" />
                </Item>
            </impactsOnLeave>
            <activeZone href="/Maps/IllusionWorld/Zones/ZC8/ZC8_WhiteRoom.(ZoneResource).xdb" />
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>