<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>517580</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/RareBox..(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <source>FixedDrop</source>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <usages>
            <Item>
                <predicate type="itemService.mail.predicates.PredicateAnd">
                    <predicates>
                        <Item type="itemService.mail.predicates.PredicateNot">
                            <predicate type="itemService.mail.predicates.PredicateLevelGE">
                                <level>63</level>
                            </predicate>
                        </Item>
                        <Item type="itemService.mail.predicates.PredicateLevelGE">
                            <level>15</level>
                        </Item>
                    </predicates>
                </predicate>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                        <item type="gameMechanics.constructor.schemes.item.QualityItemProvider">
                            <item type="gameMechanics.constructor.schemes.item.LevelItemProvider">
                                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                    <item href="Ring.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                </item>
                                <level>0</level>
                            </item>
                            <quality href="/Mechanics/ItemQualities/Rare.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
                        </item>
                        <count type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                            <value>1</value>
                        </count>
                        <binding>Transfer</binding>
                        <modifiers>
                            <Item type="itemService.avatar.itemBag.AvatarLevelModifier" />
                        </modifiers>
                    </Item>
                </actions>
                <consumeItems>0</consumeItems>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                        <minLevel type="gameMechanics.formulas.IntConstantValue">
                            <value>15</value>
                        </minLevel>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                            <minLevel type="gameMechanics.formulas.IntConstantValue">
                                <value>63</value>
                            </minLevel>
                        </predicate>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                        <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
                            <hideText>true</hideText>
                            <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                                <hideText>true</hideText>
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceSpecificItem">
                                        <hideText>true</hideText>
                                        <item href="Ring.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                        <predicates>
                                            <Item type="gameMechanics.elements.item.ItemPredicateLevel">
                                                <range>
                                                    <max>65</max>
                                                </range>
                                            </Item>
                                        </predicates>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasItem">
                                        <hideText>true</hideText>
                                        <slotType>PrimaryDress</slotType>
                                        <predicates>
                                            <Item type="gameMechanics.constructor.schemes.item.ItemPredicateOneOf">
                                                <items>
                                                    <Item href="Ring.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                                </items>
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                            </predicate>
                        </predicate>
                        <clientData href="HasRing.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>15</value>
                </minLevel>
            </Item>
        </predicates>
    </functionalPart>
    <level>15</level>
    <requiredLevel>15</requiredLevel>
    <quality href="/Mechanics/ItemQualities/Uncommon.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <binding>BindOnPickup</binding>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="BeltLevelBox.(ItemResource).Name.txt" />
    <description href="BeltLevelBox.(ItemResource).Description.txt" />
</gameMechanics.constructor.schemes.item.ItemResource>