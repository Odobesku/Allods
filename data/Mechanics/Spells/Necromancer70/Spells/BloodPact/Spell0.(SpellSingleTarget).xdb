<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>198731</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/AmmoSpells.(ActionGroup).xdb" />
    </groups>
    <element>SHADOW</element>
    <Name href="Spell0_Name.txt" />
    <Description href="Spell0_Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>3</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                    <dressSlot>AMMO</dressSlot>
                </mulCalcer>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value>35</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerDarkPower.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Necromancer/BloodPact_Spell.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>1</duration>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>-20000</mul>
                <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                    <dressSlot>AMMO</dressSlot>
                </mulCalcer>
                <sum var="cd" />
            </scaler>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateEquipped">
                        <dressType>AMMO</dressType>
                        <itemClass href="/Mechanics/ItemClasses/Other_InfiniteTeardrop.(ItemClass).xdb" />
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.constructor.basicElements.ResourceUniversal" />
                <resourceElse type="gameMechanics.elements.resources.ResourceDressItem">
                    <slot>AMMO</slot>
                    <count>5</count>
                </resourceElse>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                <impacts>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.SendImpactsToAddresseeFromCaster">
                                <addresseeFinder type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactSetForcedAggroLeader">
                                                <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                                <instantiateOnTarget>true</instantiateOnTarget>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <impactsFromTarget>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Death.(BuffResource).xdb" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mul>3</mul>
                            <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                <dressSlot>AMMO</dressSlot>
                            </mulCalcer>
                        </durationScaler>
                    </Item>
                </impactsFromTarget>
                <traceDown>true</traceDown>
                <assistantResource href="Hand.(AssistantResource).xdb" />
                <mobResource href="Hand.(MobWorld).xdb" />
                <level type="gameMechanics.elements.calcers.CalcerLevel" />
                <linkMode>Health</linkMode>
                <planeSyncStrategy>Sync</planeSyncStrategy>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>