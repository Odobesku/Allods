<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739912100</resourceId>
    </Header>
    <Name href="KissTheToad.(SpellSingleTarget).Name.txt" />
    <Description href="KissTheToad.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Special/Emoticons/OvertipIcons/Kiss.(UISingleTexture).xdb" />
    <visualScripts href="/Mechanics/Spells/ItemSpells/IMFireworks/Kiss/Kiss.(SpellVisScripts).xdb" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                <spawn>
                    <scriptID>toad_dance</scriptID>
                    <map href="/Maps/AstralIsle68/MapResource.xdb" />
                </spawn>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                        <destination type="gameMechanics.map.destination.DestinationLocator">
                            <locator>
                                <scriptID>dance_toad</scriptID>
                                <map href="/Maps/AstralIsle68/MapResource.xdb" />
                            </locator>
                        </destination>
                        <finishImpacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="ToadDance.(BuffResource).xdb" />
                            </Item>
                        </finishImpacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="KissTheToad.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                                <zone href="/Maps/AstralIsle68/ScriptZones/ToadMusic.(ScriptZone).xdb" />
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="ToadMusic.(BuffResource).xdb" />
                                            </Item>
                                        </impactsIf>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                <zone href="/Maps/AstralIsle68/ScriptZones/ToadKiss.(ScriptZone).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                <zone href="/Maps/AstralIsle68/ScriptZones/ToadMusic.(ScriptZone).xdb" />
                <disable>false</disable>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>