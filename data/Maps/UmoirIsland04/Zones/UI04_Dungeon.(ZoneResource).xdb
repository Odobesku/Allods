<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.zone.ZoneResource>
	<Header>
		<resourceId>739849724</resourceId>
	</Header>
	<internalName>UI04_Dungeon</internalName>
	<name href="UI04_Dungeon.(ZoneResource).Name.txt" />
	<color>0xff808080</color>
	<zoneLights href="/Maps/UmoirIsland04/ZoneLights/UmoirIsland04.(ZoneLights).xdb#xpointer(/ZoneLights)" />
	<pvpType href="/Mechanics/ZonePvpTypes/SanctuaryNoGroup.xdb#xpointer(/gameMechanics.map.zone.Sanctuary)" />
	<mountsProhibited>true</mountsProhibited>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectAvatarRespawnStrategy">
			<respawnStrategy type="gameMechanics.world.avatar.RandomLocatorRespawnStrategy">
				<locators>
					<Item>
						<scriptID>ui04_nt_dungeon</scriptID>
						<map href="/Maps/UmoirIsland04/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</Item>
				</locators>
				<impactsOnRespawn>
					<Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
						<destination type="gameMechanics.map.destination.SelfPosDestination" />
						<assistantResource href="/Mechanics/Characters/Hadagan_male/UmoirIsland04/Miloslavin.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
						<mobResource href="/Characters/Hadagan_male/Instances/UmoirIsland04/Miloslavin.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
						<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
						<data href="/Maps/UmoirIsland04/Scripts/TimeParadox.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					</Item>
				</impactsOnRespawn>
			</respawnStrategy>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
							<table href="/Maps/UmoirIsland04/SpawnTables/DungeonZombie.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ResetSpawnTable">
							<table href="/Maps/UmoirIsland04/SpawnTables/DungeonZombie.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<sanctuaries>
		<places />
	</sanctuaries>
	<graveyards>
		<places />
	</graveyards>
</gameMechanics.map.zone.ZoneResource>
