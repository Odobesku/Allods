<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739900198</resourceId>
    </Header>
    <name href="HyenaBoss_Fire_PuddleProjectile.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/World/FirePuddle.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>0.01</altitude>
    <lifeLengthCap>20000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                            <radius>5</radius>
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="HyenaBoss_DoT.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="HyenaBoss_DoT.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                    <initialDelay>2000</initialDelay>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Aura">
            <radius>6</radius>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="HyenaBoss_Heal_BuFF.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="HyenaBoss_Heal_BuFF.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
            <filter type="gameMechanics.world.creature.MobFilter" />
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>