<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>341482516</resourceId>
	</Header>
	<Name href="Target.(BuffResource)_Name.txt" />
	<Description href="Target.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Bard/Dissonance.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visScript href="/Spells/BuffVisScripts/OpTarget_Skull.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<nameTemplate href="Target.(BuffResource)_Name.txt.template" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
							<spell href="FlyingDeath.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ShieldInfo.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Target2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>500</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="Shield.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Target.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</onLeave>
		</Item>
	</effects>
	<duration>5000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
