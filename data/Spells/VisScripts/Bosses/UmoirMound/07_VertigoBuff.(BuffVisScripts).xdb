<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<Header>
		<Variables>
			<Animation>whirlwind</Animation>
		</Variables>
	</Header>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item var="Animation" />
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Danas_Whirlwind.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>1</scale>
						<locator>Slot_BodyFX</locator>
						<offendTime />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/WarriorWhirlwindUpgrade_Start.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<locator>Slot_BodyFX</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<stopOnDeath>false</stopOnDeath>
	</action>
</BuffVisScripts>
