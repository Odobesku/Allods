<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>197273</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/SpeedBoosts.xdb" />
        <Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
    </groups>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Spell00.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/StalkerOverturn.(UISingleTexture).xdb" />
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration var="cooldown" />
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                        <ability href="/Mechanics/Spells/Stalker63/Abilities/ExplosiveShotMateriel/Ability00.(AbilityResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/CommonBuffs/Aspects/DD/Buff01.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>6</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier>2</multiplier>
                                </durationScaler>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.creature.AliveFilter">
                            <alowImmortal>false</alowImmortal>
                        </filter>
                        <targetsLimit>3</targetsLimit>
                        <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
                            <order>Ascending</order>
                        </sorting>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactAvatarJump">
                        <destination type="gameMechanics.map.destination.RelativeRotatePos">
                            <base type="gameMechanics.map.destination.RelativePos">
                                <yaw type="constructor.basicElements.AngleRadians" />
                                <faceSourcePos>false</faceSourcePos>
                            </base>
                            <offset>20</offset>
                            <yaw type="constructor.basicElements.AngleRadians">
                                <value>3.14</value>
                            </yaw>
                        </destination>
                        <speed>20</speed>
                        <impactsOnLand>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                        <mark href="ReboundLand.(MarkResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnLand>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                        <variable href="/Mechanics/Spells/Stalker63/Abilities/MaterielResource/MaterielResource.(VariableResource).xdb" />
                        <summand>3</summand>
                    </Item>
                </impacts>
                <groupRepeaters>true</groupRepeaters>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>