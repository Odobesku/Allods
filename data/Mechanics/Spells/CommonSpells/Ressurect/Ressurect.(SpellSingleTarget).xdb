<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>200215</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Resurrection.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <element>ASTRAL</element>
    <Name href="Ressurect.(SpellSingleTarget).Name.txt" />
    <Description href="Ressurect.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/SummonSoul.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Priest/Resurrection.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>6000</prepareDuration>
    <isAggro>false</isAggro>
    <isWorkOnDead>true</isWorkOnDead>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            <Item type="gameMechanics.elements.predicates.PredicateIsDead" />
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateResurrectActive" />
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.Resurrect">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactBaseHealth">
                        <healthMultiplier>0.6</healthMultiplier>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Ressurect.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                            </Item>
                                        </predicates>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactsIf">
                                                <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateAnd">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateHasPathBinary" />
                                                        <Item type="gameMechanics.elements.predicates.PredicateDistance">
                                                            <range min="0" max="30" />
                                                        </Item>
                                                    </predicates>
                                                </predicate>
                                                <impactsIf>
                                                    <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                                        <destination type="gameMechanics.map.destination.DestinationModified">
                                                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                            <modifiers>
                                                                <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                                    <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                                        <verticalRange min="0" max="1" />
                                                                        <horizontalRange min="1" max="2" />
                                                                    </modifier>
                                                                </Item>
                                                            </modifiers>
                                                        </destination>
                                                    </Item>
                                                </impactsIf>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <timeOut>30000</timeOut>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>