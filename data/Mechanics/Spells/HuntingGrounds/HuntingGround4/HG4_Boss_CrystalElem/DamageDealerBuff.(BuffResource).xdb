<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739871004</resourceId>
    </Header>
    <Name href="DamageDealerBuff.(BuffResource).Name.txt" />
    <Description href="DamageDealerBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Axe/AxeButcher.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="DamageAura.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="DamageDealerBuff.(BuffResource)_Name.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>5</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ASTRAL</element>
                            <damage>50</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="DamageDealerBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="Target.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </predicate>
                            </Item>
                        </predicates>
                    </filter>
                    <targetsLimit>1</targetsLimit>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>1500</initialDelay>
        </Item>
    </effects>
    <stackLimit>3</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>