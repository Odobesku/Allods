<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Omni.(SpellVisScripts).xdb" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationOmniShield.(CreatureVisActionResource).xdb</PreCastAnimation>
			<CastAnimation>spellCastOmniShield</CastAnimation>
			<FXOnCaster>/Spells/FX/Spells/PriestKania.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<PreCastFX>/Spells/VisScripts/Prototypes/PreCastFXHolyWand.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastFX>
			<FXWand>/Spells/FX/Spells/ReadySpellDirectHolyWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXWand>
			<FXPocket>/Spells/FX/Spells/PocketSpellHoly01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXPocket>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<playWhile type="VisActionDelay">
			<time>1000</time>
		</playWhile>
	</launch>
</SpellVisScripts>
