<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739910186</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/ProceduralDungeon/Groups/Poison.(ActionGroupElement).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroupElement)" />
    </groups>
    <element>POISON</element>
    <image href="/Interface/Icons/Special/Alchemy/Poison.chn.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>30000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                <impact type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.tools.SelectorRandomNotLess">
                        <minIndex>1</minIndex>
                    </selector>
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="5" max="10" />
                                                    <horizontalRange min="5" max="10" />
                                                </modifier>
                                            </Item>
                                        </modifiers>
                                    </destination>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                        <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                                    </impacts>
                                    <impactsFromTarget>
                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Poison_Add.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsFromTarget>
                                    <object href="Poison_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <pool href="/Mechanics/Spells/HuntingGrounds06/TermiteQueenCorrupted/HG06_TermiteQueenTasty.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                    <isPersonalPool>true</isPersonalPool>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </impact>
                <count type="gameMechanics.elements.calcers.FloatData">
                    <value>3</value>
                </count>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>