<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>249010</resourceId>
    </Header>
    <element>SHADOW</element>
    <Name href="Cleave_spell.(SpellArea).Name.txt" />
    <visualScripts href="Cleave_Spell_Visual.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>8000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    </moveType>
                    <resource href="/Mechanics/HuntingGround5/MiniBosse/Cleave_Projectile.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                </projectileData>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>FIRE</element>
                <damage>20</damage>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>90</value>
        </angle>
    </shape>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>