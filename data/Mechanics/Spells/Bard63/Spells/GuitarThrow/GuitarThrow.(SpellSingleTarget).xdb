    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <ranks>
        <Item href="GuitarThrow01.(SpellSingleTarget).xdb" />
        <Item href="GuitarThrow02.(SpellSingleTarget).xdb" />
        <Item href="GuitarThrow03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
                <sub>1</sub>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                        <mark href="GuitarThrowHitOnCaster.(MarkResource).xdb" />
                    </Item>
                </impacts>
                <groupRepeaters>true</groupRepeaters>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="/Mechanics/Spells/Bard63/Spells/DissonanceUpgrade/ChordOnHitTarget.(MarkResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                                            <spell href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisable.(SpellSingleTarget).xdb" />
                                        </predicate>
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                        <radius>15</radius>
                                        <affectGroup>Enemies</affectGroup>
                                        <affectHolder>false</affectHolder>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                                <mark href="/Mechanics/Spells/Bard63/Spells/DissonanceUpgrade/ChordOnHitTarget.(MarkResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                                <forceAE>true</forceAE>
                                                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                    <scalers>
                                                        <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                                                        <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                                                        <Item type="gameMechanics.elements.scalers.LinearScaler">
                                                            <multiplier>0.3</multiplier>
                                                        </Item>
                                                    </scalers>
                                                </scaler>
                                                <minDamage var="damage" />
                                                <maxDamage var="damage" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                                <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                            </scalers>
                        </scaler>
                        <minDamage var="damage" />
                        <maxDamage var="damage" />
                    </Item>
                </impacts>
                <groupRepeaters>true</groupRepeaters>
            </Item>
        </targetImpacts>
        <linkedAbility href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisableAbility.(AbilityResource).xdb" />
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>