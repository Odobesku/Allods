<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>230151</resourceId>
    </Header>
    <image href="/Interface/Icons/Mounts/Griphone_IM.(UISingleTexture).xdb" />
    <itemMallDescription href="ArmoredGryphonMountItem_unpack.(ItemResource).ItemMallDescription.txt" />
    <canBeDeposited>false</canBeDeposited>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.ItemTakeActions">
        <actions>
            <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                        <item href="ArmoredGryphonMountItem.(ItemResource).xdb" />
                    </item>
                </item>
                <count type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                    <value>1</value>
                </count>
            </Item>
            <Item type="itemService.avatar.itemBag.RandomTakeAction">
                <entries>
                    <Item>
                        <actions>
                            <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                                <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                        <item href="/Mechanics/Mounts/Skins/Gryphons/DarkGreenGryphonSkin.(ItemResource).xdb" />
                                    </item>
                                </item>
                                <count type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                                    <value>1</value>
                                </count>
                            </Item>
                        </actions>
                        <chance>0.5</chance>
                    </Item>
                    <Item>
                        <actions>
                            <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                                <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                                    <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                        <item href="/Mechanics/Mounts/Skins/Gryphons/UltraVioletGryphonSkin.(ItemResource).xdb" />
                                    </item>
                                </item>
                                <count type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                                    <value>1</value>
                                </count>
                            </Item>
                        </actions>
                        <chance>0.5</chance>
                    </Item>
                </entries>
            </Item>
            <Item type="itemService.avatar.itemBag.IfTakeAction">
                <predicate type="itemService.mail.predicates.PredicateNot">
                    <predicate type="itemService.mail.predicates.PredicateHasUnlock">
                        <unlock href="/Mechanics/Unlocks/IndividualOffer_given.(UnlockResource).xdb" />
                    </predicate>
                </predicate>
                <actions>
                    <Item type="itemService.avatar.itemBag.GrantUnlockTakeAction">
                        <unlock href="/Mechanics/Unlocks/IndividualOffer_given.(UnlockResource).xdb" />
                    </Item>
                </actions>
            </Item>
        </actions>
    </functionalPart>
    <requiredLevel>4</requiredLevel>
    <quality href="/Mechanics/ItemQualities/Rare.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
    </prices>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="ArmoredGryphonMountItem_unpack.(ItemResource).Name.txt" />
    <description href="ArmoredGryphonMountItem_unpack.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/ItemMall.xdb" />
