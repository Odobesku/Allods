<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.MobAbilityKit>
    <Header>
        <resourceId>222557</resourceId>
    </Header>
    <spellEntries>
        <Item>
            <spell href="Summon.(SpellSingleTarget).xdb" />
            <cooldowns>
                <min>17000</min>
                <max>19500</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="JumpHM.(SpellSingleTarget).xdb" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort">
                    <avatarsFirst>true</avatarsFirst>
                </sortTargets>
            </targetSelector>
        </Item>
        <Item>
            <spell href="EarthStomp.(SpellSingleTarget).xdb" />
            <cooldowns>
                <min>4000</min>
                <max>5000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="KickHM.(SpellSingleTarget).xdb" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByAggro">
                    <startFrom>1</startFrom>
                </sortTargets>
                <targetConditionChecks>
                    <Item>
                        <binaryPredicates>
                            <Item type="gameMechanics.elements.predicates.PredicateDistance">
                                <range min="0" max="15" />
                            </Item>
                        </binaryPredicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>8000</min>
                <max>13000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="Peck.(SpellSingleTarget).xdb" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByAggro" />
            </targetSelector>
            <cooldowns>
                <min>5000</min>
                <max>6000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="PreyHM.(SpellSingleTarget).xdb" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByNone" />
                <helpfulRadius>30</helpfulRadius>
                <helpToSpawn>false</helpToSpawn>
                <targetConditionChecks>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="Meat.(MobWorld).xdb" />
                                </mobs>
                            </Item>
                        </predicates>
                        <binaryPredicates>
                            <Item type="gameMechanics.elements.predicates.PredicateDistance">
                                <range min="0" max="30" />
                            </Item>
                        </binaryPredicates>
                    </Item>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </Item>
                        </predicates>
                        <binaryPredicates>
                            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                <onMaster type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                    </predicate>
                                </onMaster>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateIsAggroLeader" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateDistance">
                                <range min="30" max="90" />
                            </Item>
                        </binaryPredicates>
                    </Item>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </Item>
                        </predicates>
                        <binaryPredicates>
                            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                <onMaster type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                    </predicate>
                                </onMaster>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateIsAggroLeader" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateDistance">
                                <range min="6" max="39" />
                            </Item>
                        </binaryPredicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>666000</min>
                <max>666000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="HungerHM.(SpellSingleTarget).xdb" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort" />
            </targetSelector>
            <cooldowns>
                <min>666000</min>
                <max>666000</max>
            </cooldowns>
        </Item>
    </spellEntries>
</gameMechanics.world.mob.MobAbilityKit>