<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222919</resourceId>
    </Header>
    <Name href="MassiveDischarge.(BuffResource).Name.txt" />
    <Description href="MassiveDischarge.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/ManaBikePulse.(UISingleTexture).xdb" />
    <visScript href="MassiveDischarge.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                                    <zone href="/Mechanics/RaidInstances/FerrisRaid/15_General/BossFightZone.(ScriptZone).xdb" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                                                    <predicate type="gameMechanics.elements.predicates.BinaryPredicateSwitchActors">
                                                        <predicate type="gameMechanics.elements.predicates.PredicateIsAggroLeader" />
                                                    </predicate>
                                                    <impactsElse>
                                                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                                                            <damage>1</damage>
                                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                                            </scalerTarget>
                                                        </Item>
                                                    </impactsElse>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                        </moveType>
                        <resource href="MassiveDischarge.(ProjectileResource).xdb" />
                    </projectileData>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>15_Rysina</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="DischargeSurvivors.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="DischargeSurvivors.(BuffResource).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/RaidInstances/Phase.(ActionGroup).xdb" />
            </groups>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>