                        <turn>ToTarget</turn>
                    </destination>
                    <assistantResource href="/Mechanics/Spells/AstarlIslands/UI08/Trash/UI08_Phoenix_Assistant.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                    <mobResource href="/Creatures/Phoenix/Instances/UmoirIsland08/UI08_Phoenix_Assistant.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
            <id href="CountId_Bird.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
            <delay>1000</delay>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>15</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                <Item type="gameMechanics.elements.impacts.EntityImpactEntitiesAround">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateProjectile" />
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="/Creatures/Phoenix/Instances/UmoirIsland08/UI08_Phoenix.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>