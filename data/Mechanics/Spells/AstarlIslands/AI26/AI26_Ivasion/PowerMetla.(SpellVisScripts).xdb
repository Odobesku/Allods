<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>attackPower2H02</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>600</delay>
                        <effectFx href="/Spells/FX/Mobs/ExoShift_Boss_AOEHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fixPoint>true</fixPoint>
                        <scale>0.8</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>