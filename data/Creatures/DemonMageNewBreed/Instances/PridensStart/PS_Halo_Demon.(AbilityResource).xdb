<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739885714</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="PS_Halo_Demon.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            <personalPlane>true</personalPlane>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                    <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                                        <quest href="/World/Quests/PridensStart/Pride_1_4/Pride_1_4.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                                        <counterResource href="PS_Halo_Demon.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                    </predicate>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                                                    <quest href="/World/Quests/PridensStart/Pride_1_4/Pride_1_4.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.AddParticularVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Outgoing</vector>
                <direction>Outgoing</direction>
                <plane href="PS_Halo_Demon.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
                <personalPlane>true</personalPlane>
            </visibilityRule>
            <resolventsFor>
