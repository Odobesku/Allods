<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Stalker_EnchantFire.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<scale>1</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<locator>Slot_Global</locator>
						<offendTime />
						<offset z="0.4" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureSetFlagAction">
				<onlyIfOnMainAvatar>true</onlyIfOnMainAvatar>
				<flagName>EnchantFire</flagName>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<playWhile />
		<elements>
			<Item type="VisActionDelay">
				<time>100</time>
			</Item>
			<Item type="CreatureSetFlagAction">
				<onlyIfOnMainAvatar>true</onlyIfOnMainAvatar>
				<flagName>EnchantFire</flagName>
				<isSet>false</isSet>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
