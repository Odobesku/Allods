<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739924177</resourceId>
	</Header>
	<Name href="R7_RayAttack_HM.(BuffResource).Name.txt" />
	<Description href="R7_RayAttack_HM.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Equipment/Ships/ComplexTarget.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Mobs/Demon_TargetMark.(VisObjectTemplate).xdb" />
			<locator>Chest</locator>
		</Item>
	</visualEffects>
	<visScript href="R7_Ray_Attack.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>10</radius>
					<affectHolder>false</affectHolder>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="R7_RayAttack.(ClientData).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
									<mobs>
										<Item href="R7_CageMob_HM.(MobWorld).xdb" />
									</mobs>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactKill" />
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>SHADOW</element>
									<damage>200</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impactsElse>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>1000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="R7_RayAttack_HM.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/RaidInstances/ArchBaseRaid/SiegeBoss/R7_ArchBase_Raid.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
