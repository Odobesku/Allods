        </Item>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <scaleOnTick>false</scaleOnTick>
                <tickLength>1000</tickLength>
                <damagePerTick>13</damagePerTick>
                <threatMultiplier>1</threatMultiplier>
                <affectOnStartTick>false</affectOnStartTick>
                <affectedByDoubleAttack>true</affectedByDoubleAttack>
                <recountDamageFromCaster>false</recountDamageFromCaster>
