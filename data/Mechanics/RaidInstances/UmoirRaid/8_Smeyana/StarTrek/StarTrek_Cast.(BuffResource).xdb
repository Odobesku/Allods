                                                                    <buff href="Smeyana_StarBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                </mulCalcer>
                                                                <sum>1</sum>
                                                            </Item>
                                                        </scalers>
                                                    </scaler>
