<gameMechanics.world.ship.VisualShip>
    <Header>
        <resourceId>256972</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <transitionCycle>/Spells/FX/Ships/TeleportStart.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</transitionCycle>
            <fromCycleCrossfadeLength>3000</fromCycleCrossfadeLength>
            <transitionEndIn>/Spells/FX/Ships/TeleportEnd_InFX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</transitionEndIn>
            <transitionEndOut>/Spells/FX/Ships/TeleportEnd_OutFX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</transitionEndOut>
        </Variables>
    </Header>
    <parts>
        <Item type="TeleportEffect">
            <transitionCycle hrefvar="transitionCycle" />
            <transitionEndIn hrefvar="transitionEndIn" />
            <transitionEndOut hrefvar="transitionEndOut" />
        </Item>
        <Item type="ShipDeviceManager" />
    </parts>
</gameMechanics.world.ship.VisualShip>