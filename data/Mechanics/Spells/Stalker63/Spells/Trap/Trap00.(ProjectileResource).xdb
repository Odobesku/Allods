<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739932315</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Trap00.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/Stalker70_Trap_Inactive.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>19000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectCasterTriggerGeneric">
            <conditionalEvents>
                <Item>
                    <obj>gameMechanics.elements.events.EventSpellLaunched</obj>
                    <predicate type="gameMechanics.elements.predicates.PredicateEventSpellLaunched">
                        <spell href="Spell01.(SpellSingleTarget).xdb" />
                    </predicate>
                </Item>
            </conditionalEvents>
            <impacts>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CasterLostWatcherGeneric">
            <impacts>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>5</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier var="duration" />
                            </durationScaler>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                <resource hrefvar="trapVisible" />
                            </projectileData>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.MarkedImpact">
                            <mark href="TrapBite.(MarkResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                            <value>10</value>
                        </Item>
                    </impacts>
                    <impactsOnTargetsFound>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impactsOnTargetsFound>
                    <filter type="gameMechanics.world.creature.AliveFilter" />
                    <targetsLimit>0</targetsLimit>
                    <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance" />
                </Item>
            </impacts>
            <tick>500</tick>
            <initialDelay>3000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="SeeMyTrap.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.AddPlane">
                    <plane href="/Mechanics/Planes/Landmine.xdb" />
                    <personalPlane>true</personalPlane>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>