<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>184458</resourceId>
    </Header>
    <Name href="AddKickAction.(SpellArea).Name.txt" />
    <Description href="AddKickAction.(SpellArea).Description.txt" />
    <image href="/Interface/Icons/Context/KickTheBall.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <targetType>STTSelf</targetType>
    <mechanics>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Creatures/GoblinWarrior/Instances/AstralIsle37/PointerAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    <Item href="/Creatures/GoblinWarrior/Instances/AstralIsle37/PointerAdd_training.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </mobs>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                <time>1000</time>
                <impactsOnLand>
                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                        <spell href="Explosion2.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
