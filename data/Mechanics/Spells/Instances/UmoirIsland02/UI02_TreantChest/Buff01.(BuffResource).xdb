<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739857118</resourceId>
	</Header>
	<Name href="Buff01.(BuffResource).Name.txt" />
	<Description href="Buff01.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Priest/PriestSilence.(UISingleTexture).xdb" />
	<visScript href="/Spells/BuffVisScripts/Silence.(BuffVisScripts).xdb" />
	<nameTemplate href="Buff01.(BuffResource).Name.txt" />
	<descTemplate href="Buff01.(BuffResource).Description.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
			<groups>
				<Item href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
			</groups>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
					<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
						<value>0.3</value>
					</chanceCalcer>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIsolator">
							<impacts>
								<Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.constructor.basicElements.PredicateNot">
													<predicate type="gameMechanics.elements.resources.ResourceBuff">
														<buff href="Buff02.(BuffResource).xdb" />
													</predicate>
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
													<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
													<data href="AttackFromBack.(ClientData).xdb" />
												</Item>
											</impactsIf>
										</Item>
									</impacts>
									<assistantResource href="/Mechanics/Spells/Instances/UmoirIsland02/UI02_Dreadnawt/UI02_AssistantResource.(AssistantResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<duration>3000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
