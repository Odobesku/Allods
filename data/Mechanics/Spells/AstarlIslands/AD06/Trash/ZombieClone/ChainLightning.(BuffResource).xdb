<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739825679</resourceId>
    </Header>
    <Name href="ChainLightning.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageLightningArrow.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Mechanics/Spells/AstarlIslands/AD06/Bosses/CultistBoss/ElectricStrike.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="ChainLightning.(BuffResource).NameTemplate.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>LIGHTNING</element>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    <damage>20</damage>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.RelativePos" />
                        </moveType>
                        <resource href="ElectroPuddle.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectJumpOnDetach">
            <jumps type="gameMechanics.elements.calcers.LongData">
                <value>6</value>
            </jumps>
            <buff href="ChainLightning.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.RandomAutotarget">
                <group>Enemies</group>
                <radius>10</radius>
            </autotarget>
            <onBehalfOfCaster>true</onBehalfOfCaster>
            <radius>6</radius>
            <inCasterRange>false</inCasterRange>
            <keepTrack>false</keepTrack>
            <renewingEffects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="ChainLightning.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            <calcers>
                                <addressEntries>
                                    <Item>
                                        <name>target</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                    </Item>
                                    <Item>
                                        <name>caster</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    </Item>
                                </addressEntries>
                            </calcers>
                        </Item>
                    </impactsOff>
                </Item>
            </renewingEffects>
        </Item>
    </effects>
    <duration>75</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <isForthright>true</isForthright>
</gameMechanics.constructor.schemes.buff.BuffResource>