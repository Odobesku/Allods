<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739873206</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="CheckArea.(SpellArea).Name.txt" />
    <Description href="CheckArea.(SpellArea).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/FlourBag.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="CheckArea.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>3000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>0.3</value>
                </chanceCalcer>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.map.destination.RelativeRotatePos">
                            <base type="gameMechanics.map.destination.SelfPosDestination" />
                            <offset>8</offset>
                        </destination>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                <delay>2000</delay>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                        <value>100</value>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                        <object href="/Mechanics/Spells/Instances/InstNewTkaRika/Mobs/TraurigKrabbe.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <pool href="/Mechanics/Spells/Instances/InstNewTkaRika/EventSapper_SummonPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateProjectileNear">
                        <radius>10</radius>
                        <projectiles>
                            <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Projectiles/EventSapper_Mine.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                        </projectiles>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/Instances/InstNewTkaRika/Buffs/EventSapper/MinePlane.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                        <data href="/Mechanics/Spells/Instances/InstNewTkaRika/ClientData/EventSapper_Range0.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateProjectileNear">
                                <radius>25</radius>
                                <projectiles>
                                    <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Projectiles/EventSapper_Mine.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                </projectiles>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                <data href="/Mechanics/Spells/Instances/InstNewTkaRika/ClientData/EventSapper_Range1.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateProjectileNear">
                                        <radius>40</radius>
                                        <projectiles>
                                            <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Projectiles/EventSapper_Mine.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                        </projectiles>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                        <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                        <data href="/Mechanics/Spells/Instances/InstNewTkaRika/ClientData/EventSapper_Range2.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    </Item>
                                </impactsIf>
                                <impactsElse>
                                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                        <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                        <data href="/Mechanics/Spells/Instances/InstNewTkaRika/ClientData/EventSapper_Range3.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impactsElse>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>20</speed>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>