<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>readySpellDirected</Item>
        </animations>
    </actionBarStart>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
            </Item>
            <Item type="CreatureVisActionStartThrow" />
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Spells/MageControlFire_projectile.(VisObjectTemplate).xdb" />
                <explosionFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb" />
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_Mouth</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </pointOnTarget>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>