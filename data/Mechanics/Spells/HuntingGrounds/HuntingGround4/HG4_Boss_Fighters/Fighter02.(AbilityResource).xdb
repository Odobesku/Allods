<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739873049</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
					</impacts>
					<spawnResource href="/Maps/HuntingGround4/SpawnTables/HuntingGround4/HG4_Boss_Fighter_01.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
				</Item>
			</onEnter>
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ResetSpawnTable">
					<table href="/Maps/HuntingGround4/SpawnTables/HuntingGround4/HG4_Boss_Fighter_01.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="EpicRage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
					<spawnResource href="/Maps/HuntingGround4/SpawnTables/HuntingGround4/HG4_Boss_Fighter_01.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		</Item>
	</effects>
	<disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>
