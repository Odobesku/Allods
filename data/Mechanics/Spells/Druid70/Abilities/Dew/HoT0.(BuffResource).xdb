<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>214626</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Spell0.(SpellSingleTarget).Name.txt" />
    <Description href="HoT0.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestCureWounds.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Druid/Dew.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="DewVisual.(ClientData).xdb" />
                    <calcers>
                        <addressEntries>
                            <Item>
                                <name>caster</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </Item>
                            <Item>
                                <name>target</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                            </Item>
                        </addressEntries>
                    </calcers>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.common.HealOverTime">
            <healPerTick type="constructor.elements.CalcerFloatExternal">
                <externalCalcer hrefvar="externalCalcer" />
            </healPerTick>
            <scaler type="gameMechanics.elements.scalers.HealScaler" />
            <tick>2000</tick>
            <affectedByDoubleAttack>true</affectedByDoubleAttack>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="HoT01.(BuffResource).xdb" />
        <Item href="HoT02.(BuffResource).xdb" />
        <Item href="HoT03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>