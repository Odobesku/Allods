<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739963963</resourceId>
	</Header>
	<Name href="AI60_Bandit_Ray.(SpellArea).Name.txt" />
	<visualScripts href="AI60_Bandit_Ray.(SpellVisScripts).xdb" />
	<prepareDuration>2000</prepareDuration>
	<targetType>STTPoint</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<stage>Start</stage>
			<duration>8000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
				</predicates>
			</Item>
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
				<element>FIRE</element>
				<damage>100</damage>
				<scaler type="gameMechanics.elements.scalers.MagicScaler" />
			</Item>
		</targetImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.RectangularRay">
		<width>2</width>
	</shape>
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>40</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
