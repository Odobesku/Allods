<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739949378</resourceId>
    </Header>
    <Name href="Tired.(BuffResource).Name.txt" />
    <Description href="Tired.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Stun.(UISingleTexture).xdb" />
    <visScript href="Tired.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.GiveContextActionAura">
            <radius>8</radius>
            <action href="Kick.(SpellSingleTarget).xdb" />
            <filter type="gameMechanics.world.creature.AvatarFilter" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Client/SlashCommands/MoodBored.(ClientData).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>20000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>