<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <precastType>PRECAST_NONE</precastType>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialCast01</Item>
                </animations>
                <channel>CHANNEL_ABILITY</channel>
                <channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
                <advanced>
                    <offendType>ONEOFFEND_ONETARGET</offendType>
                </advanced>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/MageStoneskin.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_TopFX</locator>
                        <offendTime type="EffectOffendConstDelay" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>