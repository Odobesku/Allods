                                                    <Item type="gameMechanics.world.avatar.assistants.PredicateHasAssistant">
                                                        <assistantResource href="/Mechanics/Characters/HumMobs/Mercenaries/Healer/Healer.(AssistantResource).xdb" />
                                                    </Item>
                                                    <Item type="gameMechanics.world.avatar.assistants.PredicateHasAssistant">
                                                        <assistantResource href="/Mechanics/Characters/HumMobs/Mercenaries/Archer/Archer.(AssistantResource).xdb" />
                                                    </Item>
                                                    <Item type="gameMechanics.world.avatar.assistants.PredicateHasAssistant">
                                                        <assistantResource href="/Mechanics/Characters/HumMobs/Mercenaries/Berserker/Berserker.(AssistantResource).xdb" />
                                                    </Item>
                                                    <Item type="gameMechanics.world.avatar.assistants.PredicateHasAssistant">
                                                        <assistantResource href="/Mechanics/Characters/HumMobs/Mercenaries/Witcher/Witcher.(AssistantResource).xdb" />
                                                    </Item>
                                                    <Item type="gameMechanics.world.avatar.assistants.PredicateHasAssistant">
                                                        <assistantResource href="/Mechanics/Characters/HumMobs/Mercenaries/Wizard/Wizard.(AssistantResource).xdb" />
                                                    </Item>
                                                </predicates>
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactCaseGeneric">
                                            <cases>
                                                <Item>
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                            <buff href="/Mechanics/LFG/Buffs/Phase2Mercs.(BuffResource).xdb" />
                                                        </Item>
                                                    </predicates>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Tank/Tank.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Healer/Healer.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Archer/Archer.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Berserker/Berserker.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Witcher/Witcher.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Wizard/Wizard.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                            <buff href="/Mechanics/LFG/Buffs/Phase2Mercs.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                                <Item>
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateHasItemsCount">
                                                            <items>
                                                                <Item href="/Items/QuestItems/ZoneLeague1/Quest_Learn_Mercenaries/Quest_Learn_Mercenaries.(ItemResource).xdb" />
                                                            </items>
                                                            <totalCount>1</totalCount>
                                                        </Item>
                                                    </predicates>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Tank/Tank.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Healer/Healer.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Archer/Archer.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Berserker/Berserker.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Witcher/Witcher.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInhabitAssistant">
                                                            <assistant href="/Mechanics/Characters/HumMobs/Mercenaries/Wizard/Wizard.(AssistantResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
                                                            <item href="/Items/QuestItems/ZoneLeague1/Quest_Learn_Mercenaries/Quest_Learn_Mercenaries.(ItemResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                                            <id href="/World/Quests/ZoneHadagan1/Quest_Learn_Mercenaries02/CountId01.(QuestCountId).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </cases>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOn>
                </Item>
