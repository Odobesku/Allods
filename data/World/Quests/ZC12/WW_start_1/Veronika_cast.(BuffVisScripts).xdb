<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Veronica_Cast.(VisObjectTemplate).xdb" />
						<scale>2</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
