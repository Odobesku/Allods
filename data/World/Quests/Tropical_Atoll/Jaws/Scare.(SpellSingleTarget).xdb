<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>315310</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ActionBarChange.(ActionGroup).xdb" />
    </groups>
    <Name href="Scare.(SpellSingleTarget).Name.txt" />
    <Description href="Scare.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/Scarecrow.(UISingleTexture).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>5</value>
    </range>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>2000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateInWater" />
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="ScareCD.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Shark.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                </predicate>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="ScareCD.(BuffResource).xdb" />
                <impactsOnAttach>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                <id href="Kills.(QuestCountId).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                        <quest href="Quest.(QuestResource).xdb" />
                                        <counterResource href="Kills.(QuestCountId).xdb" />
                                        <value>2</value>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                                        <quest href="Quest.(QuestResource).xdb" />
                                        <counterResource href="Mask.(QuestCountId).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </impactsOnAttach>
                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>20</multiplier>
                </durationScaler>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>