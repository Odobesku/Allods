<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>186222</resourceId>
    </Header>
    <name href="PoisonAOE.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/HitPoisonAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>2050</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                            <radius>10</radius>
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>POISON</element>
                                    <damage>55</damage>
                                    <impactsOnHitTarget>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="ContaminatingPoison.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsOnHitTarget>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterOr">
                                <filters>
                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                    <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                        </predicates>
                                    </Item>
                                </filters>
                            </filter>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>