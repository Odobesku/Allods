<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.basicElements.MapModifierResource>
    <Header>
        <resourceId>252344</resourceId>
    </Header>
    <name href="Leaders.(MapModifierResource).Name.txt" />
    <description href="Leaders.(MapModifierResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffLeader01.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <mapEffects>
        <Item type="gameMechanics.elements.effects.AddMapSpecificEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                        <Item type="gameMechanics.elements.predicates.PredicateIsEnemy">
                            <factions>
                                <Item href="/World/Factions/Empire.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                                <Item href="/World/Factions/League.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                            </factions>
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ReadyToBeLeader.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsOn>
                        </Item>
                    </effectsIf>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
                            <onLeave>
                                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                                    <variable href="IsThereALeaderOnMap.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                                    <summand>-1</summand>
                                </Item>
                            </onLeave>
                        </Item>
                    </effectsIf>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.offender.PredicateActionGroup">
                                    <groups>
                                        <Item href="/Mechanics/Spells/Groups/MercenarySpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                    </groups>
                                </Item>
                            </predicates>
                            <impacts>
                                <casterToTarget>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="ReadyToBeLeader.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </casterToTarget>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/InstanceModifiers/CrossModifiers/MightBeChosenOne.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsOn>
                        </Item>
                    </effectsIf>
                </Item>
            </effects>
        </Item>
    </mapEffects>
    <weight>2</weight>
    <exclusions>
        <Item href="/Maps/AstralIsle58_UI06/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
        <Item href="/Maps/AstralIsle41/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
    </exclusions>
</gameMechanics.map.basicElements.MapModifierResource>