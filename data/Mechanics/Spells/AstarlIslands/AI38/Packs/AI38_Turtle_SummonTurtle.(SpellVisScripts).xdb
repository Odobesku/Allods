<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Remove_Aggro_Slot.(VisObjectTemplate).xdb" />
                        <lockScale>true</lockScale>
                        <locator>Slot_TopFX</locator>
                    </Item>
                    <Item>
                        <delay>1000</delay>
                        <effectFx href="/Spells/FX/Spells/WarriorInnerRageAbility.(VisObjectTemplate).xdb" />
                        <lockScale>true</lockScale>
                        <scale>1.25</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>