<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>206531</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="ShieldBuff.(BuffResource).Name.txt" />
    <Description href="ShieldBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorShieldBlock.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>400</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.DamageThreshold">
                            <healthCalcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                    <scalers>
                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                <externalCalcer href="/Mechanics/Spells/Paladin63/Spells/Wrath/Calcer02.(CalcerFloatResource).xdb" />
                                            </mulCalcer>
                                        </Item>
                                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mul>25</mul>
                                            <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                                                <summands>
                                                    <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                        <value type="gameMechanics.elements.calcers.StatCalcer">
                                                            <stat type="gameMechanics.elements.stat.StatResistance">
                                                                <element>EPHYSICAL</element>
                                                            </stat>
                                                        </value>
                                                    </Item>
                                                    <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                        <value type="gameMechanics.elements.calcers.StatCalcer">
                                                            <stat type="gameMechanics.elements.stat.StatResistance">
                                                                <element>ENATURE</element>
                                                            </stat>
                                                        </value>
                                                    </Item>
                                                    <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                        <value type="gameMechanics.elements.calcers.StatCalcer">
                                                            <stat type="gameMechanics.elements.stat.StatResistance">
                                                                <element>EDIVINE</element>
                                                            </stat>
                                                        </value>
                                                    </Item>
                                                    <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                        <value type="gameMechanics.elements.calcers.StatCalcer">
                                                            <stat type="gameMechanics.elements.stat.StatResistance">
                                                                <element>EELEMENTAL</element>
                                                            </stat>
                                                        </value>
                                                    </Item>
                                                </summands>
                                            </mulCalcer>
                                        </Item>
                                    </scalers>
                                </scaler>
                                <value>1</value>
                            </healthCalcer>
                            <healthScalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                <buff href="ShieldBuff01.(BuffResource).xdb" />
                                <anyRank>true</anyRank>
                                <onlyFromMaster>true</onlyFromMaster>
                                <mul>1</mul>
                            </healthScalerTarget>
                            <outOfCombatPolicy>Nothing</outOfCombatPolicy>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ShieldBuff01.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <damageType>Damage</damageType>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>20000</duration>
    <stackLimit>100</stackLimit>
    <isHelpful>true</isHelpful>
    <ranks>
        <Item href="ShieldBuff01.(BuffResource).xdb" />
        <Item href="ShieldBuff02.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>