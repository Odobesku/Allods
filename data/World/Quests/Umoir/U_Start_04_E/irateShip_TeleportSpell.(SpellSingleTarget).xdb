    </contextActionInfo>
    <Name href="irateShip_TeleportSpell.(SpellSingleTarget).Name.txt" />
    <Description href="irateShip_TeleportSpell.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/GetOnTheShip.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="irateShip_TeleportSpell.(SpellSingleTarget).NameTemplate.txt" />
