<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>236189729</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.StackBuffGeneric">
                                    <buff href="Buffs/Rage01.(BuffResource).xdb" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>1</value>
                                    </delta>
                                    <attachIfNotExist>true</attachIfNotExist>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="CFH.(BuffResource).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>250</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="CFH.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                            <selector type="gameMechanics.tools.SelectorShuffle" />
                                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                                            <impacts>
                                                <Item>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                                                    <radius>25</radius>
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                                            <buff href="CFH.(BuffResource).xdb" />
                                                                        </Item>
                                                                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                                                            <impacts>
                                                                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                                                    <value>1</value>
                                                                                </Item>
                                                                            </impacts>
                                                                        </Item>
                                                                    </impacts>
                                                                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                                        <predicates>
                                                                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                                                <mobs>
                                                                                    <Item href="/Creatures/DemonCrabPet/Instances/Inst_TkaRika/DemonCrabPetChild.(MobWorld).xdb" />
                                                                                </mobs>
                                                                            </Item>
                                                                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                                                        </predicates>
                                                                    </filter>
                                                                    <targetsLimit>2</targetsLimit>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>