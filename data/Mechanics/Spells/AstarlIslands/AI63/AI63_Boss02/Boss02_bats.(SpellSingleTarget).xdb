					<pool href="Boss02_bats.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
				</impact>
				<count type="gameMechanics.elements.calcers.FloatData">
					<value>3</value>
				</count>
			</Item>
