										</Item>
									</predicates>
								</Item>
								<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
									<predicates>
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="DeviceLimitTrigger.(BuffResource).xdb" />
											<consumeStacks>4</consumeStacks>
										</Item>
										<Item type="gameMechanics.elements.predicates.PredicateHasAbility">
											<ability href="DeviceLimit02.(AbilityResource).xdb" />
											<anyRank>false</anyRank>
										</Item>
									</predicates>
								</Item>
								<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
									<predicates>
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="DeviceLimitTrigger.(BuffResource).xdb" />
											<consumeStacks>3</consumeStacks>
										</Item>
										<Item type="gameMechanics.elements.predicates.PredicateHasAbility">
											<ability href="DeviceLimit01.(AbilityResource).xdb" />
											<anyRank>false</anyRank>
										</Item>
									</predicates>
								</Item>
								<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
									<predicates>
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="DeviceLimitTrigger.(BuffResource).xdb" />
											<consumeStacks>2</consumeStacks>
										</Item>
										<Item type="gameMechanics.constructor.basicElements.PredicateNot">
											<predicate type="gameMechanics.elements.predicates.PredicateHasAbility">
												<ability href="DeviceLimit01.(AbilityResource).xdb" />
											</predicate>
										</Item>
