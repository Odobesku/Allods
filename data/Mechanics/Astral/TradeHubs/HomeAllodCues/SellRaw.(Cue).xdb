                </calcerLong>
                <calcerFloat type="gameMechanics.elements.calcers.FloatData">
                    <value>0.6731</value>
                </calcerFloat>
            </calcer>
        </Item>
    </data>
    <conditions>
        <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
            <lhs type="gameMechanics.world.ship.elements.calcers.CalcerTreasureChestCount">
                <chestType href="/Mechanics/Astral/TradeHubs/ResourceChests/Resource3Chest.(AstralChestType).xdb#xpointer(/gameMechanics.world.device.AstralChestType)" />
                <boundChestsOnly>true</boundChestsOnly>
            </lhs>
            <rhs type="gameMechanics.elements.calcers.LongData">
                <value>0</value>
            </rhs>
        </Item>
        <Item type="gameMechanics.world.ship.elements.PredicateOnBoundShip">
            <predicates>
                <Item type="gameMechanics.world.ship.elements.PredicatePermission">
                    <permission>BuyChests</permission>
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateOnSameMap" />
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/AstralTradeAllods.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
        </Item>
    </conditions>
    <additionalConditions>
        <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
            <minLevel type="gameMechanics.formulas.MaxLevelConstant">
                <summand>-3</summand>
            </minLevel>
        </Item>
    </additionalConditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderBoundShip" />
            <impacts>
                <Item type="itemService.elements.astral.ImpactRemoveChest">
                    <chestType href="/Mechanics/Astral/TradeHubs/ResourceChests/Resource3Chest.(AstralChestType).xdb#xpointer(/gameMechanics.world.device.AstralChestType)" />
                    <impactsOnAvatarPerChest>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateDistance">
                                <range min="0" max="80" />
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                    <id href="/World/Quests/AstralTradeAllods/FinalProduction_Hadagan/QuestCountSoldSupplies.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                    <id href="/World/Quests/AstralTradeAllods/FinalProduction_Kania/QuestCountSoldSupplies.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOnAvatarPerChest>
                    <scalableImpactsOnAvatarPerChest>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateDistance">
                                <range min="0" max="80" />
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactAddMoney">
                                    <sumCalcer type="gameMechanics.elements.calcers.CalcerLongMulFloat">
                                        <calcerLong type="constructor.elements.CalcerLongExternal">
                                            <externalCalcer href="/Mechanics/CommonFormulas/GoldFarm/LevelCapCalcer_GoldFarm.(CalcerLongResource).xdb#xpointer(/constructor.elements.CalcerLongResource)" />
                                        </calcerLong>
                                        <calcerFloat type="gameMechanics.elements.calcers.FloatData">
                                            <value>0.6731</value>
                                        </calcerFloat>
                                    </sumCalcer>
                                </Item>
                            </impactsIf>
                        </Item>
                    </scalableImpactsOnAvatarPerChest>
                    <inverseScaleOnBoundCount>true</inverseScaleOnBoundCount>
                    <boundChestsOnly>true</boundChestsOnly>
                </Item>
            </impacts>
        </Item>
    </impacts>
