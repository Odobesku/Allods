<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739921903</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Buff.(BuffResource).Name.txt" />
	<Description href="Buff.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/CommonState/Aspect_Tank.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Stalker/SetAspect_Tank.(BuffVisScripts).xdb" />
	<descVars>
		<Item>
			<name>perc</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mul>0.01</mul>
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcerHP" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>FormulaPercent</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
		<Item>
			<name>mul</name>
			<value>1</value>
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mulCalcer type="constructor.elements.CalcerFloatExternal">
					<externalCalcer hrefvar="externalCalcer" />
				</mulCalcer>
			</scaler>
		</Item>
	</descVars>
	<effects>
		<Item type="gameMechanics.elements.effects.ThreatMultiplier">
			<factor type="constructor.elements.CalcerFloatExternal">
				<externalCalcer hrefvar="externalCalcer" />
			</factor>
		</Item>
		<Item type="gameMechanics.elements.effects.MultiplyStat">
			<stat type="gameMechanics.elements.stat.StatStamina" />
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mul>0.01</mul>
				<mulCalcer type="constructor.elements.CalcerFloatExternal">
					<externalCalcer hrefvar="externalCalcerHP" />
				</mulCalcer>
				<sum>1</sum>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellPrepareDurationModifier">
			<spell href="Spell01.(SpellSingleTarget).xdb" />
			<factor>-1</factor>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.PostponedImpacts">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactResetCombatAdvantage" />
					</impacts>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactResetCombatAdvantage" />
			</impactsOff>
		</Item>
	</effects>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<ranks>
		<Item href="Buff01.(BuffResource).xdb" />
		<Item href="Buff02.(BuffResource).xdb" />
		<Item href="Buff03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
		<Item href="/Mechanics/Spells/Groups/CommonAspects.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
