<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellDirected</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownDisease.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>3</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Mobs/Yeti_AOEFear.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            </Item>
        </visualEffects>
    </launch>
</SpellVisScripts>