<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Description href="/Spells/VisScripts/Prototypes2/Direct.txt" />
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>specialCast</Item>
        </animations>
        <advanced>
            <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
            <eventPlaybackEnd>true</eventPlaybackEnd>
            <waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
        </advanced>
    </actionBarStart>
    <precastType>PRECAST_DEFAULT</precastType>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/HowlingStrike_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fixPoint>true</fixPoint>
                        <offendTime type="EffectOffendConstDelay" />
                    </Item>
                </visualEffects>
            </Item>
            <Item type="ShakeAction">
                <params href="/Creatures/OgreArmored/OgreArmored.(CameraShakeParameters).xdb#xpointer(/CameraShakeParameters)" />
            </Item>
        </elements>
    </launch>
    <playOnTargets>
        <specialAction type="CreatureEffectsAction">
            <visualEffects>
                <Item>
                    <effectFx href="/Spells/FX/Spells/HitBloodGreen.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    <locator>Slot_FX</locator>
                </Item>
            </visualEffects>
        </specialAction>
    </playOnTargets>
</SpellVisScripts>