<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739911757</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Description href="ExoCustomBuff01_Description.txt" />
    <image href="/Interface/Icons/Mounts/Exoskelet.(UISingleTexture).xdb" />
    <visScript href="ExoCustomBuffProt.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.DamageThreshold">
            <beseHealthScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>0.01</mul>
                <mulCalcer type="gameMechanics.elements.calcers.CalcerIf">
                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAuto.(BuffResource).xdb" />
                    </predicate>
                    <calcerIf type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                        <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAuto.(BuffResource).xdb" />
                    </calcerIf>
                    <calcerElse type="gameMechanics.elements.calcers.CalcerIf">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAutoRed.(BuffResource).xdb" />
                        </predicate>
                        <calcerIf type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                            <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAutoRed.(BuffResource).xdb" />
                        </calcerIf>
                        <calcerElse type="gameMechanics.elements.calcers.CalcerIf">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAutoGreen.(BuffResource).xdb" />
                            </predicate>
                            <calcerIf type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAutoGreen.(BuffResource).xdb" />
                            </calcerIf>
                            <calcerElse type="gameMechanics.elements.calcers.CalcerIf">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1TempSkinAutoYellow.(BuffResource).xdb" />
                                </predicate>
                                <calcerIf type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                    <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1TempSkinAutoYellow.(BuffResource).xdb" />
                                </calcerIf>
                                <calcerElse type="gameMechanics.elements.calcers.CalcerIf">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAutoYellow.(BuffResource).xdb" />
                                    </predicate>
                                    <calcerIf type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                        <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Exo1SkinAutoYellow.(BuffResource).xdb" />
                                    </calcerIf>
                                    <calcerElse type="gameMechanics.elements.calcers.FloatData">
                                        <value>100</value>
                                    </calcerElse>
                                </calcerElse>
                            </calcerElse>
                        </calcerElse>
                    </calcerElse>
                </mulCalcer>
            </beseHealthScaler>
            <healthScalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer href="/Mechanics/GameRoot/Mount/MountHealthCalcer.(CalcerFloatResource).xdb" />
                </mulCalcer>
            </healthScalerTarget>
            <regenCalcer type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </regenCalcer>
            <outOfCombatPolicy>Nothing</outOfCombatPolicy>
            <ownerDamageFactor type="gameMechanics.elements.calcers.CalcerIf">
                <predicate type="gameMechanics.elements.predicates.PredicateHealthLower">
                    <level>0.5</level>
                </predicate>
                <calcerIf type="gameMechanics.elements.calcers.FloatData">
                    <value>0.5</value>
                </calcerIf>
                <calcerElse type="gameMechanics.elements.calcers.FloatData">
                    <value>1</value>
                </calcerElse>
            </ownerDamageFactor>
            <barrierDamageFactor type="gameMechanics.elements.calcers.CalcerIf">
                <predicate type="gameMechanics.elements.predicates.PredicateHealthLower">
                    <level>0.5</level>
                </predicate>
                <calcerIf type="gameMechanics.elements.calcers.FloatData">
                    <value>0.5</value>
                </calcerIf>
                <calcerElse type="gameMechanics.elements.calcers.FloatData">
                    <value>0</value>
                </calcerElse>
            </barrierDamageFactor>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactDismount" />
                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                    <mark href="Exo05Mark.(MarkResource).xdb" />
                </Item>
            </impacts>
            <resource href="/Mechanics/GameRoot/Mount/MountDamageThreshold.xdb" />
            <damageType>ToMount</damageType>
            <priority>DieHard</priority>
            <affectsAdditionalHealth>false</affectsAdditionalHealth>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                <coeff>1</coeff>
                <calcer type="gameMechanics.elements.calcers.MountSpeedCalcer" />
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.5</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="ExoAbsorbStart.(ClientData).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Mounts/Exo/ExoMountsAutoBuff.(ActionGroup).xdb" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="SkinTrigger.(BuffResource).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Mounts/Exo/ExoMountActiveBuffs.(ActionGroup).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactDismount" />
            </impactsOff>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/ExoMountsBufs.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>