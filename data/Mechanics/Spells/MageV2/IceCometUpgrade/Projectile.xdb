		<Item type="gameMechanics.elements.impacts.MarkedImpact">
			<mark href="/Mechanics/Spells/MageV2/Abilities/ChainFrost/ChainFrost.(MarkResource).xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
