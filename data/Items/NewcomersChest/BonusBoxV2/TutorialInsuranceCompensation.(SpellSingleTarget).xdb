	</Header>
	<Name href="TutorialInsuranceCompensation.(SpellSingleTarget).Name.txt" />
	<Description href="TutorialInsuranceCompensation.(SpellSingleTarget).Description.txt" />
	<prepareDuration>2000</prepareDuration>
	<targetType>STTSelf</targetType>
	<mechanics>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceActiveItem" />
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
				<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
					<value>0.5</value>
				</chanceCalcer>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactGiveItem">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="/ItemMall/NotImplemented/IMStaminaPotion.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
						</item>
						<binding>ForceBind</binding>
					</Item>
				</impacts>
				<impactsLose>
					<Item type="gameMechanics.elements.impacts.ImpactGiveItem">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="/ItemMall/NotImplemented/IMPrecisionPotion.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
						</item>
						<binding>ForceBind</binding>
					</Item>
				</impactsLose>
			</Item>
		</casterImpacts>
	</mechanics>
	<iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
