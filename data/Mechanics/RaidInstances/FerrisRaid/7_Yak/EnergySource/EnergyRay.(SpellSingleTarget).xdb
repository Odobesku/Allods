<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>220806</resourceId>
    </Header>
    <element>LIGHTNING</element>
    <Name href="EnergyRay.(SpellSingleTarget).Name.txt" />
    <visualScripts href="EnergyRay.(SpellVisScripts).xdb" />
    <prepareDuration>960000</prepareDuration>
    <mechanics>
        <channelingMechanics>
            <channelingBuff href="ChannelBuff.(BuffResource).xdb" />
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="EnergySource.(BuffResource).xdb" />
                    </Item>
                </impactsOn>
                <impactsOff>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="EnergySource.(BuffResource).xdb" />
                    </Item>
                </impactsOff>
            </Item>
        </casterChannelingEffects>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>