<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>212337</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Smoke_Attention.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Smoke_Attention.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/Spells/HuntingGrounds/Mutation/Smoke_Projectile.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    <isPersonalPool>true</isPersonalPool>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </onLeave>
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                                                <groups>
                                                    <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                                    <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                                </groups>
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                            <projectileData>
                                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                </moveType>
                                                <resource href="/Mechanics/Spells/HuntingGrounds/Mutation/Smoke_Projectile.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                            </projectileData>
                                            <pool href="/Mechanics/Spells/HuntingGrounds/Mutation/Smoke_Projectile.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                            <isPersonalPool>true</isPersonalPool>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>20000</tick>
                    <initialDelay>10000</initialDelay>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>