<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739925253</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Modifiers/LethalTrap.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/CC/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <targetImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>4</radius>
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                    <value>1</value>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier var="value" />
                                            </durationScaler>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AliveFilter" />
                        </Item>
                    </targetImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationGroups">
                        <groups>
                            <Item href="/Mechanics/Spells/Groups/Suggestions.(ActionGroup).xdb" />
                        </groups>
                    </destination>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>