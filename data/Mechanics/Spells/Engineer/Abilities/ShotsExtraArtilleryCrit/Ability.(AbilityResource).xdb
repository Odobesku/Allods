<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739864425</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.(AbilityResource).Name.txt" />
    <description href="Ability.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value>15</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
        <Item>
            <name>lev</name>
            <text hrefvar="text" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>PlainText</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/IncreaseDamageOnCC.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <targetImpacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Shots_Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <stacks type="gameMechanics.elements.calcers.FloatData">
                        <value var="stack" />
                    </stacks>
                </Item>
            </targetImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/Engineer/AirStrike/Spell01.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                </spells>
            </destination>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="/Mechanics/Spells/Engineer/Shots/Acid/Engineer_AcidShot.(MarkResource).xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                        <buff href="Shots_Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                    </predicate>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ACID</element>
                            <damage>15</damage>
                            <impactsOnHitTarget>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="Shots_Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <resetTimer>false</resetTimer>
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impactsOnHitTarget>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="/Mechanics/Spells/Engineer/Shots/Fire/Engineer_FireShot.(MarkResource).xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                        <buff href="Shots_Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                    </predicate>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>FIRE</element>
                            <damage>15</damage>
                            <impactsOnHitTarget>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="Shots_Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <resetTimer>false</resetTimer>
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impactsOnHitTarget>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="/Mechanics/Spells/Engineer/Shots/Astral/Engineer_AstralShot.(MarkResource).xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                        <buff href="Shots_Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                    </predicate>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ASTRAL</element>
                            <damage>15</damage>
                            <impactsOnHitTarget>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="Shots_Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <resetTimer>false</resetTimer>
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impactsOnHitTarget>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="/Mechanics/Spells/Engineer/Shots/Electricity/Engineer_ElectroShot.(MarkResource).xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                        <buff href="Shots_Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                    </predicate>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>LIGHTNING</element>
                            <damage>15</damage>
                            <impactsOnHitTarget>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="Shots_Weakness.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <resetTimer>false</resetTimer>
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impactsOnHitTarget>
