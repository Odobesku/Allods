<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<visActionID>RapidFire</visActionID>
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionLoopAction">
				<visActionID>MeleeCombo</visActionID>
				<actionToLoop type="VisActionList">
					<visActionID />
					<play>Simultaneously</play>
					<playWhile />
					<elements>
						<Item type="CreatureAnimationAction">
							<visActionID />
							<mode>DIE</mode>
							<use>USE_CURRENT_ATTACK</use>
							<animations />
							<channel>CHANNEL_ABILITY</channel>
							<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
							<channelOverrideScript />
							<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
							<specialController />
							<advanced>
								<speed>0</speed>
								<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
								<offendType>NO_OFFEND</offendType>
								<animationKeysAction />
								<animationKeysSound />
								<animationKeysActionPeriod />
								<turnToTarget>BEFORE_ANIMATIONEND</turnToTarget>
							</advanced>
						</Item>
					</elements>
				</actionToLoop>
				<totalTime>0</totalTime>
				<repeat>0</repeat>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting />
	<actionBarComplite type="VisActionStopAction">
		<stoppedActionID>MeleeCombo</stoppedActionID>
	</actionBarComplite>
	<actionBarCancel type="VisActionStopAction">
		<stoppedActionID>MeleeCombo</stoppedActionID>
	</actionBarCancel>
	<precastType>PRECAST_DEFAULT</precastType>
	<launch />
	<playOnTargets>
		<specialAction />
	</playOnTargets>
</SpellVisScripts>