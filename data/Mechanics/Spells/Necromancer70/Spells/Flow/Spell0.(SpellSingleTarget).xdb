	<range type="gameMechanics.elements.calcers.FloatData">
		<value>30</value>
	</range>
	<prepareDuration>4000</prepareDuration>
	<ranks>
		<Item href="Spell01.(SpellSingleTarget).xdb" />
		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<casterResources />
		<channelingMechanics>
			<channelingBuff hrefvar="channelingBuff" />
		</channelingMechanics>
		<casterChannelingEffects>
			<Item type="gameMechanics.elements.effects.Switch">
