            <LayerHighlight href="/Interface/Ingame/ItemMall/Textures/ItemMall/BannersBottom/BonusButtonHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            <PushedOffset x="0" y="0"/>
            <Reaction>bonus_pressed</Reaction>
            <ReactionRightClick>bonus_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
