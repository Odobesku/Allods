<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Description href="/Spells/VisScripts/Prototypes2/Projectile.txt" />
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>ready</Item>
		</animations>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations />
						<scale>2</scale>
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations />
						<scale>2</scale>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<precastType>PRECAST_DEFAULT</precastType>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<autoHasten>
						<timeToBeLeft>500</timeToBeLeft>
					</autoHasten>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="VisActionList">
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Spells/AstralToxin.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<explosionFx href="/Spells/FX/Spells/HitAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<isMultyProjectile>true</isMultyProjectile>
								<theGe>3</theGe>
								<pointOnCaster type="VisPointLocator">
									<locator>Slot_Hand_R</locator>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator>Slot_BodyFX</locator>
								</pointOnTarget>
								<offendTime type="EffectOffendConstDelay" />
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<charged />
	<playOnTargets>
		<specialAction type="CreatureRunVisActionResource" />
	</playOnTargets>
</SpellVisScripts>
