<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="VisActionDelay">
            <time>1200</time>
        </playWhile>
        <elements>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Spells/Entrapment_Warrior_Channel.(VisObjectTemplate).xdb" />
                <fxLength>2</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </endPoint>
                <fadeInTime>100</fadeInTime>
                <fadeOutTime>100</fadeOutTime>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
            </Item>
        </elements>
    </actionBarStart>
</SpellVisScripts>