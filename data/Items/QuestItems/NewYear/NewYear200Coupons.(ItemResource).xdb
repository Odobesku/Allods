    <source>Vendor</source>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.ItemTakeActions">
        <actions>
            <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="NewYearCoupon.(ItemResource).xdb" />
                </item>
                <count type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                    <value>200</value>
                </count>
                <binding>Transfer</binding>
            </Item>
        </actions>
    </functionalPart>
    <requiredLevel>4</requiredLevel>
    <spell href="/Mechanics/Spells/Events/NewYear/NewYearCoupons/NewYear200Coupons.(SpellCasterSelf).xdb" />
