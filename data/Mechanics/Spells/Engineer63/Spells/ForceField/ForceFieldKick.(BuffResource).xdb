<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739932142</resourceId>
	</Header>
	<Name href="ForceFieldKick.(BuffResource).Name.txt" />
	<Description href="ForceFieldKick.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Mounts/SpellsMounts/AreaShuntAirMoto.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Engineer/ForceField.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactKill" />
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ForceFieldLifetime.(BuffResource).xdb" />
							<casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
			<predicate type="gameMechanics.elements.predicates.PredicateSpellInGroup">
				<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
			</predicate>
		</Item>
		<Item type="gameMechanics.elements.effects.IncomingHealModifier">
			<affectsPureHeal>true</affectsPureHeal>
			<priority>Multiplier</priority>
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-1</coeff>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>10</radius>
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="KickBuff.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
					<tick>1000</tick>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.MultiplyStat">
			<stat type="gameMechanics.elements.stat.StatFullHealth" />
			<multiplier>0.25</multiplier>
		</Item>
	</effects>
	<duration>1000</duration>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/EngineerDefenceDevices.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
