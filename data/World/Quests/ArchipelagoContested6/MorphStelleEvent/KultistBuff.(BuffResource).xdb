                                    <map href="/Maps/ArchipelagoContested6/MapResource.xdb" />
                                </locator>
                            </destination>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>100</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="KultistBuff.(BuffResource).xdb" />
                                    <anyRank>false</anyRank>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ReturningSuspicionBuff.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="AvatarAggroBuff.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasItemsCount">
                                <items>
                                    <Item href="/Items/QuestItems/ArchipelagoContested6/MorphStelleItem_01/MorphStelleItem_01.(ItemResource).xdb" />
