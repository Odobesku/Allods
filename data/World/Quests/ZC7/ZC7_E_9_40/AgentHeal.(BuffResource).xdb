<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>314548</resourceId>
    </Header>
    <Name href="AgentHeal.(BuffResource)_Name.txt" />
    <Description href="AgentHeal.(BuffResource)_Desc.txt" />
    <image href="/Interface/Icons/Spells/Bard/CheapSongs.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/VisScripts/Fairy/Meditation.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <nameTemplate href="AgentHeal.(BuffResource)_Name.txt.template" />
    <descTemplate href="AgentHeal.(BuffResource)_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.DirectHeal">
                    <heal>1</heal>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.1</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
            </impacts>
            <initialDelay>-1</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>0.9</level>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <removeExistingBuffs>false</removeExistingBuffs>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
                        <radius>60</radius>
                    </distributor>
                    <data href="/Characters/Undead_male/Instances/ZC8/AgentHeal.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactHeal">
                    <heal>1</heal>
                    <scalerTarget type="gameMechanics.elements.scalers.TrivialScaler" />
                    <scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                    </scalerCaster>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>15000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>