<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739879412</resourceId>
    </Header>
    <name href="Ice_Projectile.(ProjectileResource).Name.txt" />
    <visObject href="Ice_Comet.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <altitude>2</altitude>
    <speed>0.013</speed>
    <lifeLengthCap>25000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
            <effects>
                <Item type="gameMechanics.elements.effects.TickableEntityAura">
                    <tick>1000</tick>
                    <affectGroup>Enemies</affectGroup>
                    <radius>6</radius>
                    <height>6</height>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <holderImpactsIn>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                            <radius>6</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>COLD</element>
                                    <damage>90</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </holderImpactsIn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectDeferredEffects">
                    <effects>
                        <Item type="gameMechanics.elements.effects.TickableEntityAura">
                            <tick>1000</tick>
                            <affectGroup>Enemies</affectGroup>
                            <radius>3</radius>
                            <height>3</height>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIn>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                            </impactsIn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                        </moveType>
                        <resource href="Ice_Projectile_Boom.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                </Item>
            </impactsOff>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>