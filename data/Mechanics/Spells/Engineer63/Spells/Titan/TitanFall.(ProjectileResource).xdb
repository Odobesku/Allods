<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739932488</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="TitanFall.(ProjectileResource).Name.txt" />
	<visObject href="/Spells/FX/Spells/Engineer63_TitanFall_Deley.(VisObjectTemplate).xdb" />
	<altitude>0.05</altitude>
	<lifeLengthCap>2000</lifeLengthCap>
	<corpseDuration>1000</corpseDuration>
	<impactsOnDeath>
		<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
			<radius>15</radius>
			<affectGroup>Enemies</affectGroup>
			<affectHolder>false</affectHolder>
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
					<durationScaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
						<scalers>
							<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="constructor.elements.CalcerFloatExternal">
									<externalCalcer hrefvar="externalCalcer" />
								</mulCalcer>
							</Item>
							<Item type="gameMechanics.elements.scalers.LinearScaler">
								<multiplier>0.5</multiplier>
							</Item>
						</scalers>
					</durationScaler>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
					<value>1</value>
				</Item>
			</impacts>
		</Item>
	</impactsOnDeath>
</gameMechanics.world.projectile.ProjectileResource>
