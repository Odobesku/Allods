<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
	<Header>
		<resourceId>739918135</resourceId>
	</Header>
	<filter type="gameMechanics.world.creature.AvatarFilter" />
	<impactsIn>
		<Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
			<spawn>
				<scriptID>16_Keeper</scriptID>
				<map href="/Maps/FerrisRaid/MapResource.xdb" />
			</spawn>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Resident.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsElse>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Resident.(BuffResource).xdb" />
						</Item>
					</impactsElse>
				</Item>
			</impacts>
		</Item>
	</impactsIn>
</gameMechanics.map.scriptZone.ScriptZone>
