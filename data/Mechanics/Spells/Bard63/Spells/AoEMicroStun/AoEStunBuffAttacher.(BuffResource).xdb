<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>215435</resourceId>
    </Header>
    <Name href="AoEStunBuffAttacher.(BuffResource).Name.txt" />
    <Description href="AoEStunBuffAttacher.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Bard/Entree.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Bard/AoEStunBuff.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.Aura">
            <affectGroup>Enemies</affectGroup>
            <radius>15</radius>
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="StunAttacherOnEnemy.(BuffResource).xdb" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="StunAttacherOnEnemy.(BuffResource).xdb" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                </Item>
            </impactsOut>
            <filter type="gameMechanics.world.creature.CreatureFilter" />
        </Item>
        <Item type="gameMechanics.elements.effects.BuffInterceptor">
            <impactsOnAttach>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="AoEStunBuffAttacher.(BuffResource).xdb" />
                </Item>
            </impactsOnAttach>
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/StopSing.xdb" />
                        <Item href="/Mechanics/Spells/Groups/DRMesmerize.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Fears.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Disorients.xdb" />
                        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
                        <Item href="/Mechanics/Spells/Groups/Knockdowns.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Silence.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Blinds.xdb" />
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
                    </groups>
                </Item>
            </predicates>
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>