<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>210405</resourceId>
    </Header>
    <Name href="AnniversaryGift2012.(SpellCasterSelf)_Name.txt" />
    <Description href="AnniversaryGift2012.(SpellCasterSelf)_Desc.txt" />
    <nameTemplate href="AnniversaryGift2012.(SpellCasterSelf)_Name.txt.template" />
    <descTemplate href="AnniversaryGift2012.(SpellCasterSelf)_Desc.txt.template" />
    <targetType>STTSelf</targetType>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateIsRemort" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                                <key href="/System/ContentKeys/ItemmallService.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
                            </Item>
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                    <item href="/ItemMall/Services/Factors/RegularTrigger.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                </item>
                                <count>1000</count>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                    <item href="/ItemMall/Scrolls/Rituals/IMHalo1Day.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                </item>
                                <count>10</count>
                            </Item>
                        </impacts>
                        <elseImpacts>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                    <item href="/Items/Vendors/Myrrh/Myrrh100k.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                                </item>
                            </Item>
                        </elseImpacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="/Items/EventItems/Anniversasry/AnniversarySkilledItemGift.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                </item>
                <count>3</count>
            </Item>
        </casterImpacts>
    </mechanics>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>