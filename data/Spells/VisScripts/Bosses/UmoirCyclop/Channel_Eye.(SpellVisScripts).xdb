<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>channelCastDirected</Item>
						</animations>
						<channelOverrideScript />
						<advanced>
							<offendType>ONEOFFEND_ONETARGET</offendType>
						</advanced>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="VisActionDelay">
							<time>19500</time>
						</playWhile>
						<elements>
							<Item type="CreatureVisObjectComponentsAction">
								<visObjComponents>
									<Item type="ChannelingComponent">
										<channelingFx href="/Spells/FX/Mobs/Cyclop_Channel_Eye.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<fxLength>30</fxLength>
										<startPoint>
											<locator>FROM_LOCATOR_NAME</locator>
											<locatorName>Eye</locatorName>
											<shift x="0.05" y="0" z="-0.05" />
										</startPoint>
										<endPoint>
											<locator>FROM_LOCATOR_NAME</locator>
											<locatorName>Slot_Special98</locatorName>
										</endPoint>
									</Item>
								</visObjComponents>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
