<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>188255</resourceId>
    </Header>
    <Name href="FireRayBoss.(SpellSingleTarget).Name.txt" />
    <visualScripts href="FireRayBoss.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>80</value>
    </range>
    <prepareDuration>333</prepareDuration>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>500</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="FireRay.(BuffResource).xdb" />
                <consumeStacks>1</consumeStacks>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>FIRE</element>
                <damage>30</damage>
                <impactsOnHitTarget>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="RayHitMark.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/AstarlIslands/AI71/Flamethrower/FireDOT.(BuffResource).xdb" />
                    </Item>
                </impactsOnHitTarget>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>