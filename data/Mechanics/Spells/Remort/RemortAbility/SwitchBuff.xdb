<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>222022669</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateHasAbility">
					<ability href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
							<variable href="FlagBuffActive.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
						</Item>
					</impactsOn>
					<impactsOff>
						<Item type="gameMechanics.elements.impacts.ImpactVariableReset">
							<variable href="FlagBuffActive.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
						</Item>
					</impactsOff>
				</Item>
			</effectsIf>
			<effectsElse>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOff>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="SwitchBuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsOff>
				</Item>
			</effectsElse>
		</Item>
	</effects>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<isClientReplicated>false</isClientReplicated>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
	<canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
