                                                            <durationScaler type="gameMechanics.elements.scalers.ScalerBuff">
                                                                <buff href="DispellStacks.(BuffResource).xdb" />
                                                                <summand>0</summand>
                                                            </durationScaler>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOff>
                </Item>
