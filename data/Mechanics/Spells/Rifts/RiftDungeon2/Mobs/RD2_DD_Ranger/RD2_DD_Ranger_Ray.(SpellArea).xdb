<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>208934</resourceId>
    </Header>
    <Name href="RD2_DD_Ranger_Ray.(SpellArea).Name.txt" />
    <visualScripts href="/Mechanics/Spells/Rifts/RiftDungeon2/Mobs/RD2_Elite_Siege/RD2_Elite_Siege_Ray.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/Rifts/RiftDungeon2/Mobs/StopBuff.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>ASTRAL</element>
                <damage>1</damage>
                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageElite.(CalcerFloatResource).xdb" />
                            </mulCalcer>
                        </Item>
                    </scalers>
                </scaler>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.RectangularRay" />
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>20</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>