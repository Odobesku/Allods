<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>140566</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/IMEpic.(UISingleTexture).xdb" />
    <itemMallDescription href="UniversalUpgraderRare65.(ItemResource).ItemMallDescription.txt" />
    <source>FixedDrop</source>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="gameMechanics.constructor.schemes.item.meta.UltimateMetaUpgrader">
        <impacts>
            <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                <currency href="/Mechanics/TargetSale/MetaUpgraderCounter.(AlternativeCurrency).xdb" />
                <sumCalcer type="gameMechanics.elements.calcers.CalcerMul">
                    <calcers>
                        <Item type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
                            <currency href="/Mechanics/TargetSale/MetaUpgraderCounter.(AlternativeCurrency).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value>-1</value>
                        </Item>
                    </calcers>
                </sumCalcer>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="/Mechanics/TargetSale/UniversalUpgraderStackBuff.(BuffResource).xdb" />
            </Item>
        </impacts>
        <upgradeCondition type="gameMechanics.elements.item.ItemPredicateAnd">
            <predicates>
                <Item type="gameMechanics.elements.item.ItemPredicateLevel">
                    <range>
                        <min>65</min>
                        <max>65</max>
                    </range>
                </Item>
                <Item type="gameMechanics.elements.item.ItemPredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.item.ItemPredicateQuality">
                            <quality href="/Mechanics/ItemQualities/Common.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.item.ItemPredicateQuality">
                            <quality href="/Mechanics/ItemQualities/Uncommon.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.item.ItemPredicateQuality">
                            <quality href="/Mechanics/ItemQualities/Rare.xdb" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
        </upgradeCondition>
    </functionalPart>
    <level>65</level>
    <requiredLevel>10</requiredLevel>
    <stackLimit>20</stackLimit>
    <quality href="/Mechanics/ItemQualities/Rare.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
    </prices>
    <lifeLengthCap>2592000000</lifeLengthCap>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="UniversalUpgraderUncommon65.(ItemResource).Name.txt" />
    <description href="UniversalUpgraderRare65.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/ItemMall.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>