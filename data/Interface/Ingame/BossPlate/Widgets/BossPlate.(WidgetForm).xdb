<?xml version="1.0" encoding="UTF-8" ?>
<WidgetForm>
	<Name>BossPlate</Name>
	<Children>
		<Item href="BossItem.(WidgetButton).xdb#xpointer(/WidgetButton)" />
		<Item href="BossPanel.(WidgetPanel).xdb#xpointer(/WidgetPanel)" />
	</Children>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_BOTH</Align>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
		</Y>
	</Placement>
	<PickChildrenOnly>true</PickChildrenOnly>
</WidgetForm>
