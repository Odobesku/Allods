<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>207592</resourceId>
    </Header>
    <element>LIGHTNING</element>
    <Name href="ArchitectMinibossAOE.(SpellArea).Name.txt" />
    <visualScripts href="ArchitectMinibossAOE.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>8</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>12000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                <spell href="ArchitectMinibossCombo.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>25</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                                        <time>500</time>
                                        <impactsOnLand>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier>0.5</multiplier>
                                                </durationScaler>
                                            </Item>
                                        </impactsOnLand>
                                        <distance>16</distance>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                        <element>LIGHTNING</element>
                                        <damage>40</damage>
                                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
                <spell href="ArchitectProjectileSlow.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <factor type="gameMechanics.elements.scalers.TrivialScaler" />
                <sum type="gameMechanics.elements.calcers.LongData">
                    <value>8000</value>
                </sum>
                <canStartCooldown>true</canStartCooldown>
            </Item>
        </casterImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>8</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>