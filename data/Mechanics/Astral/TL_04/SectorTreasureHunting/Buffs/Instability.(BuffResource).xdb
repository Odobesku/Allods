    <nameTemplate href="Instability.txt" />
    <descTemplate href="Instability.Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>700</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderBoundShip" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="DeathHandler.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Desync.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderBoundShip" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Rules/Astral/TreasureHunting/BuffChestOnShipCaptured.xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactModifyBuffsTimeLeft">
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>20</value>
                                    </delta>
                                    <multiplier type="gameMechanics.elements.calcers.FloatData">
                                        <value>0</value>
                                    </multiplier>
                                    <condition type="gameMechanics.constructor.schemes.buff.PredicateBuffEquals">
                                        <buff href="/Mechanics/Rules/Astral/TreasureHunting/BuffChestOnShipCaptured.xdb" />
                                    </condition>
                                </Item>
                            </impactsIf>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Rules/Astral/TreasureHunting/BuffChestOnShip.xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactModifyBuffsTimeLeft">
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>20</value>
                                    </delta>
                                    <multiplier type="gameMechanics.elements.calcers.FloatData">
                                        <value>0</value>
                                    </multiplier>
                                    <condition type="gameMechanics.constructor.schemes.buff.PredicateBuffEquals">
                                        <buff href="/Mechanics/Rules/Astral/TreasureHunting/BuffChestOnShip.xdb" />
                                    </condition>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>5400000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <decayPolicy>OfflineDecay</decayPolicy>
    <canBeSaved>true</canBeSaved>
    <groups>
