<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>737148934</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <conditionsIn />
    <conditionsOut />
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
            <spawn>
                <scriptID>DemonBoss</scriptID>
                <map href="/Maps/Inst_SecretLab/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
            </spawn>
            <onBehalfOfTarget>true</onBehalfOfTarget>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                    <value>1</value>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
            <spawn>
                <scriptID>SL_Boss5Door</scriptID>
                <map href="/Maps/Inst_SecretLab/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
            </spawn>
            <impacts>
                <Item type="gameMechanics.elements.device.DoorSwitch">
                    <switchType>Close</switchType>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
            <zone href="DemonAggro.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                    <zone href="SL_BossDoorKiller.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                            </impactsIf>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
        </Item>
    </impactsIn>
    <impactsOut />
    <considerAsWhole>true</considerAsWhole>
</gameMechanics.map.scriptZone.ScriptZone>