                        <locator>
                            <scriptID>Last_TP_Cutscene</scriptID>
                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                        </locator>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>cutscene_boom</scriptID>
                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                        </locator>
                        <yaw type="constructor.basicElements.AngleDegrees">
                            <value>87</value>
                        </yaw>
                    </destination>
                    <impacts>
