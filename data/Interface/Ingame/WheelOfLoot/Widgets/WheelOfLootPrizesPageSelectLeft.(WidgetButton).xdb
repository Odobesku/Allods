<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>Left</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Size>18</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Pos>2</Pos>
            <Size>28</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>250</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>navigation_over_left</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>false</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag>button_label</TextTag>
    <Variants>
        <Item>
            <PushedOffset x="-2" y="2"/>
            <Reaction>navigation_pressed_left</Reaction>
            <ReactionRightClick>navigation_pressed_left</ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Ingame/Contextructor/ButtonRegular2/ButtonFormatDisabled.txt"/>
                <LayerMain href="/Interface/Ingame/WheelOfLoot/Textures/WheelOfLootPrizesPageSelect/WheelOfLootPrizesPageSelectLeftPressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateDisabled>
            <StateHighlighted>
                <LayerMain href="/Interface/Ingame/WheelOfLoot/Textures/WheelOfLootPrizesPageSelect/WheelOfLootPrizesPageSelectLeftHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/Contextructor/ButtonRegular2/ButtonFormatNormal.txt"/>
                <LayerMain href="/Interface/Ingame/WheelOfLoot/Textures/WheelOfLootPrizesPageSelect/WheelOfLootPrizesPageSelectLeftNormal.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/WheelOfLoot/Textures/WheelOfLootPrizesPageSelect/WheelOfLootPrizesPageSelectLeftPressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <reactionDblClick>navigation_pressed_left</reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
