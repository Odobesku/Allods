                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="/Mechanics/Spells/Mercenaries/SummonLeader/DisintegrateLeader.(BuffResource).xdb" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="/Mechanics/Spells/Mercenaries/SummonLeader/DisintegrateLeader.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                    <object href="/Characters/Hadagan_male/Instances/ZoneHadagan1/MercNPC_Leader.(MobWorld).xdb" />
                                                    <level type="gameMechanics.elements.calcers.CalcerLevel" />
                                                    <planeSyncStrategy>Sync</planeSyncStrategy>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impactsElse>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.constructor.basicElements.PredicateAnd">
