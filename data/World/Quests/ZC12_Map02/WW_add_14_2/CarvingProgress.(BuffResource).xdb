<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>310928</resourceId>
    </Header>
    <image href="/Interface/Icons/Special/Emotions/Victory.(UISingleTexture).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.constructor.basicElements.HighStackEffect">
            <effect type="gameMechanics.elements.effects.EffectsDeferred">
                <delay>1</delay>
                <effects>
                    <Item type="gameMechanics.elements.effects.Switch">
                        <impactsOn>
                            <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                                <spawn>
                                    <scriptID>Vaskov14</scriptID>
                                    <map href="/Maps/ZC12_Map02/MapResource.xdb" />
                                </spawn>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                        <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                        <data href="StoneCarverWin.(ClientData).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                <id href="Counter1.(QuestCountId).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="StoneCarverBuff.(BuffResource).xdb" />
                            </Item>
                        </impactsOn>
                    </Item>
                </effects>
            </effect>
            <stackCountTrigger>5</stackCountTrigger>
        </Item>
    </effects>
    <stackLimit>5</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>