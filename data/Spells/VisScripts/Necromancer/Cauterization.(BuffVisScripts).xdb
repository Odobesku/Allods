<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<delay>200</delay>
				<effectFx href="/Spells/FX/Spells/Necromancer70_CauterizationBuff_Slot.(VisObjectTemplate).xdb" />
				<scale>1.3</scale>
				<fadeInTime>0</fadeInTime>
				<fadeOutTime>0</fadeOutTime>
				<locator>Slot_FX</locator>
			</Item>
		</visualEffects>
	</action>
	<postAction type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/Necromancer70_Cauterization_Heal.(VisObjectTemplate).xdb" />
				<lockScale>true</lockScale>
				<scale>1</scale>
				<locator>Slot_Global</locator>
				<offset z="0" />
			</Item>
		</visualEffects>
	</postAction>
</BuffVisScripts>
