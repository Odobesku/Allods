<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222772</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/TransferFaction.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>100</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <affectHolder>false</affectHolder>
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="DoT_Hard_NoTank.(BuffResource).xdb" />
                                            <stacks type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                                <buff href="DoT_Hard_Transmission.(BuffResource).xdb" />
                                            </stacks>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.resources.ResourceAnyBuff">
                                                    <buffs>
                                                        <Item href="DoT_Hard_NoTank.(BuffResource).xdb" />
                                                        <Item href="DoT_Hard.(BuffResource).xdb" />
                                                    </buffs>
                                                </predicate>
                                            </Item>
                                        </predicates>
                                    </filter>
                                    <targetsLimit>1</targetsLimit>
                                    <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
                                        <order>Ascending</order>
                                    </sorting>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>5000</duration>
    <stackLimit>100</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>