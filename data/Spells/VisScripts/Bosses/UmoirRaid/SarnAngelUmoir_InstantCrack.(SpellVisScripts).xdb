<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<precastType>PRECAST_DEFAULT</precastType>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>attack01</Item>
						</animations>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
						</advanced>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>30</delay>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectAstralWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<fixPoint>true</fixPoint>
								<lockScale>false</lockScale>
								<scale>3</scale>
								<locator>Slot_Hand_L</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectFx href="/Spells/FX/Mobs/SarnAngelUmoir_InstantCrackCast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
