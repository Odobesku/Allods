<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
	<Header>
		<resourceId>739910930</resourceId>
	</Header>
	<name href="Cue_SoftModeConfirm.(Cue).Name.txt" />
	<text href="Cue_SoftModeConfirm.(Cue).Text.txt" />
	<conditions>
		<Item type="gameMechanics.constructor.basicElements.PredicateNot">
			<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
		</Item>
		<Item type="gameMechanics.elements.predicates.PredicateMobNear">
			<radius>55</radius>
			<mobs>
				<Item href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Boss/PortalBoss.(MobWorld).xdb" />
			</mobs>
		</Item>
		<Item type="gameMechanics.constructor.basicElements.PredicateNot">
			<predicate type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="/Mechanics/RaidInstances/FerrisRaid/Other/NeBoltai.(BuffResource).xdb" />
			</predicate>
		</Item>
	</conditions>
	<additionalConditions>
		<Item type="gameMechanics.elements.predicates.PredicateIsRaidLeader" />
	</additionalConditions>
	<impacts>
		<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="SoftMode.(BuffResource).xdb" />
				</Item>
			</impacts>
			<spawnResource href="NPCSpawnTable.(SpawnTable).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateInZone">
									<zone href="/Maps/FerrisRaid/Zones/RaidFerris4.(ZoneResource).xdb" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Boss/AvatarWatchingCutScene.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ImpactTeleport">
									<destination type="gameMechanics.map.destination.DestinationLocator">
										<locator>
											<scriptID>FR_13</scriptID>
											<map href="/Maps/FerrisRaid/MapResource.xdb" />
										</locator>
										<yaw type="constructor.basicElements.AngleDegrees">
											<value>5</value>
										</yaw>
									</destination>
									<finishImpacts>
										<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
											<impacts>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Boss/AvatarWatchingCutScene.(BuffResource).xdb" />
												</Item>
											</impacts>
										</Item>
									</finishImpacts>
								</Item>
							</impactsElse>
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Mechanics/RaidInstances/FerrisRaid/Other/NeBoltai.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</impacts>
</gameMechanics.world.mob.interaction.Cue>
