<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739833143</resourceId>
	</Header>
	<name href="Ktulhu.(AbilityResource).Name.txt" />
	<nameTemplate href="Ktulhu.(AbilityResource).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.basicElements.ImpactList">
							<impactsResource href="Wipe.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
						</Item>
					</impactsIf>
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Ship</scriptID>
						<map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<onBehalfOfTarget>true</onBehalfOfTarget>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</impacts>
			<skipSelfKill>true</skipSelfKill>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="Plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.SpawnSingleMob">
					<mob>
						<scriptID>KtulhuBrain</scriptID>
						<map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</mob>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>3000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectMobStatQuality">
			<quality href="Ktulhu.(MobStatQuality).xdb#xpointer(/gameMechanics.world.mob.MobStatQuality)" />
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateNot">
											<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
										</Item>
										<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
									</predicates>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.constructor.basicElements.ImpactList">
									<impactsResource href="Wipe.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>5000</tick>
			<initialDelay>20000</initialDelay>
		</Item>
	</effects>
	<disableWhileDead>true</disableWhileDead>
	<isAE>true</isAE>
</gameMechanics.constructor.schemes.ability.AbilityResource>
