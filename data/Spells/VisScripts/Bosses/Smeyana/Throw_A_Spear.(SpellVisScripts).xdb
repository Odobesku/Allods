<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>ready</PreCastAnimation>
			<FXProjectile>/Spells/FX/Mobs/Smeyana_SpearFire_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<CastAnimation>spellCastDirected</CastAnimation>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorOnCaster>FROM_LOCATOR_NAME</LocatorOnCaster>
			<Ge>12</Ge>
			<ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
			<LocatorNameOnCaster>Slot_Special02</LocatorNameOnCaster>
			<FXOnCaster />
			<FXOnTargets />
			<FixPointTarget>true</FixPointTarget>
			<FXProjectileHit>/Spells/FX/Mobs/Smeyana_SpearFire_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item skiped="" />
					<Item skiped="" />
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<actionBarComplite type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFireWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special02</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarComplite>
	<launch type="VisActionList">
		<play>InSequence</play>
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item type="VisActionList">
						<elements>
							<Item skiped="" />
							<Item type="CreatureProjectileAction">
								<explosionFx hrefvar="FXProjectileHit" />
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFireWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.5</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special02</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item skiped="" />
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
