<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>223712</resourceId>
    </Header>
    <element>LIGHTNING</element>
    <Name href="R7_SiegeBoss_Demolition.(SpellArea).Name.txt" />
    <prepareDuration>1000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTCurrentTarget</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>32000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>4000</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.RunImpactsInShape">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="R7_SiegeBoss_PlasmaBall.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                        <minDamage>55</minDamage>
                                        <maxDamage>65</maxDamage>
                                    </Item>
                                </impactsIf>
                                <impactsElse />
                            </Item>
                        </impacts>
                        <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
                            <angle type="constructor.basicElements.AngleDegrees">
                                <value>25</value>
                            </angle>
                        </shape>
                        <affectGroup>Enemies</affectGroup>
                        <radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
                            <value>80</value>
                        </radius>
                        <affectMainTarget>false</affectMainTarget>
                        <workOnDead>false</workOnDead>
                        <shapeCenterPosition>Caster</shapeCenterPosition>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="R7_Siege_Cleave_decal.(BuffResource).xdb" />
                <impactsOnAttach />
                <impactsOnFail />
            </Item>
        </casterImpacts>
        <targetImpacts />
    </mechanics>
    <radius>54</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>