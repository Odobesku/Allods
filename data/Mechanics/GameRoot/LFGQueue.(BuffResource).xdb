<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>238868</resourceId>
    </Header>
    <Name href="LFGQueue.(BuffResource).Name.txt" />
    <Description href="LFGQueue.(BuffResource).Description.txt" />
    <image href="/Interface/Ingame/ContextGuild/RelatedTextures/Mwar/MwarBattlesGroupIcon.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.world.ship.elements.EffectMapChanged">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
                                <Item type="gameMechanics.map.instance.astralIsland.PredicateOnAstralIsland" />
                                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventMember" />
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="avatarPopulation.service.impl.lookingForGroupImpl.elements.ImpactLeaveFromLFG" />
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
                                <Item type="gameMechanics.map.instance.astralIsland.PredicateOnAstralIsland" />
                                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventMember" />
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="avatarPopulation.service.impl.lookingForGroupImpl.elements.ImpactLeaveFromLFG" />
                    </impactsIf>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/LFG/Buffs/KickAFKLeader.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectTriggerAfk">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/LFG/Buffs/KickAFKLeader.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
            <effectsAfk>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsGroupLeader" />
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/LFG/Buffs/KickAFKLeader.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/LFG/Buffs/KickAFKLeader.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <initialDelay>1000</initialDelay>
                </Item>
            </effectsAfk>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>