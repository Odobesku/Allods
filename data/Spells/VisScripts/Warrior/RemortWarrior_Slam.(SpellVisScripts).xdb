<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attackPowerUnarmed</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<advanced>
					<speed>0</speed>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<autoHasten>
						<timeToBeLeft>0</timeToBeLeft>
					</autoHasten>
				</advanced>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<delay>120</delay>
						<effectFx href="/Spells/FX/Spells/WarriorSlam.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<delay>100</delay>
							<effectFx href="/Spells/FX/Spells/HitMelee.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<locator>Slot_BodyFX</locator>
							<offendTime />
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
