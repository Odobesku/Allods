<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>216542</resourceId>
    </Header>
    <Name href="AoeShield.(BuffResource).Name.txt" />
    <Description href="AoeShield.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/SweepingSlamUpgrade.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.FixedDamageAbsorber">
                    <elements>
                        <Item>PHYSICAL</Item>
                        <Item>FIRE</Item>
                        <Item>COLD</Item>
                        <Item>LIGHTNING</Item>
                        <Item>HOLY</Item>
                        <Item>SHADOW</Item>
                        <Item>ASTRAL</Item>
                        <Item>DISEASE</Item>
                        <Item>DISEASE</Item>
                        <Item>ACID</Item>
                    </elements>
                    <absorb>5</absorb>
                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                        <scalers>
                            <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>100</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                            <element>EPHYSICAL</element>
                                        </stat>
                                    </value>
                                </mulCalcer>
                            </Item>
                        </scalers>
                    </scaler>
                    <damagePredicates>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.offender.PredicateOffenderIsCaster" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                    </damagePredicates>
                    <scaledByCasterStats>true</scaledByCasterStats>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>4000</duration>
    <stackLimit>9</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>