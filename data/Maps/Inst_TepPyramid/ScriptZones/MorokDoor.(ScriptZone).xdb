<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>739835697</resourceId>
    </Header>
    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
        <filters>
            <Item type="gameMechanics.world.creature.AvatarFilter" />
            <Item type="gameMechanics.world.creature.AliveFilter" />
        </filters>
    </filter>
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>MorokDoor</scriptID>
                                <map href="/Maps/Inst_TepPyramid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                                    <visualState>1</visualState>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <spawnResource href="/Maps/Inst_TepPyramid/SpawnTables/Inst_TepPyramid/Boss_04.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
        </Item>
    </impactsIn>
    <considerAsWhole>true</considerAsWhole>
</gameMechanics.map.scriptZone.ScriptZone>