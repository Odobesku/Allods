<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>288723968</resourceId>
	</Header>
	<Name href="ExitHangarName.txt" />
	<Description href="ExitHangarDesc.txt" />
	<image href="/Interface/Icons/Actions/AngarFlayButton.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<prepareDuration>0</prepareDuration>
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>0</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateOnParentShip">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateShipManualMode" />
				</predicates>
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateOnAddressee">
						<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceUser" />
						<predicates>
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="/Mechanics/GameRoot/LFGQueue.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</predicates>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
						<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceUser" />
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
								<distributor type="gameMechanics.elements.calcers.TargetDistributor" />
								<data href="/Mechanics/GameRoot/ClientData/BlockAstral.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
							</Item>
						</impacts>
					</Item>
				</impactsIf>
				<impactsElse>
					<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
						<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceUser" />
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
								<impacts>
									<Item type="gameMechanics.elements.impacts.ImpactIsolator">
										<impacts>
											<Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
												<affectPets>false</affectPets>
												<impacts>
													<Item type="gameMechanics.elements.impacts.BuffDetacher">
														<buff href="/Mechanics/Ships/Hangar/Buffs/ShipMasterBuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
														<anyRank>false</anyRank>
													</Item>
												</impacts>
											</Item>
										</impacts>
									</Item>
								</impacts>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
						<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderTransport" />
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
								<impacts>
									<Item type="gameMechanics.elements.impacts.MarkedImpactGeneric">
										<mark href="/Mechanics/Ships/Hangar/ExitHangar.(MarkResource).xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
									</Item>
								</impacts>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
								<predicates>
									<Item type="gameMechanics.map.instance.astralIsland.PredicateOnAstralIsland" />
								</predicates>
								<elseImpacts>
									<Item type="itemService.elements.astral.ImpactShowShipTicketsInfo" />
								</elseImpacts>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="ShipMovingBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</predicates>
						<impactsElse>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="ShipMovingBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</impactsElse>
					</Item>
				</impactsElse>
			</Item>
		</casterImpacts>
	</mechanics>
	<speed>0</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
