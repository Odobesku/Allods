<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.CursedItems>
	<Header>
		<resourceId>153295873</resourceId>
	</Header>
	<predicates>
		<Item type="gameMechanics.constructor.basicElements.PredicateNot">
			<predicate type="gameMechanics.elements.predicates.PredicateHasContentKey">
				<key href="/System/ContentKeys/P2P_shard/CursedItems.(ContentKey).xdb" />
			</predicate>
		</Item>
	</predicates>
	<cursedRollsCount>3</cursedRollsCount>
	<cursedDropProbability>0.3333</cursedDropProbability>
	<canBeCursed type="gameMechanics.elements.item.ItemPredicateOr">
		<predicates>
			<Item type="gameMechanics.elements.item.ItemPredicateAnd">
				<predicates>
					<Item type="gameMechanics.elements.item.ItemPredicateNot">
						<predicate type="gameMechanics.elements.item.ItemPredicateLevel">
							<range>
								<max>14</max>
							</range>
						</predicate>
					</Item>
					<Item type="gameMechanics.elements.item.ItemPredicateQualityGreaterOrEqual">
						<quality href="/Mechanics/ItemQualities/Uncommon.xdb" />
					</Item>
					<Item type="gameMechanics.elements.item.ItemPredicateHasStatBonuses" />
				</predicates>
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateCategory">
				<category href="/Mechanics/ItemCategories/Misc/TutorialItems.(ItemCategoryTerminal).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup0.(WorldDropSuffixGroup).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup1.(WorldDropSuffixGroup).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup3.(WorldDropSuffixGroup).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup4.(WorldDropSuffixGroup).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup5.(WorldDropSuffixGroup).xdb" />
			</Item>
		</predicates>
	</canBeCursed>
	<globalCurse type="gameMechanics.elements.item.ItemPredicateOr">
		<predicates>
			<Item type="gameMechanics.elements.item.ItemPredicateCategory">
				<category href="/Mechanics/ItemCategories/Misc/TutorialItems.(ItemCategoryTerminal).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup0.(WorldDropSuffixGroup).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup1.(WorldDropSuffixGroup).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup3.(WorldDropSuffixGroup).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup4.(WorldDropSuffixGroup).xdb" />
			</Item>
			<Item type="gameMechanics.elements.item.ItemPredicateSuffixFromGroup">
				<suffixGroup href="/Items/MetaItems/700+Sets/Suffixes/70SuffixGroup5.(WorldDropSuffixGroup).xdb" />
