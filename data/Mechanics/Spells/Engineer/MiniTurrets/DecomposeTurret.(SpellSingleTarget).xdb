								</impacts>
							</Item>
							<Item type="gameMechanics.elements.impacts.RepeatedImpact">
								<impact type="gameMechanics.elements.impacts.ReturningImpact">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactModifySpellGroupCooldown">
											<group href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
