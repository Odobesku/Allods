<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739878703</resourceId>
    </Header>
    <Name href="WormArea.(SpellArea).Name.txt" />
    <visualScripts href="WormAreaScript.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <prepareDuration>3000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>14000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>30</radius>
                <affectGroup>Enemies</affectGroup>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>PHYSICAL</element>
                                <damage>30</damage>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                <delay>500</delay>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                        <data href="/Mechanics/Spells/AstarlIslands/AI19/EarthElementalGroundSlam/HitTarget.xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsIf>
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
            </Item>
        </targetImpacts>
    </mechanics>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>30</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>