<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureHoldWeaponAction">
		<hold>WEAPON_NONE</hold>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureHideMountVisAction" />
			<Item type="CreatureChangeVisItemsAction">
				<items>
					<Item>
						<slot>MAINHAND</slot>
						<newItem href="/Items/VisualItems/Weapon/1HAxe/Axe_1H_A_04KoboldWarrior_R4.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
					</Item>
				</items>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>mining</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
