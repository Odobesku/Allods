<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739965342</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Chests/SkilledItemsBoxBlue.(UISingleTexture).xdb" />
	<showItemContextAction>Always</showItemContextAction>
	<isQuestRelated>true</isQuestRelated>
	<canBeDeposited>false</canBeDeposited>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb" />
	<functionalPart type="itemService.avatar.itemBag.ItemTakeActions">
		<actions>
			<Item type="itemService.avatar.itemBag.IfTakeAction">
				<predicate type="itemService.mail.predicates.PredicateHasContentKey">
					<key href="/System/ContentKeys/ItemmallService.(ContentKey).xdb" />
				</predicate>
				<actions>
					<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="TutorialPiece.(ItemResource).xdb" />
						</item>
						<binding>Transfer</binding>
					</Item>
					<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="TutorialPieceFort.(ItemResource).xdb" />
						</item>
						<binding>Transfer</binding>
					</Item>
					<Item type="itemService.elements.components.ItemTakeActionImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
								<quest href="HighEndStart.(QuestResource).xdb" />
								<counterResource href="C1_unpack.(QuestCountId).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
								<quest href="HighEndStart_L.(QuestResource).xdb" />
								<counterResource href="C1_unpack.(QuestCountId).xdb" />
							</Item>
						</impacts>
					</Item>
				</actions>
			</Item>
			<Item type="itemService.avatar.itemBag.IfTakeAction">
				<predicate type="itemService.mail.predicates.PredicateHasContentKey">
					<key href="/System/ContentKeys/P2P_shard/P2P_shard_Server.(ContentKey).xdb" />
				</predicate>
				<actions>
					<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="TutorialPiece.(ItemResource).xdb" />
						</item>
						<binding>Transfer</binding>
					</Item>
					<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="TutorialPieceFort.(ItemResource).xdb" />
						</item>
						<binding>Transfer</binding>
					</Item>
					<Item type="itemService.elements.components.ItemTakeActionImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
								<quest href="HighEndStart_p2p.(QuestResource).xdb" />
								<counterResource href="C1_unpack.(QuestCountId).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
								<quest href="HighEndStart_L_p2p.(QuestResource).xdb" />
								<counterResource href="C1_unpack.(QuestCountId).xdb" />
							</Item>
						</impacts>
					</Item>
				</actions>
			</Item>
		</actions>
	</functionalPart>
	<quality href="/Mechanics/ItemQualities/Uncommon.xdb" />
	<prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
	<binding>BindOnPickup</binding>
	<name href="TutorialBox.(ItemResource).Name.txt" />
	<description href="TutorialBox.(ItemResource).Description.txt" />
	<canBeDroppedPredicate type="gameMechanics.constructor.basicElements.PredicateOr">
		<predicates>
			<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
				<quest href="HighEndStart.(QuestResource).xdb" />
				<status>Finished</status>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
				<quest href="HighEndStart_p2p.(QuestResource).xdb" />
				<status>Finished</status>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
				<quest href="HighEndStart_L.(QuestResource).xdb" />
				<status>Finished</status>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
				<quest href="HighEndStart_L_p2p.(QuestResource).xdb" />
				<status>Finished</status>
			</Item>
		</predicates>
	</canBeDroppedPredicate>
</gameMechanics.constructor.schemes.item.ItemResource>
