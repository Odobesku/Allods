<?xml version ="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <visActionID></visActionID>
        <elements>
            <Item type="VisActionList">
                <visActionID></visActionID>
                <elements>
                    <Item type="ProceduralEffectVisAction">
                        <visActionID></visActionID>
                        <priority>0</priority>
                        <proceduralEffect href="/Spells/FX/InterfaceFX/Poison.(ProceduralEffect).xdb#xpointer(/client.VisualConstructor.ProceduralEffect)"/>
                        <timeOff>10</timeOff>
                        <timeOn>0.33</timeOn>
                        <useOn>RiderAndMount</useOn>
                    </Item>
                </elements>
                <play>Simultaneously</play>
                <playWhile type="VisActionDelay">
                    <visActionID></visActionID>
                    <time>1100</time>
                </playWhile>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
            <Item type="CreatureEffectsAction">
                <visActionID></visActionID>
                <category>EFFECT_DEFAULT</category>
                <visualEffects>
                    <Item>
                        <delay>300</delay>
                        <effectAnimations>
                            <mode>DIE</mode>
                        </effectAnimations>
                        <effectFx href="/Spells/FX/Spells/NecromancerCorrosiveAcidAbility.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                        <fadeInTime>0</fadeInTime>
                        <fadeOutTime>0</fadeOutTime>
                        <scale>1</scale>
                        <fixPoint>false</fixPoint>
                        <lockScale>false</lockScale>
                        <muteFxSounds>false</muteFxSounds>
                        <ignoreParentRotation>false</ignoreParentRotation>
                        <locator>FROM_LOCATOR_NAME</locator>
                        <locatorName>Slot_Global</locatorName>
                        <member>Default_Member</member>
                        <offset x="0" y="0" z="0"/>
                        <rotation x="0" y="0" z="0" w="0"/>
                        <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                    </Item>
                </visualEffects>
                <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                <stopOnDeath>false</stopOnDeath>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </action>
    <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>
