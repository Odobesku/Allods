<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739918070</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/IMShardOfFrozenTearsBlue.(UISingleTexture).xdb#xpointer(/UISingleTexture)"/>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)"/>
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                        <currency
                                href="TeardropFraction.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)"/>
                        <multiplier>200</multiplier>
                    </Item>
                </actions>
                <consumeItems>1</consumeItems>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="TeardropUncommon.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)"/>
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceAltCurrency">
                    <currency
                            href="TeardropFraction.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)"/>
                    <count>700</count>
                </predicate>
            </Item>
        </predicates>
    </functionalPart>
    <quality href="/Mechanics/ItemQualities/Goods.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)"/>
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
    </prices>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="TeardropFractionX200.(ItemResource).Name.txt"/>
    <description href="TeardropFraction.(AlternativeCurrency).Description.txt"/>
    <category
            href="/Mechanics/ItemCategories/ItemMall.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)"/>
</gameMechanics.constructor.schemes.item.ItemResource>
