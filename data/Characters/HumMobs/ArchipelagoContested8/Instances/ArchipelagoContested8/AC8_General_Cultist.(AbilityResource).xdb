                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="AC8_General_plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.Guard" />
