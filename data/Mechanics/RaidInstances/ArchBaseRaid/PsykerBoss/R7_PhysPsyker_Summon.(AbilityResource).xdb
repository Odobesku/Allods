<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739924921</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="R7_PhysPsyker_Add_BossDeathTrigger.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ImpactSummon">
									<destination type="gameMechanics.map.destination.DestinationModified">
										<destination type="gameMechanics.map.destination.RelativePos" />
										<modifiers>
											<Item type="gameMechanics.map.destination.modifier.ModifierTrail">
												<modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
													<verticalRange min="0" max="0" />
													<horizontalRange min="20" max="35" />
												</modifier>
											</Item>
										</modifiers>
									</destination>
									<object href="R7_InfPsyker_Add.(MobWorld).xdb" />
								</Item>
							</impactsElse>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.Disintegrate" />
			</onLeave>
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>90</radius>
							<affectGroup>Friends</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="R7_PhysPsyker_Pulse.(BuffResource).xdb" />
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
										<mobs>
											<Item href="R7_PsykerBoss.(MobWorld).xdb" />
										</mobs>
									</Item>
								</predicates>
							</filter>
						</Item>
					</impacts>
					<tick>8000</tick>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Phys_Plane.(BuffResource).xdb" />
				</Item>
			</impactsOn>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
