<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739967541</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
								</moveType>
								<resource href="AI60_Bear_CleaveTrigger.(ProjectileResource).xdb" />
							</projectileData>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="AI60_Cleave.(SpellArea).xdb" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
			<stages>
				<Item>Start</Item>
			</stages>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ResetSpawnTable">
					<table href="/Maps/AstralIsle60_UI08/SpawnTables/AI60_Boss01.(SpawnTable).xdb" />
				</Item>
			</onLeave>
		</Item>
	</effects>
	<disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>
