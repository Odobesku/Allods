<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739932377</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/ArchitectorSpells.(ActionGroupElement).xdb" />
		<Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftEliteSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftRangedSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftBossSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftMeleeSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftTankSpells.(ActionGroup).xdb" />
	</groups>
	<Name href="RD_AEShot_Architector.(SpellArea).Name.txt" />
	<visualScripts href="RD_AEShot_Architector.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<prepareDuration>1500</prepareDuration>
	<targetType>STTPoint</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>8000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
				<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
					<value>0.4</value>
				</chanceCalcer>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
						<spell href="RD_AEShot_Architector.(SpellArea).xdb" />
					</Item>
				</impacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.PostponedImpacts">
				<impacts>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="/Mechanics/Spells/Rifts/Abilities/StopBuff.(BuffResource).xdb" />
						<impactsOnAttach />
						<impactsOnFail />
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
				<element>ASTRAL</element>
				<damage>1</damage>
				<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
					<scalers>
						<Item type="gameMechanics.elements.scalers.MagicScaler" />
						<Item type="gameMechanics.elements.scalers.ScalerIf">
							<condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
								<quality href="/Mechanics/MobQualities/Elite.xdb" />
							</condition>
							<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="constructor.elements.CalcerFloatExternal">
									<externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
								</mulCalcer>
							</scalerIf>
							<scalerElse type="gameMechanics.elements.scalers.ScalerIf">
								<condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
									<quality href="/Mechanics/MobQualities/Boss.xdb" />
								</condition>
								<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
									<mulCalcer type="constructor.elements.CalcerFloatExternal">
										<externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageElite.(CalcerFloatResource).xdb" />
									</mulCalcer>
								</scalerIf>
								<scalerElse type="gameMechanics.elements.scalers.LinearMultiplierScaler">
									<mulCalcer type="constructor.elements.CalcerFloatExternal">
										<externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageBoss.(CalcerFloatResource).xdb" />
									</mulCalcer>
								</scalerElse>
							</scalerElse>
						</Item>
					</scalers>
				</scaler>
			</Item>
		</targetImpacts>
	</mechanics>
	<speed>20</speed>
	<radius>5</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>