<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739911862</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                    <impact type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                <destination type="gameMechanics.map.destination.DestinationModified">
                                    <destination type="gameMechanics.map.destination.RelativePos">
                                        <coord z="20" />
                                    </destination>
                                    <modifiers>
                                        <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                            <verticalRange min="0" max="1" />
                                            <horizontalRange min="2" max="10" />
                                        </Item>
                                    </modifiers>
                                </destination>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                </impacts>
                                <object href="CrowAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                <pool href="CrowAdd.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                            </Item>
                        </impacts>
                    </impact>
                    <count type="gameMechanics.elements.calcers.FloatData">
                        <value>5</value>
                    </count>
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="CrowAdd.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="Boss04_AviakAdd.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                            <impact type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                        <destination type="gameMechanics.map.destination.DestinationModified">
                                            <destination type="gameMechanics.map.destination.RelativePos">
                                                <coord z="20" />
                                            </destination>
                                            <modifiers>
                                                <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="0" max="1" />
                                                    <horizontalRange min="2" max="10" />
                                                </Item>
                                            </modifiers>
                                        </destination>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                        </impacts>
                                        <object href="CrowAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        <pool href="CrowAdd.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                    </Item>
                                </impacts>
                            </impact>
                            <count type="gameMechanics.elements.calcers.FloatData">
                                <value>5</value>
                            </count>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>6000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="CrowPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="CrowPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="CrowPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="CrowPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="CrowPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Incoming</vector>
                <direction>Outgoing</direction>
                <plane href="CrowPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="/Maps/AstralIsle63/SpawnTables/Boss04_portal.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>