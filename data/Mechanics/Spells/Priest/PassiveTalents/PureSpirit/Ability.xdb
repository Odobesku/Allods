<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>90373162</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.Name.txt" />
    <description href="Ability.Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value var="dmg" />
        </Item>
        <Item>
            <name>prt</name>
            <value var="prt" />
        </Item>
        <Item>
            <name>repel</name>
            <value var="repel" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Priest/PriestSpiritualFocus.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerOutputDamageChannel">
            <element>HOLY</element>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff var="coeff" />
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.OutgoingHealModifier">
            <scaler type="gameMechanics.elements.scalers.SimpleEffectScaler">
                <scaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier var="factor" />
                </scaler>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Priest/HealingRadiance/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff var="prot" />
                    </scaler>
                </Item>
                <Item type="gameMechanics.elements.effects.BuffInterceptor">
                    <forceAttachBuff>false</forceAttachBuff>
                    <repelChanceCalcer type="gameMechanics.elements.calcers.FloatData">
                        <value var="repel" />
                    </repelChanceCalcer>
                    <predicates>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                            <groups>
                                <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                            </groups>
                        </Item>
                    </predicates>
                </Item>
            </effects>
        </Item>
    </effects>
    <majorEffect>-1</majorEffect>
    <level>1</level>
    <ranks>
        <Item href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability02.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability03.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
    <disableWhileDead>false</disableWhileDead>
    <saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>