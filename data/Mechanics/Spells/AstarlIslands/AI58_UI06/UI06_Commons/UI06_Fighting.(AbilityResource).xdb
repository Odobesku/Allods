<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>185848</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectIfOverTime">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>20</radius>
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                    </impacts>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                        <faction href="/World/Factions/Umoir/UI06_Tekuani.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
            </impactsIf>
            <runImpactsOnEachTick>true</runImpactsOnEachTick>
            <tick type="gameMechanics.elements.calcers.FloatData">
                <value>6000</value>
            </tick>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
            <impactsToTarget>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateFaction">
                            <faction href="/World/Factions/Umoir/UI06_Tekuani.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value>0.6</value>
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="UI06_TekuaniFear.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                            <impactsLose>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/AstarlIslands/AI58_UI06/UI06_SoloBars/Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsLose>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsToTarget>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>