<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739933234</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceHealTrigger.xdb" />
    </groups>
    <element>SHADOW</element>
    <Name href="Spell0_Name.txt" />
    <Description href="Spell0_Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>HealScaler</formula>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerBloodpact.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Necromancer/Restoration.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <prepareDuration>3000</prepareDuration>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <channelingMechanics>
            <channelingBuff hrefvar="channelingBuff" />
            <finishImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable href="/Mechanics/Spells/Necromancer70/Abilities/BloodDrops/BloodPool.(VariableResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </finishImpacts>
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/Necromancer70/Abilities/ChannelWatcher/Channel.(BuffResource).xdb" />
                        <impactsOnAttach />
                        <impactsOnFail />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/Necromancer70/Abilities/ChannelWatcher/HealingChannel.(BuffResource).xdb" />
                    </Item>
                </impactsOn>
                <impactsOff>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="/Mechanics/Spells/Necromancer70/Abilities/ChannelWatcher/Channel.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="/Mechanics/Spells/Necromancer70/Abilities/ChannelWatcher/HealingChannel.(BuffResource).xdb" />
                    </Item>
                </impactsOff>
            </Item>
            <Item type="gameMechanics.elements.effects.EffectsIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Necromancer70/Abilities/HealCastOnMove/MoveTrigger.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <effectsIf>
                    <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
                        <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                            <coeff>1.25</coeff>
                        </effectScaler>
                    </Item>
                </effectsIf>
            </Item>
        </casterChannelingEffects>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>