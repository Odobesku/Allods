<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/MageTeleportAbility.(VisObjectTemplate).xdb" />
						<scale>0.4</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="ProceduralEffectVisAction">
				<proceduralEffect href="/Spells/FX/InterfaceFX/Ghost.(ProceduralEffect).xdb" />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/EyeBlue.(VisObjectTemplate).xdb" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Eye_R</locatorName>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/EyeBlue.(VisObjectTemplate).xdb" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Eye_L</locatorName>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/GhostSmokeCommon.(VisObjectTemplate).xdb" />
						<scale>1.7</scale>
						<locator>Slot_FX</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/GhostSmokeCommon.(VisObjectTemplate).xdb" />
						<scale>1.3</scale>
						<locator>Slot_Head</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureSetTransparencyAction">
				<transparency>0.7</transparency>
			</Item>
		</elements>
	</actionBarStart>
	<actionBarComplite type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/MageBlinkAbility.(VisObjectTemplate).xdb" />
				<fixPoint>true</fixPoint>
				<scale>2</scale>
				<locator>Slot_Global</locator>
				<member>Mount</member>
			</Item>
		</visualEffects>
	</actionBarComplite>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>100</delay>
						<effectFx href="/Spells/FX/Spells/MageBlinkAbility_End.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<locator>Slot_Global</locator>
						<member>Mount</member>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
