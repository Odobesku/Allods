<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739888948</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="InFlame.(BuffResource).xdb" />
							</predicate>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<affectGroup>Enemies</affectGroup>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
									<projectileData>
										<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
										<resource href="IceBlow.(ProjectileResource).xdb" />
									</projectileData>
									<pool href="ElementalBossPool.(SummonPool).xdb" />
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateOr">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
											</Item>
										</predicates>
									</Item>
									<Item type="gameMechanics.constructor.basicElements.PredicateNot">
										<predicate type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="IceChains.(BuffResource).xdb" />
										</predicate>
									</Item>
								</predicates>
							</filter>
							<targetsLimit>2</targetsLimit>
						</Item>
					</impactsIf>
				</Item>
			</impacts>
			<tick>10000</tick>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
