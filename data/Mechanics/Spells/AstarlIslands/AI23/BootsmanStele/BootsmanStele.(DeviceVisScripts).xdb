<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
    <states>
        <Item>
            <action type="DeviceAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>idleOffline</Item>
                </animations>
            </action>
        </Item>
        <Item>
            <action type="DeviceAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>idleMalfunction</Item>
                </animations>
            </action>
        </Item>
        <Item>
            <action type="DeviceVisActionList">
                <elements>
                    <Item type="DeviceAnimationAction">
                        <mode>LOOP</mode>
                        <animations>
                            <Item>idle</Item>
                        </animations>
                    </Item>
                    <Item type="DeviceVisEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Ships/Parts/DeviceDamaged_Smoke.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </action>
