<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>249472</resourceId>
    </Header>
    <Name href="FrogStorm.(SpellSingleTarget).Name.txt" />
    <nameTemplate href="FrogStorm.(SpellSingleTarget).Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>73000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>50</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                                <impact type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                <verticalRange min="0" max="0" />
                                                <horizontalRange min="1" max="4" />
                                            </Item>
                                        </modifiers>
                                    </destination>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                        <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                                    </impacts>
                                    <object href="FrogStorm.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                </impact>
                                <count type="gameMechanics.elements.calcers.FloatData">
                                    <value>3</value>
                                </count>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.creature.AvatarFilter" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>