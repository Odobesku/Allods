<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222707</resourceId>
    </Header>
    <Name href="JumpResource.(BuffResource).Name.txt" />
    <Description href="JumpResource.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidPetGetItUpgrade.chn.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                    <spell href="JumpSpell.(SpellSingleTarget).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/Taunt.xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectNoAggro" />
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateAggrolistCanSelect">
                                    <selector type="gameMechanics.tools.SelectorRandomNotLess">
                                        <minIndex>0</minIndex>
                                    </selector>
                                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                                <predicates>
                                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                        <buff href="JumpTarget.(BuffResource).xdb" />
                                                    </Item>
                                                </predicates>
                                            </Item>
                                        </predicates>
                                    </filter>
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="JumpResource.(BuffResource).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
    </effects>
    <duration>30000</duration>
    <stackLimit>8</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>