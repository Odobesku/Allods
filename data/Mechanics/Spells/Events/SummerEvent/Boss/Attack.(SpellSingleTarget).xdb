    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <mechanics>
        <cooldown>
            <duration>3000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                <rule href="/Mechanics/Rules/SummerEvent/Boss.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
            </Item>
        </casterConditions>
        <targetConditions>
