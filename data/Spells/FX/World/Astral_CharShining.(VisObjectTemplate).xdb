    <geometry href="/Spells/FX/World/Astral_CharShining.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)"/>
    <scale>2</scale>
    <sound>
        <name>spells/FX/World/Astral_CharShining</name>
