    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                <key href="/System/ContentKeys/BonusBox_Newbie.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateGreaterLong">
                        <lhs type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                        <rhs type="gameMechanics.elements.calcers.CalcerLevel" />
                    </predicate>
                </predicate>
                <clientData href="BonusBoxUniversal_LevelData.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="BonusBoxUniversal.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                </item>
                <itemLevel type="gameMechanics.elements.calcers.LongData">
                    <value>10</value>
                </itemLevel>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                        <key href="/System/ContentKeys/ItemmallService.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="SkilledBox/AdvancedBonus05.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                <impact type="gameMechanics.constructor.basicElements.ImpactList">
                    <impactsResource href="RandomEquipReward.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                </impact>
                <count type="gameMechanics.elements.calcers.FloatData">
                    <value>3</value>
                </count>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>