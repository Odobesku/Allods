<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Children>
        <Item href="/Interface/Ingame/RuneCombiner/Widgets/GoldChamber.(WidgetPanel).xdb#xpointer(/client.Widgets.WidgetPanel)"/>
        <Item href="/Interface/Ingame/RuneCombiner/Widgets/CrystalChamber.(WidgetPanel).xdb#xpointer(/client.Widgets.WidgetPanel)"/>
    </Children>
    <Name>SliderBtn</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Size>22</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Size>28</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>20</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing></reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>false</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>false</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_DEFAULT</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag></TextTag>
    <Variants>
        <Item>
            <PushedOffset x="0" y="0"/>
            <Reaction></Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted>
                <LayerMain href="/Interface/Ingame/RuneCombiner/Textures/SliderOvr.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateHighlighted>
            <StateNormal>
                <LayerMain href="/Interface/Ingame/RuneCombiner/Textures/Slider.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
