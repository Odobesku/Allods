<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>320942</resourceId>
    </Header>
    <Name href="Acceleration_buff.(BuffResource).Name.txt" />
    <Description href="Acceleration_buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffMagicBallBlue01.(UISingleTexture).xdb" />
    <visScript href="WaterAcceleration.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>1</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Acceleration_buff.(BuffResource).xdb" />
                </Item>
            </onEnter>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactDismount" />
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffInterceptor">
            <impactsOnAttach>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Acceleration_buff.(BuffResource).xdb" />
                </Item>
            </impactsOnAttach>
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffEquals">
                    <buff href="/Mechanics/GameRoot/Mount/MountBuff.xdb" />
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSwimTrigger">
            <impactsOnStopSwim>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Acceleration_buff.(BuffResource).xdb" />
                </Item>
            </impactsOnStopSwim>
        </Item>
    </effects>
    <duration>30000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>