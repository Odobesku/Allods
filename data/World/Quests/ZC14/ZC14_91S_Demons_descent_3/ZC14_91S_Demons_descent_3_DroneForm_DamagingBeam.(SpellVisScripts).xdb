<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.CreatureEffectsAction">
						<category>EFFECT_DEFAULT</category>
						<visualEffects>
							<Item>
								<delay>0</delay>
								<effectAnimations>
									<mode>DIE</mode>
								</effectAnimations>
								<effectFx href="/Spells/FX/Spells/Engineer_BarrelShot_ReadySpell.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fadeInTime>250</fadeInTime>
								<fadeOutTime>250</fadeOutTime>
								<scale>1</scale>
								<fixPoint>false</fixPoint>
								<lockScale>false</lockScale>
								<muteFxSounds>false</muteFxSounds>
								<ignoreParentRotation>false</ignoreParentRotation>
								<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Slot_Special01</locatorName>
								<member>Default_Member</member>
								<offendTime type="client.Replica.EffectOffendConstDelay">
									<delay>0</delay>
								</offendTime>
								<offset x="0" y="0" z="0" />
								<rotation x="0" y="0" z="0" />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
							</Item>
						</visualEffects>
						<dontFade>false</dontFade>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
						<stopOnDeath>false</stopOnDeath>
					</Item>
				</elements>
				<play>Simultaneously</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="client.Replica.CreatureTurnToTargetAction">
						<maxDistance>1000</maxDistance>
						<minDistance>0</minDistance>
					</Item>
				</elements>
				<play>InSequence</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</actionBarStart>
	<precastType>PRECAST_DEFAULT</precastType>
	<wholeCasting type="client.Replica.VisActionList">
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</wholeCasting>
	<launch type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Spells/Engineer_Defibrillation_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<endPoint type="client.Replica.VisPointLocator">
							<shift x="0" y="0" z="0" />
							<from>FROM_DEFALUT</from>
							<locator>Slot_FX</locator>
							<member>Default_Member</member>
						</endPoint>
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<fxLength>4</fxLength>
						<multyTargetMode>FromCaster</multyTargetMode>
						<offendTime type="client.Replica.EffectOffendConstDelay">
							<delay>0</delay>
						</offendTime>
						<secondaryTargetParams>
							<fadeInTime>0</fadeInTime>
							<fadeOutTime>0</fadeOutTime>
							<fxLength>2</fxLength>
							<velocity>0</velocity>
							<scaleTextureU>false</scaleTextureU>
							<scaleTextureV>false</scaleTextureV>
						</secondaryTargetParams>
						<startPoint type="client.Replica.VisPointLocator">
							<shift x="0" y="0" z="0" />
							<from>FROM_DEFALUT</from>
							<locator>FROM_LOCATOR_NAME</locator>
							<locatorName>Slot_Special01</locatorName>
							<member>Default_Member</member>
						</startPoint>
						<velocity>0</velocity>
						<scaleTextureU>false</scaleTextureU>
						<scaleTextureV>false</scaleTextureV>
					</Item>
				</elements>
				<play>Simultaneously</play>
				<playWhile type="client.Replica.VisActionDelay">
					<time>500</time>
				</playWhile>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.CreatureEffectsAction">
						<category>EFFECT_DEFAULT</category>
						<visualEffects>
							<Item>
								<delay>0</delay>
								<effectAnimations>
									<mode>DIE</mode>
								</effectAnimations>
								<effectFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fadeInTime>250</fadeInTime>
								<fadeOutTime>250</fadeOutTime>
								<scale>1</scale>
								<fixPoint>true</fixPoint>
								<lockScale>false</lockScale>
								<muteFxSounds>false</muteFxSounds>
								<ignoreParentRotation>false</ignoreParentRotation>
								<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Slot_Special01</locatorName>
								<member>Default_Member</member>
								<offendTime type="client.Replica.EffectOffendConstDelay">
									<delay>0</delay>
								</offendTime>
								<offset x="0" y="0" z="0" />
								<rotation x="0" y="0" z="0" />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
							</Item>
						</visualEffects>
						<dontFade>false</dontFade>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
						<stopOnDeath>false</stopOnDeath>
					</Item>
					<Item type="client.Replica.CreatureEffectsOnTarget">
						<category>EFFECT_DEFAULT</category>
						<visualEffects>
							<Item>
								<delay>0</delay>
								<effectAnimations>
									<mode>DIE</mode>
								</effectAnimations>
								<effectFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fadeInTime>250</fadeInTime>
								<fadeOutTime>250</fadeOutTime>
								<scale>1</scale>
								<fixPoint>true</fixPoint>
								<lockScale>false</lockScale>
								<muteFxSounds>false</muteFxSounds>
								<ignoreParentRotation>false</ignoreParentRotation>
								<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
								<locator>Slot_FX</locator>
								<member>Default_Member</member>
								<offendTime type="client.Replica.EffectOffendConstDelay">
									<delay>0</delay>
								</offendTime>
								<offset x="0" y="0" z="0" />
								<rotation x="0" y="0" z="0" />
								<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
							</Item>
						</visualEffects>
						<dontFade>false</dontFade>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
						<stopOnDeath>false</stopOnDeath>
						<direction>DIR_NO_TRANSFORM</direction>
					</Item>
				</elements>
				<play>Simultaneously</play>
				<playWhile type="client.Replica.VisActionDelay">
					<time>1000</time>
				</playWhile>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.CreatureTurnToTargetAction">
						<maxDistance>1000</maxDistance>
						<minDistance>0</minDistance>
					</Item>
				</elements>
				<play>Simultaneously</play>
				<playWhile type="client.Replica.VisActionDelay">
					<time>200</time>
				</playWhile>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
