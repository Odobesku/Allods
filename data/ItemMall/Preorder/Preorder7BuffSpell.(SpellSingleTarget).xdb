<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>141755</resourceId>
    </Header>
    <Name href="Preorder7BuffSpell.(SpellSingleTarget).Name.txt" />
    <Description href="Preorder7BuffSpell.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Examples/SummonMount.(SpellVisScripts).xdb" />
    <prepareDuration>1000</prepareDuration>
    <targetType>STTSelf</targetType>
    <isWorkOnDead>true</isWorkOnDead>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                        <spell href="Preorder7BuffSpell.(SpellSingleTarget).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
                        <spell href="Preorder7BuffSpell.(SpellSingleTarget).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="PetBuff.(BuffResource).xdb" />
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellActivate">
                        <spell href="Preorder7BuffSpell.(SpellSingleTarget).xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="PetBuff.(BuffResource).xdb" />
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>