										<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
											<predicates>
												<Item type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="MercUnderControl.(BuffResource).xdb" />
												</Item>
											</predicates>
										</filter>
									</Item>
								</impacts>
							</Item>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="NoRegenSignaled.(BuffResource).xdb" />
							</Item>
						</impactsIf>
					</Item>
				</casterToTarget>
			</impacts>
		</Item>
		<Item type="avatarPopulation.service.impl.matchMakingImpl.map.EffectLockLFGEvent" />
	</effects>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
