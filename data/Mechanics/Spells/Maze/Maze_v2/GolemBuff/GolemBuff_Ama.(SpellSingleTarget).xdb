<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739878413</resourceId>
	</Header>
	<isExploit>true</isExploit>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>3</value>
	</range>
	<prepareDuration>2000</prepareDuration>
	<immutablePrepareDuration>true</immutablePrepareDuration>
	<targetType>STTCurrentTargetNotSelf</targetType>
	<modifiers>
		<Item type="gameMechanics.elements.spell.RepelOnNuisance" />
		<Item type="gameMechanics.elements.spell.RaiseRepelType">
			<repelType>FAIL</repelType>
		</Item>
	</modifiers>
	<iffPolicy>Everyone</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
		</casterConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ReturningImpactsGeneric">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
								<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
									<item href="/Items/QuestItems/Domination/WiningToken.(ItemResource).xdb" />
								</item>
								<count type="gameMechanics.elements.calcers.FloatToLongCalcer">
									<calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
										<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
											<scalers>
												<Item type="gameMechanics.elements.scalers.RateScaler">
													<rate href="/Mechanics/Rules/LuckyDays/Rates/BGWinToken.(RateResource).xdb" />
												</Item>
											</scalers>
										</scaler>
										<value>10</value>
									</calcer>
								</count>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
								<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
									<item href="/Items/Agents/AmaFragment_70.(ItemResource).xdb" />
								</item>
								<count type="gameMechanics.elements.calcers.FloatToLongCalcer">
									<calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
										<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
											<scalers>
												<Item type="gameMechanics.elements.scalers.RateScaler">
													<rate href="/Mechanics/Rules/LuckyDays/Rates/Agent.(RateResource).xdb" />
												</Item>
												<Item type="gameMechanics.elements.scalers.ScalerExternal">
													<scalerResource href="/Items/Agents/ExternamAma7Factor.(ScalerResource).xdb" />
												</Item>
											</scalers>
										</scaler>
										<value>10</value>
									</calcer>
								</count>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.device.DeviceDie" />
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
