<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739920526</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
        <Item href="/Mechanics/Spells/Groups/Thrusts.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
    </groups>
    <Name href="TreacherousAttack.(SpellSingleTarget).Name.txt" />
    <Description href="TreacherousAttack.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="avgDamage" />
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>WeaponScalerSpeed</formula>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>1.66667</multiplier>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Warrior/WarriorParry.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Warrior/TrickyAttack.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>1</duration>
            <scaler type="gameMechanics.elements.scalers.WeaponSpeedScaler" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateUsesWeapon" />
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceCombatAdvantage">
                <minValue>35</minValue>
                <ability href="/Mechanics/Spells/War63/Abilities/CombatAdvantage/Ability.(AbilityResource).xdb" />
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                        <scalerTarget type="gameMechanics.elements.scalers.ScalerIf">
                            <condition type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                                <groups>
                                    <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                                    <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                    <Item href="/Mechanics/Spells/Groups/DisableMovement.(ActionGroup).xdb" />
                                </groups>
                            </condition>
                            <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>1.5</multiplier>
                            </scalerIf>
                            <scalerElse type="gameMechanics.elements.scalers.TrivialScaler" />
                        </scalerTarget>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                                <Item type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier>1.66667</multiplier>
                                </Item>
                            </scalers>
                        </scaler>
                        <avgDamage var="avgDamage" />
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>