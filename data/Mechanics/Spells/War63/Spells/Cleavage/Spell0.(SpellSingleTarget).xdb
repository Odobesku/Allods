<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>216151</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
        <Item href="/Mechanics/Spells/Groups/Moves.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
    </groups>
    <Name href="Spell_Name.txt" />
    <Description href="Spell_Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="avgDamage" />
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>WeaponScalerSpeed</formula>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>1.66667</multiplier>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>FormulaPercent</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Warrior/WarriorsForce.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Warrior/Cleavage.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <targetType>STTCurrentTarget</targetType>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateUsesWeapon" />
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>45</mana>
                <manaType>
                    <Item>Energy</Item>
                </manaType>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactAddCombatAdvantage">
                        <value>25</value>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff hrefvar="debuff" />
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                                <Item type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier>1.66667</multiplier>
                                </Item>
                            </scalers>
                        </scaler>
                        <avgDamage var="avgDamage" />
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>