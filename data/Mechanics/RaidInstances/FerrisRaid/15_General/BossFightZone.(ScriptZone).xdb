<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>222838</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Boss/AvatarCounted.(BuffResource).xdb" />
                </Item>
            </predicates>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>15_GeneralBoss</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Boss/AvatarCounted.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsElse>
        </Item>
    </impactsIn>
    <impactsOut>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="Boss/AvatarCounted.(BuffResource).xdb" />
        </Item>
    </impactsOut>
    <considerAsWhole>true</considerAsWhole>
</gameMechanics.map.scriptZone.ScriptZone>