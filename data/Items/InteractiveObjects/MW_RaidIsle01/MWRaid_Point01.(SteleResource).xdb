<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
    <Header>
        <resourceId>488463</resourceId>
    </Header>
    <persistentParts>
        <Item type="gameMechanics.world.cellReplication.MapWideReplicated" />
        <Item type="bunch.ClientSpecificPart">
            <resource href="MWRaid_Point01.(ClientData).xdb" />
        </Item>
        <Item type="gameMechanics.map.spawn.recaptureable.RecapturableObserverResource">
            <radius>30</radius>
            <creatureConditions>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                        <groups>
                            <Item href="/Mechanics/Spells/Groups/Shroud.xdb" />
                        </groups>
                    </predicate>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="CheckBuff.(BuffResource).xdb" />
                    </predicate>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateMounted" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateMounted">
                            <specificGroup href="/Mechanics/Mounts/Groups/ExoMounts.(MountGroupResource).xdb" />
                        </Item>
                    </predicates>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.constructor.basicElements.PredicateExternal">
                        <predicateResource href="/Mechanics/Spells/Mounts/AirMoto/IsPassenger.(PredicateResource).xdb" />
                    </predicate>
                </Item>
            </creatureConditions>
        </Item>
    </persistentParts>
    <name href="MWRaid_Point01.(ClientData).Name.txt" />
    <visObj href="/World/Generic/Environment/Models/Mega_War_Raid_Turel/Mega_War_Raid_Turel_Neutral.(VisObjectTemplate).xdb" />
    <collision href="/World/Generic/Environment/Models/Mega_War_Raid_Turel/Mega_War_Raid_Turel_Fire.(Collision).xdb" />
    <visScripts href="MWRaid_Stelle.(DeviceVisScripts).xdb" />
    <collisionObject>false</collisionObject>
    <interactiveObject>true</interactiveObject>
    <exploitingText href="MWRaid_Point01.(SteleResource).ExploitingText.txt" />
    <scale>1.5</scale>
    <corpseDuration>1000</corpseDuration>
    <corpseEmptyDuration>1000</corpseEmptyDuration>
</gameMechanics.world.device.SteleResource>