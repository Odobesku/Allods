<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>310802</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
            <impactsOnLeave>
                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                    <assistantResource href="WW_12_1_eskort.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="WW_12_1_eskort.(BuffResource).xdb" />
                </Item>
            </impactsOnLeave>
            <timeout>900000</timeout>
            <activeZone href="/Maps/IllusionWorld/Zones/ZC6_IllusionWorld_10.(ZoneResource).xdb" />
            <checkTopLevelZonesOnly>false</checkTopLevelZonesOnly>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                    <quest href="/World/Quests/ZC12_Map02/WW_12_2/WW_12_2.xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                    <assistantResource href="WW_12_1_eskort.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="WW_12_1_eskort.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                            <zone href="/Maps/ZC12_Map02/ScriptZones/WW_12_2_NPC.(ScriptZone).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="WW_12_1_NPC.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/ZC12_Map02/Zones/ZC12_Map02/ZC12_Map02.(ZoneResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="/World/Quests/ZC12_Map02/WW_12_2/WW_12_2_bomb.(SummonPool).xdb" />
                            <isPersonalPool>true</isPersonalPool>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="/World/Quests/Umoir/U_4_04/U_4_04.xdb" />
            <counterId href="/World/Quests/Umoir/U_4_04/CountId_4.xdb" />
            <condition type="constructor.elements.LongEquals">
                <value>1</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                            <quest href="/World/Quests/ZC12_Map02/WW_12_2/WW_12_2.xdb" />
                            <status>Completed</status>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                            <assistantResource href="WW_12_1_eskort.(AssistantResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="WW_12_1_eskort.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                    <quest href="/World/Quests/ZC12_Map02/WW_12_2/WW_12_2.xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>