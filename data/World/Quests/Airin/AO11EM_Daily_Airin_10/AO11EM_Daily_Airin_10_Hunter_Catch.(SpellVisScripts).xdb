<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
  <actionBarStart type="client.Replica.VisActionList">
    <play>InSequence</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </actionBarStart>
  <precastType>PRECAST_DEFAULT</precastType>
  <wholeCasting type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionDelay">
        <time>100</time>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.SLON.CreatureIndependentFxAction">
            <lifeTime>0.5</lifeTime>
            <offset x="0" y="0" z="0" />
            <rotation x="0" y="0" z="0" />
            <scale>6</scale>
            <visEventPointIndex>-1</visEventPointIndex>
            <visObject href="/Spells/FX/World/Trap_Aura.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <isRelative>true</isRelative>
            <useCastPoint>true</useCastPoint>
          </Item>
          <Item type="client.SLON.CreatureIndependentFxAction">
            <lifeTime>1.5</lifeTime>
            <offset x="0" y="0" z="0" />
            <rotation x="0" y="0" z="0" />
            <scale>1</scale>
            <visEventPointIndex>-1</visEventPointIndex>
            <visObject href="/World/Quests/HuntingGround3/AO11_Town04/AO11_Town04_GuardAura_r6.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <isRelative>true</isRelative>
            <useCastPoint>true</useCastPoint>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>InSequence</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </wholeCasting>
  <launch type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.CreatureIndependentFxAction">
        <lifeTime>4</lifeTime>
        <offset x="0" y="0" z="0" />
        <rotation x="0" y="0" z="0" />
        <scale>2.39999986</scale>
        <visEventPointIndex>-1</visEventPointIndex>
        <visObject href="/Spells/FX/Spells/Entrapment_Warrior.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
        <isRelative>true</isRelative>
        <useCastPoint>true</useCastPoint>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </launch>
  <ownKillingParams>
    <probabilityNoOverkill>0.2</probabilityNoOverkill>
    <probabilityWithOverkill>1</probabilityWithOverkill>
  </ownKillingParams>
  <playOnTargets>
    <skipBloodFx>false</skipBloodFx>
    <skipHitAnimations>false</skipHitAnimations>
  </playOnTargets>
  <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>