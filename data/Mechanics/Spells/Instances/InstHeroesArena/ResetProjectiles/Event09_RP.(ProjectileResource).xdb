<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>195846</resourceId>
    </Header>
    <visObject href="/Spells/FX/World/Empty.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>0</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EntityWaitNoneOrSomeAround">
            <radius>100</radius>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="/Creatures/Kobold/Warrior/Instances/Inst_HeroesArena/SwarmKobold.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </mobs>
                    </Item>
                </predicates>
            </filter>
            <impactsOnNone>
                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                    <table href="/Maps/Inst_HeroesArena/SpawnTables/HeroesArena/FakeNPC01.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>100</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                            <affectPets>true</affectPets>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/Instances/InstHeroesArena/Devices/DetachNoUse.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <finalImpactsOnHolder>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </finalImpactsOnHolder>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impactsOnNone>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>