<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739923277</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability0.(AbilityResource).Name.txt" />
	<description href="Ability0.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>mana</name>
			<value var="mana" />
		</Item>
		<Item>
			<name>heal</name>
			<value var="heal" />
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer href="/Mechanics/Spells/Druid70/Spells/Sprout/Calcer3.(CalcerFloatResource).xdb" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>MagicScaler</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Misc/Food/Acorn.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/Heal/Buff01.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.BuffExtraEffects">
					<buffs>
						<Item href="/Mechanics/Spells/Druid70/Spells/Sprout/WaitBuff01.(BuffResource).xdb" />
					</buffs>
					<effects>
						<Item type="gameMechanics.elements.effects.Switch">
							<impactsOn>
								<Item type="gameMechanics.elements.impacts.ImpactsUnderEnvelope">
									<spell href="/Mechanics/Spells/Druid70/Spells/Sprout/Spell01.(SpellSingleTarget).xdb" />
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactHeal">
											<heal var="heal" />
											<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="gameMechanics.elements.calcers.HealthInferiorityCalcer" />
												<sum>1</sum>
											</scalerTarget>
											<scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="constructor.elements.CalcerFloatExternal">
													<externalCalcer href="/Mechanics/Spells/Druid70/Spells/Sprout/Calcer3.(CalcerFloatResource).xdb" />
												</mulCalcer>
												<additionalMultiplier>
													<scaler type="gameMechanics.elements.scalers.HealScaler" />
												</additionalMultiplier>
											</scalerCaster>
										</Item>
									</impacts>
								</Item>
							</impactsOn>
							<impactsOff>
								<Item type="gameMechanics.elements.impacts.ImpactsIf">
									<predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
										<buff href="/Mechanics/Spells/Druid70/Abilities/BurstOfLife/HoT03.(BuffResource).xdb" />
									</predicate>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.RepeatedImpact">
											<impact type="gameMechanics.elements.impacts.ReturningImpact">
												<impacts>
													<Item type="gameMechanics.elements.impacts.IncrementMana">
														<manaType>Mana</manaType>
														<amount>1</amount>
														<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
															<mul var="mana" />
															<mulCalcer type="gameMechanics.elements.calcers.FullManaCalcer">
																<multiplier>0.01</multiplier>
															</mulCalcer>
														</scaler>
													</Item>
												</impacts>
											</impact>
											<count type="gameMechanics.constructor.basicElements.ScalerCalcer">
												<scaler type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
													<buff href="/Mechanics/Spells/Druid70/Abilities/BurstOfLife/HoT03.(BuffResource).xdb" />
													<anyRank>true</anyRank>
													<onlyFromMaster>true</onlyFromMaster>
													<mul>1</mul>
												</scaler>
												<value>1</value>
											</count>
										</Item>
									</impactsIf>
								</Item>
							</impactsOff>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
