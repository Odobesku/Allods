<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739924860</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
    </groups>
    <Name href="/Mechanics/Spells/Rifts/RiftDungeon3/Mobs/RD3_Engineer/RD3_Engineer_Attack.(SpellArea).Name.txt" />
    <visualScripts href="/Mechanics/Spells/Rifts/RiftDungeon3/Mobs/RD3_Engineer/RD3_Engineer_Attack.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <prepareDuration>2100</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                <ability href="/Mechanics/Spells/Rifts/RiftDungeon3/Mobs/RD3_Engineer/RD3_Engineer_Mounted.(AbilityResource).xdb" />
            </Item>
        </casterConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                    <Item type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                        <quality href="/Mechanics/MobQualities/Boss.xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>LIGHTNING</element>
                        <damage>8</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>LIGHTNING</element>
                        <damage>1</damage>
                        <impactsOnHitTarget />
                        <impactsOnHitCaster />
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impactsElse>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>20</speed>
    <radius>5</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>