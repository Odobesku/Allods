<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/DisguiseCommon.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_BodyFX</locator>
						<member>Group</member>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>300</time>
					</Item>
					<Item type="CreatureChangeVisItemsAction">
						<items>
							<Item>
								<slot>ARMOR</slot>
								<newItem href="/Items/VisualItems/Armor/Leather_D_31RealWorldRewardArmor.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
							</Item>
							<Item>
								<slot>BELT</slot>
								<newItem href="/Items/VisualItems/Belt/Leather_D_31RealWorldRewardBelt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
							</Item>
							<Item>
								<slot>BOOTS</slot>
								<newItem href="/Items/VisualItems/Boots/Leather_D_31RealWorldRewardBoots.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
							</Item>
							<Item>
								<slot>BRACERS</slot>
								<newItem href="/Items/VisualItems/Bracers/Leather_D_31RealWorldRewardBracers.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
							</Item>
							<Item>
								<slot>GLOVES</slot>
								<newItem href="/Items/VisualItems/Gloves/Leather_D_31RealWorldRewardGloves.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
							</Item>
							<Item>
								<slot>PANTS</slot>
								<newItem href="/Items/VisualItems/Pants/Leather_D_31RealWorldRewardPants.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
							</Item>
							<Item>
								<slot>LIFESTYLESUIT</slot>
							</Item>
						</items>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
