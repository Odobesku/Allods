<?xml version="1.0" encoding="UTF-8" ?>
<MobEventsScripts>
	<idleScriptParams>
		<idlePeriodMin>2</idlePeriodMin>
		<idlePeriodMax>4</idlePeriodMax>
		<script type="VisActionRandom">
			<elements>
				<Item>
					<action type="CreatureAnimationAction">
						<animations>
							<Item>attack</Item>
						</animations>
					</action>
				</Item>
				<Item>
					<action type="CreatureAnimationAction">
						<animations>
							<Item>spellCastDirected</Item>
						</animations>
					</action>
				</Item>
			</elements>
		</script>
	</idleScriptParams>
</MobEventsScripts>
