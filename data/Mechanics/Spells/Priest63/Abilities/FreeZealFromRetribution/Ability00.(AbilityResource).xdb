<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739920302</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability00.(AbilityResource).Name.txt" />
	<description href="Ability00.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>small</name>
			<value var="small" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Priest/PriestZeal.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectVariableTrigger">
			<resource href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
			<valueTriggers>
				<Item>
					<onGreaterOrEqual>true</onGreaterOrEqual>
					<value type="gameMechanics.elements.calcers.FloatData">
						<value>1</value>
					</value>
					<effects>
						<Item type="gameMechanics.elements.effects.SpellsModifier">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
									<spells>
										<Item href="/Mechanics/Spells/Priest63/Spells/HolyOrb/Spell01.(SpellSingleTarget).xdb" />
									</spells>
								</Item>
							</predicates>
							<modifiers>
								<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
									<effects>
										<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
											<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
												<coeff>0.01</coeff>
												<calcer type="gameMechanics.elements.calcers.CalcerIf">
													<predicate type="gameMechanics.elements.predicates.PredicateVariableGreatThan">
														<resource href="/Mechanics/Spells/Priest63/Abilities/Zeal/Zeal.(VariableResource).xdb" />
														<minValue>1</minValue>
													</predicate>
													<calcerIf type="gameMechanics.elements.calcers.FloatData">
														<value var="big" />
													</calcerIf>
													<calcerElse type="gameMechanics.elements.calcers.FloatData">
														<value var="small" />
													</calcerElse>
												</calcer>
											</scaler>
										</Item>
									</effects>
									<onBehalfOfHolder>true</onBehalfOfHolder>
								</Item>
							</modifiers>
						</Item>
					</effects>
				</Item>
			</valueTriggers>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
		<Item href="Ability04.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
