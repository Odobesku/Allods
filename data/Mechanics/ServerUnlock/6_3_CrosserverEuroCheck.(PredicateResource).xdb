<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.PredicateResource>
    <Header>
        <resourceId>261641</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <predicates>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                            <key href="/System/ContentKeys/Europe.(ContentKey).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                            <lhs type="itemService.serverVariables.CalcerServerVariable">
                                <variableResource href="ServerUnlock.(ServerVariableResource).xdb" />
                            </lhs>
                            <rhs type="gameMechanics.elements.calcers.LongData">
                                <value var="value" />
                            </rhs>
                        </Item>
                    </predicates>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateHasContentKey">
                        <key href="/System/ContentKeys/Europe.(ContentKey).xdb" />
                    </predicate>
                </Item>
            </predicates>
        </Item>
    </predicates>
</gameMechanics.constructor.basicElements.PredicateResource>