<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739885627</resourceId>
    </Header>
    <Name href="SpearStrike.(SpellSingleTarget).Name.txt" />
    <visualScripts href="SpearStrike.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>2500</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.RunImpactsInShape">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                        <impactsOnHitTarget>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="Bleeding_HM.(BuffResource).xdb" />
                                            </Item>
                                        </impactsOnHitTarget>
                                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                        <minDamage>35</minDamage>
                                        <maxDamage>35</maxDamage>
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                        <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
                            <angle type="constructor.basicElements.AngleDegrees">
                                <value>45</value>
                            </angle>
                        </shape>
                        <affectGroup>Enemies</affectGroup>
                        <radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
                            <value>20</value>
                        </radius>
                        <affectMainTarget>false</affectMainTarget>
                        <workOnDead>false</workOnDead>
                        <shapeCenterPosition>Caster</shapeCenterPosition>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="SpearStrike.(ClientData).xdb" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                <minDamage>35</minDamage>
                                <maxDamage>35</maxDamage>
                            </Item>
                        </impactsElse>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Bleeding.(BuffResource).xdb" />
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                        <minDamage>35</minDamage>
                        <maxDamage>35</maxDamage>
                    </Item>
                </elseImpacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>