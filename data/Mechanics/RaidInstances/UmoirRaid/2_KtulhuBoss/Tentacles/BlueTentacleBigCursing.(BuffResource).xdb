<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739862127</resourceId>
	</Header>
	<Name href="BlueTentacleBigCursing.(BuffResource).Name.txt" />
	<Description href="BlueTentacleBigCursing.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Buffs/TentacleBlue.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<interfaceHighPriority>true</interfaceHighPriority>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
											<value>1</value>
										</Item>
									</impacts>
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterAnd">
								<filters>
									<Item type="gameMechanics.world.creature.AvatarFilter" />
									<Item type="gameMechanics.world.creature.AliveFilter" />
								</filters>
							</filter>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Ktulhu</scriptID>
						<map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
							<selector type="gameMechanics.tools.SelectorShuffle" />
							<impacts>
								<Item>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="BlueBigCurse.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.Enlarge">
			<factor>3</factor>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Ktulhu</scriptID>
						<map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
							<selector type="gameMechanics.tools.SelectorShuffle" />
							<impacts>
								<Item>
									<impacts>
										<Item type="gameMechanics.elements.impacts.StackBuff">
											<buff href="BlueBigCurse.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											<delta type="gameMechanics.elements.calcers.FloatData">
												<value>-1</value>
											</delta>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
