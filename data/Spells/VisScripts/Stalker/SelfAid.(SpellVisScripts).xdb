<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/UseItem.(SpellVisScripts).xdb" />
		<Variables>
			<AfterUseAnimation>useStandingLoop</AfterUseAnimation>
			<AfterUseTime>3000</AfterUseTime>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>useStandingStart</Item>
					<Item>useStandingLoop</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
