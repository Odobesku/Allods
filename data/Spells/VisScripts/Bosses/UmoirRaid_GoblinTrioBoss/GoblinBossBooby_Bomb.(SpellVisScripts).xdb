<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readySpellDirected</Item>
		</animations>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visActionID>Grenade</visActionID>
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Creatures/GoblinBossBooby/GoblinBossBoobyGrenade.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<locator>Slot_Hand_L</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>3390</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>Grenade</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<playWhile />
				<elements>
					<Item type="VisActionDelay">
						<time>400</time>
					</Item>
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Creatures/GoblinBossBooby/GoblinBossBoobyGrenadeProj.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="" />
						<theGe>7</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_L</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>FROM_LOCATOR_NAME</locator>
							<locatorName>Slot_Back_Special</locatorName>
						</pointOnTarget>
						<offendTime />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
