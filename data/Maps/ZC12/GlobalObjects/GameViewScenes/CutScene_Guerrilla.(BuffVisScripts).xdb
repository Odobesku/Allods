<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/WideScreen.(UserPostEffect).xdb" />
			</Item>
			<Item type="VisActionChangeVisObject">
				<newVisMob href="/Creatures/Willowisp/Invis.(VisualMob).xdb" />
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureCutSceneAction" />
				</elements>
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Music/Music.(FMODProject).xdb" />
					<name>Music/CutSceneMusic/ZC12_Guerrilla</name>
				</sound>
				<reverbPreset>
					<project href="" />
					<name />
				</reverbPreset>
			</Item>
		</elements>
		<stopOnDeath>true</stopOnDeath>
	</action>
	<stackCountVisScripts />
</BuffVisScripts>
