<?xml version="1.0" encoding="UTF-8" ?>
<VisualMob>
    <character href="/Creatures/Colossus/Colossus.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)"/>
    <colorCoefficients>
        <b>1</b>
        <g>1</g>
        <r>1</r>
        <w>0.2</w>
        <use>false</use>
    </colorCoefficients>
    <creatureParameters>
        <disableProceduralAndColorEffects>true</disableProceduralAndColorEffects>
    </creatureParameters>
    <decalScale>1</decalScale>
    <fixedIdleAnimation>sleep</fixedIdleAnimation>
    <hitAnimationCooldown>360000</hitAnimationCooldown>
    <hitCritAnimationCooldown>360000</hitCritAnimationCooldown>
    <pickAabb>
        <center x="0" y="0" z="0"/>
        <extents x="0" y="0" z="0"/>
    </pickAabb>
    <procedureFxScale>1</procedureFxScale>
    <scale>0.5</scale>
    <timeToCorpseFadingMax>0</timeToCorpseFadingMax>
    <timeToCorpseFadingMin>0</timeToCorpseFadingMin>
    <transparency>1</transparency>
    <variation>
        <hairColor>-1</hairColor>
        <morphPreset/>
        <morphPresetIndex>0</morphPresetIndex>
        <shoulderStoneColor>-1</shoulderStoneColor>
        <skinColor>-1</skinColor>
    </variation>
    <visualScript type="CreatureAnimationAction">
        <visActionID></visActionID>
        <advanced>
            <autoHasten>
                <mode>AUTOHASTEN_NONE</mode>
                <timeToBeLeft>0</timeToBeLeft>
            </autoHasten>
            <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
            <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
            <offendType>NO_OFFEND</offendType>
            <turnToTarget>TURN_DEFAULT</turnToTarget>
            <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
            <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
            <denyAutoHasten>false</denyAutoHasten>
            <disableRandomFirstFrame>true</disableRandomFirstFrame>
            <eventPlaybackEnd>false</eventPlaybackEnd>
            <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
            <stopIfMoved>false</stopIfMoved>
            <stopIfRotated>false</stopIfRotated>
        </advanced>
        <animations>
            <Item>sleep</Item>
        </animations>
        <channel>CHANNEL_DEATH</channel>
        <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
        <channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
        <mode>LOOP</mode>
        <specialController></specialController>
        <use>USE_ANIMATIONS</use>
        <dontFreezePrecast>false</dontFreezePrecast>
    </visualScript>
    <disableFall>false</disableFall>
    <skipCharacterVisualScript>false</skipCharacterVisualScript>
    <useIdleSpecial>true</useIdleSpecial>
    <useVisualTweaks>true</useVisualTweaks>
</VisualMob>
