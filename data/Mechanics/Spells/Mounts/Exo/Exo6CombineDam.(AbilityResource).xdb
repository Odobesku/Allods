    <image href="/Interface/Icons/Mounts/SpellsMounts/ColossusRage.(UISingleTexture).xdb#xpointer(/client.Widgets.UISingleTexture)" />
    <level>1</level>
    <name href="Mechanics/Spells/Mounts/Exo/Exo6CombineDam.(AbilityResource).Name.txt" />
