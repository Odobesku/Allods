<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialCast</Item>
                </animations>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>1500</time>
                    </Item>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Mobs/Gastornis_SpellCastSummonAoe.(VisObjectTemplate).xdb" />
                                <fixPoint>true</fixPoint>
                                <scale>4</scale>
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
    </actionBarStart>
</SpellVisScripts>