<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>188367</resourceId>
    </Header>
    <Name href="CoolHead.(BuffResource).Name.txt" />
    <Description href="CoolHead.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/IceElementalHeart.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="Phase2.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateHealthLower">
                                <level>0.5</level>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="PowerStrikeResource.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <stackLimit>5</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>