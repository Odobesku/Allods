<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.WeatherCreatureVisAction">
        <params>
          <ambientSoundImpact>Nothing</ambientSoundImpact>
          <colorGradingSettings />
          <fadeTime>1</fadeTime>
          <light>
            <AmbientColor>-11710548</AmbientColor>
            <AmbientFactor>0.5</AmbientFactor>
            <ContourColor>-13882032</ContourColor>
            <DiffuseColor>-16771808</DiffuseColor>
            <FadeEnd>850</FadeEnd>
            <FadeStart>500</FadeStart>
            <FogColor>-16577243</FogColor>
            <FogEnd>350</FogEnd>
            <FogStart>0</FogStart>
            <GrassContourColorMultiplier>-1</GrassContourColorMultiplier>
            <PointLightColor>-6930033</PointLightColor>
            <SelfIllumColor>-16777216</SelfIllumColor>
            <SpecularColor>1774608</SpecularColor>
            <SpecularWaterColor>-14438148</SpecularWaterColor>
            <SunLightPitch>0</SunLightPitch>
            <SunLightYaw>45</SunLightYaw>
            <TerrainContourColor>-16708325</TerrainContourColor>
            <TerrainContourPower>2</TerrainContourPower>
            <TerrainSpecularColor>-16533775</TerrainSpecularColor>
            <WaterGradientEnd>-14438148</WaterGradientEnd>
            <WaterGradientStart>-14438148</WaterGradientStart>
            <desaturation>0</desaturation>
            <minAmbientOcclusionValue>0</minAmbientOcclusionValue>
            <objectsLightmapBias>0.0125</objectsLightmapBias>
            <terrainLightmapBias>0.01</terrainLightmapBias>
          </light>
          <posteffectFogSettings>
            <brightness>1</brightness>
            <color>-1</color>
            <colorUp>-1</colorUp>
            <densityDown>0</densityDown>
            <densityUp>0</densityUp>
            <distanceSettings>
              <falloff>0.5</falloff>
              <maxDistance>400</maxDistance>
              <minDistance>0</minDistance>
            </distanceSettings>
            <heightSettingsDown>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsDown>
            <heightSettingsUp>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsUp>
            <sunSettings>
              <brightness>0.2</brightness>
            </sunSettings>
            <use>false</use>
          </posteffectFogSettings>
          <priority>HIGH</priority>
          <skyMesh href="/World/Sky/Umoir_Forest_Night.(SkyMesh).xdb#xpointer(/client.VisualConstructor.SkyMesh)" />
          <hasLight>true</hasLight>
          <playInBuildings>false</playInBuildings>
        </params>
      </Item>
      <Item type="client.Replica.Sound2DAction">
        <actionType>Simple</actionType>
        <musicSourceMaxRadius>0</musicSourceMaxRadius>
        <reverbPreset />
        <sound>
          <name>Music/ZonesMusic/UmoirAwry_I_adaptive</name>
          <project href="/SFX/Music/Music.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
        </sound>
        <forcedSoundStop>false</forcedSoundStop>
        <onlyForMainAvatar>true</onlyForMainAvatar>
        <resetGlobalParamsOnStop>true</resetGlobalParamsOnStop>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>