<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
                <advanced>
                    <offendType>ONEOFFEND_ONETARGET</offendType>
                </advanced>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>1200</time>
                    </Item>
                    <Item type="VisActionList">
                        <play>Simultaneously</play>
                        <elements>
                            <Item type="CreatureAnimationAction">
                                <animations>
                                    <Item>spellCastDirected</Item>
                                </animations>
                                <advanced>
                                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                                </advanced>
                            </Item>
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureTrailAction">
                <creatureTrail href="/Spells/FX/InterfaceFX/Trail_Physical.(TrailTemplate).xdb" />
                <lengthMSec>2500</lengthMSec>
            </Item>
            <Item type="CreatureRotateToCastPointAction" />
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>350</delay>
                        <effectFx href="EarthSplit_Dec.(VisObjectTemplate).xdb" />
                        <fixPoint>true</fixPoint>
                        <scale>0.8</scale>
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Mobs/Split_Ground_Cast.(VisObjectTemplate).xdb" />
                <fixPoint>true</fixPoint>
            </Item>
        </visualEffects>
    </launch>
</SpellVisScripts>