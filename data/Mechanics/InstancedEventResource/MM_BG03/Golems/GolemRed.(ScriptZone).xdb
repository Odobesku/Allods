<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
	<Header>
		<resourceId>739846016</resourceId>
	</Header>
	<filter type="gameMechanics.world.creature.AvatarFilter" />
	<conditionsIn>
		<Item type="gameMechanics.elements.resources.ResourceBuff">
			<buff href="GolemBlue.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
		</Item>
	</conditionsIn>
	<impactsIn>
		<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
			<predicates>
				<Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
					<variableResource href="/Mechanics/InstancedEventResource/MM_BG03/RedGolemOnBase.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
					<expectedValue type="gameMechanics.elements.calcers.FloatData">
						<value>1</value>
					</expectedValue>
				</Item>
			</predicates>
			<impactsIf>
				<Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactUpdateEventAchievement">
					<achievement href="/Mechanics/InstancedEventResource/MM_BG03/MM_BG03.(BattleEventAchievementResource).xdb#xpointer(/gameMechanics.battleground.BattleEventAchievementResource)" />
					<summand>1000</summand>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="GolemBlue.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
					<table href="/Maps/Domination03/SpawnTables/GolemBlue.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
				</Item>
				<Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
					<variable href="/Mechanics/InstancedEventResource/MM_BG03/BlueGolemOnBase.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
					<summand>1</summand>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ZoneDistributor">
						<zone type="gameMechanics.elements.calcers.ZoneDistributor$OwnZone" />
					</distributor>
					<data href="CD/BlueGolemCaptured.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				</Item>
			</impactsIf>
			<impactsElse>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.TargetDistributor" />
					<data href="Incapturable.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				</Item>
			</impactsElse>
