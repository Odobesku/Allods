    </functionalPart>
    <quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <category href="/Mechanics/ItemCategories/Ship/Repair.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
    <calcers>
        <Item>
            <name>power</name>
            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerMul">
                <calcers>
                    <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                        <value var="power" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerPow">
                        <base type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                            <value>1.33</value>
                        </base>
                        <power type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerSum">
                            <calcers>
                                <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerLevel" />
                                <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                                    <value>-1</value>
                                </Item>
                            </calcers>
                        </power>
                    </Item>
                </calcers>
            </calcer>
        </Item>
        <Item>
            <name>count</name>
            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerSum">
                <calcers>
                    <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                        <value var="count" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerMul">
                        <calcers>
                            <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                                <value var="count_incr" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerQuality" />
                        </calcers>
                    </Item>
