<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739923251</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>FormulaPercent</formula>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>crit</name>
            <value var="crit" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerCorrosiveAcid.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.schemes.spell.spellstate.TriggerSpellActivate">
            <spell href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Spell01.(SpellSingleTarget).xdb" />
            <effectsOn>
                <Item type="gameMechanics.elements.effects.BuffExtraEffects">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/DruidPoison.(ActionGroup).xdb" />
                    </groups>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff hrefvar="buff_coeff" />
                                </Item>
                            </impactsOn>
                            <impactsOff>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff hrefvar="buff_coeff" />
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impactsOff>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.SpellsModifier">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Druid70/Spells/PoisonousSpike/Spell01.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </predicates>
                    <modifiers>
                        <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                            <effects>
                                <Item type="gameMechanics.elements.effects.OutgoingCritChanceSummand">
                                    <impactProducer href="/Mechanics/Spells/Druid70/Spells/PoisonousSpike/Spell01.(SpellSingleTarget).xdb" />
                                    <summand var="crit" />
                                </Item>
                            </effects>
                            <onBehalfOfHolder>true</onBehalfOfHolder>
                        </Item>
                    </modifiers>
                </Item>
                <Item type="gameMechanics.elements.effects.OutgoingCritChanceSummand">
                    <impactProducer href="/Mechanics/Spells/Druid70/Spells/Strike/Spell01.(SpellSingleTarget).xdb" />
                    <summand var="crit" />
                </Item>
                <Item type="gameMechanics.elements.effects.OutgoingCritChanceSummand">
                    <impactProducer href="/Mechanics/Spells/Druid70/Spells/PoisonousSpike/Buff01.(BuffResource).xdb" />
                    <summand var="crit" />
                </Item>
            </effectsOn>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>