<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>readySpell</Item>
        </animations>
        <channel>CHANNEL_HITCRITICAL</channel>
    </actionBarStart>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
            </Item>
            <Item type="CreatureVisActionStartThrow" />
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Mobs/Jaga_HexeProjectile.(VisObjectTemplate).xdb" />
                <explosionFx href="/Spells/FX/Mobs/Jaga_HexeHit.(VisObjectTemplate).xdb" />
                <isMultyProjectile>true</isMultyProjectile>
                <theGe>6</theGe>
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </pointOnTarget>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>