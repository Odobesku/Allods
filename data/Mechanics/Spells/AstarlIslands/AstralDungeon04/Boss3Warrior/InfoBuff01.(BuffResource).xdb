<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>186453</resourceId>
    </Header>
    <Name href="InfoBuff01.(BuffResource)_Name.txt" />
    <Description href="InfoBuff01.(BuffResource)_Desc.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/Bloodshield.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.5</coeff>
            </scaler>
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger" />
        <Item type="gameMechanics.elements.effects.BalanceDamage">
            <casterPart>1</casterPart>
            <targetPart>1</targetPart>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                    <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.TickableAura">
                            <affectGroup>All</affectGroup>
                            <radius>6</radius>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="/Creatures/DemonMageNewBreed/Instances/AstralDungeon04/TZ_boss3Demon.(MobWorld).xdb" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </filter>
                            <impactsIn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="LaserVisualization.(BuffResource).xdb" />
                                </Item>
                            </impactsIn>
                            <impactsOut>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="LaserVisualization.(BuffResource).xdb" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impactsOut>
                            <holderImpactsIn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="LaserVisualization.(BuffResource).xdb" />
                                </Item>
                            </holderImpactsIn>
                            <holderImpactsOut>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="LaserVisualization.(BuffResource).xdb" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </holderImpactsOut>
                        </Item>
                        <Item type="gameMechanics.elements.effects.TickableAura">
                            <affectGroup>All</affectGroup>
                            <radius>12</radius>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="/Creatures/DemonMageNewBreed/Instances/AstralDungeon04/TZ_boss3Demon.(MobWorld).xdb" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </filter>
                            <impactsIn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="LaserVisualization.(BuffResource).xdb" />
                                </Item>
                            </impactsIn>
                            <impactsOut>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="LaserVisualization.(BuffResource).xdb" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impactsOut>
                            <holderImpactsIn>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="LaserVisualization.(BuffResource).xdb" />
                                </Item>
                            </holderImpactsIn>
                            <holderImpactsOut>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="LaserVisualization.(BuffResource).xdb" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </holderImpactsOut>
                        </Item>
                    </effects>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/Taunt.xdb" />
                    </groups>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/Taunt.xdb" />
            </groups>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>