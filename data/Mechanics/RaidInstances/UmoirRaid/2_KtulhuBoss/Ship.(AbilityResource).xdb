<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739833153</resourceId>
	</Header>
	<name href="Ship.(AbilityResource).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Ktulhu</scriptID>
						<map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<onBehalfOfTarget>true</onBehalfOfTarget>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
							<selector type="gameMechanics.tools.SelectorShuffle" />
							<impacts>
								<Item>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="RaidWipe.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="KtulhuSave.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="Wipe.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="Plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
		</Item>
	</effects>
	<disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>
