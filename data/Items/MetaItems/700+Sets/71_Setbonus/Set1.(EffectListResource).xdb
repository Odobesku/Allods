<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.EffectListResource>
	<Header>
		<resourceId>739967903</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfCaster">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateGreater">
					<lhs type="gameMechanics.elements.calcers.OnItemCalcer">
						<source type="gameMechanics.elements.item.ActiveDressableItem" />
						<calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerQuality">
							<nullQuality href="/Mechanics/ItemQualities/Epic.xdb" />
						</calcer>
					</lhs>
					<rhs type="gameMechanics.elements.calcers.FloatData">
						<value>0</value>
					</rhs>
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="Set1_OffTimer.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.StackBuff">
									<buff href="Set1_OffTimer.(BuffResource).xdb" />
									<delta type="gameMechanics.elements.calcers.FloatData">
										<value>-1</value>
									</delta>
								</Item>
							</impactsIf>
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="71_Setbonus.(BuffResource).xdb" />
						</Item>
					</impactsOn>
					<impactsOff>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Set1_OffTimer.(BuffResource).xdb" />
							<stacks type="gameMechanics.elements.calcers.FloatData">
								<value>1</value>
							</stacks>
						</Item>
					</impactsOff>
				</Item>
			</effectsIf>
		</Item>
	</effects>
</gameMechanics.constructor.basicElements.EffectListResource>
