<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="CreatureAnimationAction">
			<animations>
				<Item>channelCastDirected</Item>
			</animations>
			<channel>CHANNEL_KNOCKDOWN</channel>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownIce.(VisObjectTemplate).xdb" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/MageIceShardsAbility.(VisObjectTemplate).xdb" />
				<startPoint type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
				<fadeInTime>200</fadeInTime>
				<fadeOutTime>100</fadeOutTime>
				<offendTime type="EffectOffendConstDelay" />
			</Item>
		</elements>
	</wholeCasting>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/IceBomb.(VisObjectTemplate).xdb" />
							<lockScale>true</lockScale>
							<scale>0.6</scale>
							<locator>Slot_TopFX</locator>
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
