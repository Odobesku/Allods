<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>193941</resourceId>
    </Header>
    <visualScripts href="AI22EatMeat.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>1</value>
    </range>
    <prepareDuration>3500</prepareDuration>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <isWorkOnDead>true</isWorkOnDead>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <stage>Start</stage>
            <duration>10000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsDead" />
                    <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                        <level>0.2</level>
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="AI22EatMeat.(BuffResource).xdb" />
                </predicate>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.DirectHeal">
                <heal>1</heal>
                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                        <multiplier>0.4</multiplier>
                    </mulCalcer>
                </scalerTarget>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                        <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                        <spell href="AI22EatMeat.(SpellSingleTarget).xdb" />
                        <duration>8000</duration>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                        <spell href="AI22EatMeat.(SpellSingleTarget).xdb" />
                        <duration>20000</duration>
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Astal22WolfChef_EatMeat.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactKill" />
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="AI22EatMeat.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                <data href="HitBleedingHard.(ClientData).xdb" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>