<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>1500</time>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PaladinBladeofJusticeAbility_Trail01.(VisObjectTemplate).xdb" />
						<locator>Slot_FX</locator>
					</Item>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Mobs/MobLanding_Dust.(VisObjectTemplate).xdb" />
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<fixPoint>true</fixPoint>
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<locator>Slot_Global</locator>
						<member>Default_Member</member>
						<locatorName />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>