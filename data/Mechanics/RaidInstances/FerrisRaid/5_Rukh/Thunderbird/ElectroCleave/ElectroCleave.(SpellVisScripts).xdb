<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Rukh_Cleave_Decal_FX_01.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<scale>0.5</scale>
						<fadeInTime>250</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<channelOverrideScript />
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<visActionID>111</visActionID>
		<elements>
			<Item type="VisActionDelay">
				<time>150</time>
			</Item>
			<Item type="CreatureLockRotationAction" />
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>600</delay>
						<effectFx href="/Spells/FX/Mobs/Shadowbreath_Cleave_02_Collision.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<locator>Slot_Global</locator>
						<offset y="6" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>1500</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>111</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
