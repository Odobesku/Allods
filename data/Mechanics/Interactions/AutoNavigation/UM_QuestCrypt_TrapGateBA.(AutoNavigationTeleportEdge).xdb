<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.interactions.autonavigation.AutoNavigationTeleportEdge>
	<Header>
		<resourceId>739874349</resourceId>
	</Header>
	<from>
		<scriptID>UM_TrapGateB</scriptID>
		<map href="/Maps/UmoirIsland03/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
	</from>
	<to>
		<scriptID>UM_TrapGateA</scriptID>
		<map href="/Maps/UmoirIsland03/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
	</to>
	<impacts>
		<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
					<quest href="/World/Quests/UmoirIsland03/UI03_Quest02/UI03_Quest02.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
					<status>Active</status>
				</Item>
				<Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
					<quest href="/World/Quests/UmoirMound/UM_Q01/UM_Q01.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
					<counterResource href="/World/Quests/UmoirMound/UM_Q01/Counter01.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
					<value>1</value>
				</Item>
			</predicates>
			<impactsIf>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>UM_TrapGateA</scriptID>
							<map href="/Maps/UmoirIsland03/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
						</locator>
						<yaw type="constructor.basicElements.AngleDegrees">
							<value>180</value>
						</yaw>
					</destination>
				</Item>
			</impactsIf>
		</Item>
	</impacts>
</gameMechanics.interactions.autonavigation.AutoNavigationTeleportEdge>
