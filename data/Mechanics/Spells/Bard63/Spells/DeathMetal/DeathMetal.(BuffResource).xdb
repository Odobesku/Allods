<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>215274</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="DeathMetal.(BuffResource).Name.txt" />
    <Description href="DeathMetal.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Bard/DancingSword.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Bard/DancingSword_Buff.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.PhysicalDoT">
                <parameters>
                    <tickLength>1000</tickLength>
                    <damagePerTick>1</damagePerTick>
                    <affectOnStartTick>true</affectOnStartTick>
                    <impactsPerTick>
                        <Item type="gameMechanics.elements.impacts.ScaledImpacts">
                            <scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="externalCalcer" />
                                </mulCalcer>
                            </scalerCaster>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="DeathMetalOnTargetScaled.(MarkResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsPerTick>
                    <affectedByDoubleAttack>true</affectedByDoubleAttack>
                </parameters>
                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
                        <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                        <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer hrefvar="externalCalcer" />
                            </mulCalcer>
                        </Item>
                    </scalers>
                </scaler>
            </effect>
            <ticksCount>4</ticksCount>
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="DeathMetal01.(BuffResource).xdb" />
        <Item href="DeathMetal02.(BuffResource).xdb" />
        <Item href="DeathMetal03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/BardEtude.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>