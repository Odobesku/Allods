<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MeleeAttack.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<UseAnimation>USE_ANIMATIONS</UseAnimation>
			<Animation>attack01</Animation>
			<DelayCasterFX>0</DelayCasterFX>
			<FxOnCaster>/Spells/FX/Spells/YakGlacialChief_MountGore_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnCaster>
			<FxOnTargets>/Spells/FX/Spells/YakGlacialChief_MountGore_Hit_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTargets>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay var="DelayCasterFX" />
						<effectFx hrefvar="FxOnCaster" />
					</Item>
				</visualEffects>
			</Item>
			<Item skiped="" />
		</elements>
	</launch>
</SpellVisScripts>
