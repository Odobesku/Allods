<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>193479</resourceId>
    </Header>
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/WarriorInnerRageAbility.(VisObjectTemplate).xdb" />
            <lockScale>true</lockScale>
            <scale>1.5</scale>
        </Item>
        <Item>
            <effectFx href="/Spells/FX/Mobs/MountTank_Charge.(VisObjectTemplate).xdb" />
            <scale>1.05</scale>
        </Item>
        <Item>
            <effectFx href="/Spells/FX/Mobs/MountTank_Charge.(VisObjectTemplate).xdb" />
            <scale>1.1</scale>
        </Item>
    </visualEffects>
    <visScript href="/Mechanics/Spells/AstarlIslands/AI38/Packs/AI38_Turtle_Charge.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.Charge">
            <impacts>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                            <spell href="AI38_Turtle_Charge.(SpellArea).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <buff href="AI38_Turtle_Charge01.(BuffResource).xdb" />
            <speedFactor>0.5</speedFactor>
        </Item>
        <Item type="gameMechanics.elements.effects.PreciseAura">
            <radius>3</radius>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </filter>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                            <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                            <minDamage>100</minDamage>
                            <maxDamage>100</maxDamage>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>2</multiplier>
                            </durationScaler>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                            <time>800</time>
                            <distance>2</distance>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Knockdowns.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Fears.xdb" />
                        <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                        <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Blinds.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Silence.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Disarms.xdb" />
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
                        <Item href="/Mechanics/Spells/Groups/CommonDebuffs.(ActionGroup).xdb" />
                    </groups>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
            </groups>
        </Item>
    </effects>
    <duration>30000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
