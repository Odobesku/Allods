<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="VisActionList">
				<playWhile type="VisActionDelay">
					<time>1000</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/MegaWarMelee_WingGlow01.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>4</scale>
								<fadeInTime>200</fadeInTime>
								<fadeOutTime>200</fadeOutTime>
								<locator>Slot_Hand_R</locator>
								<offendTime />
								<offset y="0.5" />
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Mobs/Colossus_Scout_GlowHead.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>4</scale>
								<fadeInTime>200</fadeInTime>
								<fadeOutTime>200</fadeOutTime>
								<locator>Slot_Hand_R</locator>
								<offendTime />
								<offset y="0.5" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
