<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>493181</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/PrintConclaveFragment.(UISingleTexture).xdb" />
    <source>Vendor</source>
    <showItemContextAction>Never</showItemContextAction>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="ExtraDefenceLegendary.(ItemResource).xdb" />
                        </item>
                        <binding>Transfer</binding>
                        <modifiers>
                            <Item type="itemService.avatar.itemBag.ReplaceRemoveTimeModifier" />
                        </modifiers>
                    </Item>
                </actions>
                <consumeItems>100</consumeItems>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>4</value>
                </minLevel>
            </Item>
        </predicates>
        <useStack>true</useStack>
    </functionalPart>
    <requiredLevel>4</requiredLevel>
    <stackLimit>1000</stackLimit>
    <quality href="/Mechanics/ItemQualities/Relic.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.AuctionItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money>2</money>
        </cost>
    </prices>
    <lifeLengthCap>15724800000</lifeLengthCap>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="ExtraDefenceLegendaryPart.(ItemResource).Name.txt" />
    <description href="ExtraDefenceLegendaryPart.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/ItemMall.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>