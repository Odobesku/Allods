                    </calcers>
                </amount>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.world.device.scaner.ImpactScanPOI">
                <finder type="gameMechanics.world.device.scaner.ShipPOIFinder">
