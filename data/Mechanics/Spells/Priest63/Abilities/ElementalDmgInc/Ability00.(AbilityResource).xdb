<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>207469</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>stat</name>
            <value var="stat" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Mage/MageLightningArrow.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerOutputDamageChannel">
            <element>LIGHTNING</element>
            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                <coeff>1</coeff>
                <calcer type="gameMechanics.elements.calcers.CalcerSum">
                    <summands>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value var="value" />
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.ScalerCalcer">
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.01</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/DoubleHitChance.(SpecialStatResource).xdb" />
                                    </stat>
                                    <valueType>ShortTerm</valueType>
                                </mulCalcer>
                            </scaler>
                            <value var="stat" />
                        </Item>
                    </summands>
                </calcer>
            </scaler>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>