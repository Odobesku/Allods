<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739906440</resourceId>
	</Header>
	<Name href="BloodLink.(BuffResource).Name.txt" />
	<Description href="BloodLink.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Potions/HealingPotion.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
			<holderImpactsOnBreak>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="BloodLink_Caster.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="BloodLink.(BuffResource).xdb" />
				</Item>
			</holderImpactsOnBreak>
			<maxLength>8</maxLength>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="BloodLink_Caster.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="BloodLink.(ClientData).xdb" />
					<calcers>
						<addressEntries>
							<Item>
								<name>caster</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
							</Item>
							<Item>
								<name>target</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
							</Item>
						</addressEntries>
					</calcers>
				</Item>
				<Item type="gameMechanics.elements.impacts.ScaledImpacts">
					<scalerCaster type="gameMechanics.elements.scalers.TrivialScaler" />
					<scalerTarget type="gameMechanics.constructor.basicElements.ScalerMultiple">
						<scalers>
							<Item type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
								<buff href="BoodPlague_HM.(BuffResource).xdb" />
								<anyRank>true</anyRank>
								<onlyFromMaster>true</onlyFromMaster>
								<mul>1</mul>
							</Item>
							<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
									<multiplier>0.05</multiplier>
								</mulCalcer>
							</Item>
						</scalers>
					</scalerTarget>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
									<buff href="BoodPlague_HM.(BuffResource).xdb" />
									<range>
										<min>1</min>
										<max>3</max>
									</range>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ReturningImpact">
									<impacts>
										<Item type="gameMechanics.elements.impacts.PureDamage">
											<damage>0.5</damage>
										</Item>
									</impacts>
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.elements.impacts.ReturningImpact">
									<impacts>
										<Item type="gameMechanics.elements.impacts.PureDamage">
											<damage>0.75</damage>
										</Item>
									</impacts>
								</Item>
							</impactsElse>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>1500</tick>
		</Item>
	</effects>
	<duration>600000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
