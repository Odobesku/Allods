<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobRay_Instant.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <FXOnTargets>/Spells/FX/Spells/AddSpellHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
            <CastAnimation>attack</CastAnimation>
            <RayLength>12</RayLength>
            <FXRay>/Spells/FX/Spells/HG7_Turret_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXRay>
            <LocatorOnCaster>FROM_LOCATOR_NAME</LocatorOnCaster>
            <LocatorNameOnTargets />
            <RaySecondaryVelocity>0</RaySecondaryVelocity>
            <FixPointTarget>true</FixPointTarget>
            <RayMaxTime>2000</RayMaxTime>
            <MultyTargetMode>FromCaster</MultyTargetMode>
            <FXOnCaster />
            <LocatorOnTargets>Slot_FX</LocatorOnTargets>
            <LocatorNameOnCaster>Slot_Special01</LocatorNameOnCaster>
            <RaySecondaryLength>2000</RaySecondaryLength>
            <FixPointCaster>false</FixPointCaster>
            <FxOnHands />
            <RayVelocity>0</RayVelocity>
            <FXRaySecondary />
            <HitPostFXOnTargets />
            <AnimationPreCastMode>LOOP</AnimationPreCastMode>
            <PreCastAnimation>idle</PreCastAnimation>
        </Variables>
    </Header>
    <launch type="VisActionList">
        <elements>
            <Item skiped="" />
            <Item type="VisActionList">
                <elements>
                    <Item skiped="" />
                    <Item type="VisActionList">
                        <elements>
                            <Item type="CreatureChannelDirectAction">
                                <fxLength var="RayLength" />
                                <startPoint type="VisPointLocator">
                                    <locator var="LocatorOnCaster" />
                                    <locatorName var="LocatorNameOnCaster" />
                                </startPoint>
                            </Item>
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>