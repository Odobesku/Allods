<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellOmniCure</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visActionID>globalfxgr</visActionID>
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Jaga_Green_BallInside.(VisObjectTemplate).xdb" />
                        <fadeInTime>500</fadeInTime>
                        <fadeOutTime>1250</fadeOutTime>
                        <locator>Slot_Hand_L</locator>
                        <offset z="-0.33" />
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Jaga_Green_BallInside.(VisObjectTemplate).xdb" />
                        <fadeInTime>500</fadeInTime>
                        <fadeOutTime>1250</fadeOutTime>
                        <locator>Slot_Hand_R</locator>
                        <offset z="-0.33" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="CreatureAnimationAction">
        <animations>
            <Item>spellCastOmniSummon</Item>
        </animations>
        <channel>CHANNEL_ABILITY</channel>
        <channelOverrideMode>OVERRIDE_STOP</channelOverrideMode>
    </launch>
</SpellVisScripts>