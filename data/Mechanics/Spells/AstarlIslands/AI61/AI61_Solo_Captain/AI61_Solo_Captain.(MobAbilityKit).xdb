                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>15000</min>
                <max>15000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="Captain_PoisonCloud.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
            <cooldowns>
                <min>5000</min>
                <max>5000</max>
            </cooldowns>
        </Item>
        <Item>
