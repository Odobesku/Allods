<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739911402</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.RepeatedImpact">
					<impact type="gameMechanics.elements.impacts.ImpactSummon">
						<destination type="gameMechanics.map.destination.DestinationModified">
							<destination type="gameMechanics.map.destination.SelfPosDestination" />
							<modifiers>
								<Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
									<radius type="gameMechanics.elements.calcers.FloatData">
										<value>5</value>
									</radius>
								</Item>
							</modifiers>
						</destination>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
						</impacts>
						<object href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
						<pool href="Boss01_addWolfs.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					</impact>
					<count type="gameMechanics.elements.calcers.FloatData">
						<value>2</value>
					</count>
				</Item>
			</onEnter>
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="Boss01_addWolfs.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="AI63_Boss01_Werewolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							</mobs>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactMobMorph">
							<newMobWorld href="AI63_Boss01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
						</Item>
					</impactsIf>
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>Friends</affectGroup>
			<radius>20</radius>
			<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
						<mobs>
							<Item href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							<Item href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWerewolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
						</mobs>
					</Item>
				</predicates>
			</filter>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							</mobs>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Boss01_WolfFear.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Boss01_WolfFollowBoss.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsIn>
			<impactsOut>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							</mobs>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Boss01_WolfFear.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Boss01_WolfFollowBoss.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOut>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<effects>
				<Item type="gameMechanics.elements.effects.ImpactsOverTime">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
											<mobs>
												<Item href="AI63_Boss01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
											</mobs>
										</Item>
										<Item type="gameMechanics.elements.predicates.PredicateHealthLower">
											<level>0.85</level>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
											<projectileData>
												<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
													<destination type="gameMechanics.map.destination.DestinationModified">
														<destination type="gameMechanics.map.destination.SelfPosDestination" />
														<modifiers>
															<Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
																<radius type="gameMechanics.elements.calcers.FloatData">
																	<value>6</value>
																</radius>
															</Item>
															<Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
														</modifiers>
													</destination>
												</moveType>
												<resource href="Boss01_WaterPuddle.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
											</projectileData>
											<pool href="Boss01_Puddles.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
											<spell href="Boss01_Fireball.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
											<spell href="Boss01_ChangeForm.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
											<duration>1000</duration>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
						</Item>
					</impacts>
					<tick>6000</tick>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.MultiplyStat">
			<stat type="gameMechanics.elements.stat.StatStamina" />
			<multiplier>0.75</multiplier>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
