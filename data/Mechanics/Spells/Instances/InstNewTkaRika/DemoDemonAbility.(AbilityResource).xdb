<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>195074</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectNoAggro" />
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectForceMove">
                    <destinations>
                        <Item type="gameMechanics.map.destination.DestinationLocator">
                            <locator>
                                <scriptID>TeleportPoint</scriptID>
                                <map href="/Maps/Inst_TkaRika/New_MapResource.xdb" />
                            </locator>
                        </Item>
                    </destinations>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                    <zone href="/Maps/Inst_TkaRika/ScriptZones/Arena_00_Central.(ScriptZone).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Buffs/EventSleep/BuffSlowDown.(BuffResource).xdb" />
                        </Item>
                    </impactsOn>
