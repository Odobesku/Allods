<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXProjectile>/Spells/FX/Spells/NecromancerLifetapAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<FXOnTargets>/Spells/FX/Spells/HitLifetap.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<FXOnCaster>/Spells/FX/Spells/VampAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<FixPointCaster>true</FixPointCaster>
			<MulyProjectile>true</MulyProjectile>
			<LocatorNameOnCaster>Slot_FX</LocatorNameOnCaster>
			<ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<CastAnimation>spellCastOmni</CastAnimation>
			<FXProjectileHit />
			<FxOnHands>/Spells/FX/Weapon/WeaponEnchantMeleeRed.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction" />
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<scale>2</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>600</fadeOutTime>
					</Item>
					<Item>
						<scale>2</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>600</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>900</delay>
								<fixPoint var="FixPointCaster" />
							</Item>
						</visualEffects>
					</Item>
					<Item type="VisActionList">
						<elements>
							<Item skiped="" />
							<Item type="VisActionDelay">
								<time>1000</time>
							</Item>
							<Item type="CreatureProjectileAction">
								<projectileFx hrefvar="FXProjectile" />
								<explosionFx hrefvar="FXProjectileHit" />
								<isMultyProjectile var="MulyProjectile" />
								<pointOnCaster type="VisPointLocator">
									<shift z="1.8" />
									<locator var="LocatorOnCaster" />
									<locatorName var="LocatorNameOnCaster" />
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator var="ProjectileLocatorOnTarget" />
								</pointOnTarget>
								<isInverted>true</isInverted>
								<offendTime />
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
