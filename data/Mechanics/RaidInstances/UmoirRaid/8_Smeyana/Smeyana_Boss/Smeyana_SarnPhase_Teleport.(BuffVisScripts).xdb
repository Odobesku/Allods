<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/ShadowMoon_Ready.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>1.5</scale>
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureAnimationAction">
						<visActionID>Loop</visActionID>
						<mode>LOOP</mode>
						<animations>
							<Item>readySpell</Item>
						</animations>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>13500</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>Loop</stoppedActionID>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>instantSpellCastOmni</Item>
						</animations>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
