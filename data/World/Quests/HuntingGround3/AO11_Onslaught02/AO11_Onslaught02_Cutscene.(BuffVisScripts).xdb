<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.CameraTrackAction">
        <cameraRoute href="/Maps/AO11_Citadel/GlobalObjects/Routes/AO11_Onslaught02_CameraTour.(Route).xdb#xpointer(/gameMechanics.map.tour.Route)" />
        <routeDuration>0</routeDuration>
        <targetRoute href="/Maps/AO11_Citadel/GlobalObjects/Routes/AO11_Onslaught02_PlayerTour.(Route).xdb#xpointer(/gameMechanics.map.tour.Route)" />
      </Item>
      <Item type="client.Replica.VisActionChangeVisObject">
        <newVisMob href="/Creatures/NotCreatures/ZC12_Assault_Boat_Mob/ZC12_Assault_Boat_Mob.(VisualMob).xdb#xpointer(/client.VisualConstructor.VisualMob)" />
        <getBody>true</getBody>
        <getDress>true</getDress>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>