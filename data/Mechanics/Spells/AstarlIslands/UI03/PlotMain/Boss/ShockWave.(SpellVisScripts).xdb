<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <PreCastAnimation>readySpell</PreCastAnimation>
            <LocatorOnCaster>Slot_Global</LocatorOnCaster>
            <FXOnCaster />
            <CastAnimation>spellCastOmni</CastAnimation>
            <FxOnHands>/Spells/FX/Mobs/DC_1Boss_DustCloud_Hit_downscale.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
        </Variables>
    </Header>
    <wholeCasting type="VisActionList">
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>1000</delay>
                        <effectFx hrefvar="FxOnHands" />
                        <scale>0.2</scale>
                        <fadeInTime>166</fadeInTime>
                        <fadeOutTime>333</fadeOutTime>
                        <locator>Slot_Global</locator>
                    </Item>
                    <Item>
                        <delay>1300</delay>
                        <scale>0.43</scale>
                        <fadeInTime>166</fadeInTime>
                        <fadeOutTime>333</fadeOutTime>
                        <locator>Slot_Global</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <elements>
            <Item skiped="" />
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <scale>1.6</scale>
                                <locator var="LocatorOnCaster" />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>