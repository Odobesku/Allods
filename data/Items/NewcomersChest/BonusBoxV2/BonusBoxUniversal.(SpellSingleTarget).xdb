<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>517146</resourceId>
    </Header>
    <contextActionInfo>
        <contextName href="BonusBox_Proto.(SpellSingleTarget).ContextName.txt" />
        <contextImage href="/Interface/Icons/Misc/Itemmall/Chest12.(UISingleTexture).xdb" />
    </contextActionInfo>
    <Name href="BonusBoxUniversal.(SpellSingleTarget).Name.txt" />
    <Description href="BonusBoxUniversal.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Prototypes/UseItem.(SpellVisScripts).xdb" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                <key href="/System/ContentKeys/BonusBox_Newbie.(ContentKey).xdb" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateGreaterLong">
                        <lhs type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                        <rhs type="gameMechanics.elements.calcers.CalcerLevel" />
                    </predicate>
                </predicate>
                <clientData href="BonusBoxUniversal_LevelData.(ClientData).xdb" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                        <lhs type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                        <rhs type="gameMechanics.elements.calcers.CalcerLongSum">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.LongData">
                                    <value>-6</value>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.CalcerLevelCap" />
                            </calcers>
                        </rhs>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="MaxLevelReward.(ImpactListResource).xdb" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                        <lhs type="gameMechanics.elements.calcers.LongData">
                            <value>1</value>
                        </lhs>
                        <rhs type="gameMechanics.elements.calcers.CalcerMod">
                            <dividend type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                            <divisor type="gameMechanics.elements.calcers.LongData">
                                <value>10</value>
                            </divisor>
                        </rhs>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                                <lhs type="gameMechanics.elements.calcers.LongData">
                                    <value>1</value>
                                </lhs>
                                <rhs type="gameMechanics.elements.calcers.CalcerMod">
                                    <dividend type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                                    <divisor type="gameMechanics.elements.calcers.LongData">
                                        <value>5</value>
                                    </divisor>
                                </rhs>
                            </Item>
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                                <impact type="gameMechanics.constructor.basicElements.ImpactList">
                                    <impactsResource href="RandomEquipReward.(ImpactListResource).xdb" />
                                </impact>
                                <count type="gameMechanics.elements.calcers.FloatData">
                                    <value>3</value>
                                </count>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="X5LevelReward.(ImpactListResource).xdb" />
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="X5LevelReward.(ImpactListResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="RandomEquipReward.(ImpactListResource).xdb" />
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateGreater">
                        <lhs type="gameMechanics.elements.calcers.LongToFloatCalcer">
                            <calcer type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                        </lhs>
                        <rhs type="gameMechanics.elements.calcers.LongToFloatCalcer">
                            <calcer type="gameMechanics.elements.calcers.CalcerLongSum">
                                <calcers>
                                    <Item type="gameMechanics.elements.calcers.CalcerLevelCap" />
                                    <Item type="gameMechanics.elements.calcers.LongData">
                                        <value>-6</value>
                                    </Item>
                                </calcers>
                            </calcer>
                        </rhs>
                    </Item>
                </predicates>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                <item href="BonusBoxUniversal.(ItemResource).xdb" />
                            </item>
                        </item>
                        <itemLevel type="gameMechanics.elements.calcers.CalcerLongSum">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                                <Item type="gameMechanics.elements.calcers.LongData">
                                    <value>5</value>
                                </Item>
                            </calcers>
                        </itemLevel>
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>