<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>193977</resourceId>
    </Header>
    <Name href="LichKing.(BuffResource).Name.txt" />
    <Description href="LichKing.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageGlazedFrost.(UISingleTexture).xdb" />
    <visScript href="LichKing.(BuffVisScripts).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>AI22_Lich</scriptID>
                            <map href="/Maps/AstralIsle22/MapResource.xdb" />
                        </locator>
                    </destination>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                                    <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                                        <buff href="/Mechanics/Spells/AstarlIslands/AI22/AI22SnowQueenAOE/LichKingWatcher.(BuffResource).xdb" />
                                    </predicate>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
                <Item>Rooted</Item>
                <Item>ExternalMove</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/AstarlIslands/AI22/FishBoss/Cold.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>600000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>