<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<playWhile />
				<elements>
					<Item type="VisActionDelay">
						<time>400</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile />
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Mobs/WormGlacial_Projectile_Rider.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<explosionFx href="/Spells/FX/Mobs/WormGlacial_ProjectileHit_Rider.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<theGe>20</theGe>
								<pointOnCaster type="VisPointLocator">
									<locator>Slot_Mouth</locator>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator>Slot_FX</locator>
								</pointOnTarget>
								<offendTime />
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
