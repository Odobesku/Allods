<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart />
	<wholeCasting />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectFx href="/Spells/FX/Mobs/Architect_Swarm_CleaveResCast.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<scale>0.6</scale>
						<locator>Global</locator>
						<offset y="0" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<advanced>
					<turnToTarget>TURN_DEFAULT</turnToTarget>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
