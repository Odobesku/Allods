                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="ShadowBird.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.PureHeal">
                                                    <heal>1</heal>
                                                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                            <multiplier>0.0666</multiplier>
                                                        </mulCalcer>
                                                    </scalerTarget>
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.PureDamage">
                                                    <damage>1</damage>
                                                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                            <multiplier>0.1</multiplier>
                                                        </mulCalcer>
                                                    </scalerTarget>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>500</tick>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
