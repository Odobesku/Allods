<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXProjectile>/Spells/FX/Spells/MageControlFire_projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<FXOnTargets />
			<CastAnimation>attack</CastAnimation>
			<FXProjectileHit>/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<ProjectileLocatorOnTarget>Slot_BodyFX</ProjectileLocatorOnTarget>
			<FxOnHands>/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<LocatorOnCaster>Slot_Hand_R</LocatorOnCaster>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<scale>3</scale>
					</Item>
					<Item>
						<scale>3</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="CastAnimation" />
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item type="VisActionList">
						<elements>
							<Item skiped="" />
							<Item type="CreatureProjectileAction">
								<pointOnCaster type="VisPointLocator">
									<locator var="LocatorOnCaster" />
								</pointOnCaster>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
