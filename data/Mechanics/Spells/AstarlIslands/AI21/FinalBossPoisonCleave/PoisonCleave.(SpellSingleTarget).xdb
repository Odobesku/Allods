<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739886737</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/RaidInstances/Phase.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <element>ACID</element>
    <Name href="PoisonCleave.(SpellSingleTarget).Name.txt" />
    <visualScripts href="PoisonCleave.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>120000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="CleaveResource.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <consumeStacks>2</consumeStacks>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.RunImpactsInShape">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="/Spells/ClientData/HitPoison.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>POISON</element>
                                <damage>100</damage>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                        </impactsIf>
                    </Item>
                </impacts>
                <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
                    <angle type="constructor.basicElements.AngleDegrees">
                        <value>90</value>
                    </angle>
                </shape>
                <affectGroup>All</affectGroup>
                <radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
                    <value>11.75</value>
                </radius>
                <shapeCenterPosition>Caster</shapeCenterPosition>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>800</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="CleaveResource.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>50</speed>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>