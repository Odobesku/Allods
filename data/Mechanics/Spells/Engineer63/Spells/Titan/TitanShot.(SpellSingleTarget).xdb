<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>216028</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/AssistantSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="TitanShot.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Engineer/TitanShot.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>1500</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="StunOnHitTrigger.(BuffResource).xdb" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="StunOnHitTrigger.(BuffResource).xdb" />
                                        <consumeStacks>2</consumeStacks>
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStunNoCC.xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                <buff href="StunOnHitTrigger.(BuffResource).xdb" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                                <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                            </scalers>
                        </scaler>
                        <minDamage>1</minDamage>
                        <maxDamage>1</maxDamage>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ForceAggro" />
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>30</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>