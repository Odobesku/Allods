<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>230348</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="GainingMount.txt" />
    <Description hrefvar="Description_Text" />
    <image hrefvar="Icon_Image" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>2500</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasFreeStableSlots" />
                            <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                <group hrefvar="Mount_Group" />
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                            <group hrefvar="Mount_Group" />
                                        </predicate>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasFreeStableSlots" />
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                        <group hrefvar="Mount_Group" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                                            <unlock hrefvar="Mount_Unlock" />
                                        </predicate>
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateHasMount">
                    <mount hrefvar="Mount_Resourse" />
                    <temporary>true</temporary>
                </predicate>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactTameMount">
                <mount hrefvar="Mount_Resourse" />
                <expiresAfter>
                    <day var="LifeTime_days" />
                </expiresAfter>
                <level type="gameMechanics.elements.calcers.LongData">
                    <value var="Mount_Level" />
                </level>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>