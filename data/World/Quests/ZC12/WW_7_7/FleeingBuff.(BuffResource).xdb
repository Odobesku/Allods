<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739975657</resourceId>
	</Header>
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>All</affectGroup>
			<radius>45</radius>
			<filter type="gameMechanics.world.creature.AvatarFilter" />
			<holderImpactsIn>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="FleeingBuff.(BuffResource).xdb" />
				</Item>
			</holderImpactsIn>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>2000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactGoTo">
									<destination type="gameMechanics.map.destination.DestinationLocator">
										<locator>
											<scriptID>WW_7_7_Point1</scriptID>
											<map href="/Maps/ZC12/MapResource.xdb" />
										</locator>
									</destination>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
