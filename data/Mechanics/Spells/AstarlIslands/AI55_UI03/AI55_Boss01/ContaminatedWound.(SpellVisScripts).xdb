<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MeleeAttack.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <Trail />
            <FxOnTargets>/Spells/FX/Spells/HitBloodCrit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTargets>
            <UseAnimation>USE_ANIMATIONS</UseAnimation>
            <FxOnCaster />
            <HitPostFXOnTargets />
            <Animation>specialAttack</Animation>
        </Variables>
    </Header>
    <playOnTargets>
        <specialAction type="VisActionList">
            <elements>
                <Item type="CreatureEffectsAction">
                    <visualEffects>
                        <Item>
                            <effectFx hrefvar="FxOnTargets" />
                        </Item>
                    </visualEffects>
                </Item>
                <Item skiped="" />
            </elements>
        </specialAction>
    </playOnTargets>
</SpellVisScripts>