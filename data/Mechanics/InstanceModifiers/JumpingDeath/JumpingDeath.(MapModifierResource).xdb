<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.basicElements.MapModifierResource>
    <Header>
        <resourceId>252363</resourceId>
    </Header>
    <name href="JumpingDeath.(MapModifierResource).Name.txt" />
    <description href="JumpingDeath.(MapModifierResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerWanderingFever.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <mapEffects>
        <Item type="gameMechanics.elements.effects.AddMapSpecificEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
                            <onEnter>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToCells">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactRandomAvatarsOnCell">
                                                    <impacts>
                                                        <Item type="gameMechanics.map.variables.ImpactIfMapVariable">
                                                            <variable href="IsThereBuffAlready.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                                                            <predicates>
                                                                <Item type="gameMechanics.map.variables.PredicateMapVariableEqualsGeneric">
                                                                    <variableResource href="IsThereBuffAlready.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                                                                    <expectedValue type="gameMechanics.constructor.basicElements.FloatZero" />
                                                                </Item>
                                                            </predicates>
                                                            <impactsIf>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="EvolutionCounter.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                </Item>
                                                            </impactsIf>
                                                            <summandIf>1</summandIf>
                                                        </Item>
                                                    </impacts>
                                                    <predicates>
                                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                            <predicate type="gameMechanics.world.ship.elements.PredicateStandingOnShip" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                                    </predicates>
                                                    <count type="gameMechanics.elements.calcers.FloatData">
                                                        <value>1</value>
                                                    </count>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </onEnter>
                            <onLeave>
                                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                                    <variable href="IsThereBuffAlready.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                                    <summand>0</summand>
                                    <calcerSummand type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </calcerSummand>
                                </Item>
                            </onLeave>
                        </Item>
                    </effectsIf>
                </Item>
            </effects>
        </Item>
    </mapEffects>
    <weight>3</weight>
    <exclusions>
        <Item href="/Maps/AstralIsle36/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
        <Item href="/Maps/AstralIsle61/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
    </exclusions>
</gameMechanics.map.basicElements.MapModifierResource>