<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739940343</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
		<Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/BardEtude.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
	</groups>
	<Name href="Classic.(SpellSingleTarget).Name.txt" />
	<Description href="Classic.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="damage" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>WeaponScaler</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Bard/FlyingSword.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Bard/WeaponThrow.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<prepareDuration>0</prepareDuration>
	<ranks>
		<Item href="Classic01.(SpellSingleTarget).xdb" />
		<Item href="Classic02.(SpellSingleTarget).xdb" />
		<Item href="Classic03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<launchWhenReady>true</launchWhenReady>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateUsesWeapon" />
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceVariable">
				<variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
				<sub>2</sub>
			</Item>
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.elements.impacts.MarkedImpact">
						<mark href="ClassicOnHitCaster.(MarkResource).xdb" />
					</Item>
				</impacts>
				<groupRepeaters>true</groupRepeaters>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
						<impactsOnHitTarget>
							<Item type="gameMechanics.elements.impacts.ScaledImpacts">
								<scalerCaster type="gameMechanics.elements.scalers.LinearScaler">
									<multiplier var="damage" />
								</scalerCaster>
								<impacts>
									<Item type="gameMechanics.elements.impacts.MarkedImpact">
										<mark href="ClassicHitOnTargetScaled.(MarkResource).xdb" />
									</Item>
								</impacts>
							</Item>
							<Item type="gameMechanics.elements.impacts.MarkedImpact">
								<mark href="ClassicOnHitTarget.(MarkResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.impacts.MarkedImpact">
								<mark href="/Mechanics/Spells/Bard63/Spells/HardRock/EtudeFinishOnTarget.(MarkResource).xdb" />
							</Item>
						</impactsOnHitTarget>
						<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
							<scalers>
								<Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
								<Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
							</scalers>
						</scaler>
						<minDamage var="damage" />
						<maxDamage var="damage" />
					</Item>
				</impacts>
				<groupRepeaters>true</groupRepeaters>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
