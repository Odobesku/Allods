<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>240186</resourceId>
    </Header>
    <name href="AstralBombExplosion.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/PsionicMisleadend_Hit.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>7000</lifeLengthCap>
    <corpseDuration>1000</corpseDuration>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
            <radius>15</radius>
            <affectGroup>Enemies</affectGroup>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>ASTRAL</element>
                    <damage>100</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
            </impacts>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                </predicates>
            </filter>
        </Item>
    </impactsOnStart>
</gameMechanics.world.projectile.ProjectileResource>