<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>4000</time>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>channelCastDirected</Item>
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<animationKeysAction />
							<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
						</advanced>
					</Item>
					<Item type="VisActionList">
						<elements>
							<Item type="VisActionDelay">
								<time>400</time>
							</Item>
							<Item type="CreatureChannelDirectAction">
								<channelingFx href="/Spells/FX/Spells/BattleStation_LightningRay.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fxLength>20</fxLength>
								<startPoint type="VisPointLocator">
									<locator>Slot_Hand_R</locator>
									<from>FROM_SELF</from>
								</startPoint>
								<alternativeStartPoint />
								<endPoint type="VisPointLocator">
									<shift y="-30" z="5" />
									<locator>Slot_Global</locator>
									<from>FROM_SELF</from>
								</endPoint>
								<alternativeEndPoint />
								<offendTime />
								<secondaryTargetParams>
									<channelingFx href="" />
									<offendTime />
								</secondaryTargetParams>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
