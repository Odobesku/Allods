<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>History</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_LOW</Align>
            <HighPos>465</HighPos>
            <Pos>406</Pos>
            <Size>125</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <Pos>2</Pos>
            <Size>40</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>250</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>tab_history_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>tab_label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextGuild/BankTabs/BankTabHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="1" y="1"/>
            <Reaction>bank_tab_pressed</Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextGuild/BankTabs/BankTabLabelFormatSelected.txt"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextGuild/BankTabs/BankTabLabelFormatNormal.txt"/>
                <LayerMain href="/Interface/Ingame/ContextGuild/BankTabs/BankTabNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextGuild/BankTabs/BankTabHistory.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <PushedOffset x="0" y="0"/>
            <Reaction></Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextGuild/BankTabs/BankTabLabelFormatSelected.txt"/>
                <LayerMain href="/Interface/Ingame/ContextGuild/BankTabs/BankTabSelected.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextGuild/BankTabs/BankTabHistory.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
