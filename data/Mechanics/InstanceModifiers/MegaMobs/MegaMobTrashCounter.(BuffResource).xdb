<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739846081</resourceId>
	</Header>
	<Name href="MegaMobTrashCounter.(BuffResource).Name.txt" />
	<Description href="MegaMobTrashCounter.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Warrior/WarriorDefender.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
			<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
				<coeff>0.3</coeff>
				<calcer type="gameMechanics.elements.calcers.CalcerIf">
					<predicate type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.map.variables.PredicateMapVariableEquals">
							<variableResource href="MobsOnMap.(MapVariableResource).xdb" />
							<expectedValue type="gameMechanics.constructor.basicElements.FloatZero" />
						</predicate>
					</predicate>
					<calcerIf type="gameMechanics.elements.calcers.CalcerMul">
						<calcers>
							<Item type="gameMechanics.elements.calcers.InverseCalcer">
								<value type="gameMechanics.map.variables.MapVariableValueCalcer">
									<resource href="MobsOnMap.(MapVariableResource).xdb" />
								</value>
							</Item>
							<Item type="gameMechanics.map.variables.MapVariableValueCalcer">
								<resource href="MobsOnMapDead.(MapVariableResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.calcers.InverseCalcer">
								<value type="gameMechanics.elements.calcers.CalcerSum">
									<summands>
										<Item type="gameMechanics.map.variables.MapVariableValueCalcer">
											<resource href="BossDead.(MapVariableResource).xdb" />
										</Item>
										<Item type="gameMechanics.elements.calcers.FloatData">
											<value>1</value>
										</Item>
									</summands>
								</value>
							</Item>
						</calcers>
					</calcerIf>
					<calcerElse type="gameMechanics.constructor.basicElements.FloatZero" />
				</calcer>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.MultiplyStat">
			<stat type="gameMechanics.elements.stat.StatStamina" />
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mul>0.2</mul>
				<mulCalcer type="gameMechanics.elements.calcers.CalcerIf">
					<predicate type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.map.variables.PredicateMapVariableEquals">
							<variableResource href="MobsOnMap.(MapVariableResource).xdb" />
							<expectedValue type="gameMechanics.constructor.basicElements.FloatZero" />
						</predicate>
					</predicate>
					<calcerIf type="gameMechanics.elements.calcers.CalcerMul">
						<calcers>
							<Item type="gameMechanics.elements.calcers.InverseCalcer">
								<value type="gameMechanics.map.variables.MapVariableValueCalcer">
									<resource href="MobsOnMap.(MapVariableResource).xdb" />
								</value>
							</Item>
							<Item type="gameMechanics.map.variables.MapVariableValueCalcer">
								<resource href="MobsOnMapDead.(MapVariableResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.calcers.InverseCalcer">
								<value type="gameMechanics.elements.calcers.CalcerSum">
									<summands>
										<Item type="gameMechanics.map.variables.MapVariableValueCalcer">
											<resource href="BossDead.(MapVariableResource).xdb" />
										</Item>
										<Item type="gameMechanics.elements.calcers.FloatData">
											<value>1</value>
										</Item>
									</summands>
								</value>
							</Item>
						</calcers>
					</calcerIf>
					<calcerElse type="gameMechanics.constructor.basicElements.FloatZero" />
				</mulCalcer>
				<sum>1</sum>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.PostponedImpacts">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="GradualEnlarger.(BuffResource).xdb" />
							<stacks type="gameMechanics.elements.calcers.CalcerIf">
								<predicate type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.map.variables.PredicateMapVariableEquals">
										<variableResource href="MobsOnMap.(MapVariableResource).xdb" />
										<expectedValue type="gameMechanics.constructor.basicElements.FloatZero" />
									</predicate>
								</predicate>
								<calcerIf type="gameMechanics.elements.calcers.CalcerMul">
									<calcers>
										<Item type="gameMechanics.elements.calcers.InverseCalcer">
											<value type="gameMechanics.map.variables.MapVariableValueCalcer">
												<resource href="MobsOnMap.(MapVariableResource).xdb" />
											</value>
										</Item>
										<Item type="gameMechanics.map.variables.MapVariableValueCalcer">
											<resource href="MobsOnMapDead.(MapVariableResource).xdb" />
										</Item>
										<Item type="gameMechanics.elements.calcers.InverseCalcer">
											<value type="gameMechanics.elements.calcers.CalcerSum">
												<summands>
													<Item type="gameMechanics.map.variables.MapVariableValueCalcer">
														<resource href="BossDead.(MapVariableResource).xdb" />
													</Item>
													<Item type="gameMechanics.elements.calcers.FloatData">
														<value>1</value>
													</Item>
												</summands>
											</value>
										</Item>
										<Item type="gameMechanics.elements.calcers.FloatData">
											<value>100</value>
										</Item>
									</calcers>
								</calcerIf>
								<calcerElse type="gameMechanics.constructor.basicElements.FloatZero" />
							</stacks>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="GradualEnlarger.(BuffResource).xdb" />
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
