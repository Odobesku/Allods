<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/WideScreen.(UserPostEffect).xdb" />
			</Item>
			<Item type="VisActionChangeVisObject">
				<newVisMob href="/Creatures/Willowisp/Invis.(VisualMob).xdb" />
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureCutSceneAction" />
				</elements>
			</Item>
			<Item type="CameraTrackAction">
				<cameraPoints />
				<targetPoints />
				<cameraRoute href="/Maps/Inst_ZoneContested12_Start/GlobalObjects/Routes/Sea_Camera.(Route).xdb" />
				<targetRoute href="/Maps/ZC12/GlobalObjects/Routes/CS_Sea_Target.(Route).xdb" />
			</Item>
		</elements>
		<stopOnDeath>true</stopOnDeath>
	</action>
</BuffVisScripts>
