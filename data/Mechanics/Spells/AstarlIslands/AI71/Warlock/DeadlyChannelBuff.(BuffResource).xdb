<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739935312</resourceId>
    </Header>
    <Name href="DeadlyChannelBuff.(BuffResource).Name.txt" />
    <Description href="DeadlyChannelBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/TepPlague.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <tickLength>1000</tickLength>
                <damagePerTick>6</damagePerTick>
            </parameters>
            <element>SHADOW</element>
            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            <progressiveMultiplier>0.25</progressiveMultiplier>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.5</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                            <spell href="DeadlyChannel.(SpellSingleTarget).xdb" />
                            <duration>
                                <second>3</second>
                            </duration>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>