<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>206877</resourceId>
    </Header>
    <Name href="Buff01_Name.txt" />
    <Description href="Buff01_Desc.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/GenemodifiedPlague.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactHeal">
                    <heal>1000</heal>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.StackBuffGeneric">
                    <buff href="Buff03.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>1</value>
                    </delta>
                    <attachIfNotExist>true</attachIfNotExist>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn />
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>85</radius>
                            <affectGroup>All</affectGroup>
                            <affectHolder>true</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="Buff02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <anyRank>true</anyRank>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="Buff02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <anyRank>false</anyRank>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>