<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739885640</resourceId>
    </Header>
    <Name href="BattleRoar.(SpellArea).Name.txt" />
    <visualScripts href="BattleRoar.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>85</value>
    </range>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>45000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/Rage/Rage.(BuffResource).xdb" />
                        <stacks type="gameMechanics.elements.calcers.FloatData">
                            <value>3</value>
                        </stacks>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Roar_CD.(BuffResource).xdb" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>45</multiplier>
                        </durationScaler>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <impactsOnHitTarget>
                    <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                        <time>1500</time>
                        <impactsOnLand>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="Stun.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnLand>
                        <distance>30</distance>
                    </Item>
                </impactsOnHitTarget>
                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                <minDamage>40</minDamage>
                <maxDamage>40</maxDamage>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
