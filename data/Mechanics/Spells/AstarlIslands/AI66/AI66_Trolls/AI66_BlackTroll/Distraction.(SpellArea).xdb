<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>187353</resourceId>
    </Header>
    <Name href="Distraction.(SpellArea).Name.txt" />
    <visualScripts href="Distraction.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTPoint</targetType>
    <mechanics>
        <cooldown>
            <duration>120000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblinRange/AI66_WildGoblinRange.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblin/AI66_WildGoblin.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            <Item href="/Mechanics/Spells/AstarlIslands/AI66/AI66_Trolls/AI66_WildGoblin/AI66_WildGoblin_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </mobs>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactKill" />
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>FIRE</element>
                        <damage>100</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>