<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobRay_Instant.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>specialCast</PreCastAnimation>
			<LocatorNameOnTargets />
			<FXOnTargets>/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<RaySecondaryVelocity>0</RaySecondaryVelocity>
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<RayMaxTime>3000</RayMaxTime>
			<FixPointTarget>true</FixPointTarget>
			<MultyTargetMode>FromCaster</MultyTargetMode>
			<FXOnCaster />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorNameOnCaster />
			<RayLength>2</RayLength>
			<FXRay>/Spells/FX/Mobs/TepPyramid_Boss03_02_Lig.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXRay>
			<RaySecondaryLength>2</RaySecondaryLength>
			<FixPointCaster>false</FixPointCaster>
			<FxOnHands />
			<RayVelocity>0</RayVelocity>
			<FXRaySecondary />
			<HitPostFXOnTargets />
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/TrollShaman_ReadySpellDirectDown.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
						<scale>2</scale>
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>invalid</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction" />
					<Item type="VisActionList">
						<play>Simultaneously</play>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="CreatureEffectsAction" />
				<Item type="CreatureRunVisActionResource" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
