    <isExploit>true</isExploit>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>5</value>
    </range>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Everyone</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="WW_Prologue_8.xdb" />
                <status>Started</status>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                                <quest href="WW_Prologue_8.xdb" />
                                <status>Started</status>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                    <quest href="WW_Prologue_8.xdb" />
                                    <counterResource href="Counter1.(QuestCountId).xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                        <id href="Counter1.(QuestCountId).xdb" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Runners.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                        <spawn>
                            <scriptID>Gates_01</scriptID>
                            <map href="/Maps/Inst_ZoneContested12_Start/MapResource.xdb" />
                        </spawn>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                                <visualState>2</visualState>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                        <spawn>
                            <scriptID>Gates_02</scriptID>
                            <map href="/Maps/Inst_ZoneContested12_Start/MapResource.xdb" />
                        </spawn>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                                <visualState>3</visualState>
                            </Item>
                        </impacts>
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="CannonLeave.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.world.ship.device.ExploitUseShipDevice" />
        </targetImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>