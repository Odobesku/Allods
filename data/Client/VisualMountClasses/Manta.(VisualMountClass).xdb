<?xml version="1.0" encoding="UTF-8" ?>
<VisualMountClass>
	<animationSettings>
		<playOnRiderTopOnly href="" />
		<playOnRider href="" />
		<playOnMount href="" />
		<complexAnimations>
			<Item>
				<animation>idle</animation>
				<playOnRiderTop>emoteAFK</playOnRiderTop>
				<playOnRiderBottom>emoteAFK</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>idle</animation>
				<playOnRiderTop>sitGround</playOnRiderTop>
				<playOnRiderBottom>sitGround</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>instantSpellCastOmni</animation>
				<playOnRiderTop>instantSpellCastOmni</playOnRiderTop>
			</Item>
		</complexAnimations>
	</animationSettings>
	<fxSettings>
		<mountLocators>
			<Item>Slot_FX</Item>
			<Item>Slot_Global</Item>
			<Item>Global</Item>
		</mountLocators>
	</fxSettings>
	<controlParameters>
		<speedFactorForward>
			<startVelocity>6.5</startVelocity>
			<stopVelocity>2</stopVelocity>
			<startTime>1500</startTime>
			<stopTime>500</stopTime>
		</speedFactorForward>
		<speedFactorBackward>
			<startVelocity>3</startVelocity>
			<stopVelocity>0</stopVelocity>
			<startTime>0</startTime>
			<stopTime>0</stopTime>
		</speedFactorBackward>
	</controlParameters>
	<pitchParameters>
		<minVelocity>0.4</minVelocity>
		<minVelocityPitch>3</minVelocityPitch>
		<topVelocity>8</topVelocity>
		<topVelocityPitch>15</topVelocityPitch>
		<minStepDeltaTMainAvatar>50</minStepDeltaTMainAvatar>
		<minStepDeltaT>150</minStepDeltaT>
		<minTurnRadius>20</minTurnRadius>
		<pitchMaxVelocity>10</pitchMaxVelocity>
		<maxPitch>30</maxPitch>
	</pitchParameters>
	<jumpSettings>
		<specialJump href="" />
	</jumpSettings>
	<reinsSettings>
		<use>false</use>
		<member>Assaulter</member>
		<disablingAnimations href="" />
	</reinsSettings>
	<skinChangedScript href="/Spells/VisScripts/Commands/ChangeSkin.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<levelChangedScript href="/Spells/VisScripts/Commands/LevelUp_Mount.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<summonVisualScript href="/Spells/VisScripts/Mount/SummonCommonHorse.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
</VisualMountClass>
