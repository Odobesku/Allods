<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222264</resourceId>
    </Header>
    <Name href="DefenderBuff.(BuffResource).Name.txt" />
    <Description href="DefenderBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/PowerAstral.(UISingleTexture).xdb" />
    <visScript href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Horn/Horn_User.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.HighStackEffect">
            <effect type="gameMechanics.elements.effects.NotStackableEffects">
                <effects>
                    <Item type="gameMechanics.elements.effects.IncomingHealModifier">
                        <affectsPureHeal>true</affectsPureHeal>
                        <priority>Multiplier</priority>
                        <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                            <coeff>-1</coeff>
                        </scaler>
                    </Item>
                    <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
                        <group href="/Mechanics/Spells/Groups/FerrisRaid_Portal.(ActionGroup).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.effects.Switch">
                        <impactsOn>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="DefenderBuffDispelableBuff.(BuffResource).xdb" />
                            </Item>
                        </impactsOn>
                    </Item>
                </effects>
            </effect>
            <stackCountTrigger>25</stackCountTrigger>
        </Item>
        <Item type="gameMechanics.elements.effects.NotStackableEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="DefenderBuffDispelableBuff.(BuffResource).xdb" />
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="DefenderCooldown.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="DefenderBuffDispelableBuff.(BuffResource).xdb" />
                        </Item>
                    </impactsOff>
                </Item>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                            <damage>1</damage>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier>0.1</multiplier>
                                </mulCalcer>
                            </scalerTarget>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="DefenderBuff.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                    <initialDelay>1000</initialDelay>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/FerrisRaid_Portal.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableSpellsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/ActionBarChange.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="EnergyBlast/EnergyBlast.(SpellArea).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="LandMine/LandMine.(SpellArea).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="PowerShield/PowerShield.(SpellSingleTarget).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="PsionicWave/PsionicWave.(SpellSingleTarget).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="RelinquishPowers/RelinquishPowers.(SpellSingleTarget).xdb" />
        </Item>
    </effects>
    <stackLimit>25</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>