    <descVars>
        <Item>
            <name>var0</name>
            <value>25</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>WeaponScalerSpeed</formula>
            </scaler>
        </Item>
    </descVars>
