<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>223414</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/TepPyramidBosses/Spy.(BuffResource).xdb" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/Spells/TepPyramidBosses/Spy.(BuffResource).xdb" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateHasGuildProgress" />
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                                            <lhs type="gameMechanics.elements.calcers.LongData">
                                                                <value var="value" />
                                                            </lhs>
                                                            <rhs type="itemService.serverVariables.CalcerServerVariable">
                                                                <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                                                            </rhs>
                                                        </Item>
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.elements.impacts.ImpactAddGuildAuthority">
                                                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                                <scalers>
                                                                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                                                                        <multiplier>25</multiplier>
                                                                    </Item>
                                                                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                                                                        <multiplier var="HMScalerIs4" />
                                                                    </Item>
                                                                </scalers>
                                                            </scaler>
                                                            <source>Kill</source>
                                                        </Item>
                                                    </impactsIf>
                                                    <impactsElse>
                                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                            <predicates>
                                                                <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                                                    <lhs type="gameMechanics.elements.calcers.CalcerLongSum">
                                                                        <calcers>
                                                                            <Item type="gameMechanics.elements.calcers.LongData">
                                                                                <value var="value" />
                                                                            </Item>
                                                                            <Item type="gameMechanics.elements.calcers.LongData">
                                                                                <value>1</value>
                                                                            </Item>
                                                                        </calcers>
                                                                    </lhs>
                                                                    <rhs type="itemService.serverVariables.CalcerServerVariable">
                                                                        <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                                                                    </rhs>
                                                                </Item>
                                                            </predicates>
                                                            <impactsIf>
                                                                <Item type="gameMechanics.elements.impacts.ImpactAddGuildAuthority">
                                                                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                                        <scalers>
                                                                            <Item type="gameMechanics.elements.scalers.LinearScaler">
                                                                                <multiplier>6.25</multiplier>
                                                                            </Item>
                                                                            <Item type="gameMechanics.elements.scalers.LinearScaler">
                                                                                <multiplier var="HMScalerIs4" />
                                                                            </Item>
                                                                        </scalers>
                                                                    </scaler>
                                                                    <source>Kill</source>
                                                                </Item>
                                                            </impactsIf>
                                                        </Item>
                                                    </impactsElse>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <level>55</level>
</gameMechanics.constructor.schemes.ability.AbilityResource>