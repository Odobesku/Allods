<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MeleeAttack.(SpellVisScripts).xdb" />
		<Variables>
			<Trail>/Spells/FX/InterfaceFX/TrailFire.(TrailTemplate).xdb#xpointer(/TrailTemplate)</Trail>
			<DelayCasterFX>500</DelayCasterFX>
			<OffendType>WHIRLWIND_OFFEND</OffendType>
			<UseAnimation>USE_ANIMATIONS</UseAnimation>
			<FxOnCaster>/Spells/FX/Spells/PaladinBigFuriousStrike.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnCaster>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<FxOnTargets />
			<Animation>sweepingSlam</Animation>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<lockScale>true</lockScale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<delay>600</delay>
						<effectFx href="/Spells/FX/Spells/PaladinBlindingStrike2.(VisObjectTemplate).xdb" />
						<locator>Slot_FX</locator>
					</Item>
					<Item>
						<delay>600</delay>
						<effectFx href="/Spells/FX/Spells/HitMeleeHard.(VisObjectTemplate).xdb" />
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
