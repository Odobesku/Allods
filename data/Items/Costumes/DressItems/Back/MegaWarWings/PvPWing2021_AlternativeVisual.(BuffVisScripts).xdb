<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureEffectsAction">
				<category>EFFECT_DEFAULT</category>
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectAlias href="" />
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectDiseaseWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>150</fadeInTime>
						<fadeOutTime>150</fadeOutTime>
						<scale>1</scale>
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<muteFxSounds>true</muteFxSounds>
						<ignoreParentRotation>false</ignoreParentRotation>
						<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Back_Special</locatorName>
						<member>Default_Member</member>
						<offset x="0" y="0" z="0" />
						<rotation x="0" y="0" z="0" />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
				</visualEffects>
				<dontFade>false</dontFade>
				<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
				<stopOnDeath>false</stopOnDeath>
			</Item>
			<Item type="client.Replica.CreatureChangeVisItemsAction">
				<items>
					<Item>
						<newItem href="/Items/Costumes/VisItems/Back/MegaWar/PvPWing2021_Red.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						<slot>LIFESTYLEBACK</slot>
					</Item>
				</items>
				<isGfxCondition>false</isGfxCondition>
				<leaveWeapons>false</leaveWeapons>
				<notForDolls>false</notForDolls>
				<removeAllItems>false</removeAllItems>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<postAction type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureEffectsAction">
				<category>EFFECT_DEFAULT</category>
				<visualEffects>
					<Item>
