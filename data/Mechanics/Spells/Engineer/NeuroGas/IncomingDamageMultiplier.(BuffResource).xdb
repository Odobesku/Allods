<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739833966</resourceId>
	</Header>
	<Name href="IncomingDamageMultiplier.(BuffResource).Name.txt" />
	<Description href="IncomingDamageMultiplier.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Modifiers/ThePoisonousCloud.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>0.2</coeff>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<conditionalEvents>
				<Item>
					<obj>gameMechanics.elements.events.EventHealReceived</obj>
					<predicate type="gameMechanics.constructor.basicElements.PredicateGenericNot">
						<predicate type="gameMechanics.elements.predicates.PredicateEventHealIsLifeSteal" />
					</predicate>
				</Item>
			</conditionalEvents>
			<impacts>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="IncomingDamageMultiplier.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
							<value>1</value>
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="TemporaryImmunity.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<duration>25000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
