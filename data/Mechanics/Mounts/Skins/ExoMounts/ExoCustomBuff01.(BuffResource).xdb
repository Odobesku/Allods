<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>228640</resourceId>
        <Prototype href="/Mechanics/Mounts/Skins/ExoMounts/ExoCustomBuffProt.(BuffResource).xdb" />
    </Header>
    <Name href="/Mechanics/Mounts/Skins/ExoMounts/ExoCustomBuff01.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                    <ability href="/Mechanics/Spells/Mounts/Exo/ExoMountedRegeneration.(AbilityResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DirectHeal">
                            <heal>1</heal>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.02</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthBSVCalcer">
                                    <level type="gameMechanics.elements.calcers.CalcerLevel" />
                                </mulCalcer>
                            </scalerTarget>
                        </Item>
                    </impacts>
                    <initialDelay>-1</initialDelay>
                </Item>
            </effectsIf>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.buff.BuffResource>