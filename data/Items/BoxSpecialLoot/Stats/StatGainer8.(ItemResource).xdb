<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>740103864</resourceId>
	</Header>
	<binding>BindNone</binding>
	<category href="/Mechanics/ItemCategories/ItemMall.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
	<description href="StatGainer8.(ItemResource).Description.txt" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<warningUseText href="StatGainer8.(ItemResource).WarningUseText.txt" />
		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.ConvertToUnlockTakeAction">
						<unlock href="/Mechanics/Unlocks/AltCurrencies/IM_Stat_08_Unlock.(UnlockResource).xdb" />
					</Item>
				</actions>
				<consumeItems>1</consumeItems>
			</Item>
		</usages>
		<predicates>
			<Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
				<minLevel type="gameMechanics.formulas.IntConstantValue">
					<value>4</value>
				</minLevel>
			</Item>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateUnlock">
					<unlock href="/Mechanics/Unlocks/AltCurrencies/IM_Stat_08_Unlock.(UnlockResource).xdb" />
				</predicate>
			</Item>
		</predicates>
	</functionalPart>
	<image href="/Interface/Icons/Misc/Itemmall/EssencePerfection.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
	<itemMallType>ITEMMALLABLE</itemMallType>
	<level>1</level>
	<lifeLengthCap>15724800000</lifeLengthCap>
	<name href="StatGainer8.(ItemResource).Name.txt" />
	<ownershipLimit>0</ownershipLimit>
	<prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
		<cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
			<money>100000</money>
		</cost>
		<sellMod>0.5</sellMod>
	</prices>
	<quality href="/Mechanics/ItemQualities/Relic.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
	<requiredLevel>4</requiredLevel>
	<requiredReputation>Hostility</requiredReputation>
	<showItemContextAction>Never</showItemContextAction>
	<slot>UNDRESSABLE</slot>
	<source>Vendor</source>
	<stackLimit>10</stackLimit>
	<canBeDeposited>true</canBeDeposited>
	<clearAllOnTry>false</clearAllOnTry>
	<forceShowQuality>true</forceShowQuality>
	<ignoreDressSlotLevel>false</ignoreDressSlotLevel>
	<isHideLifestyleWhileNotEquipped>false</isHideLifestyleWhileNotEquipped>
	<isProbe>false</isProbe>
	<isQuestRelated>false</isQuestRelated>
	<needCheckPredicates>true</needCheckPredicates>
	<premiumItem>false</premiumItem>
	<ritual>false</ritual>
	<showOnlyIconInLink>false</showOnlyIconInLink>
	<soldForAltCurrency>false</soldForAltCurrency>
</gameMechanics.constructor.schemes.item.ItemResource>