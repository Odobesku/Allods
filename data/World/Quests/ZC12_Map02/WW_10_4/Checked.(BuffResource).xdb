<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739967708</resourceId>
	</Header>
	<Name href="Checked.(BuffResource).Name.txt" />
	<Description href="Checked.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Itemmall/TimeWarp.(UISingleTexture).xdb" />
	<onlyForTargetAndCaster>true</onlyForTargetAndCaster>
	<effects>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="/Creatures/ArchitectRanger/Instances/WW_10_7_ArchitectRanger.(MobWorld).xdb" />
							</mobs>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.RepeatedImpact">
							<impact type="gameMechanics.elements.impacts.ImpactSummon">
								<destination type="gameMechanics.map.destination.DestinationModified">
									<destination type="gameMechanics.map.destination.SelfPosDestination" />
									<modifiers>
										<Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
											<alternatives>
												<Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
													<radius type="gameMechanics.elements.calcers.FloatData">
														<value>3</value>
													</radius>
												</Item>
											</alternatives>
										</Item>
									</modifiers>
								</destination>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ForceAggro" />
									<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
										<delay>800</delay>
										<impacts>
											<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
												<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
												<data href="/World/Quests/Ferris4/Ferris_4_5_1/Ferris_4_5_1_Mob_spawn.(ClientData).xdb" />
											</Item>
										</impacts>
									</Item>
									<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
										<delay>240000</delay>
										<impacts>
											<Item type="gameMechanics.elements.impacts.Disintegrate" />
										</impacts>
									</Item>
								</impacts>
								<object href="/Creatures/ArchitectRanger/Instances/WW_10_4_ArchitectRanger.(MobWorld).xdb" />
								<pool href="/World/Quests/ZC12/WW_6_15/WW_6_15.(SummonPool).xdb" />
								<isPersonalPool>true</isPersonalPool>
							</impact>
							<count type="gameMechanics.elements.calcers.FloatData">
								<value>2</value>
							</count>
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.RepeatedImpact">
							<impact type="gameMechanics.elements.impacts.ImpactSummon">
								<destination type="gameMechanics.map.destination.DestinationModified">
									<destination type="gameMechanics.map.destination.SelfPosDestination" />
									<modifiers>
										<Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
											<alternatives>
												<Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
													<radius type="gameMechanics.elements.calcers.FloatData">
														<value>3</value>
													</radius>
												</Item>
											</alternatives>
										</Item>
									</modifiers>
								</destination>
								<impacts>
									<Item type="gameMechanics.elements.impacts.ForceAggro" />
									<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
										<delay>800</delay>
										<impacts>
											<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
												<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
												<data href="/World/Quests/Ferris4/Ferris_4_5_1/Ferris_4_5_1_Mob_spawn.(ClientData).xdb" />
											</Item>
										</impacts>
									</Item>
									<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
										<delay>240000</delay>
										<impacts>
											<Item type="gameMechanics.elements.impacts.Disintegrate" />
										</impacts>
									</Item>
								</impacts>
								<object href="/Creatures/ArchitectMele/Instances/WW_10_4_ArchitectMele.(MobWorld).xdb" />
								<pool href="/World/Quests/ZC12/WW_6_15/WW_6_15.(SummonPool).xdb" />
								<isPersonalPool>true</isPersonalPool>
							</impact>
							<count type="gameMechanics.elements.calcers.FloatData">
								<value>2</value>
							</count>
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="Counter2.(QuestCountId).xdb" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="/Mechanics/Creatures/ArchitectSiege/ZC12_Start/TimeLapseArchitectFinish.(ClientData).xdb" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<eventClasses>
				<Item>gameMechanics.elements.events.EventDeath</Item>
			</eventClasses>
			<impacts>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Checked.(BuffResource).xdb" />
				</Item>
			</impacts>
			<eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="WW_10_4_CountIDAmulet.(QuestCountId).xdb" />
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
