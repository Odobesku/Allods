<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>8880532</resourceId>
    </Header>
    <contextActionInfo>
        <priority>1</priority>
    </contextActionInfo>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <element>ASTRAL</element>
    <Name href="FillerAttack.(SpellSingleTarget).Name.txt" />
    <Description href="FillerAttack.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Psionic/Pulse.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="FillerAttack.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>2000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMounted" />
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateOnAddressee">
                            <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateTrue" />
                            </predicates>
                            <assertOnCantFind>false</assertOnCantFind>
                        </predicate>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateOnAddressee">
                                <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateTrue" />
                                </predicates>
                                <assertOnCantFind>false</assertOnCantFind>
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateBinaryWrapper">
                                <master type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
                                <slave type="gameMechanics.world.avatar.bearing.AddresseeFinderBurden" />
                                <binary type="gameMechanics.elements.predicates.PredicateNotMaster" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="/Mechanics/Spells/Mounts/Morph/Energize/Energize.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <consumeStacks>1</consumeStacks>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mounts/Morph/Shunt/InShuntCloud.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/Mounts/Morph/FillerAttackPassenger/ShuntJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <stacks type="gameMechanics.elements.calcers.FloatData">
                            <value>3</value>
                        </stacks>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/Mounts/Morph/FillerAttackPassenger/ShuntJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <stacks type="gameMechanics.elements.calcers.FloatData">
                            <value>1</value>
                        </stacks>
                    </Item>
                </impactsElse>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>0</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>