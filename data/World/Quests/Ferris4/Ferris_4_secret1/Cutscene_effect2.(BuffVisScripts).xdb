<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureCutSceneAction" />
			<Item type="WeatherCreatureVisAction">
				<params>
					<skyMesh href="/World/Sky/AI52_BossFight.(SkyMesh).xdb" />
					<light>
						<FogStart>0</FogStart>
						<FogEnd>270</FogEnd>
						<SunLightYaw>180</SunLightYaw>
						<SunLightPitch>45</SunLightPitch>
						<AmbientColor>-6181930</AmbientColor>
						<SelfIllumColor>-1774114</SelfIllumColor>
						<animatedDiffuseColor href="/Maps/AstralIsle52/ZoneLights/AI52_Hills_Diffuse.(AnimatedLight).xdb" />
						<DiffuseColor>-14208456</DiffuseColor>
						<PointLightColor>-2294322</PointLightColor>
						<FogColor>-16644594</FogColor>
						<SpecularColor>4149952</SpecularColor>
						<ContourColor>-8296297</ContourColor>
						<SpecularWaterColor>2443600</SpecularWaterColor>
						<WaterGradientStart>-16579313</WaterGradientStart>
						<WaterGradientEnd>-16709618</WaterGradientEnd>
						<TerrainSpecularColor>-15658480</TerrainSpecularColor>
						<TerrainContourColor>-16643826</TerrainContourColor>
						<TerrainContourPower>7</TerrainContourPower>
						<desaturation>0.9</desaturation>
					</light>
					<postEffectParams href="/Mechanics/Spells/AstarlIslands/AI52/Boss4_NecromancerKing/Cutscene_effect.(PostEffectParams).xdb" />
					<priority>MEDIUM</priority>
					<fadeTime>3</fadeTime>
					<hasLight>true</hasLight>
				</params>
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb" />
					<name>Ambience/OutdoorAmbience/Zones/AI52_GhostWorld</name>
				</sound>
				<forcedSoundStop>true</forcedSoundStop>
				<actionType>AmbientOutdoor</actionType>
				<reverbPreset>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb" />
					<name>ghost</name>
				</reverbPreset>
			</Item>
			<Item type="Sound2DAction">
				<forcedSoundStop>true</forcedSoundStop>
				<actionType>GlobalParams</actionType>
				<musicSourceParameters>
					<Item>
						<parameter href="/Mechanics/Spells/AstarlIslands/AI52/Boss4_NecromancerKing/AI52_GhostWorld_volume.(SoundParameter).xdb" />
						<value>0.9</value>
					</Item>
				</musicSourceParameters>
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Music/Music.(FMODProject).xdb" />
					<name>Music/ZonesMusic/Ferris4_Cutscene2</name>
				</sound>
				<forcedSoundStop>true</forcedSoundStop>
				<actionType>Music</actionType>
			</Item>
			<Item type="CreatureMusicParamAction">
				<parameter href="CutSceneSoundParameter.(SoundParameter).xdb" />
				<creatureParameter type="CutSceneParameter" />
				<value>1</value>
			</Item>
		</elements>
	</action>
	<postAction type="Sound2DAction">
		<actionType>Music</actionType>
	</postAction>
</BuffVisScripts>
