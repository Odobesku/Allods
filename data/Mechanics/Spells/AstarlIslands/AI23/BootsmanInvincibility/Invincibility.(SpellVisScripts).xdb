<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>DIE</mode>
                <animations>
                    <Item>spellCastOmniWand</Item>
                </animations>
                <advanced>
                    <speed>0.6</speed>
                </advanced>
            </Item>
            <Item type="CreatureEffectsAction">
                <visActionID>eff</visActionID>
                <visualEffects>
                    <Item>
                        <delay>500</delay>
                        <effectFx href="/Spells/FX/Mobs/BluePetMark.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <effectAlias href="" />
                        <scale>0.5</scale>
                        <fadeInTime>500</fadeInTime>
                        <fadeOutTime>500</fadeOutTime>
                        <offendTime />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
        <stopOnDeath>true</stopOnDeath>
    </wholeCasting>
    <launch />
</SpellVisScripts>