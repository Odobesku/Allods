<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="CreatureRotateToCastPointAction" />
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<channelOverrideControllers>TOP_ONLY</channelOverrideControllers>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<turnToTarget>TURN_DEFAULT</turnToTarget>
				</advanced>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Engineer_ElectricityProjectile_Turr.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Mobs/OrgeCannonMountFireballHit.(VisObjectTemplate).xdb" />
						<theGe>8</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>FROM_LOCATOR_NAME</locator>
							<member>Mount</member>
							<locatorName>Slot_Special01</locatorName>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator" />
						<offendTime />
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Engineer_BarrelShot_Main01.(VisObjectTemplate).xdb" />
								<fixPoint>true</fixPoint>
								<locator>FROM_LOCATOR_NAME</locator>
								<member>Mount</member>
								<locatorName>Slot_Special01</locatorName>
								<offset y="0.3" z="0.4" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
