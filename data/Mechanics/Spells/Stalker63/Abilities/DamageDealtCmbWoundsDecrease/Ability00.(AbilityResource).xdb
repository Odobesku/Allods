<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739933048</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="chance" />
        </Item>
        <Item>
            <name>var1</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>HealScalerWithoutRunes</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Mobparts/Fang.(UISingleTexture).xdb" />
    <visualScript type="CreatureEffectsAction">
        <visualEffects />
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnDamageDoneTrigger">
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
            </predicates>
            <impactsOnDamageDone>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateHasDamageInDelayedBarrier" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                    <chanceCalcer type="gameMechanics.elements.calcers.LinearCalcer">
                                        <mul>0.01</mul>
                                        <mulCalcer type="gameMechanics.elements.calcers.FloatData">
                                            <value var="chance" />
                                        </mulCalcer>
                                        <sum>0</sum>
                                    </chanceCalcer>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactSummandDelayedBarrier">
                                                    <summand type="gameMechanics.elements.calcers.CalcerLongMulFloat">
                                                        <calcerLong type="gameMechanics.elements.calcers.LongData">
                                                            <value>-1</value>
                                                        </calcerLong>
                                                        <calcerFloat type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                                            <scaler type="gameMechanics.elements.scalers.HealScaler" />
                                                            <value var="damage" />
                                                        </calcerFloat>
                                                        <rounding>Ceil</rounding>
                                                    </summand>
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                            <data href="WndHeal.(ClientData).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOnDamageDone>
            <impactsToVictim>
                <Item type="gameMechanics.constructor.basicElements.ImpactNull" />
            </impactsToVictim>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>