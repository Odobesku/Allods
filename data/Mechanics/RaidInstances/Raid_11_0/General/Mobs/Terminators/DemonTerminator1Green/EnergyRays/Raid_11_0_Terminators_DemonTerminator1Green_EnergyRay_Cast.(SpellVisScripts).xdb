<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
  <actionBarStart type="client.Replica.VisActionList">
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </actionBarStart>
  <precastType>PRECAST_DEFAULT</precastType>
  <wholeCasting type="client.Replica.VisActionList">
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </wholeCasting>
  <launch type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.SLON.CreatureRotateToCastPointAction">
            <immediateTurn>true</immediateTurn>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="client.Replica.VisActionDelay">
          <time>1000</time>
        </playWhile>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.CreatureChannelDirectAction">
            <channelingFx href="/Mechanics/RaidInstances/Raid_11_0/General/Mobs/Terminators/DemonTerminator1Green/EnergyRays/Raid_11_0_Terminators_DemonTerminator1Green_EnergyRay_Cast_Channel.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <endPoint type="client.Replica.VisPointLocator">
              <shift x="0" y="-170" z="2" />
              <from>FROM_SELF</from>
              <locator>FROM_LOCATOR_NAME</locator>
              <locatorName>Global</locatorName>
              <member>Default_Member</member>
            </endPoint>
            <fadeInTime>50</fadeInTime>
            <fadeOutTime>300</fadeOutTime>
            <fxLength>6</fxLength>
            <multyTargetMode>FromCaster</multyTargetMode>
            <offendTime type="client.Replica.EffectOffendConstDelay">
              <delay>0</delay>
            </offendTime>
            <secondaryTargetParams>
              <fadeInTime>0</fadeInTime>
              <fadeOutTime>0</fadeOutTime>
              <fxLength>2</fxLength>
              <velocity>0</velocity>
              <scaleTextureU>false</scaleTextureU>
              <scaleTextureV>false</scaleTextureV>
            </secondaryTargetParams>
            <startPoint type="client.Replica.VisPointLocator">
              <shift x="0" y="-8" z="2" />
              <from>FROM_SELF</from>
              <locator>FROM_LOCATOR_NAME</locator>
              <locatorName>Global</locatorName>
              <member>Default_Member</member>
            </startPoint>
            <velocity>560</velocity>
            <scaleTextureU>true</scaleTextureU>
            <scaleTextureV>true</scaleTextureV>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="client.Replica.VisActionDelay">
          <time>1000</time>
        </playWhile>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.CreatureEffectsAction">
            <category>EFFECT_DEFAULT</category>
            <visualEffects>
              <Item>
                <delay>0</delay>
                <effectAnimations>
                  <mode>DIE</mode>
                </effectAnimations>
                <fadeInTime>0</fadeInTime>
                <fadeOutTime>0</fadeOutTime>
                <scale>1</scale>
                <fixPoint>false</fixPoint>
                <lockScale>false</lockScale>
                <muteFxSounds>false</muteFxSounds>
                <ignoreParentRotation>true</ignoreParentRotation>
                <locator>Global</locator>
                <member>Default_Member</member>
                <offset x="0" y="0" z="0" />
                <rotation x="0" y="0" z="0" w="0" />
                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
              </Item>
            </visualEffects>
            <dontFade>false</dontFade>
            <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
            <stopOnDeath>false</stopOnDeath>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </launch>
  <ownKillingParams>
    <probabilityNoOverkill>0.2</probabilityNoOverkill>
    <probabilityWithOverkill>1</probabilityWithOverkill>
  </ownKillingParams>
  <playOnTargets>
    <skipBloodFx>false</skipBloodFx>
    <skipHitAnimations>false</skipHitAnimations>
  </playOnTargets>
  <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>