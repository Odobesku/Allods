<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Children>
        <Item href="/Interface/Ingame/ContextCharacter2/StatsHidePanelStatsDistributeHighlight.(WidgetPanel).xdb#xpointer(/client.Widgets.WidgetPanel)"/>
    </Children>
    <Name>Distribute</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Pos>38</Pos>
            <Size>150</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Size>25</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>distribute_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>false</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag>label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/Contextructor/ButtonRegular2/ButtonRegularHighlighted.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="0"/>
            <Reaction>distribute_pressed</Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextCharacter2/RelatedTexts/StatsHidePanelDistributeFormat.txt"/>
                <LayerMain href="/Interface/Ingame/ContextCharacter2/PrimaryStatButtonEmptyNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ContextCharacter2/PrimaryStatButtonEmptyPressed.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextCharacter2/RelatedTexts/StatsHidePanelDistributeDefault.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
