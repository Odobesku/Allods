    <visualScripts href="/Spells/VisScripts/AstralIslands/UmoirIsland01/MirrorBoss_Illusions.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="Illusions.(SpellArea).Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>80</value>
    </range>
    <prepareDuration>1000</prepareDuration>
    <needLos>false</needLos>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>20000000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.map.destination.RelativePos">
                            <coord x="8" />
                        </destination>
                        <impacts>
                            <Item type="gameMechanics.world.changeappearance.ImpactCopyAppearance" />
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="CopyApperance.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impacts>
                        <object href="Illusion.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <pool href="MirrorPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <maxTargets>3</maxTargets>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>50</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>