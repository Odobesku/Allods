<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739920712</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="DoT0.(BuffResource).Name.txt" />
	<Description href="DoT0.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Warrior/WarriorRend.(UISingleTexture).xdb" />
	<visScript href="/Spells/BuffVisScripts/DotBlood.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.PhysicalDoT">
			<parameters>
				<scalerTarget type="gameMechanics.elements.scalers.ScalerIf">
					<scalerIf type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
						<buff href="/Mechanics/Spells/War63/Spells/Cleavage/BrokenArmor1.(BuffResource).xdb" />
						<anyRank>true</anyRank>
						<onlyFromMaster>true</onlyFromMaster>
						<mul>1</mul>
						<sum>1</sum>
					</scalerIf>
					<scalerElse type="gameMechanics.elements.scalers.TrivialScaler" />
				</scalerTarget>
				<scaleOnTick>false</scaleOnTick>
				<damagePerTick>1</damagePerTick>
				<affectedByDoubleAttack>true</affectedByDoubleAttack>
			</parameters>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
					<Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
				</scalers>
			</scaler>
		</Item>
	</effects>
	<duration>6000</duration>
	<isStackable>false</isStackable>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<ranks>
		<Item href="DoT01.(BuffResource).xdb" />
		<Item href="DoT02.(BuffResource).xdb" />
		<Item href="DoT03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Bleeding.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>