<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>ready</PreCastAnimation>
			<FXProjectile>/Spells/FX/Mobs/Gamayun_AcidBolt.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
			<Ge>15</Ge>
			<LocatorOnCaster>Slot_Mouth</LocatorOnCaster>
			<FXProjectileHit>/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="PreCastAnimation" />
				</animations>
				<advanced>
					<speed>2.6</speed>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item skiped="" />
					<Item skiped="" />
					<Item>
						<effectFx href="/Spells/FX/Mobs/DemonCrabBoss_ReadySpellDirectDown.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
