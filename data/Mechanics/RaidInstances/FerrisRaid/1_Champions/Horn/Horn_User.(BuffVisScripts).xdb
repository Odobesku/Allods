<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CameraParametersAction">
				<parameters>
					<maxDistance>45</maxDistance>
					<minDistance>20</minDistance>
				</parameters>
			</Item>
			<Item type="ShiftAction">
				<verticalShift>10</verticalShift>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
