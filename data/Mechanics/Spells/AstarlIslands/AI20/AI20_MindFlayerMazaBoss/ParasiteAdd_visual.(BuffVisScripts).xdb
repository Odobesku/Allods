<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="ProceduralEffectVisAction">
				<timeOff>1</timeOff>
				<proceduralEffect href="/Spells/FX/InterfaceFX/Poison.(ProceduralEffect).xdb#xpointer(/ProceduralEffect)" />
				<useOn>Rider</useOn>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations />
						<fixPoint>true</fixPoint>
						<locator>Slot_FX</locator>
					</Item>
					<Item>
						<delay>300</delay>
						<effectFx href="/Spells/FX/Spells/NecromancerCorrosiveAcidAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Global</locatorName>
					</Item>
					<Item>
						<delay>250</delay>
						<effectFx href="/Spells/FX/Spells/HitPoison_Staff01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations />
						<locator>Slot_FX</locator>
					</Item>
					<Item>
						<delay>200</delay>
						<effectFx href="/Spells/FX/Spells/HitPoison_Staff01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations />
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<delay>100</delay>
						<effectFx href="/Spells/FX/Spells/HitPoison_Staff01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<restartOnVisualChange>true</restartOnVisualChange>
	</action>
</BuffVisScripts>
