<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<playWhile type="VisActionDelay">
			<time>725</time>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Jaga_HexeReady.(VisObjectTemplate).xdb" />
						<fadeInTime>100</fadeInTime>
						<fadeOutTime>250</fadeOutTime>
						<locator>Slot_Hand_R</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Jaga_HexeReady.(VisObjectTemplate).xdb" />
						<fadeInTime>100</fadeInTime>
						<fadeOutTime>250</fadeOutTime>
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedBall</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ABILITY</channelAfterFirstKey>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction" />
					<Item type="VisActionList">
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Mobs/Jaga_HexeProjectile.(VisObjectTemplate).xdb" />
								<explosionFx href="/Spells/FX/Mobs/Jaga_HexeHit.(VisObjectTemplate).xdb" />
								<pointOnCaster type="VisPointLocator">
									<locator>Slot_Hand_R</locator>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator>Slot_FX</locator>
								</pointOnTarget>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
