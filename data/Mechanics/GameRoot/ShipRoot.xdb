	<effectsOnDeath>
		<Item type="gameMechanics.elements.effects.EffectAstralPerimeterCollision">
			<radius>50</radius>
			<impactsOnSelfIn>
				<Item type="gameMechanics.world.astralObjectsInteractions.ImpactSwitchAstralObject">
					<enabled>false</enabled>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
					<delay>0</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</impactsOnSelfIn>
			<impactsFromSelfIn>
				<Item type="gameMechanics.world.ship.elements.ImpactGiveLoot" />
			</impactsFromSelfIn>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
					<predicates>
						<Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.basicElements.ImpactList">
							<impactsResource href="/Mechanics/Ships/WreckLootDrop100.(ImpactListResource).xdb" />
						</Item>
						<Item type="gameMechanics.world.ship.elements.ImpactModifyShipHealth">
							<limitModCalcer type="gameMechanics.elements.calcers.CalcerMul">
								<calcers>
									<Item type="gameMechanics.world.ship.elements.calcers.CalcerShipMaxDurability" />
									<Item type="gameMechanics.elements.calcers.FloatData">
										<value>0.16</value>
									</Item>
								</calcers>
							</limitModCalcer>
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
		</Item>
	</effectsOnDeath>
	<effects>
		<Item type="gameMechanics.world.ship.elements.effects.EffectPassengerChangeTrigger">
			<impactsOnIn>
				<Item type="gameMechanics.elements.impacts.ImpactsSwitchTarget">
					<cases>
						<Item>
							<predicates>
								<Item type="gameMechanics.world.ship.elements.PredicateStandingOnEnemyShip" />
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							</predicates>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.ShipDistributor" />
									<data href="ClientData/Astral/AstralEnemyWarningData.xdb" />
									<calcers>
										<stringEntries>
											<Item>
												<name>name</name>
												<calcer type="gameMechanics.elements.calcers.TargetNameCalcer" />
											</Item>
										</stringEntries>
									</calcers>
								</Item>
							</impacts>
						</Item>
					</cases>
				</Item>
			</impactsOnIn>
		</Item>
	</effects>
