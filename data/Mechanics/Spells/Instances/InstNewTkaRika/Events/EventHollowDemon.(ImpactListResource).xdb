                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                        <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                            <verticalRange min="0" max="0" />
                                            <horizontalRange min="6" max="6" />
                                        </modifier>
                                    </Item>
                                </modifiers>
                            </destination>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/Instances/InstNewTkaRika/Buffs/ParentDemonFight.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>2000</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                            <value>10</value>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <object href="/Mechanics/Spells/Instances/InstNewTkaRika/Mobs/HollowDemon.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsToInterlocutor">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactStopTalk" />
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
            <delay>2000</delay>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Mechanics/Spells/Instances/InstTkaRika/EventNames/Event05.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
