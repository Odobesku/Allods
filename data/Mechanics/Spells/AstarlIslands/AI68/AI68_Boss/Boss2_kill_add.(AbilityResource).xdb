<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739912506</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="Boss2_pool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="Boss2/NetPool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Boss2/Net.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Boss2/Net.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </filter>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.1</coeff>
            </scaler>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>