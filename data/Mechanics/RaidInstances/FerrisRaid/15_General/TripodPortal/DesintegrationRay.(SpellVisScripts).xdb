<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<animationKeysAction>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureEffectsOnTarget">
										<visualEffects>
											<Item>
												<delay>250</delay>
												<effectFx href="/Spells/FX/Mobs/MountTank_Channel_Hit.(VisObjectTemplate).xdb" />
												<scale>1.2</scale>
												<fadeInTime>250</fadeInTime>
												<fadeOutTime>250</fadeOutTime>
												<locator>Slot_FX</locator>
											</Item>
										</visualEffects>
									</Item>
									<Item type="VisActionList">
										<playWhile type="VisActionDelay">
											<time>450</time>
										</playWhile>
										<elements>
											<Item type="VisActionDelay">
												<time>30</time>
											</Item>
											<Item type="CreatureChannelDirectAction">
												<channelingFx href="/Spells/FX/Mobs/TripodPortal_DesintegrationRay.(VisObjectTemplate).xdb" />
												<fxLength>20</fxLength>
												<startPoint type="VisPointLocator">
													<shift y="-0.37" z="0.1" />
													<locator>FROM_LOCATOR_NAME</locator>
													<locatorName>Slot_Head</locatorName>
												</startPoint>
												<alternativeStartPoint />
												<endPoint type="VisPointLocator">
													<locator>Slot_FX</locator>
												</endPoint>
												<alternativeEndPoint />
												<offendTime />
												<multyTargetMode>Umbrella</multyTargetMode>
												<secondaryTargetParams>
													<channelingFx href="" />
													<offendTime />
												</secondaryTargetParams>
											</Item>
										</elements>
									</Item>
								</elements>
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
			<Item type="VisActionDelay">
				<time>2000</time>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
