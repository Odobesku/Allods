                                    <summands>
                                        <Item type="gameMechanics.elements.calcers.CalcerMul">
                                            <calcers>
                                                <Item type="gameMechanics.elements.calcers.FloatData">
                                                    <value var="speedLimit" />
                                                </Item>
                                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                    <value type="gameMechanics.elements.calcers.CalcerMul">
                                                        <calcers>
                                                            <Item type="gameMechanics.elements.calcers.FloatData">
                                                                <value>6.5</value>
                                                            </Item>
                                                            <Item type="gameMechanics.elements.calcers.CalcerSum">
                                                                <summands>
                                                                    <Item type="gameMechanics.elements.calcers.FloatData">
                                                                        <value>1</value>
                                                                    </Item>
                                                                    <Item type="gameMechanics.elements.calcers.MountSpeedCalcer" />
                                                                </summands>
                                                            </Item>
                                                        </calcers>
                                                    </value>
                                                </Item>
                                            </calcers>
                                        </Item>
                                        <Item type="gameMechanics.elements.calcers.FloatData">
                                            <value>-1</value>
                                        </Item>
                                    </summands>
                                </Item>
                            </calcers>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value>0</value>
                        </Item>
                    </calcers>
                </calcer>
            </effectScaler>
        </Item>
    </effects>
    <duration>12000</duration>
    <isStackable>true</isStackable>
