						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.world.ship.elements.ImpactReturnShipToSavedPos" />
		<Item type="gameMechanics.world.device.control.ImpactSetEngineManualMode" />
	</impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>
