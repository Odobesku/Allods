        <isPrototype>true</isPrototype>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.offender.PredicateOffenderIsCaster" />
                </Item>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
            </predicates>
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/ItemMall/BoxTrinkets/Buff_04_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </predicate>
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                            <value var="value" />
                                        </chanceCalcer>
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff hrefvar="buff" />
                                            </Item>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="/Mechanics/Spells/ItemMall/BoxTrinkets/DefenceMBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                <stacks type="gameMechanics.elements.calcers.FloatData">
                                                    <value var="value2" />
                                                </stacks>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsIf>
                    </Item>
                </casterToTarget>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/ItemMall/BoxTrinkets/Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </predicate>
                                        </Item>
                                    </predicates>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                                <value var="value" />
                                            </chanceCalcer>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff hrefvar="buff2" />
                                                </Item>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/ItemMall/BoxTrinkets/OffenceMBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                    <stacks type="gameMechanics.elements.calcers.FloatData">
