<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>277844992</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Events/EventSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="Elf_dancer.(SpellCasterSelf).Name.txt" />
    <Description href="Elf_dancer.(SpellCasterSelf)_Desc.txt" />
    <nameTemplate href="Elf_dancer.(SpellCasterSelf).Name.txt" />
    <descTemplate href="Elf_dancer.(SpellCasterSelf)_Desc.txt.template" />
    <targetType>STTSelf</targetType>
    <mechanics>
        <cooldown>
            <duration>300000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                    <rule href="/Mechanics/Rules/NoFunItems.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.RelativePos">
                    <coord x="1" />
                </destination>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>60000</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactKill" />
                            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                <delay>5000</delay>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <object href="/Creatures/Events/ElfHologramAidenus.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
            </Item>
        </casterImpacts>
    </mechanics>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>