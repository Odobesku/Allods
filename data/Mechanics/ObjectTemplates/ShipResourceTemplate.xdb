										<Item href="/Mechanics/Spells/Groups/AstralShipDespawnBlockers.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroupElement)" />
									</groups>
								</Item>
							</predicates>
						</Item>
					</effectsEmpty>
				</Item>
				<Item type="gameMechanics.world.ship.elements.EffectInHangarTrigger">
