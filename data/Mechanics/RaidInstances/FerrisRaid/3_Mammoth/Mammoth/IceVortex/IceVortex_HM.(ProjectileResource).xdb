<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739891326</resourceId>
	</Header>
	<name href="IceVortex_HM.(ProjectileResource).Name.txt" />
	<visObject href="/Spells/FX/Mobs/Mammoth_Storm.(VisObjectTemplate).xdb" />
	<altitude>0</altitude>
	<speed>0.002</speed>
	<lifeLengthCap>10000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
					<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
					<radius>4</radius>
					<affectHolder>false</affectHolder>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>COLD</element>
							<damage>12</damage>
							<impactsOnHitTarget>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="VortexFreeze.(BuffResource).xdb" />
										</Item>
									</predicates>
									<impactsElse>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="VortexCold.(BuffResource).xdb" />
										</Item>
									</impactsElse>
								</Item>
							</impactsOnHitTarget>
							<scaler type="gameMechanics.elements.scalers.MagicScaler" />
						</Item>
					</impacts>
					<filter type="gameMechanics.world.creature.AvatarFilter" />
				</Item>
				<Item type="gameMechanics.elements.impacts.EntityImpactEntitiesAround">
					<radius>5</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
									<resources>
										<Item href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Mammoth/Altar/Altar_Small.(SteleResource).xdb" />
									</resources>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Mammoth/Altar/Altar_Activation.(BuffResource).xdb" />
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>500</tick>
			<initialDelay>2000</initialDelay>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
