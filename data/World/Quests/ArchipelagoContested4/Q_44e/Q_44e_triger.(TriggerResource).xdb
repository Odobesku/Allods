<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>100307985</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectVariable">
            <resource href="Q_44e_variable.(VariableResource).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
            <valueTriggers>
                <Item>
                    <onGreaterOrEqual>true</onGreaterOrEqual>
                    <value type="gameMechanics.elements.calcers.FloatData">
                        <value>3</value>
                    </value>
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectSetReputation">
                            <faction href="/World/Factions/Demons.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                            <value>10000</value>
                        </Item>
                    </effects>
                </Item>
            </valueTriggers>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Items/QuestItems/ArchipelagoContested4/Cultist_Armor_quest/Cultist_Armor_quest.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Items/QuestItems/ArchipelagoContested4/Cultist_mantle_quest/Cultist_mantle_quest.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Items/QuestItems/ArchipelagoContested4/Cultist_cloac_quest/Cultist_cloac_quest.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>