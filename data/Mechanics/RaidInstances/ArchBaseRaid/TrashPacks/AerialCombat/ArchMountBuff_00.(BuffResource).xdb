<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739922716</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="ArchMountBuff_00.(BuffResource).Name.txt" />
    <Description href="ArchMountBuff_00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/JetPackGoblinBall.(UISingleTexture).xdb" />
    <visScript href="ArchMount_Activate.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpeedSetter">
            <speed>0.0065</speed>
            <isExternal>true</isExternal>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMoveByTour">
            <route hrefvar="tour" />
            <impactsOnArrive>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff hrefvar="buff" />
                    <anyRank>false</anyRank>
                </Item>
            </impactsOnArrive>
            <impactsOnCancel>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff hrefvar="buff" />
                    <anyRank>false</anyRank>
                </Item>
            </impactsOnCancel>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsToPet">
            <effects>
                <Item type="gameMechanics.elements.effects.AddPlane">
                    <plane href="/Mechanics/Spells/CommonBuffs/AstralTravel/PetTravelPlane.(Plane).xdb" />
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="ArchMount_Shoot.(SpellSingleTarget).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="ArchMount_Heal.(SpellSingleTarget).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="ArchMount_Shield.(SpellSingleTarget).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/ActionBarChange.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableSpellsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/ActionBarChange.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.CastOnMove">
            <spells>
                <Item href="ArchMount_Heal.(SpellSingleTarget).xdb" />
                <Item href="ArchMount_Shield.(SpellSingleTarget).xdb" />
                <Item href="ArchMount_Shoot.(SpellSingleTarget).xdb" />
            </spells>
            <moveTypes>
                <Item>Step</Item>
                <Item>Fall</Item>
            </moveTypes>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="MountedAerialCombat.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Transport.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>