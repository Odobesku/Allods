<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739963814</resourceId>
    </Header>
    <Name href="Dot.(BuffResource).Name.txt" />
    <Description href="Dot.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidCallLightningUpgrade.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <tickLength>2000</tickLength>
                <damagePerTick>5</damagePerTick>
                <affectOnStartTick>true</affectOnStartTick>
                <affectedByDoubleAttack>true</affectedByDoubleAttack>
            </parameters>
            <element>LIGHTNING</element>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>0.002</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                            <stat type="gameMechanics.elements.stat.SpecialStat">
                                <stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
                            </stat>
                            <valueType>ShortTerm</valueType>
                        </mulCalcer>
                        <sum>1.5</sum>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>