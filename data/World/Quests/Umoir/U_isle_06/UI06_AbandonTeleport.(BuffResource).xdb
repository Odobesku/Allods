<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739864474</resourceId>
	</Header>
	<Name href="UI06_AbandonTeleport.(BuffResource).Name.txt" />
	<Description href="UI06_AbandonTeleport.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Unlocks/UnlockPortal.(UISingleTexture).xdb" />
	<visScript href="/World/Quests/ArchipelagoEmpire1/Quest6_2/Teleport.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInZone">
							<zone href="/Maps/UmoirIsland06/Zones/UmoirIsland06/UmoirIsland06.(ZoneResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactTeleport">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>U_Port_door</scriptID>
									<map href="/Maps/Umoir/City_MapResource.xdb" />
								</locator>
							</destination>
						</Item>
					</impactsIf>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.TargetDistributor" />
					<data href="/World/Quests/UmoirIsland07/UI07_Quest1/U_Isle_07_abandon.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Items/InteractiveObjects/UmoirIsland06/JuneStele/SphereBuff.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Items/InteractiveObjects/UmoirIsland06/JuneStele/SphereBuff2.(BuffResource).xdb" />
								</Item>
							</predicates>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="/Items/InteractiveObjects/UmoirIsland06/JuneStele/SphereBuff.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="/Items/InteractiveObjects/UmoirIsland06/JuneStele/SphereBuff2.(BuffResource).xdb" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.Hover" />
	</effects>
	<duration>6000</duration>
	<isHelpful>false</isHelpful>
	<decayPolicy>NoOfflineDecay</decayPolicy>
	<canBeSaved>true</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
