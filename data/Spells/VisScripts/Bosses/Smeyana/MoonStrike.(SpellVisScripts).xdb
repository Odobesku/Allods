<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
				<advanced>
					<offendType>EVERYKEY_ALLOFFENDS</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ShadowMoon_ReadyStaff_02.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.4</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special02</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Mobs/ShadowMoon_MeleeCast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<scale>0.6</scale>
							<locator>Slot_FX</locator>
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
