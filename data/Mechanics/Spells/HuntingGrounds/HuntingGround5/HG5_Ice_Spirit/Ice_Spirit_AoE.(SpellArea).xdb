<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739905103</resourceId>
	</Header>
	<element>ASTRAL</element>
	<Name href="Ice_Spirit_AoE.(SpellArea).Name.txt" />
	<visualScripts href="/Mechanics/Spells/AstarlIslands/AI48/Bosses/IceEntity/CaveDestruction2.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>6000</prepareDuration>
	<targetType>STTSelf</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>30000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
				<mobs>
					<Item href="Ice_Spirit.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
				</mobs>
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
		</targetConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
				<radius>50</radius>
				<affectGroup>Enemies</affectGroup>
				<affectHolder>false</affectHolder>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
						<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
						<data href="Ice_Destruction_Data.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					</Item>
				</impacts>
				<filter type="gameMechanics.world.creature.AvatarFilter" />
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
				<element>COLD</element>
				<damage>150</damage>
				<scaler type="gameMechanics.elements.scalers.MagicScaler" />
			</Item>
		</targetImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>50</radius>
	<needLosToTarget>true</needLosToTarget>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
