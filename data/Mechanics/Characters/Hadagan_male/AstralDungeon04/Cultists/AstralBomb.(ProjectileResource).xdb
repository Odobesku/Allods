<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739952103</resourceId>
	</Header>
	<name href="AstralBomb.(ProjectileResource).Name.txt" />
	<visObject href="/Spells/FX/Spells/AstralBomb_133.(VisObjectTemplate).xdb" />
	<altitude>1.75</altitude>
	<lifeLengthCap>3000</lifeLengthCap>
	<corpseDuration>1000</corpseDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>All</affectGroup>
			<radius>1.5</radius>
			<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
				</predicates>
			</filter>
			<holderImpactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
					<projectileData>
						<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
						<resource href="AstralBombExplosion.(ProjectileResource).xdb" />
					</projectileData>
					<isPersonalPool>true</isPersonalPool>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>100</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</holderImpactsIn>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
