<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirected</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Mobs/UmoirExoskeleton_Channel.(VisObjectTemplate).xdb" />
				<fxLength>1.1</fxLength>
				<startPoint type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</endPoint>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
