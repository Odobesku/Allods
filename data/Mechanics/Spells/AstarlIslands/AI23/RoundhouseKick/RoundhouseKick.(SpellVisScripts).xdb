<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart />
    <wholeCasting type="VisActionList">
        <playWhile />
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>kick</Item>
                </animations>
                <channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
                <channelOverrideScript />
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureVisObjectComponentsAction">
                <visObjComponents>
                    <Item type="AttachedVisObjectComponent">
                        <visObject href="/Spells/FX/Spells/GoblinTrioBoss_Cleave.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>2</scale>
                        <offset z="0.25" />
                    </Item>
                </visObjComponents>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>