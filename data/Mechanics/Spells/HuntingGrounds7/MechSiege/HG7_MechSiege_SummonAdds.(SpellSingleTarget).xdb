    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>30000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                <impact type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.tools.SelectorRandomNotLess">
                        <minIndex>1</minIndex>
                    </selector>
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="3" max="8" />
                                                    <horizontalRange min="3" max="8" />
                                                </modifier>
                                            </Item>
                                        </modifiers>
                                    </destination>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                        <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                                    </impacts>
                                    <impactsFromTarget>
                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/HuntingGrounds06/WormGlacial/HG06_MechSiege_AddsTaunt.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsFromTarget>
                                    <object href="HG7_MechSiege_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <pool href="HG7_MechSiege_SummonAdds.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                    <isPersonalPool>true</isPersonalPool>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </impact>
                <count type="gameMechanics.elements.calcers.FloatData">
                    <value>1</value>
                </count>
