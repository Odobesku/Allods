<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739865290</resourceId>
	</Header>
	<Name href="BigAoE.(SpellSingleTarget).Name.txt" />
	<targetType>STTSelf</targetType>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>20000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="AoeCountdown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				<consumeStacks>50</consumeStacks>
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<affectGroup>Enemies</affectGroup>
						<affectHolder>false</affectHolder>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
								<projectileData>
									<moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
									<resource href="Tentacle.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
								</projectileData>
							</Item>
						</impacts>
						<filter type="gameMechanics.constructor.basicElements.FilterAnd">
							<filters>
								<Item type="gameMechanics.world.creature.AliveFilter" />
								<Item type="gameMechanics.world.creature.AvatarFilter" />
							</filters>
						</filter>
					</Item>
				</impacts>
			</Item>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="ChannelAllow.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.BuffDetacher">
				<buff href="AoeCountdown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
