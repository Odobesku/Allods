<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirected</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/BattleStation_FireRay.(VisObjectTemplate).xdb" />
				<fxLength>13</fxLength>
				<startPoint type="VisPointLocator">
					<locator>FROM_LOCATOR_NAME</locator>
					<member>Mount</member>
					<locatorName>Slot_Special01</locatorName>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</endPoint>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>