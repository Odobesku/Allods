<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureEffectsAction">
				<category>EFFECT_DEFAULT</category>
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<effectFx href="/Spells/FX/Spells/MageInvisibilityAbility_END.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<scale>1</scale>
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<muteFxSounds>false</muteFxSounds>
						<ignoreParentRotation>false</ignoreParentRotation>
						<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
						<locator>Slot_BodyFX</locator>
						<member>Default_Member</member>
						<offset x="0" y="0" z="0" />
						<rotation x="0" y="0" z="0" />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
				</visualEffects>
				<dontFade>false</dontFade>
				<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
				<stopOnDeath>false</stopOnDeath>
			</Item>
			<Item type="client.Replica.CreatureReplaceAnimationsAction">
				<member>Default_Member</member>
				<onBottom>
					<animationsReplacements>
						<Item>
							<forAnimations>
								<Item>walk</Item>
								<Item>run</Item>
							</forAnimations>
							<play>sneak</play>
						</Item>
						<Item>
							<forAnimations>
								<Item>idle</Item>
								<Item>idle01</Item>
								<Item>idle02</Item>
								<Item>idle03</Item>
							</forAnimations>
							<play>idleSneak</play>
						</Item>
					</animationsReplacements>
					<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
				</onBottom>
				<onMount>
					<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
				</onMount>
				<onTop>
					<animationsReplacements>
						<Item>
							<forAnimations>
								<Item>walk</Item>
								<Item>run</Item>
							</forAnimations>
							<play>sneak</play>
						</Item>
						<Item>
							<forAnimations>
								<Item>idle</Item>
								<Item>idle01</Item>
								<Item>idle02</Item>
								<Item>idle03</Item>
							</forAnimations>
							<play>idleSneak</play>
						</Item>
					</animationsReplacements>
					<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
				</onTop>
				<replaceWhen>ReplaceAlways</replaceWhen>
				<restartOnVisualChange>false</restartOnVisualChange>
			</Item>
			<Item type="client.Replica.CreatureSetTransparencyAction">
				<fadeMult>1</fadeMult>
				<priority>1</priority>
				<transparency>0.5</transparency>
			</Item>
			<Item type="client.Replica.PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/ShadowInvis.(UserPostEffect).xdb#xpointer(/UserPostEffect)" />
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<postAction type="client.Replica.CreatureEffectsAction">
		<category>EFFECT_DEFAULT</category>
		<visualEffects>
			<Item>
				<delay>0</delay>
				<effectAnimations>
					<mode>DIE</mode>
				</effectAnimations>
				<effectFx href="/Spells/FX/Spells/MageInvisibilityAbility_END.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fadeInTime>0</fadeInTime>
				<fadeOutTime>0</fadeOutTime>
				<scale>1</scale>
				<fixPoint>false</fixPoint>
				<lockScale>false</lockScale>
				<muteFxSounds>false</muteFxSounds>
				<ignoreParentRotation>false</ignoreParentRotation>
				<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
				<locator>Slot_BodyFX</locator>
				<member>Default_Member</member>
				<offset x="0" y="0" z="0" />
				<rotation x="0" y="0" z="0" />
				<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
			</Item>
		</visualEffects>
		<dontFade>false</dontFade>
		<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
		<stopOnDeath>false</stopOnDeath>
	</postAction>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>