<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739925249</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
        </Item>
        <Item>
            <name>cd</name>
            <value var="cd" />
        </Item>
        <Item>
            <name>tar</name>
            <value var="targetsLimitFloat" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/ExtraLethalityOnLament.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/CC/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectOnDamageDoneTrigger">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateAnd">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.offender.PredicateIsCrit" />
                                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                                <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.offender.PredicateIsAE" />
                                </Item>
                                <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.offender.PredicateActionGroup">
                                        <groups>
                                            <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
                                        </groups>
                                    </predicate>
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <holderPredicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="CD.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                    </holderPredicates>
                    <impactsOnDamageDone>
                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="CD.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier var="cd" />
                                    </durationScaler>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOnDamageDone>
                    <impactsToVictim>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/SilenceDisarm/SilenceDisarm.(BuffResource).xdb" />
                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier var="value" />
                                                    </durationScaler>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                                    <predicates>
                                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                            <predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                                                                <spell href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisable.(SpellSingleTarget).xdb" />
                                                            </predicate>
                                                        </Item>
                                                    </predicates>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                                            <radius>8</radius>
                                                            <affectGroup>Enemies</affectGroup>
                                                            <affectHolder>false</affectHolder>
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/SilenceDisarm/SilenceDisarm.(BuffResource).xdb" />
                                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                                        <multiplier var="value" />
                                                                    </durationScaler>
                                                                </Item>
                                                            </impacts>
                                                            <filter type="gameMechanics.world.creature.AliveFilter" />
                                                            <targetsLimit var="targetsLimit" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsToVictim>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.AbilityUnlockerEffect">
            <abilities>
                <Item href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisableAbility.(AbilityResource).xdb" />
            </abilities>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>