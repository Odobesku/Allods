<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>1700</time>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/SpringBossPrecastHand01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1</scale>
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<locator>Slot_Hand_R</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/SpringBossPrecastHand01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/SpringBossProjectile_PowerAtack.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Spells/SpringBoss_AOEAvatar.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<theGe>15</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Hand_R</locator>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<shift z="0.1" />
					<locator>Slot_Global</locator>
				</pointOnTarget>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction />
	</playOnTargets>
</SpellVisScripts>
