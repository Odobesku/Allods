<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobRay_Instant.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <PreCastAnimation>ready</PreCastAnimation>
            <CastAnimation>channelCastDirected</CastAnimation>
            <RayMaxTime>500</RayMaxTime>
            <FXOnCaster>/Spells/FX/Spells/ReadySpellDirectLightningWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
            <FXRay>/Spells/FX/Spells/MagePrismaticRayAbility_RayBlue.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXRay>
            <HitPostFXOnTargets>/Spells/VisScripts/HitPostFxOnTarget/HitLightningShader.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</HitPostFXOnTargets>
            <LocatorOnCaster>Slot_FX</LocatorOnCaster>
        </Variables>
    </Header>
    <launch type="VisActionList">
        <play>Simultaneously</play>
    </launch>
</SpellVisScripts>