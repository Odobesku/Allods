    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>false</ignoreGlobalCooldown>
    <launchWhenReady>false</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
            <group href="" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>13</mana>
                <scaleByWeaponSpeed>false</scaleByWeaponSpeed>
                <source>Mainhand</source>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DrainLifeDamage">
                <element>DISEASE</element>
                <minDamage>9.8</minDamage>
                <maxDamage>9.8</maxDamage>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                <casterHealMultiplier>0.5</casterHealMultiplier>
                <threatMultiplier>1</threatMultiplier>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Creatures/Vampire/VampirePoison/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <anyRank>true</anyRank>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <allowOverrideCaster>false</allowOverrideCaster>
                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>2</multiplier>
                        </durationScaler>
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>0</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>