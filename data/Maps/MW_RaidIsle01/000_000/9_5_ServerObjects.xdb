<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.PatchObjects>
	<objects>
		<Item type="gameMechanics.map.spawn.recaptureable.RecapturablePlace">
			<scriptID>Point03</scriptID>
			<place>
				<coord x="21.2626" y="15.0419" z="-30.5326" />
				<yaw>0.083127</yaw>
				<faction href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
			</place>
			<device href="/Items/InteractiveObjects/MW_RaidIsle01/MWRaid_Point03.(SteleResource).xdb" />
			<autoCapturePeriodSec>1800</autoCapturePeriodSec>
			<steleImpactsOnOwnerChange>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="/Items/InteractiveObjects/MW_RaidIsle01/RaidPointCapture_Impacts_01.(ImpactListResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableOwner">
							<owner href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.battleground.map.PredicateBattleMemberMark">
													<mark href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/MWRaid/Buff_GoOut_Attention.(BuffResource).xdb" />
												</Item>
											</impactsIf>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</steleImpactsOnOwnerChange>
			<impactsOnStateChanged>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableState">
							<state>Captured</state>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
							<zone href="/Items/InteractiveObjects/MW_RaidIsle01/CheckZone_3.(ScriptZone).xdb" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="/Items/InteractiveObjects/MW_RaidIsle01/MWRaid_Point03.(ImpactListResource).xdb" />
				</Item>
			</impactsOnStateChanged>
			<stopAssaultPredicates>
				<Item type="gameMechanics.constructor.basicElements.PredicateOr">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.predicates.PredicateGreater">
								<lhs type="gameMechanics.elements.calcers.CheckPointAttackersCalcer" />
								<rhs type="gameMechanics.elements.calcers.CheckPointDefendersCalcer" />
							</predicate>
						</Item>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableOwner">
							<owner href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
						</Item>
					</predicates>
				</Item>
			</stopAssaultPredicates>
			<speedScaler type="gameMechanics.elements.scalers.LinearScaler">
				<multiplier>1.5</multiplier>
			</speedScaler>
			<defendCalcer type="gameMechanics.constructor.basicElements.FloatZero" />
			<attackCalcer type="gameMechanics.constructor.basicElements.FloatZero" />
			<achievementResource href="/Mechanics/InstancedEventResource/MWRaid_01/MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
			<achievementCount type="gameMechanics.elements.calcers.LongData">
				<value>2</value>
			</achievementCount>
			<periodicUpdateTick>1000</periodicUpdateTick>
		</Item>
		<Item type="gameMechanics.map.spawn.recaptureable.RecapturablePlace">
			<scriptID>Point04</scriptID>
			<place>
				<coord x="210.12" y="122.888" z="-15.7612" />
				<yaw>3.48527</yaw>
				<faction href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
			</place>
			<device href="/Items/InteractiveObjects/MW_RaidIsle01/MWRaid_Point04.(SteleResource).xdb" />
			<autoCapturePeriodSec>1800</autoCapturePeriodSec>
			<steleImpactsOnOwnerChange>
				<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableState">
							<state>Captured</state>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
							<impacts>
								<Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactUpdateEventAchievementGeneric">
									<achievement href="/Mechanics/InstancedEventResource/MWRaid_01/MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
									<summand type="gameMechanics.elements.calcers.FloatData">
										<value>15000</value>
									</summand>
									<mark href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableOwner">
							<owner href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.battleground.map.PredicateBattleMemberMark">
													<mark href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/MWRaid/Buff_GoOut_Attention.(BuffResource).xdb" />
												</Item>
											</impactsIf>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</steleImpactsOnOwnerChange>
			<impactsOnStateChanged>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableState">
							<state>Captured</state>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
							<zone href="/Items/InteractiveObjects/MW_RaidIsle01/CheckZone_4.(ScriptZone).xdb" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="/Items/InteractiveObjects/MW_RaidIsle01/MWRaid_Point04.(ImpactListResource).xdb" />
				</Item>
			</impactsOnStateChanged>
			<stopAssaultPredicates>
				<Item type="gameMechanics.constructor.basicElements.PredicateOr">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.predicates.PredicateGreater">
								<lhs type="gameMechanics.elements.calcers.CheckPointAttackersCalcer" />
								<rhs type="gameMechanics.elements.calcers.CheckPointDefendersCalcer" />
							</predicate>
						</Item>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableOwner">
							<owner href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
						</Item>
					</predicates>
				</Item>
			</stopAssaultPredicates>
			<speedScaler type="gameMechanics.elements.scalers.LinearScaler">
				<multiplier>1.5</multiplier>
			</speedScaler>
			<defendCalcer type="gameMechanics.constructor.basicElements.FloatZero" />
			<attackCalcer type="gameMechanics.constructor.basicElements.FloatZero" />
			<achievementResource href="/Mechanics/InstancedEventResource/MWRaid_01/MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
			<achievementCount type="gameMechanics.elements.calcers.LongData">
				<value>2</value>
			</achievementCount>
			<periodicUpdateTick>1000</periodicUpdateTick>
		</Item>
