				<chance>1</chance>
			</Item>
			<Item>
				<lootTable type="gameMechanics.constructor.schemes.item.LootTableRandomModifier">
					<lootTable type="gameMechanics.constructor.schemes.item.LootTableExternal">
						<table hrefvar="DirectDrop" />
					</lootTable>
					<modifiers>
						<Item type="gameMechanics.constructor.schemes.item.ItemModifierMultiple">
							<modifiers>
								<Item type="gameMechanics.constructor.schemes.item.ItemModifierBudgetMod">
									<delta>
										<min var="min" />
										<max var="max" />
									</delta>
									<budgetType>DefenceBudget</budgetType>
								</Item>
								<Item type="gameMechanics.constructor.schemes.item.ItemModifierBudgetMod">
									<delta>
										<min var="min" />
										<max var="max" />
									</delta>
									<budgetType>OffenceBudget</budgetType>
								</Item>
							</modifiers>
						</Item>
					</modifiers>
				</lootTable>
				<chance>1</chance>
			</Item>
			<Item>
