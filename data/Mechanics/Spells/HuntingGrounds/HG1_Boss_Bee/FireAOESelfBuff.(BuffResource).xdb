				<Item type="gameMechanics.elements.device.EntityClientData">
					<data href="AOEData.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
