                                                <resource href="Bomb.(ProjectileResource).xdb" />
                                            </projectileData>
                                        </Item>
                                    </impacts>
                                    <targetsLimit>1</targetsLimit>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>3000</tick>
            <initialDelay>3000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
