<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739948690</resourceId>
	</Header>
	<visualScript type="CreatureHangInAirAction">
		<hangHeight>0.5</hangHeight>
	</visualScript>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
				<Item>Rooted</Item>
				<Item>ExternalMove</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectAllowNoVisibleTargets" />
		<Item type="gameMechanics.elements.effects.EffectNoAggro" />
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="SphereBuff.(BuffResource).xdb" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDamageTrigger">
			<predicates>
				<Item type="gameMechanics.elements.predicates.offender.PredicateNot">
					<predicate type="gameMechanics.elements.predicates.offender.PredicateOffenderIsCaster" />
				</Item>
			</predicates>
			<impacts>
				<casterToTarget>
					<Item type="gameMechanics.elements.impacts.DirectHeal">
						<heal>1</heal>
					</Item>
				</casterToTarget>
			</impacts>
			<scaleImpactsByDamage>true</scaleImpactsByDamage>
		</Item>
		<Item type="gameMechanics.elements.effects.LifeGuard">
			<level>0.5</level>
		</Item>
		<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.9375</coeff>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.Enlarge">
			<factor>0.8</factor>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
