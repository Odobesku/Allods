	<pitchParameters>
		<minVelocity>8</minVelocity>
		<minVelocityPitch>3</minVelocityPitch>
		<topVelocity>15</topVelocity>
		<topVelocityPitch>15</topVelocityPitch>
		<minStepDeltaTMainAvatar>5</minStepDeltaTMainAvatar>
		<minStepDeltaT>15</minStepDeltaT>
		<minTurnRadius>1</minTurnRadius>
		<pitchMaxVelocity>20</pitchMaxVelocity>
		<maxPitch>20</maxPitch>
	</pitchParameters>
	<jumpSettings>
		<specialJumpPause>3000</specialJumpPause>
	</jumpSettings>
