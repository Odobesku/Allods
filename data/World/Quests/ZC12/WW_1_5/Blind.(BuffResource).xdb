                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisorient">
            <radius>1</radius>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_6/Knockdown_quest.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/World/Quests/ZC12/WW_1_3/Ingrid_vis.(BuffResource).xdb" />
