<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readySpellOmni</Item>
		</animations>
		<channel>CHANNEL_ATTACK</channel>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureProjectileAction">
				<explosionFx href="/Spells/FX/Spells/Engineer_Exhaust_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<pointOnCaster type="VisPointLocator">
					<shift z="-1" />
					<locator>Slot_Hand_L</locator>
				</pointOnCaster>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedWand</Item>
				</animations>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
