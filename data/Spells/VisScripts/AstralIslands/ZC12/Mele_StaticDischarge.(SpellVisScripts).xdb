<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/GolemBlue_Glow.(VisObjectTemplate).xdb" />
						<locator>Slot_BodyFX</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/AOEAura_Ice_R5_25.(VisObjectTemplate).xdb" />
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Architect_Explosion_R5.(VisObjectTemplate).xdb" />
						<scale>0.9</scale>
						<locator>Slot_Global</locator>
						<offset z="0.2" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/HitLightning_big.(VisObjectTemplate).xdb" />
						<scale>1</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
