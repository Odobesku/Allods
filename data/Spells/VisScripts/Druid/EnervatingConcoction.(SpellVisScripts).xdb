<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/OmniNoWand.(SpellVisScripts).xdb" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationPotion.(CreatureVisActionResource).xdb</PreCastAnimation>
			<CastAnimation>spellCastPotion</CastAnimation>
