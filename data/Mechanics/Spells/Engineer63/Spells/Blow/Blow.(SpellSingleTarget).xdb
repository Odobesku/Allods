<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>215849</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/RangedAttacks.xdb" />
    </groups>
    <Name href="Blow.(SpellSingleTarget).Name.txt" />
    <Description href="Blow.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>WeaponScaler</formula>
            </scaler>
        </Item>
        <Item>
            <name>dmg2</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Mage/Harmony.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Engineer/BlowShot.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <ranks>
        <Item href="Blow01.(SpellSingleTarget).xdb" />
        <Item href="Blow02.(SpellSingleTarget).xdb" />
        <Item href="Blow03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateVariableEqualsGreatThan">
                        <resource href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
                        <minValue>160</minValue>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateVariableEqualsLessThan">
                        <resource href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
                        <maxValue>-160</maxValue>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/Engineer63/Abilities/Reactor/AutoCoolingDisable.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                <mark href="/Mechanics/Spells/Engineer63/Spells/Exhaust/ExhaustOrBlowOnCaster.(MarkResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                <mark href="BlowOnCaster.(MarkResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactVariableReset">
                <variable href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateVariableEqualsGreatThan">
                                <resource href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
                                <minValue>160</minValue>
                            </Item>
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>ACID</element>
                                <damage var="damage" />
                                <impactsOnHitTarget>
                                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                        <mark href="/Mechanics/Spells/Engineer63/Spells/Exhaust/BlowOrExhaustOnTarget.(MarkResource).xdb" />
                                    </Item>
                                </impactsOnHitTarget>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                        </impacts>
                        <elseImpacts>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                <impactsOnHitTarget>
                                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                        <mark href="/Mechanics/Spells/Engineer63/Spells/Exhaust/BlowOrExhaustOnTarget.(MarkResource).xdb" />
                                    </Item>
                                </impactsOnHitTarget>
                                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                    <scalers>
                                        <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                                        <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                                    </scalers>
                                </scaler>
                                <minDamage var="damage" />
                                <maxDamage var="damage" />
                            </Item>
                        </elseImpacts>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>35</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>