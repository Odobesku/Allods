<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>184451</resourceId>
    </Header>
    <Name href="PointBuff.(BuffResource)_Name.txt" />
    <Description href="PointBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/Bomb.chn.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="PointBuff.(BuffResource)_Name.txt.template" />
    <descTemplate href="PointBuff.(BuffResource).DescTemplate.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>10</radius>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>FIRE</element>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            <damage>30</damage>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateIsMob" />
                            </Item>
                        </predicates>
                    </filter>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="PointBuffData.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
            </impacts>
            <initialDelay>2000</initialDelay>
        </Item>
    </effects>
    <duration>6000</duration>
    <isHelpful>false</isHelpful>
    <isAE>true</isAE>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>