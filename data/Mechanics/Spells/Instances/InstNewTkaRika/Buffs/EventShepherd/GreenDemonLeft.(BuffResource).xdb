	</Header>
	<Name href="GreenDemonLeft.(BuffResource).Name.txt" />
	<Description href="GreenDemonLeft.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Crafting/LeatherHGUnicDefence.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
