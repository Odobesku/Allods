                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMaster">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="Buffs/EventAstralPoison/HealingBuff.(BuffResource).xdb" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactIncrementBuffDuration">
                                                    <buff href="Buffs/EventAstralPoison/HealingBuff.(BuffResource).xdb" />
                                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                                        <value>2000</value>
                                                    </delta>
                                                </Item>
                                            </impactsIf>
                                            <impactsElse>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="Buffs/EventAstralPoison/HealingBuff.(BuffResource).xdb" />
                                                </Item>
