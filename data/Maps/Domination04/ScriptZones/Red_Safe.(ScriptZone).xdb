<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>43132</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.battleground.map.PredicateBattleMemberMark">
                    <mark href="/Maps/Domination04/Marks/RedMark.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/InstancedEventResource/MM_BG04/Safe_zone.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIf>
        </Item>
    </impactsIn>
    <impactsOut>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="/Mechanics/InstancedEventResource/MM_BG04/Safe_zone.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        </Item>
    </impactsOut>
</gameMechanics.map.scriptZone.ScriptZone>