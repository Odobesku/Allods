<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>205736</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Misc/Food/Acorn.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Spell_Name.txt.template" />
    <descTemplate href="Spell_Desc.txt.template" />
    <speed>0</speed>
    <level>1</level>
    <prepareDuration>1000</prepareDuration>
    <immutablePrepareDuration>false</immutablePrepareDuration>
    <needLos>false</needLos>
    <element>PHYSICAL</element>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>true</replaceLowRanks>
    <isWorkOnDead>false</isWorkOnDead>
    <ranks>
        <Item href="Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
        <Item href="Spell02.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>true</triggersGlobalCooldown>
    <ignoreGlobalCooldown>false</ignoreGlobalCooldown>
    <launchWhenReady>false</launchWhenReady>
    <needInFront>true</needInFront>
    <mechanics type="gameMechanics.constructor.schemes.spell.SpellMechanics">
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem">
                <number>1</number>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                <data href="PlayAnimation.xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.IncrementMana">
                <manaType>Mana</manaType>
                <amount var="amount" />
                <threatMultiplier>1</threatMultiplier>
            </Item>
            <Item type="gameMechanics.elements.impacts.DirectHeal">
                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="gameMechanics.elements.calcers.FloatData">
                        <value var="value" />
                    </mulCalcer>
                </scalerTarget>
                <threatMultiplier>1</threatMultiplier>
                <heal>1</heal>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>