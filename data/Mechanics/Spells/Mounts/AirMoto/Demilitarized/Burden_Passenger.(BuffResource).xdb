<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739965844</resourceId>
    </Header>
    <image href="/Interface/Icons/Spells/WornHands.(UISingleTexture).xdb" />
    <needVisualize>false</needVisualize>
    <sysUIScriptName>MountPassenger</sysUIScriptName>
    <effects>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/Transformation.(ActionGroup).xdb" />
                        <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                    </groups>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectBurden">
            <impactsOnFarAway>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Burden_Passenger.(BuffResource).xdb" />
                </Item>
            </impactsOnFarAway>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/TwoSeaterMount.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableSpellsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/TwoSeaterMount.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectAddContextActions">
            <actions>
                <Item href="DismountPassenger.(SpellSingleTarget).xdb" />
                <Item href="ChopperDemilitarizedHitPassenger.(SpellSingleTarget).xdb" />
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactDismount" />
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/Mounts/AirMoto/TakePassenger/Burden_Passenger_Visual.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/Mounts/HideShield/Buff01.(BuffResource).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="DropPassenger.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="DropPassenger.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="TakePassenger.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/Spells/Mounts/AirMoto/TakePassenger/Burden_Passenger_Visual.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/Spells/Mounts/HideShield/Buff01.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/Spells/Mounts/AllMounts/Invisibility/PassengerBuff.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                    <impactsResource href="/Mechanics/Spells/Mounts/Exo/ExoAutoCaster.(ImpactListResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectVisibilityChanged">
            <impactsOnAppear>
                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                    <impactsResource href="/Mechanics/Spells/Mounts/AirMoto/TakePassenger/ReattachBurden.(ImpactListResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="BearerFinder.(BuffResource).xdb" />
                </Item>
            </impactsOnAppear>
            <impactsOnDisappear>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="BearerFinder.(BuffResource).xdb" />
                </Item>
            </impactsOnDisappear>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Burden_Passenger.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.EffectList">
            <effectsResource href="/Mechanics/GameRoot/Mount/HidePetMountAbility.(EffectListResource).xdb" />
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/BearingBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/Dismount.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>