<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>739822500</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.CreatureFilter" />
    <conditionsIn>
        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                    <mobs>
                        <Item href="/Creatures/TreantGreen/Instances/ZC8/ZC8_TreantBoss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <Item href="/Characters/HumMobs/ZC8/Tekuani/ZC8_EvilTekuani.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    </mobs>
                </Item>
            </predicates>
        </Item>
    </conditionsIn>
    <impactsOut>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>ZC8_EvilTekuani</scriptID>
                        <map href="/Maps/IllusionWorld/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <onBehalfOfTarget>true</onBehalfOfTarget>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAggro" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>ZC8_TreantBoss</scriptID>
                        <map href="/Maps/IllusionWorld/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <onBehalfOfTarget>true</onBehalfOfTarget>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAggro" />
                    </impacts>
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="/Creatures/TreantGreen/Instances/ZC8/ZC8_TreantBoss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="ZC8_ImmuneTaunts.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>ZC8_EvilTekuani</scriptID>
                                <map href="/Maps/IllusionWorld/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <onBehalfOfTarget>true</onBehalfOfTarget>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList">
                                            <eraseBeforeCopy>true</eraseBeforeCopy>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactComeToMe" />
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsElse>
        </Item>
    </impactsOut>
    <considerAsWhole>true</considerAsWhole>
</gameMechanics.map.scriptZone.ScriptZone>