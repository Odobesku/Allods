<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastGround</Item>
                </animations>
                <channel>CHANNEL_ABILITY</channel>
                <channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
                <advanced>
                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                </advanced>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>300</delay>
                        <effectFx href="/Spells/FX/Mobs/Gastornis_SpellCastAOE_EarthStomp.(VisObjectTemplate).xdb" />
                        <scale>0.2</scale>
                        <locator>FROM_LOCATOR_NAME</locator>
                        <member>Caster</member>
                        <locatorName>Slot_Global</locatorName>
                        <offset y="-0.2" z="-0.4" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>