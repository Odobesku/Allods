<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739855168</resourceId>
	</Header>
	<Name href="Buff.txt" />
	<Description href="Buff.Description.txt" />
	<image href="/Interface/Icons/Misc/Buffs/EnduringWill.(UISingleTexture).xdb" />
	<visScript href="/Spells/BuffVisScripts/WillImmunity.(BuffVisScripts).xdb" />
	<interfaceHighPriority>true</interfaceHighPriority>
	<nameTemplate href="Buff.txt" />
	<descTemplate href="Buff.Description.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
					<predicates>
						<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
							<groups>
								<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
								<Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
								<Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
							</groups>
						</Item>
						<Item type="gameMechanics.constructor.basicElements.PredicateGenericNot">
							<predicate type="gameMechanics.constructor.schemes.buff.BuffInGroup">
								<groups>
									<Item href="/Mechanics/Spells/Groups/DRMesmerize.xdb" />
									<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
								</groups>
							</predicate>
						</Item>
					</predicates>
					<binaryPredicate type="gameMechanics.constructor.basicElements.BinaryPredicateTrue" />
				</Item>
			</effectsIf>
			<effectsElse>
				<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
					<predicates>
						<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
							<groups>
								<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
								<Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
								<Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
								<Item href="/Mechanics/Spells/Groups/DRMesmerize.xdb" />
							</groups>
						</Item>
						<Item type="gameMechanics.constructor.basicElements.PredicateGenericNot">
							<predicate type="gameMechanics.constructor.schemes.buff.BuffInGroup">
								<groups>
									<Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
								</groups>
							</predicate>
						</Item>
					</predicates>
					<binaryPredicate type="gameMechanics.constructor.basicElements.BinaryPredicateTrue" />
				</Item>
			</effectsElse>
		</Item>
	</effects>
	<duration>1000</duration>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
