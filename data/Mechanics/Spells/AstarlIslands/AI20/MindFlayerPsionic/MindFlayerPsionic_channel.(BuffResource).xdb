<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739875723</resourceId>
	</Header>
	<Name href="MindFlayerPsionic_channel.(BuffResource).Name.txt" />
	<Description href="MindFlayerPsionic_channel.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/TepSoulSteal.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visScript href="/Spells/BuffVisScripts/DotAstral.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<effects>
		<Item type="gameMechanics.elements.effects.MagicDoT">
			<parameters>
				<damagePerTick>30</damagePerTick>
				<impactsPerTick>
					<Item type="gameMechanics.elements.impacts.ReturningImpact">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
								<radius>40</radius>
								<affectGroup>Friends</affectGroup>
								<impacts>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="MindFlayerPsionic_PackBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									</Item>
								</impacts>
								<filter type="gameMechanics.constructor.basicElements.FilterAnd">
									<filters>
										<Item type="gameMechanics.world.creature.MobFilter" />
										<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
											</predicates>
										</Item>
									</filters>
								</filter>
							</Item>
						</impacts>
					</Item>
				</impactsPerTick>
			</parameters>
			<element>ASTRAL</element>
			<scaler type="gameMechanics.elements.scalers.MagicScaler" />
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
