<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739925085</resourceId>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Psionic/SearedMind.chn.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <targetImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                                <spell href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisable.(SpellSingleTarget).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                <buff href="/Mechanics/Spells/Psionic63/Spells/PsionicContact/PsionicContact.(BuffResource).xdb" />
                                <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledImpacts">
                                    <scalerCaster type="gameMechanics.elements.scalers.ScalerIf">
                                        <condition type="gameMechanics.elements.predicates.PredicateHasSpell">
                                            <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionPain/Spell01.(SpellSingleTarget).xdb" />
                                            <anyRank>false</anyRank>
                                        </condition>
                                        <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                <externalCalcer href="/Mechanics/Spells/Psionic63/Spells/SuggestionPain/CalcerDamage01.(CalcerFloatResource).xdb" />
                                            </mulCalcer>
                                        </scalerIf>
                                        <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                            <condition type="gameMechanics.elements.predicates.PredicateHasSpell">
                                                <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionPain/Spell02.(SpellSingleTarget).xdb" />
                                                <anyRank>false</anyRank>
                                            </condition>
                                            <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer href="/Mechanics/Spells/Psionic63/Spells/SuggestionPain/CalcerDamage02.(CalcerFloatResource).xdb" />
                                                </mulCalcer>
                                            </scalerIf>
                                            <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                                <condition type="gameMechanics.elements.predicates.PredicateHasSpell">
                                                    <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionPain/Spell03.(SpellSingleTarget).xdb" />
                                                    <anyRank>false</anyRank>
                                                </condition>
                                                <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                        <externalCalcer href="/Mechanics/Spells/Psionic63/Spells/SuggestionPain/CalcerDamage03.(CalcerFloatResource).xdb" />
                                                    </mulCalcer>
                                                </scalerIf>
                                                <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier>0</multiplier>
                                                </scalerElse>
                                            </scalerElse>
                                        </scalerElse>
                                    </scalerCaster>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                            <radius>15</radius>
                                            <affectGroup>Enemies</affectGroup>
                                            <affectHolder>false</affectHolder>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactsUnderEnvelope">
                                                            <spell href="/Mechanics/Spells/Psionic63/Spells/SuggestionPain/Spell01.(SpellSingleTarget).xdb" />
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                                    <element>PHYSICAL</element>
                                                                    <forceAE>true</forceAE>
                                                                    <damage>0.35</damage>
                                                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                    <groupRepeaters>true</groupRepeaters>
                                                </Item>
                                            </impacts>
                                            <filter type="gameMechanics.world.creature.AliveFilter" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </targetImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/Psionic63/Spells/SuggestionPain/Spell01.(SpellSingleTarget).xdb" />
                </spells>
            </destination>
        </Item>
        <Item type="gameMechanics.elements.effects.AbilityUnlockerEffect">
            <abilities>
                <Item href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisableAbility.(AbilityResource).xdb" />
            </abilities>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>