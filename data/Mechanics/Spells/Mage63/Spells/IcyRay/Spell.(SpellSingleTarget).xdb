		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<launchWhenReady>true</launchWhenReady>
	<mechanics>
		<channelingMechanics>
			<channelingBuff hrefvar="buff" />
			<finishImpacts>
				<Item type="gameMechanics.elements.impacts.MarkedImpact">
					<mark href="/Mechanics/Spells/Mage63/Abilities/IceRayRoot/Mark.(MarkResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ReturningImpact">
							<impacts>
								<Item type="gameMechanics.elements.impacts.MarkedImpact">
									<mark href="/Mechanics/Spells/Mage63/Abilities/IcyRayHasteAfterCast/Mark.(MarkResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.MarkedImpact">
									<mark href="/Mechanics/Spells/Mage63/Abilities/Harmony/Mark.(MarkResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</finishImpacts>
		</channelingMechanics>
		<casterChannelingEffects>
			<Item type="gameMechanics.elements.effects.EffectsIfCaster">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateHasAbility">
						<ability href="/Mechanics/Spells/Mage63/Abilities/CastChannelOnMove/Ability.(AbilityResource).xdb" />
					</Item>
				</predicates>
				<effectsIf>
					<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
						<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
							<coeff>-0.35</coeff>
						</effectScaler>
					</Item>
				</effectsIf>
			</Item>
		</casterChannelingEffects>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
