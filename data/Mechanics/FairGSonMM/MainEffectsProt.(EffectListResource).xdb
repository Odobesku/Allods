<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.EffectListResource>
    <Header>
        <resourceId>261867</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EquipTrigger">
            <slot var="triggerslot" />
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateItemEquipped">
                                            <resource hrefvar="resource" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateItemEquipped">
                                            <resource hrefvar="resource2" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateItemEquipped">
                                            <resource hrefvar="resource3" />
                                        </Item>
                                    </predicates>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                    <lhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                        <calcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                            <dressSlot var="slot" />
                                        </calcer>
                                    </lhs>
                                    <rhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                        <calcer type="gameMechanics.elements.calcers.FloatData">
                                            <value var="value" />
                                        </calcer>
                                    </rhs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff hrefvar="buff" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                            <lhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                                <calcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                                    <dressSlot var="slot" />
                                                </calcer>
                                            </lhs>
                                            <rhs type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                                <calcer type="gameMechanics.elements.calcers.FloatData">
                                                    <value>4</value>
                                                </calcer>
                                            </rhs>
                                        </Item>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateItemEquipped">
                                                    <resource hrefvar="resource" />
                                                </Item>
                                                <Item type="gameMechanics.elements.predicates.PredicateItemEquipped">
                                                    <resource hrefvar="resource2" />
                                                </Item>
                                                <Item type="gameMechanics.elements.predicates.PredicateItemEquipped">
                                                    <resource hrefvar="resource3" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff hrefvar="buffEnch" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff hrefvar="buff" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff hrefvar="buffEnch" />
                        </Item>
                    </impactsOff>
                    <rerunOnLoad>true</rerunOnLoad>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.basicElements.EffectListResource>