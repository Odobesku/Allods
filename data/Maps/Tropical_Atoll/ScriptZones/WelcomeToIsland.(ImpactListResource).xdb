<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>49876</resourceId>
    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Maps/Tropical_Atoll/Scripts/ChangingVis/SailorSuit.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </predicate>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                    <impactsResource href="/Maps/Tropical_Atoll/Scripts/ChangingVis/AttachAtollVisual.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Maps/Tropical_Atoll/Scripts/ChangingVis/HideVisual_ForSailorSuit.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsElse>
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>