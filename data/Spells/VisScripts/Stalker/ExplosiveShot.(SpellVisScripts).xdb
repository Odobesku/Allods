<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/RangedAttack.(SpellVisScripts).xdb" />
		<Variables>
			<FxProjectile>/Spells/FX/Spells/ArrowBurrowing.(VisObjectTemplate).xdb</FxProjectile>
			<LocatorNameOnArrow>Slot_FX</LocatorNameOnArrow>
			<FxOnHands>/Spells/FX/Spells/StalkerShotMightyUpgrade_Precast.(VisObjectTemplate).xdb</FxOnHands>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item skiped="" />
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item skiped="" />
			<Item skiped="" />
			<Item type="CreatureThrowArrowAction">
				<additionalEffectFx hrefvar="FxProjectile" />
			</Item>
			<Item skiped="" />
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantCold</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureThrowArrowAction">
						<arrow href="" />
						<enchantedArrowIndex>1</enchantedArrowIndex>
						<arrowInTargetTime>15000</arrowInTargetTime>
						<theGe>8</theGe>
						<additionalEffectFx href="/Spells/FX/Weapon/ArrowEnchantTrail_Blue.(VisObjectTemplate).xdb" />
						<effectBone var="LocatorNameOnArrow" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantFire</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureThrowArrowAction">
						<arrow href="" />
						<enchantedArrowIndex>1</enchantedArrowIndex>
						<arrowInTargetTime>15000</arrowInTargetTime>
						<theGe>8</theGe>
						<additionalEffectFx href="/Spells/FX/Weapon/ArrowEnchantTrail_Red.(VisObjectTemplate).xdb" />
						<effectBone var="LocatorNameOnArrow" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantPoison</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureThrowArrowAction">
						<arrow href="" />
						<enchantedArrowIndex>1</enchantedArrowIndex>
						<arrowInTargetTime>15000</arrowInTargetTime>
						<theGe>8</theGe>
						<additionalEffectFx href="/Spells/FX/Weapon/ArrowEnchantTrail_Green.(VisObjectTemplate).xdb" />
						<effectBone var="LocatorNameOnArrow" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>BonusDmgAll</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureThrowArrowAction">
						<arrow href="" />
						<enchantedArrowIndex>1</enchantedArrowIndex>
						<arrowInTargetTime>0</arrowInTargetTime>
						<theGe>8</theGe>
						<additionalEffectFx href="/Spells/FX/Spells/War63_BuffRage_Hand.(VisObjectTemplate).xdb" />
						<effectBone var="LocatorNameOnArrow" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="Sound3DAction">
					<sound>
						<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
						<name>spells/Stalker/StalkerArrowHit</name>
					</sound>
					<alias href="" />
				</Item>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/War63_ThunderStrikeAoe.(VisObjectTemplate).xdb" />
							<scale>2</scale>
						</Item>
					</visualEffects>
				</Item>
				<Item type="VisActionList">
					<play>Simultaneously</play>
					<playWhile type="PredicateCreatureFlagAction">
						<flagName>EnchantCold</flagName>
					</playWhile>
					<preconditional>true</preconditional>
					<elements>
						<Item type="CreatureEffectsOnTarget">
							<visualEffects>
								<Item>
									<effectFx href="/Spells/FX/Spells/Engineer_ProtectShieldAoe.(VisObjectTemplate).xdb" />
									<effectAlias href="" />
									<offendTime />
								</Item>
							</visualEffects>
						</Item>
					</elements>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
