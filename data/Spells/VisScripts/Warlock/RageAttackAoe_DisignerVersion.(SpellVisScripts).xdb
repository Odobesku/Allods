<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarComplite type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureEffectsAction">
				<category>EFFECT_DEFAULT</category>
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectAlias href="" />
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<effectFx href="/Spells/FX/Spells/Warlock_SpellCastAoePh.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<scale>1</scale>
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<muteFxSounds>false</muteFxSounds>
						<ignoreParentRotation>false</ignoreParentRotation>
						<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
						<locator>Slot_Global</locator>
						<member>Default_Member</member>
						<offset x="0" y="0" z="0" />
						<rotation x="0" y="0" z="0" />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
				</visualEffects>
				<dontFade>false</dontFade>
				<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
				<stopOnDeath>false</stopOnDeath>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
	</actionBarComplite>
	<precastType>PRECAST_DEFAULT</precastType>
	<launch type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureAnimationAction">
				<advanced>
					<animationKeysAction>
						<Item>
							<action type="client.Replica.VisActionList">
								<elements>
									<Item type="client.Replica.CreatureChannelDirectAction">
										<alternativeEndPoint type="client.Replica.VisPointLocator">
											<shift x="0" y="0" z="0" />
											<from>FROM_DEFALUT</from>
											<locator>Slot_FX</locator>
											<member>Default_Member</member>
										</alternativeEndPoint>
										<channelingFx href="/Spells/FX/Spells/Warlock_RageAttack_ProjMain01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<endPoint type="client.Replica.VisPointLocator">
											<shift x="0" y="0" z="0" />
											<from>FROM_DEFALUT</from>
											<locator>Slot_BodyFX</locator>
											<member>Default_Member</member>
										</endPoint>
										<fadeInTime>0</fadeInTime>
										<fadeOutTime>0</fadeOutTime>
										<fxLength>5.5</fxLength>
										<multyTargetMode>FromCaster</multyTargetMode>
										<offendTime type="client.Replica.EffectOffendConstDelay">
											<delay>350</delay>
										</offendTime>
										<secondaryTargetParams>
											<channelingFx href="/Spells/FX/Spells/Warlock_RageAttack_ProjMain.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
											<fadeInTime>150</fadeInTime>
											<fadeOutTime>100</fadeOutTime>
											<fxLength>5</fxLength>
											<offendTime type="client.Replica.EffectOffendConstDelay">
												<delay>0</delay>
											</offendTime>
											<velocity>350</velocity>
											<scaleTextureU>false</scaleTextureU>
											<scaleTextureV>false</scaleTextureV>
										</secondaryTargetParams>
										<startPoint type="client.Replica.VisPointLocator">
											<shift x="0" y="0" z="0" />
											<from>FROM_DEFALUT</from>
											<locator>Slot_BodyFX</locator>
											<member>Default_Member</member>
										</startPoint>
										<velocity>0</velocity>
										<scaleTextureU>false</scaleTextureU>
										<scaleTextureV>false</scaleTextureV>
									</Item>
									<Item type="client.Replica.CreatureEffectsOnTarget">
										<category>EFFECT_DEFAULT</category>
										<visualEffects>
											<Item>
												<delay>350</delay>
												<effectAlias href="" />
												<effectAnimations>
													<mode>DIE</mode>
												</effectAnimations>
												<effectFx href="/Spells/FX/Spells/Warlock_RageAttackAoe_MeleeHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
												<fadeInTime>0</fadeInTime>
												<fadeOutTime>500</fadeOutTime>
												<scale>1</scale>
												<fixPoint>false</fixPoint>
												<lockScale>false</lockScale>
												<muteFxSounds>false</muteFxSounds>
												<ignoreParentRotation>false</ignoreParentRotation>
												<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
												<locator>Slot_BodyFX</locator>
												<member>Default_Member</member>
												<offset x="0" y="0" z="0" />
												<rotation x="0" y="0" z="0" />
												<useVisObjectSettings>FROM_TARGET</useVisObjectSettings>
											</Item>
										</visualEffects>
										<dontFade>false</dontFade>
										<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
										<stopOnDeath>false</stopOnDeath>
										<direction>DIR_NO_TRANSFORM</direction>
									</Item>
								</elements>
								<play>Simultaneously</play>
								<playWhile type="client.Replica.VisActionDelay">
									<time>1000</time>
								</playWhile>
								<preconditional>false</preconditional>
								<restartOnVisualChange>false</restartOnVisualChange>
								<stopOnDeath>false</stopOnDeath>
								<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
							</action>
							<stopIfAnimationStoped>true</stopIfAnimationStoped>
						</Item>
					</animationKeysAction>
					<autoHasten>
						<mode>AUTOHASTEN_NONE</mode>
						<timeToBeLeft>0</timeToBeLeft>
					</autoHasten>
					<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
					<offendType>NO_OFFEND</offendType>
					<speed>0</speed>
					<turnToTarget>TURN_DEFAULT</turnToTarget>
					<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
					<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
					<denyAutoHasten>false</denyAutoHasten>
					<disableRandomFirstFrame>true</disableRandomFirstFrame>
					<eventPlaybackEnd>false</eventPlaybackEnd>
					<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
					<stopIfMoved>false</stopIfMoved>
					<stopIfRotated>false</stopIfRotated>
				</advanced>
				<animations>
					<Item>spellCastDirectedLightning</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
				<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
				<mode>DIE</mode>
				<use>USE_ANIMATIONS</use>
				<dontFreezePrecast>false</dontFreezePrecast>
			</Item>
			<Item type="client.Replica.CreatureEffectsAction">
				<category>EFFECT_DEFAULT</category>
				<visualEffects>
					<Item>
						<delay>300</delay>
						<effectAlias href="" />
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<effectFx href="/Spells/FX/Spells/Warlock_SpellCastDirectMain.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<scale>1</scale>
						<fixPoint>true</fixPoint>
						<lockScale>false</lockScale>
						<muteFxSounds>false</muteFxSounds>
						<ignoreParentRotation>false</ignoreParentRotation>
						<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
						<locator>Slot_BodyFX</locator>
						<member>Default_Member</member>
						<offset x="0" y="0" z="0" />
						<rotation x="0" y="0" z="0" />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
				</visualEffects>
				<dontFade>false</dontFade>
				<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
				<stopOnDeath>false</stopOnDeath>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
