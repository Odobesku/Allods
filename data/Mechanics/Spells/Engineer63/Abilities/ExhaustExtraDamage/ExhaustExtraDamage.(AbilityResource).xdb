<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739933378</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="ExhaustExtraDamage.(AbilityResource).Name.txt" />
	<description href="ExhaustExtraDamage.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var1</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>WeaponScaler</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
		<Item>
			<name>var0</name>
			<value var="value" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>MagicScaler</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Engineer/Exhaust.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.BuffExtraEffects">
					<buffs>
						<Item href="/Mechanics/Spells/CommonBuffs/Aspects/DD/Buff01.(BuffResource).xdb" />
					</buffs>
					<effects>
						<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
							<mark href="/Mechanics/Spells/Engineer63/Spells/Exhaust/ExhaustOnTarget.(MarkResource).xdb" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateVariableGreatThan">
											<resource href="/Mechanics/Spells/Engineer63/Abilities/Reactor/Overheating.(VariableResource).xdb" />
										</Item>
									</predicates>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff hrefvar="buff" />
										</Item>
									</impacts>
									<elseImpacts>
										<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
											<element>POISON</element>
											<forceAE>true</forceAE>
											<damage var="value" />
											<scaler type="gameMechanics.elements.scalers.MagicScaler" />
										</Item>
									</elseImpacts>
								</Item>
							</impacts>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="ExhaustExtraDamage01.(AbilityResource).xdb" />
		<Item href="ExhaustExtraDamage02.(AbilityResource).xdb" />
		<Item href="ExhaustExtraDamage03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
