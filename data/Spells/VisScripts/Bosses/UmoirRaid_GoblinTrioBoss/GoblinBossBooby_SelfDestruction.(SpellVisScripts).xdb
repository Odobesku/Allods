<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>specialIdle</Item>
					<Item>readySpell</Item>
				</animations>
				<channel>CHANNEL_DEFAULT</channel>
			</Item>
		</elements>
	</actionBarStart>
	<actionBarComplite type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Spells/HitFireballBig.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
			</Item>
		</elements>
	</actionBarComplite>
	<actionBarCancel type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Creatures/GoblinBossBooby/GoblinBossBoobyBomb2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<offset z="1" />
				<scale>0.5</scale>
				<lifeTime>2</lifeTime>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>special</Item>
				</animations>
				<channelOverrideScript />
			</Item>
		</elements>
	</actionBarCancel>
</SpellVisScripts>
