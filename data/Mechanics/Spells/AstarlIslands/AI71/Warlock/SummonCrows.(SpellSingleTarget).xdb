                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/AstarlIslands/AI71/Common/InitialMobDelay.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                        <object href="/Mechanics/Spells/AstarlIslands/AI71/Crow/Crow.(MobWorld).xdb" />
                        <pool href="/Mechanics/Spells/AstarlIslands/AI71/Common/AI71Pool.(SummonPool).xdb" />
                        <planeSyncStrategy>Sync</planeSyncStrategy>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                        <impact type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                        <verticalRange min="0" max="0" />
                                        <horizontalRange min="3" max="8" />
                                    </Item>
                                </modifiers>
                            </destination>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/AstarlIslands/AI71/Common/InitialMobDelay.(BuffResource).xdb" />
                                </Item>
