	</levelsPartition>
	<minTeamSize>1</minTeamSize>
	<capacity>12</capacity>
	<immediatelyStartFactor>0.8</immediatelyStartFactor>
	<unionType>Raid</unionType>
	<joinConditions>
		<Item type="gameMechanics.constructor.basicElements.PredicateOr">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateFaction">
					<faction href="/World/Factions/Empire.xdb" />
				</Item>
				<Item type="gameMechanics.elements.predicates.PredicateFaction">
					<faction href="/World/Factions/League.xdb" />
				</Item>
			</predicates>
		</Item>
		<Item type="gameMechanics.elements.predicates.PredicateInRaid" />
		<Item type="gameMechanics.elements.predicates.PredicateGroupHasNoOfflineMembers" />
		<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
			<predicates>
				<Item type="gameMechanics.constructor.basicElements.PredicateOr">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
