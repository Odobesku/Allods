<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>129288</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <text href="GoTo.Prototype.(Cue).Text.txt" />
    <impacts>
        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressees">
            <addresseesFinder type="gameMechanics.elements.addresseeFinders.AddresseesCalcerGroupMembers" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactEnterIsland">
                    <destination type="gameMechanics.map.destination.DestinationIdentifiableCoords">
                        <spawn>
                            <scriptID>IslandEntrance</scriptID>
                            <map hrefvar="map" />
                        </spawn>
                    </destination>
                    <sectorResource href="/Mechanics/Astral/Sectors/5.0/02/Sector.(AstralSectorResource).xdb#xpointer(/gameMechanics.world.bigAstral.AstralSectorResource)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
            <buff href="GoTo.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>