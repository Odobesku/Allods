<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>252350</resourceId>
    </Header>
    <Name href="LastLaughter.(BuffResource).Name.txt" />
    <Description href="LastLaughter.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorInnerRage.chn.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.ImmunityToHarmfulSpells" />
        <Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
            <delay>0</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
                    <predicates>
                        <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
                        <Item type="gameMechanics.constructor.basicElements.PredicateGenericNot">
                            <predicate type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                                <groups>
                                    <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                </groups>
                            </predicate>
                        </Item>
                    </predicates>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="KillerBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="KillerBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impactsElse>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.ExponentialEffectScaler">
                <base>1.4</base>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.3</factor>
        </Item>
    </effects>
    <duration>6000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>