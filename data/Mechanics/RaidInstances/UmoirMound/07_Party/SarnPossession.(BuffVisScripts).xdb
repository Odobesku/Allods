<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>InSequence</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>specialSitGround</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
						<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/Demonl_TargetLock.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<lockScale>false</lockScale>
								<locator>Slot_Global</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
