<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>specialCast02</PreCastAnimation>
			<CastAnimation>invalid</CastAnimation>
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<FixPointCaster>false</FixPointCaster>
			<FixPointTarget>true</FixPointTarget>
			<LocatorNameOnCaster />
			<LocatorNameOnTargets />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<FxOnHands />
			<HitPostFXOnTargets />
			<FXOnCaster />
			<FXOnTargets />
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item var="PreCastAnimation" />
				</animations>
				<advanced>
					<speed>0.65</speed>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects />
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PocketSpellDisease01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>1.2</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_Head</locator>
						<offendTime />
					</Item>
					<Item skiped="" />
					<Item>
						<delay>1250</delay>
						<effectFx href="/Spells/FX/Mobs/MindFlayerDCPsionic_Sphere_Create.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>0.321</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_BodyFX</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
