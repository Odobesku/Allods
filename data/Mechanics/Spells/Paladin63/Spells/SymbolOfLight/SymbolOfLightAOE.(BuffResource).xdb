<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>206639</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="SymbolOfLightAOE.(BuffResource).Name.txt" />
    <Description href="SymbolOfLightAOE.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Paladin/LightInfusionUpgrade.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/Paladin63_SymbolOfLight.(VisObjectTemplate).xdb" />
            <lockScale>true</lockScale>
            <fadeInTime>500</fadeInTime>
            <fadeOutTime>500</fadeOutTime>
            <ignoreParentRotation>true</ignoreParentRotation>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>15</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>HOLY</element>
                            <forceAE>true</forceAE>
                            <damage>1</damage>
                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                            <externalCalcer hrefvar="externalCalcer" />
                                        </mulCalcer>
                                    </Item>
                                </scalers>
                            </scaler>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.CreatureFilter" />
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                    <mark href="SymbolOfLightSelfFinishImpact.(MarkResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>3000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="SymbolOfLightAOE01.(BuffResource).xdb" />
        <Item href="SymbolOfLightAOE02.(BuffResource).xdb" />
        <Item href="SymbolOfLightAOE03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>