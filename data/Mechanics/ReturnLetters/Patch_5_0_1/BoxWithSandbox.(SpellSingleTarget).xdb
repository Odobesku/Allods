<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739878303</resourceId>
	</Header>
	<Name href="BoxWithSandbox.(SpellSingleTarget).Name.txt" />
	<Description href="BoxWithSandbox.(SpellSingleTarget).Description.txt" />
	<visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>3000</prepareDuration>
	<targetType>STTSelf</targetType>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>30000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
				<minLevel type="gameMechanics.formulas.IntConstantValue">
					<value>60</value>
				</minLevel>
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactStartQuiz">
				<question href="BoxWithSandbox.(Question).xdb#xpointer(/gameMechanics.world.quiz.Question)" />
				<participants type="gameMechanics.elements.addresseeFinders.AddressesCalcerSingle">
					<calcer type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
				</participants>
				<resultsHandler type="gameMechanics.elements.common.SingleResultHandler">
					<impactsOnSuccess>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
									<lhs type="gameMechanics.elements.calcers.CalcerLongParam">
										<paramName>choice</paramName>
									</lhs>
									<rhs type="gameMechanics.elements.calcers.LongData">
										<value>0</value>
									</rhs>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.resources.ResourceItem">
											<item href="BoxWithSandbox.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactGiveItem">
											<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
												<item href="HGSand01_OverLimit.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
											</item>
											<binding>ForceBind</binding>
											<count>32</count>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
											<item href="BoxWithSandbox.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
										</Item>
									</impactsIf>
								</Item>
							</impactsIf>
						</Item>
					</impactsOnSuccess>
				</resultsHandler>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
