<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739931911</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Spell00.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/FearOfDeath.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Stalker/Instinct.(SpellVisScripts).xdb" />
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration var="cooldown" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateHasDamageInDelayedBarrier" />
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Stalker63/Abilities/MaterielResource/MaterielResource.(VariableResource).xdb" />
                <sub>4</sub>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactModifyDelayedBarrier">
                        <selector>MaxDamage</selector>
                        <multiplier type="gameMechanics.elements.calcers.FloatData">
                            <value>0</value>
                        </multiplier>
                        <scaledByDamage>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="InstinctImpactsScaled.(MarkResource).xdb" />
                            </Item>
                        </scaledByDamage>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>