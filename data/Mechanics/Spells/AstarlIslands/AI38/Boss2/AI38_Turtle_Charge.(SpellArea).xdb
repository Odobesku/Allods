<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739951500</resourceId>
	</Header>
	<element>ACID</element>
	<Name href="AI38_Turtle_Charge.(SpellArea).Name.txt" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>50</value>
	</range>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>12000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="AI38_Turtle_SpellStopCharge02.(BuffResource).xdb" />
				</predicate>
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
				<projectileData>
					<moveType type="gameMechanics.world.projectile.MoveTypeDestination">
						<to type="gameMechanics.elements.calcers.DestinationSpellTargetThrust">
							<maxDist>40</maxDist>
						</to>
					</moveType>
					<resource href="AI38_Turtle_Charge.(ProjectileResource).xdb" />
				</projectileData>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
				<spell href="AI38_Turtle_Charge02.(SpellSingleTarget).xdb" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
				<affectGroup>Enemies</affectGroup>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
						<projectileData>
							<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
								<destination type="gameMechanics.map.destination.DestinationModified">
									<destination type="gameMechanics.map.destination.SelfPosDestination" />
									<modifiers>
										<Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
											<alternatives>
												<Item type="gameMechanics.map.destination.modifier.SpreadModifier">
													<verticalRange min="0" max="0" />
													<horizontalRange min="5" max="15" />
												</Item>
											</alternatives>
											<safetyRadius>0.05</safetyRadius>
										</Item>
										<Item type="gameMechanics.map.destination.modifier.ModifierTraceNear" />
									</modifiers>
								</destination>
							</moveType>
							<resource href="AI38_Turtle_SpellStopCharge.(ProjectileResource).xdb" />
						</projectileData>
					</Item>
				</impacts>
				<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
								</Item>
							</predicates>
						</Item>
					</predicates>
				</filter>
			</Item>
		</casterImpacts>
	</mechanics>
	<speed>1</speed>
	<radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
