<?xml version="1.0" encoding="UTF-8" ?>
<basement.server.config.ShardExtraParams>
	<Header>
		<resourceId>295620609</resourceId>
	</Header>
	<build>FinalRelease</build>
	<levelCap>70</levelCap>
	<monetization>F2P</monetization>
	<contentPack>Base</contentPack>
	<commonContentPack>Common</commonContentPack>
	<msgPublisherLock>false</msgPublisherLock>
	<abonentsCounter>true</abonentsCounter>
	<abonentsCounterPeriod>60000</abonentsCounterPeriod>
	<disableMatchMaking>false</disableMatchMaking>
	<allowDiffFactions>false</allowDiffFactions>
	<forbiddenFactions />
	<forbiddenRaces />
	<forbiddenClasses />
	<denyRuleSchedule>false</denyRuleSchedule>
	<luckyTimeSchedulingEnabled>false</luckyTimeSchedulingEnabled>
	<currencyExchange enabled="true">
		<tunnel type="basement.server.config.tunnels.DynamicDailyTunnel">
			<percent>0.3</percent>
		</tunnel>
	</currencyExchange>
	<scheduleGC>true</scheduleGC>
	<maxCleanupTime>600000</maxCleanupTime>
	<enableClientNetStats>false</enableClientNetStats>
	<multithreadItemService>true</multithreadItemService>
	<summonLifetimeAssert>0</summonLifetimeAssert>
	<lags>
		<Item>
			<name>client</name>
			<lag>10</lag>
			<!-- 40 -->
			<dispersion>0</dispersion>
			<!-- 15 -->
		</Item>
		<Item>
			<name>intershard</name>
			<lag>0</lag>
			<!-- 10 -->
			<dispersion>0</dispersion>
			<!-- 0 -->
		</Item>
	</lags>
	<netParams>
		<reconnectionTimeout>10</reconnectionTimeout>
	</netParams>
	<avatarAlarmSize>1048576</avatarAlarmSize>
</basement.server.config.ShardExtraParams>
