<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>207991</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Buff.(BuffResource).Name.txt" />
    <Description href="Buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/IceStorm.(UISingleTexture).xdb" />
    <visScript href="/Spells/BuffVisScripts/DotIce.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.MagicDoT">
                <parameters>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </scalerTarget>
                    <tickLength>1000</tickLength>
                    <damagePerTick>1</damagePerTick>
                    <affectOnStartTick>true</affectOnStartTick>
                    <impactsPerTick>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Slowness/Slowness.(BuffResource).xdb" />
                        </Item>
                    </impactsPerTick>
                    <affectedByDoubleAttack>true</affectedByDoubleAttack>
                </parameters>
                <element>COLD</element>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </effect>
            <ticksCount>5</ticksCount>
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/IceSpells.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>