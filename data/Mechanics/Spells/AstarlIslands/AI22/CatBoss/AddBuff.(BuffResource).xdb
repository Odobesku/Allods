<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739973123</resourceId>
    </Header>
    <Name href="AddBuff.(BuffResource).Name.txt" />
    <Description href="AddBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/MountCatNewYear.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                    <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>1</coeff>
                    </scaler>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>0.25</coeff>
                    </scaler>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <duration>20000</duration>
    <stackLimit>10</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>