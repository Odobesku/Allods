<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>run2HL</Item>
				</animations>
				<advanced>
					<speed>1</speed>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/MountOrc_RunChargeFakeDust.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAnimations>
							<mode>CLAMP</mode>
						</effectAnimations>
					</Item>
				</visualEffects>
			</Item>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>spells/Warrior/WarriorCharge</name>
				</sound>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
