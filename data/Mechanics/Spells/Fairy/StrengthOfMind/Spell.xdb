    <descVars>
        <Item>
            <name>necr1</name>
            <text href="Spell.Text.txt" />
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                    <characterClass href="/Mechanics/Classes/Necromancer.xdb" />
                </condition>
            </scaler>
        </Item>
        <Item>
            <name>middle_spell</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.ScalerIf">
                <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                    <characterClass href="/Mechanics/Classes/Necromancer.xdb" />
                </condition>
                <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier var="summand_necro_blood" />
                </scalerIf>
                <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                    <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                        <characterClass href="/Mechanics/Classes/Psionic.xdb" />
                    </condition>
                    <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier var="summand_psi_stress" />
                    </scalerIf>
                    <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                        <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                            <characterClass href="/Mechanics/Classes/Bard.xdb" />
                        </condition>
                        <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier var="summand_bard_drive" />
                        </scalerIf>
                        <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                            <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                <characterClass href="/Mechanics/Classes/Druid.xdb" />
                            </condition>
                            <scalerIf type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier var="druid_mana_factor" />
                                    </Item>
                                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>100</multiplier>
                                    </Item>
                                </scalers>
                            </scalerIf>
                            <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                    <characterClass href="/Mechanics/Classes/Engineer.xdb" />
                                </condition>
                                <scalerIf type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                    <scalers>
                                        <Item type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>-100</multiplier>
                                        </Item>
                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="gameMechanics.elements.calcers.FloatData">
                                                <value var="engineer_cd_factor" />
                                            </mulCalcer>
                                            <sum>-1</sum>
                                        </Item>
                                    </scalers>
                                </scalerIf>
                                <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                    <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                        <characterClass href="/Mechanics/Classes/Mage.xdb" />
                                    </condition>
                                    <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier var="summand_mage_elem" />
                                    </scalerIf>
                                    <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                        <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                            <characterClass href="/Mechanics/Classes/Paladin.xdb" />
                                        </condition>
                                        <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier var="summand_paladin_canon" />
                                        </scalerIf>
                                        <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                            <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                                <characterClass href="/Mechanics/Classes/Priest.xdb" />
                                            </condition>
                                            <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier var="summand_priest_zeal" />
                                            </scalerIf>
                                            <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                                <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                                    <characterClass href="/Mechanics/Classes/Stalker.xdb" />
                                                </condition>
                                                <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier var="summand_stalk_materiel" />
                                                </scalerIf>
                                                <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                                    <condition type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                                        <characterClass href="/Mechanics/Classes/Warrior.xdb" />
                                                    </condition>
                                                    <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier var="summand_warrior_int" />
                                                    </scalerIf>
                                                    <scalerElse type="gameMechanics.elements.scalers.TrivialScaler" />
                                                </scalerElse>
                                            </scalerElse>
                                        </scalerElse>
                                    </scalerElse>
                                </scalerElse>
                            </scalerElse>
                        </scalerElse>
                    </scalerElse>
                </scalerElse>
            </scaler>
