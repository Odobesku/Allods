<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>readySpell</PreCastAnimation>
			<CastAnimation>spellCastDirected</CastAnimation>
			<FxOnHands>/Spells/FX/Mobs/Jaga_ReadySpell_Shadow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<LocatorNameOnCaster>Staff_Vine_00</LocatorNameOnCaster>
			<LocatorOnCaster>FROM_LOCATOR_NAME</LocatorOnCaster>
			<FXOnCaster>/Spells/FX/Mobs/Jaga_DirectCast_Shadow.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item skiped="" />
					<Item skiped="" />
					<Item>
						<effectFx href="" />
						<scale>2</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item />
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
