<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Spells/AOEAura_Astral_4m.(VisObjectTemplate).xdb" />
						<useCastPoint>true</useCastPoint>
						<lifeTime>2</lifeTime>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Spells/AstralComet_Respawn.(VisObjectTemplate).xdb" />
				<useCastPoint>true</useCastPoint>
				<lifeTime>0.7</lifeTime>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
