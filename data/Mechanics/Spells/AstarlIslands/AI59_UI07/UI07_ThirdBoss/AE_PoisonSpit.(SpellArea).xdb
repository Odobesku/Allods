<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739864153</resourceId>
    </Header>
    <element>POISON</element>
    <Name href="AE_PoisonSpit.(SpellArea).Name.txt" />
    <visualScripts href="PoisonSpit.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <stage>Start</stage>
            <duration>15000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="PoisonCloud.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="PoisonCloud.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                <spell href="PoisonCloud.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <duration>16000</duration>
                <scaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>1</multiplier>
                </scaler>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                    <resource href="Aoe.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                </projectileData>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>15</speed>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <shapeOrientation type="gameMechanics.elements.common.ShapeOrientationYawAndPitch" />
    <radius>40</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>