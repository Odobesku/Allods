	<prepareDuration>4000</prepareDuration>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>25000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
