<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.mount.MountSkin>
	<Header>
		<resourceId>740006988</resourceId>
	</Header>
	<Description href="ExoMount03HeroesArena.(MountSkin).Description.txt" />
	<Name href="ExoMount03HeroesArena.(MountSkin).Name.txt" />
	<SourceDescription href="ExoMount03HeroesArena.(MountSkin).SourceDescription.txt" />
	<image href="/Interface/Icons/Mounts/MountExoskeletV3HA.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<unlock href="ExoMount03HeroesArena.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
	<visualMount href="/Client/VisualMounts/Exoskeleton/Exoskeleton03HA.(VisualMount).xdb#xpointer(/VisualMount)" />
	<visualScript type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureChangeVisItemsAction">
				<items>
					<Item>
						<newItem href="/Items/VisualItems/Cloak/Bag_Plate_E_82ExoskeletonV3HA.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						<slot>EARRING2</slot>
					</Item>
				</items>
				<isGfxCondition>false</isGfxCondition>
				<leaveWeapons>true</leaveWeapons>
				<notForDolls>true</notForDolls>
				<removeAllItems>false</removeAllItems>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<playWhile type="client.SLON.PredicateExoVisualAllowedAction">
			<checkType>ALL</checkType>
			<checkIsNotSet>false</checkIsNotSet>
		</playWhile>
		<preconditional>true</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</visualScript>
	<p2p>true</p2p>
</gameMechanics.constructor.schemes.mount.MountSkin>