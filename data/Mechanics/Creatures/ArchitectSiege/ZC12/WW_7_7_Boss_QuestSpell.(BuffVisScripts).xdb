<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/CloudMind.(UserPostEffect).xdb" />
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>CLAMP</mode>
						<animations>
							<Item>knockdownStart</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>knockdownLoop</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>