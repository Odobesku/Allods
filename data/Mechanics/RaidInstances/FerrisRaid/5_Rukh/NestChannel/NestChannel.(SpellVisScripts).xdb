<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/DemonCrabBoss_ReadySpellDirectDown.(VisObjectTemplate).xdb" />
						<scale>2.3</scale>
						<offset z="0.3" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>idle</Item>
				</animations>
				<advanced>
					<speed>2</speed>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting />
	<actionBarComplite type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/JagaAdd_DeathExplosion.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarComplite>
	<actionBarCancel type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/JagaAdd_DeathExplosion.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarCancel>
	<launch />
</SpellVisScripts>
