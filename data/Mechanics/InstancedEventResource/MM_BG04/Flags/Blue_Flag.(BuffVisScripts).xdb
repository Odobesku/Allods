	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureSetOvertipAction">
				<overtip href="/Interface/Ingame/ContextRelatedTextures/OvertipMarks/MarkBlueFlag.(UITexture).xdb#xpointer(/UITexture)" />
