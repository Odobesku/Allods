<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>ready</Item>
                    <Item>ready</Item>
                    <Item>battleRoar</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect01Down.(VisObjectTemplate).xdb" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Mobs/Champions_BattleRoarCleave.(VisObjectTemplate).xdb" />
                <fixPoint>true</fixPoint>
                <lockScale>true</lockScale>
                <scale>0.3</scale>
            </Item>
        </visualEffects>
    </launch>
</SpellVisScripts>