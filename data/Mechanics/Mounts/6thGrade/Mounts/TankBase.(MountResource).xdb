<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.mount.MountResource>
    <Header>
        <resourceId>739868952</resourceId>
        <Prototype href="/Mechanics/Mounts/Prototypes/NormalBattleMount.(MountResource).xdb#xpointer(/gameMechanics.constructor.schemes.mount.MountResource)" />
    </Header>
    <Name href="TankBase.(MountResource).Name.txt" />
    <grade>6</grade>
    <mechanics>
        <speed>1.5</speed>
        <speedDelta>0.01</speedDelta>
        <health>2</health>
        <healthDelta>0.05</healthDelta>
        <regen>0.3</regen>
        <prepareDuration>900</prepareDuration>
        <prepareDurationDelta>30</prepareDurationDelta>
    </mechanics>
    <contextActions>
        <Item href="/Mechanics/Spells/Mounts/Tank/Energize.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
    </contextActions>
    <ridingEffects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/Mounts/Tank/PenetrationMode.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Mounts/Tank/PassiveEnergyForAntiCrowdControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/CommonBuffs/Immunity/CrowdControlImmunity_duration1Sec.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <durationScaler type="gameMechanics.elements.scalers.ScalerBuff">
                                        <buff href="/Mechanics/Spells/Mounts/Tank/PassiveEnergyForAntiCrowdControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <summand>0</summand>
                                    </durationScaler>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/Spells/Mounts/Tank/PassiveEnergyForAntiCrowdControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.CastOnMove">
            <spells>
                <Item href="/Mechanics/Spells/Mounts/Tank/Penetration/DamageRayClose.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <Item href="/Mechanics/Spells/Mounts/Tank/Defence/DamageRayFar.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <Item href="/Mechanics/Spells/Mounts/Tank/Defence/AESilence.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            </spells>
            <moveTypes>
                <Item>Step</Item>
                <Item>Teleport</Item>
                <Item>Fall</Item>
                <Item>Pilot</Item>
            </moveTypes>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSwimTrigger">
            <impactsOnStartSwim>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/Mounts/Tank/SwimSpeed.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOnStartSwim>
            <impactsOnStopSwim>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/Spells/Mounts/Tank/SwimSpeed.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOnStopSwim>
        </Item>
    </ridingEffects>
    <basicSkin href="/Mechanics/Mounts/Skins/BattleMounts/TankBase.(MountSkin).xdb#xpointer(/gameMechanics.constructor.schemes.mount.MountSkin)" />
    <alternativeSkins href="/Mechanics/Mounts/Skins/BattleMounts/Moloch.(SkinListResource).xdb#xpointer(/gameMechanics.constructor.schemes.mount.SkinListResource)" />
    <penaltyCalcer type="gameMechanics.elements.calcers.OverLevelPenaltyCalcer">
