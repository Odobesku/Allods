<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="CreatureAnimationAction">
			<mode>LOOP</mode>
			<animations>
				<Item>ready</Item>
			</animations>
			<channel>CHANNEL_KNOCKDOWN</channel>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect02Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
				<stopOnDeath>true</stopOnDeath>
			</Item>
		</elements>
		<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
	</wholeCasting>
	<launch type="CreatureAnimationAction">
		<animations>
			<Item>specialAttack01</Item>
		</animations>
		<channel>CHANNEL_KNOCKDOWN</channel>
	</launch>
</SpellVisScripts>
