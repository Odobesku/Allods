<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobProjectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <PreCastAnimation>readySpell</PreCastAnimation>
            <FXProjectile>/Spells/FX/Mobs/Turret02_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
            <AnimationPreCastMode>LOOP</AnimationPreCastMode>
            <LocatorOnTargets>Slot_FX</LocatorOnTargets>
            <LocatorNameOnCaster>Slot_Special01</LocatorNameOnCaster>
            <FXProjectileHit>/Spells/FX/Spells/TrueForm_ChainLightningHit_02.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
            <ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
            <HitPostFXOnTargets />
            <LocatorOnCaster>FROM_LOCATOR_NAME</LocatorOnCaster>
        </Variables>
    </Header>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item skiped="" />
                </animations>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>200</delay>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectAstralWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_Hand_R</locator>
                    </Item>
                    <Item>
                        <delay>200</delay>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectAstralWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_Hand_L</locator>
                    </Item>
                    <Item>
                        <delay>1500</delay>
                        <effectFx href="/Spells/FX/Spells/TrueForm_ChainLightningHit_02.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.5</scale>
                        <fadeInTime>500</fadeInTime>
                        <fadeOutTime>500</fadeOutTime>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                    <Item>
                        <delay>1600</delay>
                        <effectFx href="/Spells/FX/Spells/TrueForm_ChainLightningHit_02.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.55</scale>
                        <fadeInTime>500</fadeInTime>
                        <fadeOutTime>500</fadeOutTime>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                    <Item>
                        <delay>1700</delay>
                        <effectFx href="/Spells/FX/Spells/TrueForm_ChainLightningHit_02.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.6</scale>
                        <fadeInTime>500</fadeInTime>
                        <fadeOutTime>500</fadeOutTime>
                        <locator>FROM_LOCATOR_NAME</locator>
                        <locatorName>Slot_Special01</locatorName>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <elements>
            <Item skiped="" />
            <Item type="VisActionList">
                <elements>
                    <Item skiped="" />
                    <Item type="VisActionList">
                        <elements>
                            <Item skiped="" />
                            <Item type="CreatureProjectileAction">
                                <projectileFx hrefvar="FXProjectile" />
                            </Item>
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>