<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
	<Header>
		<resourceId>739949643</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
					<quest href="WW_11_4.xdb" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
			<impactsOnEnter>
				<Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
					<destination type="gameMechanics.map.destination.RelativePos" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="ZC12_Alina_Assistant.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="ZC12_Alina_Assistant_mark.(BuffResource).xdb" />
						</Item>
					</impacts>
					<assistantResource href="ZC12_Alina_Assistant.(AssistantResource).xdb" />
					<mobResource href="/Characters/Hadagan_female/Instances/ZC12_Map02/ZC12_Alina_Assistant.(MobWorld).xdb" />
				</Item>
			</impactsOnEnter>
			<impactsOnLeave>
				<Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
					<assistantResource href="ZC12_Alina_Assistant.(AssistantResource).xdb" />
				</Item>
			</impactsOnLeave>
			<timeout>900000</timeout>
			<activeZone href="/Maps/ZC12_Map02/Zones/ZC12_Zone_08.(ZoneResource).xdb" />
			<checkTopLevelZonesOnly>false</checkTopLevelZonesOnly>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
					<quest href="WW_11_4.xdb" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
					<assistantResource href="ZC12_Alina_Assistant.(AssistantResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ZC12_Alina_Assistant.(BuffResource).xdb" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectForkEnemies" />
	</effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
