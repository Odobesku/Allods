<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>314063</resourceId>
    </Header>
    <visualScript type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Spells/General_Mage_02.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <fadeInTime>1000</fadeInTime>
                <fadeOutTime>1000</fadeOutTime>
                <member>Group</member>
                <locatorName>Slot_BodyFX</locatorName>
            </Item>
        </visualEffects>
        <stopOnDeath>true</stopOnDeath>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.8</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="U_6_05_ability.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.Aura">
            <radius>20</radius>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="/Creatures/UmoirToad/Instances/Umoir/UmoirToadDistorted.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                <Item href="/Characters/Kania_male/Instances/Umoir/Umoir_Druid_distorted.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                <Item href="/Creatures/UmoirDeer/Instances/Umoir/UmoirDeerDistorted.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="U_6_05_ability.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>1000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
            </onLeave>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>