<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="Sound3DAction">
                <sound>
                    <project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
                    <name>spells/Warrior/WarriorCleavage</name>
                </sound>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ShieldProtection_Damage.(VisObjectTemplate).xdb" />
                        <locator>Slot_TopFX</locator>
                    </Item>
                    <Item>
                        <delay>900</delay>
                        <effectFx href="/Spells/FX/Mobs/GolemRed_Spark.(VisObjectTemplate).xdb" />
                        <scale>0.35</scale>
                        <fadeInTime>200</fadeInTime>
                        <fadeOutTime>200</fadeOutTime>
                        <locator>Slot_Global</locator>
                        <offset z="-0.125" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </action>
</BuffVisScripts>