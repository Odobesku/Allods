<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>208207</resourceId>
    </Header>
    <visualScript type="VisActionChangeVisObject">
        <newVisMob href="/Creatures/HG_InvisibileMob/HG_InvisibileMob.(VisualMob).xdb" />
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="RiftDungeon1_InvisibleMob.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                    <ability href="RiftDungeon1_InvisibleMob.(AbilityResource).xdb" />
                </Item>
            </onEnter>
        </Item>
    </effects>
    <disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>