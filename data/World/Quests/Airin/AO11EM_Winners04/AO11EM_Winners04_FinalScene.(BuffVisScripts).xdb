<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.Sound2DAction">
        <actionType>Simple</actionType>
        <musicSourceMaxRadius>0</musicSourceMaxRadius>
        <reverbPreset />
        <sound>
          <name>Ambience/OutdoorAmbience/Zones/Goblinoball</name>
          <project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
        </sound>
        <forcedSoundStop>false</forcedSoundStop>
        <onlyForMainAvatar>true</onlyForMainAvatar>
        <resetGlobalParamsOnStop>true</resetGlobalParamsOnStop>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>