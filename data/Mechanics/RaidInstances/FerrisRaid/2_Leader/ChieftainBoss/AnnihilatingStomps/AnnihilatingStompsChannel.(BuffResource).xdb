<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222453</resourceId>
    </Header>
    <Name href="AnnihilatingStompsChannel.(BuffResource).Name.txt" />
    <Description href="AnnihilatingStompsChannel.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Mobparts/HoofCommon.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="AnnihilatingStompsChannelAmplification.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Horn/ConjureFood/FoodPool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/FoodPile/Buff_FoodCarrier.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="AnnihilatingStompsChannelAmplification.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                </moveType>
                                <resource href="StompFX.(ProjectileResource).xdb" />
                            </projectileData>
                            <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                </Item>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="StompVisual.(ClientData).xdb" />
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                    <initialDelay>250</initialDelay>
                </Item>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                            <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                                <range min="0" max="1" />
                                                <withinRange>false</withinRange>
                                                <minCandidatesCount>64</minCandidatesCount>
                                                <targetCount>64</targetCount>
                                            </selector>
                                            <filter type="gameMechanics.constructor.basicElements.FilterOr">
                                                <filters>
                                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                                    <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                        <predicates>
                                                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                                <mobs>
                                                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChampionMelee/ChampionMelee.(MobWorld).xdb" />
                                                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChampionRange/ChampionRange.(MobWorld).xdb" />
                                                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChampionShaman/ChampionShaman.(MobWorld).xdb" />
                                                                </mobs>
                                                            </Item>
                                                        </predicates>
                                                    </Item>
                                                </filters>
                                            </filter>
                                            <impacts>
                                                <Item>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                            <element>COLD</element>
                                                            <damage>4</damage>
                                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                    <initialDelay>600</initialDelay>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>15000</duration>
    <stackLimit>10</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>