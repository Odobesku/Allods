<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>739835566</resourceId>
    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
            <radius>5</radius>
            <affectGroup>Enemies</affectGroup>
            <affectHolder>false</affectHolder>
            <impacts>
                <Item type="gameMechanics.elements.impacts.PureDamage">
                    <damage>1</damage>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.1</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Echo.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impacts>
            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                <filters>
                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                    <Item type="gameMechanics.world.creature.AliveFilter" />
                </filters>
            </filter>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
            <data href="Clamp.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>