<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.ship.ShipResource>
	<Header>
		<resourceId>30343206</resourceId>
	</Header>
	<persistentParts>
		<Item type="gameMechanics.elements.bunchparts.BunchAddPlane">
			<plane href="Ktulha.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
		</Item>
		<Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
			<effects>
				<Item type="gameMechanics.world.ship.elements.effects.EffectPassengerChangeTrigger">
					<impactsOnIn>
						<Item type="gameMechanics.constructor.basicElements.ImpactList">
							<impactsResource href="Ambience/ImpactsOn.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
						</Item>
					</impactsOnIn>
					<impactsOnOut>
						<Item type="gameMechanics.constructor.basicElements.ImpactList">
							<impactsResource href="Ambience/ImpactsOff.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
						</Item>
					</impactsOnOut>
				</Item>
			</effects>
			<reattachOnTeleport>false</reattachOnTeleport>
		</Item>
	</persistentParts>
	<visualShips>
		<Item>
			<equipmentList href="Ktulha.(EquipmentList).xdb#xpointer(/gameMechanics.world.ship.device.EquipmentList)" />
			<visualShip href="/Creatures/AstralCtulhu/AstralCtulhu.(VisualShip).xdb#xpointer(/gameMechanics.world.ship.VisualShip)" />
		</Item>
	</visualShips>
</gameMechanics.world.ship.ShipResource>
