<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
	<Header>
		<resourceId>739922986</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
					<quest href="WW_Prologue_8.xdb" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
			<impactsOnLeave>
				<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
					<quest href="WW_Prologue_8.xdb" />
				</Item>
			</impactsOnLeave>
			<activeZone href="/Maps/Inst_ZoneContested12_Start/Zones/Inst_ZoneContested12_Start/Inst_ZoneContested12_Start.(ZoneResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.QuestCounterTrigger">
			<quest href="WW_Prologue_8.xdb" />
			<counterId href="Counter2.(QuestCountId).xdb" />
			<condition type="constructor.elements.LongEquals">
				<value>10</value>
			</condition>
			<impacts>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="SummonFlyers.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Runners.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="DeathCount.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
					<table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_Prologue_8_Radovid.(SpawnTable).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
					<table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_Prologue_9_DemonHuntersStaying.(SpawnTable).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateFaction">
							<faction href="/World/Factions/Empire.xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
							<table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_Prologue_8_Luka.(SpawnTable).xdb" />
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
							<table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_Prologue_8_Ilya.(SpawnTable).xdb" />
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
					<data href="Quest_completed.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
					<table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_Prologue_11_Ogre.(SpawnTable).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>7000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
							<pool href="Flyers.(SummonPool).xdb" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
