					<impactsOnHitTarget>
						<Item type="gameMechanics.elements.impacts.MarkedImpact">
							<mark href="/Mechanics/Spells/Marks/MageIceCometAEHit.xdb#xpointer(/gameMechanics.constructor.basicElements.MarkResource)" />
						</Item>
					</impactsOnHitTarget>
