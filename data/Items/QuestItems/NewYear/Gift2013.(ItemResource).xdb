<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>357853197</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Event/Present.(UISingleTexture).xdb" />
	<source>Vendor</source>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<useAmount>-1</useAmount>
		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
						<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="NewYearCoupon.(ItemResource).xdb" />
						</item>
						<binding>Transfer</binding>
					</Item>
					<Item type="itemService.avatar.itemBag.RepeatStackTakeAction">
						<actions>
							<Item type="itemService.avatar.itemBag.RandomTakeAction">
								<entries>
									<Item>
										<actions>
											<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
												<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
													<item href="IceStatueTrinket.(ItemResource).xdb" />
												</item>
												<binding>Transfer</binding>
											</Item>
										</actions>
										<chance>0.2</chance>
									</Item>
									<Item>
										<actions>
											<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
												<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
													<item href="Trash/NY_TrashCandy.xdb" />
												</item>
												<binding>Transfer</binding>
											</Item>
										</actions>
									</Item>
									<Item>
										<actions>
											<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
												<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
													<item href="Trash/NY_TrashChampagne.xdb" />
												</item>
												<binding>Transfer</binding>
											</Item>
										</actions>
									</Item>
									<Item>
										<actions>
											<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
												<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
													<item href="Trash/NY_TrashMandarins.xdb" />
												</item>
												<binding>Transfer</binding>
											</Item>
										</actions>
									</Item>
									<Item>
										<actions>
											<Item type="itemService.avatar.itemBag.RepeatStackTakeAction">
												<actions>
													<Item type="itemService.elements.components.ItemTakeActionImpacts">
														<impacts>
															<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
																<predicates>
																	<Item type="gameMechanics.constructor.basicElements.PredicateOr">
																		<predicates>
																			<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
																				<rule href="/Mechanics/Rules/NewYearEvent/Rule.xdb" />
																			</Item>
																			<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
																				<rule href="/Mechanics/Rules/WinterEvent/WinterEvent.(RuleResource).xdb" />
																			</Item>
																			<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
																				<rule href="/Mechanics/Rules/NewYearEvent/Region/Bras_Japan_Phil/Rule.xdb" />
																			</Item>
																			<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
																				<rule href="/Mechanics/Rules/NewYearEvent/Region/China/Rule.xdb" />
																			</Item>
																			<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
																				<rule href="/Mechanics/Rules/NewYearEvent/Region/Indonesia/Rule.xdb" />
																			</Item>
																			<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
																				<rule href="/Mechanics/Rules/NewYearEvent/Region/Korea/Korea.(RuleResource).xdb" />
																			</Item>
																		</predicates>
																	</Item>
																	<Item type="gameMechanics.constructor.basicElements.PredicateNot">
																		<predicate type="gameMechanics.elements.resources.ResourceBuff">
																			<buff href="/Mechanics/Spells/Events/NewYear/GreedSanta/Buff01.xdb" />
																		</predicate>
																	</Item>
																</predicates>
																<impacts>
																	<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																		<buff href="/Mechanics/Spells/Events/NewYear/GreedSanta/Buff01.xdb" />
																	</Item>
																	<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
																		<distributor type="gameMechanics.elements.calcers.TargetDistributor" />
																		<data href="/Mechanics/Spells/Events/NewYear/GreedSanta/Buff01.(ClientData).xdb" />
																	</Item>
																</impacts>
															</Item>
														</impacts>
													</Item>
												</actions>
											</Item>
										</actions>
										<chance>0.8</chance>
									</Item>
								</entries>
							</Item>
						</actions>
					</Item>
				</actions>
				<consumeItems>1</consumeItems>
			</Item>
		</usages>
		<predicates>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
						<minLevel type="gameMechanics.formulas.IntConstantValue">
							<value>20</value>
						</minLevel>
					</Item>
					<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
								<key href="/System/ContentKeys/IM_Steam.(ContentKey).xdb" />
							</Item>
							<Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
								<minLevel type="gameMechanics.formulas.IntConstantValue">
									<value>5</value>
								</minLevel>
							</Item>
						</predicates>
					</Item>
				</predicates>
			</Item>
		</predicates>
		<useStack>true</useStack>
	</functionalPart>
	<requiredLevel>1</requiredLevel>
	<stackLimit>100</stackLimit>
	<quality href="/Mechanics/ItemQualities/Goods.xdb" />
	<prices type="gameMechanics.constructor.schemes.item.prices.AltCurrenciesItem">
		<currencies>
			<Item>
				<currency href="/Mechanics/AlternativeCurrencies/Events/SilverCoin.xdb" />
			</Item>
		</currencies>
	</prices>
	<name href="Gift2013.(ItemResource).Name.txt" />
	<description href="Gift2013.(ItemResource).Description.txt" />
	<category href="/Mechanics/ItemCategories/Misc/Holiday.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>
