	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<playWhile type="VisActionDelay">
					<time>3000</time>
				</playWhile>
				<elements>
					<Item type="PostEffectVisAction">
						<userPostEffect href="/Spells/FX/InterfaceFX/Black_Long.(UserPostEffect).xdb" />
					</Item>
				</elements>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>knockdownLoop</Item>
				</animations>
			</Item>
		</elements>
	</action>
</BuffVisScripts>