<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739925278</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="GuiltMoreDamage.(AbilityResource).Name.txt" />
	<description href="GuiltMoreDamage.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>damage</name>
			<value var="damage" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>MagicScaler</formula>
			</scaler>
		</Item>
		<Item>
			<name>damage2</name>
			<value var="damage2" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>MagicScaler</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Paladin/PaladinCourage.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.SpellExtraImpacts">
			<targetImpacts>
				<Item type="gameMechanics.elements.impacts.ImpactsIf">
					<predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
						<buff href="/Mechanics/Spells/Paladin63/Spells/Anathema/AnathemaDot03.(BuffResource).xdb" />
					</predicate>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>HOLY</element>
							<damage var="damage" />
							<scaler type="gameMechanics.elements.scalers.MagicScaler" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIncrementBuffDuration">
							<buff href="/Mechanics/Spells/Paladin63/Spells/Anathema/AnathemaDot03.(BuffResource).xdb" />
							<casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
							<delta type="gameMechanics.elements.calcers.FloatData">
								<value>-3000</value>
							</delta>
						</Item>
					</impactsIf>
				</Item>
			</targetImpacts>
			<destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
				<spells>
					<Item href="/Mechanics/Spells/Paladin63/Spells/CrusaderHitUpgrade/CrusaderHitUpgrade03.(SpellSingleTarget).xdb" />
					<Item href="/Mechanics/Spells/Paladin63/Spells/CrusaderHit/CrusaderHit03.(SpellSingleTarget).xdb" />
				</spells>
			</destination>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellExtraImpacts">
			<targetImpacts>
				<Item type="gameMechanics.elements.impacts.ImpactsIf">
					<predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
						<buff href="/Mechanics/Spells/Paladin63/Spells/Anathema/AnathemaDot01.(BuffResource).xdb" />
					</predicate>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>HOLY</element>
							<damage var="damage2" />
						</Item>
					</impactsIf>
				</Item>
			</targetImpacts>
			<destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
				<spells>
					<Item href="/Mechanics/Spells/Paladin63/Spells/Anathema/Anathema01.(SpellSingleTarget).xdb" />
				</spells>
			</destination>
		</Item>
	</effects>
	<ranks>
		<Item href="GuiltMoreDamage01.(AbilityResource).xdb" />
		<Item href="GuiltMoreDamage02.(AbilityResource).xdb" />
		<Item href="GuiltMoreDamage03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
