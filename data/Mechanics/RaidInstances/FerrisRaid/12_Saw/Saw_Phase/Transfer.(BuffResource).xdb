<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739905548</resourceId>
    </Header>
    <visScript href="Transfer.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Jump</Item>
                <Item>Move</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Guilty.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>4000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                    <spawn>
                                        <scriptID>12_Speaker_2</scriptID>
                                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                    </spawn>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                    <data href="/Mechanics/RaidInstances/FerrisRaid/Voice/12_Saw/10_TheGame.(ClientData).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>8000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>