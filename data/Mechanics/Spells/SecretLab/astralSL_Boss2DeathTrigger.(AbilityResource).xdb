<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>203441</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.constructor.basicElements.FloatZero" />
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                            <zone href="/Maps/Inst_SecretLab/ScriptZones/astral_SL_Boss2Aggro.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                            <disable>true</disable>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>SL_Boss2Door</scriptID>
                                <map href="/Maps/Inst_SecretLab/astral_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.device.DoorSwitch">
                                    <switchType>Open</switchType>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff />
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>