<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellDirected</Item>
                </animations>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>100</time>
                    </Item>
                    <Item type="CreatureIndependentFxAction">
                        <visObject href="/Spells/FX/Spells/AOEAura_Red.(VisObjectTemplate).xdb" />
                        <useCastPoint>true</useCastPoint>
                        <lifeTime>4</lifeTime>
                    </Item>
                </elements>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureVisActionStartThrow" />
                    <Item type="CreatureProjectileAction">
                        <projectileFx href="/Spells/FX/Mobs/MountChopper_Projectile01.(VisObjectTemplate).xdb" />
                        <explosionFx href="/Spells/FX/Spells/HitManaball.(VisObjectTemplate).xdb" />
                        <theGe>6</theGe>
                        <pointOnCaster type="VisPointLocator">
                            <locator>Slot_Hand_R</locator>
                        </pointOnCaster>
                        <pointOnTarget type="VisPointLocator" />
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>