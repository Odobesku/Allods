<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>194248</resourceId>
    </Header>
    <Name href="Troll_Healing.(BuffResource).Name.txt" />
    <Description href="Troll_Healing.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidNaturalRegeneration.tr.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="Troll_Healing.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.9</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Troll_ControlImmunity.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
                    <radius>10</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                    <resources>
                                        <Item href="Troll_Gas.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                    </resources>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Troll_ControlImmunity.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>1500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                    </predicates>
                    <impacts>
                        <casterToTarget>
                            <Item type="gameMechanics.elements.impacts.DirectHeal">
                                <heal>1</heal>
                                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                        <multiplier>0.03</multiplier>
                                    </mulCalcer>
                                </scalerTarget>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="Troll_Healing.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                        </casterToTarget>
                    </impacts>
                </Item>
            </effects>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>