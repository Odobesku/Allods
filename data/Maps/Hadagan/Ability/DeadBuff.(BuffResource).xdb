<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>48708</resourceId>
    </Header>
    <Name href="DeadBuff.(BuffResource).Name.txt" />
    <Description href="DeadBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestSilence.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Necromancer/FeignDeath.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDoesNotAggro" />
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.ImmunityToHarmfulSpells" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
                <Item type="gameMechanics.elements.impacts.ImpactSetManaToFull" />
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/InstancedEventResource/MM_BG01/Afk_Disabler.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.world.ship.elements.EffectMapChanged">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="DeadBuff.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>5000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>