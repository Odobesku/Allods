<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739923661</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/SpeedBoosts.xdb" />
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
	<element>ASTRAL</element>
	<Name href="Spell0.(SpellArea).Name.txt" />
	<Description href="Spell0.(SpellArea).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>MagicScaler</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Druid/DruidVisitCompanion.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Druid/Teleportation.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>35</value>
	</range>
	<prepareDuration>2000</prepareDuration>
	<targetType>STTPoint</targetType>
	<ranks>
		<Item href="Spell01.(SpellArea).xdb" />
		<Item href="Spell02.(SpellArea).xdb" />
		<Item href="Spell03.(SpellArea).xdb" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<launchWhenReady>true</launchWhenReady>
	<mechanics>
		<cooldown>
			<duration var="cd_duration" />
		</cooldown>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceMana">
				<mana>132</mana>
				<manaType>
					<Item>Mana</Item>
				</manaType>
			</Item>
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
				<projectileData>
					<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
						<destination type="gameMechanics.map.destination.SelfPosDestination" />
					</moveType>
					<lifeLengthCapScaler type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>0.75</multiplier>
					</lifeLengthCapScaler>
					<resource hrefvar="resource" />
				</projectileData>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
				<projectileData>
					<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
						<destination type="gameMechanics.map.destination.SelfPosDestination" />
						<spawnAt>Caster</spawnAt>
					</moveType>
					<resource href="Slowness.(ProjectileResource).xdb" />
				</projectileData>
			</Item>
			<Item type="gameMechanics.elements.impacts.PostponedImpacts">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactTeleport">
						<destination type="gameMechanics.map.destination.DestinationModified">
							<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
							<modifiers>
								<Item type="gameMechanics.map.destination.modifier.ModifierTrailFrom">
									<from type="gameMechanics.map.destination.SelfPosDestination" />
								</Item>
							</modifiers>
						</destination>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<radius>1</radius>
	<pathChecker type="space.pathfinding.pathChecker.PathNotTrivial" />
</gameMechanics.constructor.schemes.spell.area.SpellArea>