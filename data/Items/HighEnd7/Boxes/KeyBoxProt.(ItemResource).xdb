<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739950564</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<image href="/Interface/Icons/Misc/Chests/SkilledItemsBox.(UISingleTexture).xdb" />
	<source>FixedDrop</source>
	<descVars>
		<Item>
			<name>var0</name>
			<text href="KeyBoxProt.(ItemResource).Text.txt" />
			<scaler type="gameMechanics.elements.scalers.IfTextModifier">
				<itemCondition type="gameMechanics.elements.item.ItemPredicateOr">
					<predicates>
						<Item type="gameMechanics.elements.item.ItemPredicateQuality">
							<quality href="/Mechanics/ItemQualities/Common.xdb" />
						</Item>
						<Item type="gameMechanics.elements.item.ItemPredicateQuality">
							<quality href="/Mechanics/ItemQualities/Uncommon.xdb" />
						</Item>
					</predicates>
				</itemCondition>
			</scaler>
		</Item>
		<Item>
			<name>var1</name>
			<text href="KeyBoxProt.(ItemResource).Text02.txt" />
			<scaler type="gameMechanics.elements.scalers.IfTextModifier">
				<itemCondition type="gameMechanics.elements.item.ItemPredicateOr">
					<predicates>
						<Item type="gameMechanics.elements.item.ItemPredicateQuality">
							<quality href="/Mechanics/ItemQualities/Rare.xdb" />
						</Item>
						<Item type="gameMechanics.elements.item.ItemPredicateQuality">
							<quality href="/Mechanics/ItemQualities/Epic.xdb" />
						</Item>
					</predicates>
				</itemCondition>
			</scaler>
		</Item>
		<Item>
			<name>var2</name>
			<text href="KeyBoxProt.(ItemResource).Text03.txt" />
			<scaler type="gameMechanics.elements.scalers.IfTextModifier">
				<itemCondition type="gameMechanics.elements.item.ItemPredicateCategory">
					<category href="/Mechanics/ItemCategories/Misc/Fortified.(ItemCategoryTerminal).xdb" />
				</itemCondition>
			</scaler>
		</Item>
	</descVars>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb" />
	<functionalPart type="itemService.avatar.itemBag.ItemTakeActions">
		<actions>
			<Item type="itemService.avatar.itemBag.RepeatStackTakeAction">
				<actions>
					<Item type="itemService.avatar.itemBag.ItemTakeActionExternal">
						<actionResource hrefvar="actionResource" />
					</Item>
				</actions>
			</Item>
		</actions>
	</functionalPart>
	<level>70</level>
	<requiredLevel>65</requiredLevel>
	<quality hrefvar="quality" />
	<prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
	<ownershipLimit>1</ownershipLimit>
	<binding>BindOnPickup</binding>
	<name href="KeyBoxProt.(ItemResource).Name.txt" />
	<description href="KeyBoxProt.(ItemResource).Description.txt" />
	<category href="/Mechanics/ItemCategories/Misc/Other.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>
