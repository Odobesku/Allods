<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>246231</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                    <destination type="gameMechanics.map.destination.DestinationModified">
                        <destination type="gameMechanics.map.destination.DestinationLocator">
                            <locator>
                                <scriptID>Ferris_start</scriptID>
                                <map href="/Maps/Ferris/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </locator>
                        </destination>
                        <modifiers>
                            <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                <verticalRange min="0" max="1" />
                                <horizontalRange min="0" max="10" />
                            </Item>
                        </modifiers>
                    </destination>
                    <runningMode>true</runningMode>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.DestinationLocator">
                                    <locator>
                                        <scriptID>Ferris_start</scriptID>
                                        <map href="/Maps/Ferris/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                    </locator>
                                </destination>
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                        <verticalRange min="0" max="1" />
                                        <horizontalRange min="0" max="10" />
                                    </Item>
                                </modifiers>
                            </destination>
                            <runningMode>true</runningMode>
                        </Item>
                    </impactsIf>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>