<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>special</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/AI50_Boss01_FireChannel.(VisObjectTemplate).xdb" />
								<lockScale>true</lockScale>
								<scale>1.3</scale>
								<locator>Slot_Global</locator>
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Mobs/AI50_Boss01_FireChannelSlots.(VisObjectTemplate).xdb" />
								<lockScale>true</lockScale>
								<locator>Slot_Global</locator>
							</Item>
						</visualEffects>
						<stopOnDeath>true</stopOnDeath>
					</Item>
				</elements>
				<stopOnDeath>true</stopOnDeath>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb" />
						<scale>4</scale>
						<locator>Slot_Mouth</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureRotateToCastPointAction">
				<immediateTurn>true</immediateTurn>
			</Item>
		</elements>
		<stopOnDeath>true</stopOnDeath>
	</wholeCasting>
</SpellVisScripts>