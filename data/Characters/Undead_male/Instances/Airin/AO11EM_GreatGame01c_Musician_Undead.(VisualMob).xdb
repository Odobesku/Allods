	<transparency>1</transparency>
	<variation>
		<additionalVariation href="/Characters/Undead_male/Variations/UndeadMaleAdditional01.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
		<face href="/Characters/Undead_male/Variations/UndeadMaleFace13.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
		<facial href="/Characters/Undead_male/Variations/UndeadMaleFacial04.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
		<hairColor>-6974059</hairColor>
