<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739923291</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/HealingSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/DruidHoTs.(ActionGroup).xdb" />
    </groups>
    <element>HOLY</element>
    <Name href="Spell0.(SpellSingleTarget).Name.txt" />
    <Description href="Spell0.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer_heal" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>HealScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer_HoT" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>HealScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Quest/ZC6_waterbuff.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Druid/HealingSpring.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <prepareDuration>2500</prepareDuration>
    <targetType>STTPoint</targetType>
    <ranks>
        <Item href="Spell01.(SpellArea).xdb" />
        <Item href="Spell02.(SpellArea).xdb" />
        <Item href="Spell03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Everyone</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>20000</duration>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>39.525</mana>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    </moveType>
                    <resource hrefvar="resource" />
                </projectileData>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsIf">
                <predicate type="gameMechanics.elements.predicates.PredicateAffectGroup">
                    <affectGroup>Group</affectGroup>
                </predicate>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactHeal">
                        <heal>1</heal>
                        <scalerCaster type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer hrefvar="externalCalcer_heal" />
                            </mulCalcer>
                            <additionalMultiplier>
                                <scaler type="gameMechanics.elements.scalers.HealScaler" />
                            </additionalMultiplier>
                        </scalerCaster>
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>