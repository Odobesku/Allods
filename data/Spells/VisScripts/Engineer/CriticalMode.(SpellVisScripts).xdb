<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>idleEngineer</Item>
						</animations>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
						</advanced>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>600</delay>
								<effectFx href="/Spells/FX/Spells/Engineer_CriticalMode_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<fixPoint>false</fixPoint>
								<locator>Slot_TopFX</locator>
								<locatorName>RightHand</locatorName>
								<offendTime />
							</Item>
							<Item>
								<delay>600</delay>
								<effectFx href="/Spells/FX/Spells/Engineer_CriticalMode_Body.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fixPoint>false</fixPoint>
								<scale>0.5</scale>
								<locator>Slot_TopFX</locator>
								<locatorName>RightHand</locatorName>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
