<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBoss_FatalityWind_Precast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>4</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>500</time>
				</playWhile>
				<elements>
					<Item type="CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Spells/MagePrismaticRayAbility_RayBlue.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<startPoint type="VisPointLocator">
							<locator>FROM_LOCATOR_NAME</locator>
							<locatorName>Slot_Mouth</locatorName>
						</startPoint>
						<endPoint type="VisPointLocator">
							<locator>Slot_BodyFX</locator>
						</endPoint>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
