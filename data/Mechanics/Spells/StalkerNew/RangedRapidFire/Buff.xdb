                            <Item type="gameMechanics.elements.scalers.AbilityRankScaler">
                                <ability href="/Mechanics/Spells/StalkerNew/Talents/RapidFireDamage/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                <mul>0.1</mul>
                            </Item>
                        </scalers>
                    </scaler>
                    <minDamage var="minDamage" />
                    <maxDamage var="maxDamage" />
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>0</initialDelay>
