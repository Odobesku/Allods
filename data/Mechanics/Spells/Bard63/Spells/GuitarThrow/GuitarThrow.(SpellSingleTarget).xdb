        <Item href="/Mechanics/Spells/Groups/BardChord.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
    </groups>
    <Name href="GuitarThrow.(SpellSingleTarget).Name.txt" />
    <Description href="GuitarThrow.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>WeaponScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/Terrify.(UISingleTexture).xdb" />
