                                        <radius type="gameMechanics.elements.calcers.FloatData">
                                            <value>15</value>
                                        </radius>
                                    </Item>
                                </alternatives>
                            </Item>
                        </modifiers>
                    </destination>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                        <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                    </impacts>
                    <object href="/Creatures/TreantGreen/Instances/HuntingGround4/LesavkaAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    <pool href="LesavkaAdds.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                </impact>
