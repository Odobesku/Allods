<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739861792</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability01_Name.txt" />
    <description href="Ability01_Desc.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Quest/ColdChains.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Ability_Name.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <targetImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                        <buff href="Buff02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </predicate>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>FIRE</element>
                            <scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                <buff href="Buff02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <anyRank>true</anyRank>
                                <onlyFromMaster>true</onlyFromMaster>
                                <mul>1</mul>
                            </scalerTarget>
                            <damage>5.5</damage>
                            <impactsOnHitTarget>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="Buff02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOnHitTarget>
                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                    <Item type="gameMechanics.elements.scalers.AbilityRankScaler">
                                        <ability href="Alternation01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                        <mul>1</mul>
                                    </Item>
                                </scalers>
                            </scaler>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.CasterProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value>0.6</value>
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsElse>
                </Item>
            </targetImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
