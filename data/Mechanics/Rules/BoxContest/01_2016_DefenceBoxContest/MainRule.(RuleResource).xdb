<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.rules.RuleResource>
    <Header>
        <resourceId>739950282</resourceId>
    </Header>
    <name href="MainRule.(RuleResource).Name.txt" />
    <description href="MainRule.(RuleResource).Description.txt" />
    <level>4</level>
    <rating>5</rating>
    <reward>
        <mandatoryItems>
            <Item>
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="/Items/BoxSpecialLoot/ExtraDefence/ExtraDefenceLegendary.(ItemResource).xdb" />
                </item>
                <number>1</number>
            </Item>
            <Item>
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="/Items/BoxSpecialLoot/ExtraDefence/ExtraDefenceEpic.(ItemResource).xdb" />
                </item>
                <number>1</number>
            </Item>
            <Item>
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="/Items/BoxSpecialLoot/ExtraDefence/ExtraDefenceRare.(ItemResource).xdb" />
                </item>
                <number>1</number>
            </Item>
            <Item>
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="/Items/BoxSpecialLoot/ExtraDefence/ExtraDefenceUncommon.(ItemResource).xdb" />
                </item>
                <number>1</number>
            </Item>
            <Item>
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="/Items/BoxSpecialLoot/ExtraDefence/ExtraDefenceCommon.(ItemResource).xdb" />
                </item>
                <number>1</number>
            </Item>
        </mandatoryItems>
    </reward>
    <types>
        <Item>RULE_TYPE_ACTION</Item>
    </types>
    <hideInactive>true</hideInactive>
    <ruleKind>IngameNotification</ruleKind>
    <notification href="/Mechanics/Rules/EventNotifications/Chests/Box01ContestResourse.(RuleNotification).xdb" />
    <predicates>
        <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/ItemmallService.(ContentKey).xdb" />
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateHasContentKey">
                <key href="/System/ContentKeys/IM_Steam.(ContentKey).xdb" />
            </predicate>
        </Item>
    </predicates>
    <timeTable href="MainTimeTable.(TimePeriodTable).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectRules">
            <rules>
                <Item href="Rule.(RuleResource).xdb" />
            </rules>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactSetRulesState">
                    <rules>
                        <Item href="/Mechanics/VendorsTables/Special/Defence_2016_active.(RuleResource).xdb" />
                    </rules>
                    <ruleState>ForcedPersistActive</ruleState>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <startImpacts>
        <Item type="itemService.elements.ImpactClearAltCurrency">
            <values>
                <Item href="/ItemMall/Rares/ChestsAdvanced/DefenceBox/Guarantee_AC/9Stats_recieved.(AlternativeCurrency).xdb" />
                <Item href="/ItemMall/Rares/ChestsAdvanced/DefenceBox/Guarantee_AC/Chest_counter.(AlternativeCurrency).xdb" />
            </values>
        </Item>
    </startImpacts>
    <canBeDisabled>true</canBeDisabled>
</gameMechanics.world.rules.RuleResource>