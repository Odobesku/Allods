<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>0</fadeOutMS>
    <geometry href="/Creatures/PathKeeper/PathKeeperPortal.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <scale>1</scale>
    <sound />
    <states>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/PathKeeper/Animations/PathKeeperPortal.Death.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/PathKeeper/Animations/PathKeeperPortal.Idle.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <visObjComponents>
        <Item type="StateComponent">
            <animations>
                <Item>death</Item>
            </animations>
            <component type="AttachedVisObjectComponent">
                <locatorName>Global</locatorName>
                <offset x="0" y="0" z="0" />
                <priority>0</priority>
                <rotation x="0" y="0" z="0" w="1" />
                <scale>1</scale>
                <visObject href="/Creatures/PathKeeper/PathKeeperPortalDeath.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                <hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
                <isPortraitEnabled>true</isPortraitEnabled>
                <lockScale>false</lockScale>
                <scaleFromGlobal>false</scaleFromGlobal>
                <skipSound>false</skipSound>
            </component>
            <stopForOtherAnimation>false</stopForOtherAnimation>
            <synchronizeAnimationPosition>false</synchronizeAnimationPosition>
            <updateOnlyByFeedBacks>false</updateOnlyByFeedBacks>
        </Item>
        <Item type="AttachedVisObjectComponent">
            <VisualObjectComponentID>Death</VisualObjectComponentID>
            <locatorName>Root</locatorName>
            <offset x="0" y="0" z="0" />
            <priority>0</priority>
            <rotation x="0" y="0" z="0" w="1" />
            <scale>1</scale>
            <visObject href="/Spells/FX/Mobs/PathKeeperPortal.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
            <isPortraitEnabled>true</isPortraitEnabled>
            <lockScale>false</lockScale>
            <scaleFromGlobal>false</scaleFromGlobal>
            <skipSound>false</skipSound>
        </Item>
        <Item type="StateComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <animations>
                <Item>death</Item>
            </animations>
            <component type="DelayComponent">
                <VisualObjectComponentID></VisualObjectComponentID>
                <component type="StopVisObjectComponents">
                    <VisualObjectComponentID></VisualObjectComponentID>
                    <stopedComponentIDs>
                        <Item>Death</Item>
                    </stopedComponentIDs>
                </component>
                <skipLoading>true</skipLoading>
            </component>
            <stopForOtherAnimation>true</stopForOtherAnimation>
            <synchronizeAnimationPosition>true</synchronizeAnimationPosition>
            <updateOnlyByFeedBacks>false</updateOnlyByFeedBacks>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>