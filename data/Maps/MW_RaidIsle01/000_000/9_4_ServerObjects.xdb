<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.PatchObjects>
	<objects>
		<Item type="gameMechanics.map.spawn.recaptureable.RecapturablePlace">
			<scriptID>Point01</scriptID>
			<place>
				<coord x="114.427" y="29.0501" z="-20.7173" />
				<yaw>6.10217</yaw>
				<faction href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
			</place>
			<device href="/Items/InteractiveObjects/MW_RaidIsle01/MWRaid_Point01.(SteleResource).xdb" />
			<autoCapturePeriodSec>1800</autoCapturePeriodSec>
			<steleImpactsOnOwnerChange>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="/Items/InteractiveObjects/MW_RaidIsle01/RaidPointCapture_Impacts_01.(ImpactListResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableOwner">
							<owner href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.battleground.map.PredicateBattleMemberMark">
													<mark href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/MWRaid/Buff_GoOut_Attention.(BuffResource).xdb" />
												</Item>
											</impactsIf>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</steleImpactsOnOwnerChange>
			<impactsOnStateChanged>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableState">
							<state>Captured</state>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
							<zone href="/Items/InteractiveObjects/MW_RaidIsle01/CheckZone.(ScriptZone).xdb" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="/Items/InteractiveObjects/MW_RaidIsle01/MWRaid_Point01.(ImpactListResource).xdb" />
				</Item>
			</impactsOnStateChanged>
			<stopAssaultPredicates>
				<Item type="gameMechanics.constructor.basicElements.PredicateOr">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.predicates.PredicateGreater">
								<lhs type="gameMechanics.elements.calcers.CheckPointAttackersCalcer" />
								<rhs type="gameMechanics.elements.calcers.CheckPointDefendersCalcer" />
							</predicate>
						</Item>
						<Item type="gameMechanics.elements.predicates.PredicateRecapturableOwner">
							<owner href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
						</Item>
					</predicates>
				</Item>
			</stopAssaultPredicates>
			<speedScaler type="gameMechanics.elements.scalers.LinearScaler">
				<multiplier>1.5</multiplier>
			</speedScaler>
			<defendCalcer type="gameMechanics.constructor.basicElements.FloatZero" />
			<attackCalcer type="gameMechanics.constructor.basicElements.FloatZero" />
			<achievementResource href="/Mechanics/InstancedEventResource/MWRaid_01/MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
			<achievementCount type="gameMechanics.elements.calcers.LongData">
				<value>2</value>
			</achievementCount>
			<periodicUpdateTick>1000</periodicUpdateTick>
		</Item>
		<Item type="gameMechanics.map.spawn.SingleSpawnResource">
			<scanRadius>0</scanRadius>
			<place type="gameMechanics.map.spawn.SpawnPlacePoint">
				<tuner href="" />
				<center x="114.427" y="29.0501" z="-20.7173" />
				<yaw>0</yaw>
				<pitch>0</pitch>
				<roll>0</roll>
			</place>
			<spawnTime type="gameMechanics.elements.spawn.TimeOnce" />
			<object href="/Mechanics/MegaWar/MWRaidRespawn.(ProjectileResource).xdb" />
		</Item>
