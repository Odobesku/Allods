<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>193944</resourceId>
    </Header>
    <Name href="Astal22WolfChef_EatMeat.(BuffResource).Name.txt" />
    <Description href="Astal22WolfChef_EatMeat.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorInnerRage.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>2</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.3</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.WeaponSpeedMultiplier">
            <scaler type="gameMechanics.elements.scalers.ExponentialEffectScaler">
                <base>0.5</base>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                    <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.SummandStat">
                    <stat type="gameMechanics.elements.stat.SpecialStat">
                        <stat href="/Mechanics/SpecialStats/AntiHeal.(SpecialStatResource).xdb" />
                    </stat>
                    <value>750</value>
                </Item>
            </effectsIf>
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>