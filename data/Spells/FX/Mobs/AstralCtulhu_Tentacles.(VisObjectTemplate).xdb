<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>200</fadeInMS>
    <fadeOutMS>200</fadeOutMS>
    <geometry href="/Spells/FX/Mobs/AstralCtulhu_Tentacles.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <scale>2</scale>
    <sound>
        <name>Ships/KtulhuProjectileLoop</name>
        <project href="/SFX/Ships/Ships.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
    </sound>
    <visObjComponents>
        <Item type="TrailComponent">
            <trail href="/Spells/FX/InterfaceFX/TrailCtulhu.(TrailTemplate).xdb#xpointer(/client.VisualConstructor.TrailTemplate)" />
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>