<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>202714</resourceId>
    </Header>
    <Name href="BrokenTurrel_TechBuff.(BuffResource).Name.txt" />
    <Description href="BrokenTurrel_TechBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/FireBeam.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="BrokenTurret_Fire_Vis.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.WeaponSpeedMultiplier">
            <scaler type="gameMechanics.elements.scalers.ExponentialEffectScaler">
                <base>0.7</base>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.5</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.PureDamage">
                    <damage>1</damage>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.01</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>