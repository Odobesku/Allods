<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<defaultVisAction type="DeviceVisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="BarrierOpen.(VisualFlag).xdb" />
				<visScriptLoop type="DeviceVisActionList">
					<play>Simultaneously</play>
					<elements>
						<Item type="DeviceAnimationAction">
							<mode>LOOP</mode>
							<animations>
								<Item>death</Item>
							</animations>
						</Item>
						<Item type="DeviceVisActionChangeModel" />
						<Item type="Sound3DActionDevice">
							<sound>
								<project href="/SFX/World/World.(FMODProject).xdb" />
								<name>World/Zones/ZC12/ArchitectPortalGate_Open</name>
							</sound>
						</Item>
					</elements>
				</visScriptLoop>
			</Item>
			<Item type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceAnimationAction">
						<mode>LOOP</mode>
						<channelId>1</channelId>
						<animations>
							<Item>specialAttack</Item>
						</animations>
					</Item>
				</elements>
			</Item>
		</elements>
	</defaultVisAction>
</DeviceVisScripts>
