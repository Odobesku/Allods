<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739912231</resourceId>
	</Header>
	<Name href="RysinaShield_Mechanics.(BuffResource).Name.txt" />
	<image href="/Interface/Icons/Misc/Event/ShieldCarrier.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Bosses/FerrisRaid/RysinaShield.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>All</affectGroup>
			<radius>10</radius>
			<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
				</predicates>
			</filter>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/SwarmBuff.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="ShieldProtected.(BuffResource).xdb" />
				</Item>
			</impactsIn>
			<impactsOut>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ShieldProtected.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="ShieldProtected_Dome.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/SwarmBuff.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impactsElse>
				</Item>
			</impactsOut>
		</Item>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>All</affectGroup>
			<radius>10</radius>
			<filter type="gameMechanics.world.creature.MobFilter" />
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
					<mobs>
						<Item href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Drone/Drone.(MobWorld).xdb" />
						<Item href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/ColossusScout/ColossusScout.(MobWorld).xdb" />
					</mobs>
				</Item>
			</predicates>
			<impactsIn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/ShieldDestructor.(BuffResource).xdb" />
				</Item>
			</impactsIn>
			<impactsOut>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/ShieldDestructor.(BuffResource).xdb" />
				</Item>
			</impactsOut>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
