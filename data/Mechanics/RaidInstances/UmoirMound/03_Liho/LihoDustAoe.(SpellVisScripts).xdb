<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ShadowMoon_Ready.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1</scale>
						<locator>Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.2</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureRotateToCastPointAction" />
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectAstralWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1</scale>
						<locator>Slot_Mouth</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialCast</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<elements>
					<Item type="VisActionDelay">
						<visActionID>Pr1</visActionID>
						<time>1400</time>
					</Item>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<visActionID>Pr1</visActionID>
						<projectileFx href="/Spells/FX/Spells/Invisible_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="/Spells/FX/Mobs/UmoirLihoBoss_Ash_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<pointOnCaster />
						<pointOnTarget type="VisPointLocator" />
						<offendTime />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
