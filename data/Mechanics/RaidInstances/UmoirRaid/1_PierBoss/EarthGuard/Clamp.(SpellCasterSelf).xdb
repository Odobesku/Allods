				</impacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
				<radius>160</radius>
				<affectHolder>false</affectHolder>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
