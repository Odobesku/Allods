<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Children>
        <Item href="/Interface/Ingame/ContextItemMall2/ItemMallButtonBonusHelpIcon.(WidgetPanel).xdb#xpointer(/client.Widgets.WidgetPanel)"/>
    </Children>
    <Name>BonusHelp</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <Pos>45</Pos>
            <Size>52</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Size>40</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>help_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag></TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextItemMall2/textures/ItemMallButtonHelpHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            <PushedOffset x="-2" y="2"/>
            <Reaction>help_pressed</Reaction>
            <ReactionRightClick>help_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextItemMall2/texts/BonusButtonsHelp.txt"/>
                <LayerMain href="/Interface/Ingame/ContextItemMall2/textures/ItemMallButtonHelpNormal.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ContextItemMall2/textures/ItemMallButtonHelpPressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
