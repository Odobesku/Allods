<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739848340</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectStackTrigger">
			<count>3</count>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
					<id href="CountID01.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>3000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactTeleport">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>ui04_tm_transit</scriptID>
									<map href="/Maps/UmoirIsland04/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
								</locator>
							</destination>
							<finishImpacts>
								<Item type="gameMechanics.elements.impacts.PostponedImpacts">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="TM_Transit.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</impacts>
								</Item>
							</finishImpacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
	<duration>30000</duration>
	<stackLimit>3</stackLimit>
	<isHelpful>true</isHelpful>
	<canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
