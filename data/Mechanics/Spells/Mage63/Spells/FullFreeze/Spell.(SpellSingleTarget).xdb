<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739920562</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/IceSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/AmmoSpells.(ActionGroup).xdb" />
	</groups>
	<element>COLD</element>
	<Name href="Spell.(SpellSingleTarget).Name.txt" />
	<Description href="Spell.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="multiplierBuff" />
		</Item>
		<Item>
			<name>var1</name>
			<value var="multiplierDebuff" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Mage/IcyStatue.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Mage/FullFreeze.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<level>5</level>
	<prepareDuration var="prepareDuration" />
	<ranks>
		<Item href="Spell01.(SpellSingleTarget).xdb" />
		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<launchWhenReady>true</launchWhenReady>
	<mechanics>
		<cooldown>
			<duration>1</duration>
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mul>-25000</mul>
				<mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
					<dressSlot>AMMO</dressSlot>
				</mulCalcer>
				<sum>300000</sum>
			</scaler>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
		</targetConditions>
		<conditions>
			<Item type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
						<affectGroup>Raid</affectGroup>
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
						<affectGroup>Enemies</affectGroup>
					</Item>
				</predicates>
			</Item>
		</conditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceIf">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateEquipped">
						<dressType>AMMO</dressType>
						<itemClass href="/Mechanics/ItemClasses/Other_InfiniteTeardrop.(ItemClass).xdb" />
					</Item>
				</predicates>
				<resourceIf type="gameMechanics.elements.resources.ResourceVariable">
					<hideText>true</hideText>
					<variable href="/Mechanics/Spells/Mage63/Abilities/ElementalPower/IceVar.(VariableResource).xdb" />
					<sub>0</sub>
				</resourceIf>
				<resourceElse type="gameMechanics.elements.resources.ResourceDressItem">
					<slot>AMMO</slot>
					<count>4</count>
				</resourceElse>
			</Item>
		</casterResources>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactsIf">
				<predicate type="gameMechanics.elements.predicates.PredicateAffectGroup">
					<affectGroup>Friends</affectGroup>
				</predicate>
				<impactsIf>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="Buff00.(BuffResource).xdb" />
						<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
							<multiplier var="multiplierBuff" />
						</durationScaler>
					</Item>
				</impactsIf>
				<impactsElse>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="Debuff.(BuffResource).xdb" />
						<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
							<multiplier var="multiplierDebuff" />
						</durationScaler>
					</Item>
				</impactsElse>
			</Item>
		</targetImpacts>
	</mechanics>
	<speed>30</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
