<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739920135</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Spell00.(SpellSingleTarget).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>HOLY</element>
							<forceAE>true</forceAE>
							<damage>1</damage>
							<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
								<scalers>
									<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mulCalcer type="constructor.elements.CalcerFloatExternal">
											<externalCalcer hrefvar="externalCalcer" />
										</mulCalcer>
									</Item>
									<Item type="gameMechanics.elements.scalers.MagicScaler" />
								</scalers>
							</scaler>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectJumpOnDetach">
			<jumps type="gameMechanics.elements.calcers.LongData">
				<value>3</value>
			</jumps>
			<buff hrefvar="buff" />
			<autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.RandomAutotarget">
				<group>Enemies</group>
				<radius>85</radius>
			</autotarget>
			<onBehalfOfCaster>true</onBehalfOfCaster>
			<radius>10</radius>
			<inCasterRange>false</inCasterRange>
			<renewingEffects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOff>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="/Spells/VisScripts/Priest/ChainSmite.(ClientData).xdb" />
							<calcers>
								<addressEntries>
									<Item>
										<name>caster</name>
										<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
									</Item>
									<Item>
										<name>target</name>
										<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
									</Item>
								</addressEntries>
							</calcers>
						</Item>
					</impactsOff>
				</Item>
			</renewingEffects>
		</Item>
	</effects>
	<duration>75</duration>
	<isStackable>false</isStackable>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<ranks>
		<Item href="Buff01.(BuffResource).xdb" />
		<Item href="Buff02.(BuffResource).xdb" />
		<Item href="Buff03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<isClientReplicated>false</isClientReplicated>
	<isForthright>true</isForthright>
	<groups>
		<Item href="/Mechanics/Spells/Groups/ChainSmite63.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
