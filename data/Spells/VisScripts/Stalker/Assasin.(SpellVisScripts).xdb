<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<precastType>PRECAST_LAUNCH</precastType>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedDispell</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<advanced>
					<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
					<turnToTarget>NO_TURN</turnToTarget>
					<waitRealEvent>NO_WAIT</waitRealEvent>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/WarriorEvasiveStrike.(VisObjectTemplate).xdb" />
						<locator>Slot_BodyFX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
