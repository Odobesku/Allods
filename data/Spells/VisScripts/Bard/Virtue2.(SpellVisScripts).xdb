<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Ray.(SpellVisScripts).xdb" />
		<Variables>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<RayLength>11</RayLength>
			<FXRay>/Spells/FX/Spells/Bard_Dirge_Channel_03.(VisObjectTemplate).xdb</FXRay>
			<PreCastFX>PreCastFXSound.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastFX>
			<Animation>readySpellOmniBard</Animation>
			<LocatorOnCaster>Slot_BodyFX</LocatorOnCaster>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureChannelDirectAction">
				<startPoint type="VisPointLocator">
					<shift z="-0.5" />
				</startPoint>
				<fadeOutTime>500</fadeOutTime>
			</Item>
			<Item skiped="" />
			<Item skiped="" />
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmniBard</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
