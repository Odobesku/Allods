<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarComplite />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<advanced>
					<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
					<offendType>WHIRLWIND_OFFEND</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<delay>400</delay>
						<effectFx href="/Spells/FX/Spells/HitBloodBlackCrit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<locator>Slot_FX</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>200</delay>
						<effectFx href="/Spells/FX/Mobs/Izba_Push.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Foot_R</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
