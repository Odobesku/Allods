<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>474725</resourceId>
    </Header>
    <Name href="VortexMaker.(SpellSingleTarget).Name.txt" />
    <Description href="VortexMaker.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/IceElementalHeart.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="VortexMaker.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>10</value>
    </range>
    <prepareDuration>1500</prepareDuration>
    <isWorkOnDead>true</isWorkOnDead>
    <iffPolicy>Everyone</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>2000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="/World/Quests/ElementalPlateu/Air_2/Air_2.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <status>Started</status>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsDead" />
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/Deadman.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                </predicate>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Creatures/AirElemental/ElementalPlateu/AirElementalQuest.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    <Item href="/Creatures/AirElemental/ElementalPlateu/AirElementalSilvermob.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </mobs>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="/World/Quests/ElementalPlateu/Air_2/Counter_1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeDisorient">
                        <radius>10</radius>
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    </moveType>
                    <resource href="/World/Quests/ElementalPlateu/Air_2/Tornado.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                </projectileData>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSetFaction">
                <faction href="/World/Factions/Deadman.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
                    <radius>55</radius>
                </distributor>
                <data href="/World/Quests/ElementalPlateu/Air_2/ElementalTransparency.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>