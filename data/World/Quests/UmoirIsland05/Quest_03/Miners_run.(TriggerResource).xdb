<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>315132</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="Quest_03.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
            <counterId href="Counter6.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            <condition type="constructor.elements.LongEquals">
                <value>10</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>3000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.GoThroughPath">
                                    <runningMode>true</runningMode>
                                    <path>
                                        <Item>
                                            <scriptID>path_1</scriptID>
                                            <map href="/Maps/UmoirIsland05/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </Item>
                                        <Item>
                                            <scriptID>path_2</scriptID>
                                            <map href="/Maps/UmoirIsland05/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </Item>
                                        <Item>
                                            <scriptID>path_3</scriptID>
                                            <map href="/Maps/UmoirIsland05/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </Item>
                                        <Item>
                                            <scriptID>path_4</scriptID>
                                            <map href="/Maps/UmoirIsland05/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </Item>
                                        <Item>
                                            <scriptID>path_5</scriptID>
                                            <map href="/Maps/UmoirIsland05/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </Item>
                                        <Item>
                                            <scriptID>path_6</scriptID>
                                            <map href="/Maps/UmoirIsland05/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </Item>
                                        <Item>
                                            <scriptID>path_7</scriptID>
                                            <map href="/Maps/UmoirIsland05/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </Item>
                                    </path>
                                </Item>
                            </impacts>
                            <spawnResource href="/Maps/UmoirIsland05/SpawnTables/Miners.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>70</radius>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                            <data href="/Characters/Hadagan_male/Instances/UmoirIsland05/Time_to_go.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                <mobs>
                                                    <Item href="/Characters/Hadagan_male/Instances/UmoirIsland05/Miner01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                    <Item href="/Characters/Hadagan_male/Instances/UmoirIsland05/Miner02.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                </mobs>
                                            </Item>
                                        </predicates>
                                    </filter>
                                    <targetsLimit>4</targetsLimit>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
                    <item href="/Items/QuestItems/UmoirIslan05/Samogon.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="Quest_03.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
            <counterId href="/Items/QuestItems/UmoirIslan05/Samogon.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            <condition type="constructor.elements.LongEquals">
                <value>0</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                            <quest href="Quest_03.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                            <counterResource href="Counter5.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                            <value>1</value>
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                <quest href="Quest_03.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                <counterResource href="Counter6.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                <value>10</value>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                            <data href="NeedMoreSamogon.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>