<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.LootTableResource>
    <Header>
        <resourceId>739898532</resourceId>
    </Header>
    <table type="gameMechanics.constructor.schemes.item.LootTablePredicates">
        <predicates>
            <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                <lhs type="itemService.serverVariables.CalcerServerVariable">
                    <variableResource href="/Mechanics/ServerUnlock/ServerUnlock.(ServerVariableResource).xdb" />
                </lhs>
                <rhs type="gameMechanics.elements.calcers.LongData">
                    <value>3</value>
                </rhs>
            </Item>
        </predicates>
        <lootTable type="gameMechanics.constructor.schemes.item.LootTableSingleItem">
            <itemProvider type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                <item href="ServerUnlock.Rare.(ItemResource).xdb" />
            </itemProvider>
            <minNumber>2</minNumber>
            <maxNumber>5</maxNumber>
            <isForAll>true</isForAll>
        </lootTable>
    </table>
</gameMechanics.constructor.schemes.item.LootTableResource>