<?xml version="1.0" encoding="UTF-8"?>
<VisualMob>
	<charExtScaleIndex>-1</charExtScaleIndex>
	<character href="DragonBossSphereMob.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
	<colorCoefficients>
		<b>1</b>
		<g>1</g>
		<r>1</r>
		<w>0.2</w>
		<use>false</use>
	</colorCoefficients>
	<creatureParameters>
		<disableProceduralAndColorEffects>false</disableProceduralAndColorEffects>
	</creatureParameters>
	<decalScale>1</decalScale>
	<hitAnimationCooldown>0</hitAnimationCooldown>
	<hitCritAnimationCooldown>0</hitCritAnimationCooldown>
	<mobAnimations href="" />
	<mobEventsScripts href="" />
	<pickAabb>
		<center x="0" y="0" z="0" />
		<extents x="0" y="0" z="0" />
	</pickAabb>
	<procedureFxScale>1</procedureFxScale>
	<scale>1</scale>
	<sfxArmorSet href="" />
	<soundVariation href="" />
	<timeToCorpseFadingMax>0</timeToCorpseFadingMax>
	<timeToCorpseFadingMin>0</timeToCorpseFadingMin>
	<transparency>1</transparency>
	<variation>
		<additionalVariation href="" />
		<face href="" />
		<facial href="" />
		<hairColor>-1</hairColor>
		<hairGeoset href="" />
		<morphPresetIndex>0</morphPresetIndex>
		<shoulderStone href="" />
		<shoulderStoneColor>-1</shoulderStoneColor>
		<skin href="" />
		<skinColor>-1</skinColor>
	</variation>
	<visualScript type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureAnimationAction">
				<advanced>
					<autoHasten>
						<mode>AUTOHASTEN_NONE</mode>
						<timeToBeLeft>0</timeToBeLeft>
					</autoHasten>
					<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
					<offendType>NO_OFFEND</offendType>
					<speed>0</speed>
					<turnToTarget>TURN_DEFAULT</turnToTarget>
					<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
					<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
					<denyAutoHasten>false</denyAutoHasten>
					<disableRandomFirstFrame>true</disableRandomFirstFrame>
					<eventPlaybackEnd>false</eventPlaybackEnd>
					<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
					<stopIfMoved>false</stopIfMoved>
					<stopIfRotated>false</stopIfRotated>
				</advanced>
				<animations>
					<Item>special</Item>
				</animations>
				<channel>CHANNEL_DEFAULT</channel>
				<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
				<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
				<mode>LOOP</mode>
				<use>USE_ANIMATIONS</use>
				<dontFreezePrecast>false</dontFreezePrecast>
			</Item>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.VisActionDelay">
						<time>1500</time>
					</Item>
					<Item type="client.SLON.CreatureIndependentFxAction">
						<lifeTime>1.5</lifeTime>
						<offset x="0" y="0" z="3" />
						<rotation x="0" y="0" z="0" />
						<scale>1</scale>
						<visEventPointIndex>-1</visEventPointIndex>
						<visObject href="/Spells/FX/World/Ferris_CS_Portal_Flash.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<isRelative>true</isRelative>
						<useCastPoint>false</useCastPoint>
					</Item>
				</elements>
				<play>InSequence</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<playWhile type="client.Replica.VisActionDelay">
			<time>1600</time>
		</playWhile>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</visualScript>
	<disableFall>false</disableFall>
	<skipCharacterVisualScript>false</skipCharacterVisualScript>
	<useIdleSpecial>true</useIdleSpecial>
	<useVisualTweaks>true</useVisualTweaks>
</VisualMob>