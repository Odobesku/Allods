<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>196800</resourceId>
    </Header>
    <Name href="ColdSteel.(BuffResource).Name.txt" />
    <Description href="ColdSteel.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Dualwield/PairSwordsPalash.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                    <spells>
                        <Item href="/Mechanics/Spells/Stalker63/Spells/InstinctiveStrike/Spell03.(SpellSingleTarget).xdb" />
                    </spells>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                <coeff>1</coeff>
                                <calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="gameMechanics.elements.calcers.SpellRankCalcer">
                                            <spell href="/Mechanics/Spells/Stalker63/Spells/EnchantCold/Spell01.(SpellSingleTarget).xdb" />
                                            <mul>1</mul>
                                        </mulCalcer>
                                        <additionalMultiplier>
                                            <scaler type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                                <buff href="ColdSteel.(BuffResource).xdb" />
                                                <anyRank>true</anyRank>
                                                <onlyFromMaster>false</onlyFromMaster>
                                                <mul>1</mul>
                                            </scaler>
                                        </additionalMultiplier>
                                    </scaler>
                                    <value>0.05</value>
                                </calcer>
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ColdSteel.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Stalker63/Spells/InstinctiveStrike/Spell03.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Launch</Item>
            </stages>
        </Item>
    </effects>
    <duration>4000</duration>
    <stackLimit>10</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>