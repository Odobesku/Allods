<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739875992</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<image href="/Interface/Icons/Misc/Keys/Particle_chaos.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<source>Quest</source>
	<position>1</position>
	<descVars>
		<Item>
			<name>sectorName</name>
			<text hrefvar="sectorName" />
		</Item>
		<Item>
			<name>tierName</name>
			<text hrefvar="tierName" />
		</Item>
		<Item>
			<name>tier2Name</name>
			<text hrefvar="tier2Name" />
		</Item>
	</descVars>
	<showItemContextAction>OnlyCurrentQuest</showItemContextAction>
	<forceShowQuality>true</forceShowQuality>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.RandomTakeAction">
						<entries>
							<Item>
								<actions>
									<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
										<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
											<item hrefvar="item3" />
										</item>
										<modifiers>
											<Item type="itemService.avatar.itemBag.ReplaceRemoveTimeModifier" />
										</modifiers>
									</Item>
								</actions>
								<chance>0.11</chance>
							</Item>
							<Item>
								<actions>
									<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
										<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
											<item hrefvar="item2" />
										</item>
										<modifiers>
											<Item type="itemService.avatar.itemBag.ReplaceRemoveTimeModifier" />
										</modifiers>
									</Item>
								</actions>
								<chance>0.49</chance>
							</Item>
							<Item>
								<actions>
									<Item type="itemService.avatar.itemBag.GiveItemTakeAction">
										<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
											<item hrefvar="item" />
										</item>
										<modifiers>
											<Item type="itemService.avatar.itemBag.ReplaceRemoveTimeModifier" />
										</modifiers>
									</Item>
								</actions>
								<chance>0.4</chance>
							</Item>
						</entries>
					</Item>
				</actions>
				<consumeItems>100</consumeItems>
			</Item>
		</usages>
		<triggersGlobalCooldown>false</triggersGlobalCooldown>
	</functionalPart>
	<level>60</level>
	<requiredLevel>60</requiredLevel>
	<stackLimit>10000</stackLimit>
	<quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
	<prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
		<cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
			<money var="money" />
		</cost>
	</prices>
	<binding>BindOnPickup</binding>
	<lifeLengthCap>1209600000</lifeLengthCap>
	<name href="KeyPiece.(ItemResource).Name02.txt" />
	<description href="KeyPiece.(ItemResource).Description02.txt" />
	<category href="/Mechanics/ItemCategories/Ship/Misc.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
</gameMechanics.constructor.schemes.item.ItemResource>
