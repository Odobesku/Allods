<?xml version="1.0" encoding="UTF-8" ?>
<mapLoader.MapTemplate>
    <Header>
        <resourceId>380088354</resourceId>
        <Prototype href="DungeonInstanceProto.xdb" />
        <Variables>
            <beastFaction>/World/Factions/WildWild.(Faction).xdb</beastFaction>
        </Variables>
    </Header>
    <zone href="/Mechanics/Stronghold/PillageZone.xdb" />
    <entrance type="avatarPopulation.service.impl.matchMakingImpl.map.InstancedEventMapEntrance" />
    <headParts>
        <parts>
            <Item type="mapLoader.parts.PlayerCountResource" />
            <Item type="mapLoader.parts.MapDestroyerResource">
                <instanceLifeTime>200000</instanceLifeTime>
            </Item>
            <Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
                <reattachOnTeleport>false</reattachOnTeleport>
                <effects>
                    <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
                        <mark href="/Mechanics/GameRoot/DeathLimitExceeded.xdb" />
                        <impacts>
                            <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactFinishInstancedEventGeneric" />
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.effects.Switch">
                        <impactsOn>
                            <Item type="gameMechanics.elements.impacts.ImpactSetMapDeathLimit">
                                <range>
                                    <min>5</min>
                                    <max>15</max>
                                </range>
                            </Item>
                        </impactsOn>
                    </Item>
                </effects>
            </Item>
            <Item type="gameMechanics.world.avatar.MapCombatStateResource" />
            <Item type="gameMechanics.map.basicElements.MapSpecificEffects">
                <effects>
                    <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                        <effectsIf>
                            <Item type="gameMechanics.elements.effects.DeathTrigger">
                                <impacts>
                                    <Item type="itemService.avatar.stronghold.ImpactCatchSpark" />
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.effects.EffectSetDisconnectTimeout">
                                <disconnectTime>600000</disconnectTime>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.EffectList">
                                <effectsResource href="/Mechanics/Mounts/Prototypes/InstanceDismount.(EffectListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.EffectListResource)" />
                            </Item>
                        </effectsIf>
                    </Item>
                    <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                        </predicates>
                        <effectsIf>
                            <Item type="gameMechanics.world.mob.behaviour.components.effects.EffectCanBeAggred" />
                        </effectsIf>
                    </Item>
                </effects>
            </Item>
        </parts>
    </headParts>
    <mechanicsSettings>
        <forceSleep>true</forceSleep>
        <evadeMob>false</evadeMob>
    </mechanicsSettings>
</mapLoader.MapTemplate>