<?xml version="1.0" encoding="UTF-8" ?>
<UIBindSection>
	<sysName>ship_movement</sysName>
	<name href="Section.txt" />
	<binds>
		<Item>
			<sysName>ship_forward</sysName>
			<name href="ShipForward.txt" />
			<activationType>ACTIVATION_TYPE_ACTIVATE_AND_DEACTIVATE</activationType>
			<anyMods>true</anyMods>
			<defaultKeys>
				<Item>W</Item>
				<Item>UP</Item>
			</defaultKeys>
		</Item>
		<Item>
			<sysName>ship_back</sysName>
			<name href="ShipBackward.txt" />
			<activationType>ACTIVATION_TYPE_ACTIVATE_AND_DEACTIVATE</activationType>
			<anyMods>true</anyMods>
			<defaultKeys>
				<Item>S</Item>
				<Item>DOWN</Item>
			</defaultKeys>
		</Item>
		<Item>
			<sysName>ship_left</sysName>
			<name href="ShipLeft.txt" />
			<activationType>ACTIVATION_TYPE_ACTIVATE_AND_DEACTIVATE</activationType>
			<anyMods>true</anyMods>
			<defaultKeys>
				<Item>A</Item>
				<Item>LEFT</Item>
			</defaultKeys>
		</Item>
		<Item>
			<sysName>ship_right</sysName>
			<name href="ShipRight.txt" />
			<activationType>ACTIVATION_TYPE_ACTIVATE_AND_DEACTIVATE</activationType>
			<anyMods>true</anyMods>
			<defaultKeys>
				<Item>D</Item>
				<Item>RIGHT</Item>
			</defaultKeys>
		</Item>
		<Item>
			<sysName>ship_up</sysName>
			<name href="ShipUp.txt" />
			<activationType>ACTIVATION_TYPE_ACTIVATE_AND_DEACTIVATE</activationType>
			<anyMods>true</anyMods>
			<defaultKeys>
				<Item>Q</Item>
				<Item>PG_UP</Item>
			</defaultKeys>
		</Item>
		<Item>
			<sysName>ship_down</sysName>
			<name href="ShipDown.txt" />
			<activationType>ACTIVATION_TYPE_ACTIVATE_AND_DEACTIVATE</activationType>
			<anyMods>true</anyMods>
			<defaultKeys>
				<Item>E</Item>
				<Item>PG_DOWN</Item>
			</defaultKeys>
		</Item>

	</binds>
</UIBindSection>
