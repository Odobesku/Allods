<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>drink</Item>
		</animations>
		<advanced>
			<speed>0.5</speed>
			<turnToTarget>NO_TURN</turnToTarget>
		</advanced>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureHoldWeaponAction" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/DrinkPotion_Bottle.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
