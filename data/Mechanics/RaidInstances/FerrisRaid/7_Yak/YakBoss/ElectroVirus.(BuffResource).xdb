<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739901312</resourceId>
	</Header>
	<Name href="ElectroVirus.(BuffResource).Name.txt" />
	<Description href="ElectroVirus.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Mounts/SpellsMounts/ElectrostaticChargeTank.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Spells/AOEAura_Electric_R10.(VisObjectTemplate).xdb" />
			<lockScale>true</lockScale>
			<locator>Slot_Global</locator>
		</Item>
	</visualEffects>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>4750</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.map.destination.SelfPosDestination" />
								</moveType>
								<resource href="ElectroExplosion.(ProjectileResource).xdb" />
							</projectileData>
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
							<spawn>
								<scriptID>7_Yak</scriptID>
								<map href="/Maps/FerrisRaid/MapResource.xdb" />
							</spawn>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
											<radius>10</radius>
											<affectHolder>false</affectHolder>
											<impacts>
												<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
													<element>LIGHTNING</element>
													<damage>20</damage>
													<impactsOnHitTarget>
														<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
															<predicates>
																<Item type="gameMechanics.elements.resources.ResourceBuff">
																	<buff href="ElectroVirus.(BuffResource).xdb" />
																</Item>
															</predicates>
															<impactsElse>
																<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																	<buff href="ElectroVirus.(BuffResource).xdb" />
																</Item>
															</impactsElse>
														</Item>
													</impactsOnHitTarget>
													<scaler type="gameMechanics.elements.scalers.MagicScaler" />
												</Item>
											</impacts>
											<filter type="gameMechanics.constructor.basicElements.FilterAnd">
												<filters>
													<Item type="gameMechanics.world.creature.AvatarFilter" />
													<Item type="gameMechanics.world.creature.AliveFilter" />
													<Item type="gameMechanics.constructor.basicElements.FilterNot">
														<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
															<predicates>
																<Item type="gameMechanics.elements.resources.ResourceAnyBuff">
																	<buffs>
																		<Item href="ElectroVirus.(BuffResource).xdb" />
																	</buffs>
																</Item>
															</predicates>
														</filter>
													</Item>
												</filters>
											</filter>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="ElectroVirusImmunity.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ElectroVirus.(BuffResource).xdb" />
