<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>215993</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
    </groups>
    <element>LIGHTNING</element>
    <Name href="Defibrillation.(SpellSingleTarget).Name.txt" />
    <Description href="Defibrillation.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/Defibrillation.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Engineer/Defibrillation.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <isWorkOnDead>true</isWorkOnDead>
    <ranks>
        <Item href="Defibrillation01.(SpellSingleTarget).xdb" />
        <Item href="Defibrillation02.(SpellSingleTarget).xdb" />
        <Item href="Defibrillation03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/CommonBuffs/Disorient/Buff00.(BuffResource).xdb" />
                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>3</multiplier>
                </durationScaler>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                <value>1</value>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>