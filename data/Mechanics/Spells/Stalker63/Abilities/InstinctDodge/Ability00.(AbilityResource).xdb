											<radius>40</radius>
											<affectPets>false</affectPets>
											<excludeCaster>true</excludeCaster>
											<excludeTarget>true</excludeTarget>
											<impacts>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/Spells/Stalker63/Abilities/InstinctiveStrikeDodgeBuff/DodgeOne.(BuffResource).xdb" />
													<durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
														<mul>1</mul>
														<mulCalcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
															<ability href="/Mechanics/Spells/Stalker63/Abilities/InstinctiveStrikeDodgeBuff/Ability01.(AbilityResource).xdb" />
															<mul>1.5</mul>
														</mulCalcer>
													</durationScaler>
												</Item>
											</impacts>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="/Mechanics/Spells/Stalker63/Spells/Reflexes/Spell01.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
