<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>215921</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="HealStation.(BuffResource).Name.txt" />
    <Description href="HealStation.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/EngineerTumba.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/EngineerHive_Attack.(VisObjectTemplate).xdb" />
            <lockScale>true</lockScale>
            <locator>Slot_Global</locator>
            <offset z="1.5" />
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="HealStationLifetime.(BuffResource).xdb" />
                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
            <predicate type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
            </predicate>
        </Item>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <affectsPureHeal>true</affectsPureHeal>
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <tick>1000</tick>
            <affectGroup>Group</affectGroup>
            <radius>15</radius>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff hrefvar="buff" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Healing01.(BuffResource).xdb" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatFullHealth" />
            <multiplier>0.25</multiplier>
        </Item>
    </effects>
    <duration>8000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="HealStation01.(BuffResource).xdb" />
        <Item href="HealStation02.(BuffResource).xdb" />
        <Item href="HealStation03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/EngineerDefenceDevices.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>