<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739951949</resourceId>
	</Header>
	<Name href="Buff00.(BuffResource).Name.txt" />
	<Description href="Buff00.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Priest/PriestSpiritualFocus.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Spells/LimitOfFaith.(VisObjectTemplate).xdb" />
			<scale>1.4</scale>
			<fadeInTime>300</fadeInTime>
			<fadeOutTime>300</fadeOutTime>
		</Item>
	</visualEffects>
	<effects>
		<Item type="gameMechanics.elements.effects.DamageAbsorber">
			<elements>
				<Item>COLD</Item>
				<Item>DISEASE</Item>
				<Item>FIRE</Item>
				<Item>ASTRAL</Item>
				<Item>HOLY</Item>
				<Item>LIGHTNING</Item>
				<Item>PHYSICAL</Item>
				<Item>POISON</Item>
				<Item>SHADOW</Item>
				<Item>ACID</Item>
			</elements>
			<absorb>90</absorb>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.HealScaler" />
					<Item type="gameMechanics.elements.scalers.OffensiveRunesScaler" />
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mul>0.01</mul>
						<mulCalcer type="gameMechanics.elements.calcers.StatCalcer">
							<stat type="gameMechanics.elements.stat.SpecialStat">
								<stat href="/Mechanics/Spells/CommonBuffs/Aspects/Heal/HealAspectSpecialStat.(SpecialStatResource).xdb" />
							</stat>
						</mulCalcer>
						<sum>1</sum>
					</Item>
				</scalers>
			</scaler>
			<buff href="Buff00.(BuffResource).xdb" />
			<absorbNotForthrightDamage>true</absorbNotForthrightDamage>
			<scaledByCasterStats>true</scaledByCasterStats>
		</Item>
	</effects>
	<duration>6000</duration>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
