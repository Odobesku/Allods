    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)"/>
    <functionalPart type="gameMechanics.constructor.schemes.item.meta.UltimateMetaUpgrader">
        <upgradeCondition type="gameMechanics.elements.item.ItemPredicateAnd">
            <predicates>
