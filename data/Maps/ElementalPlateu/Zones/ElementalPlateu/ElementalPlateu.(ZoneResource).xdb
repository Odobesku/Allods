		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactLogAvatarStats">
							<resource href="/Maps/ElementalPlateu/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateFaction">
									<faction href="/World/Factions/League.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Maps/ElementalPlateu/Mechanics/LootBoost.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									<stacks type="gameMechanics.map.variables.MapVariableValueCalcer">
										<resource href="/Maps/ElementalPlateu/Variables/Powerplace_L.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
									</stacks>
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Maps/ElementalPlateu/Mechanics/LootBoost.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									<stacks type="gameMechanics.map.variables.MapVariableValueCalcer">
										<resource href="/Maps/ElementalPlateu/Variables/Powerplace_E.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
									</stacks>
								</Item>
							</impactsElse>
						</Item>
					</impactsOn>
				</Item>
			</effectsIf>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectAvatarRespawnStrategy">
			<respawnStrategy type="gameMechanics.world.avatar.RespawnStrategyIf">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Items/Reputation/ElementalPlateu/EP_DeathTicket.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
