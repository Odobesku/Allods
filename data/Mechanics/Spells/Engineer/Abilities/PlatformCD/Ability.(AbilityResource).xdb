<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739863337</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.(AbilityResource).Name.txt" />
    <description href="Ability.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>percent</name>
            <value var="factor" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Engineer/Platform.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <casterImpacts>
                <Item type="gameMechanics.elements.impacts.CasterProbabilisticImpact">
                    <chanceCalcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
                        <ability href="Ability01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        <mul>0.334</mul>
                    </chanceCalcer>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>8</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Kick.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                            <value>1</value>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.CreatureFilter" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="PlatformKick.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impacts>
                </Item>
            </casterImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/Engineer/LevitatingPlatform/Spell01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                    <Item href="/Mechanics/Spells/Engineer/LevitatingPlatformV2.01/Spell01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                </spells>
            </destination>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability02.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability03.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>