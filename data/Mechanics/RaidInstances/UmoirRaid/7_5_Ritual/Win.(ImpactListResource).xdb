<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>225221</resourceId>
    </Header>
    <impacts>
        <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
            <variable href="RitualBoss.(MapVariableResource).xdb" />
            <summand>1</summand>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
            <zone href="Ray/ShadowZone.(ScriptZone).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
            <zone href="Ray/FireZone.(ScriptZone).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="Ritualist.(MobWorld).xdb" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.world.mob.ImpactLogBossKill">
                                    <loggerType>RaidBoss</loggerType>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>500</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <spawnResource href="Ritual.(SpawnTable).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
            <impacts>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impacts>
            <spawnResource href="Fire.(SpawnTable).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
            <device>
                <scriptID>RitualChest</scriptID>
                <map href="/Maps/UmoirRaid/MapResource.xdb" />
            </device>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="/World/Quests/Umoir/U_raid_05/Ritual.(QuestCountId).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
            <mob>
                <scriptID>NezebQ</scriptID>
                <map href="/Maps/UmoirRaid/MapResource.xdb" />
            </mob>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
            <spawn>
                <scriptID>RDoor1</scriptID>
                <map href="/Maps/UmoirRaid/MapResource.xdb" />
            </spawn>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                    <visualState>1</visualState>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
            <spawn>
                <scriptID>RDoor2</scriptID>
                <map href="/Maps/UmoirRaid/MapResource.xdb" />
            </spawn>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                    <visualState>1</visualState>
                </Item>
            </impacts>
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>