<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionList">
						<playWhile type="VisActionDelay">
							<time>3000</time>
						</playWhile>
						<elements>
							<Item type="CreatureAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>readySpellDirectedSky</Item>
								</animations>
							</Item>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<delay>80</delay>
										<effectFx href="/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb" />
										<fadeInTime>6000</fadeInTime>
										<fadeOutTime>2000</fadeOutTime>
										<locator>Slot_Hand_L</locator>
									</Item>
									<Item>
										<effectFx href="/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb" />
										<fadeInTime>6000</fadeInTime>
										<fadeOutTime>2000</fadeOutTime>
										<locator>Slot_Hand_R</locator>
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
					<Item type="VisActionList">
						<playWhile type="VisActionDelay">
							<time>1000</time>
						</playWhile>
						<elements>
							<Item type="CreatureAnimationAction">
								<animations>
									<Item>battleRoarInstant</Item>
									<Item>levelUp</Item>
								</animations>
								<advanced>
									<speed>1.25</speed>
								</advanced>
							</Item>
						</elements>
					</Item>
					<Item type="VisActionList">
						<elements>
							<Item type="CreatureAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>ready2HL</Item>
								</animations>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>3250</delay>
						<effectFx href="/Spells/FX/Spells/WarriorCrueltyAbility.(VisObjectTemplate).xdb" />
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureHoldWeaponAction">
				<time>6000</time>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>4250</time>
			</Item>
			<Item type="CreatureTrailAction">
				<lengthMSec>4000</lengthMSec>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb" />
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<locator>Slot_Hand_R</locator>
						<offset y="-0.5" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEnchantWeaponAction">
				<enchant href="/Spells/FX/InterfaceFX/MeleeRed.(EnchantTemplate).xdb" />
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack2HL</Item>
				</animations>
				<advanced>
					<animationKeysAction>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureRunActionOnSpellTargets">
										<targetAction type="CreatureIndependentFxAction">
											<visObject href="/Spells/FX/Mobs/GT_4BossGuard_DeathSentence_Hit_Part.(VisObjectTemplate).xdb" />
											<offset z="0.5" />
											<scale>1.4</scale>
											<lifeTime>3</lifeTime>
										</targetAction>
									</Item>
									<Item type="CreatureEffectsAction">
										<visualEffects>
											<Item>
												<fadeInTime>500</fadeInTime>
												<fadeOutTime>500</fadeOutTime>
												<locator>Slot_Hand_R</locator>
												<offendTime type="EffectOffendConstDelay" />
											</Item>
										</visualEffects>
									</Item>
								</elements>
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
