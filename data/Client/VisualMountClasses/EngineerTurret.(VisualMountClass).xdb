<?xml version="1.0" encoding="UTF-8" ?>
<VisualMountClass>
	<animationSettings>
		<playOnRiderTopOnly href="Horse/PlayOnRiderTopOnly.(AnimationsGroup).xdb#xpointer(/AnimationsGroup)" />
		<playOnRider href="" />
		<playOnMount href="Golem/PlayOnMountOnly.(AnimationsGroup).xdb#xpointer(/AnimationsGroup)" />
		<visualDismount>
			<Item>sitGround</Item>
			<Item>sitGroundUp</Item>
			<Item>emoteKneel</Item>
			<Item>sleep</Item>
			<Item>sleepDown</Item>
			<Item>sleepUp</Item>
			<Item>emoteMuscle</Item>
			<Item>emoteRasp</Item>
			<Item>emoteBeg</Item>
			<Item>emoteCheer</Item>
			<Item>emoteTriumph</Item>
			<Item>danceAnniversary</Item>
			<Item>emotePlayMusic</Item>
			<Item>specialSitGround</Item>
			<Item>emoteDance01</Item>
			<Item>emoteDance02</Item>
			<Item>emoteDance03</Item>
			<Item>emoteDance04</Item>
			<Item>emoteDance05</Item>
			<Item>emoteDance06</Item>
			<Item>emoteDance07</Item>
			<Item>emoteDance08</Item>
			<Item>emoteDance09</Item>
			<Item>emoteDance10</Item>
			<Item>channelCastDirectedEngineer</Item>
			<Item>spellCastDirectedEngineer</Item>
			<Item>spellCastOmniEngineer</Item>
		</visualDismount>
		<complexAnimations>
			<Item>
				<animation>loot</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>lootLoop</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>attack</animation>
				<playOnRiderTop>mountBikeJumpStart</playOnRiderTop>
				<playOnRiderBottom>mountBikeJumpStart</playOnRiderBottom>
				<playOnMount>attack</playOnMount>
			</Item>
			<Item>
				<animation>attack01</animation>
				<playOnRiderTop>mountBikeJumpStart</playOnRiderTop>
				<playOnRiderBottom>mountBikeJumpStart</playOnRiderBottom>
				<playOnMount>attack01</playOnMount>
			</Item>
			<Item>
				<animation>channelCastDirected</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>channelCastDirected</playOnMount>
			</Item>
			<Item>
				<animation>hitCritical</animation>
				<playOnRiderTop>mountBikeJumpStart</playOnRiderTop>
				<playOnRiderBottom>mountBikeJumpStart</playOnRiderBottom>
				<playOnMount>hitCritical</playOnMount>
			</Item>
			<Item>
				<animation>idle</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>ready</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>ready1H</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>readyUnarmed</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>readyCast</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>readyCastWand</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>idleEngineer</animation>
				<playOnRiderTop>spellCastOmni</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>hitCritical</playOnMount>
			</Item>
			<Item>
				<animation>shuffleLeft</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>shuffleLeft</playOnMount>
			</Item>
			<Item>
				<animation>shuffleRight</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>shuffleRight</playOnMount>
			</Item>
			<Item>
				<animation>special</animation>
				<playOnRiderTop>mountBikeSit01</playOnRiderTop>
				<playOnRiderBottom>mountBikeSit01</playOnRiderBottom>
				<playOnMount>special</playOnMount>
			</Item>
			<Item>
				<animation>readySpellDirectedEngineer</animation>
				<playOnRiderTop>readySpellDirectedEngineer</playOnRiderTop>
				<playOnRiderBottom>readySpellDirectedEngineer</playOnRiderBottom>
				<playOnMount>idle</playOnMount>
			</Item>
			<Item>
				<animation>spellCastOmni</animation>
				<playOnRiderTop>mountBikeIdle</playOnRiderTop>
				<playOnRiderBottom>mountBikeIdle</playOnRiderBottom>
				<playOnMount>spellCastOmni</playOnMount>
			</Item>
		</complexAnimations>
	</animationSettings>
	<fxSettings>
		<mountLocators>
			<Item>Slot_FX</Item>
			<Item>Slot_Global</Item>
			<Item>Global</Item>
		</mountLocators>
	</fxSettings>
	<controlParameters>
		<speedFactorForward>
			<startVelocity>2</startVelocity>
			<stopVelocity>2</stopVelocity>
			<startTime>200</startTime>
			<stopTime>0</stopTime>
		</speedFactorForward>
		<speedFactorBackward>
			<startVelocity>3</startVelocity>
			<stopVelocity>0</stopVelocity>
			<startTime>0</startTime>
			<stopTime>0</stopTime>
		</speedFactorBackward>
	</controlParameters>
	<pitchParameters>
		<minVelocity>8</minVelocity>
		<minVelocityPitch>3</minVelocityPitch>
		<topVelocity>15</topVelocity>
		<topVelocityPitch>15</topVelocityPitch>
		<minStepDeltaTMainAvatar>5</minStepDeltaTMainAvatar>
		<minStepDeltaT>15</minStepDeltaT>
		<minTurnRadius>1</minTurnRadius>
		<pitchMaxVelocity>20</pitchMaxVelocity>
		<maxPitch>20</maxPitch>
	</pitchParameters>
	<jumpSettings>
		<specialJump href="SpecialJump.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
	</jumpSettings>
	<reinsSettings>
		<use>false</use>
		<reinsBone>Slot_Reins</reinsBone>
		<handBone>Slot_Hand_L</handBone>
		<reinsBone01>Slot_Reins01</reinsBone01>
		<handBone01>Slot_Hand_R</handBone01>
		<member>Assaulter</member>
		<disablingAnimations href="Horse/DisableReins.(CharacterAnimationsGroup).xdb#xpointer(/CharacterAnimationsGroup)" />
	</reinsSettings>
	<skinChangedScript href="/Spells/VisScripts/Commands/ChangeSkin.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<levelChangedScript href="/Spells/VisScripts/Commands/LevelUp_Mount.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<summonVisualScript href="/Spells/VisScripts/Mount/SummonCommonHorse.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<sitAnimation>special</sitAnimation>
	<riderOrientation>All_FromMountSlot</riderOrientation>
	<useRiderSpineTurn>false</useRiderSpineTurn>
	<hiddenDressSlots />
</VisualMountClass>
