<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739877802</resourceId>
    </Header>
    <element>COLD</element>
    <Name href="IcePuddle.(SpellArea).Name.txt" />
    <visualScripts href="IcePuddleVis.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>16</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>12000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                <time>1000</time>
                <destination type="gameMechanics.map.destination.RelativePos">
                    <faceSourcePos>false</faceSourcePos>
                    <coord x="30" />
                </destination>
            </Item>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                <minDamage>50</minDamage>
                <maxDamage>50</maxDamage>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>35</value>
        </angle>
    </shape>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <shapeOrientation type="gameMechanics.elements.common.ShapeOrientationYawAndPitch" />
    <radius>16</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>