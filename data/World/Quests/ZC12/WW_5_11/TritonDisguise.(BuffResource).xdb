                    <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                    <data href="TritonGuardAlertnessOff.(ClientData).xdb" />
                </Item>
            </impactsOut>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="/Creatures/WaterFolkMale/Instances/ZC12/Triton_guard_WW_5_11.(MobWorld).xdb" />
                        </mobs>
                    </Item>
                </predicates>
            </filter>
        </Item>
        <Item type="gameMechanics.elements.effects.Aura">
            <radius>15</radius>
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                            <data href="TritonGuardAlertnessHigh.(ClientData).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                    <data href="TritonGuardAlertnessHighOff.(ClientData).xdb" />
                </Item>
            </impactsOut>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="/Creatures/WaterFolkMale/Instances/ZC12/Triton_guard_WW_5_11.(MobWorld).xdb" />
                        </mobs>
                    </Item>
                </predicates>
