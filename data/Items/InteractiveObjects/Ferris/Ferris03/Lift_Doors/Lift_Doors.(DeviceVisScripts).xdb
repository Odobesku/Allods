<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states>
		<Item>
			<action type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>idle</Item>
						</animations>
					</Item>
				</elements>
			</action>
		</Item>
		<Item>
			<action type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceVisActionChangeModel">
								<visObj href="/World/Dungeons/FerisLab/Models/FerisLab_Lift_Doors.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<collision href="/World/Dungeons/FerisLab/Models/FerisLab_Lift_Doors.(Collision).xdb#xpointer(/Collision)" />
							</Item>
						</elements>
					</Item>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceAnimationAction">
								<animations>
									<Item>specialIdle</Item>
								</animations>
							</Item>
						</elements>
					</Item>
					<Item type="DeviceVisActionList">
						<elements>
							<Item type="DeviceVisActionDelay">
								<time>1030</time>
							</Item>
							<Item type="DeviceAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>idle01</Item>
								</animations>
							</Item>
						</elements>
					</Item>
				</elements>
			</action>
		</Item>
	</states>
	<defaultVisAction type="DeviceAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>idle</Item>
		</animations>
	</defaultVisAction>
</DeviceVisScripts>
