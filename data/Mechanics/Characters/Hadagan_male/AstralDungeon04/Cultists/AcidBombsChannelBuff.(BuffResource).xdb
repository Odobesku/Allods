<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>240183</resourceId>
    </Header>
    <Name href="AcidBombsChannelBuff.(BuffResource).Name.txt" />
    <Description href="AcidBombsChannelBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffMagicBallGreen.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="AcidTorrentVisual.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="/Characters/Hadagan_male/Instances/AstralDungeon04/Boss02/Necro.(MobWorld).xdb" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                            <spell href="/Mechanics/Spells/AstarlIslands/AstralDungeon04/Boss02/AcidTorrentBoss.(SpellArea).xdb" />
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                            <spell href="AcidTorrent.(SpellArea).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="AcidTorrentVisual.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="/Characters/Hadagan_male/Instances/AstralDungeon04/Boss02/Necro.(MobWorld).xdb" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                            <spell href="/Mechanics/Spells/AstarlIslands/AstralDungeon04/Boss02/AcidTorrentBoss.(SpellArea).xdb" />
                            <duration>
                                <hour>1</hour>
                            </duration>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/AstarlIslands/AstralDungeon04/Boss02/AcidBoltRes.(BuffResource).xdb" />
                            <scalerTarget type="gameMechanics.elements.scalers.RandomScaler">
                                <range>
                                    <min>3</min>
                                    <max>5</max>
                                </range>
                            </scalerTarget>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                            <spell href="AcidBolt.(SpellSingleTarget).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                            <spell href="AcidTorrent.(SpellArea).xdb" />
                            <duration>
                                <hour>1</hour>
                            </duration>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                            <spell href="AcidTorrentReady.(SpellSingleTarget).xdb" />
                            <duration>
                                <second>7</second>
                                <ms>500</ms>
                            </duration>
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>5000</duration>
    <stackLimit>20</stackLimit>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>