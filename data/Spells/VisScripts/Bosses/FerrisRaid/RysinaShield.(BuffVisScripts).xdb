<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastOmni</Item>
				</animations>
				<channelOverrideScript />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/RysinaShield_Main.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<locator>Slot_Global</locator>
						<ignoreParentRotation>true</ignoreParentRotation>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/AOEAura_Rysina_R10.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
