<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>ready</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/BossAvatar_Pull.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                        <scale>1</scale>
                        <locator>Global</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </action>
</BuffVisScripts>