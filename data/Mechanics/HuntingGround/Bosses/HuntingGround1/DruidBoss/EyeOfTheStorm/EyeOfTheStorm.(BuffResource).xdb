    <image href="/Interface/Icons/Spells/Druid/ChainLightning.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/MageLightningInstability.(VisObjectTemplate).xdb" />
        </Item>
        <Item>
            <effectFx href="/Spells/FX/Spells/DruidCallLightningUpgrade.(VisObjectTemplate).xdb" />
        </Item>
    </visualEffects>
    <visualPostEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/HitLightning_big_01.(VisObjectTemplate).xdb" />
        </Item>
    </visualPostEffects>
    <nameTemplate href="EyeOfTheStorm.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>10</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
