<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>204350</resourceId>
    </Header>
    <contextActionInfo>
        <priority>201</priority>
    </contextActionInfo>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
    </groups>
    <Name href="ExoMountConnector.(SpellSingleTarget).Name.txt" />
    <Description href="ExoMountConnector.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/Defense.(UISingleTexture).xdb" />
    <visualScripts href="ExoMountConnector.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <needLos>false</needLos>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>180000</duration>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>-0.03333</mul>
                <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                    <group href="/Mechanics/Mounts/Groups/ExoMount101.xdb" />
                </mulCalcer>
                <sum>1</sum>
            </scaler>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMountFromGroupFeeded">
                <group href="/Mechanics/Mounts/Groups/ExoMount101.xdb" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateMounted" />
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="ExoMountConnector.(BuffResource).xdb" />
                </predicate>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
                <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceItem">
                            <item href="/Items/BoxSpecialLoot/Cannon/ManaBattery.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                            <buff href="Energize.(BuffResource).xdb" />
                            <range>
                                <min>10</min>
                                <max>99</max>
                            </range>
                        </Item>
                    </predicates>
                </predicate>
                <clientData href="EnergizeCD.(ClientData).xdb" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="TempExoMountConnectorFake.(BuffResource).xdb" />
                            <consumeStacks>0</consumeStacks>
                        </Item>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="ExoMountConnectorFake.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                </predicate>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                        <buff href="Energize.(BuffResource).xdb" />
                        <range>
                            <min>10</min>
                            <max>99</max>
                        </range>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.StackBuff">
                        <buff href="Energize.(BuffResource).xdb" />
                        <delta type="gameMechanics.elements.calcers.FloatData">
                            <value>-10</value>
                        </delta>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Energize.(BuffResource).xdb" />
                        <stacks type="gameMechanics.elements.calcers.FloatData">
                            <value>30</value>
                        </stacks>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
                        <item href="/Items/BoxSpecialLoot/Cannon/ManaBattery.xdb" />
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="ExoMountConnectorFake.(BuffResource).xdb" />
                <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mul>0.045</mul>
                    <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                        <group href="/Mechanics/Mounts/Groups/ExoMounts.(MountGroupResource).xdb" />
                    </mulCalcer>
                    <sum>0.5</sum>
                </durationScaler>
            </Item>
            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="ExoMountConnector.(BuffResource).xdb" />
                        <durationScalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mul>0.045</mul>
                            <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                                <group href="/Mechanics/Mounts/Groups/ExoMounts.(MountGroupResource).xdb" />
                            </mulCalcer>
                            <sum>0.5</sum>
                        </durationScalerTarget>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>20</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>