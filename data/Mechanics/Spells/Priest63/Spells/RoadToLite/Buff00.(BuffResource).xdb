<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>207316</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Buff00.(BuffResource).Description02.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageEnlarge.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Priest/RoadToLite.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.CalcerMul">
                <calcers>
                    <Item type="gameMechanics.elements.calcers.FullHealthCalcer" />
                    <Item type="gameMechanics.elements.calcers.LinearCalcer">
                        <mul>0.01</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerDiff">
                            <minuend type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer hrefvar="externalCalcer" />
                            </minuend>
                            <subtrahend type="gameMechanics.elements.calcers.FloatData">
                                <value>10</value>
                            </subtrahend>
                        </mulCalcer>
                        <sum>0</sum>
                    </Item>
                </calcers>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.elements.predicates.PredicateOnSameMap" />
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                                        <groups>
                                            <Item href="/Mechanics/Spells/Groups/TeleportBlockers.(ActionGroup).xdb" />
                                        </groups>
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                    <data href="TeleportCD.(ClientData).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                    <finishImpacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                                            <data href="/Mechanics/Spells/Priest63/Spells/Unites/TeleportCD.(ClientData).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.DoubleAttackOnly">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.DirectHeal">
                                                                            <heal>1</heal>
                                                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                                                                <additionalMultiplier>
                                                                                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                                        <mul>0.005</mul>
                                                                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                                            <externalCalcer hrefvar="externalCalcer" />
                                                                                        </mulCalcer>
                                                                                    </scaler>
                                                                                </additionalMultiplier>
                                                                            </scalerTarget>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                                <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.DirectHeal">
                                                                            <heal>1</heal>
                                                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                                                                <additionalMultiplier>
                                                                                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                                        <mul>0.01</mul>
                                                                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                                            <externalCalcer hrefvar="externalCalcer" />
                                                                                        </mulCalcer>
                                                                                    </scaler>
                                                                                </additionalMultiplier>
                                                                            </scalerTarget>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                            <buff hrefvar="buff" />
                                                        </Item>
                                                    </finishImpacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateGreater">
                            <lhs type="gameMechanics.elements.calcers.CalcerMul">
                                <calcers>
                                    <Item type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                    <Item type="gameMechanics.elements.calcers.LinearCalcer">
                                        <mul>0.01</mul>
                                        <mulCalcer type="gameMechanics.elements.calcers.CalcerDiff">
                                            <minuend type="constructor.elements.CalcerFloatExternal">
                                                <externalCalcer hrefvar="externalCalcer" />
                                            </minuend>
                                            <subtrahend type="gameMechanics.elements.calcers.FloatData">
                                                <value>10</value>
                                            </subtrahend>
                                        </mulCalcer>
                                        <sum>0</sum>
                                    </Item>
                                </calcers>
                            </lhs>
                            <rhs type="gameMechanics.elements.calcers.HealthCalcer" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateOnSameMap" />
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                    <data href="TeleportCD.(ClientData).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                    <finishImpacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                                            <data href="/Mechanics/Spells/Priest63/Spells/Unites/TeleportCD.(ClientData).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.DoubleAttackOnly">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.DirectHeal">
                                                                            <heal>1</heal>
                                                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                                                                <additionalMultiplier>
                                                                                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                                        <mul>0.005</mul>
                                                                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                                            <externalCalcer hrefvar="externalCalcer" />
                                                                                        </mulCalcer>
                                                                                    </scaler>
                                                                                </additionalMultiplier>
                                                                            </scalerTarget>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                                <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.DirectHeal">
                                                                            <heal>1</heal>
                                                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                                                                <additionalMultiplier>
                                                                                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                                        <mul>0.01</mul>
                                                                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                                            <externalCalcer hrefvar="externalCalcer" />
                                                                                        </mulCalcer>
                                                                                    </scaler>
                                                                                </additionalMultiplier>
                                                                            </scalerTarget>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                                    <buff hrefvar="buff" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </finishImpacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>