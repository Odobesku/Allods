<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.CreatureChangeVisItemsAction">
        <items>
          <Item>
            <newItem href="/Items/VisualItems/Cloak/Bag_Cloth_A_73Jetpack.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
            <slot>LIFESTYLEBACK</slot>
          </Item>
        </items>
        <isGfxCondition>false</isGfxCondition>
        <leaveWeapons>true</leaveWeapons>
        <notForDolls>false</notForDolls>
        <removeAllItems>false</removeAllItems>
      </Item>
      <Item type="client.Replica.CreatureIfMainAvatarRunAction">
        <action type="client.Replica.VisActionList">
          <elements>
            <Item type="client.Replica.CreatureSetFlagVisAction">
              <visualFlag href="/World/Quests/HuntingGround3/AO11_Prologue04/AO11_Prologue04_JetPack_Fly.(VisualFlag).xdb#xpointer(/client.Replica.VisualFlag)" />
              <mainAvatarOnly>true</mainAvatarOnly>
            </Item>
            <Item type="client.Replica.CreatureIfFlagVisAction">
              <visScriptStart type="client.Replica.CreatureEffectsAction">
                <category>EFFECT_DEFAULT</category>
                <visualEffects>
                  <Item>
                    <delay>0</delay>
                    <effectAnimations>
                      <mode>DIE</mode>
                    </effectAnimations>
                    <effectFx href="/Spells/FX/Mobs/MountStove_Smoke.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                    <fadeInTime>0</fadeInTime>
                    <fadeOutTime>0</fadeOutTime>
                    <scale>0.299999982</scale>
                    <fixPoint>false</fixPoint>
                    <lockScale>false</lockScale>
                    <muteFxSounds>false</muteFxSounds>
                    <ignoreParentRotation>false</ignoreParentRotation>
                    <locator>Global</locator>
                    <member>Default_Member</member>
                    <offset x="0" y="0" z="0" />
                    <rotation x="0" y="0" z="0" w="0" />
                    <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                  </Item>
                </visualEffects>
                <dontFade>false</dontFade>
                <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                <stopOnDeath>false</stopOnDeath>
              </visScriptStart>
              <visualFlag href="/World/Quests/HuntingGround3/AO11_Prologue04/AO11_Prologue04_JetPack_Fly.(VisualFlag).xdb#xpointer(/client.Replica.VisualFlag)" />
            </Item>
          </elements>
          <play>InSequence</play>
          <preconditional>false</preconditional>
          <restartOnVisualChange>false</restartOnVisualChange>
          <stopOnDeath>false</stopOnDeath>
          <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
        </action>
        <checkCreature>Current</checkCreature>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>