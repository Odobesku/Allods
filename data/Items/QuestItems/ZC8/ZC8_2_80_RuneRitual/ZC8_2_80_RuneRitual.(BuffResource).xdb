<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>314151971</resourceId>
    </Header>
    <Name href="ZC8_2_80_RuneRitual.(BuffResource)_Name.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidTreantForm.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="ZC8_2_80_RuneRitual.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="ZC8_2_80_RuneRitual.(BuffResource)_Name.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                    <mob>
                        <scriptID>ZC8_EvilTekuani</scriptID>
                        <map href="/Maps/IllusionWorld/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </mob>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>6000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>ZC8_EvilTekuani</scriptID>
                                <map href="/Maps/IllusionWorld/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <onBehalfOfTarget>true</onBehalfOfTarget>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>60</radius>
                            <conditions>
                                <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                    <onSlave type="gameMechanics.constructor.basicElements.PredicateAnd">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                <mobs>
                                                    <Item href="/Creatures/TreantGreen/Instances/ZC8/ZC8_TreantGreen.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                </mobs>
                                            </Item>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                            </Item>
                                        </predicates>
                                    </onSlave>
                                </Item>
                            </conditions>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                            </impacts>
                            <filter type="gameMechanics.world.creature.MobFilter" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>4000</tick>
        </Item>
    </effects>
    <duration>30000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>