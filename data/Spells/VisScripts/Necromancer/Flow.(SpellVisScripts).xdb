<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastOmniWand</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectNecromancerWand.(VisObjectTemplate).xdb" />
						<locator>Wand_Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionLoopAction">
				<actionToLoop type="VisActionList">
					<playWhile type="VisActionDelay">
						<time>1000</time>
					</playWhile>
					<elements>
						<Item type="CreatureEffectsAction">
							<visualEffects>
								<Item>
									<effectFx href="/Spells/FX/Spells/ReadySpellDirectNecromancerWand_Cast.(VisObjectTemplate).xdb" />
									<locator>Wand_Slot_FX</locator>
								</Item>
							</visualEffects>
						</Item>
					</elements>
				</actionToLoop>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements />
	</wholeCasting>
</SpellVisScripts>
