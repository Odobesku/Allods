								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton04Top.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton04Temp.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton04Raid.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton04Lion.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton05Base.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton05Top.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton05BaseRed.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton05Raid.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton05Premium.(VisualMount).xdb#xpointer(/VisualMount)" />
							</mountsList>
							<checkIsInTheList>true</checkIsInTheList>
							<checkOnStartOnly>false</checkOnStartOnly>
						</playWhile>
						<preconditional>false</preconditional>
						<restartOnVisualChange>true</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
					</Item>
					<Item type="client.Replica.VisActionList">
						<elements>
							<Item type="client.Replica.VisActionList">
								<elements>
									<Item type="client.SLON.CreatureStepSoundParamAction">
										<param>
											<parameter href="ExoFootstepsV2.(SoundParameter).xdb#xpointer(/SoundParameter)" />
											<value>0.2</value>
										</param>
										<onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
									</Item>
								</elements>
								<play>Simultaneously</play>
