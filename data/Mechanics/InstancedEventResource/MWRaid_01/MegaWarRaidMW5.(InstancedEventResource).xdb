<?xml version="1.0" encoding="UTF-8" ?>
<avatarPopulation.service.impl.matchMakingImpl.eventType.mWar.MWarRaidEventType>
    <Header>
        <resourceId>739849386</resourceId>
    </Header>
    <name href="MegaWarRaidMW5.(InstancedEventResource).Name.txt" />
    <description href="MegaWarRaidMW5.(InstancedEventResource).Description.txt" />
    <isHighPriority>true</isHighPriority>
    <showPredicates>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                <hideText>true</hideText>
                <rule href="/Mechanics/Rules/MegaWar/MegawarOff.(RuleResource).xdb" />
            </predicate>
        </Item>
    </showPredicates>
    <minAvatarLevel type="gameMechanics.formulas.MaxLevelConstant" />
    <startTime href="/Mechanics/InstancedEventResource/MW_01/RaidMW5TimeTable.(TimeTable).xdb" />
    <levelsPartition>
        <entries>
            <Item>
                <minLevel type="gameMechanics.formulas.MaxLevelConstant" />
            </Item>
        </entries>
    </levelsPartition>
    <minAvatarsCount>0</minAvatarsCount>
    <leaderOnly>true</leaderOnly>
    <capacity>12</capacity>
    <keepGroupAfterFinish>true</keepGroupAfterFinish>
    <immediatelyStartFactor>0.1</immediatelyStartFactor>
    <unionType>SmallRaid</unionType>
    <internal>true</internal>
    <exclusive>true</exclusive>
    <joinConditions>
        <Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
            <rule href="/Mechanics/Rules/MegaWar/MWRaidPrepareTime.(RuleResource).xdb" />
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/Empire.xdb" />
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/League.xdb" />
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                <hideText>true</hideText>
                <rule href="/Mechanics/Rules/MegaWar/MegawarOff.(RuleResource).xdb" />
            </predicate>
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
            <predicate type="gameMechanics.elements.predicates.PredicateInRaid">
                <policy>Small</policy>
            </predicate>
            <clientData href="/Mechanics/InstancedEventResource/SmallRaidWarningMegaWar.(ClientData).xdb" />
        </Item>
    </joinConditions>
    <inviteTimeout>
        <second>30</second>
    </inviteTimeout>
    <delayedInvite>true</delayedInvite>
    <rewards>
        <Item>
            <eventPredicates>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateNot">
                    <predicate type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateEventWinner" />
                </Item>
            </eventPredicates>
            <items>
                <Item>
                    <item href="/Items/MegaWars/RealgarRate.(ItemResource).xdb" />
                    <calcer type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerSum">
                        <calcers>
                            <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerMul">
                                <calcers>
                                    <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.LoserAchievementCalcer">
                                        <achievementResource href="MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
                                    </Item>
                                    <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                                        <value>0.0104167</value>
                                    </Item>
                                </calcers>
                            </Item>
                            <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                                <value>125</value>
                            </Item>
                        </calcers>
                    </calcer>
                </Item>
            </items>
            <mailTemplate href="/Mechanics/InstancedEventResource/MW_01/MegaReward.(MailTemplate).xdb" />
        </Item>
        <Item>
            <eventPredicates>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.event.predicates.PredicateEventWinner" />
            </eventPredicates>
            <items>
                <Item>
                    <item href="/Items/MegaWars/RealgarRate.(ItemResource).xdb" />
                    <calcer type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerSum">
                        <calcers>
                            <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerMul">
                                <calcers>
                                    <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.WinnerAchievementCalcer">
                                        <achievementResource href="MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
                                    </Item>
                                    <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                                        <value>0.0104167</value>
                                    </Item>
                                </calcers>
                            </Item>
                            <Item type="avatarPopulation.service.impl.matchMakingImpl.event.calcers.CalcerConst">
                                <value>150</value>
                            </Item>
                        </calcers>
                    </calcer>
                </Item>
            </items>
            <mailTemplate href="/Mechanics/InstancedEventResource/MW_01/MegaReward.(MailTemplate).xdb" />
        </Item>
    </rewards>
    <maps>
        <Item href="BattleEventMapMechanics.xdb" />
    </maps>
    <increaseVisitsOnFreeWin>true</increaseVisitsOnFreeWin>
    <acceptStage>Queue</acceptStage>
    <allowEmptyGroupsAfterPrepare>true</allowEmptyGroupsAfterPrepare>
    <defendersMark href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
    <attackersMark href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
    <teamScore href="MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
    <maxSameClassesCount>3</maxSameClassesCount>
</avatarPopulation.service.impl.matchMakingImpl.eventType.mWar.MWarRaidEventType>