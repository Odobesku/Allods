<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739932080</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/EngineerDefenceDevices.(ActionGroup).xdb" />
    </groups>
    <Name href="HealStation.(SpellArea).Name.txt" />
    <Description href="HealStation.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>MagicScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Engineer/EngineerTumba.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Engineer/Engineer_MeleeBotSpell.(SpellVisScripts).xdb" />
    <durationBuff href="HealStationLifetime.(BuffResource).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <targetType>STTPoint</targetType>
    <ranks>
        <Item href="HealStation01.(SpellArea).xdb" />
        <Item href="HealStation02.(SpellArea).xdb" />
        <Item href="HealStation03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Everyone</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHasPath">
                <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                <maxLength>85</maxLength>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateFaction">
                        <faction href="/World/Factions/League.xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff hrefvar="buff" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/DeviceFall.(MarkResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                        <delay>100</delay>
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="HealStationLifetime.(BuffResource).xdb" />
                                                <durationScaler type="gameMechanics.elements.scalers.BuffTicksScaler">
                                                    <buff href="HealStation01.(BuffResource).xdb" />
                                                    <tickLength>1000</tickLength>
                                                </durationScaler>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                        <assistantResource href="HealStation.(AssistantResource).xdb" />
                        <mobResource href="HealStationLeague.(MobWorld).xdb" />
                        <level type="gameMechanics.elements.calcers.CalcerLevel" />
                        <linkMode>ModifiedHealth</linkMode>
                        <planeSyncStrategy>Sync</planeSyncStrategy>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff hrefvar="buff" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/DeviceFall.(MarkResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                        <delay>100</delay>
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="HealStationLifetime.(BuffResource).xdb" />
                                                <durationScaler type="gameMechanics.elements.scalers.BuffTicksScaler">
                                                    <buff href="HealStation01.(BuffResource).xdb" />
                                                    <tickLength>1000</tickLength>
                                                </durationScaler>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                        <assistantResource href="HealStation.(AssistantResource).xdb" />
                        <mobResource href="HealStationEmpire.(MobWorld).xdb" />
                        <level type="gameMechanics.elements.calcers.CalcerLevel" />
                        <linkMode>ModifiedHealth</linkMode>
                        <planeSyncStrategy>Sync</planeSyncStrategy>
                    </Item>
                </elseImpacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                <spell href="/Mechanics/Spells/Engineer63/Spells/ForceField/ForceField03.(SpellArea).xdb" />
                <duration var="duration" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellGroupCooldown">
                <group href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
                <duration>1000</duration>
            </Item>
        </casterImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>