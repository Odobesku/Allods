<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739871192</resourceId>
	</Header>
	<Name href="ConeFear.(SpellArea).Name.txt" />
	<visualScripts href="ConeFear.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>15</value>
	</range>
	<prepareDuration>1200</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>10000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="WoodSpiritPhase.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff href="/Mechanics/Spells/CommonBuffs/Fear/Buff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
					<multiplier>3</multiplier>
				</durationScaler>
			</Item>
		</targetImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Cone">
		<angle type="constructor.basicElements.AngleDegrees">
			<value>90</value>
		</angle>
	</shape>
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
