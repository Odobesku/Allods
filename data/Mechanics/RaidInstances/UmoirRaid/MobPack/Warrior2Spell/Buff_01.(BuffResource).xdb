<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>224875</resourceId>
    </Header>
    <visScript href="Buff_02.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.AbonentLostWatcher">
            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllSpells" />
        <Item type="gameMechanics.elements.effects.EffectForcedAggroLeader" />
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.elements.predicates.PredicateDistance">
                        <range min="0" max="7" />
                    </predicate>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Buff_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                            <spell href="Spell_01.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                    </impactsIf>
                </Item>
            </impacts>
            <tick>500</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/Taunt.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                    </groups>
                </Item>
            </predicates>
        </Item>
    </effects>
    <duration>20000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>