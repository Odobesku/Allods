<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.EffectListResource>
    <Header>
        <resourceId>739880900</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <effects>
        <Item type="gameMechanics.world.ship.elements.EffectMapChanged">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                    <zone hrefvar="zone" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderGroup" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable hrefvar="variableAccessCounter" />
                                            <summand var="sumLeaveZone" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff hrefvar="SelfBuff" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleLeaveMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                    <zone hrefvar="zone" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderGroup" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable hrefvar="variableAccessCounter" />
                                            <summand var="sumLeaveZone" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGroupTrigger">
            <impactsOnLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff hrefvar="SelfBuff" />
                </Item>
            </impactsOnLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone hrefvar="zone" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderGroup" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                    <variable hrefvar="variableAccessCounter" />
                                    <summand var="sumEnterZone" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.constructor.basicElements.EffectListResource>