<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirected</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<channelOverrideMode>OVERRIDE_STOP</channelOverrideMode>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Smeyana_MagicShield.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_Global</locator>
						<locatorName />
						<useVisObjectSettings>FROM_TARGET</useVisObjectSettings>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
