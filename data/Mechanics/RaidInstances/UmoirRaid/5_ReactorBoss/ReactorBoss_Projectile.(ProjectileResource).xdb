<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>225169</resourceId>
    </Header>
    <name href="ReactorBoss_Projectile.(ProjectileResource).Name.txt" />
    <visObject href="/Creatures/UmoirReactor/UmoirReactorAddRed.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <speed>0.02</speed>
    <lifeLengthCap>6000</lifeLengthCap>
    <impactsOnHit>
        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
            <radius>3.5</radius>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>FIRE</element>
                    <damage>25</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ReactorBoss_Burn_Big.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impacts>
            <filter type="gameMechanics.world.creature.AvatarFilter">
                <withPet>true</withPet>
            </filter>
        </Item>
    </impactsOnHit>
    <impactsToTarget>
        <Item type="gameMechanics.elements.impacts.ImpactBunchesAround">
            <radius>2</radius>
            <affectHolder>false</affectHolder>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                            <resources>
                                <Item href="ReactorBoss_Projectile_FirePuddle.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                            </resources>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>1000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateProjectile" />
                </predicates>
            </filter>
            <targetsLimit>1</targetsLimit>
        </Item>
        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown">
                                        <useWater>false</useWater>
                                    </Item>
                                </modifiers>
                            </destination>
                        </moveType>
                        <resource href="ReactorBoss_Projectile_FirePuddle.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown">
                                        <useWater>false</useWater>
                                    </Item>
                                </modifiers>
                            </destination>
                        </moveType>
                        <resource href="ReactorBoss_Projectile_Hit.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
            <delay>1000</delay>
            <impacts>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impacts>
        </Item>
    </impactsToTarget>
</gameMechanics.world.projectile.ProjectileResource>