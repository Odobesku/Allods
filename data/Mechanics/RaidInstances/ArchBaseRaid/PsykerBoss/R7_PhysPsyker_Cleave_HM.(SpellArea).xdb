<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>224475</resourceId>
    </Header>
    <Name href="R7_PhysPsyker_Cleave_HM.(SpellArea).Name.txt" />
    <visualScripts href="R7_PhysPsyker_Cleave.(SpellVisScripts).xdb" />
    <prepareDuration>3000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="R7_PhysPsyker_Mark_HM_2.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="Phys_Plane.(BuffResource).xdb" />
                    </Item>
                </predicates>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.RunImpactsInShape">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="Inf_Plane.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="Phys_Plane.(BuffResource).xdb" />
                                            </Item>
                                        </predicates>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </predicates>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                <projectileData>
                                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                    <resource href="R7_Phys_Projectile.(ProjectileResource).xdb" />
                                </projectileData>
                                <pool href="/Mechanics/RaidInstances/ArchBaseRaid/SiegeBoss/R7_PhysPsyker_Cleave_HM.(SummonPool).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                <minDamage>18</minDamage>
                                <maxDamage>22</maxDamage>
                            </Item>
                        </impactsIf>
                    </Item>
                </impacts>
                <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
                    <angle type="constructor.basicElements.AngleDegrees">
                        <value>30</value>
                    </angle>
                </shape>
                <affectGroup>Enemies</affectGroup>
                <radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
                    <value>15</value>
                </radius>
                <shapeCenterPosition>Caster</shapeCenterPosition>
            </Item>
        </casterImpacts>
    </mechanics>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>