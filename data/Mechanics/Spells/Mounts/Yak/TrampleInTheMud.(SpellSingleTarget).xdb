                                        <buff href="/Mechanics/Mounts/Prototypes/AntiNormalMountCC.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impactsOnAttach>
                                <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mul>0.05</mul>
                                    <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                                        <group href="/Mechanics/Mounts/Groups/Yak9Grade.(MountGroupResource).xdb#xpointer(/gameMechanics.constructor.schemes.mount.MountGroupResource)" />
                                    </mulCalcer>
                                    <sum>0.5</sum>
                                </durationScaler>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
