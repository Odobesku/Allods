<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>219664</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.Name.txt" />
    <description href="Ability.Description.txt" />
    <descVars>
        <Item>
            <name>prob</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Mounts/ManaBikePulse.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <targetImpacts>
                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value var="value" />
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </targetImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                        <spells>
                            <Item href="/Mechanics/Spells/Engineer/AirStrike/Spell01.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                        </spells>
                    </destination>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability02.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability03.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>