<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739873120</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>AI61_CommonerAtmo1</scriptID>
						<map href="/Maps/AstralIsle61/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactGoTo">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>AI61_Commoner1_point</scriptID>
									<map href="/Maps/AstralIsle61/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
								</locator>
							</destination>
							<runningMode>true</runningMode>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="AI61_Atmo1.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
									<delay>4000</delay>
									<impacts>
										<Item type="gameMechanics.elements.impacts.Disintegrate" />
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</onEnter>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
