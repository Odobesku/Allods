					<nodes>
						<Item>joint1</Item>
						<Item>Slot_Special01</Item>
					</nodes>
					<resistance>12</resistance>
					<spring>10</spring>
					<useDefaultGravity>true</useDefaultGravity>
				</Item>
			</chains>
			<ignoreVisObjMotion>false</ignoreVisObjMotion>
		</Item>
	</visObjComponents>
	<drawBehindCamera>false</drawBehindCamera>
	<softReplace>false</softReplace>
