<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<visActionID>readyspell</visActionID>
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>4000</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>readyspell</stoppedActionID>
					</Item>
					<Item type="CreatureAnimationAction">
						<visActionID>readyspell</visActionID>
						<mode>LOOP</mode>
						<animations>
							<Item>specialAttack</Item>
						</animations>
						<channel>CHANNEL_ATTACK</channel>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>1500</delay>
								<effectFx href="/Spells/FX/Mobs/TrollShaman_AOEBomb.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>2</scale>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
