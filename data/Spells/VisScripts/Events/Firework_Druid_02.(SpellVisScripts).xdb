<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes2/Omni_Instant.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FixPointCaster>true</FixPointCaster>
			<FxOnCaster>/Spells/FX/Spells/Events/Firework_Druid_02_Main.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnCaster>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>spells/DruidFirework/Firework02</name>
				</sound>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item skiped="" />
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
