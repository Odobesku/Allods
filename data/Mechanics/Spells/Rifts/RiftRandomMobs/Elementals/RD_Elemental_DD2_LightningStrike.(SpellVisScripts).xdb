<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureRunActionOnSpellTargets">
						<targetAction type="CreatureEffectsAction">
							<visualEffects>
								<Item>
									<effectFx href="/Spells/FX/Spells/DruidCallLightning.(VisObjectTemplate).xdb" />
								</Item>
							</visualEffects>
						</targetAction>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="CreatureRunVisActionResource">
			<resource href="/Spells/VisScripts/HitPostFxOnTarget/HitLightningShader.(CreatureVisActionResource).xdb" />
		</specialAction>
	</playOnTargets>
</SpellVisScripts>