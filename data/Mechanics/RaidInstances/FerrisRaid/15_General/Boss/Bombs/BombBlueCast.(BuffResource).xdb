<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739913676</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Buffs/BuffMagicBallBlue01.(UISingleTexture).xdb" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.basicElements.ImpactList">
							<impactsResource href="BluePortalOpens.(ImpactListResource).xdb" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<duration>15000</duration>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/RaidInstances/Phase1.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
