<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>361871371</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.constructor.schemes.buff.StackBuffGeneric">
                    <buff href="Bonus.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>20</value>
                    </delta>
                    <attachIfNotExist>true</attachIfNotExist>
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Bonus.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                    <impact type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                        <projectileData>
                            <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                    <base type="gameMechanics.map.destination.RelativePos" />
                                    <offset>10</offset>
                                </destination>
                            </moveType>
                            <resource href="Bonus.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                        </projectileData>
                    </impact>
                    <count type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                        <buff href="Bonus.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </count>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Creatures/GolemJunes/Instances/AstralIsle48/GolemJunes51_51.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        <Item href="/Creatures/GolemJunes/Instances/AstralIsle48/GolemWarrior.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        <Item href="/Creatures/GolemJunes/Instances/AstralIsle48/GolemMage.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        <Item href="/Creatures/GolemJunesMid/Instances/AstralIsle48/GolemAE.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactSetFaction">
                                    <faction href="/World/Factions/Wild.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.MobFilter" />
                </Item>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Bonus.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Activation.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <stacks type="gameMechanics.elements.calcers.FloatData">
                        <value>4</value>
                    </stacks>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>Enemies</affectGroup>
            <radius>12</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="MeleeRangeBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="MeleeRangeBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                        <range min="0" max="50" />
                        <withinRange>true</withinRange>
                        <minCandidatesCount>1</minCandidatesCount>
                        <targetCount>1</targetCount>
                    </selector>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Creatures/GolemJunes/Instances/AstralIsle48/FireDoT.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </predicate>
                            </Item>
                        </predicates>
                    </filter>
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Creatures/GolemJunes/Instances/AstralIsle48/FireDoT.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>12000</tick>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>