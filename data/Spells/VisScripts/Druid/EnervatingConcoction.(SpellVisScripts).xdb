			<LocatorOnCaster>Slot_TopFX</LocatorOnCaster>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>1000</delay>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownDisease.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<locator>Slot_Global</locator>
								<offendTime />
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectDiseaseWand.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>0.5</scale>
								<locator>Slot_Hand_L</locator>
								<offendTime />
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectDiseaseWand.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>0.5</scale>
								<locator>Slot_Hand_R</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/DruidEnervatingConcoction_loop.(VisObjectTemplate).xdb" />
						<locator>Slot_TopFX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
