                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                                            <level>0.5</level>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                                            <spell href="CrushingBlow.(SpellSingleTarget).xdb" />
                                            <duration>
                                                <second>4</second>
                                            </duration>
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
