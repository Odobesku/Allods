<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>312961</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/Architects/SelfShieldBuff_inst01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="/Mechanics/Creatures/ArchitectBot/Architects_inst_miniboss.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                            <ability href="Ferris4_ExoskeletonArchitector_inst.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="/Mechanics/Creatures/ArchitectBot/Architects_inst_miniboss.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                            </impacts>
                        </Item>
                    </impactsElse>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                                            <zone href="/Maps/Ferris4/ScriptZones/Ferris_4_5_2.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                            <impacts>
                                                <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                                                    <destination type="gameMechanics.map.destination.RelativePos" />
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.GoThroughPath">
                                                                            <path>
                                                                                <Item>
                                                                                    <scriptID>Ferris_4_inst_Zimina_5</scriptID>
                                                                                    <map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb#xpointer(/mapLoader.MapResource)" />
                                                                                </Item>
                                                                                <Item>
                                                                                    <scriptID>Ferris_4_inst_Zimina_5_1</scriptID>
                                                                                    <map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb#xpointer(/mapLoader.MapResource)" />
                                                                                </Item>
                                                                            </path>
                                                                        </Item>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                                            <delay>1000</delay>
                                                                            <impacts>
                                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                                    <buff href="Ferris_4_5_2_Assistant_move_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                                </Item>
                                                                            </impacts>
                                                                        </Item>
                                                                    </impacts>
                                                                    <object href="/Characters/Hadagan_female/Instances/Ferris4/Ferris4_Zimina_Kill.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                                    <pool href="/World/Quests/Ferris4/Ferris_4_5_1/Ferris_4_5_1_Random_pool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                    <assistantResource href="/World/Quests/Ferris4/Ferris_4_2_2/Ferris4_Zimina.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Ferris_4_5_2__stun_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                            <delay>500</delay>
                                            <impacts>
                                                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                                                    <assistantResource href="/World/Quests/Ferris4/Ferris_4_2_2/Ferris4_Zimina.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>