<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739889874</resourceId>
    </Header>
    <Name href="RiverPull.(BuffResource).Name.txt" />
    <Description href="RiverPull.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Psionic/PsionicTelekineticThrow.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="RiverCharge.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.tools.SelectorShuffle" />
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>3_pull</scriptID>
                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                    <finishImpacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                            <group href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
                                        </Item>
                                    </finishImpacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Mammoth/IceVortex/Vortex_HM.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>3_pull_start</scriptID>
                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                        </locator>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>3_pull</scriptID>
                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                </locator>
                            </destination>
                        </moveType>
                        <resource href="PullFX.(ProjectileResource).xdb" />
                    </projectileData>
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
        </Item>
    </effects>
    <duration>5000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Events/EventBuffs.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>