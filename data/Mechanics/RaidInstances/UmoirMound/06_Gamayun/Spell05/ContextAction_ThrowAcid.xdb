<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="VisActionDelay">
							<time>1000</time>
						</playWhile>
						<elements>
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Mobs/GT_5Boss_AcidPool_ProjectileSmall.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<explosionFx href="/Spells/FX/Spells/HitPoisonBig.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<theGe>20</theGe>
								<pointOnCaster type="VisPointLocator">
									<locator>Slot_Hand_R</locator>
									<member>Group</member>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator>Slot_FX</locator>
									<member>Group</member>
								</pointOnTarget>
								<offendTime />
							</Item>
							<Item type="CreatureVisActionStartThrow" />
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
		<stopOnDeath>false</stopOnDeath>
	</launch>
</SpellVisScripts>
