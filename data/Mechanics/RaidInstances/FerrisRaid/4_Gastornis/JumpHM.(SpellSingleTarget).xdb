<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739897413</resourceId>
    </Header>
    <Name href="JumpHM.(SpellSingleTarget).Name.txt" />
    <visualScripts href="JumpHM.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <minRange type="gameMechanics.elements.calcers.FloatData">
        <value>15</value>
    </minRange>
    <prepareDuration>1000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                <time>700</time>
                <impactsOnLand>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>8</radius>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                <minDamage>15</minDamage>
                                <maxDamage>15</maxDamage>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Prey02.(BuffResource).xdb" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>0.5</multiplier>
                        </durationScaler>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="JumpHM.(ClientData).xdb" />
                    </Item>
                </impactsOnLand>
                <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                <keepOnGround>false</keepOnGround>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>