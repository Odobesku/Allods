<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>187727</resourceId>
    </Header>
    <element>FIRE</element>
    <Name href="Boss03_SelfBurn.(SpellArea).Name.txt" />
    <visualScripts href="Boss03_SelfBurn.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>12000</prepareDuration>
    <targetType>STTSelf</targetType>
    <mechanics>
        <cooldown>
            <duration>300000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="Boss03_UndAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </mobs>
                    </Item>
                </predicates>
            </Item>
        </targetConditions>
        <channelingMechanics>
            <channelingBuff href="Boss03_SelfBurn_burn.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            <finishImpacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FloatData">
                            <value>4</value>
                        </mulCalcer>
                    </durationScaler>
                </Item>
            </finishImpacts>
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>60</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/AstarlIslands/AI61/AI61_Boss04/Boss03_SelfBurn_Stacks.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.creature.AvatarFilter" />
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                        <pool href="/Mechanics/InstanceModifiers/Addon5/SummonLimit.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        </impacts>
                    </Item>
                </impactsOn>
                <impactsOff>
                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                        <spell href="Boss03_AddBuffer.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                        <spell href="Boss03_SelfBurn_teleport.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                        <duration>45000</duration>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>60</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="/Mechanics/Spells/AstarlIslands/AI61/AI61_Boss04/Boss03_SelfBurn_Stacks.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.creature.AvatarFilter" />
                    </Item>
                </impactsOff>
            </Item>
        </casterChannelingEffects>
    </mechanics>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>60</radius>
    <needLosToTarget>true</needLosToTarget>
    <stopOnNoTargets>false</stopOnNoTargets>
</gameMechanics.constructor.schemes.spell.area.SpellArea>