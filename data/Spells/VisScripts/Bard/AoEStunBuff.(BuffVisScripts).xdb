<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/AoEStun_Main.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<scale>1.2</scale>
						<fadeInTime>400</fadeInTime>
						<fadeOutTime>400</fadeOutTime>
						<locator>Slot_Global</locator>
