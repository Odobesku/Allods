<?xml version ="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <precastType>PRECAST_DEFAULT</precastType>
    <launch type="VisActionList">
        <visActionID></visActionID>
        <elements>
            <Item type="CreatureSetFlagAction">
                <visActionID></visActionID>
                <flagName>Flag_MountNeeded</flagName>
                <timeOut>0.5</timeOut>
                <isSet>true</isSet>
                <onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
            </Item>
            <Item type="VisActionList">
                <visActionID></visActionID>
                <elements>
                    <Item type="VisActionDelay">
                        <visActionID></visActionID>
                        <time>500</time>
                    </Item>
                </elements>
                <play>InSequence</play>
                <playWhile type="PredicateCreatureFlagAction">
                    <visActionID></visActionID>
                    <flagName>Flag_Emote</flagName>
                    <checkIsSet>true</checkIsSet>
                    <checkOnMainAvatar>false</checkOnMainAvatar>
                </playWhile>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
            <Item type="VisActionList">
                <visActionID></visActionID>
                <elements>
                    <Item type="VisActionList">
                        <visActionID></visActionID>
                        <elements>
                            <Item type="CreatureHoldWeaponAction">
                                <visActionID></visActionID>
                                <hold>WEAPON_MELEE</hold>
                                <time>10000</time>
                                <boast>false</boast>
                            </Item>
                            <Item type="CreatureEffectsAction">
                                <visActionID></visActionID>
                                <category>EFFECT_DEFAULT</category>
                                <visualEffects>
                                    <Item>
                                        <delay>0</delay>
                                        <effectAnimations>
                                            <mode>DIE</mode>
                                        </effectAnimations>
                                        <effectFx href="/Spells/FX/Spells/PaladinBladeofJusticeAbility_Trail01.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                                        <fadeInTime>0</fadeInTime>
                                        <fadeOutTime>0</fadeOutTime>
                                        <scale>1</scale>
                                        <fixPoint>false</fixPoint>
                                        <lockScale>false</lockScale>
                                        <muteFxSounds>false</muteFxSounds>
                                        <ignoreParentRotation>false</ignoreParentRotation>
                                        <locator>Slot_FX</locator>
                                        <locatorName></locatorName>
                                        <member>Default_Member</member>
                                        <offset x="0" y="0" z="0"/>
                                        <rotation x="0" y="0" z="0" w="0"/>
                                        <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                                    </Item>
                                    <Item>
                                        <delay>0</delay>
                                        <effectAnimations>
                                            <mode>DIE</mode>
                                        </effectAnimations>
                                        <effectFx href="/Spells/FX/Spells/PaladinBladeofJusticeAbility_StartSmoke.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                                        <fadeInTime>0</fadeInTime>
                                        <fadeOutTime>0</fadeOutTime>
                                        <scale>1</scale>
                                        <fixPoint>true</fixPoint>
                                        <lockScale>false</lockScale>
                                        <muteFxSounds>false</muteFxSounds>
                                        <ignoreParentRotation>false</ignoreParentRotation>
                                        <locator>Global</locator>
                                        <locatorName></locatorName>
                                        <member>Default_Member</member>
                                        <offset x="0" y="0" z="0"/>
                                        <rotation x="0" y="0" z="0" w="0"/>
                                        <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                                    </Item>
                                </visualEffects>
                                <dontFade>false</dontFade>
                                <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                                <stopOnDeath>false</stopOnDeath>
                            </Item>
                            <Item type="CreatureTrailAction">
                                <visActionID></visActionID>
                                <lengthMSec>400</lengthMSec>
                                <mainHandTrail href="/Spells/FX/InterfaceFX/TrailBlood.(TrailTemplate).xdb#xpointer(/client.VisualConstructor.TrailTemplate)"/>
                                <useItemsMainHandTrail>false</useItemsMainHandTrail>
                            </Item>
                        </elements>
                        <play>InSequence</play>
                        <preconditional>false</preconditional>
                        <restartOnVisualChange>false</restartOnVisualChange>
                        <stopOnDeath>false</stopOnDeath>
                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                    </Item>
                </elements>
                <play>Simultaneously</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="VisActionDelay">
            <visActionID></visActionID>
            <time>2000</time>
        </playWhile>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </launch>
    <ownKillingParams>
        <probabilityNoOverkill>0.2</probabilityNoOverkill>
        <probabilityWithOverkill>1</probabilityWithOverkill>
    </ownKillingParams>
    <playOnTargets>
        <skipBloodFx>false</skipBloodFx>
        <skipHitAnimations>false</skipHitAnimations>
    </playOnTargets>
    <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>
