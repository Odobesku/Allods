												</Item>
												<Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
													<spell href="/Mechanics/Ships/Engine/Remote/Speed2.(SpellCasterSelf).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
												</Item>
