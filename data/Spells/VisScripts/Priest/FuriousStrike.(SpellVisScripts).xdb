			<Trail>/Spells/FX/InterfaceFX/TrailHoly.(TrailTemplate).xdb#xpointer(/TrailTemplate)</Trail>
			<FxOnTargets>/Spells/FX/Spells/PaladinBlindingStrike_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTargets>
