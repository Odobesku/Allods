<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>special</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>specialCast</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>idle</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>walk</Item>
						</animations>
					</Item>
					<Item type="Sound3DActionDevice">
						<sound>
							<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
							<name>spells/FX/World/FerrisRaid_TV_ScreenStele/Alarm</name>
						</sound>
					</Item>
				</elements>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>run</Item>
				</animations>
			</action>
		</Item>
	</states>
	<defaultVisAction type="DeviceAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>idle01</Item>
		</animations>
	</defaultVisAction>
</DeviceVisScripts>
