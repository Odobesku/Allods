<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states>
		<Item>
			<action type="DeviceVisActionChangeModel">
				<visObj href="/World/Dungeons/UmoirMound/Models/UM_Cyclopus_Room_Platform.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<collision href="/World/Dungeons/UmoirMound/Models/UM_Cyclopus_Room_Platform.(Collision).xdb#xpointer(/Collision)" />
			</action>
		</Item>
		<Item>
			<action type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceVisActionChangeModel">
						<visObj href="/World/Dungeons/UmoirMound/Models/UM_Cyclopus_Room_Platform_Broken.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<collision href="/World/Dungeons/UmoirMound/Models/UM_Cyclopus_Room_Platform_Broken.(Collision).xdb#xpointer(/Collision)" />
					</Item>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceAnimationAction">
								<mode>CLAMP</mode>
								<animations>
									<Item>special</Item>
								</animations>
							</Item>
						</elements>
					</Item>
					<Item type="DeviceVisActionList">
						<elements>
							<Item type="DeviceVisActionDelay">
								<time>400</time>
							</Item>
							<Item type="DeviceAnimationAction">
								<mode>CLAMP</mode>
								<animations>
									<Item>death</Item>
								</animations>
							</Item>
						</elements>
					</Item>
				</elements>
			</action>
		</Item>
	</states>
</DeviceVisScripts>
