<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/MageBlinkAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<effectAlias href="" />
				<fixPoint>true</fixPoint>
				<scale>2</scale>
				<locator>Slot_Global</locator>
				<member>Mount</member>
				<offendTime />
			</Item>
		</visualEffects>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="CreatureSetFlagAction">
					<flagName>Flag_MountNeeded</flagName>
					<timeOut>0.5</timeOut>
				</Item>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<delay>100</delay>
							<effectFx href="/Spells/FX/Spells/MageBlinkAbility_End.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<effectAlias href="" />
							<scale>2</scale>
							<locator>Slot_Global</locator>
							<member>Mount</member>
							<offendTime />
						</Item>
					</visualEffects>
				</Item>
				<Item type="CreatureAnimationAction">
					<animations>
						<Item>special06</Item>
					</animations>
					<channel>CHANNEL_DEATH</channel>
					<channelOverrideScript />
					<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
				</Item>
			</elements>
		</playWhile>
		<elements>
			<Item type="CreatureGeometryModifierAction">
				<fadeByCameraCollision>false</fadeByCameraCollision>
				<member>Mount</member>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
