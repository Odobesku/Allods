<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>193489</resourceId>
    </Header>
    <element>POISON</element>
    <Name href="AI38_Summon.(SpellArea).Name.txt" />
    <visualScripts href="/Mechanics/Spells/AstarlIslands/AI38/Packs/AI38_Turtle_Cleave.(SpellVisScripts).xdb" />
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>1000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                <level>0.9</level>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                    <buff href="AI38_Summon.(BuffResource).xdb" />
                                    <range>
                                        <min>4</min>
                                        <max>10</max>
                                    </range>
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateHasAbility">
                                    <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
                                </predicate>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                    <buff href="AI38_Summon.(BuffResource).xdb" />
                                    <range>
                                        <min>2</min>
                                        <max>2</max>
                                    </range>
                                </predicate>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="AI38_Summon.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
                            <alternatives>
                                <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                    <verticalRange min="0" max="0" />
                                    <horizontalRange min="7" max="12" />
                                </Item>
                            </alternatives>
                            <safetyRadius>0.05</safetyRadius>
                        </Item>
                    </modifiers>
                </destination>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                    <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                </impacts>
                <object href="AI38_Boss02_Adds.(MobWorld).xdb" />
                <pool href="/Mechanics/Spells/AstarlIslands/AI38/Packs/AI38_Kitty.(SummonPool).xdb" />
            </Item>
        </targetImpacts>
    </mechanics>
    <maxTargets>1</maxTargets>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>45</value>
        </angle>
    </shape>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>15</radius>
    <stopOnNoTargets>false</stopOnNoTargets>
</gameMechanics.constructor.schemes.spell.area.SpellArea>