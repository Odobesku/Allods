                                            <proceduralEffect href="/Spells/FX/InterfaceFX/LightningExoskeleton01.(ProceduralEffect).xdb#xpointer(/ProceduralEffect)" />
                                        </Item>
                                    </elements>
                                </Item>
                                <Item type="VisActionList">
                                    <playWhile type="VisActionDelay">
                                        <time>75</time>
                                    </playWhile>
