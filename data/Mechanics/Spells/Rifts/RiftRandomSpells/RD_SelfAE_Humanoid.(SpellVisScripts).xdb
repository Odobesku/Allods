<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellOmni</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectIce.(VisObjectTemplate).xdb" />
                        <locator>Slot_Hand_L</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectIce.(VisObjectTemplate).xdb" />
                        <locator>Slot_Hand_R</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Mammoth_ReadySpell_HeavyStomp.(VisObjectTemplate).xdb" />
                        <scale>0.6</scale>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Red.(VisObjectTemplate).xdb" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/Mage_IceComet.(VisObjectTemplate).xdb" />
                        <fixPoint>true</fixPoint>
                        <lockScale>true</lockScale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>