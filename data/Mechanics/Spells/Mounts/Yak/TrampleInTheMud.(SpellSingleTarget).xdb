        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMounted" />
            <Item type="gameMechanics.elements.predicates.PredicateMountFromGroupFeeded">
                <group href="/Mechanics/Mounts/Groups/Yak9Grade.(MountGroupResource).xdb#xpointer(/gameMechanics.constructor.schemes.mount.MountGroupResource)" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAvatarJump">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.map.destination.RelativePos">
                        <faceSourcePos>false</faceSourcePos>
                    </destination>
                    <modifiers>
