<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739906511</resourceId>
	</Header>
	<Name href="Slime_BombAura.(BuffResource).Name.txt" />
	<visScript href="Slime_BombAura.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>3000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.TickableAura">
					<affectGroup>All</affectGroup>
					<radius>4</radius>
					<filter type="gameMechanics.constructor.basicElements.FilterAnd">
						<filters>
							<Item type="gameMechanics.world.creature.AvatarFilter" />
							<Item type="gameMechanics.world.creature.AliveFilter" />
						</filters>
					</filter>
					<blinking>true</blinking>
					<holderImpactsIn>
						<Item type="gameMechanics.elements.impacts.ImpactKill" />
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<radius>10</radius>
							<affectGroup>Enemies</affectGroup>
							<affectHolder>false</affectHolder>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>POISON</element>
									<damage>30</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="HitPoisonBig.(ClientData).xdb" />
						</Item>
					</holderImpactsIn>
				</Item>
			</effects>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
