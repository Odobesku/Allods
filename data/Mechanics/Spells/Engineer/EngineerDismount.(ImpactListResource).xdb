<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>739890948</resourceId>
    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="ArtilleryForm/Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateMounted">
                            <specificGroup href="/Mechanics/Mounts/Groups/ExoMounts.(MountGroupResource).xdb#xpointer(/gameMechanics.constructor.schemes.mount.MountGroupResource)" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <elseImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactDismount" />
            </elseImpacts>
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>