                        <value>332</value>
                    </predicate>
                </predicate>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                        <currency href="/Mechanics/AlternativeCurrencies/Astral/Addon5TotalUnlock.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                        <multiplier>5</multiplier>
                    </Item>
                </actions>
            </Item>
        </actions>
    </functionalPart>
    <level>60</level>
    <requiredLevel>60</requiredLevel>
    <stackLimit>100</stackLimit>
    <quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <lifeLengthCap>86400000</lifeLengthCap>
    <name href="GiveUnlock01.(ItemResource).Name.txt" />
