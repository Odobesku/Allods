<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="CreatureAnimationAction">
		<animations>
			<Item>specialAttack</Item>
		</animations>
	</launch>
	<playOnTargets>
		<specialAction type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<locator>Slot_FX</locator>
				</Item>
			</visualEffects>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
