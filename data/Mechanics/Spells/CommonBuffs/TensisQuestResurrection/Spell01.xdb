<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>200263</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Resurrection.(ActionGroup).xdb" />
    </groups>
    <element>HOLY</element>
    <Name href="Spell_Name.txt" />
    <Description href="Spell_Desc.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestResurrect.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Priest/Resurrection.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <level>2</level>
    <prepareDuration>3000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTCurrentTarget</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <isWorkOnDead>true</isWorkOnDead>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <stage>Launch</stage>
            <duration>60000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            <Item type="gameMechanics.elements.predicates.PredicateIsDead" />
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateResurrectActive" />
            </Item>
        </targetConditions>
        <conditions>
            <Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
                <affectGroup>Raid</affectGroup>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
                <hideText>true</hideText>
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                        <onMaster type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                        </onMaster>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                        <onMaster type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                <buff href="/Mechanics/RaidInstances/BattleResLimit/NoResSmallRaid.(BuffResource).xdb" />
                                <range>
                                    <min>2</min>
                                    <max>2</max>
                                </range>
                            </predicate>
                        </onMaster>
                        <onSlave type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                <buff href="/Mechanics/RaidInstances/BattleResLimit/NoResSmallRaid.(BuffResource).xdb" />
                                <range>
                                    <min>2</min>
                                    <max>2</max>
                                </range>
                            </predicate>
                        </onSlave>
                    </Item>
                </predicates>
            </Item>
        </conditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.Resurrect">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactBaseHealth">
                        <healthMultiplier>0.4</healthMultiplier>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="/Mechanics/Spells/CommonSpells/TeleportToResurrecter/TensisQuest.(ImpactListResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactsToUnionMembers">
                                <affectPets>false</affectPets>
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/RaidInstances/BattleResLimit/NoResSmallRaid.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                                        <spell href="Spell01.xdb" />
                                        <duration>300000</duration>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                        <elseImpacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Buff01.xdb" />
                            </Item>
                        </elseImpacts>
                    </Item>
                </impacts>
                <timeOut>30000</timeOut>
                <force>true</force>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>0</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>