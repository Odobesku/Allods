                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                            <destination type="gameMechanics.map.destination.RelativePos" />
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.AttachAbility">
                                                    <ability href="/Mechanics/Abilities/StandartSummoned/Ability01.xdb" />
                                                </Item>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="Threat.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <object href="Backstabber.xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="BackstabberSpawn.(BuffResource).xdb" />
                                            <anyRank>false</anyRank>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                            <impactsLose>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="BackstabberSpawn.(BuffResource).xdb" />
                                </Item>
                            </impactsLose>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>4000</tick>
            <initialDelay>-1</initialDelay>
