<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>InSequence</play>
		<playWhile />
		<elements>
			<Item type="VisActionDelay">
				<time>200</time>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>spellCastOmni</Item>
						</animations>
						<channelOverrideScript />
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/MountScorpion_StunWave_FX.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>0.8</scale>
								<fadeInTime>1</fadeInTime>
								<offendTime />
								<offset x="-0.8" y="-2.5" z="-0.1" />
							</Item>
						</visualEffects>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>100</delay>
								<effectFx href="/Spells/FX/Spells/MountScorpion_StunWave_FX.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>0.8</scale>
								<fadeInTime>1</fadeInTime>
								<offendTime />
								<offset x="0.5" y="-2.5" z="-0.1" />
							</Item>
						</visualEffects>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/MountScorpion_StunWave_Cleave.(VisObjectTemplate).xdb" />
								<effectAlias href="" />
								<scale>1.05</scale>
								<fadeInTime>1</fadeInTime>
								<offendTime />
								<offset y="-1" z="0.3" />
							</Item>
						</visualEffects>
						<restartOnVisCreatureChange>false</restartOnVisCreatureChange>
					</Item>
				</elements>
			</Item>
		</elements>
		<stopOnDeath>false</stopOnDeath>
		<restartOnVisualChange>true</restartOnVisualChange>
	</actionBarStart>
</SpellVisScripts>
