                    </Item>
                </impactsPerTick>
            </parameters>
            <element>FIRE</element>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.MagicScaler"></Item>
                    <Item type="gameMechanics.elements.scalers.AbilityRankScaler">
                        <ability href="/Mechanics/Spells/Priest/PassiveTalents/Concentration/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
