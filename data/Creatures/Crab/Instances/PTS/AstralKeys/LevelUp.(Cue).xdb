<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.world.mob.interaction.Cue>
	<Header>
		<resourceId>739919142</resourceId>
	</Header>
	<name href="LevelUp.(Cue).Name.txt" />
	<text href="LevelUp.(Cue).Text.txt" />
	<conditions>
		<Item type="gameMechanics.constructor.basicElements.PredicateNot">
			<predicate type="gameMechanics.elements.predicates.PredicateCreatureLevel">
				<minLevel type="gameMechanics.formulas.MaxLevelConstant" />
			</predicate>
		</Item>
		<Item type="gameMechanics.elements.predicates.PredicateUnlock">
			<unlock href="/Mechanics/Unlocks/AltCurrencies/AstralKeys.(UnlockResource).xdb" />
		</Item>
	</conditions>
	<impacts>
		<Item type="gameMechanics.elements.impacts.ImpactAddExperience">
			<calcer type="gameMechanics.elements.calcers.CalcerRemainingExpirience">
				<level type="gameMechanics.elements.calcers.CalcerLevelCap" />
			</calcer>
			<direct>true</direct>
			<scaleByGlobal>false</scaleByGlobal>
		</Item>
	</impacts>
	<nextCues>
		<Item href="Greetings.(Cue).xdb" />
	</nextCues>
</gameMechanics.world.mob.interaction.Cue>
