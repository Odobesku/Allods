<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>197149</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Buff00.(BuffResource).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/StalkerRapidFire.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.ImpactsOverTime">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                    <scalers>
                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                <externalCalcer hrefvar="calcerDamage" />
                                            </mulCalcer>
                                        </Item>
                                        <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                                        <Item type="gameMechanics.elements.scalers.WeaponDpsScaler">
                                            <source>Ranged</source>
                                        </Item>
                                    </scalers>
                                </scaler>
                                <avgDamage>1</avgDamage>
                                <source>Ranged</source>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="TickMark.(MarkResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <tick>500</tick>
            </effect>
            <ticksCount>8</ticksCount>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="RegenMateriel.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RangedAttacks.xdb" />
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Stalker63/Abilities/ColdSteel/DamageUp.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>