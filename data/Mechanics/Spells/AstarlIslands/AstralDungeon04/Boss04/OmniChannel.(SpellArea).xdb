<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739951862</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/RaidInstances/Phase1.(ActionGroup).xdb" />
	</groups>
	<element>SHADOW</element>
	<Name href="OmniChannel.(SpellArea).Name.txt" />
	<visualScripts href="OmniChannel.(SpellVisScripts).xdb" />
	<prepareDuration>3000</prepareDuration>
	<targetType>STTSelf</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>10000</duration>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
				<spell href="/Mechanics/Spells/AutoAttack/MeleeDamage.xdb" />
				<duration>
					<second>3</second>
				</duration>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
				<element>SHADOW</element>
				<scalerTarget type="gameMechanics.elements.scalers.ScalerAddBuff">
					<buff href="AOEDebuff.(BuffResource).xdb" />
					<buffStackFactor>20</buffStackFactor>
				</scalerTarget>
				<damage>45</damage>
				<impactsOnHitTarget>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="AOEDebuff.(BuffResource).xdb" />
					</Item>
				</impactsOnHitTarget>
				<scaler type="gameMechanics.elements.scalers.MagicScaler" />
			</Item>
		</targetImpacts>
	</mechanics>
	<radius>100</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
