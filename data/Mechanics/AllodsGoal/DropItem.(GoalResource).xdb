<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.elements.goals.GoalResource>
    <Header>
        <resourceId>261492</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <title href="AC2.(GoalResource).Title.txt" />
    <showPredicates>
        <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
            <lhs type="itemService.serverVariables.CalcerServerVariable">
                <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
            </lhs>
            <rhs type="gameMechanics.elements.calcers.LongData">
                <value>0</value>
            </rhs>
        </Item>
    </showPredicates>
    <finishPredicates>
        <Item type="gameMechanics.elements.predicates.PredicateHasItem">
            <slotType>ItemBag</slotType>
            <predicates>
                <Item type="gameMechanics.elements.item.ItemPredicateLevel">
                    <range>
                        <min>71</min>
                        <max>77</max>
                    </range>
                </Item>
                <Item type="gameMechanics.elements.item.ItemPredicateDressable" />
                <Item type="gameMechanics.elements.item.ItemPredicateQualityGreaterOrEqual">
                    <quality hrefvar="quality" />
                </Item>
            </predicates>
        </Item>
    </finishPredicates>
    <targetLevel>67</targetLevel>
</gameMechanics.elements.goals.GoalResource>