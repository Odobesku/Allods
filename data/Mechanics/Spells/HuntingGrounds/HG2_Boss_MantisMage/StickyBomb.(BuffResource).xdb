<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739851448</resourceId>
    </Header>
    <Name href="StickyBomb.(BuffResource).Name.txt" />
    <Description href="StickyBomb.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/NekromanMine.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="StickyBombAcid.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="StickyBomb.(BuffResource).Name.txt" />
    <descTemplate href="StickyBomb.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Aura">
            <checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
            <radius>7</radius>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ExplosionWarnSticky.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ExplosionWarnSticky.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.DirectDamage">
                    <damage>1</damage>
                    <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.12</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="BombExplosion.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>16</radius>
                    <affectGroup>Friends</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ACID</element>
                            <damage>30</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterOr">
                        <filters>
                            <Item type="gameMechanics.world.creature.AvatarFilter">
                                <withPet>true</withPet>
                            </Item>
                        </filters>
                    </filter>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>11000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>