<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739940032</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="WW_6_15_mob.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="/World/Quests/Ferris4/Ferris_4_5_1/Ferris_4_5_1_Mob_spawn.(ClientData).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                            <ability href="WW_6_15_mob.(AbilityResource).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </onLeave>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>