<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>241607</resourceId>
    </Header>
    <Name href="Arena_AntiHeal.(BuffResource).Name.txt" />
    <Description href="Arena_AntiHeal.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/WeaknessTenses.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMounted">
                                    <specificGroup href="/Mechanics/Mounts/Groups/ExoMounts.(MountGroupResource).xdb" />
                                </Item>
                            </predicates>
                            <elseImpacts>
                                <Item type="gameMechanics.elements.impacts.ImpactDismount" />
                            </elseImpacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <affectsPureHeal>true</affectsPureHeal>
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.01</coeff>
            </scaler>
        </Item>
    </effects>
    <stackLimit>100</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>