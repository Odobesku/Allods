<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="DelayComponent">
						<timeMin>0.1</timeMin>
						<timeMax>0.1</timeMax>
						<component type="AttachedVisObjectComponent">
							<visObject href="/Spells/FX/Spells/FireThrower_Fire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<scale>0.5</scale>
							<offset y="-1" />
							<locatorName>Global</locatorName>
							<lockScale>true</lockScale>
						</component>
					</Item>
				</visObjComponents>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
