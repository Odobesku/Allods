<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739936262</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Buffs/BuffMagicBallBlue01.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Mobs/Jaga_BlueSpark_Hit.(VisObjectTemplate).xdb" />
			<locator>Slot_FX</locator>
		</Item>
		<Item>
			<delay>250</delay>
			<effectFx href="/Spells/FX/Mobs/Jaga_BallRecently_Blue.(VisObjectTemplate).xdb" />
			<fadeInTime>500</fadeInTime>
			<fadeOutTime>500</fadeOutTime>
			<locator>Slot_Global</locator>
		</Item>
	</visualEffects>
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.NotStackableEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.EffectInstantiating">
					<effects>
						<Item type="gameMechanics.elements.effects.TickableAura">
							<tick>1000</tick>
							<affectGroup>All</affectGroup>
							<radius>6</radius>
							<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
									<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
								</predicates>
							</filter>
							<impactsIn>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="AvatarLink.(BuffResource).xdb" />
								</Item>
							</impactsIn>
							<impactsOut>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="AvatarLink.(BuffResource).xdb" />
									<casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
								</Item>
							</impactsOut>
						</Item>
						<Item type="gameMechanics.elements.effects.EffectDeferredEffects">
							<delay type="gameMechanics.elements.calcers.CalcerLongIf">
								<predicate type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
									<buff href="DeadlyChannelTargetBuff.(BuffResource).xdb" />
									<range>
										<min>2</min>
										<max>2</max>
									</range>
								</predicate>
								<calcerIf type="gameMechanics.elements.calcers.LongData">
									<value>0</value>
								</calcerIf>
								<calcerElse type="gameMechanics.elements.calcers.LongData">
									<value>500</value>
								</calcerElse>
							</delay>
							<effects>
								<Item type="gameMechanics.elements.effects.ImpactsOverTime">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
											<radius>6</radius>
											<affectHolder>false</affectHolder>
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
													<predicates>
														<Item type="gameMechanics.elements.resources.ResourceBuff">
															<buff href="DeadlyChannelTargetBuff.(BuffResource).xdb" />
														</Item>
													</predicates>
													<impactsIf>
														<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
															<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
															<data href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Impulse/OppositeImpulses.(ClientData).xdb" />
															<calcers>
																<addressEntries>
																	<Item>
																		<name>caster</name>
																		<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
																	</Item>
																	<Item>
																		<name>target</name>
																		<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
																	</Item>
																</addressEntries>
															</calcers>
														</Item>
													</impactsIf>
												</Item>
											</impacts>
											<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
												<predicates>
													<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
													<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
												</predicates>
											</filter>
										</Item>
									</impacts>
									<tick>500</tick>
								</Item>
							</effects>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</effects>
	<duration>15000</duration>
	<stackLimit>2</stackLimit>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/AstralIslandSpells.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
