<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.basicElements.MapModifierResource>
    <Header>
        <resourceId>252213</resourceId>
    </Header>
    <name href="PricklyAir.txt" />
    <description href="PricklyAir.Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/PricklyAir.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <mapEffects>
        <Item type="gameMechanics.elements.effects.AddMapSpecificEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
                            <onEnter>
                                <Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
                                    <phantom href="Phantom.xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="PhantomBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </onEnter>
                            <onLeave>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="PhantomBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </onLeave>
                        </Item>
                    </effectsIf>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    </predicates>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="PhantomBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </mapEffects>
    <weight>3</weight>
    <exclusions>
        <Item href="/Maps/AstralIsle61/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
        <Item href="/Maps/AstralIsle58_UI06/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
    </exclusions>
</gameMechanics.map.basicElements.MapModifierResource>