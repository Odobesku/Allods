<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>187474</resourceId>
    </Header>
    <Name href="Boss01_WerewolfAE.(SpellArea).Name.txt" />
    <visualScripts href="Boss01_WerewolfAE.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>2500</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="AI63_Boss01_Werewolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </mobs>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>10</radius>
                <affectGroup>Enemies</affectGroup>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        <minDamage>35</minDamage>
                        <maxDamage>35</maxDamage>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impacts>
                <impactsOnTargetsFound>
                    <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                </impactsOnTargetsFound>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/AstarlIslands/AI63/AI63_StopMove.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                <spell href="Boss01_ChangeForm.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <duration>1000</duration>
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>