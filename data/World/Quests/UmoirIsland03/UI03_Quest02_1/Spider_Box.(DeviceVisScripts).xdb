<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states>
		<Item>
			<action type="DeviceAnimationAction">
				<animations>
					<Item>idle</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<animations>
					<Item>special</Item>
				</animations>
			</action>
			<prevState>1</prevState>
		</Item>
	</states>
	<defaultVisAction type="DeviceAnimationAction">
		<animations>
			<Item>idle</Item>
		</animations>
	</defaultVisAction>
</DeviceVisScripts>
