    <Name href="FillerAttack.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Common/AutoAttackMelee.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>4000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <threatMultiplier>0</threatMultiplier>
                <minDamage>25</minDamage>
                <maxDamage>30</maxDamage>
            </Item>
            <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>0.2</value>
                </chanceCalcer>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <durationScaler type="gameMechanics.elements.scalers.RandomScaler">
                            <range>
                                <min>2</min>
                                <max>3</max>
                            </range>
                        </durationScaler>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>