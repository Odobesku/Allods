<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>207656</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.(AbilityResource).Name.txt" />
    <description href="Ability.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaSeconds</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Mage/MageHarmony.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="Mark.(MarkResource).xdb" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="CD.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value>0.2</value>
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Buff.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="CD.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier var="value" />
                                    </durationScaler>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
        <Item href="Ability04.(AbilityResource).xdb" />
        <Item href="Ability05.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>