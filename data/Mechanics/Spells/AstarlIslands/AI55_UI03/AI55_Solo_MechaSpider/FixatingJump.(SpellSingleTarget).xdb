<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>186339</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MountSpeedBoosts.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="FixatingJump.(SpellSingleTarget).Name.txt" />
    <Description href="FixatingJump.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/BattleMountZemFixation.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="FixatingJump.(SpellSingleTarget)_Name.txt.template" />
    <descTemplate href="FixatingJump.(SpellSingleTarget)_Desc.txt.template" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>20000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="JumpBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                <time>2000</time>
                <impactsOnLand>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="JumpBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>5</radius>
                                <affectGroup>Enemies</affectGroup>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                        <minDamage>50</minDamage>
                                        <maxDamage>50</maxDamage>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterOr">
                                    <filters>
                                        <Item type="gameMechanics.world.creature.AvatarFilter" />
                                        <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </filters>
                                </filter>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor">
                            <radius>25</radius>
                        </distributor>
                        <data href="/Mechanics/Spells/AstarlIslands/UI03/PlotMain/Boss/EarthShake.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impactsOnLand>
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierRelativePolar">
                            <radius type="gameMechanics.elements.calcers.FloatData">
                                <value>2</value>
                            </radius>
                            <angle type="constructor.basicElements.AngleRadians" />
                        </Item>
                        <Item type="gameMechanics.map.destination.modifier.ModifierIfCheckPath">
                            <pathChecker type="space.pathfinding.pathChecker.PathDeviationLimited">
                                <angle>1.5708</angle>
                            </pathChecker>
                            <modifierElse type="gameMechanics.map.destination.modifier.ModifierTrailFrom" />
                        </Item>
                    </modifiers>
                </destination>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Fixation.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>