                                            <Item href="/Mechanics/RaidInstances/FerrisRaid/11_Clone_Elf/ElfOnTank/ElfOnTank.(MobWorld).xdb" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </filter>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>5000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>true</canBeSaved>
    <isAE>true</isAE>
    <groups>
