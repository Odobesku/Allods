<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>211046</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerCorrosiveAcid.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/VisScripts/Necromancer/CorrosiveAcid.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <damageType>Damage</damageType>
            <eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateSubElement">
                    <subElement>ACID</subElement>
                </Item>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
            </predicates>
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ACID</element>
                        <damage var="damage" />
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.elements.impacts.StackBuff">
                                <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <resetTimer>false</resetTimer>
                                <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                <delta type="gameMechanics.elements.calcers.FloatData">
                                    <value>-1</value>
                                </delta>
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </casterToTarget>
            </impacts>
            <scaleImpactsByDamage>false</scaleImpactsByDamage>
        </Item>
    </effects>
    <duration>15000</duration>
    <isStackable>true</isStackable>
    <stackLimit>5</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>false</isHelpful>
    <isDetachableOnWill>false</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff03.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
    </ranks>
    <canBeSaved>true</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Poisons.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>