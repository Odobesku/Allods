<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>241295</resourceId>
    </Header>
    <name href="Disable.(AbilityResource).Name02.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                    <spell href="/World/Quests/UmoirIsland01/UI01_Q05/AssistantDisable.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                </Item>
            </onEnter>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.4</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/World/Quests/UmoirIsland01/UI01_Q05/AssistantDisBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="/Characters/Kania_male/Instances/UmoirIsland01/Assistant_UI01_Unity.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/World/Quests/UmoirIsland01/UI01_Q03/HasAssistant.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>Assistant</scriptID>
                                    <map href="/Maps/UmoirIsland01/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                </locator>
                            </destination>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Characters/Kania_male/Instances/UmoirIsland01/AssistantImmune.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <object href="/Characters/Kania_male/Instances/UmoirIsland01/AssistantFinal.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/World/Quests/UmoirIsland01/UI01_Q03/HasAssistant.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.2</multiplier>
            </healthOn>
            <impactsOn>
