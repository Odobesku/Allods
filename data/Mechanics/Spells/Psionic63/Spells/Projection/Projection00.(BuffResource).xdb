<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739924395</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Projection00.(BuffResource).Name.txt" />
	<Description href="Projection00.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Psionic/PsionicDominate.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Psionic/Projection.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.9</coeff>
			</scaler>
			<predicates>
				<Item type="gameMechanics.elements.predicates.offender.PredicateIsAE" />
			</predicates>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.Disintegrate" />
				<Item type="gameMechanics.elements.impacts.ImpactsToMaster">
					<impacts>
						<Item type="gameMechanics.elements.impacts.StackBuff">
							<buff href="ProjCounter.(BuffResource).xdb" />
							<resetTimer>false</resetTimer>
							<delta type="gameMechanics.elements.calcers.FloatData">
								<value>-1</value>
							</delta>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.MultiplyStat">
			<stat type="gameMechanics.elements.stat.StatFullHealth" />
			<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mulCalcer type="constructor.elements.CalcerFloatExternal">
					<externalCalcer hrefvar="calcerHP" />
				</mulCalcer>
			</scaler>
		</Item>
	</effects>
	<duration>1000</duration>
	<isHelpful>true</isHelpful>
	<ranks>
		<Item href="Projection01.(BuffResource).xdb" />
		<Item href="Projection02.(BuffResource).xdb" />
		<Item href="Projection03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
