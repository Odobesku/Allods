<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>225657</resourceId>
    </Header>
    <Name href="GeneratorLink.(BuffResource).Name.txt" />
    <Description href="GeneratorLink.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffURConnectionLine.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
            <impactsIn type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine$ImpactsPack">
                <impactsFromCaster>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>HOLY</element>
                                <damage>10</damage>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="GeneratorLinkDamage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsFromCaster>
            </impactsIn>
            <impactsOut type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine$ImpactsPack">
                <impactsFromCaster>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="GeneratorLinkDamage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsFromCaster>
            </impactsOut>
            <maxLength>85</maxLength>
            <reconnect>true</reconnect>
            <height>10</height>
            <width>3</width>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="BossCharge.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="GeneratorLink.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    <calcers>
                        <addressEntries>
                            <Item>
                                <name>caster</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </Item>
                            <Item>
                                <name>target</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                            </Item>
                        </addressEntries>
                    </calcers>
                </Item>
            </impacts>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>