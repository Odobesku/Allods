<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739865399</resourceId>
	</Header>
	<name href="Bomb_Explosion.(ProjectileResource).Name.txt" />
	<visObject href="Bomb_Explosion.(VisObjectTemplate).xdb" />
	<altitude>0.1</altitude>
	<lifeLengthCap>3000</lifeLengthCap>
	<impactsOnStart>
		<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
			<delay>500</delay>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
					<phantom href="/Mechanics/InstanceModifiers/PricklyAir/Phantom.xdb" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
							<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
							<radius>5</radius>
							<affectGroup>Enemies</affectGroup>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>ACID</element>
									<damage>75</damage>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateOr">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
											</Item>
										</predicates>
									</Item>
									<Item type="gameMechanics.constructor.basicElements.PredicateNot">
										<predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
											<groups>
												<Item href="/Mechanics/InstanceModifiers/Addon5/Not_Astral_Modifiers.(ActionGroup).xdb" />
											</groups>
										</predicate>
									</Item>
								</predicates>
							</filter>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</impactsOnStart>
</gameMechanics.world.projectile.ProjectileResource>
