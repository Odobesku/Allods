        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>1</duration>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>-20000</mul>
                <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                    <summands>
                        <Item type="gameMechanics.elements.calcers.ItemQualityCalcer">
                            <dressSlot>AMMO</dressSlot>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value>-1</value>
                        </Item>
                    </summands>
                </mulCalcer>
                <sum>300000</sum>
            </scaler>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateEquipped">
                        <dressType>AMMO</dressType>
                        <itemClass href="/Mechanics/ItemClasses/Other_InfiniteTeardrop.(ItemClass).xdb" />
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.constructor.basicElements.ResourceUniversal" />
                <resourceElse type="gameMechanics.elements.resources.ResourceDressItem">
                    <slot>AMMO</slot>
                    <count>5</count>
                </resourceElse>
            </Item>
        </casterResources>
        <channelingMechanics>
            <channelingBuff hrefvar="channelingBuff" />
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/Druid70/Abilities/CastOnMove/Buff.(BuffResource).xdb" />
                    </Item>
