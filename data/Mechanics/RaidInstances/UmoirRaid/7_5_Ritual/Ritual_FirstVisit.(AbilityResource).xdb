<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739872900</resourceId>
	</Header>
	<visualScript type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>special</Item>
		</animations>
		<channel>CHANNEL_ABILITY</channel>
	</visualScript>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.map.variables.PredicateMapVariableGreater">
							<variableResource href="Ritual_FirstVisit.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
							<minValue type="gameMechanics.elements.calcers.FloatData">
								<value>0</value>
							</minValue>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
							<ability href="Ritual_FirstVisit.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="/Mechanics/RaidInstances/UmoirRaid/2_KtulhuBoss/NoTargeting.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectNoAggro" />
		<Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
