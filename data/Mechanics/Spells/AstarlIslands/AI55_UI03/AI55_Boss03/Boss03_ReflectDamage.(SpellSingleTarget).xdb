                                    <Item href="AI55_SpiderAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="AI55_ZEMMyAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                </mobs>
