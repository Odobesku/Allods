<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<defaultVisAction type="DeviceVisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="CS_Guerrila.(VisualFlag).xdb" />
				<visScriptStart type="DeviceVisActionList">
					<elements>
						<Item type="ShowSceneAction">
							<scene href="CutScene_Guerrilla.(GameViewScene).xdb" />
							<script href="/Maps/ZC12/GlobalObjects/Scripts/CutScenes_Guerrilla/CutScenes_Guerrilla_Script.(GameViewScript).xdb" />
						</Item>
					</elements>
				</visScriptStart>
			</Item>
			<Item type="DeviceVisActionChangeModel">
				<visObj href="/World/Astral/AstralIsles/Models/AI48/AI48_Palm_02_Snow.(VisObjectTemplate).xdb" />
				<collision href="/World/Astral/AstralIsles/Models/AI48/AI48_Palm_02_Snow.(Collision).xdb" />
			</Item>
			<Item type="DeviceVisActionChangeModel">
				<visObj href="/World/TepIsland/IllusionWorld/Models/Flora/IW_Palm_02.(VisObjectTemplate).xdb" />
				<collision href="/World/TepIsland/IllusionWorld/Models/Flora/IW_Palm_02.(Collision).xdb" />
			</Item>
		</elements>
	</defaultVisAction>
</DeviceVisScripts>
