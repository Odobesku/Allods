<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound/>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>200</fadeInMS>
    <fadeOutMS>200</fadeOutMS>
    <particle href="/Spells/FX/World/Torch02Red.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)"/>
    <scale>6</scale>
    <sound>
        <name>World/Flame/BigCampfire</name>
        <project href="/SFX/World/World.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)"/>
    </sound>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>
