<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.WeatherCreatureVisAction">
        <params>
          <ambientSoundImpact>Nothing</ambientSoundImpact>
          <colorGradingSettings />
          <fadeTime>3</fadeTime>
          <light>
            <AmbientColor>-14208919</AmbientColor>
            <AmbientFactor>1</AmbientFactor>
            <ContourColor>2971039</ContourColor>
            <DiffuseColor>-15519159</DiffuseColor>
            <FadeEnd>600</FadeEnd>
            <FadeStart>300</FadeStart>
            <FogColor>-15786166</FogColor>
            <FogEnd>600</FogEnd>
            <FogStart>-10</FogStart>
            <GrassContourColorMultiplier>-16109495</GrassContourColorMultiplier>
            <PointLightColor>-11296870</PointLightColor>
            <SelfIllumColor>-13817444</SelfIllumColor>
            <SpecularColor>-12892755</SpecularColor>
            <SpecularWaterColor>2240162</SpecularWaterColor>
            <SunLightPitch>195</SunLightPitch>
            <SunLightYaw>55</SunLightYaw>
            <TerrainContourColor>-16642526</TerrainContourColor>
            <TerrainContourPower>6</TerrainContourPower>
            <TerrainSpecularColor>-15382178</TerrainSpecularColor>
            <WaterGradientEnd>-16380894</WaterGradientEnd>
            <WaterGradientStart>-14928535</WaterGradientStart>
            <desaturation>0</desaturation>
            <minAmbientOcclusionValue>0</minAmbientOcclusionValue>
            <objectsLightmapBias>0.0125</objectsLightmapBias>
            <terrainLightmapBias>0.01</terrainLightmapBias>
          </light>
          <posteffectFogSettings>
            <brightness>1</brightness>
            <color>-1</color>
            <colorUp>-1</colorUp>
            <densityDown>0</densityDown>
            <densityUp>0</densityUp>
            <distanceSettings>
              <falloff>0.5</falloff>
              <maxDistance>400</maxDistance>
              <minDistance>0</minDistance>
            </distanceSettings>
            <heightSettingsDown>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsDown>
            <heightSettingsUp>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsUp>
            <sunSettings>
              <brightness>0.2</brightness>
            </sunSettings>
            <use>false</use>
          </posteffectFogSettings>
          <priority>HIGH</priority>
          <skyMesh href="/World/Sky/Aed_Night_Sky.(SkyMesh).xdb#xpointer(/client.VisualConstructor.SkyMesh)" />
          <hasLight>true</hasLight>
          <playInBuildings>false</playInBuildings>
        </params>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>