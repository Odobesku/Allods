<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.CreatureChangeVisItemsAction">
		<items>
			<Item>
				<slot>MAINHAND</slot>
			</Item>
			<Item>
				<slot>OFFHAND</slot>
			</Item>
			<Item>
				<newItem href="/Items/VisualItems/Armor/Leather_B_27ElfBardArmor.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
				<slot>ARMOR</slot>
			</Item>
			<Item>
				<newItem href="/Items/VisualItems/Belt/Leather_B_27ElfBardBelt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
				<slot>BELT</slot>
			</Item>
			<Item>
				<newItem href="/Items/VisualItems/Boots/Leather_B_27ElfBardBoots.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
				<slot>BOOTS</slot>
			</Item>
			<Item>
				<slot>MANTLE</slot>
			</Item>
			<Item>
				<newItem href="/Items/VisualItems/Pants/Leather_B_27ElfBardPants.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
				<slot>PANTS</slot>
			</Item>
			<Item>
				<newItem href="/Items/VisualItems/Weapon/Wand/Wand_1H_E_03ElfPurple_R4.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
				<slot>RANGED</slot>
			</Item>
			<Item>
				<slot>GLOVES</slot>
			</Item>
		</items>
		<isGfxCondition>false</isGfxCondition>
		<leaveWeapons>true</leaveWeapons>
		<notForDolls>false</notForDolls>
		<removeAllItems>true</removeAllItems>
	</action>
	<restartOnIncStackCount>true</restartOnIncStackCount>
</BuffVisScripts>