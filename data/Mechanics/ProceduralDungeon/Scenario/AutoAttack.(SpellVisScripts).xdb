<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureHoldWeaponAction">
				<time>15000</time>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack2H</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
				</advanced>
			</Item>
		</elements>
		<stopOnDeath>true</stopOnDeath>
		<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
	</launch>
</SpellVisScripts>
