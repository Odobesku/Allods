<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>242387</resourceId>
    </Header>
    <Name href="Achievement_Buff.(BuffResource).Name.txt" />
    <Description href="Achievement_Buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarriorPowerAttackUpgrade.chn.(UISingleTexture).xdb" />
    <nameTemplate href="Achievement_Buff.(BuffResource).Name.txt" />
    <descTemplate href="Achievement_Buff.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                            <zone href="Achievment_Zone.(ScriptZone).xdb" />
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                                <groups>
                                    <Item href="/Mechanics/Spells/Groups/Shroud.xdb" />
                                </groups>
                            </predicate>
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateMounted" />
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateMounted">
                                    <specificGroup href="/Mechanics/Mounts/Groups/ExoMounts.(MountGroupResource).xdb" />
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactUpdateEventAchievement">
                            <achievement href="MM_BG02.(InstancedEventAchievementResource).xdb" />
                            <summand>2</summand>
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateInZone">
                                <zone href="/Maps/Domination02/Zones/Domination02/Domination02.(ZoneResource).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Achievement_Buff.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>