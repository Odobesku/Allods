                </Item>
            </impactsOnArrived>
            <impactsOnPathNotFound>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Charge.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOnPathNotFound>
            <resetThrust>false</resetThrust>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSwimTrigger">
            <impactsOnStartSwim>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Charge.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOnStartSwim>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
