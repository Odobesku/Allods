<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.PostEffectVisAction">
        <userPostEffect href="/Spells/FX/InterfaceFX/WideScreen.(UserPostEffect).xdb#xpointer(/client.VisualConstructor.UserPostEffect)" />
      </Item>
      <Item type="client.Replica.CreatureSetTransparencyAction">
        <fadeMult>2</fadeMult>
        <priority>1</priority>
        <transparency>0</transparency>
      </Item>
      <Item type="client.SLON.CreatureVisObjectComponentsAction">
        <member>Default_Member</member>
        <visObjComponents>
          <Item type="client.Scene.AttachedVisObjectComponent">
            <locatorName>Global</locatorName>
            <offset x="0" y="0" z="1" />
            <priority>0</priority>
            <rotation x="0" y="0" z="0" w="1" />
            <scale>1</scale>
            <visObject href="/Spells/FX/Spells/Camera_CutScene.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
            <isPortraitEnabled>true</isPortraitEnabled>
            <lockScale>false</lockScale>
            <scaleFromGlobal>false</scaleFromGlobal>
            <skipSound>false</skipSound>
          </Item>
        </visObjComponents>
        <stopOnDeath>false</stopOnDeath>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.SLON.CreatureCutSceneAction" />
          <Item type="client.Replica.CreatureMusicParamAction">
            <creatureParameter type="client.Replica.CutSceneParameter" />
            <fromCreature>Self</fromCreature>
            <parameter href="/Mechanics/RaidInstances/FerrisRaid/CutScene/FerrisRaidCutscene.(SoundParameter).xdb#xpointer(/client.Sound.SoundParameter)" />
            <value>1</value>
          </Item>
          <Item type="client.Replica.Sound2DAction">
            <actionType>Music</actionType>
            <musicSourceMaxRadius>0</musicSourceMaxRadius>
            <reverbPreset />
            <sound>
              <name>Music/AdaptiveMusic/Nihaz</name>
              <project href="/SFX/Music/Music.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
            </sound>
            <forcedSoundStop>false</forcedSoundStop>
            <onlyForMainAvatar>false</onlyForMainAvatar>
            <resetGlobalParamsOnStop>true</resetGlobalParamsOnStop>
          </Item>
          <Item type="client.Replica.CreatureMusicParamAction">
            <creatureParameter type="client.Replica.CutSceneParameter" />
            <fromCreature>Self</fromCreature>
            <parameter href="/Mechanics/RaidInstances/FerrisRaid/CutScene/3rdCutsceneMusic.(SoundParameter).xdb#xpointer(/client.Sound.SoundParameter)" />
            <value>2</value>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>InSequence</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>