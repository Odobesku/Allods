<?xml version="1.0" encoding="UTF-8" ?>
<WidgetBrowser>
	<Name>Browser</Name>
	<Priority>10</Priority>
	<BackLayer href="textures/Stub.(WidgetLayerSimpleTexture).xdb#xpointer(/WidgetLayerSimpleTexture)" />
	<FrontLayer href="textures/Stub.(WidgetLayerSimpleTexture).xdb#xpointer(/WidgetLayerSimpleTexture)" />
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>0</Pos>
			<HighPos>0</HighPos>
			<Size>50</Size>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
			<Pos>0</Pos>
			<HighPos>0</HighPos>
			<Size>50</Size>
		</Y>
	</Placement>
	<wheelScrollJsStep>50</wheelScrollJsStep>
	<helperScript href="/Client/Social/Web/ScreenshotPicker_Helper.(NamedWebResource).xdb#xpointer(/NamedWebResource)" />
	<helperScriptLoadOnStart>true</helperScriptLoadOnStart>
	<respawnNotifier>true</respawnNotifier>
	<analyzeHttpCodes>true</analyzeHttpCodes>
	<allowSpecialEvents>true</allowSpecialEvents>
</WidgetBrowser>
