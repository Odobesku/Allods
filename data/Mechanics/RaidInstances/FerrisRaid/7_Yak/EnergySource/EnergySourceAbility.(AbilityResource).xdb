<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739901227</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>2000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactActivateAggro" />
											</impacts>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>100</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="EnergySourcePlane.(Plane).xdb" />
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
