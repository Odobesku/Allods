<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>219573</resourceId>
    </Header>
    <Name href="TargetRootAndEat.(BuffResource).Name.txt" />
    <Description href="TargetRootAndEat.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/EngineerDrill.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.AbonentLostWatcher">
            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="TargetRootAndEat.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                    <impactsOnHitCaster>
                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                                    <ability href="/Mechanics/Spells/Engineer/Abilities/ArtilleryFormUpg/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
                                                    <spell href="/Mechanics/Spells/Engineer/BeamCannon/Spell01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                                                    <factor type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier>1</multiplier>
                                                    </factor>
                                                    <sum type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                                        <calcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
                                                            <ability href="/Mechanics/Spells/Engineer/Abilities/ArtilleryFormUpg/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                                            <mul>-1000</mul>
                                                        </calcer>
                                                    </sum>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ImpactModifySpellGroupCooldown">
                                                    <group href="/Mechanics/Spells/Groups/EngineerFlamethrowerSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                                    <factor>1</factor>
                                                    <factorMul type="gameMechanics.elements.calcers.FloatData">
                                                        <value>1</value>
                                                    </factorMul>
                                                    <sum type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                                        <calcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
                                                            <ability href="/Mechanics/Spells/Engineer/Abilities/ArtilleryFormUpg/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                                            <mul>-750</mul>
                                                        </calcer>
                                                    </sum>
                                                    <forAllSpells>true</forAllSpells>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOnHitCaster>
                    <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                    <minDamage>24</minDamage>
                    <maxDamage>24</maxDamage>
                </Item>
            </impacts>
            <initialDelay>1000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/TeleportationSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/Teleporters.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/SpeedBoosts.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/SpeedBoosts.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/Teleporters.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        <Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                    </groups>
                </Item>
            </predicates>
        </Item>
    </effects>
    <duration>1300</duration>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>