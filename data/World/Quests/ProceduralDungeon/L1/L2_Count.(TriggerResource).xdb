<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>739911847</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
            <impactsOnEnter>
                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                    <id href="L2_Counter.(QuestCountId).xdb" />
                </Item>
            </impactsOnEnter>
            <impactsOnLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                            <minLevel type="gameMechanics.formulas.MaxLevelConstant">
                                <summand>-4</summand>
                            </minLevel>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="L2.(QuestResource).xdb" />
                        </Item>
                    </impactsIf>
                    <impactsElse />
                </Item>
            </impactsOnLeave>
            <activeZone href="/Maps/ProceduralDungeon01/Zones/GameHolder.(ZoneResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectLevelUpTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                            <minLevel type="gameMechanics.formulas.MaxLevelConstant">
                                <summand>-4</summand>
                            </minLevel>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="L2.(QuestResource).xdb" />
                        </Item>
                    </impactsIf>
                    <impactsElse />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>