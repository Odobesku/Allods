    </groups>
    <Name href="Grenade.(SpellArea).Name.txt" />
    <Description href="Grenade.(SpellArea).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/AntimatterGrenade.(UISingleTexture).xdb" />
    <visualScripts href="Grenade.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>45</value>
    </range>
    <needLos>false</needLos>
    <targetType>STTPoint</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>2000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormHole/WormHole.(MobWorld).xdb" />
                </mobs>
            </Item>
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="GrenadesPack.(BuffResource).xdb" />
