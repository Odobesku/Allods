<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>223391</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                    <time>2000</time>
                    <turnToDestination>true</turnToDestination>
                    <destination type="gameMechanics.map.destination.DestinationModified">
                        <destination type="gameMechanics.map.destination.DestinationLocatorSpread">
                            <locator>
                                <scriptID>FR4_Start</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </locator>
                        </destination>
                        <modifiers>
                            <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                <verticalRange min="0" max="1" />
                                <horizontalRange min="0" max="5" />
                            </Item>
                        </modifiers>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Groups/PlayerSelfDisablers.(ActionGroup).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.Hover" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
    </effects>
    <duration>3000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>