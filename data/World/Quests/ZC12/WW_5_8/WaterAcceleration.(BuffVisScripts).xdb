<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/World/WaterBubble.(VisObjectTemplate).xdb" />
						<fadeInTime>1000</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<locator>Slot_BodyFX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/StalkerRush.(UserPostEffect).xdb" />
			</Item>
		</elements>
	</action>
</BuffVisScripts>
