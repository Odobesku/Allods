<?xml version="1.0" encoding="UTF-8" ?>
<WidgetTextView>
    <BackLayer href="/Interface/Ingame/QuestTracker/QuestPanel/textures/QuestCounterEntryHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
    <Name>CounterText</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <HighPos>37</HighPos>
            <Size>50</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <Sizing>WIDGET_SIZING_INTERNAL</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>20</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing></reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>false</IgnoreDblClick>
    <PickChildrenOnly>true</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <DefaultTag></DefaultTag>
    <FormatFileRef href="/Interface/Ingame/QuestTracker/texts/CounterItemText.txt"/>
    <TextStyle>
        <Align>ALIGNY_DEFAULT</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>true</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextValues>
        <Item>
            <Tag>subtask</Tag>
            <TagValueFileRef href="/Interface/Ingame/QuestTracker/texts/SubTaskDefault.txt"/>
        </Item>
    </TextValues>
    <isHtmlEscaping>false</isHtmlEscaping>
    <pickObjectsOnly>true</pickObjectsOnly>
</WidgetTextView>
