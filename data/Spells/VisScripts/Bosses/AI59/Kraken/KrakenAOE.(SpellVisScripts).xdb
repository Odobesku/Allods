<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXOnCaster>/Spells/FX/Mobs/Kraken_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<CastAnimation>channelCastOmni</CastAnimation>
			<PreCastAnimation>channelCastOmni</PreCastAnimation>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<advanced>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item var="CastAnimation" />
				</animations>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<turnToTarget>NO_TURN</turnToTarget>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FXOnCaster" />
						<effectAlias href="" />
						<lockScale>true</lockScale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator var="LocatorOnCaster" />
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch />
</SpellVisScripts>
