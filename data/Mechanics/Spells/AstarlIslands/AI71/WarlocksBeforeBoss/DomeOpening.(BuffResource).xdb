<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739939132</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Chests/KeySteel.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.HighStackEffect">
            <effect type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                <buff href="DomeOpening.(BuffResource).xdb" />
                                <range>
                                    <min>3</min>
                                    <max>3</max>
                                </range>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                <spawn>
                                    <scriptID>FinalBossDome3</scriptID>
                                    <map href="/Maps/AstralIsle71/MapResource.xdb" />
                                </spawn>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                                <table href="/Maps/AstralIsle71/SpawnTables/4_Boss04.(SpawnTable).xdb" />
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsOn>
            </effect>
            <stackCountTrigger>3</stackCountTrigger>
        </Item>
    </effects>
    <stackLimit>3</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>