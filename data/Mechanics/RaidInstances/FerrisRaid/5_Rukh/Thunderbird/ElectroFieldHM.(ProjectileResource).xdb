<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739904083</resourceId>
    </Header>
    <visObject href="ElectroField.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>19600</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.StaticEntityAura">
                    <shape type="space.scaner.resources.Cylinder">
                        <halfHeight>12</halfHeight>
                    </shape>
                    <radius>5</radius>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="Thunderbird.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ElectroBuffHM.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ElectroBuffHM.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Firebird/FireSmokeDebuff.(BuffResource).xdb" />
                        </Item>
                    </impactsOut>
                </Item>
                <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>5</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="Thunderbird.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="ElectroPowerHM.(BuffResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/HMCopiesDebuff.(BuffResource).xdb" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/Firebird/Firebird.(MobWorld).xdb" />
                                            <Item href="Thunderbird.(MobWorld).xdb" />
                                            <Item href="/Mechanics/RaidInstances/FerrisRaid/5_Rukh/ShadowBird/ShadowBird.(MobWorld).xdb" />
                                        </mobs>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                </Item>
                <Item type="gameMechanics.elements.effects.StaticEntityAura">
                    <shape type="space.scaner.resources.Cylinder">
                        <halfHeight>12</halfHeight>
                    </shape>
                    <radius>5</radius>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ElectroFieldDebuff.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ElectroFieldDebuff.(BuffResource).xdb" />
                        </Item>
                    </impactsOut>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>