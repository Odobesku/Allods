<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>141338</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="ShipRune.(SpellSingleTarget).Name.txt" />
    <Description href="ShipRune.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/ShipUpgradeRune.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>5000</prepareDuration>
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.world.ship.elements.PredicateHasShipInRepair" />
                            <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                                <lhs type="gameMechanics.elements.calcers.RemainingShipRepairCalcer" />
                                <rhs type="gameMechanics.elements.calcers.LongData">
                                    <value>0</value>
                                </rhs>
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.world.ship.elements.PredicateInHangar" />
                            <Item type="gameMechanics.world.ship.elements.PredicateOnBoundShip">
                                <predicates>
                                    <Item type="gameMechanics.world.ship.elements.PredicatePermission">
                                        <permission>Modify</permission>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateOnSameMap" />
                                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                                        <onSlave type="gameMechanics.elements.predicates.PredicateGreater">
                                            <lhs type="gameMechanics.world.ship.elements.calcers.CalcerShipMaxDurability" />
                                            <rhs type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                        </onSlave>
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.world.ship.elements.PredicateShipInProgressComplete" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                                <lhs type="gameMechanics.elements.calcers.RemainingShipProgressCalcer" />
                                <rhs type="gameMechanics.elements.calcers.LongData">
                                    <value>300000</value>
                                </rhs>
                            </Item>
                            <Item type="gameMechanics.world.ship.elements.PredicateHasShipInProgress" />
                        </predicates>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.world.ship.elements.PredicateShipInProgressComplete" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
                        <lhs type="gameMechanics.elements.calcers.RemainingShipProgressCalcer" />
                        <rhs type="gameMechanics.elements.calcers.LongData">
                            <value>300000</value>
                        </rhs>
                    </Item>
                    <Item type="gameMechanics.world.ship.elements.PredicateHasShipInProgress" />
                </predicates>
                <impacts>
                    <Item type="gameMechanics.world.ship.elements.ImpactIncreaseProgress">
                        <timeBy>86400000</timeBy>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.world.ship.elements.PredicateHasShipInRepair" />
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.world.ship.elements.ImpactIncreaseRepair">
                                <timeBy>28800000</timeBy>
                            </Item>
                        </impacts>
                        <elseImpacts>
                            <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderBoundShip" />
                                <impacts>
                                    <Item type="gameMechanics.world.ship.elements.ImpactModifyShipHealth">
                                        <limitModCalcer type="gameMechanics.elements.calcers.CalcerMul">
                                            <calcers>
                                                <Item type="gameMechanics.world.ship.elements.calcers.CalcerShipMaxDurability" />
                                                <Item type="gameMechanics.elements.calcers.FloatData">
                                                    <value>-0.16</value>
                                                </Item>
                                            </calcers>
                                        </limitModCalcer>
                                        <valueModCalcer type="gameMechanics.elements.calcers.CalcerMul">
                                            <calcers>
                                                <Item type="gameMechanics.world.ship.elements.calcers.CalcerShipMaxDurability" />
                                                <Item type="gameMechanics.elements.calcers.FloatData">
                                                    <value>0.16</value>
                                                </Item>
                                            </calcers>
                                        </valueModCalcer>
                                    </Item>
                                </impacts>
                            </Item>
                        </elseImpacts>
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>50</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>