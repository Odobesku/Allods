<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221596</resourceId>
    </Header>
    <Name href="LesserAcidResource.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Equipment/Ships/Shot/AcidShot03.(UISingleTexture).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.tools.SelectorShuffle">
                        <sourceSelector type="gameMechanics.elements.calcers.RangeSelectorResource">
                            <range min="0" max="1" />
                            <withinRange>false</withinRange>
                            <minCandidatesCount>1</minCandidatesCount>
                            <targetCount>1</targetCount>
                        </sourceSelector>
                    </selector>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceAnyBuff">
                                <buffs>
                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/ActivatePlatform/Rider_A.(BuffResource).xdb" />
                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/ActivatePlatform/Rider_B.(BuffResource).xdb" />
                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/ActivatePlatform/Rider_C.(BuffResource).xdb" />
                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/ActivatePlatform/Rider_D.(BuffResource).xdb" />
                                </buffs>
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        </predicates>
                    </filter>
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                    <mobs>
                                                        <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormGlacialBoss/WormGlacialBoss.(MobWorld).xdb" />
                                                    </mobs>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                                            <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                                            <data href="GreaterAcidWarning.(ClientData).xdb" />
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                                                            <spell href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormGlacialBoss/ToPlatformRider/LesserAcid/LesserAcid.(SpellSingleTarget).xdb" />
                                                            <duration>
                                                                <second>3</second>
                                                            </duration>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                    <spawnResource href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormBoss.(SpawnTable).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                    <spell href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/WormGlacialBoss/ToPlatformRider/LesserAcid/LesserAcid.(SpellSingleTarget).xdb" />
                    <duration>
                        <second>3</second>
                    </duration>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>8000</duration>
    <stackLimit>5</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>