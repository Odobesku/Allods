<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>212228</resourceId>
    </Header>
    <Name href="Elemental_Channel.(BuffResource).Name.txt" />
    <Description href="Elemental_Channel.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/FireBolt.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <nameTemplate href="Elemental_Channel.(BuffResource).Name.txt" />
    <descTemplate href="Elemental_Channel.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.DirectDamage">
                    <damage>1</damage>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.05</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>