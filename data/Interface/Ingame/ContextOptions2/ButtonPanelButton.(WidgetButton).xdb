<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>ButtonPanelButton</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>25</HighPos>
            <Size>125</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Size>28</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>panel_button_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>false</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>button_text_button</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextOptions2/textures/OptionBtnHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="0"/>
            <Reaction>panel_button_pressed</Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Ingame/ContextOptions2/ButtonTextButton.txt"/>
                <LayerMain href="/Interface/Ingame/ContextOptions2/textures/OptionBtnDisabled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateDisabled>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextOptions2/ButtonTextButton.txt"/>
                <LayerMain href="/Interface/Ingame/ContextOptions2/textures/OptionBtnNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ContextOptions2/textures/OptionBtnPressed.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextOptions2/Autodetect.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
