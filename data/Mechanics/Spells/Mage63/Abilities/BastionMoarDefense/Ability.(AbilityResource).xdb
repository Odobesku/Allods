<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739922234</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>perc</name>
			<value var="value" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercentAbsMinus1</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Mage/MageBastion.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/Mage63/Abilities/Citadel/Buff.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.MultiplyStat">
					<stat type="gameMechanics.elements.stat.StatResistance">
						<element>EPHYSICAL</element>
					</stat>
					<multiplier var="value" />
				</Item>
				<Item type="gameMechanics.elements.effects.MultiplyStat">
					<stat type="gameMechanics.elements.stat.StatResistance">
						<element>EELEMENTAL</element>
					</stat>
					<multiplier var="value" />
				</Item>
				<Item type="gameMechanics.elements.effects.MultiplyStat">
					<stat type="gameMechanics.elements.stat.StatResistance">
						<element>EDIVINE</element>
					</stat>
					<multiplier var="value" />
				</Item>
				<Item type="gameMechanics.elements.effects.MultiplyStat">
					<stat type="gameMechanics.elements.stat.StatResistance">
						<element>ENATURE</element>
					</stat>
					<multiplier var="value" />
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
