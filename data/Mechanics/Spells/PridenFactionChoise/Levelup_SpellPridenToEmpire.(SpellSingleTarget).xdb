<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>219948</resourceId>
    </Header>
    <Name href="Levelup_SpellPridenToEmpire.(SpellSingleTarget).Name.txt" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateFaction">
                        <faction href="/World/Factions/Pridens.(Faction).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateFaction">
                        <faction href="/World/Factions/Pridens_Empire.(Faction).xdb" />
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="/Mechanics/Unlocks/Quest/PridenFactionChoise/PridenFactionChoise_E.(UnlockResource).xdb" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                    <unlock href="/Mechanics/Unlocks/Quest/PridenFactionChoise/PridenFactionChoise_L.(UnlockResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="PridensStartExit.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactLeaveUnion" />
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="CastMeFasterPls.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                <unlock href="/Mechanics/Unlocks/Quest/PridenFactionChoise/PridenFactionChoise_E.(UnlockResource).xdb" />
            </Item>
            <Item type="itemService.avatar.changeFaction.ImpactSetFaction">
                <faction href="/World/Factions/Empire.xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAddExperience">
                <calcer type="gameMechanics.elements.calcers.CalcerRemainingExpirience">
                    <level type="gameMechanics.elements.calcers.LongData">
                        <value>65</value>
                    </level>
                </calcer>
                <direct>true</direct>
                <scaleByGlobal>false</scaleByGlobal>
                <transactional>true</transactional>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateIsRemort" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasItemsCount">
                                <items>
                                    <Item href="/ItemMall/Services/AvatarDonate/LevelUpItem.(ItemResource).xdb" />
                                </items>
                                <totalCount>1</totalCount>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                <impactsResource href="/Mechanics/Spells/ItemMall/AvatarDonate/LevelUpSpell_All_main.(ImpactListResource).xdb" />
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasItemsCount">
                                        <items>
                                            <Item href="/ItemMall/Services/AvatarDonate/PresentLevelUpItem.(ItemResource).xdb" />
                                        </items>
                                        <totalCount>1</totalCount>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                        <impactsResource href="/Mechanics/Spells/ItemMall/AvatarDonate/LevelUpSpell_All_present.(ImpactListResource).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impactsElse>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasItemsCount">
                                <items>
                                    <Item href="/ItemMall/Services/AvatarDonate/RemortLevelUpItem.(ItemResource).xdb" />
                                </items>
                                <totalCount>1</totalCount>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                <impactsResource href="/Mechanics/Spells/ItemMall/AvatarDonate/LevelUpSpell_All_remort.(ImpactListResource).xdb" />
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsElse>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                <impactsResource href="/Mechanics/Spells/ItemMall/AvatarDonate/LevelUpSpell_E.(ImpactListResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>