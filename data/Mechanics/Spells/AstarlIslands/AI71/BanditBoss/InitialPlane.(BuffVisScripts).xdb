    <postAction type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>sitGroundUp</Item>
            <Item>idle01</Item>
            <Item>idle</Item>
        </animations>
    </postAction>
</BuffVisScripts>