<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2200</time>
		</playWhile>
		<elements>
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="AttachedVisObjectComponent">
						<visObject href="/Spells/FX/Mobs/ReadySpell_ArchitectMinibossAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locatorName>Hand_L</locatorName>
					</Item>
					<Item type="AttachedVisObjectComponent">
						<visObject href="/Spells/FX/Mobs/ReadySpell_ArchitectMinibossAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<rotation y="1" w="0" />
						<locatorName>Hand_R</locatorName>
					</Item>
				</visObjComponents>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Mobs/ArchitectDestroyer_SpellCastAoe_NoShaker.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
