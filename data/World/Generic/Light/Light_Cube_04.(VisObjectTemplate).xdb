<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound>
            <name></name>
        </sound>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>0</fadeOutMS>
    <scale>1</scale>
    <sound>
        <name></name>
    </sound>
    <visObjComponents>
        <Item type="LightComponent">
            <attenuationPower>0.7</attenuationPower>
            <direction x="0" y="0" z="1" />
            <facingValue>0.65</facingValue>
            <intensity>1.2</intensity>
            <pivot x="0" y="0" z="0" />
            <radius>8</radius>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>