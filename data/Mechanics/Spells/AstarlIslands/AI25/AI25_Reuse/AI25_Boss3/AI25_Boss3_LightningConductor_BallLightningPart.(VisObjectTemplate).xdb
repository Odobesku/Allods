<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound/>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>800</fadeInMS>
    <fadeOutMS>100</fadeOutMS>
    <particle href="/Spells/FX/Spells/PocketSpellDirectPsionicControl01.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)"/>
    <scale>6</scale>
    <sound>
        <name>spells/ReadySpellDirect/ReadySpellDirectIce</name>
        <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)"/>
    </sound>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>
