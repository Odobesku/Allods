<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>739848962</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <conditionsOut>
        <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
            <quest href="/World/Quests/UmoirIsland04/UI04_Q03/UI04_Q03.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
            <counterResource href="/Items/QuestItems/UmoirIsland04/NayanArtefact.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            <value>1</value>
        </Item>
    </conditionsOut>
    <impactsOut>
        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
            <spawn>
                <scriptID>tm_guard_talk</scriptID>
                <map href="/Maps/UmoirIsland04/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
            </spawn>
            <onBehalfOfTarget>true</onBehalfOfTarget>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                    <data href="/World/Quests/UmoirIsland04/UI04_Q03/KomGuard_PreAggro.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>15000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                            </impacts>
                            <spawnResource href="/Maps/UmoirIsland04/SpawnTables/TM_KomGuard.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </impactsOut>
</gameMechanics.map.scriptZone.ScriptZone>