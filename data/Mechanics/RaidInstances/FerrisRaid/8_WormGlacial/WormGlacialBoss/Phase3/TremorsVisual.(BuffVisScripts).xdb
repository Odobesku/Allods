<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionList">
						<elements>
							<Item type="VisActionDelay">
								<time>500</time>
							</Item>
							<Item type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureAnimationAction">
										<mode>CLAMP</mode>
										<animations>
											<Item>slump</Item>
										</animations>
										<channel>CHANNEL_DEATH</channel>
										<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
									</Item>
									<Item type="VisActionList">
										<elements>
											<Item type="VisActionDelay">
												<time>1333</time>
											</Item>
											<Item type="CreatureSetTransparencyAction">
												<transparency>0</transparency>
												<fadeMult>4</fadeMult>
											</Item>
										</elements>
									</Item>
								</elements>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/WormUnderground_Run.(VisObjectTemplate).xdb" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>750</time>
					</Item>
					<Item type="CreatureIndependentFxAction">
						<visObject href="/Spells/FX/Mobs/WormGlacial_TremorsAttack.(VisObjectTemplate).xdb" />
