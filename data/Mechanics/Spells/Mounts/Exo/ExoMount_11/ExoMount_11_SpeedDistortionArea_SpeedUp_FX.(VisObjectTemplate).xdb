        <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
    </sound>
    <visObjComponents>
        <Item type="client.Scene.AttachedVisObjectComponent">
            <locatorName>Slot_Special01</locatorName>
            <offset x="0" y="0" z="0" />
            <priority>0</priority>
            <rotation x="0" y="0" z="0" w="1" />
            <scale>0.4</scale>
            <visObject href="/Spells/FX/Mobs/MEV11Base_Active_Speed_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
