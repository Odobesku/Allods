<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionList">
                        <playWhile type="VisActionDelay">
                            <time>1400</time>
                        </playWhile>
                        <elements>
                            <Item type="CreatureAnimationAction">
                                <animations>
                                    <Item>ready</Item>
                                </animations>
                                <channel>CHANNEL_READY</channel>
                            </Item>
                        </elements>
                    </Item>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>specialAttack</Item>
                        </animations>
                        <channel>CHANNEL_ATTACK</channel>
                    </Item>
                </elements>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Red.(VisObjectTemplate).xdb" />
                        <lockScale>true</lockScale>
                        <scale>1</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="CreatureIndependentFxAction">
        <visObject href="/Spells/FX/Mobs/DC_1Boss_DustCloud_Hit_Decal.(VisObjectTemplate).xdb" />
        <scale>1.5</scale>
        <lifeTime>1.5</lifeTime>
    </launch>
</SpellVisScripts>