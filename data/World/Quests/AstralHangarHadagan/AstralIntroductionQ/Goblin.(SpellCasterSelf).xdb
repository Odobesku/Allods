<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>324042</resourceId>
    </Header>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>60000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                <predicates>
                    <Item type="gameMechanics.world.ship.elements.PredicateStandingOnShip" />
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
                            <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                <zone href="/Maps/AstralHangarHadagan/Zones/AstralHangarHadagan/AstralHangarHadagan.xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                <zone href="/Maps/AstralHangarLeague/Zones/AstralHangarLeague/AstralHangar.xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateGreater">
                            <lhs type="gameMechanics.elements.calcers.CalcerSectorAstralLevel" />
                            <rhs type="gameMechanics.elements.calcers.FloatData">
                                <value>1</value>
                            </rhs>
                        </predicate>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>60000</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        </impacts>
                    </Item>
                </impacts>
                <object href="/Mechanics/Ships/Hangar/HangarNPC/AstralGoblin.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="AstralIntroductionQ.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="/World/Quests/AstralHangarLeague/AstralIntroductionQ/C1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>