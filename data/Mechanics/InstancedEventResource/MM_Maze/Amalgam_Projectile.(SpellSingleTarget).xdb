<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739877472</resourceId>
	</Header>
	<isExploit>true</isExploit>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>5</value>
	</range>
	<prepareDuration>5000</prepareDuration>
	<targetType>STTCurrentTargetNotSelf</targetType>
	<iffPolicy>Everyone</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ReturningImpact">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactGiveItem">
								<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
									<item href="/Items/QuestItems/Domination/WiningToken.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
								</item>
								<count>6</count>
							</Item>
						</impacts>
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactKill" />
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
