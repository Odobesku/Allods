<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221638</resourceId>
    </Header>
    <Name href="Rider_B.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Equipment/Ships/CrystalMedium/Crystal06.(UISingleTexture).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectMoveByTour">
            <route href="/Maps/FerrisRaid/GlobalObjects/Tours/8_Worm/Platform_B.(Tour).xdb" />
            <impactsOnArrive>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Rider_B.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="ActivatedPlatform_B.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="ActivatedPlatform_B.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/PanelUser_B.(BuffResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnArrive>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.RepelTypeRaiser">
            <type>IGNORE</type>
        </Item>
        <Item type="gameMechanics.elements.effects.CastOnMove">
            <spells>
                <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/RiderSpells/HolyGrenade.(SpellArea).xdb" />
                <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/RiderSpells/RefillGrenadePack.(SpellSingleTarget).xdb" />
                <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/RiderSpells/Grenade.(SpellArea).xdb" />
            </spells>
            <moveTypes>
                <Item>Step</Item>
                <Item>Fall</Item>
                <Item>Pilot</Item>
            </moveTypes>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectAddContextActionsGeneric">
            <actions>
                <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/RiderSpells/HolyGrenade.(SpellArea).xdb" />
                <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/RiderSpells/RefillGrenadePack.(SpellSingleTarget).xdb" />
                <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/RiderSpells/Grenade.(SpellArea).xdb" />
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="PlatformRider.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                    <spawn>
                        <scriptID>Platform_B</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="PlatformRider.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>Platform_B</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </device>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>120000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>