<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739930117</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
        </Item>
        <Item>
            <name>stat</name>
            <value var="stat" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/AcousticBarrier.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.BuffExtraEffects">
                    <buffs>
                        <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
                    </buffs>
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                <coeff>-0.01</coeff>
                                <calcer type="gameMechanics.elements.calcers.FloatData">
                                    <value var="value" />
                                </calcer>
                            </scaler>
                        </Item>
                        <Item type="gameMechanics.elements.effects.EffectsToAllAssistants">
                            <effects>
                                <Item type="gameMechanics.elements.effects.EffectsIf">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                                            <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                        </Item>
                                    </predicates>
                                    <effectsIf>
                                        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                                <coeff>-0.01</coeff>
                                                <calcer type="gameMechanics.elements.calcers.FloatData">
                                                    <value var="value" />
                                                </calcer>
                                            </scaler>
                                        </Item>
                                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                                <coeff>0.01</coeff>
                                                <calcer type="gameMechanics.elements.calcers.FloatData">
                                                    <value var="value" />
                                                </calcer>
                                            </scaler>
                                        </Item>
                                    </effectsIf>
                                </Item>
                            </effects>
                        </Item>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                                <coeff>0.01</coeff>
                                <calcer type="gameMechanics.elements.calcers.FloatData">
                                    <value var="value" />
                                </calcer>
                            </scaler>
                        </Item>
                        <Item type="gameMechanics.elements.effects.SummandStat">
                            <stat type="gameMechanics.elements.stat.SpecialStat">
                                <stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
                            </stat>
                            <value var="stat" />
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>