<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739854800</resourceId>
	</Header>
	<Name href="GoByTourBeam.(BuffResource).Name.txt" />
	<nameTemplate href="GoByTourBeam.(BuffResource).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInCombat" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
							<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderShipOwner" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.TargetDistributor" />
									<data href="/Mechanics/Astral/Sectors/NewbieAstral/IntroductionSector/Mobs/Mercs/TextMessage/BeamFail.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="GoByTourShield.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectStackTrigger">
			<count>4</count>
			<impacts>
				<Item type="gameMechanics.world.ship.elements.ImpactGoByTour">
					<tour href="/Mechanics/Astral/Sectors/NewbieAstral/IntroductionSector/Tours/Hub2/TourBeam.(Tour).xdb#xpointer(/gameMechanics.map.tour.Tour)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
					<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderShipOwner" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="/World/Quests/AstralHangar_VIP/AstralIntroduction5.0/Q1/Prototypes/C3.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
					<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderShipOwner" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.TargetDistributor" />
							<data href="/Mechanics/Astral/Sectors/NewbieAstral/IntroductionSector/Mobs/Mercs/TextMessage/Beam.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
	<stackLimit>4</stackLimit>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
