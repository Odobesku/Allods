                <coeff>-0.9</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                    <mobs>
                        <Item href="/Characters/Orc_male/Instances/ZC12_Map02/ZC12_RI7_OrcSoldier_Assistant.(MobWorld).xdb" />
