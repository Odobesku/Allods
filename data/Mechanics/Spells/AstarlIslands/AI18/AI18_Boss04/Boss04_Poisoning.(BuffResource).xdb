<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739878594</resourceId>
    </Header>
    <Name href="Boss04_Poisoning.(BuffResource).Name.txt" />
    <Description href="Boss04_Poisoning.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerBloodPlague.(UISingleTexture).xdb" />
    <visScript href="Boss04_Poisoning.(BuffVisScripts).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectJumpOnDetach">
            <jumps type="gameMechanics.elements.calcers.LongData">
                <value>6</value>
            </jumps>
            <buff href="Boss04_Poisoning.(BuffResource).xdb" />
            <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.ClosestAutotarget">
                <group>Enemies</group>
                <conditions>
                    <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                        <onSlave type="gameMechanics.constructor.basicElements.PredicateAnd">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="Boss04_AntiPoisoning.(BuffResource).xdb" />
                                    </predicate>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                </Item>
                            </predicates>
                        </onSlave>
                    </Item>
                </conditions>
            </autotarget>
            <onBehalfOfCaster>true</onBehalfOfCaster>
            <radius>10</radius>
            <inCasterRange>false</inCasterRange>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Boss04_Poisoning.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Boss04_AntiPoisoning.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>10</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>POISON</element>
                            <damage>55</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </filter>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Boss04_Poisoning.(BuffResource).xdb" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.MagicDoT">
                    <parameters>
                        <damagePerTick>5</damagePerTick>
                    </parameters>
                    <element>POISON</element>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>10000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
