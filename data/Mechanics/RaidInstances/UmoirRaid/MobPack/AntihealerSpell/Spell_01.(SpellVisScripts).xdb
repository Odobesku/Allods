<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<playWhile type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownDisease.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				</Item>
				<Item>
					<effectFx href="/Spells/FX/Spells/ReadySpellDirectAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<locator>Slot_Hand_L</locator>
				</Item>
			</visualEffects>
		</playWhile>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirectedWand</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
		</elements>
	</actionBarStart>
	<actionBarComplite type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
		</elements>
	</actionBarComplite>
	<launch type="CreatureProjectileAction">
		<projectileFx href="/Spells/FX/Spells/MageHarmony_projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
		<explosionFx href="/Spells/FX/Spells/HitAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
		<pointOnCaster type="VisPointLocator">
			<locator>Slot_Hand_L</locator>
		</pointOnCaster>
		<pointOnTarget type="VisPointLocator">
			<locator>Slot_BodyFX</locator>
		</pointOnTarget>
	</launch>
</SpellVisScripts>
