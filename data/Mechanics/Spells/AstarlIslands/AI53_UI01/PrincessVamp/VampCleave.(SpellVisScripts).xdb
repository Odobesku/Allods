<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MeleeAttack.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<LocatorNameOnTargets />
			<TrailCreature />
			<FixPointTarget>true</FixPointTarget>
			<Trail />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorNameOnCaster />
			<DelayCasterFX>0</DelayCasterFX>
			<FxOnTargets />
			<Enchant />
			<OffendType>ONEOFFEND_ONETARGET</OffendType>
			<FixPointCaster>false</FixPointCaster>
			<skipBloodFxOnTarget>false</skipBloodFxOnTarget>
			<UseAnimation>USE_CURRENT_ATTACK</UseAnimation>
			<FxOnCaster>/Spells/FX/Spells/VampCleaveFX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnCaster>
			<HitPostFXOnTargets />
			<Animation>invalid</Animation>
			<LocatorOnCaster>Slot_BodyFX</LocatorOnCaster>
			<TrailOffHand />
			<PreCastAnimation>specialCast</PreCastAnimation>
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<FxOnHands>/Spells/FX/Weapon/ArrowEnchantTrail_Magenta.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
		</Variables>
	</Header>
	<Description href="/Spells/VisScripts/Prototypes/Parts/Base.Description.txt" />
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode var="AnimationPreCastMode" />
				<animations>
					<Item var="PreCastAnimation" />
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FxOnHands" />
						<scale>2</scale>
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx hrefvar="FxOnHands" />
						<scale>2</scale>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<precastType>PRECAST_NONE</precastType>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<use var="UseAnimation" />
				<animations>
					<Item var="Animation" />
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<offendType var="OffendType" />
					<autoHasten>
						<mode>AUTOHASTEN_NONE</mode>
						<timeToBeLeft>0</timeToBeLeft>
					</autoHasten>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<animationKeysActionPeriod>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureTrailAction">
										<visActionID>TrailAction1</visActionID>
										<mainHandTrail hrefvar="Trail" />
										<offHandTrail hrefvar="TrailOffHand" />
										<creatureTrail hrefvar="TrailCreature" />
										<lengthMSec>10000</lengthMSec>
									</Item>
									<Item type="CreatureEnchantWeaponAction">
										<visActionID>EnchantAction1</visActionID>
										<enchant hrefvar="Enchant" />
									</Item>
								</elements>
							</action>
						</Item>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="VisActionStopAction">
										<visActionID />
										<stoppedActionID>TrailAction1</stoppedActionID>
									</Item>
									<Item type="VisActionStopAction">
										<visActionID />
										<stoppedActionID>EnchantAction1</stoppedActionID>
									</Item>
								</elements>
							</action>
						</Item>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureTrailAction">
										<visActionID>TrailAction2</visActionID>
										<mainHandTrail hrefvar="Trail" />
										<offHandTrail hrefvar="TrailOffHand" />
										<creatureTrail hrefvar="TrailCreature" />
										<lengthMSec>10000</lengthMSec>
									</Item>
									<Item type="CreatureEnchantWeaponAction">
										<visActionID>EnchantAction2</visActionID>
										<enchant hrefvar="Enchant" />
									</Item>
								</elements>
							</action>
						</Item>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="VisActionStopAction">
										<visActionID />
										<stoppedActionID>TrailAction2</stoppedActionID>
									</Item>
									<Item type="VisActionStopAction">
										<visActionID />
										<stoppedActionID>EnchantAction2</stoppedActionID>
									</Item>
								</elements>
							</action>
						</Item>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureTrailAction">
										<visActionID>TrailAction3</visActionID>
										<mainHandTrail hrefvar="Trail" />
										<offHandTrail hrefvar="TrailOffHand" />
										<creatureTrail hrefvar="TrailCreature" />
										<lengthMSec>10000</lengthMSec>
									</Item>
									<Item type="CreatureEnchantWeaponAction">
										<visActionID>EnchantAction3</visActionID>
										<enchant hrefvar="Enchant" />
									</Item>
								</elements>
							</action>
						</Item>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="VisActionStopAction">
										<visActionID />
										<stoppedActionID>TrailAction3</stoppedActionID>
									</Item>
									<Item type="VisActionStopAction">
										<visActionID />
										<stoppedActionID>EnchantAction3</stoppedActionID>
									</Item>
								</elements>
							</action>
						</Item>
					</animationKeysActionPeriod>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="DelayComponent">
						<timeMin>0.4</timeMin>
						<timeMax>0.4</timeMax>
						<component type="AttachedVisObjectComponent">
							<visObject hrefvar="FxOnCaster" />
							<locatorName>Slot_BodyFX</locatorName>
						</component>
					</Item>
				</visObjComponents>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<skipBloodFx var="skipBloodFxOnTarget" />
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx hrefvar="FxOnTargets" />
							<fixPoint var="FixPointTarget" />
							<locator var="LocatorOnTargets" />
							<locatorName var="LocatorNameOnTargets" />
						</Item>
					</visualEffects>
				</Item>
				<Item type="CreatureRunVisActionResource">
					<resource hrefvar="HitPostFXOnTargets" />
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
