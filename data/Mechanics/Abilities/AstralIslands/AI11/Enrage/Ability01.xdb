                                                                </locator>
                                                                <yaw type="constructor.basicElements.AngleRadians" />
                                                            </destination>
                                                        </moveType>
                                                        <resource href="/Mechanics/Spells/AstarlIslands/AI11/VoidZones/Projectile01.xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                                    </projectileData>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </entries>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/AstarlIslands/AI11/DeathStrike/DeathStrike.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                            </spells>
