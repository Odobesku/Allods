<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739848910</resourceId>
	</Header>
	<visObject href="/Spells/FX/World/Buff_healing.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<lifeLengthCap>60000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.Aura">
					<checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
					<radius>3</radius>
					<impactsIn>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.PureHeal">
									<heal>1</heal>
									<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
											<multiplier>0.3</multiplier>
										</mulCalcer>
									</scalerTarget>
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ReturningImpact">
							<impacts>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impacts>
						</Item>
					</impactsIn>
					<filter type="gameMechanics.world.creature.AvatarFilter" />
				</Item>
			</effects>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
