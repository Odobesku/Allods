<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>215382</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/BardMelody.(ActionGroup).xdb" />
    </groups>
    <Name href="ConsumeMagic.(SpellSingleTarget).Name.txt" />
    <Description href="ConsumeMagic.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Bard/ConsumeMagic.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Bard/Lure.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration var="prepareDuration" />
    <ranks>
        <Item href="ConsumeMagic01.(SpellSingleTarget).xdb" />
        <Item href="ConsumeMagic02.(SpellSingleTarget).xdb" />
        <Item href="ConsumeMagic03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
                <sub>1</sub>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.DispelMagic">
                        <magics href="/Mechanics/Spells/Groups/Magics.xdb" />
                        <impactsOnDispel>
                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                        <mark href="ConsumeMagicOnCaster.(MarkResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="ConsumeMagicOnTarget.(MarkResource).xdb" />
                            </Item>
                        </impactsOnDispel>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="ConsumeMagicOnTargetBeforeDispell.(MarkResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>