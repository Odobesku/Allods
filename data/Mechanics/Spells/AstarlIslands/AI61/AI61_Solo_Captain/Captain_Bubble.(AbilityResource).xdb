<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>188817</resourceId>
    </Header>
    <visualScript type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Spells/Bubble_Immunity.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <scale>1.5</scale>
                <locator>Slot_FX</locator>
            </Item>
        </visualEffects>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactSetFaction">
                    <faction href="/World/Factions/NeutralFriendly.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactSetFaction">
                    <faction href="/World/Factions/Wild.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>