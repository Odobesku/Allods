    </Header>
    <Name href="RD3_Support_Bomber_Bomb.(BuffResource).Name.txt" />
    <Description href="RD3_Support_Bomber_Bomb.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Trinket/AstralBomb_01.(UISingleTexture).xdb" />
    <visScript href="RD3_Support_Bomber_Bomb.(BuffVisScripts).xdb" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>800</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="RD3_Support_Bomber_Explosion.(ClientData).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>700</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>6</radius>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>LIGHTNING</element>
                                            <damage>1</damage>
                                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                <scalers>
                                                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                            <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
                                                        </mulCalcer>
                                                    </Item>
                                                </scalers>
                                            </scaler>
                                        </Item>
                                    </impacts>
                                    <finishImpacts>
                                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impacts>
                                        </Item>
                                    </finishImpacts>
                                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.6</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <affectGroup>Enemies</affectGroup>
                    <radius>4</radius>
                    <filter type="gameMechanics.world.creature.CreatureFilter" />
                    <holderImpactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </holderImpactsIn>
                </Item>
            </effects>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>