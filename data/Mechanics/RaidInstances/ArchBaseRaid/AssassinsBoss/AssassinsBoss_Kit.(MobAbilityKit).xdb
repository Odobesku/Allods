<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.MobAbilityKit>
    <Header>
        <resourceId>224606</resourceId>
    </Header>
    <spellEntries>
        <Item>
            <spell href="R7_Backstab.(SpellSingleTarget).xdb" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort" />
                <helpfulRadius>70</helpfulRadius>
                <targetConditionChecks>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/RaidInstances/ArchBaseRaid/Other/TankBuff.(BuffResource).xdb" />
                            </Item>
                        </predicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>15000</min>
                <max>15000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="R7_Cleave.(SpellArea).xdb" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByAggro">
                    <startFrom>1</startFrom>
                    <shuffle>true</shuffle>
                </sortTargets>
                <helpfulRadius>70</helpfulRadius>
                <targetConditionChecks>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="R7_Trap.(BuffResource).xdb" />
                                        </predicate>
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="R7_Trap2.(BuffResource).xdb" />
                                        </predicate>
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="R7_RayAttack_2.(BuffResource).xdb" />
                                        </predicate>
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>14000</min>
                <max>14000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="R7_AutoAttack_Assassins.(SpellSingleTarget).xdb" />
            <cooldowns>
                <min>3000</min>
                <max>3000</max>
            </cooldowns>
        </Item>
    </spellEntries>
</gameMechanics.world.mob.MobAbilityKit>