                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                                    <time>1000</time>
                                    <impactsOnLand>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier>2</multiplier>
                                            </durationScaler>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                                    <quality href="/Mechanics/MobQualities/Elite.xdb" />
                                                </Item>
                                            </predicates>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                        <scalers>
                                                            <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                                                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageCommon.(CalcerFloatResource).xdb" />
                                                                </mulCalcer>
                                                            </Item>
                                                        </scalers>
                                                    </scaler>
                                                    <minDamage>1</minDamage>
                                                    <maxDamage>1</maxDamage>
                                                </Item>
                                            </impacts>
                                            <elseImpacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                                            <quality href="/Mechanics/MobQualities/Boss.xdb" />
                                                        </Item>
                                                    </predicates>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                                <scalers>
                                                                    <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                                                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                            <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageElite.(CalcerFloatResource).xdb" />
                                                                        </mulCalcer>
                                                                    </Item>
                                                                </scalers>
                                                            </scaler>
                                                            <minDamage>1</minDamage>
                                                            <maxDamage>1</maxDamage>
                                                        </Item>
                                                    </impacts>
                                                    <elseImpacts>
                                                        <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                                <scalers>
                                                                    <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                                                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                            <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/PartiallyEscapableDamageBoss.(CalcerFloatResource).xdb" />
                                                                        </mulCalcer>
                                                                    </Item>
                                                                </scalers>
                                                            </scaler>
                                                            <minDamage>1</minDamage>
                                                            <maxDamage>1</maxDamage>
                                                        </Item>
                                                    </elseImpacts>
                                                </Item>
                                            </elseImpacts>
                                        </Item>
                                    </impactsOnLand>
                                    <distance>5</distance>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
                        <angle type="constructor.basicElements.AngleDegrees">
                            <value>45</value>
                        </angle>
                    </shape>
                    <affectGroup>All</affectGroup>
                    <radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
