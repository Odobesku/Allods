<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739912825</resourceId>
    </Header>
    <Name href="DiArderMassTeleport.(BuffResource).Name.txt" />
    <Description href="DiArderMassTeleport.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/MagePortal.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/MageTeleportAbility.(VisObjectTemplate).xdb" />
        </Item>
    </visualEffects>
    <visualPostEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/TeleportUp.(VisObjectTemplate).xdb" />
        </Item>
    </visualPostEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                            <zone href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Dome_1.(ScriptZone).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>11.5</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.DestinationLocator">
                                            <locator>
                                                <scriptID>Dome_2_Loc</scriptID>
                                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                            </locator>
                                        </destination>
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                <verticalRange min="0" max="0" />
                                                <horizontalRange min="1" max="8" />
                                            </Item>
                                        </modifiers>
                                    </destination>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="TeleportUp.(ClientData).xdb" />
                                </Item>
                            </impacts>
                            <finishImpacts>
                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>Dome_2_Loc</scriptID>
                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                    <finishImpacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                            <radius>10</radius>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Allies/ShieldProtected_Dome.(BuffResource).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/SwarmBuff.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                                        </Item>
                                    </finishImpacts>
                                </Item>
                            </finishImpacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </filter>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                            <device>
                                <scriptID>Dome_2</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </device>
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                            <zone href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Dome_2.(ScriptZone).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>11.5</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.DestinationLocator">
                                            <locator>
                                                <scriptID>Dome_3_Loc</scriptID>
                                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                            </locator>
                                        </destination>
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                <verticalRange min="0" max="0" />
                                                <horizontalRange min="1" max="8" />
                                            </Item>
                                        </modifiers>
                                    </destination>
                                </Item>
                            </impacts>
                            <finishImpacts>
                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>Dome_3_Loc</scriptID>
                                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                        </locator>
                                    </destination>
                                    <finishImpacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                            <radius>10</radius>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Allies/ShieldProtected_Dome.(BuffResource).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/SwarmBuff.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                                        </Item>
                                    </finishImpacts>
                                </Item>
                            </finishImpacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </predicates>
                            </filter>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                            <device>
                                <scriptID>Dome_3</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </device>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>3000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>