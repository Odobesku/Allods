<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureSetTransparencyAction">
				<transparency>0.4</transparency>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/MageInvisibilityAbility_END.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_BodyFX</locator>
						<offset z="-1" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureColorAction">
				<priority>10</priority>
				<colorFactor x="1" y="1" z="1" w="1" />
				<colorValue>-7087617</colorValue>
			</Item>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>sneak</play>
							<forAnimations>
								<Item>run</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
					<notReplacedanimations />
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>sneak</play>
							<forAnimations>
								<Item>run</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
				<member>Mount</member>
			</Item>
		</elements>
	</action>
	<postAction type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/MageInvisibilityAbility_END.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<effectAlias href="" />
				<locator>Slot_BodyFX</locator>
				<offendTime />
			</Item>
		</visualEffects>
	</postAction>
</BuffVisScripts>
