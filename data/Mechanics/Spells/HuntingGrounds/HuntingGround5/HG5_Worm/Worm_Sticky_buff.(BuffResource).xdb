<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>212610</resourceId>
    </Header>
    <Name href="Worm_Sticky_buff.(BuffResource).Name.txt" />
    <Description href="Worm_Sticky_buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerBloodPlague.chn.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="Worm_Buff_Vis.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="Bomb_Data.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>16</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ACID</element>
                            <damage>30</damage>
                            <impactsOnHitTarget>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Worm_Healing_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsOnHitTarget>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="Boss_Worm.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        <Item href="Boss_Worm.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Worm_Healing_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterOr">
                        <filters>
                            <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="Boss_Worm.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.world.creature.AvatarFilter">
                                <withPet>true</withPet>
                            </Item>
                        </filters>
                    </filter>
                    <targetsLimit>6</targetsLimit>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Worm_Attention_Bomb_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Worm_Attention_Bomb_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>11000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>