<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>353538049</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Event/ChristmasGiftVoucher1.(UISingleTexture).xdb" />
	<source>Vendor</source>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
						<currency href="/Mechanics/AlternativeCurrencies/Events/NewYearCoupon.(AlternativeCurrency).xdb" />
					</Item>
				</actions>
				<consumeItems>1</consumeItems>
			</Item>
		</usages>
		<useStack>true</useStack>
	</functionalPart>
	<requiredLevel>4</requiredLevel>
	<stackLimit>10000</stackLimit>
	<quality href="/Mechanics/ItemQualities/Goods.xdb" />
	<prices type="gameMechanics.constructor.schemes.item.prices.AltCurrenciesItem">
		<currencies>
			<Item>
				<currency href="/Mechanics/AlternativeCurrencies/Events/BronzeCoin.xdb" />
				<value>5</value>
			</Item>
		</currencies>
	</prices>
	<binding>BindOnPickup</binding>
	<name href="NewYearCoupon.(ItemResource).Name.txt" />
	<description href="NewYearCoupon.(ItemResource).Description.txt" />
	<category href="/Mechanics/ItemCategories/Consumables/Special.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>
