<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureSetTransparencyAction">
				<transparency>0.5</transparency>
			</Item>
			<Item type="CreatureReplaceAnimationAction">
				<action>RUN</action>
				<newAnimation>sneak</newAnimation>
			</Item>
			<Item type="CreatureReplaceAnimationAction">
				<action>WALK</action>
				<newAnimation>sneak</newAnimation>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
