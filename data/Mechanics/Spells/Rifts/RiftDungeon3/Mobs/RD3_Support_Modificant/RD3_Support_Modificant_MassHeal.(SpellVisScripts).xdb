<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>readySpellOmni</Item>
        </animations>
    </actionBarStart>
    <wholeCasting type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="RD3_Support_Modificant_Healing.(VisObjectTemplate).xdb" />
                <lockScale>true</lockScale>
                <scale>0.2</scale>
            </Item>
        </visualEffects>
    </wholeCasting>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>200</delay>
                        <effectFx href="/Spells/FX/Mobs/Architect_Chain_SpellCast.(VisObjectTemplate).xdb" />
                        <scale>2</scale>
                        <locator>Global</locator>
                        <ignoreParentRotation>true</ignoreParentRotation>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>