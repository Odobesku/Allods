<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>193605</resourceId>
    </Header>
    <name href="AI38_SlowZoneVisual.(ProjectileResource).Name.txt" />
    <visObject href="AI38_SlowZoneVisual.(VisObjectTemplate).xdb" />
    <altitude>0.2</altitude>
    <lifeLengthCap>2000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>600</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <radius>5</radius>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>COLD</element>
                                            <damage>75</damage>
                                        </Item>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="AI38_FrostPlayers.(BuffResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="AI38_BossAdd01.(MobWorld).xdb" />
                                                <Item href="AI38_BossAdd02.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="AI38_SpeedDown.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="AI38_SpeedUP.(BuffResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>