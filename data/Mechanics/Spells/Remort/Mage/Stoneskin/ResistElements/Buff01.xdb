<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>218139</resourceId>
    </Header>
    <Name href="Buff_Name.txt" />
    <Description href="Buff_Desc.txt" />
    <image href="/Interface/Icons/Spells/Mage/ResistElements.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/VisScripts/Mage/ResistElements.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.FixedDamageAbsorber">
            <elements>
                <Item>ACID</Item>
                <Item>ASTRAL</Item>
                <Item>COLD</Item>
                <Item>FIRE</Item>
                <Item>HOLY</Item>
                <Item>LIGHTNING</Item>
                <Item>SHADOW</Item>
            </elements>
            <absorb>48</absorb>
            <scaler type="gameMechanics.elements.scalers.ScalerMax">
                <scaler1 type="gameMechanics.elements.scalers.HealScaler" />
                <scaler2 type="gameMechanics.elements.scalers.HealSlotScaler">
                    <slot>MAINHAND</slot>
                </scaler2>
            </scaler>
            <scaledByCasterStats>true</scaledByCasterStats>
            <damagePredicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
            </damagePredicates>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                            <spell href="Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                            <duration>45000</duration>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                            <spell href="/Mechanics/Spells/Remort/Mage/Stoneskin/Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                            <duration>45000</duration>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
            <rerunOnLoad>false</rerunOnLoad>
        </Item>
        <Item type="gameMechanics.elements.effects.ForgetSpellTrigger">
            <spell href="Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            <anyRank>true</anyRank>
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <anyRank>true</anyRank>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>1800000</duration>
    <isStackable>true</isStackable>
    <stackLimit>3</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>false</isMultiple>
    <ranks />
    <canBeSaved>true</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
