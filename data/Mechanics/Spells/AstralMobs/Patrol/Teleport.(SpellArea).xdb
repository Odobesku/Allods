<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739872947</resourceId>
	</Header>
	<Name href="Teleport.(SpellArea).Name.txt" />
	<visualScripts href="/Spells/VisScripts/AstralMobs/Patrol/Teleport.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>5000</prepareDuration>
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<isAggro>false</isAggro>
	<modifiers>
		<Item type="gameMechanics.elements.spell.IgnoreRangeAfterStartModifier" />
	</modifiers>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<needInFront>false</needInFront>
	<mechanics>
		<cooldown>
			<duration>30000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateIsAstralMob" />
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactsIf">
				<predicate type="gameMechanics.elements.predicates.PredicateDistance">
					<range min="1000" max="1500" />
				</predicate>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ImpactTeleport">
						<destination type="gameMechanics.map.destination.DestinationModified">
							<destination type="gameMechanics.map.destination.SelfPosDestination" />
							<modifiers>
								<Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
									<radius type="gameMechanics.elements.calcers.FloatData">
										<value>25</value>
									</radius>
								</Item>
							</modifiers>
						</destination>
					</Item>
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
	<maxTargets>1</maxTargets>
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>1500</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
