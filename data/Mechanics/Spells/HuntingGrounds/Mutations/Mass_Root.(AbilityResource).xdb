<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>212333</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                            <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                <range min="5" max="10" />
                                <withinRange>true</withinRange>
                                <minCandidatesCount>0</minCandidatesCount>
                                <targetCount>0</targetCount>
                            </selector>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                            <impacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                                    <radius>35</radius>
                                                    <affectPets>false</affectPets>
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="Mass_RootAvatar.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>10000</tick>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Mass_Root.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Mass_Root.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.1</coeff>
            </scaler>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>