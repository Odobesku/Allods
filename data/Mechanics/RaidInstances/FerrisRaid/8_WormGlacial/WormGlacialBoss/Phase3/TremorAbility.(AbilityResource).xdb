<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>221573</resourceId>
    </Header>
    <visualScript type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>1000</time>
                    </Item>
                    <Item type="CreatureAnimationAction">
                        <mode>CLAMP</mode>
                        <animations>
                            <Item>special</Item>
                        </animations>
                        <advanced>
                            <speed>0.666</speed>
                        </advanced>
                    </Item>
                    <Item type="CreatureAnimationAction">
                        <mode>CLAMP</mode>
                        <animations>
                            <Item>special01</Item>
                        </animations>
                    </Item>
                </elements>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/WormUnderground_Run.(VisObjectTemplate).xdb" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="TremorPlane.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>7000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>