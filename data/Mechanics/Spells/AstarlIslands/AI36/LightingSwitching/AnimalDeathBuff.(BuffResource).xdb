<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>190888</resourceId>
    </Header>
    <Name href="AnimalDeathBuff.(BuffResource)_Name.txt" />
    <Description href="AnimalDeathBuff.(BuffResource)_Desc.txt" />
    <image href="/Interface/Icons/Misc/Mobparts/SkullAnimal.(UISingleTexture).xdb" />
    <nameTemplate href="AnimalDeathBuff.(BuffResource)_Name.txt.template" />
    <descTemplate href="AnimalDeathBuff.(BuffResource)_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectStackTrigger">
            <count>16</count>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>Druid</scriptID>
                        <map href="/Maps/AstralIsle36/MapResource.xdb" />
                    </spawn>
                    <onBehalfOfTarget>true</onBehalfOfTarget>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                            <affectPets>true</affectPets>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="DarkWood.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                    <delay>500</delay>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="AnimalDeathBuff.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="Light.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.world.pet.PredicateHasPet" />
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                            <buff href="Light.(BuffResource).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="WoodSwitch.(MapVariableResource).xdb" />
                    <summand>0</summand>
                    <calcerSummand type="gameMechanics.elements.calcers.LinearCalcer">
                        <mul>1</mul>
                        <sum>0</sum>
                    </calcerSummand>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateInZone">
                                <zone href="/Maps/AstralIsle36/Zones/AstralIsle36/AstralIsle36.xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="AnimalDeathBuff.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <tick>5000</tick>
        </Item>
    </effects>
    <stackLimit>16</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>