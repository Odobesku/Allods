<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/PhantomWorld.(UserPostEffect).xdb#xpointer(/UserPostEffect)" />
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>Ambience/OtherWorldMain</name>
				</sound>
				<actionType>Music</actionType>
				<onlyForMainAvatar>true</onlyForMainAvatar>
			</Item>
			<Item type="CreatureChangeVisItemsAction">
				<items>
					<Item>
						<slot>LIFESTYLESUIT</slot>
						<newItem href="/Items/VisualItems/Shirt/Leather_A_50UmoirShirt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
					</Item>
					<Item>
						<slot>LIFESTYLEHEAD</slot>
						<newItem href="/Items/VisualItems/Helm/Helm_Leather_A_50Umoir.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
					</Item>
					<Item>
						<slot>LIFESTYLESHOULDER</slot>
						<newItem href="/Items/VisualItems/Mantle/Shoulder_Leather_A_50Umoir.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
					</Item>
				</items>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>Ambience/OtherWorldEnd</name>
				</sound>
				<onlyForMainAvatar>true</onlyForMainAvatar>
			</Item>
			<Item type="Sound2DAction">
				<actionType>Music</actionType>
				<onlyForMainAvatar>true</onlyForMainAvatar>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
