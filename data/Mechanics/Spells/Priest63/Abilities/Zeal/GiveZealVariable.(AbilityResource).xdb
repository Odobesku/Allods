                        <Item type="gameMechanics.elements.effects.SpellPrepareDurationModifier">
                            <spell href="/Mechanics/Spells/Priest63/Spells/CompleteHealUpgrade/Spell01.(SpellSingleTarget).xdb" />
                            <factor>-1</factor>
