<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>204726</resourceId>
    </Header>
    <Name href="Spell0.(SpellSingleTarget).Name.txt" />
    <Description href="Buff0.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Event/ShieldCarrier.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.DamageThreshold">
            <healthScalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>0.3</mul>
                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
            </healthScalerTarget>
            <outOfCombatPolicy>Nothing</outOfCombatPolicy>
            <ownerDamageFactor type="gameMechanics.elements.calcers.FloatData">
                <value>0</value>
            </ownerDamageFactor>
            <barrierDamageFactor type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </barrierDamageFactor>
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff0.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="BuffVis.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Vis0.(BuffResource).xdb" />
                </Item>
            </impacts>
            <priority>HarmfulLimitedDamageAbsorber</priority>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff0_1.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMountTrigger">
            <onBeforeDismount>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Vis0.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerBuffDuration">
                                    <buff href="Buff0.(BuffResource).xdb" />
                                    <multiplier>0.001</multiplier>
                                </mulCalcer>
                            </durationScaler>
                        </Item>
                    </impacts>
                </Item>
            </onBeforeDismount>
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>