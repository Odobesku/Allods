<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739921004</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>perc</name>
			<value var="coeff" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
		<Item>
			<name>stat</name>
			<value var="stat" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Psionic/EssenceOfThought.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.ScalerOutputDamageChannel">
			<element>ASTRAL</element>
			<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
				<coeff>1</coeff>
				<calcer type="gameMechanics.elements.calcers.CalcerSum">
					<summands>
						<Item type="gameMechanics.elements.calcers.FloatData">
							<value var="coeff" />
						</Item>
						<Item type="gameMechanics.constructor.basicElements.ScalerCalcer">
							<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mul>0.01</mul>
								<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
									<stat type="gameMechanics.elements.stat.SpecialStat">
										<stat href="/Mechanics/SpecialStats/DoubleHitChance.(SpecialStatResource).xdb" />
									</stat>
									<valueType>ShortTerm</valueType>
								</mulCalcer>
							</scaler>
							<value var="stat" />
						</Item>
					</summands>
				</calcer>
			</scaler>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
		<Item href="Ability04.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
