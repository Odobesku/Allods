                                        </Item>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Deploying_visibility.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="Deploying_visibility.(BuffResource).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="/Mechanics/QuestSchemes/Maintenance/SeeMobs.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <assistantResource href="/World/Quests/ZC12/WW_1_9/Soldier1.(AssistantResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="Deploying_visibility.(BuffResource).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="/Mechanics/QuestSchemes/Maintenance/SeeMobs.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <assistantResource href="/World/Quests/ZC12/WW_1_9/Soldier2.(AssistantResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="Deploying_visibility.(BuffResource).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="/Mechanics/QuestSchemes/Maintenance/SeeMobs.(BuffResource).xdb" />
