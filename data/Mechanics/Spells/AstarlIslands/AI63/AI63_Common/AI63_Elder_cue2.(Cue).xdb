		</Item>
	</conditions>
	<additionalConditions>
		<Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
			<variableResource href="/Maps/AstralIsle63/AI63_Boss01_reward.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
			<expectedValue type="gameMechanics.elements.calcers.FloatData">
