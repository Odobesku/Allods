                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                    <ability href="/Mechanics/Spells/Engineer63/Abilities/SupportDronePull/SupportDronePull02.(AbilityResource).xdb" />
                                    <anyRank>false</anyRank>
                                </Item>
                            </predicates>
                            <effectsIf>
                                <Item type="gameMechanics.elements.effects.TickableAura">
                                    <tick>1000</tick>
                                    <affectGroup>Enemies</affectGroup>
                                    <radius var="radius" />
                                    <filter type="gameMechanics.world.creature.CreatureFilter" />
