<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739884542</resourceId>
	</Header>
	<Name href="PoisonousBite.(SpellSingleTarget).Name.txt" />
	<visualScripts href="PoisonousBite.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>2000</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="PoisonBiteTargetCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</predicates>
				<impactsElse>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="PoisonBiteTargetCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="PoisonousPoison.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</impactsElse>
			</Item>
			<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
				<element>POISON</element>
				<damage>20</damage>
				<scaler type="gameMechanics.elements.scalers.MagicScaler" />
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
