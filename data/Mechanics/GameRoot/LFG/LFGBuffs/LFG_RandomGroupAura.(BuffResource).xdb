<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739918069</resourceId>
    </Header>
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.GroupAura">
                    <affectSelf>true</affectSelf>
                    <radius>85</radius>
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="LFG_RandomGroupAura_buff.(BuffResource).xdb" />
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.StackBuff">
                            <buff href="LFG_RandomGroupAura_buff.(BuffResource).xdb" />
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>-1</value>
                            </delta>
                        </Item>
                    </impactsOut>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.world.ship.elements.EffectMapChanged">
            <executeOnAttach>true</executeOnAttach>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
                                <Item type="gameMechanics.map.instance.astralIsland.PredicateOnAstralIsland" />
                                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventMember" />
                                <Item type="gameMechanics.elements.scenarios.predicates.PredicateIsOnEventScenarioMap" />
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="LFG_RandomGroupAura.(BuffResource).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
                                <Item type="gameMechanics.map.instance.astralIsland.PredicateOnAstralIsland" />
                                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventMember" />
                                <Item type="gameMechanics.elements.scenarios.predicates.PredicateIsOnEventScenarioMap" />
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="LFG_RandomGroupAura.(BuffResource).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LFG_RandomBuff.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LFG_RandomBuff_timer.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>