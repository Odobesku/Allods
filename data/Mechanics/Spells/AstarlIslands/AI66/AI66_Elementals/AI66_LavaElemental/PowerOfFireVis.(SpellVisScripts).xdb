<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/AstralDemonMage_FireRed.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.5</scale>
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<locator>Slot_BodyFX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="CreatureAnimationAction">
		<animations>
			<Item>specialCast</Item>
		</animations>
	</launch>
</SpellVisScripts>
