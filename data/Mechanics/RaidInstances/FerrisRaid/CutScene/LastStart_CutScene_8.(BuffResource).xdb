            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub12.(ClientData).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
