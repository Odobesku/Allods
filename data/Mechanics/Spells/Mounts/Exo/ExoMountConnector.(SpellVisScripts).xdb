<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Variables>
            <FXWand>/Spells/FX/Spells/ReadySpellDirectHolyWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXWand>
            <FXProjectile>/Spells/FX/Spells/Exoskeleton_Spell01_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
            <FXProjectileHit>/Spells/FX/Spells/Exoskeleton_Spell01_Projectile_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
        </Variables>
    </Header>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <playWhile />
        <elements>
            <Item type="CreatureSetFlagAction">
                <flagName>Flag_MountNeeded</flagName>
                <timeOut>0.5</timeOut>
            </Item>
            <Item type="VisActionList">
                <playWhile type="PredicateCreatureFlagAction">
                    <flagName>Flag_Emote</flagName>
                </playWhile>
                <elements>
                    <Item type="VisActionDelay">
                        <time>500</time>
                    </Item>
                </elements>
            </Item>
            <Item type="VisActionList">
                <play>InSequence</play>
                <playWhile />
                <elements>
                    <Item type="VisActionDelay">
                        <time>650</time>
                    </Item>
                    <Item type="CreatureVisActionStartThrow" />
                    <Item type="CreatureProjectileAction">
                        <projectileFx hrefvar="FXProjectile" />
                        <explosionFx hrefvar="FXProjectileHit" />
                        <theGe>5</theGe>
                        <pointOnCaster type="VisPointLocator">
                            <locator>Slot_Hand_L</locator>
                        </pointOnCaster>
                        <pointOnTarget type="VisPointLocator">
                            <locator>Slot_FX</locator>
                        </pointOnTarget>
                        <offendTime />
                    </Item>
                    <Item type="Sound3DAction">
                        <sound>
                            <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
                            <name>spells/Mount/MountExoskeleton/Projectile_Start</name>
                        </sound>
                    </Item>
                </elements>
            </Item>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <playWhile />
                <elements>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>instantSpellCastOmniWand</Item>
                        </animations>
                        <channelOverrideScript />
                        <advanced>
                            <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                        </advanced>
                    </Item>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <delay>600</delay>
                                <effectFx hrefvar="FXWand" />
                                <effectAlias href="" />
                                <fixPoint>true</fixPoint>
                                <locator>Slot_Hand_L</locator>
                                <offendTime />
                            </Item>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/Exoskeleton_Spell01_TeleportUp.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <scale>0.25</scale>
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>