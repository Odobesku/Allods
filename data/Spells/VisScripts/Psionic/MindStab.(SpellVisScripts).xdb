<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Ray_Instant.(SpellVisScripts).xdb" />
		<Variables>
			<FXOnTargets>/Spells/FX/Spells/HitAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<FXRay>/Spells/FX/Spells/PsionicMindStabNew2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXRay>
			<PreCastFX>/Spells/VisScripts/Prototypes/PreCastFXAstral.(CreatureVisActionResource).xdb</PreCastFX>
			<FXWand />
			<FXPocket>/Spells/FX/Spells/PocketSpellAstral01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXPocket>
			<LocatorOnCaster>Slot_Head</LocatorOnCaster>
			<CastAnimation>spellCastDirectedMind</CastAnimation>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationDirect.(CreatureVisActionResource).xdb</PreCastAnimation>
			<FXOnCaster>/Spells/FX/Spells/PsionicHeadCast.(VisObjectTemplate).xdb</FXOnCaster>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item type="VisActionList">
						<elements>
							<Item type="CreatureChannelDirectAction">
								<offendTime type="EffectOffendConstDelay">
									<delay>500</delay>
								</offendTime>
							</Item>
							<Item type="Sound3DAction">
								<sound>
									<project href="/SFX/Spells/Sounds.(FMODProject).xdb" />
									<name>spells/Psionic/PsionicMindStab</name>
								</sound>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<delay>600</delay>
						</Item>
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
