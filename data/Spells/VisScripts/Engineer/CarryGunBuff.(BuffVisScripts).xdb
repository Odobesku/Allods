				<Item>
					<play>channelCastDirectedEngineer</play>
					<forAnimations>
						<Item>channelCastDirected</Item>
						<Item>readySpellOmniWand</Item>
					</forAnimations>
				</Item>
				<Item>
					<play>readyEngineer</play>
					<forAnimations>
						<Item>ready</Item>
						<Item>ready1H</Item>
						<Item>readyUnarmed</Item>
						<Item>idle</Item>
						<Item>idle01</Item>
						<Item>idle02</Item>
						<Item>idle03</Item>
						<Item>idle04</Item>
						<Item>readyCast</Item>
						<Item>readyCastWand</Item>
