<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<animationKeysAction />
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>300</delay>
						<effectFx href="/Spells/FX/Mobs/Architect_Swarm_ImpulsAoe.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<scale>1.3</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>1500</time>
				</playWhile>
				<elements>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Mobs/Architect_Swarm_CastImpulsAoe.(VisObjectTemplate).xdb" />
								<offset z="-0.6" />
								<locatorName>Slot_Hand_L</locatorName>
							</Item>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Mobs/Architect_Swarm_CastImpulsAoe.(VisObjectTemplate).xdb" />
								<offset z="-0.6" />
								<locatorName>Slot_Hand_R</locatorName>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
