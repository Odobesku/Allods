<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>190922</resourceId>
    </Header>
    <name href="LightSkill.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Adds/EagleRage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsOn>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Adds/EagleRage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onEnter>
        </Item>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>0.01</level>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.02</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactMobMorph">
                    <newMobWorld href="/Creatures/Banshee/Instances/AstralIsle36/FinalBossDark.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>