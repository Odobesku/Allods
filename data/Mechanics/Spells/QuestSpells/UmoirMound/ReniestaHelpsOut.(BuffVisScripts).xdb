<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item />
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="DelayComponent">
						<timeMin>0.25</timeMin>
						<timeMax>0.25</timeMax>
						<component type="AttachedVisObjectComponent">
							<visObject href="/Spells/FX/Spells/ReadySpellDirectAstralWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<scale>2.5</scale>
							<offset z="2.5" />
							<locatorName>Slot_Global</locatorName>
							<lockScale>true</lockScale>
						</component>
					</Item>
				</visObjComponents>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
