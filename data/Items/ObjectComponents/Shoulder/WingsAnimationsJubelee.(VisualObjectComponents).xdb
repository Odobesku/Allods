<?xml version ="1.0" encoding="UTF-8" ?>
<VisualObjectComponents>
    <components>
        <Item type="AnimationFromParentComponent">
            <animationsReplacements>
                <Item>
                    <forAnimations>
                        <Item>jump</Item>
                        <Item>jumpEnd</Item>
                        <Item>jumpLandRun</Item>
                        <Item>mountRideJumpLandRun</Item>
                        <Item>mountRideJump</Item>
                        <Item>fall</Item>
                    </forAnimations>
                    <play>jump</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>mountRideJumpStart</Item>
                        <Item>jumpStart</Item>
                    </forAnimations>
                    <play>jumpStart</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>run</Item>
                        <Item>run01</Item>
                        <Item>run02</Item>
                        <Item>run1H</Item>
                        <Item>run2H</Item>
                        <Item>run2HL</Item>
                        <Item>runBow</Item>
                        <Item>runCharge</Item>
                        <Item>runSpellCharged</Item>
                        <Item>runSpellChargedWand</Item>
                    </forAnimations>
                    <play>run</play>
                </Item>
            </animationsReplacements>
            <controller href="/Characters/Upper.(AnimationController).xdb#xpointer(/client.Scene3D.AnimationController)"/>
            <ifAnimationNotExistsRun>idle</ifAnimationNotExistsRun>
            <skipBlendOptimization>false</skipBlendOptimization>
            <synchronizeAnimationPosition>false</synchronizeAnimationPosition>
        </Item>
    </components>
</VisualObjectComponents>
