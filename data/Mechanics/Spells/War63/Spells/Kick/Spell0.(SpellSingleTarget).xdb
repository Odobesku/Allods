<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>216200</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
        <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
    </groups>
    <Name href="Kick.(SpellSingleTarget).Name.txt" />
    <Description href="Kick.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="avgDamage" />
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>WeaponScalerSpeed</formula>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>1.66667</multiplier>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value var="probability" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Equipment/Boots/PlateOrcWarriorBoots.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Warrior/Kick.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>1000</duration>
            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                <multiplier var="duration" />
            </scaler>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana>25</mana>
                <rawManaScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>1.66667</multiplier>
                </rawManaScaler>
                <scaleByWeaponSpeed>true</scaleByWeaponSpeed>
                <manaType>
                    <Item>Energy</Item>
                </manaType>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                        <impactsOnHitTarget>
                            <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/InstanceModifiers/Nightmare/KnockDown/BuffKnockDown.xdb" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>2</multiplier>
                                        </durationScaler>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnHitTarget>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                                <Item type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier>1.66667</multiplier>
                                </Item>
                            </scalers>
                        </scaler>
                        <avgDamage var="avgDamage" />
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>