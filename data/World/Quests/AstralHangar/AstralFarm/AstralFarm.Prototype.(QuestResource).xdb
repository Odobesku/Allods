		</Item>
	</counters>
	<reward>
		<mandatoryItems>
			<Item>
				<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
					<item href="/Mechanics/Astral/AstralFarm/Common/AstralFarmReward70.(ItemResource).xdb" />
				</item>
				<predicates>
