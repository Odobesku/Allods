<?xml version ="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Description href="/Spells/VisScripts/Prototypes2/MeleeAttack.txt" />
    <actionBarStart type="CreatureAnimationAction">
        <visActionID></visActionID>
        <advanced>
            <autoHasten>
                <mode>AUTOHASTEN_NONE</mode>
                <timeToBeLeft>0</timeToBeLeft>
            </autoHasten>
            <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
            <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
            <offendType>NO_OFFEND</offendType>
            <turnToTarget>TURN_DEFAULT</turnToTarget>
            <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
            <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
            <denyAutoHasten>false</denyAutoHasten>
            <disableRandomFirstFrame>true</disableRandomFirstFrame>
            <eventPlaybackEnd>false</eventPlaybackEnd>
            <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
            <stopIfMoved>false</stopIfMoved>
            <stopIfRotated>false</stopIfRotated>
        </advanced>
        <animations>
            <Item>attack01</Item>
        </animations>
        <channel>CHANNEL_DEFAULT</channel>
        <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
        <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
        <mode>DIE</mode>
        <specialController></specialController>
        <use>USE_ANIMATIONS</use>
        <dontFreezePrecast>true</dontFreezePrecast>
    </actionBarStart>
    <precastType>PRECAST_DEFAULT</precastType>
    <launch type="VisActionList">
        <visActionID></visActionID>
        <elements>
            <Item type="CreatureEffectsAction">
                <visActionID></visActionID>
                <category>EFFECT_DEFAULT</category>
                <visualEffects>
                    <Item>
                        <delay>100</delay>
                        <effectAnimations>
                            <mode>DIE</mode>
                        </effectAnimations>
                        <effectFx href="/Spells/FX/Spells/ParryMelee.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                        <fadeInTime>0</fadeInTime>
                        <fadeOutTime>0</fadeOutTime>
                        <scale>1</scale>
                        <fixPoint>false</fixPoint>
                        <lockScale>false</lockScale>
                        <muteFxSounds>false</muteFxSounds>
                        <ignoreParentRotation>false</ignoreParentRotation>
                        <locator>Slot_Hand_L</locator>
                        <member>Default_Member</member>
                        <offset x="0" y="0" z="0" />
                        <rotation x="0" y="0" z="0" w="0" />
                        <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                    </Item>
                </visualEffects>
                <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                <stopOnDeath>false</stopOnDeath>
            </Item>
            <Item type="VisActionList">
                <visActionID></visActionID>
                <elements>
                    <Item type="CreatureAnimationAction">
                        <visActionID></visActionID>
                        <advanced>
                            <animationKeysActionPeriod>
                                <Item>
                                    <action type="VisActionList">
                                        <visActionID></visActionID>
                                        <elements>
                                            <Item type="CreatureTrailAction">
                                                <visActionID>TrailAction1</visActionID>
                                                <lengthMSec>10000</lengthMSec>
                                                <useItemsMainHandTrail>false</useItemsMainHandTrail>
                                            </Item>
                                            <Item type="CreatureEnchantWeaponAction">
                                                <visActionID>EnchantAction1</visActionID>
                                                <whatToEnchant>MeleeWeapon</whatToEnchant>
                                            </Item>
                                        </elements>
                                        <play>Simultaneously</play>
                                        <preconditional>false</preconditional>
                                        <restartOnVisualChange>false</restartOnVisualChange>
                                        <stopOnDeath>false</stopOnDeath>
                                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                                    </action>
                                    <stopIfAnimationStoped>true</stopIfAnimationStoped>
                                </Item>
                                <Item>
                                    <action type="VisActionList">
                                        <visActionID></visActionID>
                                        <elements>
                                            <Item type="VisActionStopAction">
                                                <stoppedActionID>TrailAction1</stoppedActionID>
                                            </Item>
                                            <Item type="VisActionStopAction">
                                                <stoppedActionID>EnchantAction1</stoppedActionID>
                                            </Item>
                                        </elements>
                                        <play>Simultaneously</play>
                                        <preconditional>false</preconditional>
                                        <restartOnVisualChange>false</restartOnVisualChange>
                                        <stopOnDeath>false</stopOnDeath>
                                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                                    </action>
                                    <stopIfAnimationStoped>true</stopIfAnimationStoped>
                                </Item>
                                <Item>
                                    <action type="VisActionList">
                                        <visActionID></visActionID>
                                        <elements>
                                            <Item type="CreatureTrailAction">
                                                <visActionID>TrailAction2</visActionID>
                                                <lengthMSec>10000</lengthMSec>
                                                <useItemsMainHandTrail>false</useItemsMainHandTrail>
                                            </Item>
                                            <Item type="CreatureEnchantWeaponAction">
                                                <visActionID>EnchantAction2</visActionID>
                                                <whatToEnchant>MeleeWeapon</whatToEnchant>
                                            </Item>
                                        </elements>
                                        <play>Simultaneously</play>
                                        <preconditional>false</preconditional>
                                        <restartOnVisualChange>false</restartOnVisualChange>
                                        <stopOnDeath>false</stopOnDeath>
                                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                                    </action>
                                    <stopIfAnimationStoped>true</stopIfAnimationStoped>
                                </Item>
                                <Item>
                                    <action type="VisActionList">
                                        <visActionID></visActionID>
                                        <elements>
                                            <Item type="VisActionStopAction">
                                                <stoppedActionID>TrailAction2</stoppedActionID>
                                            </Item>
                                            <Item type="VisActionStopAction">
                                                <stoppedActionID>EnchantAction2</stoppedActionID>
                                            </Item>
                                        </elements>
                                        <play>Simultaneously</play>
                                        <preconditional>false</preconditional>
                                        <restartOnVisualChange>false</restartOnVisualChange>
                                        <stopOnDeath>false</stopOnDeath>
                                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                                    </action>
                                    <stopIfAnimationStoped>true</stopIfAnimationStoped>
                                </Item>
                                <Item>
                                    <action type="VisActionList">
                                        <visActionID></visActionID>
                                        <elements>
                                            <Item type="CreatureTrailAction">
                                                <visActionID>TrailAction3</visActionID>
                                                <lengthMSec>10000</lengthMSec>
                                                <useItemsMainHandTrail>false</useItemsMainHandTrail>
                                            </Item>
                                            <Item type="CreatureEnchantWeaponAction">
                                                <visActionID>EnchantAction3</visActionID>
                                                <whatToEnchant>MeleeWeapon</whatToEnchant>
                                            </Item>
                                        </elements>
                                        <play>Simultaneously</play>
                                        <preconditional>false</preconditional>
                                        <restartOnVisualChange>false</restartOnVisualChange>
                                        <stopOnDeath>false</stopOnDeath>
                                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                                    </action>
                                    <stopIfAnimationStoped>true</stopIfAnimationStoped>
                                </Item>
                                <Item>
                                    <action type="VisActionList">
                                        <visActionID></visActionID>
                                        <elements>
                                            <Item type="VisActionStopAction">
                                                <stoppedActionID>TrailAction3</stoppedActionID>
                                            </Item>
                                            <Item type="VisActionStopAction">
                                                <stoppedActionID>EnchantAction3</stoppedActionID>
                                            </Item>
                                        </elements>
                                        <play>Simultaneously</play>
                                        <preconditional>false</preconditional>
                                        <restartOnVisualChange>false</restartOnVisualChange>
                                        <stopOnDeath>false</stopOnDeath>
                                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                                    </action>
                                    <stopIfAnimationStoped>true</stopIfAnimationStoped>
                                </Item>
                            </animationKeysActionPeriod>
                            <autoHasten>
                                <mode>AUTOHASTEN_NONE</mode>
                                <timeToBeLeft>0</timeToBeLeft>
                            </autoHasten>
                            <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                            <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                            <offendType>ONEOFFEND_ONETARGET</offendType>
                            <turnToTarget>TURN_DEFAULT</turnToTarget>
                            <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                            <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                            <denyAutoHasten>false</denyAutoHasten>
                            <disableRandomFirstFrame>true</disableRandomFirstFrame>
                            <eventPlaybackEnd>true</eventPlaybackEnd>
                            <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                            <stopIfMoved>false</stopIfMoved>
                            <stopIfRotated>false</stopIfRotated>
                        </advanced>
                        <animations>
                            <Item>invalid</Item>
                        </animations>
                        <channel>CHANNEL_DEFAULT</channel>
                        <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                        <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                        <mode>DIE</mode>
                        <specialController></specialController>
                        <use>USE_CURRENT_ATTACK</use>
                        <dontFreezePrecast>false</dontFreezePrecast>
                    </Item>
                    <Item type="CreatureEffectsOnTarget">
                        <visActionID></visActionID>
                        <category>EFFECT_DEFAULT</category>
                        <visualEffects>
                            <Item>
                                <delay>0</delay>
                                <effectAnimations>
                                    <mode>DIE</mode>
                                </effectAnimations>
                                <effectFx href="/Spells/FX/Spells/HitMeleeHard.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <scale>1</scale>
                                <fixPoint>true</fixPoint>
                                <lockScale>false</lockScale>
                                <muteFxSounds>true</muteFxSounds>
                                <ignoreParentRotation>false</ignoreParentRotation>
                                <locator>Slot_FX</locator>
                                <member>Default_Member</member>
                                <offset x="0" y="0" z="0" />
                                <rotation x="0" y="0" z="0" w="0" />
                                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                            </Item>
                        </visualEffects>
                        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                        <stopOnDeath>false</stopOnDeath>
                        <direction></direction>
                    </Item>
                </elements>
                <play>InSequence</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </launch>
    <ownKillingParams>
        <probabilityNoOverkill>0.2</probabilityNoOverkill>
        <probabilityWithOverkill>1</probabilityWithOverkill>
    </ownKillingParams>
    <playOnTargets>
        <specialAction type="CreatureRunVisActionResource">
            <visActionID></visActionID>
        </specialAction>
        <skipBloodFx>false</skipBloodFx>
        <skipHitAnimations>false</skipHitAnimations>
    </playOnTargets>
    <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>