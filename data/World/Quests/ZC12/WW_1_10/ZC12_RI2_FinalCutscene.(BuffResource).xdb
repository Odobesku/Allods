                                                            </mobs>
                                                        </Item>
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.elements.impacts.ImpactMobChat">
                                                            <msg href="WW_1_10_MinersCutscene.(TextMessage).xdb" />
                                                        </Item>
                                                    </impactsIf>
                                                </Item>
                                            </impacts>
                                            <spawnResource href="/Maps/ZC12_RiftInstance2/SpawnTables/ZC12_RI2_MinersCutscene.(SpawnTable).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </finishImpacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>8000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
