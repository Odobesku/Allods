<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.LootTableResource>
	<Header>
		<resourceId>739864895</resourceId>
	</Header>
	<table type="gameMechanics.constructor.schemes.item.LootTableRollIsolator">
		<lootTable type="gameMechanics.constructor.schemes.item.LootTableAnd">
			<entries>
				<Item>
					<lootTable type="gameMechanics.constructor.schemes.item.LootTableSingleItem">
						<itemProvider type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
							<item href="Items/GuardCostumeBox.(ItemResource).xdb" />
						</itemProvider>
					</lootTable>
					<chance>1</chance>
				</Item>
				<Item>
					<lootTable type="gameMechanics.constructor.schemes.item.LootTableMultiplier">
						<multiplier type="gameMechanics.elements.calcers.FloatData">
							<value>3</value>
						</multiplier>
						<table type="gameMechanics.constructor.schemes.item.LootTableExternal">
							<table href="/Items/Compensation/DR60Luck.(LootTableResource).xdb" />
						</table>
					</lootTable>
					<chance>1</chance>
				</Item>
			</entries>
		</lootTable>
	</table>
</gameMechanics.constructor.schemes.item.LootTableResource>
