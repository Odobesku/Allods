<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739921304</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Papers/LetterSealed.(UISingleTexture).xdb" />
	<itemClass href="/Mechanics/ItemClasses/Other.xdb" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<useAmount>0</useAmount>
		<usages>
			<Item>
				<predicate type="itemService.mail.predicates.PredicateOr">
					<predicates>
						<Item type="itemService.mail.predicates.PredicateQuestStatus">
							<quest href="/World/Quests/ZoneHadagan1/ZH1_Halo5/ZH1_Halo5.(QuestResource).xdb" />
							<anyStatus>
								<Item>Active</Item>
								<Item>Finished</Item>
								<Item>Completed</Item>
							</anyStatus>
						</Item>
						<Item type="itemService.mail.predicates.PredicateQuestStatus">
							<quest href="/World/Quests/ZoneLeague1/ZL1_Halo5/ZL1_Halo5.(QuestResource).xdb" />
							<anyStatus>
								<Item>Active</Item>
								<Item>Finished</Item>
								<Item>Completed</Item>
							</anyStatus>
						</Item>
					</predicates>
				</predicate>
				<actions>
					<Item type="itemService.elements.components.ItemTakeActionImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactClientData">
								<data href="/Mechanics/Rules/Strongbox/April_2015/AlreadyTakenWarning.(ClientData).xdb" />
							</Item>
						</impacts>
					</Item>
				</actions>
				<consumeItems>0</consumeItems>
			</Item>
		</usages>
	</functionalPart>
	<level>65</level>
	<requiredLevel>65</requiredLevel>
	<quality href="/Mechanics/ItemQualities/Common.xdb" />
	<prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
	<interactions>
		<availableQuests>
			<Item href="/World/Quests/ZoneHadagan1/ZH1_Halo5/ZH1_Halo5.(QuestResource).xdb" />
			<Item href="/World/Quests/ZoneLeague1/ZL1_Halo5/ZL1_Halo5.(QuestResource).xdb" />
		</availableQuests>
	</interactions>
	<binding>BindOnPickup</binding>
	<itemMallType>ITEMMALLABLE</itemMallType>
	<name href="Halo5QuestItem.(ItemResource).Name.txt" />
	<description href="Halo5QuestItem.(ItemResource).Description.txt" />
	<canBeDroppedPredicate type="gameMechanics.constructor.basicElements.PredicateFalse" />
</gameMechanics.constructor.schemes.item.ItemResource>
