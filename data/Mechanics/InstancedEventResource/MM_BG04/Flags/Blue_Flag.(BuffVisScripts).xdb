						<slot>LIFESTYLEBACK</slot>
						<newItem href="/Items/VisualItems/Cloak/Bag_Cloth_A_75BattleGround.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
					</Item>
				</items>
			</Item>
