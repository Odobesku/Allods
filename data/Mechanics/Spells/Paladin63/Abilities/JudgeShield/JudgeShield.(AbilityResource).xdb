<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739951407</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="JudgeShield.(AbilityResource).Name.txt" />
    <description href="JudgeShield.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>abs</name>
            <value var="heal" />
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>10</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                            <summands>
                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                            <element>EPHYSICAL</element>
                                        </stat>
                                    </value>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                            <element>ENATURE</element>
                                        </stat>
                                    </value>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                            <element>EDIVINE</element>
                                        </stat>
                                    </value>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                            <element>EELEMENTAL</element>
                                        </stat>
                                    </value>
                                </Item>
                            </summands>
                        </mulCalcer>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>dur</name>
            <value var="dur" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent1MinusAbs</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Warrior/WarriorDefenseCombo.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <targetImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                                <buff href="/Mechanics/Spells/Paladin63/Spells/Preaching/Preaching02.(BuffResource).xdb" />
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.effects.ImpactHealDamageThreshold">
                                            <heal var="heal" />
                                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                <scalers>
                                                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                        <mul>10</mul>
                                                        <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                                                            <summands>
                                                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                                                            <element>EPHYSICAL</element>
                                                                        </stat>
                                                                    </value>
                                                                </Item>
                                                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                                                            <element>ENATURE</element>
                                                                        </stat>
                                                                    </value>
                                                                </Item>
                                                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                                                            <element>EDIVINE</element>
                                                                        </stat>
                                                                    </value>
                                                                </Item>
                                                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                                                            <element>EELEMENTAL</element>
                                                                        </stat>
                                                                    </value>
                                                                </Item>
                                                            </summands>
                                                        </mulCalcer>
                                                    </Item>
                                                </scalers>
                                            </scaler>
                                            <resource href="/Mechanics/Spells/CommonEffects/CommonClass_Full_Threshold.(DamageThresholdResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </targetImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                        <spells>
                            <Item href="/Mechanics/Spells/Paladin63/Spells/Charge/Charge01.(SpellSingleTarget).xdb" />
                            <Item href="/Mechanics/Spells/Paladin63/Spells/SheildBash/SheildBash01.(SpellSingleTarget).xdb" />
                        </spells>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.effects.BuffDurationModifier">
                    <buffs>
                        <Item href="/Mechanics/Spells/Paladin63/Spells/Preaching/Preaching02.(BuffResource).xdb" />
                    </buffs>
                    <multiplier type="gameMechanics.elements.calcers.FloatData">
                        <value var="dur" />
                    </multiplier>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="JudgeShield01.(AbilityResource).xdb" />
        <Item href="JudgeShield02.(AbilityResource).xdb" />
        <Item href="JudgeShield03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>