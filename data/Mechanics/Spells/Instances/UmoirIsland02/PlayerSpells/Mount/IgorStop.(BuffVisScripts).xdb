<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>specialIdleStart</Item>
			<Item>specialIdle</Item>
		</animations>
	</action>
	<postAction type="CreatureAnimationAction">
		<animations>
			<Item>specialIdleEnd</Item>
		</animations>
	</postAction>
</BuffVisScripts>
