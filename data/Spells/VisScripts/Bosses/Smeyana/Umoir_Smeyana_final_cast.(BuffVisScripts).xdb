<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Smeyana_Final_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>900</fadeOutTime>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<playWhile />
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>special</Item>
						</animations>
						<channelOverrideScript />
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Smeyana_Final_CastEnd.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
			<Item skiped="" />
		</elements>
	</postAction>
</BuffVisScripts>
