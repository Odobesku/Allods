<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739913502</resourceId>
	</Header>
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>1000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateNot">
											<predicate type="gameMechanics.elements.predicates.PredicateQuestStatus">
												<quest href="Ferris_4_2_4.xdb" />
												<status>Completed</status>
											</predicate>
										</Item>
										<Item type="gameMechanics.constructor.basicElements.PredicateNot">
											<predicate type="gameMechanics.elements.predicates.PredicateQuestStatus">
												<quest href="Ferris_4_2_4.xdb" />
												<status>Finished</status>
											</predicate>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
											<quest href="Ferris_4_2_4.xdb" />
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
													<zone href="/Maps/Ferris4/ScriptZones/Ferris_4_Zimina_holo.(ScriptZone).xdb" />
												</Item>
												<Item type="gameMechanics.constructor.basicElements.PredicateNot">
													<predicate type="gameMechanics.elements.resources.ResourceBuff">
														<buff href="Ferris_4_2_4_clon_vis.(BuffResource).xdb" />
													</predicate>
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="Ferris_4_2_4_clon_vis.(BuffResource).xdb" />
												</Item>
											</impactsIf>
										</Item>
									</impactsIf>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.HealthTrigger">
			<healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
				<multiplier>0.2</multiplier>
			</healthOn>
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="CountId_2.(QuestCountId).xdb" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Ferris_4_2_4_Escape.(BuffResource).xdb" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.LifeGuard">
			<level>0.1</level>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
