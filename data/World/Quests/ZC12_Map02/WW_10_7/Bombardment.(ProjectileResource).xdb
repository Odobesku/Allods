<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739967780</resourceId>
    </Header>
    <visObject href="WW_10_7_Bombardment.(VisObjectTemplate).xdb" />
    <lifeLengthCap>3000</lifeLengthCap>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
            <radius>10</radius>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="/Creatures/Colossus/Instances/ZC12_Map02/WW_10_7_Colossus.(MobWorld).xdb" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                            <damage>1</damage>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier>0.8</multiplier>
                                </mulCalcer>
                            </scalerTarget>
                            <offends>true</offends>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <filter type="gameMechanics.world.creature.MobFilter" />
        </Item>
    </impactsOnStart>
</gameMechanics.world.projectile.ProjectileResource>