<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739858509</resourceId>
    </Header>
    <Name href="AstralProjectiles.(SpellSingleTarget).Name.txt" />
    <visualScripts href="AstralProjectiles.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>1000</prepareDuration>
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>12000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>60</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                <projectileData>
                                    <moveType type="gameMechanics.world.projectile.MoveTypeDestination" />
                                    <resource href="AstralProjectile.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                </projectileData>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                            <filters>
                                <Item type="gameMechanics.world.creature.AliveFilter" />
                                <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="ProjectileImmunity.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </predicate>
                                        </Item>
                                    </predicates>
                                </Item>
                            </filters>
                        </filter>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>5</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>