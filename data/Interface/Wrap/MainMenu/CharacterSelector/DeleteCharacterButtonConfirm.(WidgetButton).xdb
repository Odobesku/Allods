<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <BackLayer href="/Interface/Common/Elements/MsgBox/textures/MsgBoxButtonBack.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
    <FrontLayer href="/Interface/Common/Elements/MsgBox/textures/MsgBoxButtonFrame.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
    <Name>Confirm</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Pos>-56</Pos>
            <Size>112</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>20</HighPos>
            <Size>30</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing></reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>false</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>false</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>label</TextTag>
    <Variants>
        <Item>
            <PushedOffset x="0" y="1"/>
            <Reaction>delete_char_confirm_pressed</Reaction>
            <ReactionRightClick>delete_char_confirm_pressed</ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Common/Elements/MsgBox/texts/MsgBoxButtonDisabled.txt"/>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxButtonDisabled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateDisabled>
            <StateHighlighted>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxButtonHighlighted.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Common/Elements/MsgBox/texts/MsgBoxButtonNormal.txt"/>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxButtonNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxButtonPressed.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted>
                <LayerMain href="/Interface/Common/Elements/MsgBox/textures/MsgBoxButtonPressedHighlighted.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushedHighlighted>
            <TextFileRef href="/Interface/Wrap/MainMenu/CharacterSelector/DeleteCharacterButtonConfirmLabel.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
