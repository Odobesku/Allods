<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739932737</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability00.(AbilityResource).Name.txt" />
	<description href="Ability00.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="value" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Paladin/PaladinSacrifice.chn.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.SpellsModifier">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="/Mechanics/Spells/Stalker63/Spells/InstinctiveStrike/Spell01.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</predicates>
					<modifiers>
						<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
							<effects>
								<Item type="gameMechanics.elements.effects.EffectsIfTarget">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateOr">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateBinaryWrapper">
													<master type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
													<slave type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
													<binary type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
														<buff href="/Mechanics/Spells/Stalker63/Spells/EnchantPoison/PoisonStrong01.(BuffResource).xdb" />
													</binary>
												</Item>
												<Item type="gameMechanics.elements.predicates.PredicateBinaryWrapper">
													<master type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
													<slave type="gameMechanics.elements.addresseeFinders.FinderActiveSpellTarget" />
													<binary type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
														<buff href="/Mechanics/Spells/Stalker63/Spells/EnchantPoison/PoisonNormal01.(BuffResource).xdb" />
													</binary>
												</Item>
											</predicates>
										</Item>
									</predicates>
									<effectsIf>
										<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
											<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
												<coeff>0.01</coeff>
												<calcer type="gameMechanics.elements.calcers.FloatData">
													<value var="value" />
												</calcer>
											</scaler>
										</Item>
									</effectsIf>
								</Item>
							</effects>
							<onBehalfOfHolder>true</onBehalfOfHolder>
						</Item>
					</modifiers>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
