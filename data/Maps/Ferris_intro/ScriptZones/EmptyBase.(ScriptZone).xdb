<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.scriptZone.ScriptZone>
    <Header>
        <resourceId>7826</resourceId>
    </Header>
    <filter type="gameMechanics.world.creature.AvatarFilter" />
    <impactsIn>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.world.avatar.assistants.PredicateHasAssistant">
                    <assistantResource href="/Characters/Hadagan_female/Instances/Ferris/Zimina_assistant.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                    <impacts>
                        <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="/World/Quests/Ferris01/Ferris_1_2/EmptyPlace.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </Item>
                            </impacts>
                            <assistantResource href="/Characters/Hadagan_female/Instances/Ferris/Zimina_assistant.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>1000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                            <zone href="EmptyBase.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsIf>
        </Item>
    </impactsIn>
</gameMechanics.map.scriptZone.ScriptZone>