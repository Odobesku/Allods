<?xml version="1.0" encoding="UTF-8" ?>
<UIAddon>
	<Name>ReadyCheck</Name>
	<AutoStart>true</AutoStart>
	<ScriptFileRefs>
		<Item href="/Interface/Common/Script/ScriptStandardExtension.lua" />
		<Item href="/Interface/Common/Script/ScriptCommonUtility.lua" />
		<Item href="/Interface/Common/Script/ScriptMultipleEventHandlers.lua" />
		<Item href="Names/Names.lua" />
		<Item href="ReadyCheck.lua" />
	</ScriptFileRefs>
	<MainFormId>MainForm</MainFormId>
	<Forms>
		<Item>
			<Id>MainForm</Id>
			<Form href="MainForm.(WidgetForm).xdb#xpointer(/WidgetForm)" />
		</Item>
	</Forms>
	<texts href="ReadyCheck.(UIRelatedTexts).xdb#xpointer(/UIRelatedTexts)" />
	<textsGroups>
		<Item>
			<groupName>AvatarNameFormat</groupName>
			<texts href="/Interface/Ingame/ContextRelatedTexts/AvatarNameFormat/AvatarNameFormat.(UIRelatedTexts).xdb#xpointer(/UIRelatedTexts)" />
		</Item>
	</textsGroups>
</UIAddon>
