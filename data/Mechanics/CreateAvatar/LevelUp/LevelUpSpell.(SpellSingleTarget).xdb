<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>253155</resourceId>
    </Header>
    <Name href="/Mechanics/Spells/ItemMall/AvatarDonate/LevelUpSpell.(SpellSingleTarget).Name.txt" />
    <Description href="/Mechanics/Spells/ItemMall/AvatarDonate/LevelUpSpell.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Teleportation.(SpellVisScripts).xdb" />
    <prepareDuration>10000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <!-- <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel"> -->
            <!-- <minLevel type="gameMechanics.formulas.IntConstantValue"> -->
            <!-- <value>4</value> -->
            <!-- </minLevel> -->
            <!-- </Item> -->
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateIsRemort" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                <faction href="/World/Factions/League.xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                <faction href="/World/Factions/Empire.xdb" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                <faction href="/World/Factions/League.xdb" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                <impactsResource href="/Mechanics/Spells/ItemMall/AvatarDonate/LevelUpSpell_L.(ImpactListResource).xdb" />
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                <impactsResource href="/Mechanics/Spells/ItemMall/AvatarDonate/LevelUpSpell_E.(ImpactListResource).xdb" />
                            </Item>
                        </impactsElse>
                    </Item>
                    <!-- <Item type="gameMechanics.elements.impacts.ImpactAddExperience"> -->
                    <!-- <calcer type="gameMechanics.elements.calcers.CalcerRemainingExpirience"> -->
                    <!-- <level type="gameMechanics.elements.calcers.LongData"> -->
                    <!-- <value>70</value> -->
                    <!-- </level> -->
                    <!-- </calcer> -->
                    <!-- <direct>true</direct> -->
                    <!-- <scaleByGlobal>false</scaleByGlobal> -->
                    <!-- <transactional>true</transactional> -->
                    <!-- </Item> -->
                    <Item type="gameMechanics.elements.impacts.ImpactAddExperience">
                        <calcer type="gameMechanics.elements.calcers.CalcerRemainingExpirience">
                            <level type="gameMechanics.elements.calcers.LongData">
                                <value>70</value>
                            </level>
                        </calcer>
                        <direct>true</direct>
                        <scaleByGlobal>false</scaleByGlobal>
                        <transactional>true</transactional>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="LevelUpSpell_All_main.(ImpactListResource).xdb" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactClientData">
                        <data href="/Mechanics/Spells/ItemMall/AvatarDonate/PridenFactionChoise.(ClientData).xdb" />
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>