<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Red_R10.(VisObjectTemplate).xdb" />
                        <lockScale>true</lockScale>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>levelUp</Item>
                </animations>
            </Item>
        </elements>
    </action>
    <postAction type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <delay>0</delay>
                <effectFx href="/Spells/FX/Mobs/LandMine_MineExplosion.(VisObjectTemplate).xdb" />
                <lockScale>true</lockScale>
                <scale>1</scale>
            </Item>
        </visualEffects>
    </postAction>
</BuffVisScripts>