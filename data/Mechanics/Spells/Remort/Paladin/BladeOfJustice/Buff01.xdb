                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier>1.5</multiplier>
                                            </durationScaler>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOnHitTarget>
                            <scaler type="gameMechanics.elements.scalers.ScalerMax">
                                <scaler1 type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                    <scalers>
                                        <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                                        <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                                    </scalers>
                                </scaler1>
                                <scaler2 type="gameMechanics.elements.scalers.MagicScaler" />
                            </scaler>
                            <minDamage>20</minDamage>
                            <maxDamage>20</maxDamage>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <buff href="Buff01.xdb" />
            <speedFactor>3</speedFactor>
            <pathChecker type="space.pathfinding.pathChecker.PathDeviationLimited">
                <angle>0.5236</angle>
