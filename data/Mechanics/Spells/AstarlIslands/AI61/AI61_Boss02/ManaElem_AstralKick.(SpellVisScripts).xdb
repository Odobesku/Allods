<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PsionicTelekineticTrustAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <fixPoint>true</fixPoint>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="ShakeAction">
                <params href="/Spells/FX/InterfaceFX/CameraShakeVert1.(CameraShakeParameters).xdb#xpointer(/CameraShakeParameters)" />
            </Item>
        </elements>
    </launch>
</SpellVisScripts>