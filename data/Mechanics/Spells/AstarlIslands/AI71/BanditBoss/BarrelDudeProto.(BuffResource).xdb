<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>188397</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                    <mobs>
                        <Item href="/Mechanics/Spells/AstarlIslands/AI71/BarrelDude/BarrelDude.(MobWorld).xdb" />
                    </mobs>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.DeathTrigger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff hrefvar="buff" />
                                </Item>
                            </impacts>
                            <spawnResource href="/Maps/AstralIsle71/SpawnTables/2_Boss02.(SpawnTable).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/AstarlIslands/AI71/Common/SummonHumanoid.(BuffResource).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effectsIf>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>