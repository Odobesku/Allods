<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>321295</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/Inst_ZoneContested12_Start/Zones/Ship1.(ZoneResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/Inst_ZoneContested12_Start/Zones/Ship2.(ZoneResource).xdb" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.DeathTrigger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="WW_1_2.xdb" />
                        </Item>
                    </impacts>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                            <zone href="/Maps/Inst_ZoneContested12_Start/Zones/Ship1.(ZoneResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                            <zone href="/Maps/Inst_ZoneContested12_Start/Zones/Ship2.(ZoneResource).xdb" />
                                        </Item>
                                    </predicates>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                                    <quest href="WW_1_2.xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
            <impactsOnLeave>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                            <quest href="WW_1_2.xdb" />
                            <counterResource href="Counter1.(QuestCountId).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="WW_1_2.xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOnLeave>
            <activeZone href="/Maps/Inst_ZoneContested12_Start/Zones/Astral_fleet.(ZoneResource).xdb" />
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>