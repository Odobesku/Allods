<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>250</fadeInMS>
    <fadeOutMS>250</fadeOutMS>
    <geometry href="/Spells/FX/Spells/AOE_Earthquake.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <particle href="/Spells/FX/Spells/AOE_Earthquake.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)" />
    <scale>3</scale>
    <sound>
        <name>spells/FX/Spells/DemonForm_Earthquake</name>
        <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
    </sound>
    <states>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/Spells/AOE_Earthquake.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <visObjComponents>
        <Item type="CameraShakerComponent">
            <params href="/Spells/FX/InterfaceFX/Aoe_85.(CameraShakeParameters).xdb#xpointer(/client.VisualConstructor.CameraShakeParameters)" />
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>