<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>196713</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/RaceClassSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <element>PHYSICAL</element>
    <Name href="Spell_Name.txt" />
    <Description href="Spell_Desc.txt" />
    <image href="/Interface/Icons/Spells/Paladin/CryCommissars.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Warrior/Kania.(SpellVisScripts).xdb" />
    <level>1</level>
    <prepareDuration>0</prepareDuration>
    <immutablePrepareDuration>false</immutablePrepareDuration>
    <needLos>true</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>true</isAggro>
    <replaceLowRanks>true</replaceLowRanks>
    <isWorkOnDead>false</isWorkOnDead>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>true</triggersGlobalCooldown>
    <ignoreGlobalCooldown>false</ignoreGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <stage>Launch</stage>
            <duration>45000</duration>
            <group href="/Mechanics/Spells/Groups/RaceClassSpells.xdb" />
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                <radius>30</radius>
                <affectPets>true</affectPets>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/WillPower/WillPower.(BuffResource).xdb" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>4</multiplier>
                        </durationScaler>
                    </Item>
                    <Item type="gameMechanics.world.avatar.assistants.ImpactsToAllAssistants">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/WillPower/WillPower.(BuffResource).xdb" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>4</multiplier>
                                        </durationScaler>
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Cowardice/Cowardice.(BuffResource).xdb" />
                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                    <multiplier>4</multiplier>
                </durationScaler>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                <value>10</value>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>0</speed>
    <maxTargets>0</maxTargets>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>30</radius>
    <stopOnNoTargets>false</stopOnNoTargets>
</gameMechanics.constructor.schemes.spell.area.SpellArea>