    </states>
    <visObjComponents>
        <Item type="LightComponent">
            <attenuationPower>2</attenuationPower>
            <direction x="0" y="0" z="0" />
            <intensity>2</intensity>
            <pivot x="0" y="0" z="0" />
            <radius>155</radius>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>