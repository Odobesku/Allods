<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739920599</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
    </groups>
    <Name href="Spell0.(SpellArea).Name.txt" />
    <Description href="Spell0.(SpellArea).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/WarJumpPowerful.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Warrior/HowlingStrike.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <targetType>STTPoint</targetType>
    <ranks>
        <Item href="Spell01.(SpellArea).xdb" />
        <Item href="Spell02.(SpellArea).xdb" />
        <Item href="Spell03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration var="cd_duration" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCanMove" />
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceMana">
                <mana var="mana" />
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAvatarJump">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierTrailFrom">
                            <from type="gameMechanics.map.destination.SelfPosDestination" />
                        </Item>
                    </modifiers>
                </destination>
                <speed>30</speed>
                <impactsOnLand>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>7</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Jump.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.creature.AliveFilter" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="/Spells/ClientData/HowlingStrike.(ClientData).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="Buff.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impactsOnLand>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Buff.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>7</radius>
    <pathChecker type="space.pathfinding.pathChecker.PathNotTrivial" />
</gameMechanics.constructor.schemes.spell.area.SpellArea>