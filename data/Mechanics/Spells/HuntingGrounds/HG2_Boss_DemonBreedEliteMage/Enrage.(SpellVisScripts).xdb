<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FixPointTarget>true</FixPointTarget>
			<PreCastAnimation>readySpell</PreCastAnimation>
			<LocatorOnTargets>Slot_Head</LocatorOnTargets>
			<LocatorOnCaster>Slot_Head</LocatorOnCaster>
			<FXOnCaster />
			<CastAnimation>spellCastOmni</CastAnimation>
			<FXOnTargets>/Spells/FX/Spells/ReadySpellDirectAstralWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<scale>1.7</scale>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<scale>1.5</scale>
							<locator var="LocatorOnTargets" />
						</Item>
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
