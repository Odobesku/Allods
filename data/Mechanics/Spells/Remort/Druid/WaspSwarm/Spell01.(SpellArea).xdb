<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739952403</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/RemortSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
	</groups>
	<Name href="Spell01.(SpellArea).Name.txt" />
	<Description href="Spell01.(SpellArea).Description.txt" />
	<image href="/Interface/Icons/Spells/Druid/DruidEntanglingRoots.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Druid/RemortDruid_Roots.(SpellVisScripts).xdb" />
	<sysName>CategoryRemort</sysName>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>30</value>
	</range>
	<prepareDuration>2000</prepareDuration>
	<targetType>STTPoint</targetType>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>1000</duration>
			<scaler type="gameMechanics.elements.scalers.ScalerExternal">
				<scalerResource href="WaspSwarm.(ScalerResource).xdb" />
			</scaler>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
				<projectileData>
					<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
						<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
						<directed>false</directed>
					</moveType>
					<resource href="Roots.(ProjectileResource).xdb" />
				</projectileData>
			</Item>
			<Item type="gameMechanics.constructor.basicElements.ImpactList">
				<impactsResource href="/Mechanics/Spells/Remort/RemortSpellsCD.(ImpactListResource).xdb" />
			</Item>
		</casterImpacts>
	</mechanics>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<radius>10</radius>
	<stopOnNoTargets>false</stopOnNoTargets>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
