<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739919120</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                            <zone href="OutOfBordersZone.(ScriptZone).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.resources.ResourceAnyBuff">
                                        <buffs>
                                            <Item href="/Mechanics/RaidInstances/FerrisRaid/15_General/Allies/Timelapse.(BuffResource).xdb" />
                                            <Item href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/Bombs/BombMechanics.(BuffResource).xdb" />
                                        </buffs>
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="OutOfBordersSwarm.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="OutOfBordersSwarm.(BuffResource).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="OutOfBordersWatcher.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="OutOfBordersSwarm.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="OutOfBordersSwarmStackable.(BuffResource).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
            <tick>500</tick>
            <initialDelay>5000</initialDelay>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
