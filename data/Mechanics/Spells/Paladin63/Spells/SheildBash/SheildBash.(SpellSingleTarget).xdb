    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <Name href="SheildBash.(SpellSingleTarget).Name.txt" />
    <Description href="SheildBash.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>200</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>Shield</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Warrior/WarriorShieldBash.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Warrior/ShieldBash.(SpellVisScripts).xdb" />
