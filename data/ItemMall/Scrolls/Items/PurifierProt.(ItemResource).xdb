            <Item>
                <itemPredicate type="gameMechanics.elements.item.ItemPredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.constructor.schemes.item.ItemPredicateCursed"/>
                        <Item type="gameMechanics.constructor.schemes.item.ItemPredicateGreater">
                            <lhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerStack"/>
