<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
  <actionBarStart type="client.Replica.VisActionList">
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </actionBarStart>
  <precastType>PRECAST_DEFAULT</precastType>
  <wholeCasting type="client.Replica.VisActionList">
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </wholeCasting>
  <launch type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.CreatureProjectileAction">
            <explosionFx href="/Spells/FX/Spells/HitLightning_big.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <offendTime type="client.Replica.EffectOffendConstDelay">
              <delay>0</delay>
            </offendTime>
            <optionalSpeed>0</optionalSpeed>
            <pointOnCaster type="client.Replica.VisPointLocator">
              <shift x="0" y="0" z="0" />
              <from>FROM_DEFALUT</from>
              <locator>FROM_LOCATOR_NAME</locator>
              <locatorName>Slot_Special01</locatorName>
              <member>Default_Member</member>
            </pointOnCaster>
            <pointOnTarget type="client.Replica.VisPointLocator">
              <shift x="0" y="0" z="0" />
              <from>FROM_DEFALUT</from>
              <locator>Global</locator>
              <member>Default_Member</member>
            </pointOnTarget>
            <projectileFx href="/Spells/FX/Spells/MageLightningBallsAbility.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <theGe>1.5</theGe>
            <dontFade>false</dontFade>
            <isInverted>false</isInverted>
            <isMultyProjectile>false</isMultyProjectile>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.CreatureEffectsAction">
            <category>EFFECT_DEFAULT</category>
            <visualEffects>
              <Item>
                <delay>0</delay>
                <effectAnimations>
                  <mode>DIE</mode>
                </effectAnimations>
                <effectFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                <fadeInTime>250</fadeInTime>
                <fadeOutTime>250</fadeOutTime>
                <scale>1</scale>
                <fixPoint>true</fixPoint>
                <lockScale>false</lockScale>
                <muteFxSounds>false</muteFxSounds>
                <ignoreParentRotation>true</ignoreParentRotation>
                <locator>Global</locator>
                <member>Default_Member</member>
                <offset x="0" y="0" z="0" />
                <rotation x="0" y="0" z="0" w="0" />
                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
              </Item>
            </visualEffects>
            <dontFade>false</dontFade>
            <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
            <stopOnDeath>false</stopOnDeath>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="client.Replica.VisActionDelay">
          <time>1000</time>
        </playWhile>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.SLON.CreatureRotateToCastPointAction">
            <immediateTurn>true</immediateTurn>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <playWhile type="client.Replica.VisActionDelay">
          <time>200</time>
        </playWhile>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </launch>
  <ownKillingParams>
    <probabilityNoOverkill>0.2</probabilityNoOverkill>
    <probabilityWithOverkill>1</probabilityWithOverkill>
  </ownKillingParams>
  <playOnTargets>
    <skipBloodFx>false</skipBloodFx>
    <skipHitAnimations>false</skipHitAnimations>
  </playOnTargets>
  <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>