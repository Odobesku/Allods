<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>223423</resourceId>
    </Header>
    <name href="Raid_Entrance01.(Cue).Name.txt" />
    <text href="Raid_Entrance01.(Cue).Text.txt" />
    <conditions>
        <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
            <key href="/System/ContentKeys/FerrisRaid.(ContentKey).xdb" />
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
            <quest href="/World/Quests/Ferris01/Ferris_1_16_1/Ferris_1_16_1.(QuestResource).xdb" />
            <status>Finished</status>
        </Item>
    </conditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateInRaid">
                    <policy>Small</policy>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>FR_Entrance</scriptID>
                            <map href="/Maps/FerrisRaid/MapResource.xdb" />
                        </locator>
                    </destination>
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                    <data href="/Mechanics/RaidInstances/SmallRaidWarning.(ClientData).xdb" />
                </Item>
            </impactsElse>
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>