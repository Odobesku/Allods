<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ShadowMoon_BigAoe.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fixPoint>true</fixPoint>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>special</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
