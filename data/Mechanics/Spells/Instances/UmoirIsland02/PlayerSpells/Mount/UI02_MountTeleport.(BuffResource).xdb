<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739856022</resourceId>
	</Header>
	<visScript href="UI02_MountTeleport.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>3000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactTeleport">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>KoscheyDungeon</scriptID>
									<map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
								</locator>
								<yaw type="constructor.basicElements.AngleDegrees" />
							</destination>
							<finishImpacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="UI02_MountDeath.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
							</finishImpacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<duration>4000</duration>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
