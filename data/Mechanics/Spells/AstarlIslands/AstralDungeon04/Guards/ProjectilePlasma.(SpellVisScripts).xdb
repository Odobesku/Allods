<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBossSpear_Ice.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<fadeInTime>400</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBossSpear_Ice.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<fadeInTime>400</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/VoidEvil_R4.(VisObjectTemplate).xdb" />
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedBall</Item>
				</animations>
				<advanced>
					<animationKeysAction>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureEffectsAction">
										<visualEffects>
											<Item>
												<locator>Slot_Hand_R</locator>
											</Item>
										</visualEffects>
									</Item>
									<Item type="CreatureProjectileAction">
										<projectileFx href="/Spells/FX/Spells/PlasmaBall_Projectile02_Small.(VisObjectTemplate).xdb" />
										<explosionFx href="/Spells/FX/Spells/HitManaball.(VisObjectTemplate).xdb" />
										<theGe>10</theGe>
										<pointOnCaster type="VisPointLocator">
											<locator>Slot_Hand_R</locator>
										</pointOnCaster>
										<pointOnTarget type="VisPointLocator">
											<locator>Slot_Global</locator>
										</pointOnTarget>
										<offendTime type="EffectOffendConstVelocity">
											<velocity>15</velocity>
										</offendTime>
									</Item>
								</elements>
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
