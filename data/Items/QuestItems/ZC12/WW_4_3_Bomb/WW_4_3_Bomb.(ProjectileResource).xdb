<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739934869</resourceId>
	</Header>
	<visObject href="/Spells/FX/Spells/Invisible_Projectile.(VisObjectTemplate).xdb" />
	<impactsOnStart>
		<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
			<radius>85</radius>
			<affectGroup>Enemies</affectGroup>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="/Items/QuestItems/ZC12/WW_4_3_Bomb/WW_4_3_BombShot.(ClientData).xdb" />
					<calcers>
						<resourceEntries />
						<addressEntries>
							<Item>
								<name>caster</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
							</Item>
							<Item>
								<name>target</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
							</Item>
						</addressEntries>
						<coordEntries />
						<stringEntries />
						<longEntries />
						<floatEntries />
					</calcers>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>1000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactKill" />
					</impacts>
				</Item>
			</impacts>
			<finalImpactsOnHolder>
				<Item type="gameMechanics.elements.impacts.Disintegrate" />
			</finalImpactsOnHolder>
			<filter type="gameMechanics.constructor.basicElements.FilterAnd">
				<filters>
					<Item type="gameMechanics.world.creature.MobFilter" />
					<Item type="gameMechanics.world.creature.AliveFilter" />
					<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
								<mobs>
									<Item href="/Creatures/ArchitectSiege/Instances/ZC12_RI3_ArchitectSiege.(MobWorld).xdb" />
								</mobs>
							</Item>
						</predicates>
					</Item>
				</filters>
			</filter>
			<targetsLimit>1</targetsLimit>
		</Item>
	</impactsOnStart>
</gameMechanics.world.projectile.ProjectileResource>