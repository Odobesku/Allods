<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirected</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/FlamethrowerHenchman_Flame_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>0.5</scale>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Slot_Special01</locatorName>
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/FlamethrowerHenchman_Flame_01_AT_Fire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>0.45</scale>
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Slot_Special01</locatorName>
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/Engineer_FlamethrowerWide.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<locator>FROM_LOCATOR_NAME</locator>
								<locatorName>Slot_Special01</locatorName>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>channelCastDirected</play>
							<forAnimations>
								<Item>run</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
