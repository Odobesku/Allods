<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>ready</Item>
		</animations>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialCast</Item>
				</animations>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
