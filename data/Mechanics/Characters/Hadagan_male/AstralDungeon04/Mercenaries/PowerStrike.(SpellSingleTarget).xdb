								<isPersonalPool>true</isPersonalPool>
							</Item>
						</impactsIf>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.BuffDetacher">
				<buff href="PowerStrikeTarget.(BuffResource).xdb" />
