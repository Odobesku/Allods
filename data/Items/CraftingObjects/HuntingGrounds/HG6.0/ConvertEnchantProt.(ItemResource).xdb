<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>507112</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <source>Crafted</source>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <warningUseText hrefvar="warningUseText" />
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item hrefvar="item" />
                        </item>
                        <binding>Transfer</binding>
                        <modifiers>
                            <Item type="itemService.avatar.itemBag.TransferCurseModifier" />
                        </modifiers>
                    </Item>
                </actions>
                <consumeItems>1</consumeItems>
            </Item>
        </usages>
        <useStack>true</useStack>
    </functionalPart>
    <level>60</level>
    <requiredLevel>60</requiredLevel>
    <stackLimit>100</stackLimit>
    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <binding>BindOnPickup</binding>
    <category href="/Mechanics/ItemCategories/Jewelry/Enchant.(ItemCategoryTerminal).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
</gameMechanics.constructor.schemes.item.ItemResource>