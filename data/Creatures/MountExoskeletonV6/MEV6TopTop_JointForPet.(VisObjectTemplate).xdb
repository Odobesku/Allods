            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <visObjComponents>
        <Item type="ChainAnimatorComponent">
            <chains>
                <Item>
                    <gravity x="0" y="0" z="0" />
                    <nodes>
                        <Item>joint1</Item>
                        <Item>joint2</Item>
                        <Item>Slot_Special99</Item>
                    </nodes>
                    <resistance>10</resistance>
                    <spring>3</spring>
                    <useDefaultGravity>true</useDefaultGravity>
                </Item>
            </chains>
            <ignoreVisObjMotion>false</ignoreVisObjMotion>
