<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739940223</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="FleeingBuff.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EventTrigger">
            <eventClasses>
                <Item>gameMechanics.world.mob.behaviour.aiEvents.GoneThroughPathEvent</Item>
            </eventClasses>
            <impacts>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>8000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="FleeingBuff.(BuffResource).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>