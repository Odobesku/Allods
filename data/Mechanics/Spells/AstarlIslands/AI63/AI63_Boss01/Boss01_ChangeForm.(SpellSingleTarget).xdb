<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739911418</resourceId>
    </Header>
    <Name href="Boss01_ChangeForm.(SpellSingleTarget).Name.txt" />
    <visualScripts href="Boss01_summonAdds.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>1000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>36000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                <level>0.02</level>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                <level>0.85</level>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="AI63_Boss01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </mobs>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactMobMorph">
                        <newMobWorld href="AI63_Boss01_Werewolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                                <pool href="Boss01_addWolfs.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                <mobs>
                                                    <Item href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                </mobs>
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                <predicates>
                                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                            <buff href="Boss01_WolfFear.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                        </predicate>
                                                    </Item>
                                                </predicates>
                                                <impactsIf>
                                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                        <buff href="Boss01_WolfFollowBoss.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                    </Item>
                                                </impactsIf>
                                            </Item>
                                            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ImpactMobMorph">
                                                        <newMobWorld href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWerewolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                    </Item>
                                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                        <buff href="Boss01_WolfFear.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                    </Item>
                                                    <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                                </impacts>
                                            </Item>
                                        </impactsIf>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                        <pool href="Boss01_Puddles.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        </impacts>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactMobMorph">
                        <newMobWorld href="AI63_Boss01.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                                <level>0.7</level>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                                <impact type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                <radius type="gameMechanics.elements.calcers.FloatData">
                                                    <value>5</value>
                                                </radius>
                                            </Item>
                                        </modifiers>
                                    </destination>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                    </impacts>
                                    <object href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <pool href="Boss01_addWolfs.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                </impact>
                                <count type="gameMechanics.elements.calcers.FloatData">
                                    <value>2</value>
                                </count>
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                                        <level>0.4</level>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                                        <impact type="gameMechanics.elements.impacts.ImpactSummon">
                                            <destination type="gameMechanics.map.destination.DestinationModified">
                                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                <modifiers>
                                                    <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                        <radius type="gameMechanics.elements.calcers.FloatData">
                                                            <value>5</value>
                                                        </radius>
                                                    </Item>
                                                </modifiers>
                                            </destination>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                            </impacts>
                                            <object href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                            <pool href="Boss01_addWolfs.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                        </impact>
                                        <count type="gameMechanics.elements.calcers.FloatData">
                                            <value>3</value>
                                        </count>
                                    </Item>
                                </impactsIf>
                                <impactsElse>
                                    <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                                        <impact type="gameMechanics.elements.impacts.ImpactSummon">
                                            <destination type="gameMechanics.map.destination.DestinationModified">
                                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                <modifiers>
                                                    <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                        <radius type="gameMechanics.elements.calcers.FloatData">
                                                            <value>5</value>
                                                        </radius>
                                                    </Item>
                                                </modifiers>
                                            </destination>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                            </impacts>
                                            <object href="/Mechanics/Spells/AstarlIslands/AI63/AI63_Packs/Boss01_addWolf.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                            <pool href="Boss01_addWolfs.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                        </impact>
                                        <count type="gameMechanics.elements.calcers.FloatData">
                                            <value>4</value>
                                        </count>
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impactsElse>
                    </Item>
                </impactsElse>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/AstarlIslands/AI63/AI63_StopMove.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>