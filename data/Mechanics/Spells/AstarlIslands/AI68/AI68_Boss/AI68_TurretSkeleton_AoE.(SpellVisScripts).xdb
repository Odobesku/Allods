<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>chargenEngineer</Item>
        </animations>
    </wholeCasting>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureProjectileAction">
                <projectileFx href="AI68_SkeletonTurret_ball.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <explosionFx href="AI68_SkeletonTurret_ball_explosion.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <theGe>6</theGe>
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_Hand_L</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_Global</locator>
                </pointOnTarget>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirectedEngineer</Item>
                </animations>
            </Item>
        </elements>
    </launch>
    <playOnTargets>
        <specialAction type="CreatureEffectsAction">
            <visualEffects>
                <Item>
                    <effectFx href="AI68_TurretSkeleton_AoE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                </Item>
            </visualEffects>
        </specialAction>
    </playOnTargets>
</SpellVisScripts>