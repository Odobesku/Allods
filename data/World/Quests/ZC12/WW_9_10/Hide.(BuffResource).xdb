<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739951850</resourceId>
	</Header>
	<visScript href="Hide.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDoesNotAggro" />
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="DialogVis.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInZone">
							<zone href="/Maps/ZC12_Map02/Zones/ZC12_Zone_05_01.(ZoneResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactSummon">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>WW_9_10_Rubilo_loc</scriptID>
									<map href="/Maps/ZC12_Map02/MapResource.xdb" />
								</locator>
							</destination>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/World/Quests/ZC12/WW_1_5/Sniper_vis.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.elements.impacts.PostponedImpacts">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ForceAggro" />
									</impacts>
								</Item>
							</impacts>
							<object href="/Characters/Orc_male/Instances/ZC12_Map02/ZC12_Rubilo_agressive.(MobWorld).xdb" />
							<pool href="Rubilo.(SummonPool).xdb" />
							<isPersonalPool>true</isPersonalPool>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactSummon">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>WW_9_10_Rubilo_loc</scriptID>
									<map href="/Maps/ZC12_Map02/MapResource.xdb" />
								</locator>
							</destination>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="Kopito_run_vis.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.elements.impacts.GoThroughPath">
									<runningMode>true</runningMode>
									<path>
										<Item>
											<scriptID>WW_9_10_Kopito_run</scriptID>
											<map href="/Maps/ZC12_Map02/MapResource.xdb" />
										</Item>
									</path>
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
									<delay>3000</delay>
									<impacts>
										<Item type="gameMechanics.elements.impacts.Disintegrate" />
										<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
											<impacts>
												<Item type="gameMechanics.elements.impacts.BuffDetacher">
													<buff href="Kopito_run_vis.(BuffResource).xdb" />
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
							</impacts>
							<object href="/Creatures/Minotaur/Instances/ZC12_Map02/ZC12_Kopito_run.(MobWorld).xdb" />
							<pool href="Rubilo.(SummonPool).xdb" />
							<isPersonalPool>true</isPersonalPool>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactSummon">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>WW_9_10_Troll_loc</scriptID>
									<map href="/Maps/ZC12_Map02/MapResource.xdb" />
								</locator>
							</destination>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/World/Quests/ZC12/WW_1_5/Sniper_vis.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Troll.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.PostponedImpacts">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ForceAggro" />
									</impacts>
								</Item>
							</impacts>
							<object href="/Creatures/Troll/Instances/ZC12_Map02/WW_9_10_Troll_agressive.(MobWorld).xdb" />
							<pool href="Rubilo.(SummonPool).xdb" />
							<isPersonalPool>true</isPersonalPool>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="Counter3.(QuestCountId).xdb" />
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
							<quest href="WW_9_10.xdb" />
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Shot1.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Shot2.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Shot3.(BuffResource).xdb" />
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
