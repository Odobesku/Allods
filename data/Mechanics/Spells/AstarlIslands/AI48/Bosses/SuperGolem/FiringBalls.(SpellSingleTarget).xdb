	<visualScripts href="FiringBalls.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>1000</prepareDuration>
	<needLos>false</needLos>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>1</duration>
			<scaler type="gameMechanics.elements.scalers.ScalerBuff">
				<buff href="Bonus.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				<multiplier>75</multiplier>
				<summand>0</summand>
				<checkCaster>true</checkCaster>
			</scaler>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
				<spell href="Attack.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
