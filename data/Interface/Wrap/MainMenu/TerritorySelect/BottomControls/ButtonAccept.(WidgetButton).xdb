<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>ButtonAccept</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>72</HighPos>
            <Size>132</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <HighPos>16</HighPos>
            <Pos>8</Pos>
            <Size>130</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>accept_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_DEFAULT</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag></TextTag>
    <Variants>
        <Item>
            <PushedOffset x="0" y="0"/>
            <Reaction>accept_pressed</Reaction>
            <ReactionRightClick>accept_pressed</ReactionRightClick>
            <StateDisabled>
                <LayerMain href="/Interface/Wrap/MainMenu/CharacterGenerator3/Common/ButtonAcceptDisabled.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateDisabled>
            <StateHighlighted>
                <LayerMain href="/Interface/Wrap/MainMenu/CharacterGenerator3/Common/ButtonAcceptHighlighted.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateHighlighted>
            <StateNormal>
                <LayerMain href="/Interface/Wrap/MainMenu/CharacterGenerator3/Common/ButtonAcceptNormal.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Wrap/MainMenu/CharacterGenerator3/Common/ButtonAcceptPressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted>
                <LayerMain href="/Interface/Wrap/MainMenu/CharacterGenerator3/Common/ButtonAcceptPressedHighlighted.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushedHighlighted>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
