<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states>
		<Item>
			<action type="DeviceAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<animations>
					<Item>ready</Item>
				</animations>
			</action>
			<prevState>1</prevState>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<animations>
					<Item>run</Item>
				</animations>
			</action>
			<prevState>1</prevState>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<animations>
					<Item>walk</Item>
				</animations>
			</action>
			<prevState>1</prevState>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<animations>
					<Item>idle</Item>
				</animations>
			</action>
			<prevState>1</prevState>
		</Item>
	</states>
	<defaultVisAction />
</DeviceVisScripts>
