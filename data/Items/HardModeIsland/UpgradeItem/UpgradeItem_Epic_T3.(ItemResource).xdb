<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>740021657</resourceId>
	</Header>
	<binding>BindOnPickup</binding>
	<descVars>
		<Item>
			<name>perc</name>
			<value>109</value>
		</Item>
	</descVars>
	<description href="UpgradeItemProto.(ItemResource).Description.txt" />
	<functionalPart type="itemService.avatar.itemBag.UseOnItemAndTakeActions">
        <multipleUse>true</multipleUse>
		<highlightPredicate type="gameMechanics.elements.item.ItemPredicateAnd">
			<predicates>
				<Item type="gameMechanics.elements.item.ItemPredicateOr">
					<predicates>
						<Item type="gameMechanics.elements.item.ItemPredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.item.ItemPredicateQuality">
									<quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateQuality">
									<quality href="/Mechanics/ItemQualities/Uncommon.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateQuality">
									<quality href="/Mechanics/ItemQualities/Rare.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateQuality">
									<quality href="/Mechanics/ItemQualities/Epic.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
								</Item>
							</predicates>
						</Item>
						<Item type="gameMechanics.constructor.schemes.item.ItemPredicateGreater">
							<lhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerBudgetType">
								<type>DefenceBudget</type>
							</lhs>
							<rhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
								<value>89</value>
							</rhs>
						</Item>
						<Item type="gameMechanics.constructor.schemes.item.ItemPredicateGreater">
							<lhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerBudgetType">
								<type>OffenceBudget</type>
							</lhs>
							<rhs type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
								<value>89</value>
							</rhs>
						</Item>
						<Item type="gameMechanics.elements.item.ItemPredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.item.ItemPredicateCategory">
									<category href="/Items/MetaItems/700+Sets/NonReforge.(ItemCategoryTerminal).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
								</Item>
								<Item type="gameMechanics.elements.item.ItemPredicateCategory">
									<category href="/Items/MetaItems/700+Sets/ReforgeIco.(ItemCategoryTerminal).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
								</Item>
							</predicates>
						</Item>
					</predicates>
				</Item>
			</predicates>
		</highlightPredicate>
		<usages>
            <Item>
                <useActions>
                    <Item type="itemService.avatar.itemBag.ChangeBudgetModTakeAction">
                        <delta>
                            <min>1</min>
                            <max>1</max>
                        </delta>
                        <trimResultBudgetMod>
                            <min>50</min>
                            <max>109</max>
                        </trimResultBudgetMod>
                        <budgetType>DefenceBudget</budgetType>
                    </Item>
                    <Item type="itemService.avatar.itemBag.ChangeBudgetModTakeAction">
                        <delta>
                            <min>1</min>
                            <max>1</max>
                        </delta>
                        <trimResultBudgetMod>
                            <min>50</min>
                            <max>109</max>
                        </trimResultBudgetMod>
                        <budgetType>OffenceBudget</budgetType>
                    </Item>
                </useActions>
                <consumeUsedItem>1</consumeUsedItem>
            </Item>
        </usages>
		<predicates>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </predicates>
        <triggersGlobalCooldown>false</triggersGlobalCooldown>
	</functionalPart>
	<image href="/Interface/Icons/Misc/Astral/Improver04.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
	<itemMallType>NOTITEMMALLABLE</itemMallType>
	<level>1</level>
	<lifeLengthCap>0</lifeLengthCap>
	<name href="UpgradeItemProto.(ItemResource).Name.txt" />
	<ownershipLimit>0</ownershipLimit>
