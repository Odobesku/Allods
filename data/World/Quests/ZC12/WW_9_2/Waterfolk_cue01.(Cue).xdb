<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>739948373</resourceId>
    </Header>
    <name href="Waterfolk_cue01.(Cue).Name.txt" />
    <text href="Waterfolk_cue01.(Cue).Text.txt" />
    <conditions>
        <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
            <quest href="WW_9_2.xdb" />
            <status>Started</status>
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateToInterlocutor">
            <predicates>
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="Cue01.(BuffResource).xdb" />
                    </Item>
                </predicates>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateBinaryWrapper">
            <master type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <slave type="gameMechanics.elements.addresseeFinders.AddresseeFinderInterlocutor" />
            <binary type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                    <buff href="Checked.(BuffResource).xdb" />
                </predicate>
            </binary>
        </Item>
    </conditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                        <quest href="WW_9_2.xdb" />
                        <counterResource href="Counter2.(QuestCountId).xdb" />
                    </predicate>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                    <id href="Counter2.(QuestCountId).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToInterlocutor">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Checked.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsIf>
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>