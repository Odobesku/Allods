<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>ready</Item>
                </animations>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Mobs/Saw_ChannelHeal.(VisObjectTemplate).xdb" />
                <startPoint type="VisPointLocator">
                    <locator>Slot_Mouth</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </endPoint>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectDisease.(VisObjectTemplate).xdb" />
                        <scale>1.5</scale>
                        <locator>Slot_Head</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <playOnTargets>
        <specialAction type="CreatureEffectsAction">
            <visualEffects>
                <Item>
                    <effectFx href="/Spells/FX/Spells/TrinketChannelShadow_Hit.(VisObjectTemplate).xdb" />
                </Item>
            </visualEffects>
        </specialAction>
    </playOnTargets>
</SpellVisScripts>