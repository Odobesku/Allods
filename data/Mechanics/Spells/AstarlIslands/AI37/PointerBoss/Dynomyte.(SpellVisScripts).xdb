<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect01Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialAttack</Item>
                </animations>
                <advanced>
                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                </advanced>
            </Item>
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Spells/StalkerBlindingPowder_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <explosionFx href="/Spells/FX/Mobs/Morok_AddSummonFX_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <theGe>9</theGe>
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_Hand_R</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_Global</locator>
                </pointOnTarget>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>