<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>243858</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceInSlot">
                        <slot>Slot_ManaReactor_01</slot>
                    </addresseeFinder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="SelfDestructOnAnimation.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceInSlot">
                        <slot>Slot_ManaReactor_01</slot>
                    </addresseeFinder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="SelfDestructOffAnimation.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>60000</duration>
    <isHelpful>true</isHelpful>
    <isClientReplicated>false</isClientReplicated>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>