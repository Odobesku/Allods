<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739895925</resourceId>
    </Header>
    <Name href="Flour.(BuffResource).Name.txt" />
    <Description href="Flour.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/FlourBag.(UISingleTexture).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.constructor.basicElements.HighStackEffect">
            <effect type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="AI26_Whirlwind/Whirlwind.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>30</radius>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="MillCharm/CharmBuff.(BuffResource).xdb" />
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                <buff href="MillCharm/CharmBuff.(BuffResource).xdb" />
                                            </Item>
                                        </impactsIf>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </predicates>
                                </filter>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="Flour.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="MillCharm/SupressAa.(BuffResource).xdb" />
                    </Item>
                </impactsOn>
            </effect>
            <stackCountTrigger>2</stackCountTrigger>
        </Item>
    </effects>
    <stackLimit>2</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>