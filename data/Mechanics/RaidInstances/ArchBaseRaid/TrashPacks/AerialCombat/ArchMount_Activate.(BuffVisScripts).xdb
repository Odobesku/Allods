<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureChangeVisItemsAction">
				<items>
					<Item>
						<slot>LIFESTYLEBACK</slot>
						<newItem href="/Items/VisualItems/Cloak/BackDummy.xdb" />
					</Item>
				</items>
			</Item>
			<Item type="CreatureMountVisAction">
				<visualMount href="/Client/VisualMounts/JetPack/JetPackEclipse.(VisualMount).xdb" />
			</Item>
		</elements>
	</action>
</BuffVisScripts>
