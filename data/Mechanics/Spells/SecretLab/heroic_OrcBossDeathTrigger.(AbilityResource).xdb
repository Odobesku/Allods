<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>108514312</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.HealthTrigger">
			<healthOn type="gameMechanics.constructor.basicElements.FloatZero" />
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.SpawnSingleMob">
					<mob>
						<scriptID>SL_Boss11SpawnPoint</scriptID>
						<map href="/Maps/Inst_SecretLab/heroic_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
					</mob>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>2000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
							<spawn>
								<scriptID>SL_Boss11SpawnPoint</scriptID>
								<map href="/Maps/Inst_SecretLab/heroic_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
							</spawn>
							<onBehalfOfTarget>true</onBehalfOfTarget>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
								<Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
