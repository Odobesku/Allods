<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<playWhile type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/MayEvent/FireworkMayBig.(VisObjectTemplate).xdb" />
				</Item>
			</visualEffects>
		</playWhile>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>emoteCongratulate</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
				<channelOverrideControllers>TOP_ONLY</channelOverrideControllers>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
