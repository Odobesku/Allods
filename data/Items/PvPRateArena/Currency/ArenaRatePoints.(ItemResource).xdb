<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>520375</resourceId>
    </Header>
    <image href="/Interface/Icons/Special/Currency/RedCurrency.(UISingleTexture).xdb" />
    <position>6</position>
    <boxParamsOverride>
        <level>40</level>
        <quality href="/Mechanics/ItemQualities/Common.xdb" />
    </boxParamsOverride>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.ItemTakeActions">
        <actions>
            <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                <currency href="/Mechanics/AlternativeCurrencies/ArenaRatePoints.(AlternativeCurrency).xdb" />
