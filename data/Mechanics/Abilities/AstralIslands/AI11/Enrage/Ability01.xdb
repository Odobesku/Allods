                                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                                                <locator>
                                                                    <scriptID>spell_marker_02</scriptID>
                                                                    <map href="/Maps/AstralIsle11/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                                                </locator>
                                                                <yaw type="constructor.basicElements.AngleRadians" />
                                                            </destination>
                                                        </moveType>
                                                        <resource href="/Mechanics/Spells/AstarlIslands/AI11/VoidZones/Projectile01.xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                                    </projectileData>
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                    <projectileData>
                                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                                                <locator>
                                                                    <scriptID>spell_marker_03</scriptID>
                                                                    <map href="/Maps/AstralIsle11/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                                                </locator>
                                                                <yaw type="constructor.basicElements.AngleRadians" />
                                                            </destination>
                                                        </moveType>
                                                        <resource href="/Mechanics/Spells/AstarlIslands/AI11/VoidZones/Projectile01.xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                                    </projectileData>
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                    <projectileData>
                                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                                                <locator>
                                                                    <scriptID>spell_marker_04</scriptID>
