<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_HITCRITICAL</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>200</delay>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectFireWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>2</scale>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>