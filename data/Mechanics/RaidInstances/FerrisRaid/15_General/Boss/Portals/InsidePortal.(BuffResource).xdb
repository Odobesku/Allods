<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222954</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Itemmall/PortalsDesc.(UISingleTexture).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/AvatarCounted.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                    <spawn>
                                        <scriptID>15_GeneralBoss</scriptID>
                                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                    </spawn>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/15_General/Boss/AvatarCounted.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.RelativeRotatePos">
                        <base type="gameMechanics.map.destination.DestinationLocator">
                            <locator>
                                <scriptID>FR_15</scriptID>
                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                            </locator>
                        </base>
                        <offset>6</offset>
                    </destination>
                    <finishImpacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="InsidePortal.(BuffResource).xdb" />
                        </Item>
                    </finishImpacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>