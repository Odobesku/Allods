                <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                    <spell href="PoisonedShot.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
