            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort" />
                <targetConditionChecks>
                    <Item>
                        <binaryPredicates>
                            <Item type="gameMechanics.elements.predicates.PredicateDistance">
                                <range min="10" max="60" />
                            </Item>
                        </binaryPredicates>
                    </Item>
                </targetConditionChecks>
            </targetSelector>
            <cooldowns>
                <min>8000</min>
                <max>8000</max>
            </cooldowns>
        </Item>
        <Item>
            <spell href="Captain_Cleave.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
        </Item>
    </spellEntries>
    <abilities>
