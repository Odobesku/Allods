                    <buff href="OneShotLifeGuard.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectIncreaseHealth">
            <bonusHealthPercent>10</bonusHealthPercent>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>