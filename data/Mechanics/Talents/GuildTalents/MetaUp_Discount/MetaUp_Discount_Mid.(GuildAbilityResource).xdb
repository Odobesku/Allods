                <Item href="/Mechanics/Crowd/Guild/Ranks/HonoraryMember.xdb" />
                <Item href="/Mechanics/Crowd/Guild/Ranks/Leader.xdb" />
                <Item href="/Mechanics/Crowd/Guild/Ranks/Officer.xdb" />
                <Item href="/Mechanics/Crowd/Guild/Ranks/OrdinaryMember.xdb" />
                <Item href="/Mechanics/Crowd/Guild/Ranks/Quartermaster.xdb" />
                <Item href="/Mechanics/Crowd/Guild/Ranks/Alt.xdb" />
                <Item href="/Mechanics/Crowd/Guild/Ranks/Veteran.xdb" />
