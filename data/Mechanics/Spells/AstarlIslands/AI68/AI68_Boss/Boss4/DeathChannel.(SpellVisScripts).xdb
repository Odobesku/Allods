<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
				<channel>CHANNEL_HITCRITICAL</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectAstral.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/World/AI68_Idol_Toad_Channel.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
