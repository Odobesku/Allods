<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Mobs/Red_Channel_01.(VisObjectTemplate).xdb" />
                <fxLength>20</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>Slot_Hand_R</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </endPoint>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/EngineerTurretSmall_FireHadagan_Glow.(VisObjectTemplate).xdb" />
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/GolemRed_Glow.(VisObjectTemplate).xdb" />
                        <scale>0.75</scale>
                        <locator>Slot_FX</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>