<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222174</resourceId>
    </Header>
    <Name href="ChainBuff2.(BuffResource).Name.txt" />
    <Description href="ChainBuff2.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/ChainViolet.(UISingleTexture).xdb" />
    <visScript href="/Spells/BuffVisScripts/DotLightniing.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
            <impactsIn>
                <impactsFromCaster>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="ChainDamageBuff_Player.(BuffResource).xdb" />
                    </Item>
                </impactsFromCaster>
            </impactsIn>
            <impactsOut>
                <impactsFromCaster>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="ChainDamageBuff_Player.(BuffResource).xdb" />
                    </Item>
                </impactsFromCaster>
            </impactsOut>
            <maxLength>80</maxLength>
            <reconnect>true</reconnect>
            <height>3</height>
            <width>1</width>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
        </Item>
        <Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
            <impactsIn>
                <impactsFromHolder>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard_noHM_Defence.(BuffResource).xdb" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.StackBuff">
                                <buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard_noHM_Defence.(BuffResource).xdb" />
                                <delta type="gameMechanics.elements.calcers.FloatData">
                                    <value>-1</value>
                                </delta>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                        <buff href="ChainBuff2.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="ChainDamageBuff_Robot.(BuffResource).xdb" />
                            </Item>
                        </impactsElse>
                    </Item>
                </impactsFromHolder>
            </impactsIn>
            <impactsOut>
                <impactsFromCaster>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="ChainDamageBuff_Robot.(BuffResource).xdb" />
                    </Item>
                </impactsFromCaster>
            </impactsOut>
            <maxLength>80</maxLength>
            <reconnect>true</reconnect>
            <height>3</height>
            <width>3</width>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/RoboGuard1.(MobWorld).xdb" />
                            <Item href="RoboGuard2.(MobWorld).xdb" />
                        </mobs>
                    </Item>
                </predicates>
            </filter>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
                    <phantom href="RoboGuard2.(MobWorld).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>LIGHTNING</element>
                            <damage>13</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="ChainRay.(ClientData).xdb" />
                    <calcers>
                        <addressEntries>
                            <Item>
                                <name>caster</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </Item>
                            <Item>
                                <name>target</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                            </Item>
                        </addressEntries>
                    </calcers>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ChainBuff2.(BuffResource).xdb" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ChainBuff.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>