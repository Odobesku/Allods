<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>CLAMP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
                <channel>CHANNEL_HITCRITICAL</channel>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="GolemAI20AOE_decal.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            </Item>
        </visualEffects>
    </wholeCasting>
    <precastType>PRECAST_DEFAULT</precastType>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_HITCRITICAL</channel>
            </Item>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <elements>
                    <Item type="CreatureRunActionOnSpellTargets">
                        <targetAction type="CreatureRunVisActionResource">
                            <resource href="/Spells/VisScripts/HitPostFxOnTarget/HitLightningShader.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
                        </targetAction>
                    </Item>
                    <Item type="ShakeAction">
                        <params href="/Spells/FX/InterfaceFX/CameraShake_LightningBig.(CameraShakeParameters).xdb#xpointer(/CameraShakeParameters)" />
                    </Item>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Mobs/MazeGolemPower_Discharge.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <fixPoint>true</fixPoint>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Special20</locatorName>
                            </Item>
                            <Item>
                                <effectFx href="/Spells/FX/Mobs/MazeGolemPower_Discharge.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <fixPoint>true</fixPoint>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Special21</locatorName>
                                <offendTime type="EffectOffendConstDelay" />
                            </Item>
                            <Item>
                                <effectFx href="/Spells/FX/Mobs/MazeGolemPower_Discharge.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <fixPoint>true</fixPoint>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Special22</locatorName>
                                <offendTime type="EffectOffendConstDelay" />
                            </Item>
                            <Item>
                                <effectFx href="/Spells/FX/Mobs/MazeGolemPower_Discharge.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <fixPoint>true</fixPoint>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Special23</locatorName>
                                <offendTime type="EffectOffendConstDelay" />
                            </Item>
                            <Item>
                                <effectFx href="/Spells/FX/Mobs/MazeGolemPower_Discharge.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <fixPoint>true</fixPoint>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Special24</locatorName>
                                <offendTime type="EffectOffendConstDelay" />
                            </Item>
                            <Item>
                                <effectFx href="/Spells/FX/Mobs/MazeGolemPower_Discharge.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <fixPoint>true</fixPoint>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Special25</locatorName>
                                <offendTime type="EffectOffendConstDelay" />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
    <playOnTargets>
        <specialAction type="CreatureEffectsOnTarget">
            <visualEffects>
                <Item>
                    <effectFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                </Item>
            </visualEffects>
        </specialAction>
    </playOnTargets>
</SpellVisScripts>