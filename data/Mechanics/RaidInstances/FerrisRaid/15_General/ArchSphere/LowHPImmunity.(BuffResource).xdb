<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739913387</resourceId>
	</Header>
	<Name href="LowHPImmunity.(BuffResource).Name.txt" />
	<Description href="LowHPImmunity.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Event/ShieldCarrier.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
			</predicates>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>15_GeneralBoss</scriptID>
						<map href="/Maps/FerrisRaid/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="SpheresDownCount.(BuffResource).xdb" />
							<impactsOnAttach>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="MovingIgnore.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
							</impactsOnAttach>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.Enlarge">
			<factor>0.8</factor>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="/Mechanics/RaidInstances/FerrisRaid/15_General/DefeatedAddPlane.(Plane).xdb" />
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
