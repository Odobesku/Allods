	<visScript href="RD_Humanoid_Boss2_FirePuddle.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="RD_Humanoid_Boss2_IceDebuff.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.StackBuff">
							<buff href="RD_Humanoid_Boss2_IceDebuff.(BuffResource).xdb" />
