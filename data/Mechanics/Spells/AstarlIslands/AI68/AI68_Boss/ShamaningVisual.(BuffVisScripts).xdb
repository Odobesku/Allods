<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionLoopAction">
        <actionToLoop type="CreatureAnimationAction">
            <use>USE_RANDOM_FROM_LIST</use>
            <animations>
                <Item>readySpell</Item>
                <Item>attack01</Item>
                <Item>idle01</Item>
                <Item>idle02</Item>
                <Item>special</Item>
                <Item>spellCastOmni</Item>
            </animations>
            <channel>CHANNEL_KNOCKDOWN</channel>
            <advanced>
                <denyAutoHasten>true</denyAutoHasten>
            </advanced>
        </actionToLoop>
    </action>
</BuffVisScripts>