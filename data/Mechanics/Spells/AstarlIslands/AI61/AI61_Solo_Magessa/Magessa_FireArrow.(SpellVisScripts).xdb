<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/Projectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationDirectWand.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</PreCastAnimation>
            <FXProjectile>/Spells/FX/Spells/MageFireArrowAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
            <LocatorNameOnTargets />
            <FXOnTargets />
            <CastAnimation>specialCast</CastAnimation>
            <FixPointTarget>true</FixPointTarget>
            <LocatorNameOnCaster />
            <FXOnCaster />
            <LocatorOnTargets>Slot_FX</LocatorOnTargets>
            <FXProjectileHit>/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
            <ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
            <PreCastFX />
            <FixPointCaster>false</FixPointCaster>
            <FXWand />
            <FXPocket />
            <Ge>0</Ge>
            <HitPostFXOnTargets>/Spells/VisScripts/HitPostFxOnTarget/HitFireShader.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)</HitPostFXOnTargets>
            <MulyProjectile>false</MulyProjectile>
            <LocatorOnCaster>Slot_Mouth</LocatorOnCaster>
        </Variables>
    </Header>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>ready</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_Mouth</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
</SpellVisScripts>