<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739963985</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Buffs/ChainGreen.(UISingleTexture).xdb" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="PullDisable.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/RaidInstances/DisableEscapes.(BuffResource).xdb" />
					<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>4</multiplier>
					</durationScaler>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
							<time>500</time>
							<destination type="gameMechanics.map.destination.RelativeRotatePos">
								<base type="gameMechanics.map.destination.SelfPosDestination" />
								<offset>3</offset>
								<yaw type="constructor.basicElements.AngleDegrees" />
							</destination>
							<keepOnGround>false</keepOnGround>
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
