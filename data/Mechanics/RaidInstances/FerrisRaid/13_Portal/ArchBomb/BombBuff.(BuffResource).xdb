<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739910900</resourceId>
	</Header>
	<Name href="BombBuff.(BuffResource).Name.txt" />
	<image href="/Interface/Icons/Equipment/Ships/AstralComponentTL2/Offhand_Orb_D_03Purple.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Mobs/PortalBoss_Aura.(VisObjectTemplate).xdb" />
			<locator>FROM_LOCATOR_NAME</locator>
			<locatorName>VisualSceneNode</locatorName>
		</Item>
	</visualEffects>
	<visScript href="BombBuff.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
			</predicates>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>20</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.DirectDamage">
							<damage>1</damage>
							<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
							</scalerTarget>
						</Item>
					</impacts>
					<finishImpacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</finishImpacts>
					<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
						</predicates>
					</filter>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>9500</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch" />
				<Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
				<Item type="gameMechanics.elements.effects.ImmunityToAllActions" />
				<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
					<predicates>
						<Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
					</predicates>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactDevicesAround">
							<impacts>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impacts>
							<device href="Decale.(SteleResource).xdb" />
							<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
							<radius>20</radius>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<duration>10000</duration>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
