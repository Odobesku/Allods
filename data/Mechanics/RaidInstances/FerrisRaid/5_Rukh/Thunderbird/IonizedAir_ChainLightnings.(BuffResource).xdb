<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221383</resourceId>
    </Header>
    <image href="/Interface/Icons/Equipment/Ships/LightGun.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>5_Rukh</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                            <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                                <range min="0" max="1" />
                                                <withinRange>false</withinRange>
                                                <minCandidatesCount>1</minCandidatesCount>
                                                <targetCount>1</targetCount>
                                            </selector>
                                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                                <filters>
                                                    <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                        <predicates>
                                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                                <buff href="IonizedAir.(BuffResource).xdb" />
                                                            </Item>
                                                        </predicates>
                                                    </Item>
                                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                                </filters>
                                            </filter>
                                            <impacts>
                                                <Item>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="ChainLightning.(BuffResource).xdb" />
                                                                    <stacks type="gameMechanics.elements.calcers.FloatData">
                                                                        <value>5</value>
                                                                    </stacks>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                            <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                                <range min="0" max="1" />
                                                <withinRange>false</withinRange>
                                                <minCandidatesCount>1</minCandidatesCount>
                                                <targetCount>1</targetCount>
                                            </selector>
                                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                                <filters>
                                                    <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                        <predicates>
                                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                                <buff href="IonizedAir.(BuffResource).xdb" />
                                                            </Item>
                                                        </predicates>
                                                    </Item>
                                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                                </filters>
                                            </filter>
                                            <impacts>
                                                <Item>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="ChainLightning1.(BuffResource).xdb" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>4000</tick>
            <initialDelay>7000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="IonizedAir.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="IonizedAir_ChainLightnings.(BuffResource).xdb" />
                </Item>
