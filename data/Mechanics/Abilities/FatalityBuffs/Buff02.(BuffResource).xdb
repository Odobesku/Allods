<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739830407</resourceId>
    </Header>
    <Name href="Buff02.txt" />
    <Description href="Buff02.Description.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/IMFatalityLotteryEnergy.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.PureHeal">
                            <heal>1</heal>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                            <buff href="Buff02.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.calcers.LinearCalcer">
                                            <mul>0.01</mul>
                                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthBSVCalcer">
                                                <level type="gameMechanics.elements.calcers.CalcerLevel" />
                                            </mulCalcer>
                                            <sum>0</sum>
                                        </Item>
                                    </calcers>
                                </mulCalcer>
                                <additionalMultiplier>
                                    <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
                                </additionalMultiplier>
                            </scalerTarget>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff02.(BuffResource).xdb" />
                </Item>
            </onLeave>
            <effects />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                </Item>
                            </predicates>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.PureHeal">
                                            <heal>1</heal>
                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
                                                    <calcers>
                                                        <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                                            <buff href="Buff02.(BuffResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.calcers.LinearCalcer">
                                                            <mul>0.01</mul>
                                                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthBSVCalcer">
                                                                <level type="gameMechanics.elements.calcers.CalcerLevel" />
                                                            </mulCalcer>
                                                            <sum>0</sum>
                                                        </Item>
                                                    </calcers>
                                                </mulCalcer>
                                                <additionalMultiplier>
                                                    <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
                                                </additionalMultiplier>
                                            </scalerTarget>
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Buff02.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <stackLimit>10</stackLimit>
    <isHelpful>true</isHelpful>
    <decayPolicy>OfflineDecay</decayPolicy>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
        <Item href="/Mechanics/Spells/Groups/Undispelable.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>