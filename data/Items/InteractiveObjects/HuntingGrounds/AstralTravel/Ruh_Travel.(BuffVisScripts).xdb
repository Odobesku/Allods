<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>500</time>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureMountVisAction">
						<visualMount href="/Client/VisualMounts/Ruh/Ruh.(VisualMount).xdb#xpointer(/VisualMount)" />
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
