<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/PsionicTelekineticTrustAbility.(VisObjectTemplate).xdb" />
                                <scale>1.5</scale>
                            </Item>
                        </visualEffects>
                    </Item>
                    <Item type="VisActionDelay">
                        <time>1500</time>
                    </Item>
                </elements>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
            </Item>
        </elements>
    </actionBarStart>
</SpellVisScripts>