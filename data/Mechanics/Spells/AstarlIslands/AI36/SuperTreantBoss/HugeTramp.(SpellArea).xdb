<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739866787</resourceId>
    </Header>
    <Name href="HugeTramp.(SpellArea).Name.txt" />
    <visualScripts href="TrampVis.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="HugeTramp.(SpellArea).Name.txt" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <prepareDuration>3500</prepareDuration>
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <needLos>false</needLos>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>200000000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Roots.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>PHYSICAL</element>
                <threatMultiplier>0</threatMultiplier>
                <damage>20</damage>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                        <time>1000</time>
                        <impactsOnLand>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Roots.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impactsOnLand>
                        <distance>5</distance>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>PHYSICAL</element>
                        <damage>30</damage>
                    </Item>
                </impactsElse>
            </Item>
        </targetImpacts>
    </mechanics>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>