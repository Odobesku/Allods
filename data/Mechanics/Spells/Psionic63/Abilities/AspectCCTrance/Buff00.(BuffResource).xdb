<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739925328</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Buff00.(BuffResource).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestZeal.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Psionic/AspectCCTrance.(BuffVisScripts).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                    <group href="/Mechanics/Spells/Groups/Suggestions.(ActionGroup).xdb" />
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalableCooldownMultiplier">
                            <factor type="gameMechanics.elements.calcers.FloatData">
                                <value var="factor" />
                            </factor>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectGroupCooldownMultiplier">
            <group href="/Mechanics/Spells/Groups/Suggestions.(ActionGroup).xdb" />
            <factor type="gameMechanics.elements.calcers.FloatData">
                <value var="factor" />
            </factor>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Proxy.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>