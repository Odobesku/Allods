<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739885811</resourceId>
    </Header>
    <visualScripts href="SummonWolfs.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>85</value>
    </range>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>60000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                        <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                            <range min="0" max="1" />
                            <withinRange>false</withinRange>
                            <minCandidatesCount>1</minCandidatesCount>
                            <targetCount>1</targetCount>
                        </selector>
                        <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                            <filters>
                                <Item type="gameMechanics.world.creature.AvatarFilter" />
                                <Item type="gameMechanics.world.creature.AliveFilter" />
                                <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/RaidInstances/Tank.(BuffResource).xdb" />
                                            </predicate>
                                        </Item>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/BattleRoar/Stun.(BuffResource).xdb" />
                                            </predicate>
                                        </Item>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/SpearStrike/Bleeding_HM.(BuffResource).xdb" />
                                            </predicate>
                                        </Item>
                                    </predicates>
                                </Item>
                            </filters>
                        </filter>
                        <impacts>
                            <Item>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <calcDestinationOnTarget>false</calcDestinationOnTarget>
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="/Mechanics/RaidInstances/UmoirRaid/Disabler.(BuffResource).xdb" />
                                            </Item>
                                        </impacts>
                                        <impactsFromTarget>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="GhostWolf_Taunt.(BuffResource).xdb" />
                                            </Item>
                                        </impactsFromTarget>
                                        <traceDown>true</traceDown>
                                        <object href="GhostWolf.(MobWorld).xdb" />
                                        <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                        <impact type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                        <verticalRange min="1" max="1" />
                                        <horizontalRange min="3" max="6" />
                                    </Item>
                                </modifiers>
                            </destination>
                            <traceDown>true</traceDown>
                            <object href="SnowWolf.(MobWorld).xdb" />
                            <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                        </impact>
                        <count type="gameMechanics.elements.calcers.FloatData">
                            <value>2</value>
                        </count>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>