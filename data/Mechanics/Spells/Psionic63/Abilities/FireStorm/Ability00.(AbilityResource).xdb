<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739925029</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability00.(AbilityResource).Name.txt" />
	<description href="Ability00.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value var="value" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Misc/Buffs/BuffURShadowFire2.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.SpellExtraImpacts">
			<targetImpacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
								<spell href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisable.(SpellSingleTarget).xdb" />
							</predicate>
						</Item>
					</predicates>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsIf">
							<predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
								<buff href="/Mechanics/Spells/Psionic63/Spells/BladeStorm/Buff01.(BuffResource).xdb" />
								<from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
							</predicate>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ScaledImpacts">
									<scalerCaster type="gameMechanics.elements.scalers.ScalerIf">
										<condition type="gameMechanics.elements.predicates.PredicateHasSpell">
											<spell href="/Mechanics/Spells/Psionic63/Spells/PsychicBurn/Spell01.(SpellSingleTarget).xdb" />
											<anyRank>false</anyRank>
										</condition>
										<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
											<mulCalcer type="constructor.elements.CalcerFloatExternal">
												<externalCalcer href="/Mechanics/Spells/Psionic63/Spells/PsychicBurn/CalcerDamage01.(CalcerFloatResource).xdb" />
											</mulCalcer>
										</scalerIf>
										<scalerElse type="gameMechanics.elements.scalers.ScalerIf">
											<condition type="gameMechanics.elements.predicates.PredicateHasSpell">
												<spell href="/Mechanics/Spells/Psionic63/Spells/PsychicBurn/Spell02.(SpellSingleTarget).xdb" />
												<anyRank>false</anyRank>
											</condition>
											<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="constructor.elements.CalcerFloatExternal">
													<externalCalcer href="/Mechanics/Spells/Psionic63/Spells/PsychicBurn/CalcerDamage02.(CalcerFloatResource).xdb" />
												</mulCalcer>
											</scalerIf>
											<scalerElse type="gameMechanics.elements.scalers.ScalerIf">
												<condition type="gameMechanics.elements.predicates.PredicateHasSpell">
													<spell href="/Mechanics/Spells/Psionic63/Spells/PsychicBurn/Spell03.(SpellSingleTarget).xdb" />
													<anyRank>false</anyRank>
												</condition>
												<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
													<mulCalcer type="constructor.elements.CalcerFloatExternal">
														<externalCalcer href="/Mechanics/Spells/Psionic63/Spells/PsychicBurn/CalcerDamage03.(CalcerFloatResource).xdb" />
													</mulCalcer>
												</scalerIf>
												<scalerElse type="gameMechanics.elements.scalers.LinearScaler">
													<multiplier>0</multiplier>
												</scalerElse>
											</scalerElse>
										</scalerElse>
									</scalerCaster>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
											<radius>15</radius>
											<affectGroup>Enemies</affectGroup>
											<affectHolder>false</affectHolder>
											<impacts>
												<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
													<impacts>
														<Item type="gameMechanics.elements.impacts.ImpactsUnderEnvelope">
															<spell href="/Mechanics/Spells/Psionic63/Spells/PsychicBurn/Spell01.(SpellSingleTarget).xdb" />
															<impacts>
																<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
																	<element>ASTRAL</element>
																	<forceAE>true</forceAE>
																	<damage>1</damage>
																	<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
																		<scalers>
																			<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
																				<mul>0.01</mul>
																				<mulCalcer type="gameMechanics.elements.calcers.FloatData">
																					<value var="value" />
																				</mulCalcer>
																			</Item>
																			<Item type="gameMechanics.elements.scalers.MagicScaler" />
																		</scalers>
																	</scaler>
																</Item>
															</impacts>
														</Item>
													</impacts>
													<groupRepeaters>true</groupRepeaters>
												</Item>
											</impacts>
											<filter type="gameMechanics.world.creature.AliveFilter" />
										</Item>
									</impacts>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</targetImpacts>
			<destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
				<spells>
					<Item href="/Mechanics/Spells/Psionic63/Spells/PsychicBurn/Spell01.(SpellSingleTarget).xdb" />
				</spells>
			</destination>
		</Item>
		<Item type="gameMechanics.elements.effects.AbilityUnlockerEffect">
			<abilities>
				<Item href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisableAbility.(AbilityResource).xdb" />
			</abilities>
		</Item>
	</effects>
	<ranks>
