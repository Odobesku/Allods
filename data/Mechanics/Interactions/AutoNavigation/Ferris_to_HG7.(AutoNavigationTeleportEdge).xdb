<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.interactions.autonavigation.AutoNavigationTeleportEdge>
    <Header>
        <resourceId>257392</resourceId>
    </Header>
    <from>
        <scriptID>Ferris03_MainLift</scriptID>
        <map href="/Maps/Ferris_indoor/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
    </from>
    <to>
        <scriptID>HG7_Enter</scriptID>
        <map href="/Maps/HuntingGround7/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
    </to>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
            <destination type="gameMechanics.map.destination.DestinationLocator">
                <locator>
                    <scriptID>HG7_Enter</scriptID>
                    <map href="/Maps/HuntingGround7/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                </locator>
            </destination>
            <finishImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                                <unlock href="/Mechanics/Unlocks/Locations/HuntingGround7/HG7_Portal.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                            <unlock href="/Mechanics/Unlocks/Locations/HuntingGround7/HG7_Portal.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                                <unlock href="/Mechanics/Unlocks/Locations/HuntingGround7/HG7_PortalQuest.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                            <unlock href="/Mechanics/Unlocks/Locations/HuntingGround7/HG7_PortalQuest.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </finishImpacts>
        </Item>
    </impacts>
    <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
        <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
    </predicate>
</gameMechanics.interactions.autonavigation.AutoNavigationTeleportEdge>