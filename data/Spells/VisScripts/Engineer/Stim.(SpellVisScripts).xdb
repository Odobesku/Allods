<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirectedEngineer</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<advanced>
					<offendType>EVERYKEY_ALLOFFENDS</offendType>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Engineer_Defibrillation_Ready.(VisObjectTemplate).xdb" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<visActionID>0</visActionID>
		<play>Simultaneously</play>
		<playWhile />
		<preconditional>true</preconditional>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastDirectedEngineer</Item>
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
							<offendType>EVERYKEY_ALLOFFENDS</offendType>
						</advanced>
					</Item>
					<Item type="CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Spells/Engineer_Defibrillation_Channel.(VisObjectTemplate).xdb" />
						<fxLength>5</fxLength>
						<startPoint type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</startPoint>
						<endPoint type="VisPointLocator" />
						<secondaryTargetParams />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction />
	</playOnTargets>
</SpellVisScripts>
