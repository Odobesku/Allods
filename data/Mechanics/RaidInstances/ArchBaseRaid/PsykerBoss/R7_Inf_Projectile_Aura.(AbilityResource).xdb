<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>224525</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>60000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>65</level>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <tick>1000</tick>
            <affectGroup>All</affectGroup>
            <radius>10</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Phys_Plane.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/ArchBaseRaid/Other/R7_3thBoss_Normal.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Arena_Blue_Attack.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Arena_Blue.(BuffResource).xdb" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.StackBuff">
                    <buff href="Arena_Blue_Attack.(BuffResource).xdb" />
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>-1</value>
                    </delta>
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <tick>1000</tick>
            <affectGroup>All</affectGroup>
            <radius>10</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Phys_Plane.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/ArchBaseRaid/Other/R7_3thBoss_HM.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Arena_Blue_Defend.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Arena_Blue.(BuffResource).xdb" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.StackBuff">
                    <buff href="Arena_Blue_Defend.(BuffResource).xdb" />
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>-1</value>
                    </delta>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="Arena_Blue_Defend.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Arena_Blue.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOut>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>