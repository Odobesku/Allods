<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.QuestResource>
    <Header>
        <resourceId>278364177</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Quest_Name.txt" />
    <goal href="AddonQuest_GoalText.txt" />
    <startText href="AddonQuest_StartText.txt" />
    <checkText href="Quest_CheckText.txt" />
    <finishText href="AddonQuest_FinishText.txt" />
    <finisher type="gameMechanics.elements.quest.QuestFinisherMob">
        <mobWorld hrefvar="questTaker" />
    </finisher>
    <rewardImpacts>
        <Item type="gameMechanics.world.ship.elements.ImpactAddShipInUpgrade">
            <constructionTime var="time" />
            <modification type="gameMechanics.world.ship.elements.ImpactAddShipInUpgrade$ShipModificationResource">
                <shipResource hrefvar="ship" />
            </modification>
        </Item>
    </rewardImpacts>
    <startConditions>
        <Item type="gameMechanics.elements.predicates.PredicateGreater">
            <lhs type="gameMechanics.elements.calcers.AstralUnlockCalcer" />
            <rhs type="gameMechanics.elements.calcers.FloatData">
                <value var="value" />
            </rhs>
        </Item>
        <Item type="gameMechanics.world.ship.elements.PredicateHasUpgradableShip">
            <newShipResource hrefvar="ship" />
        </Item>
    </startConditions>
    <counters>
        <Item type="gameMechanics.elements.quest.QuestCountAltCurrency">
            <limit>5</limit>
            <currency hrefvar="ac" />
        </Item>
        <Item type="gameMechanics.elements.quest.QuestCountItem">
            <autoRelatedItems>
                <Item href="" />
            </autoRelatedItems>
            <limit>15</limit>
            <items>
                <Item hrefvar="parts" />
            </items>
            <removeOnAbandon>false</removeOnAbandon>
        </Item>
        <Item type="gameMechanics.elements.quest.QuestCountUpgradableShip">
            <customName href="Upgrade.txt" />
            <limit>1</limit>
            <newShipResource hrefvar="ship" />
        </Item>
    </counters>
    <sharing>
        <onRequest>false</onRequest>
    </sharing>
    <repeatPolicy type="gameMechanics.constructor.schemes.quest.RepeatPolicyNone" />
    <zone href="/Maps/AstralHangar/Zones/AstralHangar/AstralHangar.xdb" />
    <canBeSkipped>false</canBeSkipped>
    <requiredLevel type="gameMechanics.formulas.IntConstantValue">
        <value var="qlevel" />
    </requiredLevel>
    <level type="gameMechanics.formulas.IntConstantValue">
        <value var="qlevel" />
    </level>
</gameMechanics.constructor.schemes.quest.QuestResource>