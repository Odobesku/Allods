<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739932074</resourceId>
	</Header>
	<Name href="/Mechanics/Spells/Rifts/RiftRandomSpells/RD_DoT_Architector.(BuffResource).Name.txt" />
	<Description href="/Mechanics/Spells/Rifts/RiftRandomSpells/RD_DoT_Architector.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Event/SparkStaticDot.(UISingleTexture).xdb" />
	<visScript href="/Spells/BuffVisScripts/DotLightniing.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.MagicDoT">
			<parameters>
				<damagePerTick>1</damagePerTick>
			</parameters>
			<element>LIGHTNING</element>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.MagicScaler" />
					<Item type="gameMechanics.elements.scalers.ScalerIf">
						<condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
							<quality href="/Mechanics/MobQualities/Elite.xdb" />
						</condition>
						<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
							<mulCalcer type="constructor.elements.CalcerFloatExternal">
								<externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/DoTCommon.(CalcerFloatResource).xdb" />
							</mulCalcer>
						</scalerIf>
						<scalerElse type="gameMechanics.elements.scalers.ScalerIf">
							<condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
								<quality href="/Mechanics/MobQualities/Boss.xdb" />
							</condition>
							<scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="constructor.elements.CalcerFloatExternal">
									<externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/DoTElite.(CalcerFloatResource).xdb" />
								</mulCalcer>
							</scalerIf>
							<scalerElse type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="constructor.elements.CalcerFloatExternal">
									<externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/DoTBoss.(CalcerFloatResource).xdb" />
								</mulCalcer>
							</scalerElse>
						</scalerElse>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</effects>
	<duration>10000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>