	<soundParameters>
		<Item>
			<alias>Credits</alias>
			<music>
				<music>
					<project href="/SFX/Music/Music.(FMODProject).xdb" />
					<name>Music/MainMenuMusic/Credits</name>
				</music>
			</music>
			<ambience>
				<reverbPreset>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb" />
					<name>city</name>
				</reverbPreset>
			</ambience>
			<useCameraTransformForListener>true</useCameraTransformForListener>
		</Item>
		<Item>
			<alias>FactionSelect</alias>
			<music>
				<music>
					<project href="/SFX/Music/Music.(FMODProject).xdb" />
					<name>Music/MainMenuMusic/MainTitle</name>
				</music>
				<params>
					<Item>
						<parameter href="MusicParameters/Screen.(SoundParameter).xdb" />
						<value>1</value>
					</Item>
				</params>
			</music>
			<ambience>
				<reverbPreset>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb" />
					<name>hall</name>
				</reverbPreset>
				<sounds>
					<Item>
						<ambience>
							<project href="/SFX/Ambience/Ambience.(FMODProject).xdb" />
							<name>Ambience/OutdoorAmbience/MainMenu/LoginScreen</name>
						</ambience>
						<percent>100</percent>
					</Item>
				</sounds>
			</ambience>
			<useCameraTransformForListener>true</useCameraTransformForListener>
			<globalParameters>
				<Item>
					<parameter href="MusicParameters/ShipMute.(SoundParameter).xdb" />
					<value>0</value>
				</Item>
			</globalParameters>
