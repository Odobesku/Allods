				<alternativeStartPoint />
				<endPoint type="VisPointLocator">
					<shift x="30" y="-100" z="0" />
					<locator>Slot_Global</locator>
				</endPoint>
				<alternativeEndPoint />
				<offendTime />
				<secondaryTargetParams>
					<channelingFx href="" />
					<offendTime />
				</secondaryTargetParams>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
