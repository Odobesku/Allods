<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Druid70_ThunderLightning.(VisObjectTemplate).xdb" />
						<locator>Slot_Global</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/Hit_MageLightningBalls.(VisObjectTemplate).xdb" />
						<scale>1</scale>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Spells/InsuranceTrigger_Projectile.(VisObjectTemplate).xdb" />
						<fxLength>15</fxLength>
						<startPoint type="VisPointLocator">
							<locator>Slot_FX</locator>
						</startPoint>
						<endPoint type="VisPointLocator">
							<locator>Slot_FX</locator>
						</endPoint>
						<velocity>0</velocity>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>300</delay>
						<effectFx href="/Spells/FX/Mobs/KillPackToHeal.(VisObjectTemplate).xdb" />
						<fadeInTime>200</fadeInTime>
						<fadeOutTime>200</fadeOutTime>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
