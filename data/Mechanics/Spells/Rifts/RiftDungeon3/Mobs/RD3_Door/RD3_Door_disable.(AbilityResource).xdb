<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>208138</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatStamina" />
            <multiplier>1.6</multiplier>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>All</affectGroup>
            <radius>60</radius>
            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                <filters>
                    <Item type="gameMechanics.world.creature.MobFilter" />
                    <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                <faction href="/World/Factions/Wild.xdb" />
                            </Item>
                        </predicates>
                    </Item>
                </filters>
            </filter>
            <onBehalfOfHolder>true</onBehalfOfHolder>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                    <value>100</value>
                </Item>
            </impactsIn>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>