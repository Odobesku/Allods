                        </Item>
                    </predicates>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeTargetModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.PersonalKillTrigger">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                    <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                        <value var="value" />
