<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739900189</resourceId>
	</Header>
	<Name href="Gong.(SpellSingleTarget).Name.txt" />
	<Description href="Gong.(SpellSingleTarget).Description.txt" />
	<image href="/Interface/Icons/Misc/Quest/ZC6_science_device.(UISingleTexture).xdb" />
	<isExploit>true</isExploit>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>5</value>
	</range>
	<needLos>false</needLos>
	<isAggro>false</isAggro>
	<replaceLowRanks>false</replaceLowRanks>
	<iffPolicy>Everyone</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>5000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
			</Item>
		</casterConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
										<mobs>
											<Item href="WormGlacialBoss/WormGlacialBoss.(MobWorld).xdb" />
										</mobs>
									</Item>
								</predicates>
								<impactsIf>
									<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
										<impacts>
											<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
												<predicates>
													<Item type="gameMechanics.constructor.basicElements.PredicateNot">
														<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
													</Item>
												</predicates>
												<impactsIf>
													<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
														<buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
													</Item>
													<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
														<table href="Engineers.(SpawnTable).xdb" />
													</Item>
													<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
														<impacts>
															<Item type="gameMechanics.elements.impacts.Disintegrate" />
															<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
																<impacts>
																	<Item type="gameMechanics.elements.impacts.ImpactStopSpawn">
																		<table href="RepairParts.(SpawnTable).xdb" />
																	</Item>
																</impacts>
															</Item>
														</impacts>
														<spawnResource href="RepairParts.(SpawnTable).xdb" />
													</Item>
													<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
														<impacts>
															<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
																<predicates>
																	<Item type="gameMechanics.elements.predicates.PredicateHasAbility">
																		<ability href="HealthIndicator/IndicatorAbility.(AbilityResource).xdb" />
																	</Item>
																</predicates>
																<impactsIf>
																	<Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
																		<ability href="HealthIndicator/IndicatorAbility.(AbilityResource).xdb" />
																	</Item>
																	<Item type="gameMechanics.elements.impacts.BuffDetacher">
																		<buff href="HealthIndicator/HPAbove075.(BuffResource).xdb" />
																	</Item>
																</impactsIf>
															</Item>
														</impacts>
														<spawnResource href="Turrets.(SpawnTable).xdb" />
													</Item>
												</impactsIf>
											</Item>
										</impacts>
									</Item>
								</impactsIf>
							</Item>
						</impacts>
						<spawnResource href="WormBoss.(SpawnTable).xdb" />
					</Item>
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
