<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739893923</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="Zimina_Ferris_2_2_ass_plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIsolator">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsToMaster">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
									<quest href="Ferris_2_2.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Aura">
			<radius>20</radius>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Zimina_Ferris_2_2_ass_visibility.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>1000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
									<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
										<value>0.5</value>
									</chanceCalcer>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ForceAggro" />
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsIn>
			<impactsOut>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Zimina_Ferris_2_2_ass_visibility.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOut>
			<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
						<mobs>
							<Item href="/Creatures/MechMelee/Instances/Ferris/MechMelee_Ferris_2_2.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
							<Item href="/Creatures/MechGunslinger/Instances/Ferris/MechGunslinger_Ferris_2_2.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
						</mobs>
					</Item>
				</predicates>
			</filter>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
