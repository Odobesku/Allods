<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739911153</resourceId>
    </Header>
    <Name href="UndMelee2_ReadyExecution.(BuffResource).Name.txt" />
    <Description href="UndMelee2_ReadyExecution.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Axe/AxeButcher.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="UndMelee2_ReadyExecution.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>6</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                            <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                            <minDamage>120</minDamage>
                            <maxDamage>120</maxDamage>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>3000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>