<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="CreatureChangeVisItemsAction">
		<removeAllItems>true</removeAllItems>
		<leaveWeapons>true</leaveWeapons>
		<items>
			<Item>
				<slot>BAG</slot>
				<newItem href="/Items/VisualItems/Cloak/Bag_Plate_E_46ExoskeletonBaseGreen.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
			</Item>
			<Item>
				<slot>HELM</slot>
				<newItem href="/Items/VisualItems/Helm/Helm_Plate_E_46ExoskeletonBaseGreen.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
			</Item>
			<Item>
				<slot>SHIRT</slot>
				<newItem href="/Items/VisualItems/Shirt/Plate_E_46ExoskeletonBaseShirt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
			</Item>
			<Item>
				<slot>MANTLE</slot>
				<newItem href="/Items/VisualItems/Mantle/Shoulder_Plate_E_46ExoskeletonBaseGreen.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
			</Item>
		</items>
		<notForDolls>true</notForDolls>
	</action>
</BuffVisScripts>
