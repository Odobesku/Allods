<?xml version="1.0" encoding="UTF-8" ?>
<WidgetTextView>
    <Name>CurrentPage</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>70</HighPos>
            <Size>100</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>22</HighPos>
            <Size>30</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>20</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing></reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>false</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>true</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <DefaultTag></DefaultTag>
    <FormatFileRef href="/Interface/Ingame/ContextVendorTrade/CurrentPage.txt"/>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>false</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextValues>
        <Item>
            <Tag>current_page</Tag>
            <TagValueFileRef href="/Interface/Ingame/ContextVendorTrade/CurrentPageValue.txt"/>
        </Item>
        <Item>
            <Tag>total_page</Tag>
            <TagValueFileRef href="/Interface/Ingame/ContextVendorTrade/TotalPageValue.txt"/>
        </Item>
    </TextValues>
    <isHtmlEscaping>false</isHtmlEscaping>
    <pickObjectsOnly>false</pickObjectsOnly>
</WidgetTextView>
