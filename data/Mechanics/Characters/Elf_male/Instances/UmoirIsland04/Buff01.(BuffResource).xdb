    <image href="/Interface/Icons/Spells/Mage/MageGlazedFrost.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                        <multiplier>0.2</multiplier>
                    </mulCalcer>
                </scalerTarget>
                <tickLength>1000</tickLength>
                <damagePerTick>1</damagePerTick>
            </parameters>
            <element>COLD</element>
            <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <ignoreLevelDelta>true</ignoreLevelDelta>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
