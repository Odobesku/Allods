<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739932218</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="DroneMine.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/World/Empty.(VisObjectTemplate).xdb" />
    <altitude>0.05</altitude>
    <lifeLengthCap>20000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <tick>1000</tick>
            <affectGroup>Enemies</affectGroup>
            <radius var="radius" />
            <filter type="gameMechanics.world.creature.AliveFilter" />
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                    <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </durationScaler>
                </Item>
            </impactsIn>
            <holderImpactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                        <resource hrefvar="resource" />
                    </projectileData>
                </Item>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="DroneVisual.(SummonPool).xdb" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                    <mark href="/Mechanics/Spells/Engineer63/Abilities/SupportDronePull/DroneExploded.(MarkResource).xdb" />
                </Item>
            </holderImpactsIn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>