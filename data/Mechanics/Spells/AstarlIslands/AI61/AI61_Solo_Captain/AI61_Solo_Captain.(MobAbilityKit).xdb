    <spellEntries>
        <Item>
            <spell href="Captain_Suffocate.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
            <targetSelector>
                <sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
                    <order>Ascending</order>
                </sortTargets>
                <moveToDestination>true</moveToDestination>
                <targetConditionChecks>
                    <Item>
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
