<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>185781</resourceId>
    </Header>
    <visObject href="BossYeti_trap.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>15000</lifeLengthCap>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
            <projectileData>
                <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                <resource href="BossYeti_TrapMarker.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
            </projectileData>
        </Item>
    </impactsOnStart>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <affectGroup>All</affectGroup>
            <radius>3</radius>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="UI06_BossYeti.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        </mobs>
                    </Item>
                </predicates>
            </filter>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="BossYeti_TrapSlow.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
                            <radius>5</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                            <resources>
                                                <Item href="BossYeti_TrapMarker.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                            </resources>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>1000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsIn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>