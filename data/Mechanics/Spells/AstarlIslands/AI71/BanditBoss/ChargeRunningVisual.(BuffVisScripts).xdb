<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>2000</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="VisActionList">
								<elements>
									<Item type="CreatureEffectsAction">
										<visualEffects>
											<Item>
												<effectFx href="/Spells/FX/Spells/PaladinBladeofJusticeAbility_StartSmoke.(VisObjectTemplate).xdb" />
												<scale>0.5</scale>
												<locator>Slot_Global</locator>
											</Item>
											<Item>
												<effectFx href="/Spells/FX/Spells/YakGlacialChief_Charge_FX.(VisObjectTemplate).xdb" />
												<scale>0.66</scale>
												<locator>Slot_Global</locator>
												<offset y="-0.75" z="-1.75" />
											</Item>
										</visualEffects>
									</Item>
									<Item type="CreatureTrailAction">
										<mainHandTrail href="/Spells/FX/InterfaceFX/TrailBlue.(TrailTemplate).xdb" />
										<lengthMSec>10000</lengthMSec>
									</Item>
								</elements>
							</Item>
							<Item type="CreatureAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>run2HL</Item>
								</animations>
								<channel>CHANNEL_KNOCKDOWN</channel>
								<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
								<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
								<advanced>
									<speed>1.6</speed>
								</advanced>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready2HL</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
			</Item>
			<Item type="CreatureEnchantWeaponAction">
				<enchant href="/Spells/FX/Weapon/PowerWeapon/Enchants/PowerHoly_R4.(EnchantTemplate).xdb" />
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attackPower2H01</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
				<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
				<advanced>
					<speed>2</speed>
					<autoHasten>
						<mode>AUTOHASTEN_FIRSTKEY</mode>
					</autoHasten>
				</advanced>
			</Item>
			<Item type="CreatureTrailAction">
				<mainHandTrail href="/Spells/FX/InterfaceFX/TrailBlue.(TrailTemplate).xdb" />
				<lengthMSec>500</lengthMSec>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
