<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>245709</resourceId>
    </Header>
    <Name href="SherKhanRock_Jump.(SpellArea).Name.txt" />
    <visualScripts href="SherKhan_Jump.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>20</value>
    </range>
    <prepareDuration>1500</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                <time>1000</time>
                <impactsOnLand>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>6</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                <minDamage>90</minDamage>
                                <maxDamage>120</maxDamage>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                                <time>1000</time>
                                <impactsOnLand>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>0.5</multiplier>
                                        </durationScaler>
                                    </Item>
                                </impactsOnLand>
                                <distance>6</distance>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.creature.AvatarFilter" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="SherKhan_jump.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impactsOnLand>
                <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>