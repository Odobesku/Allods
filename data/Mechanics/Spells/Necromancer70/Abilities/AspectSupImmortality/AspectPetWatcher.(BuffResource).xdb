                    <buff href="/Mechanics/Spells/Necromancer70/Spells/SummonSkeleton/SummonedSkeleton.(BuffResource).xdb" />
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffInterceptor">
            <impactsOnDetach>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="APWatcher01.(BuffResource).xdb" />
                </Item>
            </impactsOnDetach>
            <predicates>
