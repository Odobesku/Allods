<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739921926</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.(AbilityResource).Name.txt" />
    <description href="Ability.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>perc</name>
            <value var="factor" />
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearScaler">
                        <multiplier>-1</multiplier>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>FormulaPercent</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>dmg</name>
            <value var="dmg" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Special/Talents/Mage/FireCDProc.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Mage63/Abilities/Flash/Buff.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SpellsModifier">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Mage63/Spells/FireBolt/Spell01.(SpellSingleTarget).xdb" />
                                <Item href="/Mechanics/Spells/Mage63/Spells/FireBoltUpgrade/Spell01.(SpellSingleTarget).xdb" />
                                <Item href="/Mechanics/Spells/Mage63/Spells/FireArrow/Spell01.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </predicates>
                    <modifiers>
                        <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                            <effects>
                                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                        <coeff var="dmg" />
                                    </scaler>
                                </Item>
                            </effects>
                            <onBehalfOfHolder>true</onBehalfOfHolder>
                        </Item>
                    </modifiers>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectModifySpellCastTime">
                    <group href="/Mechanics/Spells/Groups/MageFireSpeedcast.(ActionGroup).xdb" />
                    <factor var="factor" />
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Mage63/Abilities/Flash/Stacking.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.NotStackableEffects">
                    <effects>
                        <Item type="gameMechanics.elements.effects.SpellsModifier">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                    <spells>
                                        <Item href="/Mechanics/Spells/Mage63/Spells/FireBolt/Spell01.(SpellSingleTarget).xdb" />
                                        <Item href="/Mechanics/Spells/Mage63/Spells/FireBoltUpgrade/Spell01.(SpellSingleTarget).xdb" />
                                        <Item href="/Mechanics/Spells/Mage63/Spells/FireArrow/Spell01.(SpellSingleTarget).xdb" />
                                    </spells>
                                </Item>
                            </predicates>
                            <modifiers>
                                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                                    <effects>
                                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                                <coeff var="dmg2" />
                                            </scaler>
                                        </Item>
                                    </effects>
                                    <onBehalfOfHolder>true</onBehalfOfHolder>
                                </Item>
                            </modifiers>
                        </Item>
                        <Item type="gameMechanics.elements.effects.EffectModifySpellCastTime">
                            <group href="/Mechanics/Spells/Groups/MageFireSpeedcast.(ActionGroup).xdb" />
                            <factor var="factor2" />
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>