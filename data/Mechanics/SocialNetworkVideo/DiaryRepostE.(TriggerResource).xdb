            <onAvailable>
                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                    <id href="/Mechanics/SocialNetworkVideo/DiaryRepost1.(QuestCountId).xdb" />
                </Item>
            </onAvailable>
            <onUnavailable>
                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                    <id href="/Mechanics/SocialNetworkVideo/DiaryRepost1.(QuestCountId).xdb" />
                    <value>-1</value>
                </Item>
            </onUnavailable>
        </Item>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="/Mechanics/SocialNetworkVideo/PatchVideoRepostE.(QuestResource).xdb" />
            <counterId href="/Mechanics/SocialNetworkVideo/VideoRepost3.(QuestCountId).xdb" />
            <condition type="constructor.elements.LongEquals">
                <value>1</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/SocialNetworkVideo/DiaryRepost.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="/Mechanics/SocialNetworkVideo/PatchVideoRepostE.(QuestResource).xdb" />
            <counterId href="/Mechanics/SocialNetworkVideo/VideoRepost2.(QuestCountId).xdb" />
            <condition type="constructor.elements.LongEquals">
                <value>1</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/SocialNetworkVideo/DiaryRepost.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>