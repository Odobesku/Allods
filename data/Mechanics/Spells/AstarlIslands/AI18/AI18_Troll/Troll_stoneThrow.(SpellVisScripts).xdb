<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<animations>
			<Item>attack</Item>
		</animations>
		<channel>CHANNEL_KNOCKDOWN</channel>
		<advanced>
			<speed>0.55</speed>
			<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
		</advanced>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Lesavka_StoneProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="/Spells/FX/Spells/Lesavka_EarthExplosion.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<theGe>6</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_Global</locator>
						</pointOnTarget>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>300</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visActionID>st01</visActionID>
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/Lesavka_Stone.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<lockScale>true</lockScale>
								<scale>1.5</scale>
								<locator>Slot_Hand_R</locator>
							</Item>
						</visualEffects>
					</Item>
					<Item type="VisActionDelay">
						<time>885</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>st01</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
