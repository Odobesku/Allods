<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<FixPointCaster>false</FixPointCaster>
			<FixPointTarget>true</FixPointTarget>
			<LocatorNameOnCaster />
			<LocatorNameOnTargets />
			<PreCastAnimation>specialCast</PreCastAnimation>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<FxOnHands />
			<HitPostFXOnTargets />
			<FXOnCaster />
			<CastAnimation>specialCast</CastAnimation>
			<FXOnTargets />
		</Variables>
	</Header>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/CallAny_Loop.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
			</Item>
		</visualEffects>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="Sound3DAction">
				<sound>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>spells/Warrior/WarriorCharge</name>
				</sound>
			</Item>
			<Item type="VisActionList">
				<playWhile />
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item var="CastAnimation" />
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<channelOverrideScript />
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_ABILITY</channelAfterFirstKey>
							<eventPlaybackEnd>true</eventPlaybackEnd>
							<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
						</advanced>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile />
						<elements>
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx hrefvar="FXOnCaster" />
										<effectAlias href="" />
										<locator var="LocatorOnCaster" />
										<offendTime type="EffectOffendConstDelay" />
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
