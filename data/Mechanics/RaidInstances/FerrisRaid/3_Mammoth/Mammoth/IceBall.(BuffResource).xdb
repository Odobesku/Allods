<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739891431</resourceId>
    </Header>
    <Name href="IceBall.(BuffResource).Name.txt" />
    <Description href="IceBall.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/IceRing.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/AOEAura_Ice_R6m.(VisObjectTemplate).xdb" />
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>2</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/Mechanics/RaidInstances/UmoirRaid/2_KtulhuBoss/NoTargeting.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>6</radius>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>COLD</element>
                            <damage>10</damage>
                            <impactsOnHitTarget>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="IceVortex/VortexFreeze.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="IceVortex/VortexCold.(BuffResource).xdb" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impactsOnHitTarget>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
            <tick>500</tick>
            <initialDelay>8000</initialDelay>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>