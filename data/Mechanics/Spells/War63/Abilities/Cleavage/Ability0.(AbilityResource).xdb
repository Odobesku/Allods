<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739921361</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="coeff" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value var="duration" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaSeconds</formula>
            </scaler>
        </Item>
        <Item>
            <name>var2</name>
            <value var="value" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Warrior/WarriorsForce.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <casterPreImpacts>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAddCombatAdvantage">
                                    <value var="com" />
                                </Item>
                            </impacts>
                        </Item>
                    </casterPreImpacts>
                    <targetImpacts>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIncrementBuffDuration">
                                    <buff href="/Mechanics/Spells/War63/Spells/Bleeding/DoT01.(BuffResource).xdb" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value var="duration" />
                                    </delta>
                                </Item>
                            </impacts>
                        </Item>
                    </targetImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                        <spells>
                            <Item href="/Mechanics/Spells/War63/Spells/Cleavage/Spell01.(SpellSingleTarget).xdb" />
                        </spells>
                    </destination>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                    <spells>
                        <Item href="/Mechanics/Spells/War63/Spells/Cleavage/Spell01.(SpellSingleTarget).xdb" />
                    </spells>
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                <coeff var="coeff" />
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>