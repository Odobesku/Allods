<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="VisActionDelay">
							<time>400</time>
						</playWhile>
						<elements>
							<Item type="CreatureAnimationAction">
								<mode>LOOP</mode>
								<animations>
									<Item>ready</Item>
								</animations>
							</Item>
						</elements>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>CLAMP</mode>
						<animations>
							<Item>attack02</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
						<advanced>
							<speed>0.6</speed>
						</advanced>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>2000</time>
					</Item>
					<Item type="CreatureIndependentFxAction">
						<visObject href="RD_Architector_Boss1_CleaveUpgr.(VisObjectTemplate).xdb" />
						<lifeTime>3</lifeTime>
					</Item>
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureRotateToCastPointAction" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ArchitectBot_BodyFX.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ArchitectBot_BodyFX.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<locator>Slot_Head</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
