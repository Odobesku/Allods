<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionLoopAction">
		<actionToLoop type="CreatureAnimationAction">
			<use>USE_RANDOM_FROM_LIST</use>
			<animations>
				<Item>dodge</Item>
				<Item>kickWeak</Item>
				<Item>attackOffPierce</Item>
				<Item>attack1H</Item>
			</animations>
			<channel>CHANNEL_KNOCKDOWN</channel>
			<advanced>
				<denyAutoHasten>true</denyAutoHasten>
			</advanced>
		</actionToLoop>
	</action>
</BuffVisScripts>
