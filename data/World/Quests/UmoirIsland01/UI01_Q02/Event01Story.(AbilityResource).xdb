                    </predicates>
                    <effectsElse>
                        <Item type="gameMechanics.elements.effects.EffectsDeferred">
                            <delay>3000</delay>
                            <effects>
                                <Item type="gameMechanics.elements.effects.Switch">
                                    <impactsOn>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                            <data href="Event01_story1.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </Item>
                                    </impactsOn>
                                </Item>
                            </effects>
                        </Item>
                        <Item type="gameMechanics.elements.effects.EffectsDeferred">
                            <delay>9000</delay>
                            <effects>
                                <Item type="gameMechanics.elements.effects.Switch">
                                    <impactsOn>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                            <data href="Event01_story2.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </Item>
                                    </impactsOn>
                                </Item>
                            </effects>
                        </Item>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                                    <destination type="gameMechanics.map.destination.DestinationLocator">
                                        <locator>
                                            <scriptID>Event01_Story</scriptID>
                                            <map href="/Maps/UmoirIsland01/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                        </locator>
                                    </destination>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Event01_Story2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
