<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Items/RPG_Cast.(VisObjectTemplate).xdb" />
						<scale>0.2</scale>
						<locator>Slot_Head</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/Items/RPG_Channeling.(VisObjectTemplate).xdb" />
				<startPoint type="VisPointLocator">
					<locator>Slot_Hand_L</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
				<fadeInTime>100</fadeInTime>
				<fadeOutTime>100</fadeOutTime>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
				<channelOverrideControllers>TOP_ONLY</channelOverrideControllers>
				<advanced>
					<speed>0.25</speed>
					<offendType>EVERYKEY_OFFEND</offendType>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<turnToTarget>BEFORE_ANIMATIONEND</turnToTarget>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<actionBarComplite type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Mobs/GT_7Boss_TeleportExplosion_HandFlash.(VisObjectTemplate).xdb" />
				<locator>Slot_Hand_R</locator>
			</Item>
		</visualEffects>
	</actionBarComplite>
	<precastType>PRECAST_DEFAULT</precastType>
	<charged />
</SpellVisScripts>
