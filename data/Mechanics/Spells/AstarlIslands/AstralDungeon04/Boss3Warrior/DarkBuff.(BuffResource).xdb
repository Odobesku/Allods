<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739951576</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Buffs/Constellation1.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Mobs/Demon_TargetMark.(VisObjectTemplate).xdb" />
            <lockScale>true</lockScale>
            <scale>1.55</scale>
            <fadeInTime>300</fadeInTime>
            <fadeOutTime>300</fadeOutTime>
            <locator>Slot_TopFX</locator>
            <offset z="2.1" />
        </Item>
    </visualEffects>
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                            <spawn>
                                <scriptID>TZ03Slave</scriptID>
                                <map href="/Maps/AstralDungeon04/MapResource.xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ForcedAggroLeader.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="/Mechanics/Spells/AstarlIslands/Remove_Aggro.(ClientData).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="/Mechanics/Spells/AstarlIslands/AstralDungeon04/Boss04/SphereChannel.(ClientData).xdb" />
                                    <calcers>
                                        <addressEntries>
                                            <Item>
                                                <name>target</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                            </Item>
                                            <Item>
                                                <name>caster</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                            </Item>
                                        </addressEntries>
                                    </calcers>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                        <Item type="gameMechanics.elements.predicates.PredicateIsDead" />
                                    </predicates>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                                    <spawn>
                                        <scriptID>TZ03Slave</scriptID>
                                        <map href="/Maps/AstralDungeon04/MapResource.xdb" />
                                    </spawn>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="ForcedAggroLeader.(BuffResource).xdb" />
                                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                                    <predicates>
                                                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                                            <mobs>
                                                                                <Item href="/Creatures/DemonMageNewBreed/Instances/AstralDungeon04/TZ_boss3Demon.(MobWorld).xdb" />
                                                                            </mobs>
                                                                        </Item>
                                                                    </predicates>
                                                                    <impactsIf>
                                                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                                            <impacts>
                                                                                <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                                                            </impacts>
                                                                        </Item>
                                                                    </impactsIf>
                                                                </Item>
                                                            </impacts>
                                                            <spawnResource href="/Maps/AstralDungeon04/SpawnTables/Boss03.(SpawnTable).xdb" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro">
                                            <value>10</value>
                                        </Item>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="LightBuff.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/AstralIslandSpells.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>