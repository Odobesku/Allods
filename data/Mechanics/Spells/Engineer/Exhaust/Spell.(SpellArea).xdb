										<time>1500</time>
										<impactsOnLand>
											<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
												<buff href="ColdSlow.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
												<durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
													<mul>1.25</mul>
													<mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
														<calcers>
															<Item type="gameMechanics.elements.calcers.InverseCalcer">
																<value type="gameMechanics.elements.calcers.FloatData">
																	<value>-50</value>
																</value>
															</Item>
															<Item type="gameMechanics.elements.calcers.VariableValueCalcer">
																<variable href="/Mechanics/Spells/Engineer/Overheating/Overheating.(VariableResource).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
															</Item>
															<Item type="gameMechanics.elements.calcers.AbilityRankCalcer">
																<ability href="/Mechanics/Spells/Engineer/Abilities/ExhaustUpg/Ability01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
																<mul>0.16667</mul>
																<sum>1</sum>
															</Item>
														</calcers>
													</mulCalcer>
												</durationScaler>
											</Item>
										</impactsOnLand>
										<distance var="distance" />
									</Item>
								</impactsOnAttach>
							</Item>
						</elseImpacts>
					</Item>
				</impacts>
				<elseImpacts>
