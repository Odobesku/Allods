<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739852649</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/AcidSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="BombOnLand.(SpellArea).Name.txt" />
    <visualScripts href="Bomb00.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="BombOnLand.(SpellArea).Name.txt" />
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="ReflectBubble.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                    </moveType>
                    <resource href="BombProjectile.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                </projectileData>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateCreature" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ACID</element>
                        <threatMultiplier>0</threatMultiplier>
                        <damage>30</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>