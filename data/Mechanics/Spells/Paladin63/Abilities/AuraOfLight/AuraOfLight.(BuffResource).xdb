<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739924844</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="AuraOfLight.(BuffResource).Name.txt" />
    <Description href="AuraOfLight.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/Exorcism.(UISingleTexture).xdb" />
    <visScript href="/Spells/BuffVisScripts/DotHoly.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>10</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>HOLY</element>
                                    <forceAE>true</forceAE>
                                    <damage>1</damage>
                                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                        <scalers>
                                            <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer hrefvar="externalCalcer" />
                                                </mulCalcer>
                                            </Item>
                                        </scalers>
                                    </scaler>
                                </Item>
                            </impacts>
                            <groupRepeaters>true</groupRepeaters>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>4000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="AuraOfLight01.(BuffResource).xdb" />
        <Item href="AuraOfLight02.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>