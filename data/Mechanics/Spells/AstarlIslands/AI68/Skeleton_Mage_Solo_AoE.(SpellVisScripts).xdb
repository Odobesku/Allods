<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<animations>
			<Item>spellCastOmni</Item>
		</animations>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect02Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirected</Item>
				</animations>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureProjectileAction">
				<explosionFx href="/Spells/FX/Spells/Engeneer_MantrapRootAndEat.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<theGe>5</theGe>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_Global</locator>
				</pointOnTarget>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
