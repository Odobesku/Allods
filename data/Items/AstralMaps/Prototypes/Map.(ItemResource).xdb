<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>520088</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <description href="Map.(ItemResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Papers/PapersSecret.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <source>Quest</source>
    <position>1</position>
    <descVars>
        <Item>
            <name>sectorName</name>
            <text hrefvar="sectorName" />
        </Item>
        <Item>
            <name>tierName</name>
            <text hrefvar="tierName" />
        </Item>
        <Item>
            <name>tier2Name</name>
            <text hrefvar="tier2Name" />
        </Item>
    </descVars>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <level>60</level>
    <requiredLevel>60</requiredLevel>
    <stackLimit>20</stackLimit>
    <quality href="/Mechanics/ItemQualities/Common.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money var="money" />
        </cost>
    </prices>
    <binding>BindOnPickup</binding>
    <lifeLengthCap>1209600000</lifeLengthCap>
    <name href="Map.(ItemResource).Name.txt" />
    <category href="/Mechanics/ItemCategories/Ship/Misc.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
    <calcers>
        <Item>
            <name>mult</name>
            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerMul">
                <calcers>
                    <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerSum">
                        <calcers>
                            <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerAstralMapMult" />
                            <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                                <value>-1</value>
                            </Item>
                        </calcers>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                        <value>100</value>
                    </Item>
                </calcers>
            </calcer>
        </Item>
        <Item>
            <name>maxMult</name>
            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerMul">
                <calcers>
                    <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerSum">
                        <calcers>
                            <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                                <value var="maxMult" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                                <value>-1</value>
                            </Item>
                        </calcers>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                        <value>100</value>
                    </Item>
                </calcers>
            </calcer>
        </Item>
    </calcers>
</gameMechanics.constructor.schemes.item.ItemResource>