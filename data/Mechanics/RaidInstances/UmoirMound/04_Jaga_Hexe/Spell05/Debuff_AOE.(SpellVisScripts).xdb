<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>readySpell</PreCastAnimation>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<FXOnTargets>/Spells/FX/Mobs/Jaga_Hit_Debuff.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<FxOnHands>/Spells/FX/Mobs/Jaga_Ready_Debuff.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
		</Variables>
	</Header>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<lockScale>false</lockScale>
							<scale>1</scale>
						</Item>
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
