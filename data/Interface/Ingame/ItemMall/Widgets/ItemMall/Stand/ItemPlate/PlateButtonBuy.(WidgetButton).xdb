<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>Buy</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>17</HighPos>
            <Size>120</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>16</HighPos>
            <Size>33</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>100</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>mall_buy_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag>value</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ItemMall/Textures/ItemPlate/PlateButtonBuyHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            <PushedOffset x="0" y="0"/>
            <Reaction>mall_buy_pressed</Reaction>
            <ReactionRightClick>mall_buy_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ItemMall/Texts/Widgets/PlateButtonBuyNormal.txt"/>
                <LayerMain href="/Interface/Ingame/ItemMall/Textures/ItemPlate/PlateButtonBuyNormal.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ItemMall/Textures/ItemPlate/PlateButtonBuyPressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ItemMall/Texts/Widgets/PlateButtonBuyValue.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
