<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739920548</resourceId>
    </Header>
    <Name href="RollLoot.(SpellSingleTarget).Name.txt"/>
    <Description href="RollLoot.(SpellSingleTarget).Description.txt"/>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem"/>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                <currency href="/Mechanics/AlternativeCurrencies/ItemMall/CasualToken.xdb"/>
                <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>1</value>
                </sumCalcer>
            </Item>
            <Item type="itemService.elements.ImpactContestIncrease">
                <contestResource
                        href="/Mechanics/Rules/BoxContest/11_2015_HaloSpellContest/Contest.(OpenBoxContestResource).xdb"/>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactDropLoot">
                <rolls type="gameMechanics.elements.calcers.FloatData">
                    <value>1</value>
                </rolls>
                <lootTable href="DefaultLoot.(LootTableResource).xdb"/>
                <worldNotification
                        href="/ItemMall/Rares/ChestsAdvanced/HaloSpells/WorldNotify/HaloSpellGetNotify.(ClientData).xdb"/>
                <worldNotificationWithGuild
                        href="/ItemMall/Rares/ChestsAdvanced/HaloSpells/WorldNotify/HaloSpellGetNotifyWithGuild.(ClientData).xdb"/>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
