<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739856313</resourceId>
	</Header>
	<mechanics>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
				<spawn>
					<scriptID>Koschey</scriptID>
					<map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
				</spawn>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="UI02_Fire.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.BuffDetacher">
								<buff href="UI02_Fire.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="UI02_Mushroom.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactClientData">
								<data href="Fire_Success.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
								<locators>
									<Item>
										<scriptID>Kettle</scriptID>
										<map href="/Maps/UmoirIsland02/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
									</Item>
								</locators>
							</Item>
						</impactsIf>
						<impactsElse>
							<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
								<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
								<data href="Fire.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
							</Item>
						</impactsElse>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
