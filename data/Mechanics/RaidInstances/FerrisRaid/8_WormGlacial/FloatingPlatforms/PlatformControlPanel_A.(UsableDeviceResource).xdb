<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.UsableDeviceResource>
    <Header>
        <resourceId>739893853</resourceId>
    </Header>
    <parts>
        <Item type="UsableDeviceClientPart">
            <type>USDEV_USABLE_DEVICE</type>
        </Item>
    </parts>
    <persistentParts>
        <Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
            <effects>
                <Item type="gameMechanics.world.device.parts.ImpactsOnUserGeneric">
                    <userImpactsOnStartUse>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="PanelUser_A.(BuffResource).xdb" />
                            <impactsOnAttach>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                            <buff href="ActivatePlatform/Rider_A.(BuffResource).xdb" />
                                                        </Item>
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                                            <impacts>
                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                    <buff href="ActivatePlatform/ActivatedPlatform_A.(BuffResource).xdb" />
                                                                </Item>
                                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                                    <buff href="PanelUser_A.(BuffResource).xdb" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impactsIf>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOnAttach>
                        </Item>
                    </userImpactsOnStartUse>
                    <userImpactsOnFinishUse>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="PanelUser_A.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ActivatePlatform/ActivatedPlatform_A.(BuffResource).xdb" />
                        </Item>
                    </userImpactsOnFinishUse>
                </Item>
            </effects>
        </Item>
    </persistentParts>
    <name href="PlatformControlPanel_A.(UsableDeviceResource).Name.txt" />
    <spawnLocation>
        <position x="13394.799805" y="14222.651367" z="153.705002" />
        <zone href="/Maps/FerrisRaid/Zones/RaidFerris2.(ZoneResource).xdb" />
    </spawnLocation>
    <visObj href="/Ships/Components/RudderVertical_01B/RudderVertical_01B.(VisObjectTemplate).xdb" />
    <collisionObject>false</collisionObject>
    <interactiveObject>true</interactiveObject>
    <exploitingText href="PlatformControlPanel_A.(UsableDeviceResource).ExploitingText.txt" />
