<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>49495</resourceId>
    </Header>
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/World/WaterBubble.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <scale>2</scale>
        </Item>
    </visualEffects>
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpeedSetter">
            <speed>0.005</speed>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.RandomImpact">
                            <entries>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                            <data href="DrunkHint1.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                            <data href="DrunkHint2.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                            <data href="DrunkHint3.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </entries>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/Mechanics/Spells/Events/LoreEvents/Blacksmith/BSLoreElemental.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
            <personalPlane>true</personalPlane>
        </Item>
    </effects>
    <duration>20000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <ignoreLevelDelta>true</ignoreLevelDelta>
    <groups>
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/Events/EventBuffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>