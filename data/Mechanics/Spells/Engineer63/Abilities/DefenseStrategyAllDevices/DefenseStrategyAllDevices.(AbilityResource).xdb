<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739933491</resourceId>
    </Header>
    <name href="DefenseStrategyAllDevices.(AbilityResource).Name.txt" />
    <description href="DefenseStrategyAllDevices.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Ships/RestoreShield.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <casterImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>50</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectGroup>Friends</affectGroup>
                            <conditions>
                                <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                                </Item>
                            </conditions>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="/Mechanics/Spells/Engineer63/Abilities/SelfDestroy/DoNotExplode.(MarkResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                                            <variable href="/Mechanics/Spells/Engineer63/Spells/Strategies/ShieldAmount.(VariableResource).xdb" />
                                                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                <mulCalcer type="gameMechanics.elements.calcers.HealthCalcer" />
                                                            </scaler>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <finishImpacts>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/Engineer63/Spells/Strategies/Shield.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                            <mark href="/Mechanics/Spells/Engineer63/Abilities/DefenseStrategyGroup/StrategyGroupShield.(MarkResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </finishImpacts>
                        </Item>
                    </impacts>
                </Item>
            </casterImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/Engineer63/Spells/Strategies/Shield.(SpellSingleTarget).xdb" />
                </spells>
            </destination>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>