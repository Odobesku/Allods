<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Description href="/Spells/VisScripts/Prototypes/Parts/Base.Description.txt" />
    <actionBarStart type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.CreatureRunVisActionResource" />
            <Item type="client.Replica.CreatureRunVisActionResource" />
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </actionBarStart>
    <precastType>PRECAST_DEFAULT</precastType>
    <wholeCasting type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.CreatureRunVisActionResource" />
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </wholeCasting>
    <charged type="client.Replica.CreatureChargedSpellAction">
        <effectLocator>Wand_Slot_FX</effectLocator>
        <fadeInTime>0</fadeInTime>
        <fadeOutTime>0</fadeOutTime>
    </charged>
    <launch type="client.Replica.VisActionList">
        <elements>
            <Item type="client.Replica.VisActionList">
                <elements>
                    <Item type="client.Replica.CreatureEffectsAction">
                        <category>EFFECT_DEFAULT</category>
                        <visualEffects>
                            <Item>
                                <delay>0</delay>
                                <effectAnimations>
                                    <mode>DIE</mode>
                                </effectAnimations>
                                <effectFx href="/Spells/FX/Spells/Necromancer70_SpellCast_BloodPact_Ult.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <scale>1</scale>
                                <fixPoint>false</fixPoint>
                                <lockScale>false</lockScale>
                                <muteFxSounds>false</muteFxSounds>
                                <ignoreParentRotation>false</ignoreParentRotation>
                                <locator>Global</locator>
                                <member>Default_Member</member>
                                <offset x="0" y="0" z="0" />
                                <rotation x="0" y="0" z="0" w="0" />
                                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                            </Item>
                        </visualEffects>
                        <dontFade>false</dontFade>
                        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                        <stopOnDeath>false</stopOnDeath>
                    </Item>
                </elements>
                <play>InSequence</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
            <Item type="client.Replica.VisActionList">
                <elements>
                    <Item type="client.Replica.CreatureEffectsAction">
                        <category>EFFECT_DEFAULT</category>
                        <visualEffects>
                            <Item>
                                <delay>0</delay>
                                <effectAnimations>
                                    <mode>DIE</mode>
                                </effectAnimations>
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <scale>1</scale>
                                <fixPoint>false</fixPoint>
                                <lockScale>false</lockScale>
                                <muteFxSounds>false</muteFxSounds>
                                <ignoreParentRotation>false</ignoreParentRotation>
                                <locator>Global</locator>
                                <member>Default_Member</member>
                                <offset x="0" y="0" z="0" />
                                <rotation x="0" y="0" z="0" w="0" />
                                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                            </Item>
                            <Item>
                                <delay>0</delay>
                                <effectAnimations>
                                    <mode>DIE</mode>
                                </effectAnimations>
                                <effectFx href="/Spells/FX/Spells/ReadySpellDirectNecromancerWand_CastScale.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <scale>1</scale>
                                <fixPoint>true</fixPoint>
                                <lockScale>false</lockScale>
                                <muteFxSounds>false</muteFxSounds>
                                <ignoreParentRotation>false</ignoreParentRotation>
                                <locator>Global</locator>
                                <member>Default_Member</member>
                                <offset x="0" y="0" z="0" />
                                <rotation x="0" y="0" z="0" w="0" />
                                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                            </Item>
                        </visualEffects>
                        <dontFade>false</dontFade>
                        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                        <stopOnDeath>false</stopOnDeath>
                    </Item>
                    <Item type="client.Replica.VisActionList">
                        <elements>
                            <Item type="client.Replica.CreatureChannelDirectAction">
                                <channelingFx href="/Spells/FX/Spells/Necromancer70_BloodPact_Channel_Ult.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                                <endPoint type="client.Replica.VisPointLocator">
                                    <shift x="0" y="0" z="0" />
                                    <from>FROM_DEFALUT</from>
                                    <locator>Slot_FX</locator>
                                    <member>Default_Member</member>
                                </endPoint>
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <fxLength>10</fxLength>
                                <multyTargetMode>FromCaster</multyTargetMode>
                                <secondaryTargetParams>
                                    <fadeInTime>0</fadeInTime>
                                    <fadeOutTime>0</fadeOutTime>
                                    <fxLength>10</fxLength>
                                    <velocity>0</velocity>
                                    <scaleTextureU>false</scaleTextureU>
                                    <scaleTextureV>false</scaleTextureV>
                                </secondaryTargetParams>
                                <startPoint type="client.Replica.VisPointLocator">
                                    <shift x="0" y="0" z="0" />
                                    <from>FROM_DEFALUT</from>
                                    <locator>Slot_FX</locator>
                                    <member>Default_Member</member>
                                </startPoint>
                                <velocity>0</velocity>
                                <scaleTextureU>false</scaleTextureU>
                                <scaleTextureV>false</scaleTextureV>
                            </Item>
                        </elements>
                        <play>Simultaneously</play>
                        <playWhile type="client.Replica.VisActionDelay">
                            <time>1500</time>
                        </playWhile>
                        <preconditional>false</preconditional>
                        <restartOnVisualChange>false</restartOnVisualChange>
                        <stopOnDeath>false</stopOnDeath>
                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                    </Item>
                </elements>
                <play>Simultaneously</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </launch>
    <ownKillingParams>
        <probabilityNoOverkill>0.2</probabilityNoOverkill>
        <probabilityWithOverkill>1</probabilityWithOverkill>
    </ownKillingParams>
    <playOnTargets>
        <specialAction type="client.Replica.VisActionList">
            <elements>
                <Item type="client.Replica.CreatureEffectsAction">
                    <category>EFFECT_DEFAULT</category>
                    <visualEffects>
                        <Item>
                            <delay>0</delay>
                            <effectAnimations>
                                <mode>DIE</mode>
                            </effectAnimations>
                            <fadeInTime>0</fadeInTime>
                            <fadeOutTime>0</fadeOutTime>
                            <scale>1</scale>
                            <fixPoint>false</fixPoint>
                            <lockScale>true</lockScale>
                            <muteFxSounds>false</muteFxSounds>
                            <ignoreParentRotation>false</ignoreParentRotation>
                            <locator>Global</locator>
                            <member>Default_Member</member>
                            <offset x="0" y="0" z="0" />
                            <rotation x="0" y="0" z="0" w="0" />
                            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                        </Item>
                    </visualEffects>
                    <dontFade>false</dontFade>
                    <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                    <stopOnDeath>false</stopOnDeath>
                </Item>
                <Item type="client.Replica.CreatureRunVisActionResource" />
            </elements>
            <play>Simultaneously</play>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
        </specialAction>
        <skipBloodFx>false</skipBloodFx>
        <skipHitAnimations>false</skipHitAnimations>
    </playOnTargets>
    <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>