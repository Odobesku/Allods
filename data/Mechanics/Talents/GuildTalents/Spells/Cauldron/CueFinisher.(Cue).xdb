    </conditions>
    <impacts>
        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
            <buff href="GotPot.(BuffResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactsToInterlocutor">
