			<locator>Slot_Global</locator>
		</Item>
	</visualPostEffects>
	<visScript href="/Mechanics/InstanceModifiers/Addon5/Storm/Normal/Storm.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>4</radius>
					<affectGroup>Enemies</affectGroup>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateOr">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
										<Item type="gameMechanics.elements.resources.ResourceBuff">
											<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
										</Item>
									</predicates>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
											<buff href="/Mechanics/InstanceModifiers/Addon5/Storm/Storm_PplCheck.(BuffResource).xdb" />
											<range>
												<min>2</min>
												<max>15</max>
											</range>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
											<element>LIGHTNING</element>
											<damage>40</damage>
											<scaler type="gameMechanics.elements.scalers.MagicScaler" />
										</Item>
									</impactsIf>
									<impactsElse>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
													<buff href="/Mechanics/InstanceModifiers/Addon5/Storm/Storm_PplCheck.(BuffResource).xdb" />
													<range>
														<min>1</min>
														<max>1</max>
													</range>
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
													<element>LIGHTNING</element>
													<damage>80</damage>
													<scaler type="gameMechanics.elements.scalers.MagicScaler" />
												</Item>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/InstanceModifiers/Addon5/Storm/Normal/Storm_Dot_Low.(BuffResource).xdb" />
												</Item>
											</impactsIf>
											<impactsElse>
												<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
													<element>LIGHTNING</element>
													<damage>100</damage>
													<scaler type="gameMechanics.elements.scalers.MagicScaler" />
												</Item>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="Storm_Dot.(BuffResource).xdb" />
												</Item>
											</impactsElse>
										</Item>
									</impactsElse>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
