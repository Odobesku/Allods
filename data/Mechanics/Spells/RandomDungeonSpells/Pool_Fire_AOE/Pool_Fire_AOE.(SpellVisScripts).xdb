<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Header>
        <Prototype href="/Spells/VisScripts/Prototypes/MobOmni.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
        <Variables>
            <AnimationPreCastMode>LOOP</AnimationPreCastMode>
            <PreCastAnimation>readySpell</PreCastAnimation>
            <FxOnHands>/Spells/FX/Spells/ReadySpellDirectFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
            <CastAnimation>spellCastOmni</CastAnimation>
            <FXOnCaster />
            <FixPointCaster>false</FixPointCaster>
            <LocatorOnCaster>Slot_Global</LocatorOnCaster>
            <LocatorNameOnCaster />
            <FixPointTarget>true</FixPointTarget>
            <LocatorNameOnTargets />
            <LocatorOnTargets>Slot_FX</LocatorOnTargets>
            <HitPostFXOnTargets />
            <FXOnTargets>/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
        </Variables>
    </Header>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <mode var="AnimationPreCastMode" />
                <animations>
                    <Item var="PreCastAnimation" />
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>2</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx hrefvar="FxOnHands" />
                        <scale>2</scale>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                    <Item>
                        <effectFx hrefvar="FxOnHands" />
                        <scale>2</scale>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item var="CastAnimation" />
                </animations>
            </Item>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx hrefvar="FXOnCaster" />
                                <fixPoint var="FixPointCaster" />
                                <scale>0.8</scale>
                                <locator var="LocatorOnCaster" />
                                <locatorName var="LocatorNameOnCaster" />
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>