<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>321513</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectRestrictInteractions" />
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateInZone">
                                        <zone href="/Maps/ZC12/Zones/ZC12/ZC12.(ZoneResource).xdb" />
                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                                    <assistantResource href="WW_6_12_Assistant.(AssistantResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="WW_6_12_item.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="WW_6_12_item.(BuffResource).xdb" />
                            <anyRank>false</anyRank>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>