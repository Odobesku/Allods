<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739904124</resourceId>
    </Header>
    <groups>
        <Item href="Ferris10Electro.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <element>LIGHTNING</element>
    <Name href="ElectroCleave.(SpellArea).Name.txt" />
    <prepareDuration>1000</prepareDuration>
    <mechanics>
        <cooldown>
            <duration>6000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ACID</element>
                        <damage>25</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ACID</element>
                        <damage>10</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </elseImpacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>90</value>
        </angle>
    </shape>
    <radius>7</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>