<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>193970</resourceId>
    </Header>
    <visualScripts href="Shout.(SpellVisScripts).xdb" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>12000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                        <ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="SelfBuff.(BuffResource).xdb" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="CatAdd.(MobWorld).xdb" />
                        </mobs>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="AddBuff.(BuffResource).xdb" />
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>60</radius>
    <needLosToTarget>true</needLosToTarget>
    <stopOnNoTargets>false</stopOnNoTargets>
</gameMechanics.constructor.schemes.spell.area.SpellArea>