                                            <impactsResource href="/Mechanics/RaidInstances/RewardChestKill.(ImpactListResource).xdb" />
                                        </Item>
                                    </impacts>
                                    <device>
                                        <scriptID>Psyker_Chest</scriptID>
                                        <map href="/Maps/ArchBase_Raid/MapResource.xdb" />
                                    </device>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                                            <variable href="/Mechanics/RaidInstances/ArchBaseRaid/Other/R7_Psyker_Kill.(MapVariableResource).xdb" />
                                            <summand>1</summand>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="R7_PsykerBoss_HM.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                                <Item type="gameMechanics.map.variables.PredicateMapVariableLess">
                                    <variableResource href="/Mechanics/RaidInstances/ArchBaseRaid/Other/R7_Psyker_Kill.(MapVariableResource).xdb" />
                                    <maxValue type="gameMechanics.elements.calcers.FloatData">
                                        <value>1</value>
                                    </maxValue>
                                </Item>
                            </predicates>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                            <impactsResource href="/Mechanics/RaidInstances/RewardChestKill.(ImpactListResource).xdb" />
                                        </Item>
                                    </impacts>
                                    <device>
                                        <scriptID>Psyker_Chest_HM</scriptID>
                                        <map href="/Maps/ArchBase_Raid/MapResource.xdb" />
                                    </device>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                                            <variable href="/Mechanics/RaidInstances/ArchBaseRaid/Other/R7_Psyker_Kill.(MapVariableResource).xdb" />
                                            <summand>1</summand>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
