<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Omni.(SpellVisScripts).xdb" />
		<Variables>
			<PreCastAnimation>/Spells/VisScripts/Prototypes/PreCastAnimationOmniWand.(CreatureVisActionResource).xdb</PreCastAnimation>
			<FXOnTargets />
			<CastAnimation>spellCastDirectedBard</CastAnimation>
			<FXOnCaster>/Spells/FX/Spells/Bard_Dissonance.(VisObjectTemplate).xdb</FXOnCaster>
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<LocatorNameOnTargets />
			<FixPointTarget>true</FixPointTarget>
			<LocatorNameOnCaster />
			<PreCastFX />
			<FXWand />
			<FixPointCaster>false</FixPointCaster>
			<FXPocket />
			<WholeCastFX />
			<HitPostFXOnTargets />
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmniBard</Item>
				</animations>
				<channel>CHANNEL_ACTIONBAR</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect01DownMusic.(VisObjectTemplate).xdb" />
						<fadeOutTime>500</fadeOutTime>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="CreatureEffectsAction" />
				<Item type="CreatureRunVisActionResource" />
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/Bard_ShadowHit.(VisObjectTemplate).xdb" />
							<locator>Slot_FX</locator>
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
