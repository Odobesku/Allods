        <Item href="/Mechanics/Spells/Groups/RemortSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/SpeedBoosts.xdb" />
    </groups>
    <element>HOLY</element>
    <Name href="Spell_Name.txt" />
    <Description href="Spell_Desc.txt" />
    <image href="/Interface/Icons/Spells/Paladin/LightInfusionUpgrade.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Priest/RemortPriest_Teleport.(SpellVisScripts).xdb" />
    <sysName>CategoryRemort</sysName>
    <nameTemplate href="Spell_Name.txt.template" />
    <descTemplate href="Spell_Desc.txt.template" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <level>1</level>
    <prepareDuration>0</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>1000</duration>
            <scaler type="gameMechanics.elements.scalers.ScalerExternal">
                <scalerResource href="DivineArmor.(ScalerResource).xdb" />
            </scaler>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint">
                        <yawDelta type="constructor.basicElements.AngleDegrees">
                            <value>180</value>
                        </yawDelta>
                    </destination>
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.ModifierTrailFrom">
                            <from type="gameMechanics.map.destination.SelfPosDestination" />
                        </Item>
                    </modifiers>
                </destination>
                <finishImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>15</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Spells/CommonBuffs/Root/Buff.(BuffResource).xdb" />
                                <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier>3</multiplier>
                                </durationScaler>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                <value>10</value>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.creature.AliveFilter" />
                        <targetsLimit>1</targetsLimit>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientData">
                        <data href="TeleportData.(ClientData).xdb" />
                    </Item>
                </finishImpacts>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                <impactsResource href="/Mechanics/Spells/Remort/RemortSpellsCD.(ImpactListResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>0</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>