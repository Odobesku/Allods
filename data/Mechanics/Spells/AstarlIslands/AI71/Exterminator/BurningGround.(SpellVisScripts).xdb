<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellOmniShield</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_Precast.(VisObjectTemplate).xdb" />
                        <scale>1.5</scale>
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>250</fadeOutTime>
                        <locator>Slot_Global</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_PrecastHands.(VisObjectTemplate).xdb" />
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>250</fadeOutTime>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                    <Item>
                        <delay>250</delay>
                        <effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_PrecastHands.(VisObjectTemplate).xdb" />
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>250</fadeOutTime>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureHoldWeaponAction" />
        </elements>
    </actionBarStart>
</SpellVisScripts>