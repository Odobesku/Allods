								<member>Mount</member>
								<locatorName>Slot_Special01</locatorName>
								<offendTime />
								<offset y="-0.3" z="0.35" />
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/MountTauntaun_Shield.(VisObjectTemplate).xdb" />
