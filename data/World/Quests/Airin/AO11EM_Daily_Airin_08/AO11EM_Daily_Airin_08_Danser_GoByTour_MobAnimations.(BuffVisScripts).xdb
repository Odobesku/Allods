<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.CreatureChangeVisItemsAction">
        <items>
          <Item>
            <newItem href="/Items/VisualItems/Boots/Lather_A_61SkatesWinterBoots.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
            <slot>BOOTS</slot>
          </Item>
        </items>
        <isGfxCondition>false</isGfxCondition>
        <leaveWeapons>false</leaveWeapons>
        <notForDolls>false</notForDolls>
        <removeAllItems>false</removeAllItems>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.VisActionDelay">
            <time>100</time>
          </Item>
          <Item type="client.Replica.CreatureAnimationAction">
            <advanced>
              <autoHasten>
                <mode>AUTOHASTEN_NONE</mode>
                <timeToBeLeft>0</timeToBeLeft>
              </autoHasten>
              <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
              <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
              <offendType>NO_OFFEND</offendType>
              <speed>0</speed>
              <turnToTarget>TURN_DEFAULT</turnToTarget>
              <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
              <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
              <denyAutoHasten>false</denyAutoHasten>
              <disableRandomFirstFrame>true</disableRandomFirstFrame>
              <eventPlaybackEnd>false</eventPlaybackEnd>
              <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
              <stopIfMoved>false</stopIfMoved>
              <stopIfRotated>false</stopIfRotated>
            </advanced>
            <channel>CHANNEL_DEFAULT</channel>
            <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
            <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
            <mode>DIE</mode>
            <use>USE_ANIMATIONS</use>
            <dontFreezePrecast>false</dontFreezePrecast>
          </Item>
          <Item type="client.SLON.IfAction">
            <condition type="client.SLON.IfCreatureVisCharacter">
              <visCharList>
                <Item href="/Characters/Giberling_Group/GiberlingGroup.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
              </visCharList>
              <checkIsInTheList>true</checkIsInTheList>
              <checkOnStartOnly>true</checkOnStartOnly>
            </condition>
            <onBreak>
              <breakEnabled>false</breakEnabled>
            </onBreak>
            <thenAction type="client.Replica.VisActionList">
              <elements>
                <Item type="client.Replica.CreatureReplaceAnimationsAction">
                  <member>Assaulter</member>
                  <onBottom>
                    <animationsReplacements>
                      <Item>
                        <forAnimations>
                          <Item>walk</Item>
                          <Item>idle</Item>
                          <Item>run</Item>
                          <Item>shuffleLeft</Item>
                          <Item>shuffleRight</Item>
                        </forAnimations>
                        <play>walkIce</play>
                      </Item>
                    </animationsReplacements>
                    <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
                  </onBottom>
                  <onMount>
                    <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
                  </onMount>
                  <onTop>
                    <animationsReplacements>
                      <Item>
                        <forAnimations>
                          <Item>walk</Item>
                          <Item>idle</Item>
                          <Item>run</Item>
                          <Item>shuffleLeft</Item>
                          <Item>shuffleRight</Item>
                        </forAnimations>
                        <play>walkIce</play>
                      </Item>
                    </animationsReplacements>
                    <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
                  </onTop>
                  <priority href="/Client/Priorieties/CreatureReplaceAnimationsAction/OverrideWeaponReplace.(PriorityResource).xdb#xpointer(/client.Replica.PriorityResource)" />
                  <replaceWhen>ReplaceAlways</replaceWhen>
                  <restartOnVisualChange>true</restartOnVisualChange>
                </Item>
                <Item type="client.Replica.CreatureReplaceAnimationsAction">
                  <member>Defender</member>
                  <onBottom>
                    <animationsReplacements>
                      <Item>
                        <forAnimations>
                          <Item>walk</Item>
                          <Item>idle</Item>
                          <Item>run</Item>
                          <Item>shuffleLeft</Item>
                          <Item>shuffleRight</Item>
                        </forAnimations>
                        <play>walkIce</play>
                      </Item>
                    </animationsReplacements>
                    <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
                  </onBottom>
                  <onMount>
                    <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
                  </onMount>
                  <onTop>
                    <animationsReplacements>
                      <Item>
                        <forAnimations>
                          <Item>walk</Item>
                          <Item>idle</Item>
                          <Item>run</Item>
                          <Item>shuffleLeft</Item>
                          <Item>shuffleRight</Item>
                        </forAnimations>
                        <play>walkIce</play>
                      </Item>
                    </animationsReplacements>
                    <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
                  </onTop>
                  <priority href="/Client/Priorieties/CreatureReplaceAnimationsAction/OverrideWeaponReplace.(PriorityResource).xdb#xpointer(/client.Replica.PriorityResource)" />
                  <replaceWhen>ReplaceAlways</replaceWhen>
                  <restartOnVisualChange>true</restartOnVisualChange>
                </Item>
                <Item type="client.Replica.CreatureReplaceAnimationsAction">
                  <member>Caster</member>
                  <onBottom>
                    <animationsReplacements>
                      <Item>
                        <forAnimations>
                          <Item>walk</Item>
                          <Item>idle</Item>
                          <Item>run</Item>
                          <Item>shuffleLeft</Item>
                          <Item>shuffleRight</Item>
                        </forAnimations>
                        <play>walkIce</play>
                      </Item>
                    </animationsReplacements>
                    <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
                  </onBottom>
                  <onMount>
                    <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
                  </onMount>
                  <onTop>
                    <animationsReplacements>
                      <Item>
                        <forAnimations>
                          <Item>walk</Item>
                          <Item>idle</Item>
                          <Item>run</Item>
                          <Item>shuffleLeft</Item>
                          <Item>shuffleRight</Item>
                        </forAnimations>
                        <play>walkIce</play>
                      </Item>
                    </animationsReplacements>
                    <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
                  </onTop>
                  <priority href="/Client/Priorieties/CreatureReplaceAnimationsAction/OverrideWeaponReplace.(PriorityResource).xdb#xpointer(/client.Replica.PriorityResource)" />
                  <replaceWhen>ReplaceAlways</replaceWhen>
                  <restartOnVisualChange>true</restartOnVisualChange>
                </Item>
                <Item type="client.Replica.CreatureDisableSpecialIdlesAction" />
              </elements>
              <play>Simultaneously</play>
              <preconditional>false</preconditional>
              <restartOnVisualChange>false</restartOnVisualChange>
              <stopOnDeath>false</stopOnDeath>
              <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </thenAction>
          </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>