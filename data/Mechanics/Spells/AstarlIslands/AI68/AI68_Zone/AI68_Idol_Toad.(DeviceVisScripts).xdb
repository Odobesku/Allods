<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>hit</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>hitCritical</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirected</Item>
				</animations>
			</action>
		</Item>
		<Item>
			<action type="DeviceAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>walk</Item>
				</animations>
			</action>
		</Item>
	</states>
</DeviceVisScripts>
