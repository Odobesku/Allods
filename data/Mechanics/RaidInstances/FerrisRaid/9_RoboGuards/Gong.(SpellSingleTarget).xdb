<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>222001</resourceId>
    </Header>
    <Name href="Gong.(SpellSingleTarget).Name.txt" />
    <Description href="Gong.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Quest/ZC6_science_device.(UISingleTexture).xdb" />
    <isExploit>true</isExploit>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>5</value>
    </range>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Everyone</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                                <ability href="RoboGuard1/RoboGuard1_Abilities1.(AbilityResource).xdb" />
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                                                <ability href="RoboGuard1/RoboGuard1_Abilities1.(AbilityResource).xdb" />
                                            </Item>
                                        </impactsIf>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.predicates.PredicateHasAbility">
                                                    <ability href="RoboGuards_HM_common.(AbilityResource).xdb" />
                                                </predicate>
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.elements.impacts.AttachAbility">
                                                <ability href="RoboGuards_HM_common.(AbilityResource).xdb" />
                                            </Item>
                                        </impactsIf>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                                <ability href="RoboGuard1/RoboGuard1_NoHM_death.(AbilityResource).xdb" />
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                                                <ability href="RoboGuard1/RoboGuard1_NoHM_death.(AbilityResource).xdb" />
                                            </Item>
                                        </impactsIf>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                                <ability href="/Mechanics/RaidInstances/FerrisRaid/Other/GuildExp_NoSpy.(AbilityResource).xdb" />
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                                                <ability href="/Mechanics/RaidInstances/FerrisRaid/Other/GuildExp_NoSpy.(AbilityResource).xdb" />
                                            </Item>
                                        </impactsIf>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                                        <table href="/Maps/FerrisRaid/SpawnTables/9_RoboBoss.(SpawnTable).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <spawnResource href="/Maps/FerrisRaid/SpawnTables/9_RoboGuards.(SpawnTable).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>