    <visScript href="BlueTeam_Vis.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/2ndCircle_Goblinoball_New/Zones/ArchipelagoGoblinoball/ArchipelagoGoblinoball.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="BlueTeam_Vis.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
            <tick>20000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                    <affectPets>false</affectPets>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                            <group href="/Mechanics/Spells/Groups/GobDressSet.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                    <affectPets>false</affectPets>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                                <buff href="BlueTeam_Vis.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                            </predicate>
                                                        </Item>
                                                    </predicates>
                                                    <impactsIf>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="BlueTeam_Vis.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                        </Item>
                                                    </impactsIf>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
