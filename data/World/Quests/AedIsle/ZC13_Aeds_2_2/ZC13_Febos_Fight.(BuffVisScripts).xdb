<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.CreatureReplaceAnimationsAction">
		<member>Default_Member</member>
		<onBottom>
			<animationsReplacements>
				<Item>
					<forAnimations>
						<Item>idle</Item>
						<Item>idle01</Item>
						<Item>idle02</Item>
						<Item>idle03</Item>
					</forAnimations>
					<play>readyUnarmed</play>
				</Item>
			</animationsReplacements>
			<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
		</onBottom>
		<onMount>
			<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
		</onMount>
		<onTop>
			<animationsReplacements>
				<Item>
					<forAnimations>
						<Item>idle</Item>
						<Item>idle01</Item>
						<Item>idle02</Item>
						<Item>idle03</Item>
					</forAnimations>
					<play>readyUnarmed</play>
				</Item>
			</animationsReplacements>
			<skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
		</onTop>
		<replaceWhen>ReplaceAlways</replaceWhen>
		<restartOnVisualChange>false</restartOnVisualChange>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>