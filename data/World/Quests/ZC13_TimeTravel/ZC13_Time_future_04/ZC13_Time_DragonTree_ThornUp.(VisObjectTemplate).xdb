<?xml version="1.0" encoding="UTF-8"?>
<VisObjectTemplate>
	<defaultState>
		<sound>
			<creationRadius>-1</creationRadius>
		</sound>
		<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
		<playSoundOnKeys>true</playSoundOnKeys>
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>0</fadeInMS>
	<fadeOutMS>0</fadeOutMS>
	<replaceDistance>-1</replaceDistance>
	<scale>1</scale>
	<sound>
		<creationRadius>-1</creationRadius>
	</sound>
	<visObjComponents>
		<Item type="client.SLON.AlignCollisionComponent">
			<VisualObjectComponentID>precast</VisualObjectComponentID>
			<endHeight>-5</endHeight>
			<offset x="0" y="0" z="0" />
			<scale>1</scale>
			<sphereRadius>0</sphereRadius>
			<startHeight>5</startHeight>
			<visObject href="/Spells/FX/Mobs/Gastornis_JumpHM_Crack.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
			<yaw>0</yaw>
			<alignNormal>true</alignNormal>
			<checkNormal>true</checkNormal>
			<fixedPosition>false</fixedPosition>
			<getPrevObjectHeight>false</getPrevObjectHeight>
			<lockScale>false</lockScale>
			<placeAlways>false</placeAlways>
		</Item>
		<Item type="client.Scene.DelayComponent">
			<component type="client.SLON.AlignCollisionComponent">
				<VisualObjectComponentID>precast</VisualObjectComponentID>
				<endHeight>-5</endHeight>
				<offset x="0" y="0" z="0" />
				<scale>1</scale>
				<sphereRadius>0</sphereRadius>
				<startHeight>5</startHeight>
				<visObject href="/Spells/FX/Mobs/UmoirRaid_PierBoss_SpikeUp.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<yaw>0</yaw>
				<alignNormal>true</alignNormal>
				<checkNormal>true</checkNormal>
				<fixedPosition>false</fixedPosition>
				<getPrevObjectHeight>false</getPrevObjectHeight>
				<lockScale>false</lockScale>
				<placeAlways>false</placeAlways>
			</component>
			<timeMax>1</timeMax>
			<timeMin>1</timeMin>
			<skipLoading>true</skipLoading>
		</Item>
		<Item type="client.Scene.DelayComponent">
			<component type="client.Scene.StopVisObjectComponents">
				<stopedComponentIDs>
					<Item>precast</Item>
				</stopedComponentIDs>
			</component>
			<timeMax>1.5</timeMax>
			<timeMin>1.5</timeMin>
			<skipLoading>true</skipLoading>
		</Item>
	</visObjComponents>
	<drawBehindCamera>false</drawBehindCamera>
	<softReplace>false</softReplace>
