<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>220650584</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/PaladinWeaponAttacks.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/DragonRelic5.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
	<element>PHYSICAL</element>
	<Name href="Spell.Name.txt" />
	<Description href="Spell.Description.txt" />
	<descVars>
		<Item>
			<name>min</name>
			<value var="avgDamage" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>WeaponScalerSpeedMin</formula>
			</scaler>
		</Item>
		<Item>
			<name>max</name>
			<value var="avgDamage" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>WeaponScalerSpeedMax</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Paladin/PaladinBlessedSword.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualScripts href="/Spells/VisScripts/Paladin/PurificationStrike.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<sysName />
	<range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
	<level>1</level>
	<prepareDuration>0</prepareDuration>
	<immutablePrepareDuration>false</immutablePrepareDuration>
	<needLos>true</needLos>
	<targetType>STTCurrentTarget</targetType>
	<isAggro>true</isAggro>
	<replaceLowRanks>true</replaceLowRanks>
	<isWorkOnDead>false</isWorkOnDead>
	<ranks>
		<Item href="Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
		<Item href="Spell02.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
		<Item href="Spell03.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>true</triggersGlobalCooldown>
	<ignoreGlobalCooldown>false</ignoreGlobalCooldown>
	<launchWhenReady>false</launchWhenReady>
	<needInFront>true</needInFront>
	<mechanics>
		<cooldown>
			<stage>Launch</stage>
			<duration>1</duration>
			<group href="" />
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.WeaponSpeedScaler" />
					<Item type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>1.5</multiplier>
					</Item>
				</scalers>
			</scaler>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateUsesWeapon">
				<hideText>false</hideText>
			</Item>
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceMana">
				<hideText>false</hideText>
				<mana>40</mana>
				<scaleByWeaponSpeed>true</scaleByWeaponSpeed>
				<source>Mainhand</source>
				<manaType>
					<Item>Energy</Item>
				</manaType>
			</Item>
		</casterResources>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
				<impactsOnHitTarget>
					<Item type="gameMechanics.elements.impacts.ImpactsIf">
						<predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
							<buff href="/Mechanics/Spells/PaladinV2/MarkBuff/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							<from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
						</predicate>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.BuffDetacher">
								<buff href="/Mechanics/Spells/PaladinV2/MarkBuff/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								<casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
							</Item>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="PuriDot.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</Item>
						</impactsIf>
					</Item>
				</impactsOnHitTarget>
				<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
				<avgDamage var="avgDamage" />
				<source>Mainhand</source>
			</Item>
		</targetImpacts>
	</mechanics>
	<isAE>false</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
