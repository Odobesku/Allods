<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
	<Header>
		<resourceId>739905346</resourceId>
	</Header>
	<persistentParts>
		<Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.EffectInZoneTracker">
					<buff href="Blue_Flag_Tracker.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					<activeZone href="/Maps/Domination04/Zones/Domination04/Domination.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
					<trackData href="/Mechanics/InstancedEventResource/MM_BG03/Golems/GolemBlue.(TrackDataResource).xdb#xpointer(/gameMechanics.world.avatar.TrackDataResource)" />
				</Item>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Blue_Flag_Tracker.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsOn>
				</Item>
				<Item type="gameMechanics.elements.effects.TickableAura">
					<affectGroup>All</affectGroup>
					<radius>5</radius>
					<filter type="gameMechanics.world.creature.AliveFilter" />
					<impactsIn>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
								<Item type="gameMechanics.battleground.map.PredicateBattleMemberMark">
									<mark href="/Maps/Domination04/Marks/BlueMark.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
								</Item>
								<Item type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.constructor.basicElements.PredicateOr">
										<predicates>
											<Item type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="Blue_Flag.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
											</Item>
											<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
												<groups>
													<Item href="/Mechanics/Spells/Groups/Escapes.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
													<Item href="/Mechanics/Spells/Groups/Shroud.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
												</groups>
											</Item>
										</predicates>
									</predicate>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ReturningImpactsGeneric">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="Blue_Flag.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
										<Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
											<variable href="/Mechanics/InstancedEventResource/MM_BG04/Blue_Flag_On_Base.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
											<summand>-1</summand>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
											<distributor type="gameMechanics.elements.calcers.ZoneDistributor">
												<zone type="gameMechanics.elements.calcers.ZoneDistributor$OwnZone" />
											</distributor>
											<data href="Blue_Flag_Stolen.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpactGeneric">
									<impacts>
										<Item type="gameMechanics.elements.device.DeviceDie" />
									</impacts>
								</Item>
							</impactsIf>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
								<Item type="gameMechanics.battleground.map.PredicateBattleMemberMark">
									<mark href="/Maps/Domination04/Marks/BlueMark.(BattlegroundPlayerSpawnPlace).xdb#xpointer(/gameMechanics.battleground.BattlegroundPlayerSpawnPlace)" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
											<zone href="FlagBlue.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.constructor.basicElements.ImpactNull" />
									</impactsIf>
									<impactsElse>
										<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
											<table href="/Maps/Domination04/SpawnTables/Blue_Flag.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
										</Item>
										<Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
											<variable href="/Mechanics/InstancedEventResource/MM_BG04/Blue_Flag_On_Base.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
											<summand>1</summand>
										</Item>
										<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
											<distributor type="gameMechanics.elements.calcers.ZoneDistributor">
												<zone type="gameMechanics.elements.calcers.ZoneDistributor$OwnZone" />
											</distributor>
											<data href="Blue_Flag_Returned.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
										</Item>
									</impactsElse>
								</Item>
							</impactsIf>
						</Item>
					</impactsIn>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.constructor.schemes.buff.BuffsResource" />
	</persistentParts>
	<name href="Blue_Flag.(SteleResource).Name.txt" />
	<visObj href="/Creatures/GolemJunes/GolemJunes.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<visScripts href="/Mechanics/InstancedEventResource/MM_BG03/Golems/Golem_Blue.(DeviceVisScripts).xdb#xpointer(/DeviceVisScripts)" />
	<corpseDuration>1</corpseDuration>
	<corpseEmptyDuration>1</corpseEmptyDuration>
</gameMechanics.world.device.SteleResource>
