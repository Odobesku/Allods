<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>221808</resourceId>
    </Header>
    <Name href="ColossusCleave.(SpellArea).Name.txt" />
    <visualScripts href="ColossusCleave.(SpellVisScripts).xdb" />
    <needLos>false</needLos>
    <targetType>STTPoint</targetType>
    <isAggro>false</isAggro>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>2000000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="CleaveRes.(BuffResource).xdb" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.RunImpactsInShape">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>ASTRAL</element>
                                <damage>20</damage>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                        </impactsIf>
                    </Item>
                </impacts>
                <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
                    <angle type="constructor.basicElements.AngleDegrees">
                        <value>20</value>
                    </angle>
                </shape>
                <affectGroup>Enemies</affectGroup>
                <radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
                    <value>85</value>
                </radius>
                <shapeCenterPosition>Caster</shapeCenterPosition>
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>80</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>