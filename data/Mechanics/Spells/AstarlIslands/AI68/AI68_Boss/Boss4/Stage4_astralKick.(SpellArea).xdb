<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>192513</resourceId>
    </Header>
    <Name href="Stage4_astralKick.(SpellArea).Name.txt" />
    <visualScripts href="Strike.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>500</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>30000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="CanShoot.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                <spell href="LaunchBullets.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="NoRays.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impacts>
                <spawnResource href="/Maps/AstralIsle68/SpawnTables/BossSpirit.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                <time>1000</time>
                <distance>30</distance>
            </Item>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>SHADOW</element>
                <damage>30</damage>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Hemisphere" />
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>10</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>