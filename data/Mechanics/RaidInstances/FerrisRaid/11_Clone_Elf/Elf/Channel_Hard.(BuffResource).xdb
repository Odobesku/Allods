    </Header>
    <Name href="Channel_Hard.(BuffResource).Name.txt" />
    <Description href="Channel_Hard.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageLightningBallsUpgrade.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="Channel_Hard.(VisObjectTemplate).xdb" />
            <locator>Slot_TopFX</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTargetGeneric">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Channel_Hard_Stack_Balada_Enrage.(BuffResource).xdb" />
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                            <spell href="Channel_Hard.(SpellSingleTarget).xdb" />
                            <duration>10000</duration>
                        </Item>
                    </impactsOff>
                </Item>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Channel_Hard_LightDebuf.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>LIGHTNING</element>
                                    <damage>7</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                    <initialDelay>1500</initialDelay>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>LIGHTNING</element>
                                    <damage>7</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                    <initialDelay>1500</initialDelay>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                                    <spell href="Channel_Hard.(SpellSingleTarget).xdb" />
                                    <duration>10000</duration>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOff>
                </Item>
            </effectsElse>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Channel_Hard_Stack_Balada.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAbility">
            <ability href="/Mechanics/Abilities/Creatures/CCImmunities/Ability.xdb" />
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
