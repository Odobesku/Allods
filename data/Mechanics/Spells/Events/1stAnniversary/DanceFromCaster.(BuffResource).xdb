<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>200700933</resourceId>
	</Header>
	<Name href="DanceFromCaster.txt" />
	<Description href="DanceFromCaster.Description.txt" />
	<image href="/Interface/Icons/Special/Emoticons/Moods/Cheerful.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visScript href="DanceFromCaster.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.predicates.PredicateUnlock">
								<unlock href="/Mechanics/Unlocks/EmoteAnniversaryUnlock.xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
							</predicate>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
							<unlock href="/Mechanics/Unlocks/EmoteAnniversaryUnlock.xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
							<quest href="/World/Quests/ZoneHadagan1/EventAnniversaryEmote/EventAnniversaryEmote.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
							<counterResource href="/World/Quests/ZoneHadagan1/EventAnniversaryEmote/LearnEmote.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
							<quest href="/World/Quests/ZoneLeague1/EventAnniversaryEmote_L/EventAnniversaryEmote_L.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
							<counterResource href="/World/Quests/ZoneLeague1/EventAnniversaryEmote_L/LearnEmote.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.constructor.basicElements.ImpactList">
					<impactsResource href="/Mechanics/Mounts/Prototypes/ExoAntiDismount.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
	</effects>
	<duration>300000</duration>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<ignoreLevelDelta>true</ignoreLevelDelta>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Events/EventBuffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
