    <image href="/Interface/Icons/Spells/Mage/MageHarmony.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/ReadySpellDirectLightningWand.(VisObjectTemplate).xdb" />
