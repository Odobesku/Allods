<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>224641</resourceId>
    </Header>
    <Name href="R7_Cleave_HM.(SpellArea).Name.txt" />
    <visualScripts href="R7_Cleave_Vis.(SpellVisScripts).xdb" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>25000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="R7_Cleave_HM.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>1000</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.RunImpactsInShape">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                        <element>PHYSICAL</element>
                                        <damage>20</damage>
                                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="R7_CleaveBleeding_HM.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="R7_Backstab.(BuffResource).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                        <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
                            <angle type="constructor.basicElements.AngleDegrees">
                                <value>20</value>
                            </angle>
                        </shape>
                        <affectGroup>Enemies</affectGroup>
                        <radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
                            <value>85</value>
                        </radius>
                        <shapeCenterPosition>Caster</shapeCenterPosition>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>45</value>
        </angle>
    </shape>
    <radius>80</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>