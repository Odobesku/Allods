<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>199871</resourceId>
    </Header>
    <Name href="HitLighting.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageLightningInstability.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/VisScripts/Bosses/TepPyramid/HitLighting_Buff.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="HitLighting.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>20</radius>
                    <affectGroup>Enemies</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>LIGHTNING</element>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier>0.3</multiplier>
                                </mulCalcer>
                            </scalerTarget>
                            <damage>1</damage>
                            <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>true</canBeSaved>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>