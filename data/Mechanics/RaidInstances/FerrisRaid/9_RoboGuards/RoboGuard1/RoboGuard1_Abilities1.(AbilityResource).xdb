<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>222147</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsToTargetSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard2/RoboGuard2.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/ClientData_voice/RoboGuards_ShieldOff.(ClientData).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>20000</delay>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.RandomImpact">
                                                    <entries>
                                                        <Item>
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactsToTargetSpawnTable">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                                            <predicates>
                                                                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                                                    <mobs>
                                                                                        <Item href="RoboGuard1.(MobWorld).xdb" />
                                                                                    </mobs>
                                                                                </Item>
                                                                            </predicates>
                                                                            <impactsIf>
                                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard_noHM_Defence.(BuffResource).xdb" />
                                                                                    <stacks type="gameMechanics.elements.calcers.FloatData">
                                                                                        <value>5</value>
                                                                                    </stacks>
                                                                                </Item>
                                                                            </impactsIf>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                        <Item>
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactsToTargetSpawnTable">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                                            <predicates>
                                                                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                                                    <mobs>
                                                                                        <Item href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard2/RoboGuard2.(MobWorld).xdb" />
                                                                                    </mobs>
                                                                                </Item>
                                                                            </predicates>
                                                                            <impactsIf>
                                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard_noHM_Defence.(BuffResource).xdb" />
                                                                                    <stacks type="gameMechanics.elements.calcers.FloatData">
                                                                                        <value>5</value>
                                                                                    </stacks>
                                                                                </Item>
                                                                            </impactsIf>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </entries>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>