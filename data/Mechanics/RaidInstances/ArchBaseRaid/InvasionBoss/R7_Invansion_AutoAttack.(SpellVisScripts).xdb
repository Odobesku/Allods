<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Ray.(SpellVisScripts).xdb" />
		<Variables>
			<Animation>spellCastDirected</Animation>
			<FXRay>/Spells/FX/Mobs/ArchitectBossCaster_SuffocateChannel.(VisObjectTemplate).xdb</FXRay>
			<RayLength>2</RayLength>
			<LocatorOnCaster>Slot_FX</LocatorOnCaster>
			<LocatorNameOnCaster />
			<LocatorOnTargets>Slot_FX</LocatorOnTargets>
			<LocatorNameOnTargets />
			<RayVelocity>0</RayVelocity>
			<MultyTargetMode>FromCaster</MultyTargetMode>
			<FXRaySecondary />
			<RaySecondaryLength>2</RaySecondaryLength>
			<RaySecondaryVelocity>0</RaySecondaryVelocity>
			<FXOnTarget>/Spells/FX/Mobs/ArchitectBossCaster_SuffocateHit.(VisObjectTemplate).xdb</FXOnTarget>
			<FXOnCaster>/Spells/FX/Mobs/ArchitectBossCaster_SuffocateHit.(VisObjectTemplate).xdb</FXOnCaster>
			<FXOnWand />
			<PreCastFX>/Spells/VisScripts/Prototypes/PreCastFXAstralWand.(CreatureVisActionResource).xdb</PreCastFX>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<stopIfRotated>true</stopIfRotated>
					<stopIfMoved>true</stopIfMoved>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<animationKeysAction />
					<animationKeysSound />
					<animationKeysActionPeriod />
					<turnToTarget>NO_TURN</turnToTarget>
					<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
				</advanced>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<startPoint type="VisPointLocator">
					<shift y="1" z="-1" />
				</startPoint>
			</Item>
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<offset y="1" z="-1" />
					</Item>
					<Item skiped="" />
					<Item>
						<effectFx href="/Spells/FX/Mobs/ReadySpell_Nihil_Damage_Lighting.(VisObjectTemplate).xdb" />
						<scale>1.8</scale>
						<locator>Slot_FX</locator>
						<offset y="1.3" z="-1.25" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<stopIfRotated>true</stopIfRotated>
					<stopIfMoved>true</stopIfMoved>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<animationKeysAction />
					<animationKeysSound />
					<animationKeysActionPeriod />
					<turnToTarget>NO_TURN</turnToTarget>
					<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
				</advanced>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<stopIfRotated>true</stopIfRotated>
					<stopIfMoved>true</stopIfMoved>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<animationKeysAction />
					<animationKeysSound />
					<animationKeysActionPeriod />
					<turnToTarget>NO_TURN</turnToTarget>
					<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
