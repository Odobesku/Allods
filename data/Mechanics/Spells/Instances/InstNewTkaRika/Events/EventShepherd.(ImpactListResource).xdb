<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>195351</resourceId>
    </Header>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactsToInterlocutor">
