<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CameraParametersAction">
				<parameters>
					<maxDistance>60</maxDistance>
				</parameters>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/WormGlacial_RiderBag.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Back_LC</locatorName>
					</Item>
					<Item>
						<effectFx href="/Creatures/EngineerGadgets/EngineerPlatform/EngineerPlatformHadagan.(VisObjectTemplate).xdb" />
						<scale>1.1</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_Global</locator>
						<offset x="0.3" y="0.1" z="-3" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readyUnarmed</Item>
				</animations>
				<channel>CHANNEL_DEATH</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
