<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739952392</resourceId>
	</Header>
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="R7_Invasion_Ray_Check.(BuffResource).xdb" />
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
					<impactsIn>
						<impactsFromCaster>
							<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
										<predicates>
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="R7_Ray_Attack_Def.(BuffResource).xdb" />
												</predicate>
											</Item>
											<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
										</predicates>
									</Item>
								</predicates>
								<impactsIf>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="R7_RayAttack_Stun_1.(BuffResource).xdb" />
									</Item>
								</impactsIf>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateAnd">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
											<Item type="gameMechanics.constructor.basicElements.PredicateNot">
												<predicate type="gameMechanics.elements.predicates.PredicateMobWorld">
													<mobs>
														<Item href="R7_InvasionBoss.(MobWorld).xdb" />
														<Item href="R7_InvasionBoss_HM.(MobWorld).xdb" />
													</mobs>
												</predicate>
											</Item>
										</predicates>
									</Item>
								</predicates>
								<impactsIf>
									<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
										<buff href="R7_Ray_Coloss_Stun.(BuffResource).xdb" />
									</Item>
								</impactsIf>
							</Item>
						</impactsFromCaster>
					</impactsIn>
					<minLength>1</minLength>
					<maxLength>85</maxLength>
					<reconnect>true</reconnect>
					<height>5</height>
					<width>1.5</width>
					<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateIsMob" />
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								</predicates>
							</Item>
						</predicates>
					</filter>
				</Item>
			</effectsIf>
		</Item>
	</effects>
	<duration>15000</duration>
	<isHelpful>true</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<isAE>true</isAE>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/RaidInstances/ArchBaseRaid/SiegeBoss/R7_ArchBase_Raid.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
