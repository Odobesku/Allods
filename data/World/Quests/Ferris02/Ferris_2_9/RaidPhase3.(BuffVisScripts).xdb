<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>special</play>
							<forAnimations>
								<Item>special02</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>special01</play>
							<forAnimations>
								<Item>special03</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>special</play>
							<forAnimations>
								<Item>special02</Item>
							</forAnimations>
						</Item>
						<Item>
							<play>special01</play>
							<forAnimations>
								<Item>special03</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
