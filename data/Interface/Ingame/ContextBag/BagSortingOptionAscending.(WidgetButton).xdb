<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>Button</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <Pos>20</Pos>
            <Size>50</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <Size>50</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>option_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>false</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>value</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextBag/BagSortingOptionHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="1"/>
            <Reaction>option_pressed</Reaction>
            <ReactionRightClick>option_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextBag/BagSortingOptionNormal.txt"/>
            </StateNormal>
            <StatePushed>
                <FormatFileRef href="/Interface/Ingame/ContextBag/BagSortingOptionPressed.txt"/>
                <LayerMain href="/Interface/Ingame/ContextBag/BagSortingOptionToggled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextBag/BagSortingOptionPressed.txt"/>
            </StatePushedHighlighted>
            <TextFileRef href="/Interface/Ingame/ContextBag/BagSortingOptionAscending.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextBag/BagSortingOptionHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="1"/>
            <Reaction>option_pressed</Reaction>
            <ReactionRightClick>option_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextBag/BagSortingOptionToggled.txt"/>
                <LayerMain href="/Interface/Ingame/ContextBag/BagSortingOptionToggled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <FormatFileRef href="/Interface/Ingame/ContextBag/BagSortingOptionPressed.txt"/>
            </StatePushed>
            <StatePushedHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextBag/BagSortingOptionPressed.txt"/>
            </StatePushedHighlighted>
            <TextFileRef href="/Interface/Ingame/ContextBag/BagSortingOptionAscending.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
