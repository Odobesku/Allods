<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>Ambience/ShipsAmbience/RegularShipsAmbience</name>
				</sound>
				<forcedSoundStop>true</forcedSoundStop>
				<actionType>AmbientOutdoor</actionType>
				<reverbPreset>
					<project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>ghost</name>
				</reverbPreset>
				<onlyForMainAvatar>true</onlyForMainAvatar>
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Music/Music.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>Music/RegularShipsMusic/RegularShips</name>
				</sound>
				<forcedSoundStop>true</forcedSoundStop>
				<actionType>Music</actionType>
				<onlyForMainAvatar>true</onlyForMainAvatar>
			</Item>
		</elements>
	</action>
	<postAction type="Sound2DAction">
		<actionType>Music</actionType>
		<onlyForMainAvatar>true</onlyForMainAvatar>
	</postAction>
	<restartOnIncStackCount>true</restartOnIncStackCount>
</BuffVisScripts>
