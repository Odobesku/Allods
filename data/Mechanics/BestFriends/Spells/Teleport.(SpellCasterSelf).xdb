<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>358925322</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Teleporters.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
	<Name href="Teleport.txt" />
	<Description href="Teleport.Description.txt" />
	<image href="/Interface/Icons/Misc/Unlocks/UnlockPortal.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualScripts href="/Spells/VisScripts/Common/Teleportation.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>15000</prepareDuration>
	<targetType>STTSelf</targetType>
	<isWorkOnDead>false</isWorkOnDead>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>false</ignoreGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>1800000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
				<key href="/System/ContentKeys/BestFriends.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactTeleportToBestFriend">
				<friendIndex type="gameMechanics.elements.calcers.CalcerLongParam">
					<paramName>friendIndex</paramName>
				</friendIndex>
				<impactsOnSucces>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="/Mechanics/BestFriends/Buffs/AfterTeleportBuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</impactsOnSucces>
				<impactsOnFail>
					<Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
						<spell href="Teleport.(SpellCasterSelf).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
					</Item>
				</impactsOnFail>
			</Item>
		</casterImpacts>
	</mechanics>
	<params>
		<params>
			<Item>
				<name>friendIndex</name>
				<type>Int</type>
			</Item>
		</params>
	</params>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
	<iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
