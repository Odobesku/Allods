                    <buff href="/Mechanics/Spells/CommonBuffs/Immunity/CrowdControlImmunity.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
            <impactsOff>
