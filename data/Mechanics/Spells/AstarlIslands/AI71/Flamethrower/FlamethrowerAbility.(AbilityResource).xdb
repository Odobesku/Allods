<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739935244</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatStamina" />
            <multiplier>1.5</multiplier>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectAggroListMembers">
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="AvatarTargets.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.StackBuff">
                            <buff href="AvatarTargets.(BuffResource).xdb" />
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>-1</value>
                            </delta>
                        </Item>
                    </impacts>
                </Item>
            </impactsOut>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>