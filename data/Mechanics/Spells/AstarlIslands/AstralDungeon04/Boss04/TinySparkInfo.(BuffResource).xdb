<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739951944</resourceId>
	</Header>
	<Name href="TinySparkInfo.(BuffResource).Name.txt" />
	<Description href="TinySparkInfo.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Buffs/BuffURGoldenSpark.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<delay>100</delay>
			<effectFx href="/Spells/FX/Spells/VoidGood_R10.(VisObjectTemplate).xdb" />
			<lockScale>true</lockScale>
			<scale>0.25</scale>
			<locator>Slot_Global</locator>
			<offset x="-0.05" y="-0.21" />
		</Item>
	</visualEffects>
	<visualPostEffects>
		<Item>
			<effectFx href="/Spells/FX/Mobs/Gastornis_SpellCastSummonAoe.(VisObjectTemplate).xdb" />
			<lockScale>true</lockScale>
			<scale>1.5</scale>
			<locator>Slot_Global</locator>
		</Item>
		<Item>
			<effectFx href="/Spells/FX/Mobs/Gastornis_SpellCastSummonAoe.(VisObjectTemplate).xdb" />
			<lockScale>true</lockScale>
			<scale>1.5</scale>
			<locator>Slot_Global</locator>
		</Item>
	</visualPostEffects>
	<effects>
		<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.75</coeff>
			</scaler>
			<predicates>
				<Item type="gameMechanics.elements.predicates.offender.PredicateNot">
					<predicate type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
				</Item>
			</predicates>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>8</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="AOEDebuff.(BuffResource).xdb" />
						</Item>
					</impacts>
					<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
									</Item>
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								</predicates>
							</Item>
							<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
						</predicates>
					</filter>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="TinySparkInfo.(BuffResource).xdb" />
				</Item>
			</impacts>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
