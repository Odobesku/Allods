            <visObject href="/Mechanics/Spells/AstarlIslands/AI57_UI05/AI57_Reuse/AI57_Boss1/AI57_Boss1_DanceFirePuddle_Decal.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
