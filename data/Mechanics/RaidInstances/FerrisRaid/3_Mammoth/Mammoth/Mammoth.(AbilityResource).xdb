<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>223220</resourceId>
    </Header>
    <name href="Mammoth.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Phase1.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactMapVariableClearSave" />
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactMapVariableAddSave" />
                                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                                            <zone href="/Maps/FerrisRaid/Zones/RaidFerris01_MamoothCave.(ZoneResource).xdb" />
                                                        </Item>
                                                    </predicates>
                                                    <impactsElse>
                                                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                                            <destination type="gameMechanics.map.destination.DestinationLocatorSpread">
                                                                <locator>
                                                                    <scriptID>FR_3_loc</scriptID>
                                                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                                </locator>
                                                                <horizontalSpread>5</horizontalSpread>
                                                            </destination>
                                                        </Item>
                                                    </impactsElse>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/TepPyramidBosses/Spy.(BuffResource).xdb" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                                    <group href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactMapVariableClearSave" />
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                    <spawnResource href="HM_Phase2.(SpawnTable).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                    <table href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Champions/Champions.(SpawnTable).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                    <table href="Altar/Altar_Small.(SpawnTable).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                                    <table href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Gong.(SpawnTable).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                    <spawn>
                                        <scriptID>33_kit1</scriptID>
                                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                    </spawn>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                    <spawn>
                                        <scriptID>33_kit2</scriptID>
                                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                    </spawn>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                    <spawn>
                                        <scriptID>33_kit3</scriptID>
                                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                    </spawn>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/Spells/TepPyramidBosses/Spy.(BuffResource).xdb" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="HM_Phase2.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                    <group href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                    <id href="/World/Quests/FerrisRaid/FR_Q03/Quest03.(QuestCountId).xdb" />
                                    <ignoreMaxGroupShareLootRadius>true</ignoreMaxGroupShareLootRadius>
                                    <targetAvatarOnly>true</targetAvatarOnly>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                    <table href="Altar/Altar_Small.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                    <table href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Gong.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                                            <variable href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Mammoth.(MapVariableResource).xdb" />
                                            <summand>1</summand>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactMapVariableClearSave" />
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                                            <device>
                                                <scriptID>3_chest_hm</scriptID>
                                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                            </device>
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                                            <device>
                                                <scriptID>3_chest</scriptID>
                                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                            </device>
                                        </Item>
                                    </impactsElse>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                                                    <device>
                                                        <scriptID>FR2_Portal</scriptID>
                                                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                    </device>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>33_kit1</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>33_kit3</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>33_kit2</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>FR2_Portal</scriptID>
                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                    </device>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
            <impactsToTarget>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/RaidInstances/Tank.(BuffResource).xdb" />
                </Item>
            </impactsToTarget>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
            <quality href="Mammoth.(MobStatQuality).xdb" />
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>