<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.battleground.BattleEventMapMechanics>
    <Header>
        <resourceId>242410</resourceId>
    </Header>
    <score href="MM_Football.(BattleEventAchievementResource).xdb" />
    <mechanicsType>FOOTBALL</mechanicsType>
    <map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
    <waitBuff href="FootballWait.(BuffResource).xdb" />
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.MapHeadSpawnTableObjects">
            <table href="/Maps/2ndCircle_Goblinoball_New/SpawnTables/ArchipelagoGoblinoball/Goblinoball/SlimeBall_Out.(SpawnTable).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactResetBuffDuration">
                            <buff href="/Mechanics/Spells/QuestSpells/Football_New/RedTeam.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactResetBuffDuration">
                            <buff href="/Mechanics/Spells/QuestSpells/Football_New/BlueTeam.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </impactsOnStart>
    <impactsOnTimeout>
        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
            <predicates>
                <Item type="gameMechanics.map.variables.PredicateMapVariableEqualsGeneric">
                    <variableResource href="/Mechanics/Spells/QuestSpells/Football_New/FootballDrawVariable.(MapVariableResource).xdb" />
                    <expectedValue type="gameMechanics.elements.calcers.FloatData">
                        <value>1</value>
                    </expectedValue>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactFinishInstancedEventGeneric" />
            </impactsIf>
            <impactsElse>
                <Item type="avatarPopulation.service.impl.matchMakingImpl.eventType.marked.ImpactCompareAchievementsGeneric">
                    <firstMark href="/Maps/2ndCircle_Goblinoball_New/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
                    <secondMark href="/Maps/2ndCircle_Goblinoball_New/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
                    <achievement href="MM_Football.(BattleEventAchievementResource).xdb" />
                    <impactsOnGreater>
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactFinishInstancedEventGeneric" />
                    </impactsOnGreater>
                    <impactsOnEqual>
                        <Item type="gameMechanics.map.variables.ImpactMapVariableSummandGeneric">
                            <variable href="/Mechanics/Spells/QuestSpells/Football_New/FootballDrawVariable.(MapVariableResource).xdb" />
                            <summand>1</summand>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                            <data href="/Mechanics/Spells/QuestSpells/Football_New/MoreTimeAnnounce.(ClientData).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactShiftRoundDuration">
                            <shift type="gameMechanics.elements.calcers.TimeStampCalcer">
                                <value>
                                    <minute>2</minute>
                                </value>
                            </shift>
                        </Item>
                    </impactsOnEqual>
                    <impactsOnLesser>
                        <Item type="avatarPopulation.service.impl.matchMakingImpl.map.ImpactFinishInstancedEventGeneric" />
                    </impactsOnLesser>
                </Item>
            </impactsElse>
        </Item>
    </impactsOnTimeout>
    <startAnnounce href="/Mechanics/Spells/QuestSpells/Football_New/StartAnnounce.(ClientData).xdb" />
    <impactsOnAvatars>
        <Item type="gameMechanics.elements.impacts.ImpactsIf">
            <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                <onMaster type="gameMechanics.battleground.map.PredicateBattleMemberMark">
                    <mark href="/Maps/2ndCircle_Goblinoball_New/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
                </onMaster>
            </predicate>
            <impactsIf>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/QuestSpells/Football_New/RedTeam.(BuffResource).xdb" />
                </Item>
            </impactsIf>
            <impactsElse>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/QuestSpells/Football_New/BlueTeam.(BuffResource).xdb" />
                </Item>
            </impactsElse>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
            <group href="/Mechanics/Spells/Groups/SpeedBoosts.xdb" />
        </Item>
        <Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellGroupDeactivate">
            <group href="/Mechanics/Spells/Groups/SpeedBoosts.xdb" />
        </Item>
    </impactsOnAvatars>
    <assignWinnerOnDraw>false</assignWinnerOnDraw>
    <roundsCount>0</roundsCount>
    <shootdownOnTimeout>false</shootdownOnTimeout>
    <impactsOnEarlyExit>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="/Mechanics/Spells/QuestSpells/Football_New/RedTeam.(BuffResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="/Mechanics/Spells/QuestSpells/Football_New/BlueTeam.(BuffResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="/Mechanics/Spells/QuestSpells/Football_New/BlueGoalkeeper_Spells.(BuffResource).xdb" />
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
            <buff href="/Mechanics/Spells/QuestSpells/Football_New/RedGoalkeeper_Spells.(BuffResource).xdb" />
        </Item>
    </impactsOnEarlyExit>
    <entrances>
        <Item>
            <mark href="/Maps/2ndCircle_Goblinoball_New/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
            <entrances>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>RedTeamEntryPoint</scriptID>
                        <map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>-45</value>
                    </yaw>
                </Item>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>RedTeamEntryPoint1</scriptID>
                        <map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>-45</value>
                    </yaw>
                </Item>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>RedTeamEntryPoint2</scriptID>
                        <map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>-45</value>
                    </yaw>
                </Item>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>RedTeamEntryPoint3</scriptID>
                        <map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>-45</value>
                    </yaw>
                </Item>
            </entrances>
        </Item>
        <Item>
            <mark href="/Maps/2ndCircle_Goblinoball_New/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
            <entrances>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>BlueTeamEntryPoint</scriptID>
                        <map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>135</value>
                    </yaw>
                </Item>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>BlueTeamEntryPoint1</scriptID>
                        <map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>135</value>
                    </yaw>
                </Item>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>BlueTeamEntryPoint2</scriptID>
                        <map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>135</value>
                    </yaw>
                </Item>
                <Item type="mapLoader.pointer.MapPointerPos">
                    <pointer>
                        <scriptID>BlueTeamEntryPoint3</scriptID>
                        <map href="/Maps/2ndCircle_Goblinoball_New/MapResource.xdb" />
                    </pointer>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>135</value>
                    </yaw>
                </Item>
            </entrances>
        </Item>
    </entrances>
    <prepareTime>
        <minute>1</minute>
    </prepareTime>
    <duration>
        <minute>10</minute>
    </duration>
    <achievements>
        <Item>
            <showInTable>true</showInTable>
            <resource href="MM_Football.(BattleEventAchievementResource).xdb" />
            <weight>1</weight>
            <finalWeight>1</finalWeight>
        </Item>
        <Item>
            <showInTable>true</showInTable>
            <resource href="FootStrikeAchievement.(BattleEventAchievementResource).xdb" />
        </Item>
        <Item>
            <showInTable>true</showInTable>
            <resource href="FootKeeperAchievement.(BattleEventAchievementResource).xdb" />
        </Item>
        <Item>
            <showInTable>true</showInTable>
            <resource href="FootStrikeGoal.(BattleEventAchievementResource).xdb" />
        </Item>
    </achievements>
</gameMechanics.battleground.BattleEventMapMechanics>