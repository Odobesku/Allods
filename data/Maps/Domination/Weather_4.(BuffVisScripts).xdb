<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="WeatherCreatureVisAction">
				<params>
					<light>
						<FogStart>0</FogStart>
						<FogEnd>70</FogEnd>
						<AmbientColor>2013284490</AmbientColor>
						<FogColor>2014850596</FogColor>
					</light>
					<hasLight>true</hasLight>
					<ambientSoundImpact>Stop</ambientSoundImpact>
				</params>
			</Item>
			<Item type="Sound2DAction">
				<sound>
					<project href="/SFX/Music/Music.(FMODProject).xdb#xpointer(/FMODProject)" />
					<name>Music/AdaptiveMusic/Infiltration</name>
				</sound>
				<actionType>Music</actionType>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
