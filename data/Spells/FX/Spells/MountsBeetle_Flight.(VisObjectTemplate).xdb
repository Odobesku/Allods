<?xml version="1.0" encoding="UTF-8"?>
<VisObjectTemplate>
	<defaultState>
		<sound>
			<creationRadius>-1</creationRadius>
			<project href="" />
		</sound>
		<allowMultipleSoundInstances>false</allowMultipleSoundInstances>
		<playSoundOnKeys>true</playSoundOnKeys>
		<animation href="" />
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>250</fadeInMS>
	<fadeOutMS>300</fadeOutMS>
	<geometry href="MountsBeetle_Flight.(Geometry).xdb#xpointer(/Geometry)" />
	<particle href="MountsBeetle_Flight.(ParticleAnimation).xdb#xpointer(/ParticleAnimation)" />
	<questHighlight href="" />
	<replaceDistance>-1</replaceDistance>
	<replacement href="" />
	<scale>1</scale>
	<sound>
		<creationRadius>-1</creationRadius>
		<name>spells/Mount/MountCarpetPlane/WindOfHaste</name>
		<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
	</sound>
	<visObjComponents>
		<Item type="client.VisualConstructor.ChainAnimatorComponent">
			<chains>
				<Item>
					<gravity x="0" y="0" z="0" />
