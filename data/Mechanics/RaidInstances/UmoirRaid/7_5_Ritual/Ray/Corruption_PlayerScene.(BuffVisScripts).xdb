<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<playWhile />
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>ready</Item>
						</animations>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>specialIdleStart</Item>
						</animations>
						<channel>CHANNEL_ABILITY</channel>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>specialIdle</Item>
						</animations>
						<channel>CHANNEL_ABILITY</channel>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<playWhile type="VisActionDelay">
					<time>10000</time>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/SarnAngelUmoir_LightDarkHit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<locator>Slot_FX</locator>
								<offendTime />
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Mobs/SarnAngelUmoir_LightDarkHit_Part.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<locator>Slot_FX</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
