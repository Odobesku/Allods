<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound/>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>500</fadeInMS>
    <fadeOutMS>500</fadeOutMS>
    <geometry href="/Spells/FX/Mobs/Danas_FirePuddle.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)"/>
    <particle href="/Spells/FX/Mobs/Danas_FirePuddle.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)"/>
    <scale>2</scale>
    <sound>
        <name>/spells/FX/World/Tka-Rika_SmallStatue_Fire</name>
        <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)"/>
    </sound>
    <states>
        <Item>
            <sound/>
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/Mobs/Danas_FirePuddle.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)"/>
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>
