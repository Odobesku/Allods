                            <value>151</value>
                        </yaw>
                    </destination>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="SwarmBoss_Animation.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <object href="/Mechanics/RaidInstances/FerrisRaid/14_PvtSwarm/Boss/CutScene_Swarm.(MobWorld).xdb" />
                    <pool href="CutScenePool.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/World/Quests/Ferris_indoor/Ferris_3_4_2/Swarm_Sub_4.1.(ClientData).xdb" />
                </Item>
