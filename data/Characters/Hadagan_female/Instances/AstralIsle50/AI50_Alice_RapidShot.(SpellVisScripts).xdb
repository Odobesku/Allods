<?xml version ="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarComplite type="VisActionStopAction">
        <visActionID></visActionID>
        <stoppedActionID>RapidFire</stoppedActionID>
    </actionBarComplite>
    <actionBarStart type="VisActionList">
        <visActionID>RapidFire</visActionID>
        <elements>
            <Item type="VisActionLoopAction">
                <visActionID></visActionID>
                <actionToLoop type="VisActionList">
                    <visActionID></visActionID>
                    <elements>
                        <Item type="CreatureAnimationAction">
                            <visActionID></visActionID>
                            <advanced>
                                <animationKeysAction>
                                    <Item>
                                        <action type="CreatureTakeArrowAction">
                                            <visActionID>TakeArrow</visActionID>
                                            <enchantedArrowIndex>0</enchantedArrowIndex>
                                            <rorate>NONE</rorate>
                                            <forceTakeInHand>false</forceTakeInHand>
                                        </action>
                                        <stopIfAnimationStoped>true</stopIfAnimationStoped>
                                    </Item>
                                    <Item>
                                        <action type="VisActionList">
                                            <visActionID></visActionID>
                                            <elements>
                                                <Item type="CreatureItemAnimationAction">
                                                    <visActionID></visActionID>
                                                    <animation>special</animation>
                                                    <idleAnimation>idle</idleAnimation>
                                                    <itemsSlot>RANGED</itemsSlot>
                                                    <mode>CLAMP</mode>
                                                </Item>
                                                <Item type="CreatureTakeBowStringAction">
                                                    <visActionID>AttachString</visActionID>
                                                    <creatureLocator>Slot_Hand_R</creatureLocator>
                                                    <creatureLocatorName></creatureLocatorName>
                                                    <itemLocatorName>Slot_String</itemLocatorName>
                                                    <itemsSlot>RANGED</itemsSlot>
                                                    <member>Assaulter</member>
                                                </Item>
                                                <Item type="Sound3DAction">
                                                    <visActionID></visActionID>
                                                    <sound>
                                                        <name>spells/Stalker/StalkerArrowPull</name>
                                                        <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)"/>
                                                    </sound>
                                                    <forcedSoundStop>false</forcedSoundStop>
                                                    <onlyForMainAvatar>false</onlyForMainAvatar>
                                                </Item>
                                            </elements>
                                            <play>Simultaneously</play>
                                            <preconditional>false</preconditional>
                                            <restartOnVisualChange>false</restartOnVisualChange>
                                            <stopOnDeath>false</stopOnDeath>
                                            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                                        </action>
                                        <stopIfAnimationStoped>true</stopIfAnimationStoped>
                                    </Item>
                                    <Item>
                                        <action type="VisActionList">
                                            <visActionID></visActionID>
                                            <elements>
                                                <Item type="VisActionList">
                                                    <visActionID></visActionID>
                                                    <elements>
                                                        <Item type="VisActionStopAction">
                                                            <visActionID></visActionID>
                                                            <stoppedActionID>AttachString</stoppedActionID>
                                                        </Item>
                                                        <Item type="VisActionStopAction">
                                                            <visActionID></visActionID>
                                                            <stoppedActionID>TakeArrow</stoppedActionID>
                                                        </Item>
                                                        <Item type="CreatureItemAnimationAction">
                                                            <visActionID></visActionID>
                                                            <animation>attack</animation>
                                                            <idleAnimation>idle</idleAnimation>
                                                            <itemsSlot>RANGED</itemsSlot>
                                                            <mode>DIE</mode>
                                                        </Item>
                                                        <Item type="CreatureThrowArrowAction">
                                                            <visActionID></visActionID>
                                                            <additionalEffectFx href="/Spells/FX/Weapon/ArrowRapidFireTrail.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                                                            <arrowInTargetTime>5000</arrowInTargetTime>
                                                            <effectBone>Slot_FX</effectBone>
                                                            <enchantedArrowIndex>0</enchantedArrowIndex>
                                                            <fixedThrowDuration>500</fixedThrowDuration>
                                                            <offendTime type="EffectOffendConstDelay">
                                                                <delay>0</delay>
                                                            </offendTime>
                                                            <pointInTargetMax>0.7</pointInTargetMax>
                                                            <pointInTargetMin>0.5</pointInTargetMin>
                                                            <theGe>10</theGe>
                                                            <useMeleeWeapon>false</useMeleeWeapon>
                                                            <usePointInArrow>true</usePointInArrow>
                                                        </Item>
                                                        <Item type="Sound3DAction">
                                                            <visActionID></visActionID>
                                                            <sound>
                                                                <name>spells/Stalker/StalkerArrowShot</name>
                                                                <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)"/>
                                                            </sound>
                                                            <forcedSoundStop>false</forcedSoundStop>
                                                            <onlyForMainAvatar>false</onlyForMainAvatar>
                                                        </Item>
                                                    </elements>
                                                    <play>Simultaneously</play>
                                                    <preconditional>false</preconditional>
                                                    <restartOnVisualChange>false</restartOnVisualChange>
                                                    <stopOnDeath>false</stopOnDeath>
                                                    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                                                </Item>
                                            </elements>
                                            <play>InSequence</play>
                                            <preconditional>false</preconditional>
                                            <restartOnVisualChange>false</restartOnVisualChange>
                                            <stopOnDeath>false</stopOnDeath>
                                            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                                        </action>
                                        <stopIfAnimationStoped>true</stopIfAnimationStoped>
                                    </Item>
                                </animationKeysAction>
                                <autoHasten>
                                    <mode>AUTOHASTEN_NONE</mode>
                                    <timeToBeLeft>0</timeToBeLeft>
                                </autoHasten>
                                <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                                <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                                <offendType>NO_OFFEND</offendType>
                                <turnToTarget>BEFORE_ANIMATIONEND</turnToTarget>
                                <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                                <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
                                <denyAutoHasten>false</denyAutoHasten>
                                <disableRandomFirstFrame>true</disableRandomFirstFrame>
                                <eventPlaybackEnd>false</eventPlaybackEnd>
                                <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                                <stopIfMoved>false</stopIfMoved>
                                <stopIfRotated>false</stopIfRotated>
                            </advanced>
                            <channel>CHANNEL_ABILITY</channel>
                            <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                            <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                            <mode>DIE</mode>
                            <specialController></specialController>
                            <use>USE_CURRENT_RANGED_RAPIDFIRE</use>
                            <dontFreezePrecast>false</dontFreezePrecast>
                        </Item>
                    </elements>
                    <play>Simultaneously</play>
                    <preconditional>false</preconditional>
                    <restartOnVisualChange>false</restartOnVisualChange>
                    <stopOnDeath>false</stopOnDeath>
                    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                </actionToLoop>
                <repeat>0</repeat>
            </Item>
            <Item type="VisActionList">
                <visActionID></visActionID>
                <elements>
                    <Item type="VisActionDelay">
                        <visActionID></visActionID>
                        <time>700</time>
                    </Item>
                    <Item type="VisActionLoopAction">
                        <visActionID></visActionID>
                        <actionToLoop type="VisActionList">
                            <visActionID></visActionID>
                            <elements>
                                <Item type="CreatureEffectsOnTarget">
                                    <visActionID></visActionID>
                                    <category>EFFECT_DEFAULT</category>
                                    <visualEffects>
                                        <Item>
                                            <delay>0</delay>
                                            <effectAnimations>
                                                <mode>DIE</mode>
                                            </effectAnimations>
                                            <effectFx href="/Spells/FX/Spells/WarriorCleave_Hit.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                                            <fadeInTime>0</fadeInTime>
                                            <fadeOutTime>0</fadeOutTime>
                                            <scale>1</scale>
                                            <fixPoint>true</fixPoint>
                                            <lockScale>false</lockScale>
                                            <muteFxSounds>true</muteFxSounds>
                                            <ignoreParentRotation>false</ignoreParentRotation>
                                            <locator>Slot_FX</locator>
                                            <locatorName></locatorName>
                                            <member>Default_Member</member>
                                            <offset x="0" y="0" z="0"/>
                                            <rotation x="0" y="0" z="0" w="0"/>
                                            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                                        </Item>
                                        <Item>
                                            <delay>0</delay>
                                            <effectAnimations>
                                                <mode>DIE</mode>
                                            </effectAnimations>
                                            <effectFx href="/Spells/FX/Spells/HitMelee.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                                            <fadeInTime>0</fadeInTime>
                                            <fadeOutTime>0</fadeOutTime>
                                            <scale>1</scale>
                                            <fixPoint>true</fixPoint>
                                            <lockScale>false</lockScale>
                                            <muteFxSounds>true</muteFxSounds>
                                            <ignoreParentRotation>false</ignoreParentRotation>
                                            <locator>Slot_FX</locator>
                                            <locatorName></locatorName>
                                            <member>Default_Member</member>
                                            <offset x="0" y="0" z="0"/>
                                            <rotation x="0" y="0" z="0" w="0"/>
                                            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                                        </Item>
                                    </visualEffects>
                                    <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                                    <stopOnDeath>false</stopOnDeath>
                                    <direction></direction>
                                </Item>
                            </elements>
                            <play>Simultaneously</play>
                            <playWhile type="VisActionDelay">
                                <visActionID></visActionID>
                                <time>500</time>
                            </playWhile>
                            <preconditional>false</preconditional>
                            <restartOnVisualChange>false</restartOnVisualChange>
                            <stopOnDeath>false</stopOnDeath>
                            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                        </actionToLoop>
                        <repeat>0</repeat>
                    </Item>
                </elements>
                <play>InSequence</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </actionBarStart>
    <precastType>PRECAST_DEFAULT</precastType>
    <launch type="CreatureEffectsOnTarget">
        <visActionID></visActionID>
        <category>EFFECT_DEFAULT</category>
        <visualEffects>
            <Item>
                <delay>0</delay>
                <effectAnimations>
                    <mode>DIE</mode>
                </effectAnimations>
                <effectFx href="/Spells/FX/Spells/WarriorGrind_Hit.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                <fadeInTime>0</fadeInTime>
                <fadeOutTime>0</fadeOutTime>
                <scale>0.7</scale>
                <fixPoint>true</fixPoint>
                <lockScale>false</lockScale>
                <muteFxSounds>true</muteFxSounds>
                <ignoreParentRotation>false</ignoreParentRotation>
                <locator>Slot_FX</locator>
                <locatorName></locatorName>
                <member>Default_Member</member>
                <offendTime type="EffectOffendConstDelay">
                    <delay>0</delay>
                </offendTime>
                <offset x="0" y="0" z="0"/>
                <rotation x="0" y="0" z="0" w="0"/>
                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
            </Item>
        </visualEffects>
        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
        <stopOnDeath>false</stopOnDeath>
        <direction></direction>
    </launch>
    <ownKillingParams>
        <probabilityNoOverkill>0.2</probabilityNoOverkill>
        <probabilityWithOverkill>1</probabilityWithOverkill>
    </ownKillingParams>
    <playOnTargets>
        <skipBloodFx>false</skipBloodFx>
        <skipHitAnimations>false</skipHitAnimations>
    </playOnTargets>
    <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>
