<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739974852</resourceId>
	</Header>
	<image href="/Interface/Icons/Spells/ReductionTreatment.(UISingleTexture).xdb" />
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
							<buff href="MiasmBuff.(BuffResource).xdb" />
							<range>
								<max>1</max>
							</range>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="MiasmMutationStrengthen.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="MiasmMutationStrengthen.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.StackBuff">
							<buff href="MiasmBuff.(BuffResource).xdb" />
							<delta type="gameMechanics.elements.calcers.FloatData">
								<value>-1</value>
							</delta>
						</Item>
					</impactsElse>
				</Item>
			</impacts>
			<initialDelay>2000</initialDelay>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
