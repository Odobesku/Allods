<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <objects>
            <Item>
                <locatorName>VisualSceneNode</locatorName>
                <visObject href="/Spells/FX/World/Astral_ObjectShiningGlow.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
            </Item>
        </objects>
        <sound/>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>500</fadeInMS>
    <fadeOutMS>500</fadeOutMS>
    <geometry href="/Spells/FX/World/Astral_ObjectShining.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)"/>
    <scale>1</scale>
    <sound/>
    <states>
        <Item>
            <sound/>
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/World/Astral_ObjectShining.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)"/>
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>
