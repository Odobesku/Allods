<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739911001</resourceId>
    </Header>
    <Name href="CannonBall.(SpellSingleTarget).Name.txt" />
    <visualScripts href="CannonBall.(SpellVisScripts).xdb" />
    <prepareDuration>4000</prepareDuration>
    <mechanics>
        <cooldown>
            <duration>1000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>10</radius>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>ASTRAL</element>
                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mul>-1</mul>
                            <mulCalcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                <buff href="/Mechanics/RaidInstances/FerrisRaid/13_Portal/Defender/PowerShield/PowerShieldBuff.(BuffResource).xdb" />
                            </mulCalcer>
                            <sum>1</sum>
                        </scalerTarget>
                        <damage>30</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </impacts>
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                </filter>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>15</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>