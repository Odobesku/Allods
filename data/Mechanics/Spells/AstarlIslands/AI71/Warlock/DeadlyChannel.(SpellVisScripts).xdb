<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Spells/TrinketChannelShadow.(VisObjectTemplate).xdb" />
                <startPoint type="VisPointLocator">
                    <locator>Slot_Hand_R</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </endPoint>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
                <advanced>
                    <speed>0.4</speed>
                </advanced>
            </Item>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/TrinketChannelShadow_Hit.(VisObjectTemplate).xdb" />
                        <locator>Slot_FX</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/TrinketChannelShadow_Hit.(VisObjectTemplate).xdb" />
                        <scale>0.575</scale>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
</SpellVisScripts>