<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739895103</resourceId>
	</Header>
	<Name href="ForcePush.(SpellArea).Name.txt" />
	<visualScripts href="ForcePush.(SpellVisScripts).xdb" />
	<prepareDuration>5000</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>20000</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateCreature" />
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.elements.predicates.PredicateNotHigher">
						<maxAltitude>0.2</maxAltitude>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
						<time>2200</time>
						<impactsOnLand>
							<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
								<element>LIGHTNING</element>
								<damage>15</damage>
								<scaler type="gameMechanics.elements.scalers.MagicScaler" />
							</Item>
						</impactsOnLand>
						<distance>30</distance>
					</Item>
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>60</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
