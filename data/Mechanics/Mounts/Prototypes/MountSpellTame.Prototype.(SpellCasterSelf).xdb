<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>230344</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <Description_Text />
            <Icon_Image />
            <Mount_Group />
        </Variables>
    </Header>
    <Name href="GainingMount.txt" />
    <Description hrefvar="Description_Text" />
    <image hrefvar="Icon_Image" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb" />
    <prepareDuration>2500</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasFreeStableSlots">
                                <forMount hrefvar="Mount_Resourse" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                <group hrefvar="Mount_Group" />
                            </Item>
                        </predicates>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                            <group hrefvar="Mount_Group" />
                                        </predicate>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasFreeStableSlots">
                                        <forMount hrefvar="Mount_Resourse" />
                                    </Item>
                                </predicates>
                            </Item>
                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                        <group hrefvar="Mount_Group" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                                                    <unlock hrefvar="Mount_Unlock" />
                                                </predicate>
                                            </Item>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                                <predicates>
                                                    <Item type="gameMechanics.elements.predicates.PredicateGreater">
                                                        <lhs type="gameMechanics.elements.calcers.FloatData">
                                                            <value var="value" />
                                                        </lhs>
                                                        <rhs type="gameMechanics.elements.calcers.FloatData">
                                                            <value>0</value>
                                                        </rhs>
                                                    </Item>
                                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                        <predicate type="gameMechanics.elements.predicates.PredicateHasMount">
                                                            <mount hrefvar="Mount_Resourse" />
                                                        </predicate>
                                                    </Item>
                                                </predicates>
                                            </Item>
                                        </predicates>
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateHasContentKey">
                            <key href="/System/ContentKeys/P2P_shard/P2P_shard_Server.(ContentKey).xdb" />
                        </predicate>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateGreater">
                        <lhs type="gameMechanics.elements.calcers.FloatData">
                            <value var="P2P_usable" />
                        </lhs>
                        <rhs type="gameMechanics.elements.calcers.FloatData">
                            <value>0</value>
                        </rhs>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                        <group hrefvar="Mount_Group" />
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateHasFreeStableSlots">
                            <forMount hrefvar="Mount_Resourse" />
                        </predicate>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                            <unlock hrefvar="Mount_Unlock" />
                        </predicate>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                        <unlock hrefvar="Mount_Unlock" />
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateGreater">
                                <lhs type="gameMechanics.elements.calcers.FloatData">
                                    <value var="value" />
                                </lhs>
                                <rhs type="gameMechanics.elements.calcers.FloatData">
                                    <value>0</value>
                                </rhs>
                            </Item>
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.predicates.PredicateHasMount">
                                            <mount hrefvar="Mount_Resourse" />
                                        </predicate>
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactTameMount">
                                        <mount hrefvar="Mount_Resourse" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                                <group hrefvar="Mount_Group" />
                                            </Item>
                                        </predicates>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                                <data href="OverrideMount.(ClientData).xdb" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                        <elseImpacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHasMountFromGroup">
                                        <group hrefvar="Mount_Group" />
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                                        <unlock hrefvar="Mount_Unlock" />
                                    </Item>
                                </impacts>
                                <elseImpacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactTameMount">
                                        <mount hrefvar="Mount_Resourse" />
                                    </Item>
                                </elseImpacts>
                            </Item>
                        </elseImpacts>
                    </Item>
                </elseImpacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>