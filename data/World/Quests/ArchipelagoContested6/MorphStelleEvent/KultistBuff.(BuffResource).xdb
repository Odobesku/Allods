                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                            <mobs>
                                                                <Item href="/Characters/Hadagan_male/Instances/ArchipelagoContested6/HadaganCultistMale45_46.(MobWorld).xdb" />
                                                                <Item href="/Characters/Hadagan_male/Instances/ArchipelagoContested6/HadaganCultistMale46_46.(MobWorld).xdb" />
                                                                <Item href="/Characters/Hadagan_male/Instances/ArchipelagoContested6/HadaganCultistMale46_47.(MobWorld).xdb" />
                                                            </mobs>
                                                        </Item>
                                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                                <buff href="AggroBuff.(BuffResource).xdb" />
                                                            </predicate>
                                                        </Item>
                                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                                <buff href="WildBuff.(BuffResource).xdb" />
                                                            </predicate>
                                                        </Item>
                                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                                <buff href="CombatBuff.(BuffResource).xdb" />
                                                            </predicate>
                                                        </Item>
                                                    </predicates>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="AggroBuff.(BuffResource).xdb" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.world.creature.MobFilter" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                                <rule href="/Mechanics/Rules/ArchipelagoContested6/MorphStelleEvent/MorphStelleEvent.(RuleResource).xdb" />
                            </predicate>
