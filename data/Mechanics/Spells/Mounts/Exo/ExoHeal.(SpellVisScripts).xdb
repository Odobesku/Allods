                                <effectFx href="/Spells/FX/Spells/Exoskeleton_Spell02_Electro04.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <scale>0.5</scale>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Back_Special</locatorName>
                                <offset z="0.1" />
                            </Item>
                            <Item>
                                <delay>400</delay>
                                <effectFx href="/Spells/FX/Spells/Exoskeleton_Spell02_Electro03.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <scale>1</scale>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Back_Special</locatorName>
                                <offset x="-0.15" z="0.1" />
                            </Item>
                            <Item>
                                <delay>400</delay>
                                <effectFx href="/Spells/FX/Spells/Exoskeleton_Spell02_Electro03.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <effectAlias href="" />
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Back_Special</locatorName>
