<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>224483</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="R7_PhysPsyker_Add_BossDeathTrigger.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.RelativePos" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="0" max="0" />
                                                    <horizontalRange min="20" max="35" />
                                                </modifier>
                                            </Item>
                                        </modifiers>
                                    </destination>
                                    <object href="R7_InfPsyker_Add_HM.(MobWorld).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        </moveType>
                                        <resource href="R7_Debuff_Enrage.(ProjectileResource).xdb" />
                                    </projectileData>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Phys_Plane.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </onLeave>
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>90</radius>
                            <affectGroup>Friends</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="R7_PhysPsyker_Pulse_HM.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="R7_InfPsyker_Pulse.(ClientData).xdb" />
                                    <calcers>
                                        <addressEntries>
                                            <Item>
                                                <name>caster</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                            </Item>
                                            <Item>
                                                <name>target</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                            </Item>
                                        </addressEntries>
                                    </calcers>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="R7_PhysPsyker_Pulse_HM.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <tick>5000</tick>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>