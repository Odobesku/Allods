<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>ItemMall</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_CENTER</Align>
            <Size>52</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>-4</HighPos>
            <Size>52</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>pin_button_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>false</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>false</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>false</showClippedLine>
        <showClippedSymbol>true</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextPinMenu3/textures/ButtonItemMallHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            <PushedOffset x="1" y="2"/>
            <Reaction>pin_button_pressed</Reaction>
            <ReactionRightClick>pin_button_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextPinMenu3/PinButtonItemMall.txt"/>
                <LayerMain href="/Interface/Ingame/ContextPinMenu3/textures/ButtonItemMallNormal.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed>
                <FormatFileRef href="/Interface/Ingame/ContextPinMenu3/PinButtonItemMall.txt"/>
                <LayerMain href="/Interface/Ingame/ContextPinMenu3/textures/ButtonItemMallPressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextPinMenu3/texts/PinButtonItemMallLabel.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>false</useDefaultSounds>
</WidgetButton>
