		<Item>
			<name>var3</name>
			<value var="value" />
		</Item>
		<Item>
			<name>var0</name>
			<value var="baseBonus" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
		<Item>
			<name>var1</name>
			<value var="crPowBonus" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
		<Item>
			<name>coeff</name>
			<value var="coeff" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Bard/ExtraLethalityOnLament.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.BuffExtraEffects">
					<buffs>
						<Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
					</buffs>
					<effects>
						<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
							<mark href="/Mechanics/Spells/Bard63/Spells/Party/SoloPartyHitOnCaster.(MarkResource).xdb" />
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIsolator">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
											<radius>40</radius>
											<affectPets>true</affectPets>
											<impacts>
												<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
													<predicates>
														<Item type="gameMechanics.elements.resources.ResourceBuff">
															<buff href="/Mechanics/Spells/Bard63/Abilities/CommonBuffProxy/WilProxy.(BuffResource).xdb" />
														</Item>
													</predicates>
													<impacts>
														<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
															<buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/WillPower/WillPower.(BuffResource).xdb" />
															<durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
																<mul var="value" />
																<mulCalcer type="gameMechanics.elements.calcers.SpellRankCalcer">
																	<spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/WillPower/WillPower1.(SpellSingleTarget).xdb" />
																	<mul>0.67</mul>
																</mulCalcer>
															</durationScaler>
														</Item>
													</impacts>
													<elseImpacts>
														<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
															<predicates>
																<Item type="gameMechanics.elements.resources.ResourceBuff">
																	<buff href="/Mechanics/Spells/Bard63/Abilities/CommonBuffProxy/BloodLustProxy.(BuffResource).xdb" />
																</Item>
															</predicates>
															<impacts>
																<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																	<buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Bloodlust/Bloodlust.(BuffResource).xdb" />
																	<durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
																		<mul var="value" />
																		<mulCalcer type="gameMechanics.elements.calcers.SpellRankCalcer">
																			<spell href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Bloodlust/Bloodlust1.(SpellSingleTarget).xdb" />
																			<mul>0.67</mul>
																		</mulCalcer>
																	</durationScaler>
																</Item>
															</impacts>
														</Item>
													</elseImpacts>
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.effects.SpellsModifier">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
									<spells>
										<Item href="/Mechanics/Spells/Bard63/Spells/Party/Party03.(SpellArea).xdb" />
										<Item href="/Mechanics/Spells/Bard63/Spells/Solo/Solo03.(SpellSingleTarget).xdb" />
									</spells>
								</Item>
							</predicates>
							<modifiers>
