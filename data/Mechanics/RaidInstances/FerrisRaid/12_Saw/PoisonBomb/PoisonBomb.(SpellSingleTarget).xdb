<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>223045</resourceId>
    </Header>
    <Name href="PoisonBomb.(SpellSingleTarget).Name.txt" />
    <visualScripts href="Poisonbomb.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>0</value>
    </range>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>20000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="PoisonBomb.(BuffResource).xdb" />
                        <impactsOnAttach>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="FirstCastSkipped.(BuffResource).xdb" />
                                            </Item>
                                        </predicates>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                                        <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                                            <range min="0" max="1" />
                                                            <withinRange>false</withinRange>
                                                            <minCandidatesCount>2</minCandidatesCount>
                                                            <targetCount>2</targetCount>
                                                        </selector>
                                                        <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                                            <filters>
                                                                <Item type="gameMechanics.world.creature.AvatarFilter" />
                                                                <Item type="gameMechanics.world.creature.AliveFilter" />
                                                                <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                                                    <predicates>
                                                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                                            <predicate type="gameMechanics.elements.resources.ResourceAnyBuff">
                                                                                <buffs>
                                                                                    <Item href="/Mechanics/RaidInstances/Tank.(BuffResource).xdb" />
                                                                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/12_Saw/BloodPlague/BoodPlague_HM.(BuffResource).xdb" />
                                                                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/12_Saw/BloodPlague/BloodLink_Caster.(BuffResource).xdb" />
                                                                                    <Item href="PoisonBomb.(BuffResource).xdb" />
                                                                                    <Item href="PoisonBomb.(BuffResource).xdb" />
                                                                                </buffs>
                                                                            </predicate>
                                                                        </Item>
                                                                    </predicates>
                                                                </Item>
                                                            </filters>
                                                        </filter>
                                                        <impacts>
                                                            <Item>
                                                                <impacts>
                                                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                        <buff href="SlimePoison.(BuffResource).xdb" />
                                                                    </Item>
                                                                </impacts>
                                                            </Item>
                                                        </impacts>
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                        <elseImpacts>
                                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                <impacts>
                                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                        <buff href="FirstCastSkipped.(BuffResource).xdb" />
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </elseImpacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impactsOnAttach>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>POISON</element>
                        <damage>200</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
                                <spell href="PoisonBomb.(SpellSingleTarget).xdb" />
                                <duration>
                                    <second>4</second>
                                </duration>
                            </Item>
                        </impacts>
                    </Item>
                </impactsElse>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>30</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>