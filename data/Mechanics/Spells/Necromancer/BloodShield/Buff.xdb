<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>1921974299</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Spells/Necromancer/Bloodshield.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffectsIncCount />
    <interfaceHighPriority>true</interfaceHighPriority>
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.NotStackableEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.RepelTypeRaiser">
                    <type>IGNORE</type>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
                    <damageType>Damage</damageType>
                    <eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                        <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.offender.PredicateOffenderIsCaster" />
                        </Item>
                    </predicates>
                    <impacts>
                        <casterToTarget>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <hideText>false</hideText>
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <hideText>false</hideText>
                                            <buff href="Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            <anyRank>true</anyRank>
                                            <consumeStacks>0</consumeStacks>
                                        </predicate>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.StackBuff">
                                                <buff hrefvar="buff" />
                                                <resetTimer>false</resetTimer>
                                                <anyRank>true</anyRank>
                                                <delta type="gameMechanics.elements.calcers.FloatData">
                                                    <value>-1</value>
                                                </delta>
                                            </Item>
                                        </impacts>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                                <hideText>false</hideText>
                                                <ability href="/Mechanics/Abilities/NecromancerTalents/InstantDefence/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                                <anyRank>true</anyRank>
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                <allowOverrideCaster>false</allowOverrideCaster>
                                                <durationScaler type="gameMechanics.elements.scalers.AbilityRankScaler">
                                                    <ability href="/Mechanics/Abilities/NecromancerTalents/InstantDefence/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                                    <mul>300</mul>
                                                </durationScaler>
                                            </Item>
                                        </impactsIf>
                                    </Item>
                                </impactsIf>
                            </Item>
                        </casterToTarget>
                    </impacts>
                    <scaleImpactsByDamage>false</scaleImpactsByDamage>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatResistance">
                <element>EPHYSICAL</element>
            </stat>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>0.08</mul>
                <mulCalcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <forAllRanks>true</forAllRanks>
                </mulCalcer>
                <sum>1</sum>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateCharacterClass">
                                    <characterClass href="/Mechanics/Classes/Necromancer.xdb#xpointer(/gameMechanics.world.avatar.CharacterClass)" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <rerunOnLoad>true</rerunOnLoad>
        </Item>
    </effects>
    <duration>1800000</duration>
    <isStackable>true</isStackable>
    <stackLimit var="stackLimit" />
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>false</isMultiple>
    <ranks>
        <Item href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff03.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
    </ranks>
    <canBeSaved>true</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/ClassChangeBuffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>