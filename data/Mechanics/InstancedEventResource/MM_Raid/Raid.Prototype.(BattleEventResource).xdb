<?xml version="1.0" encoding="UTF-8" ?>
<avatarPopulation.service.impl.matchMakingImpl.eventType.lfg.RaidEventType>
    <Header>
        <resourceId>242319</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="" />
    <category href="/Mechanics/InstancedEventResource/MM_Raid/Raids.(BattleEventCategory).xdb" />
    <minAvatarLevel type="gameMechanics.formulas.MaxLevelConstant" />
    <minAvatarsCount>0</minAvatarsCount>
    <capacity>12</capacity>
    <immediatelyStartFactor>0.2</immediatelyStartFactor>
    <unionType>SmallRaid</unionType>
    <allowEmptyGroupsAfterPrepare>true</allowEmptyGroupsAfterPrepare>
    <keepGroupAfterFinish>true</keepGroupAfterFinish>
    <activeEventJoinPeriod>0</activeEventJoinPeriod>
    <question href="/Mechanics/InstancedEventResource/MM_LFG/RoleQuiz.(Question).xdb" />
    <forceStartQuestion href="/Mechanics/InstancedEventResource/MM_LFG/ForceStartQuiz.(Question).xdb" />
    <roles>
        <Item>
            <role>DamageDealer</role>
            <capacity>12</capacity>
        </Item>
    </roles>
    <joinConditions>
        <Item type="gameMechanics.elements.predicates.PredicateGreater">
            <lhs type="gameMechanics.elements.calcers.CalcerGearScore" />
            <rhs type="gameMechanics.elements.calcers.FloatData">
                <value>0</value>
            </rhs>
        </Item>
    </joinConditions>
    <unionRequirements>
        <Item type="gameMechanics.elements.predicates.SoftUnionRequirement">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateExternal">
                    <predicateResource hrefvar="GearScorePred" />
                </Item>
            </predicates>
            <successesPerFailure>2</successesPerFailure>
            <errorClientData href="/Mechanics/InstancedEventResource/CommonMechanics/GearscoreUnionRequirement.(ClientData).xdb" />
        </Item>
    </unionRequirements>
    <leaderOnly>true</leaderOnly>
    <destinationTag href="Raid_Enter.(IdentifiableTagResource).xdb" />
</avatarPopulation.service.impl.matchMakingImpl.eventType.lfg.RaidEventType>