<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.map.basicElements.MapModifierResource>
    <Header>
        <resourceId>252140</resourceId>
    </Header>
    <name href="NewYear.(MapModifierResource).Name.txt" />
    <description href="NewYear.(MapModifierResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageIceTomb.(UISingleTexture).xdb" />
    <mapEffects>
        <Item type="gameMechanics.elements.effects.AddMapSpecificEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsIf">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                            <onMaster type="gameMechanics.elements.predicates.PredicateIsMob" />
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                            </predicates>
                            <impacts>
                                <targetToOffender>
                                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                            <value>0.03</value>
                                        </chanceCalcer>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                        <predicates>
                                                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                                    <buff href="FrostStunImmun.(BuffResource).xdb" />
                                                                </predicate>
                                                            </Item>
                                                        </predicates>
                                                        <impactsIf>
                                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                <buff href="FrostStun.(BuffResource).xdb" />
                                                            </Item>
                                                        </impactsIf>
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </targetToOffender>
                            </impacts>
                        </Item>
                    </effectsIf>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsIf">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                            <onMaster type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.SummandStat">
                            <stat type="gameMechanics.elements.stat.InnateStat">
                                <stat>Will</stat>
                            </stat>
                            <value>75</value>
                            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>10</multiplier>
                            </scaler>
                        </Item>
                        <Item type="gameMechanics.elements.effects.SummandStat">
                            <stat type="gameMechanics.elements.stat.InnateStat">
                                <stat>Vitality</stat>
                            </stat>
                            <value>15</value>
                            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>10</multiplier>
                            </scaler>
                        </Item>
                    </effectsIf>
                </Item>
            </effects>
        </Item>
    </mapEffects>
</gameMechanics.map.basicElements.MapModifierResource>