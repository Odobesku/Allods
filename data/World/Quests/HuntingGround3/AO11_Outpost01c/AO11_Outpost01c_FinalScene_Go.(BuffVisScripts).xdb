<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.IfAction">
        <condition type="client.SLON.IfCreatureVisCharacter">
          <visCharList>
            <Item href="/Characters/Kania_female/KaniaFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
          </visCharList>
          <checkIsInTheList>true</checkIsInTheList>
          <checkOnStartOnly>true</checkOnStartOnly>
        </condition>
        <onBreak>
          <breakEnabled>false</breakEnabled>
        </onBreak>
        <thenAction type="client.Replica.CreatureMountVisAction">
          <visualMount href="/Client/VisualMounts/Horses/KaniaStandartWhite.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
          <restorePrevMount>false</restorePrevMount>
        </thenAction>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>