<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirect02Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
            </Item>
        </elements>
    </actionBarStart>
    <wholeCasting type="VisActionList">
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AstralToxin.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.5</scale>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AstralToxin.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>0.5</scale>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <advanced>
                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                </advanced>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>