<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
    <Header>
        <resourceId>221148</resourceId>
    </Header>
    <persistentParts>
        <Item type="gameMechanics.constructor.schemes.buff.BuffAttachHandlersResource" />
        <Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                            <pool href="Proec.(SummonPool).xdb" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                            <resources>
                                                <Item href="Proec_DiAr.(SteleResource).xdb" />
                                            </resources>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactsIfGeneric">
                                            <predicate type="gameMechanics.elements.predicates.PredicateNotMaster" />
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impactsIf>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="Proec_DiAr.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>3000</tick>
                </Item>
            </effects>
        </Item>
    </persistentParts>
    <name href="Proec_DiAr.(SteleResource).Name.txt" />
    <visObj href="/Spells/FX/Mobs/ArchitectFinalBoss_Sphere.(VisObjectTemplate).xdb" />
    <spell href="Proec_DiAr.(SpellSingleTarget).xdb" />
    <corpseDuration>3000</corpseDuration>
    <corpseEmptyDuration>1200</corpseEmptyDuration>
    <dropsPublicLoot>false</dropsPublicLoot>
</gameMechanics.world.device.SteleResource>