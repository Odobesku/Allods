    <Description href="Cowardice.(BuffResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="buff_duration" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/CommonState/Debuff_Cowardice.(UISingleTexture).xdb" />
