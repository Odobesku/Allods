    <nameTemplate href="FireCone.(SpellArea).NameTemplate.txt" />
    <range type="gameMechanics.elements.calcers.MeleeRangeCalcer" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/AstarlIslands/AI45/AI45_SummerLizardFire_Buff_Animation.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>500</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
