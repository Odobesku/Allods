<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>spellCastDirectedBard</Item>
        </animations>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/Bard_Dissonance_Targets.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Slot_BodyFX</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
    <playOnTargets>
        <specialAction type="VisActionList">
            <play>Simultaneously</play>
            <elements>
                <Item type="CreatureEffectsAction">
                    <visualEffects>
                        <Item>
                            <effectFx href="/Spells/FX/Spells/Bard_Dissonance_Targets.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                            <locator>Slot_BodyFX</locator>
                        </Item>
                    </visualEffects>
                </Item>
            </elements>
        </specialAction>
    </playOnTargets>
</SpellVisScripts>