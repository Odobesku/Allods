<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<AnimationPreCastMode>LOOP</AnimationPreCastMode>
			<LocatorOnTargets>Global</LocatorOnTargets>
			<CastAnimation>specialAttack</CastAnimation>
			<FXOnTargets>/Spells/FX/Spells/HitMeleeHard2_Wave1.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList" />
	<wholeCasting type="VisActionList" />
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
				</advanced>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FXOnTargets" />
					</Item>
				</visualEffects>
				<category>EFFECT_DEFAULT</category>
			</Item>
		</elements>
	</launch>
	<useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>
