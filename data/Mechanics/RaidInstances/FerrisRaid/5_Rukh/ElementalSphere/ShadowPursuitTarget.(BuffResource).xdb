<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221425</resourceId>
    </Header>
    <Name href="ShadowPursuitTarget.(BuffResource).Name.txt" />
    <Description href="ShadowPursuitTarget.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Junk/Offhand_Orb_D_03Purple.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                    <runningMode>true</runningMode>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                    <initialDelay>1000</initialDelay>
                </Item>
            </effectsIf>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ShadowToShadow.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ShadowSphere.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ShadowPursuitTarget.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>20000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>