<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739872917</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/World/Quests/UmoirMound/UM_Q05/UM_Q05_Plane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>120000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                            <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                            <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>