<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739949583</resourceId>
    </Header>
    <Name href="CureFaith.(BuffResource).Name.txt" />
    <Description href="CureFaith.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestCureWoundsUpgrade.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffInterceptor">
            <impactsOnDetach>
                <Item type="gameMechanics.elements.impacts.ScaledImpacts">
                    <scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                        <buff href="CureFaith.(BuffResource).xdb" />
                        <anyRank>true</anyRank>
                        <onlyFromMaster>true</onlyFromMaster>
                        <mul>1</mul>
                    </scalerTarget>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateInCombat" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                            <variable href="/Mechanics/Spells/Priest63/Abilities/Zeal/Faith.(VariableResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>15</radius>
                                    <affectGroup>Group</affectGroup>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactHeal">
                                            <heal>3</heal>
                                            <scalerCaster type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                <scalers>
                                                    <Item type="gameMechanics.elements.scalers.HealScaler" />
                                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                        <mulCalcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
                                                            <ability href="Ability01.(AbilityResource).xdb" />
                                                            <mul>1</mul>
                                                        </mulCalcer>
                                                    </Item>
                                                </scalers>
                                            </scalerCaster>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnDetach>
            <buffCaster type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffEquals">
                    <buff href="CureFaith.(BuffResource).xdb" />
                </Item>
            </predicates>
        </Item>
    </effects>
    <duration>4000</duration>
    <stackLimit>3</stackLimit>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>