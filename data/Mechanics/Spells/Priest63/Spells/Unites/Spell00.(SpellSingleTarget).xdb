					<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactHeal">
								<heal var="heal" />
								<scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
							</Item>
						</impacts>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactTeleport">
						<destination type="gameMechanics.map.destination.SelfPosDestination" />
						<finishImpacts>
							<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
								<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
								<data href="TeleportCD.(ClientData).xdb" />
							</Item>
						</finishImpacts>
					</Item>
				</impacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.PostponedImpacts">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
						<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
						<data href="HealCD.(ClientData).xdb" />
					</Item>
					<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactHeal">
								<heal var="heal" />
								<scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
							</Item>
						</impacts>
					</Item>
				</impacts>
