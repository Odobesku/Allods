<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>221408</resourceId>
    </Header>
    <visObject href="/Spells/FX/Mobs/ShadowPuddle_Collision.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>19600</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.StaticEntityAura">
                    <shape type="space.scaner.resources.Cylinder">
                        <halfHeight>12</halfHeight>
                    </shape>
                    <radius>5</radius>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="ShadowPuddleDebuff.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="ShadowPuddleDebuff.(BuffResource).xdb" />
                        </Item>
                    </impactsOut>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>