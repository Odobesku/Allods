<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739920374</resourceId>
    </Header>
    <Name href="DemonBoss02_Summon.(SpellArea).Name.txt" />
    <visualScripts href="DemonBoss02_Summon.(SpellVisScripts).xdb" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>24000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="DemonBoss02_Vanish.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="DemonBoss02_DemonTimer.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                        <object href="DemonBoss02_Spark.(MobWorld).xdb" />
                        <pool href="DemonBoss02_Summon.(SummonPool).xdb" />
                        <isPersonalPool>true</isPersonalPool>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                        <spell href="DemonBoss02_Reflect.(SpellSingleTarget).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactStartSpell">
                        <spell href="DemonBoss02_Reflect.(SpellSingleTarget).xdb" />
                        <spellTarget type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>0</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>