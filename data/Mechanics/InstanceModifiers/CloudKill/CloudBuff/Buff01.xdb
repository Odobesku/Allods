            <initialDelay>-1</initialDelay>
        </Item>
    </effects>
    <duration>19000</duration>
    <isStackable>false</isStackable>
    <isGradual>true</isGradual>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
