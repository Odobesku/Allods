<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739933515</resourceId>
    </Header>
    <name href="EscapeStrategyParty.(AbilityResource).Name.txt" />
    <description href="EscapeStrategyParty.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/MagePortal.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
            <mark href="TeleportGroup.(MarkResource).xdb" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                            <radius>10</radius>
                            <affectPets>false</affectPets>
                            <excludeCaster>true</excludeCaster>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="TeleportParty.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <affectGroup>Friends</affectGroup>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                            <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                        </Item>
                    </conditions>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>95</radius>
                                    <conditions>
                                        <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                            <buff href="TeleportParty.(BuffResource).xdb" />
                                            <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCasterMaster" />
                                        </Item>
                                    </conditions>
                                    <affectHolder>false</affectHolder>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                            <data href="/Mechanics/Spells/Engineer63/Spells/Strategies/TeleportVisual.(ClientData).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <targetsLimit>1</targetsLimit>
                    <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>