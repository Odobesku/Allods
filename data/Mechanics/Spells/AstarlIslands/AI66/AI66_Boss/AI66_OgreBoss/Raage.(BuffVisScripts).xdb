<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialCast</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/CastSpell_FireBomb.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/AI14_BossFire_Hands.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <locator>Head</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureColorAction">
                <timeOn>1</timeOn>
                <timeOff>1</timeOff>
            </Item>
        </elements>
    </action>
</BuffVisScripts>