<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>739869764</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name hrefvar="name" />
    <text href="StValentinesExchange.Prototype.(Cue).Text.txt" />
    <conditions>
        <Item type="gameMechanics.elements.predicates.PredicateHasItemsCount">
            <items>
                <Item hrefvar="item" />
            </items>
            <totalCount>1</totalCount>
            <checkDress>false</checkDress>
        </Item>
    </conditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactDestroyItem">
            <item hrefvar="item" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
            <currency href="/Mechanics/AlternativeCurrencies/Events/SpringCoupon.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
            <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </sumCalcer>
            <multiplier var="cost" />
        </Item>
    </impacts>
    <nextCues>
        <Item href="SpringVendorExchange.(Cue).xdb#xpointer(/gameMechanics.world.mob.interaction.Cue)" />
        <Item href="SpringVendorNotExchange.(Cue).xdb#xpointer(/gameMechanics.world.mob.interaction.Cue)" />
    </nextCues>
</gameMechanics.world.mob.interaction.Cue>