<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/ProjectileAOE.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXProjectile>/Spells/FX/Spells/Dust_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<FXProjectileHit>/Spells/FX/Mobs/UmoirLihoBoss_Ash_PlayerAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<ProjectileLocatorOnTarget>Slot_FX</ProjectileLocatorOnTarget>
			<LocatorOnCaster>Slot_Hand_L</LocatorOnCaster>
			<Ge>20</Ge>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item type="VisActionList">
						<elements>
							<Item skiped="" />
							<Item type="CreatureProjectileAction">
								<projectileFx hrefvar="FXProjectile" />
								<explosionFx hrefvar="FXProjectileHit" />
								<theGe var="Ge" />
								<pointOnCaster type="VisPointLocator">
									<locator var="LocatorOnCaster" />
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator var="ProjectileLocatorOnTarget" />
								</pointOnTarget>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="CreatureEffectsAction">
			<visualEffects />
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
