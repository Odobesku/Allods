<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739917678</resourceId>
    </Header>
    <Name href="Generator_Enrage.(BuffResource).Name.txt" />
    <Description href="Generator_Enrage.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/ActivateGeneratorAirMoto.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.StackBuff">
                    <buff href="Generator_Enrage.(BuffResource).xdb" />
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>1</value>
                    </delta>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>1000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectStackTrigger">
                    <count>50</count>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="/Mechanics/RaidInstances/AstralExplosion.(ClientData).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>LIGHTNING</element>
                                            <damage>50</damage>
                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.DirectHeal">
                                            <heal>1</heal>
                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                            </scalerTarget>
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                <filters>
                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                    <Item type="gameMechanics.world.creature.AliveFilter" />
                                </filters>
                            </filter>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                </Item>
            </effects>
        </Item>
    </effects>
    <stackLimit>50</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>