<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>189170</resourceId>
    </Header>
    <visScript href="/Spells/BuffVisScripts/Stun.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EventTrigger">
            <eventClasses>
                <Item>gameMechanics.elements.events.EventHealReceived</Item>
            </eventClasses>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateHealthLower">
                                <level>1</level>
                            </predicate>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="AESpiderStun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.common.HealOverTime">
            <healPerTick type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </healPerTick>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                    <multiplier>0.0234375</multiplier>
                </mulCalcer>
            </scaler>
            <tick>500</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/StunBreakers.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            </groups>
        </Item>
    </effects>
    <duration>10000</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Stuns.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/Undispelable.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/StopSing.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>