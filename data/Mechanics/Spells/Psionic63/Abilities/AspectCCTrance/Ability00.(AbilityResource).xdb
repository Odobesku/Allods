<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>220341</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="duration" />
        </Item>
        <Item>
            <name>var1</name>
            <value>-100</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer hrefvar="externalCalcer" />
                </mulCalcer>
                <sum>-1</sum>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Priest/PriestZeal.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/CC/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.CombatStateTrigger">
                    <effects>
                        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
                            <conditionalImpacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                                    <predicates>
                                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                            <buff href="Buff01.(BuffResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                                            <buff href="Proxy.(BuffResource).xdb" />
                                                            <range>
                                                                <min>3</min>
                                                                <max>4</max>
                                                            </range>
                                                        </Item>
                                                    </predicates>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff hrefvar="buff" />
                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier var="duration" />
                                                    </durationScaler>
                                                </Item>
                                            </impactsIf>
                                            <impactsElse>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="Proxy.(BuffResource).xdb" />
                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier var="duration" />
                                                    </durationScaler>
                                                </Item>
                                            </impactsElse>
                                        </Item>
                                    </impacts>
                                    <conditions>
                                        <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                                            <group href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
                                        </Item>
                                    </conditions>
                                </Item>
                            </conditionalImpacts>
                            <stages>
                                <Item>Launch</Item>
                            </stages>
                        </Item>
                        <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
                            <mark href="/Mechanics/Spells/Psionic63/Spells/MentalStorm/TranceTrigger.(MarkResource).xdb" />
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="Buff01.(BuffResource).xdb" />
                                                </Item>
                                                <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                                    <buff href="Proxy.(BuffResource).xdb" />
                                                    <range>
                                                        <min>3</min>
                                                        <max>4</max>
                                                    </range>
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff hrefvar="buff" />
                                            <impactsOnAttach />
                                            <impactsOnFail />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier var="duration" />
                                            </durationScaler>
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Proxy.(BuffResource).xdb" />
                                            <impactsOnAttach />
                                            <impactsOnFail />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier var="duration" />
                                            </durationScaler>
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>