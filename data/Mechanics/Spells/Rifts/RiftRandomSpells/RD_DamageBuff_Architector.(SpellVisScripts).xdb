<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readySpell</Item>
		</animations>
		<channel>CHANNEL_HITCRITICAL</channel>
	</actionBarStart>
	<launch type="VisActionList">
		<play>InSequence</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Mobs/Morok_CasterAddAoE_Projectile.(VisObjectTemplate).xdb" />
				<explosionFx href="/Spells/FX/Spells/WarriorInnerRageAbility.(VisObjectTemplate).xdb" />
				<isMultyProjectile>true</isMultyProjectile>
				<theGe>6</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_FX</locator>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_Global</locator>
				</pointOnTarget>
				<offendTime />
			</Item>
		</elements>
	</launch>
</SpellVisScripts>