<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MeleeAttack.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FxOnTargets>/Spells/FX/Spells/HitMeleeHard2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnTargets>
			<OffendType>ONEOFFEND_ONETARGET</OffendType>
			<UseAnimation>USE_ANIMATIONS</UseAnimation>
			<FxOnCaster>/Spells/FX/Spells/BardPridenHeavyPaw.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnCaster>
			<Animation>crusaderStrike</Animation>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FxOnCaster" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<channel>CHANNEL_TURNSPECIAL</channel>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<scale>0.75</scale>
						</Item>
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
