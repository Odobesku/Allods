                            </Item>
                            <Item type="gameMechanics.elements.calcers.CalcerLongMul">
                                <calcers>
                                    <Item type="constructor.elements.CalcerLongExternal">
                                        <externalCalcer href="Calcers/LoadResource.(CalcerLongResource).xdb#xpointer(/constructor.elements.CalcerLongResource)" />
                                    </Item>
                                    <Item type="gameMechanics.elements.calcers.LongData">
                                        <value>-1</value>
                                    </Item>
                                </calcers>
                            </Item>
                        </calcers>
                    </sumCalcer>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.BuffDetacher">
