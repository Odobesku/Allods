<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222908</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Event/ShieldCarrier.(UISingleTexture).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/Mechanics/RaidInstances/FerrisRaid/15_General/DefeatedAddPlane.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>3000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                </moveType>
                                <resource href="/Mechanics/RaidInstances/FerrisRaid/15_General/3_GeneralToDrones.(ProjectileResource).xdb" />
                            </projectileData>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                            <data href="/Mechanics/RaidInstances/FerrisRaid/Voice/15_General/29_Enrage.(ClientData).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/Voice/VoiceCooldown.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>10000</multiplier>
                            </durationScaler>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/RaidInstances/Phase1.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>