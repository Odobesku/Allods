<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739951734</resourceId>
	</Header>
	<Name href="ColdDebuff.(SpellSingleTarget).Name.txt" />
	<visualScripts href="ColdDebuff.(SpellVisScripts).xdb" />
	<prepareDuration>1000</prepareDuration>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>9999999</duration>
		</cooldown>
		<targetConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
				</predicates>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateIsPet" />
			</Item>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="FreezingBuff.(BuffResource).xdb" />
				</predicate>
			</Item>
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateHasAbility">
						<ability href="/Mechanics/InstanceModifiers/HardMode/HardMode.(AbilityResource).xdb" />
					</Item>
				</predicates>
				<impacts>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="FreezingBuff.(BuffResource).xdb" />
					</Item>
				</impacts>
				<elseImpacts>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="ColdDOT.(BuffResource).xdb" />
					</Item>
				</elseImpacts>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
