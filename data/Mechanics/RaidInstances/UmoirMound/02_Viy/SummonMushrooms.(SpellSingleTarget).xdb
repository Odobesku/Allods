<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>226867</resourceId>
    </Header>
    <Name href="SummonMushrooms.(SpellSingleTarget).Name.txt" />
    <prepareDuration>1000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>600000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                        <variableResource href="Point_6_1.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                        <expectedValue type="gameMechanics.elements.calcers.FloatData">
                            <value>0</value>
                        </expectedValue>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.map.destination.DestinationLocator">
                            <locator>
                                <scriptID>B2_6_1</scriptID>
                                <map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </locator>
                            <yaw type="constructor.basicElements.AngleDegrees">
                                <value>180</value>
                            </yaw>
                        </destination>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                            <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                                <variable href="Point_6_1.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                                <reset>true</reset>
                                <summand>0</summand>
                                <calcerSummand type="gameMechanics.elements.calcers.FloatData">
                                    <value>1</value>
                                </calcerSummand>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.AttachAbility">
                                <ability href="MorphAbil_6_1.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                            </Item>
                        </impacts>
                        <object href="Mushroom.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <pool href="Spell_01_Pool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                        <variableResource href="Point_6_4.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                        <expectedValue type="gameMechanics.elements.calcers.FloatData">
                            <value>0</value>
                        </expectedValue>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.map.destination.DestinationLocator">
                            <locator>
                                <scriptID>B2_6_4</scriptID>
                                <map href="/Maps/UmoirMound/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </locator>
                            <yaw type="constructor.basicElements.AngleDegrees">
                                <value>180</value>
                            </yaw>
                        </destination>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                            <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                                <variable href="Point_6_4.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                                <reset>true</reset>
                                <summand>0</summand>
                                <calcerSummand type="gameMechanics.elements.calcers.FloatData">
                                    <value>1</value>
                                </calcerSummand>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.AttachAbility">
                                <ability href="MorphAbil_6_4.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                            </Item>
                        </impacts>
                        <object href="Mushroom.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <pool href="Spell_01_Pool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                <data href="MushroomMessage.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>