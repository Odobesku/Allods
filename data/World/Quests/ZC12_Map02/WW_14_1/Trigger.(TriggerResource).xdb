<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
	<Header>
		<resourceId>739952503</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.QuestCounterTrigger">
			<quest href="WW_14_1.xdb" />
			<counterId href="Counter1.(QuestCountId).xdb" />
			<condition type="constructor.elements.LongEquals">
				<value>4</value>
			</condition>
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="WW_14_Arrived_vis.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Crystal_vis.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="Crystals.(SummonPool).xdb" />
					<isPersonalPool>true</isPersonalPool>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
