                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/War63/Spells/AcceleratedAttackUpgrade/Spell02.(SpellSingleTarget).xdb" />
                                <Item href="/Mechanics/Spells/War63/Spells/FinalBlow/Spell03.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="StackBuff.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/War63/Spells/TreacherousAttack/Spell03.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
        </Item>
    </effects>
    <ranks>
        <Item href="Root01.(AbilityResource).xdb" />
        <Item href="Root02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>