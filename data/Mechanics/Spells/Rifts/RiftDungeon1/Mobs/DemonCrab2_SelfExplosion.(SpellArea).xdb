<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739921083</resourceId>
    </Header>
    <Name href="DemonCrab2_SelfExplosion.(SpellArea).Name.txt" />
    <visualScripts href="DemonCrab2_Explosion.(SpellVisScripts).xdb" />
    <prepareDuration>4000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <channelingMechanics>
            <channelingBuff href="DemonCrab2_SelfExplosion.(BuffResource).xdb" />
            <finishImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>5</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>FIRE</element>
                                    <damage>1</damage>
                                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                        <scalers>
                                            <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
                                                </mulCalcer>
                                            </Item>
                                        </scalers>
                                    </scaler>
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="Boss03/DemonBoss03.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Boss03/Boss03_ExplosionStun.(BuffResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>FIRE</element>
                                            <damage>1</damage>
                                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                <scalers>
                                                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                            <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
                                                        </mulCalcer>
                                                    </Item>
                                                </scalers>
                                            </scaler>
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                    </impactsElse>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                    <finishImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </finishImpacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="DemonCrab1.(MobWorld).xdb" />
                                            <Item href="Boss03/DemonBoss03.(MobWorld).xdb" />
                                        </mobs>
                                    </Item>
                                </predicates>
                            </Item>
                        </predicates>
                    </filter>
                </Item>
            </finishImpacts>
        </channelingMechanics>
    </mechanics>
    <radius>0</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>