<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739921263</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability.(AbilityResource).Name.txt" />
	<description href="Ability.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>-1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="gameMechanics.elements.calcers.FloatData">
							<value var="coeff_speed" />
						</mulCalcer>
						<sum>1</sum>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>FormulaPercent</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
		<Item>
			<name>var1</name>
			<value var="coeff_dmg" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>FormulaPercent</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Druid/DruidWhirlAbility.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.CastOnMove">
			<spells>
				<Item href="/Mechanics/Spells/War63/Spells/Whirlwind/Spell01.(SpellSingleTarget).xdb" />
			</spells>
			<moveTypes>
				<Item>Step</Item>
				<Item>Fall</Item>
				<Item>Pilot</Item>
			</moveTypes>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.SpellsModifier">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="/Mechanics/Spells/War63/Spells/Whirlwind/Spell01.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</predicates>
					<modifiers>
						<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
							<effects>
								<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
									<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
										<coeff var="coeff_dmg" />
									</scaler>
								</Item>
								<Item type="gameMechanics.elements.effects.BuffExtraEffects">
									<buffs>
										<Item href="/Mechanics/Spells/War63/Spells/Whirlwind/Buff01.(BuffResource).xdb" />
									</buffs>
									<effects>
										<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
											<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
												<coeff var="coeff_speed" />
											</effectScaler>
										</Item>
									</effects>
								</Item>
							</effects>
							<onBehalfOfHolder>true</onBehalfOfHolder>
						</Item>
					</modifiers>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>