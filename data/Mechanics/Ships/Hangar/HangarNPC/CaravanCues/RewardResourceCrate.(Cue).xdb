                </additionalMultiplier>
            </scalerCaster>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactAddMoney">
                    <sumCalcer type="gameMechanics.elements.calcers.CalcerLongSum">
                        <calcers>
                            <Item type="constructor.elements.CalcerLongExternal">
