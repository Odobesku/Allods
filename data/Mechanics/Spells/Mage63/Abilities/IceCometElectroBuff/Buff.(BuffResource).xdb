<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>207812</resourceId>
    </Header>
    <Name href="Buff.(BuffResource).Name.txt" />
    <Description href="Buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Mage/MageIceCometUpgrade.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                <Item type="gameMechanics.elements.predicates.offender.PredicateOffenderIsCaster" />
                <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.offender.PredicateIsAE" />
                </Item>
            </predicates>
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.StackBuff">
                        <buff href="Buff.(BuffResource).xdb" />
                        <resetTimer>false</resetTimer>
                        <delta type="gameMechanics.elements.calcers.FloatData">
                            <value>-1</value>
                        </delta>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                        <element>COLD</element>
                                        <damage>12</damage>
                                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </casterToTarget>
            </impacts>
        </Item>
    </effects>
    <duration>30000</duration>
    <stackLimit>6</stackLimit>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>