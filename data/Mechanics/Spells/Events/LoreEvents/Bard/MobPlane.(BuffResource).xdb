<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>209547</resourceId>
    </Header>
    <Name href="MobPlane.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="MobPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectNoAggro" />
        <Item type="gameMechanics.elements.effects.EffectNoAggroChecks" />
    </effects>
    <duration>16000</duration>
    <isHelpful>false</isHelpful>
    <ignoreLevelDelta>true</ignoreLevelDelta>
    <groups>
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/Events/EventBuffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>