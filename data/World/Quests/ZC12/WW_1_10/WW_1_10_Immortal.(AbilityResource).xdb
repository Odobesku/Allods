<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>320653</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>0.1</level>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.11</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="WW_1_10_Immortal.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.common.HealOverTime">
                    <healPerTick type="gameMechanics.elements.calcers.FloatData">
                        <value>1</value>
                    </healPerTick>
                    <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
                    <scalerTarget type="gameMechanics.elements.scalers.ScalerIf">
                        <condition type="gameMechanics.elements.predicates.PredicateInCombat" />
                        <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>0</multiplier>
                        </scalerIf>
                        <scalerElse type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                <multiplier>0.02</multiplier>
                            </mulCalcer>
                        </scalerElse>
                    </scalerTarget>
                    <mode>Pure</mode>
                    <considerOutgoingModifiers>false</considerOutgoingModifiers>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>