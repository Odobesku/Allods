										<calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
											<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
												<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
													<stat type="gameMechanics.elements.stat.SpecialStat">
														<stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
													</stat>
													<valueType>ShortTerm</valueType>
												</mulCalcer>
