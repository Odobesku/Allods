<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>207579</resourceId>
    </Header>
    <Name href="Buff00.(BuffResource).Name.txt" />
    <Description href="Buff00.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/Holy_Orb.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                    <group href="/Mechanics/Spells/Groups/HolyOrb63.(ActionGroup).xdb" />
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                <coeff>0.35</coeff>
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <casterImpacts>
                <Item type="gameMechanics.elements.impacts.StackBuff">
                    <buff href="Buff00.(BuffResource).xdb" />
                    <resetTimer>false</resetTimer>
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>-1</value>
                    </delta>
                </Item>
            </casterImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationGroups">
                <groups>
                    <Item href="/Mechanics/Spells/Groups/HolyOrb63.(ActionGroup).xdb" />
                </groups>
            </destination>
        </Item>
    </effects>
    <duration>20000</duration>
    <stackLimit>4</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>