<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739932516</resourceId>
    </Header>
    <Name href="RD_ProjectilesChannel_Architector.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Misc/Quest/ArchitektCore.(UISingleTexture).xdb" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>10</radius>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                            <time>1000</time>
                            <distance>15</distance>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                        <filters>
                            <Item type="gameMechanics.world.creature.AliveFilter" />
                            <Item type="gameMechanics.world.creature.AvatarFilter" />
                        </filters>
                    </filter>
                </Item>
                <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                    <impact type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                <projectileData>
                                    <moveType type="gameMechanics.world.projectile.MoveTypeDestination">
                                        <to type="gameMechanics.map.destination.DestinationModified">
                                            <destination type="gameMechanics.map.destination.RelativePos" />
                                            <modifiers>
                                                <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                    <modifier type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                        <radius type="gameMechanics.elements.calcers.FloatData">
                                                            <value>25</value>
                                                        </radius>
                                                    </modifier>
                                                </Item>
                                            </modifiers>
                                        </to>
                                    </moveType>
                                    <resource href="RD_SingleProjectile_Architector.(ProjectileResource).xdb" />
                                </projectileData>
                            </Item>
                        </impacts>
                    </impact>
                    <count type="gameMechanics.elements.calcers.FloatData">
                        <value>3</value>
                    </count>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>1000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                    <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                        <range min="0" max="1" />
                                        <withinRange>false</withinRange>
                                        <minCandidatesCount>0</minCandidatesCount>
                                        <targetCount>0</targetCount>
                                    </selector>
                                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                                    <impacts>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                    <projectileData>
                                                        <moveType type="gameMechanics.world.projectile.MoveTypeDestination">
                                                            <receiver>Caster</receiver>
                                                            <to type="gameMechanics.elements.calcers.DestinationBehind">
                                                                <comfortRange>6</comfortRange>
                                                                <maxSteps>6</maxSteps>
                                                            </to>
                                                        </moveType>
                                                        <resource href="RD_SingleProjectile_Architector.(ProjectileResource).xdb" />
                                                    </projectileData>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="RD_ProjectilesChannel_Architector.(ClientData).xdb" />
                </Item>
            </impacts>
            <tick>1500</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="RD_ProjectilesChannel_Architector.(BuffResource).xdb" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn />
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                    <spell href="RD_ProjectilesChannel_Architector.(SpellSingleTarget).xdb" />
                    <duration>25000</duration>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>