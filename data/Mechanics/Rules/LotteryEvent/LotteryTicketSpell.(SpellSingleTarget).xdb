    </Header>
    <Name href="LotteryTicketSpell.(SpellSingleTarget).Name.txt" />
    <Description href="LotteryTicketSpell.(SpellSingleTarget).Description.txt" />
    <targetType>STTSelf</targetType>
    <mechanics>
        <casterConditions>
            <Item type="itemService.elements.lottery.PredicateLotteryIsActive" />
            <Item type="itemService.elements.lottery.PredicateCanAddLotteryTicket" />
            <Item type="gameMechanics.elements.predicates.PredicateWrapClientData">
