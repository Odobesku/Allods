<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>210197504</resourceId>
    </Header>
    <targetType>STTSelf</targetType>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics type="gameMechanics.constructor.schemes.spell.SpellMechanics">
        <cooldown>
            <duration>4000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.StackBuffGeneric">
                <buff href="Enrage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <delta type="gameMechanics.elements.calcers.FloatData">
                    <value>1</value>
                </delta>
                <attachIfNotExist>true</attachIfNotExist>
            </Item>
            <Item type="gameMechanics.elements.impacts.DirectHeal">
                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                        <multiplier>0.02</multiplier>
                    </mulCalcer>
                </scalerTarget>
                <heal>1</heal>
            </Item>
        </casterImpacts>
    </mechanics>
    <iffPolicy>Friends</iffPolicy>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>