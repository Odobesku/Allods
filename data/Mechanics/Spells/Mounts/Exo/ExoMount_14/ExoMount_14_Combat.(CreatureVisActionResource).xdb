<?xml version="1.0" encoding="UTF-8"?>
<CreatureVisActionResource>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.CreatureEffectsAction">
            <category>EFFECT_DEFAULT</category>
            <visualEffects>
              <Item>
                <delay>0</delay>
                <effectAnimations>
                  <mode>DIE</mode>
                </effectAnimations>
                <effectFx href="/Spells/FX/Spells/MEV6Base_Start.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <fadeInTime>50</fadeInTime>
                <fadeOutTime>150</fadeOutTime>
                <scale>1</scale>
                <fixPoint>true</fixPoint>
                <lockScale>false</lockScale>
                <muteFxSounds>false</muteFxSounds>
                <ignoreParentRotation>false</ignoreParentRotation>
                <ignoreProcedureFxScale>false</ignoreProcedureFxScale>
                <locator>Slot_TopFX</locator>
                <member>Default_Member</member>
                <offset x="0" y="0" z="0.09999999" />
                <rotation x="0" y="0" z="0" />
                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
              </Item>
            </visualEffects>
            <dontFade>false</dontFade>
            <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
            <stopOnDeath>false</stopOnDeath>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.SLON.CreatureStepSoundParamAction">
            <param>
              <parameter href="/Mechanics/Mounts/Skins/ExoMounts/ExoFootsteps.(SoundParameter).xdb#xpointer(/SoundParameter)" />
              <value>0.3</value>
            </param>
            <onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>true</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.VisActionDelay">
            <time>350</time>
          </Item>
          <Item type="client.Replica.CreatureChangeVisItemsAction">
            <items>
              <Item>
                <slot>HELM</slot>
              </Item>
              <Item>
                <slot>LIFESTYLEHEAD</slot>
              </Item>
            </items>
            <isGfxCondition>false</isGfxCondition>
            <leaveWeapons>false</leaveWeapons>
            <notForDolls>false</notForDolls>
            <removeAllItems>false</removeAllItems>
          </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
      <Item type="client.Replica.VisActionList">
        <elements>
          <Item type="client.Replica.VisActionList">
            <elements>
              <Item type="client.Replica.CreatureChangeVisItemsAction">
                <items>
                  <Item>
                    <newItem href="/Items/VisualItems/Armor/Plate_E_119ExoskeletonV14Base.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                    <slot>EARRING2</slot>
                  </Item>
                </items>
                <isGfxCondition>false</isGfxCondition>
                <leaveWeapons>true</leaveWeapons>
                <notForDolls>true</notForDolls>
                <removeAllItems>false</removeAllItems>
              </Item>
            </elements>
            <play>Simultaneously</play>
            <playWhile type="client.SLON.PredicateVisualMountAction">
              <mountsList>
                <Item href="/Client/VisualMounts/Exoskeleton/ExoMount_14_Base.(VisualMount).xdb#xpointer(/VisualMount)" />
              </mountsList>
              <checkIsInTheList>true</checkIsInTheList>
              <checkOnStartOnly>true</checkOnStartOnly>
            </playWhile>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
          </Item>
          <Item type="client.Replica.VisActionList">
            <elements>
              <Item type="client.Replica.CreatureChangeVisItemsAction">
                <items>
                  <Item>
                    <newItem href="/Items/VisualItems/Armor/Plate_E_120ExoskeletonV14Top.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                    <slot>EARRING2</slot>
                  </Item>
                </items>
                <isGfxCondition>false</isGfxCondition>
                <leaveWeapons>true</leaveWeapons>
                <notForDolls>true</notForDolls>
                <removeAllItems>false</removeAllItems>
              </Item>
            </elements>
            <play>Simultaneously</play>
            <playWhile type="client.SLON.PredicateVisualMountAction">
              <mountsList>
                <Item href="/Client/VisualMounts/Exoskeleton/ExoMount_14_Top.(VisualMount).xdb#xpointer(/VisualMount)" />
              </mountsList>
              <checkIsInTheList>true</checkIsInTheList>
              <checkOnStartOnly>true</checkOnStartOnly>
            </playWhile>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
          </Item>
          <Item type="client.Replica.VisActionList">
            <elements>
              <Item type="client.Replica.CreatureChangeVisItemsAction">
                <items>
                  <Item>
                    <newItem href="/Items/VisualItems/Cloak/Plate_E_121ExoskeletonV14Com.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                    <slot>EARRING2</slot>
                  </Item>
                </items>
                <isGfxCondition>false</isGfxCondition>
                <leaveWeapons>true</leaveWeapons>
                <notForDolls>true</notForDolls>
                <removeAllItems>false</removeAllItems>
              </Item>
            </elements>
            <play>Simultaneously</play>
            <playWhile type="client.SLON.PredicateVisualMountAction">
              <mountsList>
                <Item href="/Client/VisualMounts/Exoskeleton/ExoMount_14_Horses.(VisualMount).xdb#xpointer(/VisualMount)" />
              </mountsList>
              <checkIsInTheList>true</checkIsInTheList>
              <checkOnStartOnly>true</checkOnStartOnly>
            </playWhile>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
          </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <playWhile type="client.SLON.PredicateVisualMountAction">
      <mountsList>
        <Item href="/Client/VisualMounts/Exoskeleton/ExoMount_14_Base.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
        <Item href="/Client/VisualMounts/Exoskeleton/ExoMount_14_Top.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
        <Item href="/Client/VisualMounts/Exoskeleton/ExoMount_14_Horses.(VisualMount).xdb#xpointer(/client.VisualConstructor.VisualMount)" />
      </mountsList>
      <checkIsInTheList>true</checkIsInTheList>
      <checkOnStartOnly>true</checkOnStartOnly>
    </playWhile>
    <preconditional>false</preconditional>
    <restartOnVisualChange>true</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
</CreatureVisActionResource>