                    </scalerTarget>
                    <mode>Pure</mode>
                    <considerOutgoingModifiers>false</considerOutgoingModifiers>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
