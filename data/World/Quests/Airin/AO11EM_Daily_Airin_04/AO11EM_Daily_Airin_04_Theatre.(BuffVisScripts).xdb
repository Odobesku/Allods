<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.SLON.WeatherCreatureVisAction">
        <params>
          <ambientSoundImpact>Nothing</ambientSoundImpact>
          <colorGradingSettings />
          <fadeTime>1</fadeTime>
          <light>
            <AmbientColor>-13554105</AmbientColor>
            <AmbientFactor>0</AmbientFactor>
            <ContourColor>3349859</ContourColor>
            <DiffuseColor>-11309637</DiffuseColor>
            <FadeEnd>560</FadeEnd>
            <FadeStart>500</FadeStart>
            <FogColor>-15067345</FogColor>
            <FogEnd>350</FogEnd>
            <FogStart>0</FogStart>
            <GrassContourColorMultiplier>-1</GrassContourColorMultiplier>
            <PointLightColor>-11913109</PointLightColor>
            <SelfIllumColor>2017861120</SelfIllumColor>
            <SpecularColor>0</SpecularColor>
            <SpecularWaterColor>2364179</SpecularWaterColor>
            <SunLightPitch>15</SunLightPitch>
            <SunLightYaw>70</SunLightYaw>
            <TerrainContourColor>0</TerrainContourColor>
            <TerrainContourPower>0</TerrainContourPower>
            <TerrainSpecularColor>3349859</TerrainSpecularColor>
            <WaterGradientEnd>-6380580</WaterGradientEnd>
            <WaterGradientStart>-9079435</WaterGradientStart>
            <desaturation>0</desaturation>
            <minAmbientOcclusionValue>0</minAmbientOcclusionValue>
            <objectsLightmapBias>0.0125</objectsLightmapBias>
            <terrainLightmapBias>0.01</terrainLightmapBias>
          </light>
          <posteffectFogSettings>
            <brightness>1</brightness>
            <color>-1</color>
            <colorUp>-1</colorUp>
            <densityDown>0</densityDown>
            <densityUp>0</densityUp>
            <distanceSettings>
              <falloff>0.5</falloff>
              <maxDistance>400</maxDistance>
              <minDistance>0</minDistance>
            </distanceSettings>
            <heightSettingsDown>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsDown>
            <heightSettingsUp>
              <falloff>0.5</falloff>
              <maxDistance>50</maxDistance>
              <minDistance>-50</minDistance>
            </heightSettingsUp>
            <sunSettings>
              <brightness>0.2</brightness>
            </sunSettings>
            <use>false</use>
          </posteffectFogSettings>
          <priority>MEDIUM</priority>
          <skyMesh href="/World/Sky/Chargen_Elf.(SkyMesh).xdb#xpointer(/client.VisualConstructor.SkyMesh)" />
          <hasLight>true</hasLight>
          <playInBuildings>true</playInBuildings>
        </params>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>