																					</impactsIf>
																					<impactsElse>
																						<Item type="gameMechanics.constructor.basicElements.ImpactList">
																							<impactsResource href="GiveUnlock.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
																						</Item>
																					</impactsElse>
																				</Item>
																			</defaultImpacts>
																		</Item>
																	</impactsIf>
																</Item>
															</impacts>
														</Item>
													</impactsIf>
												</Item>
											</impacts>
										</Item>
										<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
											<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMapHead" />
											<impacts>
												<Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
													<variable href="/Mechanics/InstanceModifiers/BossCounters/FinalBossCounter.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
													<summand>-1</summand>
												</Item>
											</impacts>
										</Item>
									</impactsIf>
								</Item>
								<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
									<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMapHead" />
									<impacts>
										<Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
											<variable href="/Mechanics/InstanceModifiers/BossCounters/BossCounter.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
											<summand>-1</summand>
										</Item>
									</impacts>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</effectsIf>
		</Item>
	</effects>
</gameMechanics.constructor.basicElements.EffectListResource>
