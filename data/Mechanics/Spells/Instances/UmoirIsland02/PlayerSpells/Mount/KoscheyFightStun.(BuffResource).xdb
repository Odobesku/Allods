<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739856061</resourceId>
	</Header>
	<visScript href="KoscheyFightStun.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactTeleport">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>KoscheyDungeon</scriptID>
									<map href="/Maps/UmoirIsland02/MapResource.xdb" />
								</locator>
							</destination>
							<finishImpacts>
								<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
									<id href="/World/Quests/UmoirIsland02/UI02_Q01/Counter04.(QuestCountId).xdb" />
								</Item>
							</finishImpacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="KoscheyFight.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
					</impactsIf>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
		</Item>
	</effects>
	<duration>9000</duration>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
