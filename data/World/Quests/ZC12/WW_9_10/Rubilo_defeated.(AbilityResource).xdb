<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739951985</resourceId>
    </Header>
    <visualScript type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>sleep</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
                <channelOverrideControllers>TOP_ONLY</channelOverrideControllers>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/Stun.(VisObjectTemplate).xdb" />
                        <locator>Slot_Head</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Rubilo_defeated.(Plane).xdb" />
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>