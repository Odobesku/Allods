                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateYear">
                                    <year>2016</year>
                                </Item>
                                <Item type="gameMechanics.elements.predicates.PredicateTimeInIntervalGeneric">
                                    <interval href="/Mechanics/Spells/ItemSpells/PvPWing/2015PvPWing2.(TimeIntervalTable).xdb" />
                                </Item>
                            </predicates>
