<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739924138</resourceId>
	</Header>
	<visScript href="/Spells/VisScripts/Creatures/OgrCharge.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
			<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>2</coeff>
			</effectScaler>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.EffectForcePull">
					<destination type="gameMechanics.map.destination.RelativeRotatePos">
						<base type="gameMechanics.map.destination.SelfPosDestination" />
						<offset>30</offset>
						<yaw type="constructor.basicElements.AngleDegrees" />
						<turn>ToBase</turn>
					</destination>
					<impactsOnArrived>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Ogre_charge.(BuffResource).xdb" />
						</Item>
					</impactsOnArrived>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>Enemies</affectGroup>
			<radius>6</radius>
			<filter type="gameMechanics.world.creature.CreatureFilter" />
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
					<time>1000</time>
					<impactsOnLand>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
						</Item>
					</impactsOnLand>
					<distance>10</distance>
				</Item>
				<Item type="gameMechanics.elements.impacts.TagMobForKill" />
				<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
					<value>500</value>
				</Item>
				<Item type="gameMechanics.elements.impacts.DirectDamage">
					<damage>1</damage>
					<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
							<multiplier>0.18</multiplier>
						</mulCalcer>
					</scalerTarget>
				</Item>
			</impactsIn>
		</Item>
	</effects>
	<duration>4000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
