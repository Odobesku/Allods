    </persistentParts>
    <visMob href="/Mechanics/Astral/Mobs/Single/Instances/TL8/AstralBoss.(VisualMob).xdb#xpointer(/VisualMob)" />
    <quality href="/Mechanics/MobQualities/AstralMob.(MobQuality).xdb#xpointer(/gameMechanics.world.mob.MobQuality)" />
