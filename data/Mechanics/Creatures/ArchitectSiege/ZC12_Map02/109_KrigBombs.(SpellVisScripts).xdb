<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/PortalBoss_TelekinesisCenter_01.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>2500</time>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>special01</Item>
						</animations>
						<advanced>
							<speed>0.6</speed>
						</advanced>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<offendTime type="EffectOffendConstDelay" />
			</Item>
		</visualEffects>
	</launch>
</SpellVisScripts>
