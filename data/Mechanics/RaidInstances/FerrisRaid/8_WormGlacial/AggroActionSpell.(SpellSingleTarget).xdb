<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>221496</resourceId>
    </Header>
    <Name href="AggroActionSpell.(SpellSingleTarget).Name.txt" />
    <Description href="AggroActionSpell.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/KickUpgrade.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Warrior/HowlingStrike.(SpellVisScripts).xdb" />
    <prepareDuration>1000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                <time>2000</time>
                <impactsOnLand>
                    <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                                        <impacts>
                                                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                                <predicates>
                                                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                                        <mobs>
                                                                            <Item href="WormGlacialBoss/WormGlacialBoss.(MobWorld).xdb" />
                                                                        </mobs>
                                                                    </Item>
                                                                </predicates>
                                                                <impactsIf>
                                                                    <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                                        <value>1</value>
                                                                    </Item>
                                                                    <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                                                                        <zone href="AggroZone.(ScriptZone).xdb" />
                                                                    </Item>
                                                                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                                        <impacts>
                                                                            <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                                                                <impacts>
                                                                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                                                        <predicates>
                                                                                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                                                                <mobs>
                                                                                                    <Item href="WormGlacialBoss/WormGlacialBossFake.(MobWorld).xdb" />
                                                                                                </mobs>
                                                                                            </Item>
                                                                                        </predicates>
                                                                                        <impactsIf>
                                                                                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                                                                <impacts>
                                                                                                    <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                                                                                </impacts>
                                                                                            </Item>
                                                                                        </impactsIf>
                                                                                    </Item>
                                                                                </impacts>
                                                                                <spawnResource href="WormBoss.(SpawnTable).xdb" />
                                                                            </Item>
                                                                        </impacts>
                                                                    </Item>
                                                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                                        <predicates>
                                                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                                                <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                                                            </Item>
                                                                        </predicates>
                                                                        <impactsElse>
                                                                            <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                                                                                <table href="RepairParts.(SpawnTable).xdb" />
                                                                            </Item>
                                                                        </impactsElse>
                                                                    </Item>
                                                                </impactsIf>
                                                            </Item>
                                                        </impacts>
                                                        <spawnResource href="WormBoss.(SpawnTable).xdb" />
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="/Spells/ClientData/HowlingStrike.(ClientData).xdb" />
                    </Item>
                </impactsOnLand>
                <destination type="gameMechanics.map.destination.RelativePos">
                    <yaw type="constructor.basicElements.AngleDegrees" />
                    <coord x="1" z="1" />
                </destination>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>