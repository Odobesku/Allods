<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>Tab02</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <Size>64</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Size>40</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>features_tab_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="1"/>
            <Reaction>features_tab_pressed</Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabSelected.txt"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabNormal.txt"/>
                <LayerMain href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <FormatFileRef href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabSelected.txt"/>
                <LayerMain href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabSelected.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabLabel02.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="0"/>
            <Reaction>features_tab_pressed</Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabSelected.txt"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabSelected.txt"/>
                <LayerMain href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabSelected.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextCharacter2/FrameFeaturesTabLabel02.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
