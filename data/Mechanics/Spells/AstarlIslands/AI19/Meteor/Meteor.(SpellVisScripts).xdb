<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>500</time>
			</Item>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Spells/AoE_Aura_AI19.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<isRelative>false</isRelative>
				<useCastPoint>true</useCastPoint>
				<lifeTime>3</lifeTime>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirectedWand</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectFireWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Wand_Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedWand</Item>
				</animations>
				<advanced>
					<offendType>EVERYKEY_OFFEND</offendType>
				</advanced>
			</Item>
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/MageFireballAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Spells/HitFireball2.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<theGe>5</theGe>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<locator>Slot_FX</locator>
				</Item>
			</visualEffects>
			<stopOnDeath>true</stopOnDeath>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
