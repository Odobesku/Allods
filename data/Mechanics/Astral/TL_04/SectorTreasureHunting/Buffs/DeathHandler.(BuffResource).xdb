<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>271972371</resourceId>
	</Header>
	<Name href="DeathHandler.txt" />
	<Description href="DeathHandler.Description.txt" />
	<image href="/Interface/Icons/Misc/AstralShip.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<needVisualizeDuration>false</needVisualizeDuration>
	<nameTemplate href="DeathHandler.txt" />
	<descTemplate href="DeathHandler.Description.txt" />
	<effects>
		<Item type="gameMechanics.world.ship.elements.effects.EffectShipDieHard">
			<impactsOnAttach>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/Ships/ShipDieHard.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/Ships/ShipDamageSuppressor.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>2</multiplier>
					</durationScaler>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactOnShipCrew">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIncrementBuffDuration">
									<buff href="Instability.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									<anyRank>false</anyRank>
									<delta type="gameMechanics.elements.calcers.CalcerMul">
										<calcers>
											<Item type="gameMechanics.elements.calcers.FloatData">
												<value>-180000</value>
											</Item>
											<Item type="gameMechanics.elements.calcers.CalcerMin">
												<calcers>
													<Item type="gameMechanics.elements.calcers.FloatData">
														<value>1</value>
													</Item>
													<Item type="gameMechanics.elements.calcers.CalcerMul">
														<calcers>
															<Item type="gameMechanics.elements.calcers.InverseCalcer">
																<value type="gameMechanics.elements.calcers.FloatData">
																	<value>185000</value>
																</value>
															</Item>
															<Item type="gameMechanics.elements.calcers.CalcerBuffDuration">
																<buff href="Instability.(BuffResource).xdb" />
																<multiplier>1</multiplier>
															</Item>
														</calcers>
													</Item>
												</calcers>
											</Item>
										</calcers>
									</delta>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
					<delay>5500</delay>
					<impacts>
						<Item type="gameMechanics.world.ship.elements.ImpactEmergencyTeleport">
							<impactsOnArrive>
								<Item type="gameMechanics.world.ship.elements.ImpactCoolReactor" />
								<Item type="gameMechanics.world.ship.elements.ImpactSetSpeed">
									<speedMod>0</speedMod>
								</Item>
								<Item type="gameMechanics.world.ship.elements.ImpactRudderTurn">
									<omegaMod>0</omegaMod>
								</Item>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="/Mechanics/Astral/TL_04/SectorTreasureHunting/Hublinks/HublinkLock.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="ShipRepair.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
								<Item type="gameMechanics.constructor.basicElements.ImpactList">
									<impactsResource href="/Mechanics/Ships/ShipDieHard_AfterTeleportFX.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
								</Item>
							</impactsOnArrive>
						</Item>
					</impacts>
				</Item>
			</impactsOnAttach>
			<priority>-10</priority>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
					<delay>0</delay>
					<impacts>
						<Item type="gameMechanics.world.ship.elements.ImpactScanAllHubs" />
					</impacts>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="/Mechanics/Rules/Astral/TreasureHunting/BuffChestOnShip.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.RepeatedImpactsGeneric">
							<impacts>
								<Item type="gameMechanics.constructor.basicElements.ImpactList">
									<impactsResource href="/Mechanics/Rules/Astral/TreasureHunting/ImpactsOnSector/BuffImpacts.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
								</Item>
							</impacts>
							<count type="gameMechanics.elements.calcers.CalcerLongMulFloat">
								<calcerLong type="gameMechanics.elements.calcers.LongData">
									<value>1</value>
								</calcerLong>
								<calcerFloat type="gameMechanics.elements.calcers.BuffStackCountCalcer">
									<buff href="/Mechanics/Rules/Astral/TreasureHunting/BuffChestOnShip.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									<forAllRanks>true</forAllRanks>
								</calcerFloat>
							</count>
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="/Mechanics/Rules/Astral/TreasureHunting/BuffChestOnShip.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.world.ship.elements.ImpactReturnShipToSavedPos" />
					</impactsIf>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.EffectShipDieHardTrigger">
					<toKillerImpacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Mechanics/Ships/BuffDespawn.(BuffResource).xdb" />
								</Item>
							</predicates>
							<elseImpacts>
								<Item type="gameMechanics.elements.impacts.ImpactsIfGeneric">
									<predicate type="gameMechanics.constructor.basicElements.BinaryPredicateAnd">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateNotMaster" />
											<Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
												<onSlave type="gameMechanics.world.ship.elements.PredicateIsShip" />
											</Item>
										</predicates>
									</predicate>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
											<predicates>
												<Item type="gameMechanics.constructor.basicElements.PredicateNot">
													<predicate type="gameMechanics.elements.resources.ResourceBuff">
														<buff href="ShipSlayerComplete.(BuffResource).xdb" />
													</predicate>
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="ShipSlayer.(BuffResource).xdb" />
												</Item>
											</impactsIf>
										</Item>
									</impactsIf>
								</Item>
							</elseImpacts>
						</Item>
					</toKillerImpacts>
				</Item>
			</effects>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Ships/Astrolabe/AstrolabeDisabler.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
