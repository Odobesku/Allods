<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739904378</resourceId>
	</Header>
	<Name href="ChargeBuff.(BuffResource).Name.txt" />
	<Description href="ChargeBuff.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Mounts/ChargeRhino.(UISingleTexture).xdb" />
	<visScript href="Charge/Charge.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.RunImpactsInShape">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
									<impactsOnHitTarget>
										<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
											<time>1000</time>
											<distance>12</distance>
										</Item>
									</impactsOnHitTarget>
									<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
									<minDamage>25</minDamage>
									<maxDamage>25</maxDamage>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<shape type="gameMechanics.constructor.schemes.spell.area.RectangularRay">
						<width>5</width>
					</shape>
					<affectGroup>All</affectGroup>
					<radius type="gameMechanics.elements.impacts.RunImpactsInShape$FixedRadius">
						<value>10</value>
					</radius>
				</Item>
			</impacts>
			<tick>500</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableLocalEvade" />
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.EffectNoAggro" />
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Rotate</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectForceMove">
			<destinations>
				<Item type="gameMechanics.map.destination.RelativeRotatePos">
					<base type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
					<offset>2</offset>
					<yaw type="constructor.basicElements.AngleDegrees" />
				</Item>
			</destinations>
			<impactsOnArrived>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ChargeBuff.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/Wait.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
					<pool href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChieftainBoss/Charge/TargetDecales.(SummonPool).xdb" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>6</radius>
					<affectGroup>Enemies</affectGroup>
					<affectHolder>false</affectHolder>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
							<impactsOnHitTarget>
								<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
									<time>800</time>
									<distance>10</distance>
								</Item>
							</impactsOnHitTarget>
							<scaler type="gameMechanics.elements.scalers.WeaponScaler" />
							<minDamage>30</minDamage>
							<maxDamage>30</maxDamage>
						</Item>
					</impacts>
					<filter type="gameMechanics.constructor.basicElements.FilterAnd">
						<filters>
							<Item type="gameMechanics.world.creature.AvatarFilter" />
							<Item type="gameMechanics.world.creature.AliveFilter" />
						</filters>
					</filter>
				</Item>
			</impactsOnArrived>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
			<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>1.6</coeff>
			</effectScaler>
		</Item>
	</effects>
	<duration>6000</duration>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
