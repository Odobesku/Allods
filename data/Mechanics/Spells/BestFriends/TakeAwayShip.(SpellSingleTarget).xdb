<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739833300</resourceId>
	</Header>
	<Name href="TakeAwayShip_Name.txt" />
	<Description href="TakeAwayShip_Desc.txt" />
	<nameTemplate href="TakeAwayShip_Name.txt" />
	<prepareDuration>10000</prepareDuration>
	<targetType>STTSelf</targetType>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateHasBestFriends" />
			<Item type="gameMechanics.world.ship.elements.PredicateInHangar" />
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.world.ship.elements.ImpactTakeAwayShip">
				<shipIndex type="gameMechanics.elements.calcers.CalcerLongParam">
					<paramName>shipIndex</paramName>
				</shipIndex>
				<iWantMyShipClientData href="IWantMyShip.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				<shipIsOnlineClientData href="ShipIsOnlineClientData.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
			</Item>
		</casterImpacts>
	</mechanics>
	<params>
		<params>
			<Item>
				<name>shipIndex</name>
				<type>Int</type>
			</Item>
		</params>
	</params>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
