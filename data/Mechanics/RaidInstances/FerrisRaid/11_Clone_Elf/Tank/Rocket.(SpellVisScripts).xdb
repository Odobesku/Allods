<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Items/RPG_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.5</scale>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/Items/RPG_Channeling.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<startPoint type="VisPointLocator">
					<locator>FROM_LOCATOR_NAME</locator>
					<locatorName>Slot_Special01</locatorName>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
				<fadeInTime>100</fadeInTime>
				<fadeOutTime>100</fadeOutTime>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
