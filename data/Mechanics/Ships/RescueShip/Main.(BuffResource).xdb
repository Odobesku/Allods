<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739881604</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddMapSpecificEffectsGeneric">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectShipDespawnTrigger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                            <impactsResource href="Summon.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                            <destination type="gameMechanics.map.destination.DestinationLocalLocator">
                                                <scriptID>IslandEntrance</scriptID>
                                            </destination>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.world.ship.elements.effects.EffectNoBoundTrigger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                            <impactsResource href="Summon.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </effects>
            <filter type="gameMechanics.world.ship.ShipFilter" />
        </Item>
        <Item type="gameMechanics.elements.effects.AddMapSpecificEffectsGeneric">
            <effects>
                <Item type="gameMechanics.elements.effects.TriggerMapKicker">
                    <cause>InvalidMap</cause>
                    <impactsAdd>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Leaver.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.world.ship.elements.PredicateOnBoundShip">
                                    <predicates>
                                        <Item type="gameMechanics.world.ship.elements.PredicateShipOwner" />
                                    </predicates>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactDespawnShip" />
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsAdd>
                </Item>
            </effects>
            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                <filters>
                    <Item type="gameMechanics.world.creature.AliveFilter" />
                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                </filters>
            </filter>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>