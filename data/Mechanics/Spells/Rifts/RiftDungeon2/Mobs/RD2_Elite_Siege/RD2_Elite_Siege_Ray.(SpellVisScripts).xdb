<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureRotateToCastPointAction" />
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>100</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureLockRotationAction" />
							<Item type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="RD2_Elite_Siege_Ray.(VisObjectTemplate).xdb" />
										<lockScale>true</lockScale>
									</Item>
								</visualEffects>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="VisActionDelay">
				<time>1500</time>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="CreatureAnimationAction">
					<animations>
						<Item>spellCastDirected</Item>
					</animations>
					<channel>CHANNEL_KNOCKDOWN</channel>
					<advanced>
						<speed>1.8</speed>
					</advanced>
				</playWhile>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>100</delay>
								<effectFx href="/Spells/FX/Mobs/TripodPortal_DesintegrationRay.(VisObjectTemplate).xdb" />
								<fixPoint>true</fixPoint>
								<lockScale>true</lockScale>
								<scale>2</scale>
								<locator>Slot_BodyFX</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
