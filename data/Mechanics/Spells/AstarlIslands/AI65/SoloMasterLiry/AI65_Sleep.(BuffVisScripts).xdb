<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>sleep</Item>
				</animations>
				<channel>CHANNEL_DEATH</channel>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/DruidDrowsingPotion_buff.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.4</scale>
						<locator>Slot_BodyFX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
	<restartOnIncStackCount>true</restartOnIncStackCount>
</BuffVisScripts>
