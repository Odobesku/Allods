<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>208241</resourceId>
    </Header>
    <Name href="DemonWarriorElite_Pull.(SpellSingleTarget).Name.txt" />
    <visualScripts href="DemonWarriorElite_Pull.(SpellVisScripts).xdb" />
    <prepareDuration>1000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>14000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="Boss01/DemonBoss01_Enrage.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                    <range min="1" max="40" />
                    <withinRange>true</withinRange>
                    <minCandidatesCount>0</minCandidatesCount>
                    <targetCount>0</targetCount>
                </selector>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
                <impacts>
                    <Item>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                                <time>1000</time>
                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="DemonWarriorElite_Pull.(ClientData).xdb" />
                                <calcers>
                                    <addressEntries>
                                        <Item>
                                            <name>caster</name>
                                            <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                        </Item>
                                        <Item>
                                            <name>target</name>
                                            <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                        </Item>
                                    </addressEntries>
                                </calcers>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/Rifts/Abilities/StopBuff.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.RandomImpact">
                        <entries>
                            <Item>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                                        <spell href="Boss01/DemonBoss01_Enrage.(SpellSingleTarget).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                            <Item>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                                        <spell href="Boss01/DemonBoss01_AEHit.(SpellArea).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </entries>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>