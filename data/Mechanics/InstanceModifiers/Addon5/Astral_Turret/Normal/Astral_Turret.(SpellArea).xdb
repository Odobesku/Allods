<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739871865</resourceId>
    </Header>
    <element>ACID</element>
    <Name href="Astral_Turret.(SpellArea).Name.txt" />
    <visualScripts href="Astral_Turret.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>50</value>
    </range>
    <prepareDuration>5000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                    </Item>
                </predicates>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
                    <groups>
                        <Item href="/Mechanics/InstanceModifiers/Addon5/Not_Astral_Modifiers.(ActionGroup).xdb" />
                    </groups>
                </predicate>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeDestination">
                        <to type="gameMechanics.elements.calcers.DestinationSpellTargetThrust">
                            <maxDist>15</maxDist>
                        </to>
                    </moveType>
                    <resource href="Astral_Turret.(ProjectileResource).xdb" />
                </projectileData>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Astral_Turret_NoRotate.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
    </mechanics>
    <speed>1</speed>
    <radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>