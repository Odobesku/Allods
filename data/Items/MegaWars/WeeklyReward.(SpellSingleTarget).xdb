<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>519317</resourceId>
    </Header>
    <Name href="WeeklyReward.(SpellSingleTarget).Name.txt" />
    <Description href="WeeklyReward.(SpellSingleTarget).Description.txt" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasGuildTabardRight">
                        <tabardType>Champion</tabardType>
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateResourceReady">
                        <resource href="/Items/GuildItems/GuildChampionTabard.xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/Items/Agents/ShiningFragment_70.(ItemResource).xdb" />
                        </item>
                        <count type="gameMechanics.elements.calcers.FloatToLongCalcer">
                            <calcer type="gameMechanics.elements.calcers.CalcerMul">
                                <calcers>
                                    <Item type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
                                        <currency href="/Mechanics/AlternativeCurrencies/MWrewardCurrency.(AlternativeCurrency).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.calcers.FloatData">
                                        <value>2.5</value>
                                    </Item>
                                </calcers>
                            </calcer>
                        </count>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasGuildTabardRight">
                                <tabardType>Common</tabardType>
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateResourceReady">
                                <resource href="/Items/GuildItems/GuildTabard.xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateResourceReady">
                                <resource href="/Items/GuildItems/GuildChampionTabard.xdb" />
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactGiveItemsCount">
                                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                    <item href="/Items/Agents/ShiningFragment_70.(ItemResource).xdb" />
                                </item>
                                <count type="gameMechanics.elements.calcers.FloatToLongCalcer">
                                    <calcer type="gameMechanics.elements.calcers.AlternativeCurrencyCalcer">
                                        <currency href="/Mechanics/AlternativeCurrencies/MWrewardCurrency.(AlternativeCurrency).xdb" />
                                    </calcer>
                                </count>
                            </Item>
                        </impactsIf>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>