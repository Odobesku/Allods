<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>spellCastDirected</Item>
        </animations>
    </actionBarStart>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureVisActionStartThrow" />
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Spells/StalkerGibber_ProjectTail.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_Hand_L</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </pointOnTarget>
                <offendTime type="EffectOffendConstDelay" />
            </Item>
        </elements>
    </launch>
</SpellVisScripts>