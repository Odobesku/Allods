<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>specialCast</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect01Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>2</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>7000</time>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/YetiBoss_Spikes_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
