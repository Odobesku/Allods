<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>10000</time>
		</playWhile>
		<elements>
			<Item type="CreatureChannelDirectAction">
				<channelingFx href="/Spells/FX/Spells/BattleStation_FireRay.(VisObjectTemplate).xdb" />
				<fxLength>14</fxLength>
				<startPoint type="VisPointLocator">
					<shift y="0" z="1.25" />
					<locator>Slot_Global</locator>
				</startPoint>
				<endPoint type="VisPointLocator">
					<locator>Slot_FX</locator>
				</endPoint>
				<multyTargetMode>Umbrella</multyTargetMode>
			</Item>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBossSpear_Fire.(VisObjectTemplate).xdb" />
						<scale>5</scale>
						<locator>Slot_FX</locator>
						<offset y="0.4" z="0.25" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellDirected</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/OpFirework_Rocket01Red.(VisObjectTemplate).xdb" />
						<locator>Slot_Global</locator>
						<offset y="0" z="1.25" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/PierBossSpear_Fire.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<scale>5</scale>
						<locator>Slot_Global</locator>
						<offendTime />
						<offset z="1.25" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
