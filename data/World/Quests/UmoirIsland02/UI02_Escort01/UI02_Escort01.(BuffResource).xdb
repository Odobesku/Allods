<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739846860</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Mobparts/EyeAnimal.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <nameTemplate href="/Mechanics/QuestSchemes/Maintenance/SeeCopyQuestGiver.(BuffResource)_Name.txt.template" />
    <descTemplate href="/Mechanics/QuestSchemes/Maintenance/SeeCopyQuestGiver.(BuffResource)_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                            <table href="/Maps/UmoirIsland02/SpawnTables/OldManInWoods.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                            <quest href="/World/Quests/UmoirIsland02/UI02_Q00/UI02_Q00.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EventTrigger">
            <eventClasses>
                <Item>gameMechanics.world.mob.behaviour.aiEvents.GoneThroughPathEvent</Item>
            </eventClasses>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                            <id href="/World/Quests/UmoirIsland02/UI02_Q00/Counter02.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="/Maps/UmoirIsland02/SpawnTables/OldManVillage.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.Aura">
                    <radius>8</radius>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Speed.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="Speed.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOut>
                </Item>
                <Item type="gameMechanics.elements.effects.Aura">
                    <radius>30</radius>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="StopMovement.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="StopMovement.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                            <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                            <data href="/Mechanics/QuestSchemes/Maintenance/StopMovementData.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsOut>
                </Item>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <affectGroup>All</affectGroup>
                    <radius>30</radius>
                    <filter type="gameMechanics.world.creature.MobFilter" />
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Creatures/UmoirRabbit/Instances/UmoirIsland02/UI02_EscortRabbit.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="UI02_MorphRabbit.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsIn>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectUnworthyOfAttention" />
            </effects>
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>