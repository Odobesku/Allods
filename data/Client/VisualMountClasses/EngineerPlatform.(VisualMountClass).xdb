	</animationSettings>
	<fxSettings>
		<mountLocators>
			<Item>Slot_FX</Item>
			<Item>Slot_Global</Item>
			<Item>Global</Item>
		</mountLocators>
	</fxSettings>
	<controlParameters>
		<speedFactorForward>
			<startVelocity>12</startVelocity>
			<stopVelocity>2</stopVelocity>
			<startTime>200</startTime>
			<stopTime>150</stopTime>
		</speedFactorForward>
		<speedFactorBackward>
			<startVelocity>3</startVelocity>
			<stopVelocity>0</stopVelocity>
			<startTime>0</startTime>
			<stopTime>0</stopTime>
		</speedFactorBackward>
	</controlParameters>
	<pitchParameters>
		<minVelocity>0.4</minVelocity>
		<minVelocityPitch>3</minVelocityPitch>
		<topVelocity>8</topVelocity>
		<topVelocityPitch>15</topVelocityPitch>
		<minStepDeltaTMainAvatar>50</minStepDeltaTMainAvatar>
		<minStepDeltaT>150</minStepDeltaT>
		<minTurnRadius>20</minTurnRadius>
		<pitchMaxVelocity>10</pitchMaxVelocity>
		<maxPitch>30</maxPitch>
	</pitchParameters>
	<jumpSettings>
		<specialJumpPause>3500</specialJumpPause>
		<specialJump href="SpecialJump.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
	</jumpSettings>
	<reinsSettings>
		<use>false</use>
		<reinsBone />
		<handBone />
		<reinsBone01/>
		<handBone01/>
		<member>Assaulter</member>
		<disablingAnimations href="Horse/DisableReins.(CharacterAnimationsGroup).xdb#xpointer(/CharacterAnimationsGroup)" />
	</reinsSettings>
	<skinChangedScript href="/Spells/VisScripts/Commands/ChangeSkin.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<levelChangedScript href="/Spells/VisScripts/Commands/LevelUp_Mount.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<summonVisualScript href="/Spells/VisScripts/Mount/SummonCommonHorse.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<sitAnimation>mountRideSit</sitAnimation>
	<riderOrientation>All_FromMountSlot</riderOrientation>
	<useRiderSpineTurn>false</useRiderSpineTurn>
	<hiddenDressSlots />
</VisualMountClass>
