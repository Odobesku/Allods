<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739870299</resourceId>
    </Header>
    <Name href="AI08_Summon.(SpellSingleTarget).Name.txt" />
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.DestinationModified">
                    <destination type="gameMechanics.map.destination.RelativePos" />
                    <modifiers>
                        <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                            <verticalRange min="0" max="0" />
                            <horizontalRange min="5" max="5" />
                        </Item>
                    </modifiers>
                </destination>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                    <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                </impacts>
                <object href="AI08_Add_Death.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                <pool href="AI08_Add_DeSummon.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>