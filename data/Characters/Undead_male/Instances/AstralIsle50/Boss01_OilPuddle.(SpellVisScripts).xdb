<?xml version ="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <Description href="/Spells/VisScripts/Prototypes/Parts/Base.Description.txt"/>
    <actionBarStart type="VisActionList">
        <visActionID></visActionID>
        <elements>
            <Item type="CreatureRunVisActionResource">
                <visActionID></visActionID>
                <resource href="/Spells/VisScripts/Prototypes/PreCastAnimationDirect.(CreatureVisActionResource).xdb#xpointer(/client.VisualConstructor.CreatureVisActionResource)"/>
            </Item>
            <Item type="CreatureRunVisActionResource">
                <visActionID></visActionID>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </actionBarStart>
    <precastType>PRECAST_DEFAULT</precastType>
    <wholeCasting type="VisActionList">
        <visActionID></visActionID>
        <elements>
            <Item type="CreatureRunVisActionResource">
                <visActionID></visActionID>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </wholeCasting>
    <charged type="CreatureChargedSpellAction">
        <visActionID></visActionID>
        <effectLocator>Wand_Slot_FX</effectLocator>
        <fadeInTime>0</fadeInTime>
        <fadeOutTime>0</fadeOutTime>
    </charged>
    <launch type="VisActionList">
        <visActionID></visActionID>
        <elements>
            <Item type="CreatureAnimationAction">
                <visActionID></visActionID>
                <advanced>
                    <autoHasten>
                        <mode>AUTOHASTEN_NONE</mode>
                        <timeToBeLeft>0</timeToBeLeft>
                    </autoHasten>
                    <changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
                    <channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
                    <offendType>NO_OFFEND</offendType>
                    <turnToTarget>TURN_DEFAULT</turnToTarget>
                    <waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                    <denyAutoHasten>false</denyAutoHasten>
                    <disableRandomFirstFrame>true</disableRandomFirstFrame>
                    <eventPlaybackEnd>true</eventPlaybackEnd>
                    <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                    <stopIfMoved>false</stopIfMoved>
                    <stopIfRotated>false</stopIfRotated>
                </advanced>
                <animations>
                    <Item>throwWeapon</Item>
                </animations>
                <channel>CHANNEL_ABILITY</channel>
                <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                <mode>DIE</mode>
                <specialController></specialController>
                <use>USE_ANIMATIONS</use>
                <dontFreezePrecast>true</dontFreezePrecast>
            </Item>
            <Item type="VisActionList">
                <visActionID></visActionID>
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visActionID></visActionID>
                        <category>EFFECT_DEFAULT</category>
                        <visualEffects>
                            <Item>
                                <delay>0</delay>
                                <effectAnimations>
                                    <mode>DIE</mode>
                                </effectAnimations>
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <scale>1</scale>
                                <fixPoint>false</fixPoint>
                                <lockScale>false</lockScale>
                                <muteFxSounds>true</muteFxSounds>
                                <ignoreParentRotation>false</ignoreParentRotation>
                                <locator>Slot_Hand_R</locator>
                                <member>Default_Member</member>
                                <offset x="0" y="0" z="0"/>
                                <rotation x="0" y="0" z="0" w="0"/>
                                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                            </Item>
                            <Item>
                                <delay>0</delay>
                                <effectAnimations>
                                    <mode>DIE</mode>
                                </effectAnimations>
                                <fadeInTime>0</fadeInTime>
                                <fadeOutTime>0</fadeOutTime>
                                <scale>1</scale>
                                <fixPoint>true</fixPoint>
                                <lockScale>false</lockScale>
                                <muteFxSounds>false</muteFxSounds>
                                <ignoreParentRotation>false</ignoreParentRotation>
                                <locator>Wand_Slot_FX</locator>
                                <locatorName></locatorName>
                                <member>Default_Member</member>
                                <offset x="0" y="0" z="0"/>
                                <rotation x="0" y="0" z="0" w="0"/>
                                <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                            </Item>
                        </visualEffects>
                        <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                        <stopOnDeath>false</stopOnDeath>
                    </Item>
                    <Item type="VisActionList">
                        <visActionID></visActionID>
                        <elements>
                            <Item type="CreatureVisActionStartThrow">
                                <visActionID></visActionID>
                            </Item>
                            <Item type="CreatureProjectileAction">
                                <visActionID></visActionID>
                                <explosionFx href="/Spells/FX/Spells/ThrowBottlePoison_Hit_Small.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                                <offendTime type="EffectOffendConstDelay">
                                    <delay>0</delay>
                                </offendTime>
                                <pointOnCaster type="VisPointLocator">
                                    <from>FROM_DEFALUT</from>
                                    <locator>Slot_Hand_R</locator>
                                    <member>Default_Member</member>
                                </pointOnCaster>
                                <pointOnTarget type="VisPointLocator">
                                    <from>FROM_DEFALUT</from>
                                    <locator>Slot_Global</locator>
                                    <member>Default_Member</member>
                                </pointOnTarget>
                                <projectileFx href="/Spells/FX/Mobs/MindFlayerMageMazeBoss_BottleProjectile.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)"/>
                                <theGe>5</theGe>
                                <isInverted>false</isInverted>
                                <isMultyProjectile>false</isMultyProjectile>
                            </Item>
                        </elements>
                        <play>InSequence</play>
                        <preconditional>false</preconditional>
                        <restartOnVisualChange>false</restartOnVisualChange>
                        <stopOnDeath>false</stopOnDeath>
                        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
                    </Item>
                </elements>
                <play>Simultaneously</play>
                <preconditional>false</preconditional>
                <restartOnVisualChange>false</restartOnVisualChange>
                <stopOnDeath>false</stopOnDeath>
                <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
            </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </launch>
    <ownKillingParams>
        <probabilityNoOverkill>0.2</probabilityNoOverkill>
        <probabilityWithOverkill>1</probabilityWithOverkill>
    </ownKillingParams>
    <playOnTargets>
        <specialAction type="VisActionList">
            <visActionID></visActionID>
            <elements>
                <Item type="CreatureEffectsAction">
                    <visActionID></visActionID>
                    <category>EFFECT_DEFAULT</category>
                    <visualEffects>
                        <Item>
                            <delay>0</delay>
                            <effectAnimations>
                                <mode>DIE</mode>
                            </effectAnimations>
                            <fadeInTime>0</fadeInTime>
                            <fadeOutTime>0</fadeOutTime>
                            <scale>1</scale>
                            <fixPoint>true</fixPoint>
                            <lockScale>false</lockScale>
                            <muteFxSounds>false</muteFxSounds>
                            <ignoreParentRotation>false</ignoreParentRotation>
                            <locator>Slot_FX</locator>
                            <member>Default_Member</member>
                            <offset x="0" y="0" z="0"/>
                            <rotation x="0" y="0" z="0" w="0"/>
                            <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                        </Item>
                    </visualEffects>
                    <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                    <stopOnDeath>false</stopOnDeath>
                </Item>
                <Item type="CreatureRunVisActionResource">
                    <visActionID></visActionID>
                    <resource href="/Spells/VisScripts/HitPostFxOnTarget/HitPoisonShader.(CreatureVisActionResource).xdb#xpointer(/client.VisualConstructor.CreatureVisActionResource)"/>
                </Item>
            </elements>
            <play>Simultaneously</play>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
        </specialAction>
        <skipBloodFx>false</skipBloodFx>
        <skipHitAnimations>false</skipHitAnimations>
    </playOnTargets>
    <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>
