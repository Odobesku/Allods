<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>316980</resourceId>
    </Header>
    <visualScript type="VisActionLoopAction">
        <actionToLoop type="CreatureAnimationAction">
            <use>USE_RANDOM_FROM_LIST</use>
            <animations>
                <Item>spellCastOmni</Item>
                <Item>spellCastDirected</Item>
                <Item>hitCritical</Item>
                <Item>knockdownEnd</Item>
            </animations>
            <advanced>
                <denyAutoHasten>true</denyAutoHasten>
            </advanced>
        </actionToLoop>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="ArchitectSiege_plane.(Plane).xdb" />
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>