<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>204125</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DragonRelic5.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <element>ASTRAL</element>
    <image href="/Interface/Icons/Spells/Psionic/AstralBreath.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="/Spells/VisScripts/Psionic/Suffocate.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="Spell_Name.txt.template" />
    <descTemplate href="Spell_Desc.txt.template" />
    <level>1</level>
    <prepareDuration>8000</prepareDuration>
    <immutablePrepareDuration>false</immutablePrepareDuration>
    <needLos>true</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>true</isAggro>
    <replaceLowRanks>true</replaceLowRanks>
    <isWorkOnDead>false</isWorkOnDead>
    <ranks>
        <Item href="Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
        <Item href="Spell02.xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
        <Item href="Spell03.xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
    </ranks>
    <modifiers>
        <Item type="gameMechanics.elements.spell.RaiseRepelType">
            <repelType>FAIL</repelType>
        </Item>
    </modifiers>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>true</triggersGlobalCooldown>
    <ignoreGlobalCooldown>false</ignoreGlobalCooldown>
    <launchWhenReady>false</launchWhenReady>
    <needInFront>true</needInFront>
    <mechanics>
        <cooldown>
            <stage>Launch</stage>
            <duration>90000</duration>
            <group href="" />
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <conditions>
            <Item type="gameMechanics.elements.predicates.PredicateHasLos">
                <hideText>false</hideText>
            </Item>
        </conditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <hideText>false</hideText>
                <buff href="/Mechanics/Spells/PsionicNew/MindStab/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <anyRank>true</anyRank>
                <consumeStacks>1</consumeStacks>
            </Item>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateEquipped">
                        <dressType>AMMO</dressType>
                        <itemClass href="/Mechanics/ItemClasses/Other_InfiniteTeardrop.(ItemClass).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.elements.resources.ResourceBaseMana">
                    <baseMana>0</baseMana>
                </resourceIf>
                <resourceElse type="gameMechanics.elements.resources.ResourceDressItem">
                    <slot>AMMO</slot>
                    <count>3</count>
                </resourceElse>
            </Item>
        </casterResources>
        <channelingMechanics>
            <channelingBuff hrefvar="buff" />
            <finishImpacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Buff_02_01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                    <anyRank>false</anyRank>
                </Item>
            </finishImpacts>
            <isForthright>false</isForthright>
        </channelingMechanics>
    </mechanics>
    <speed>0</speed>
    <maxTargets>-1</maxTargets>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>25</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>