<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739913417</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="BossPlane.(Plane).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="BossPhase.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>FR15_Center</scriptID>
							<map href="/Maps/FerrisRaid/MapResource.xdb" />
						</locator>
						<yaw type="constructor.basicElements.AngleDegrees">
							<value>180</value>
						</yaw>
					</destination>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactBaseHealth" />
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="AttackSpeedBuff.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
											<zone href="/Mechanics/RaidInstances/FerrisRaid/15_General/BossFightZone.(ScriptZone).xdb" />
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="AvatarCounted.(BuffResource).xdb" />
										</Item>
									</impactsIf>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="/Mechanics/RaidInstances/FerrisRaid/15_General/GeneralAppears.(ClientData).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="BossPhase.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
			</predicates>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
