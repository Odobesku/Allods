<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>25000</time>
					</Item>
					<Item type="CreatureSetTransparencyAction">
						<transparency>0</transparency>
						<fadeMult>0.2</fadeMult>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionLoopAction">
				<actionToLoop type="VisActionList">
					<playWhile type="VisActionDelay">
						<time>1500</time>
					</playWhile>
					<elements>
						<Item type="CreatureEffectsAction">
							<visualEffects>
								<Item>
									<effectFx href="/Spells/FX/Mobs/Architect_Cruiser_Hit.(VisObjectTemplate).xdb" />
								</Item>
							</visualEffects>
						</Item>
					</elements>
				</actionToLoop>
				<totalTime>1500</totalTime>
				<repeat>20</repeat>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
