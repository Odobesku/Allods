<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739920326</resourceId>
    </Header>
    <Name href="BossSpheres.(SpellSingleTarget).Name.txt" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>300000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                <impact type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeDestination">
                                    <to type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.RelativePos" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                <modifier type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                    <radius type="gameMechanics.elements.calcers.FloatData">
                                                        <value>25</value>
                                                    </radius>
                                                </modifier>
                                            </Item>
                                        </modifiers>
                                    </to>
                                </moveType>
                                <resource href="BossSphere_dark.(ProjectileResource).xdb" />
                            </projectileData>
                        </Item>
                    </impacts>
                </impact>
                <count type="gameMechanics.elements.calcers.FloatData">
                    <value>5</value>
                </count>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeDestination">
                        <to type="gameMechanics.map.destination.DestinationModified">
                            <destination type="gameMechanics.map.destination.RelativePos" />
                            <modifiers>
                                <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                    <modifier type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                        <radius type="gameMechanics.elements.calcers.FloatData">
                                            <value>25</value>
                                        </radius>
                                    </modifier>
                                </Item>
                            </modifiers>
                        </to>
                    </moveType>
                    <resource href="BossSphere_Light.(ProjectileResource).xdb" />
                </projectileData>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>