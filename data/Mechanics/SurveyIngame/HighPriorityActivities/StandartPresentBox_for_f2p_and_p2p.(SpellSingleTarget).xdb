<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739880620</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="StandartPresentBox_for_f2p_and_p2p.(SpellSingleTarget).Name.txt" />
    <Description href="StandartPresentBox_for_f2p_and_p2p.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                        <key href="/System/ContentKeys/ItemmallService.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/ItemMall/Scrolls/Rituals/IMHalo1Day.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </item>
                        <binding>ForceBind</binding>
                        <count>3</count>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/ItemMall/Potions/Defence/IMStaminaElixir.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </item>
                        <binding>ForceBind</binding>
                        <count>3</count>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/ItemMall/Potions/Special/IMPrecisionElixir.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </item>
                        <binding>ForceBind</binding>
                        <count>3</count>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactGiveItem">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="/Items/IMCurrencies/Myrrh1000/Myrrh1000.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </item>
                        <binding>ForceBind</binding>
                        <count>30</count>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>