<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>244086</resourceId>
    </Header>
    <Name href="BuffAstralAstrolabeJump.(BuffResource).Name.txt" />
    <Description href="BuffAstralAstrolabeJump.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Ships/Astralyabiya.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.world.ship.elements.effects.EffectOnInterHubAcceleration">
            <destination type="gameMechanics.elements.calcers.CalcerLongParam">
                <paramName>destination</paramName>
            </destination>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.world.ship.elements.effects.EffectInterHubAcceleration" />
                <Item type="gameMechanics.world.ship.elements.effects.EffectOnOnlineBoundChangeTrigger">
                    <impactsOnAdd>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasUnlockedShipDestination" />
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsFairyActive" />
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="CooldownBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="BuffAstralAstrolabeJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="BuffAstralAstrolabeJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impactsOnAdd>
                    <impactsOnRemove>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="BuffAstralAstrolabeJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOnRemove>
                </Item>
                <Item type="gameMechanics.world.ship.elements.EffectShipDamageTrigger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
                            <delay>0</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="BuffAstralAstrolabeJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ShipDistributor" />
                                    <data href="/Mechanics/GameRoot/ClientData/Ship/AstrolabeStopDamageData.xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Ships/Astrolabe/BuffBlockAstrolabe.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                    </predicates>
                </Item>
                <Item type="gameMechanics.world.ship.elements.EffectMapChanged">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="BuffAstralAstrolabeJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ShipDistributor" />
                            <data href="/Mechanics/GameRoot/ClientData/Ship/AstrolabeStopData.xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.world.ship.elements.effects.EffectAllDevices">
                    <effects>
                        <Item type="gameMechanics.world.ship.elements.DeviceOnlineTrigger">
                            <impactsOff>
                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceLinkedTo" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="BuffAstralAstrolabeJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.ShipDistributor" />
                                            <data href="/Mechanics/GameRoot/ClientData/Ship/AstrolabeStopData.xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOff>
                        </Item>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.world.device.PredicateDeviceOnline" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceLinkedTo" />
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="BuffAstralAstrolabeJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.ShipDistributor" />
                                                    <data href="/Mechanics/GameRoot/ClientData/Ship/AstrolabeStopData.xdb#xpointer(/gameMechanics.world.ClientData)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                    <filter type="gameMechanics.world.device.filters.UsableDeviceTypeFilter">
                        <allowedTypes>
                            <Item href="/Mechanics/Ships/UsableDeviceTypes/EngineHorizontal.xdb#xpointer(/gameMechanics.world.device.UsableDeviceType)" />
                        </allowedTypes>
                    </filter>
                </Item>
                <Item type="gameMechanics.world.ship.elements.effects.EffectAllDevices">
                    <effects>
                        <Item type="gameMechanics.world.ship.elements.effects.EffectDeviceShutdown">
                            <reason>TR_InterHubAcceleration</reason>
                        </Item>
                    </effects>
                    <filter type="gameMechanics.world.device.filters.HasRemotePartFilter" />
                </Item>
                <Item type="gameMechanics.world.ship.elements.effects.EffectCollisionTriger">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="BuffAstralAstrolabeJump.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ShipDistributor" />
                            <data href="/Mechanics/GameRoot/ClientData/Ship/AstrolabeStopCollisionData.xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impacts>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.world.ship.elements.ImpactTeleportShipToPoi">
                    <destination type="gameMechanics.elements.calcers.CalcerLongParam">
                        <paramName>destination</paramName>
                    </destination>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressees">
                                    <addresseesFinder type="gameMechanics.elements.addresseeFinders.AddressesCalcerOnlineShipBounds" />
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="CooldownBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>1</duration>
    <isStackable>false</isStackable>
    <stackLimit>1</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isMultiple>false</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>