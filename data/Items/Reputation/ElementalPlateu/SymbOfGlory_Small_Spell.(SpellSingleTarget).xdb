<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>514507</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="SymbOfGlory_Small_Spell.(SpellSingleTarget).Name.txt" />
    <Description href="SymbOfGlory_Small_Spell.(SpellSingleTarget).Description.txt" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHasGuildProgress" />
            <Item type="gameMechanics.elements.predicates.PredicateGuildRight">
                <memberRight>GMRWearSymobolics</memberRight>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAddGuildAuthority">
                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
                        <Item type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>10</multiplier>
                        </Item>
                        <Item type="gameMechanics.elements.scalers.ScalerIf">
                            <condition type="gameMechanics.elements.predicates.PredicateGuildLevelLesser">
                                <level>15</level>
                            </condition>
                            <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>10</multiplier>
                            </scalerIf>
                            <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>1</multiplier>
                            </scalerElse>
                        </Item>
                    </scalers>
                </scaler>
                <source>Impact</source>
            </Item>
            <Item type="gameMechanics.elements.impacts.AddGuildLoyalty">
                <amount>5</amount>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>