<?xml version="1.0" encoding="UTF-8" ?>
<UIBindSection>
	<sysName>ship_other</sysName>
	<name href="Section.txt" />
	<binds>
		<Item>
			<sysName>decrease_map</sysName>
			<name href="DecreaseMap.txt" />
			<defaultKeys>
				<Item>-</Item>
			</defaultKeys>
		</Item>
		<Item>
			<sysName>increase_map</sysName>
			<name href="IncreaseMap.txt" />
			<defaultKeys>
				<Item>=</Item>
			</defaultKeys>
		</Item>
		<Item>
			<sysName>toggle_statistic</sysName>
			<name href="ToggleStatistic.txt" />
			<activationType>ACTIVATION_TYPE_ACTIVATE_AND_DEACTIVATE</activationType>
			<defaultKeys>
				<Item>TAB</Item>
			</defaultKeys>
		</Item>		
		<Item>
			<sysName>toggle_help_overlay</sysName>
			<name href="ToggleHelpOverlay.txt" />
			<activationType>ACTIVATION_TYPE_ACTIVATE_AND_DEACTIVATE</activationType>
			<defaultKeys>
				<Item>F1</Item>
			</defaultKeys>
		</Item>
	</binds>
</UIBindSection>
