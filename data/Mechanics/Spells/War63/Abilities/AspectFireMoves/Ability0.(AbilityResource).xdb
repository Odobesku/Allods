					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="/Mechanics/Spells/War63/Spells/PowerAttack/Spell01.(SpellSingleTarget).xdb" />
								<Item href="/Mechanics/Spells/War63/Spells/PowerAttackUpgrade/Spell01.(SpellSingleTarget).xdb" />
								<Item href="/Mechanics/Spells/War63/Spells/Cleavage/Spell01.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</predicates>
					<modifiers>
						<Item type="gameMechanics.elements.spell.SpellEnvelopeTargetModifier">
							<effects>
								<Item type="gameMechanics.elements.effects.EffectsIf">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
													<buff href="/Mechanics/Spells/War63/Spells/Bleeding/DoT01.(BuffResource).xdb" />
													<from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
												</Item>
												<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
													<buff href="/Mechanics/Spells/War63/Abilities/ThunderStrikeBleeding/Buff01.(BuffResource).xdb" />
													<from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
												</Item>
												<Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
													<buff href="/Mechanics/Spells/War63/Abilities/Wound/Wound1.(BuffResource).xdb" />
													<from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
												</Item>
											</predicates>
										</Item>
									</predicates>
									<effectsIf>
										<Item type="gameMechanics.elements.effects.IncomingCritProbabilitySummand">
											<summand type="gameMechanics.elements.calcers.FloatData">
												<value var="value" />
											</summand>
											<onlyFromCaster>true</onlyFromCaster>
										</Item>
									</effectsIf>
								</Item>
							</effects>
							<onBehalfOfHolder>true</onBehalfOfHolder>
						</Item>
					</modifiers>
				</Item>
