<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739866040</resourceId>
	</Header>
	<Name href="ExplosiveBottle.(SpellArea).Name.txt" />
	<Description href="ExplosiveBottle.(SpellArea).Description.txt" />
	<visualScripts href="ExplosiveBottle.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>30</value>
	</range>
	<prepareDuration>1000</prepareDuration>
	<targetType>STTPoint</targetType>
	<iffPolicy>Everyone</iffPolicy>
	<mechanics>
		<cooldown>
			<duration>6000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
				<quest href="/World/Quests/ElementalPlateu/Ice_4/Ice_4.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
				<status>Started</status>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
				<zone href="/Maps/ElementalPlateu/ScriptZones/IceIsleFires.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
			</Item>
		</casterConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateDevice">
						<deviceResources>
							<Item href="/Items/InteractiveObjects/ElementalPlateu/CampFire/CampFire.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
						</deviceResources>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
						<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
						<radius>10</radius>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
										<mobs>
											<Item href="/Creatures/Folks/Instances/ElementalPlateu/ExplosiveFolkWar.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
											<Item href="/Creatures/Folks/Instances/ElementalPlateu/ExplosiveFolkMag.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
										</mobs>
									</Item>
									<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
								</predicates>
								<impactsIf>
									<Item type="gameMechanics.elements.impacts.ImpactAstralKick">
										<time>100</time>
										<impactsOnLand>
											<Item type="gameMechanics.elements.impacts.ReturningImpact">
												<impacts>
													<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
														<id href="/World/Quests/ElementalPlateu/Ice_4/Counter_2.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
													</Item>
												</impacts>
											</Item>
											<Item type="gameMechanics.elements.impacts.ImpactKill" />
										</impactsOnLand>
										<distance>8</distance>
									</Item>
								</impactsIf>
							</Item>
						</impacts>
						<filter type="gameMechanics.world.creature.MobFilter" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactClientData">
						<data href="/World/Quests/ElementalPlateu/Ice_4/Explosion.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
								<predicates>
									<Item type="gameMechanics.constructor.basicElements.PredicateNot">
										<predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
											<quest href="/World/Quests/ElementalPlateu/Ice_4/Ice_4.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
											<counterResource href="/World/Quests/ElementalPlateu/Ice_4/Counter_1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
											<value>5</value>
										</predicate>
									</Item>
								</predicates>
								<impactsIf>
									<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
										<id href="/World/Quests/ElementalPlateu/Ice_4/Counter_1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
									</Item>
								</impactsIf>
							</Item>
						</impacts>
					</Item>
				</impactsIf>
			</Item>
		</targetImpacts>
	</mechanics>
	<speed>20</speed>
	<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
	<radius>3</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
