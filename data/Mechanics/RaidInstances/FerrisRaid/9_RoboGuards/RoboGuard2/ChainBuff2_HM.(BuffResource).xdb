<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739904392</resourceId>
	</Header>
	<Name href="ChainBuff2_HM.(BuffResource).Name.txt" />
	<Description href="ChainBuff2_HM.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Buffs/ChainViolet.(UISingleTexture).xdb" />
	<visScript href="/Spells/BuffVisScripts/DotLightniing.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
			<impactsIn>
				<impactsFromCaster>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="ChainDamageBuff_HM_Player.(BuffResource).xdb" />
					</Item>
				</impactsFromCaster>
			</impactsIn>
			<impactsOut>
				<impactsFromCaster>
					<Item type="gameMechanics.elements.impacts.BuffDetacher">
						<buff href="ChainDamageBuff_HM_Player.(BuffResource).xdb" />
					</Item>
				</impactsFromCaster>
			</impactsOut>
			<maxLength>80</maxLength>
			<reconnect>true</reconnect>
			<height>3</height>
			<width>1</width>
			<filter type="gameMechanics.world.creature.AvatarFilter" />
		</Item>
		<Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
			<impactsIn>
				<impactsFromCaster>
					<Item type="gameMechanics.elements.impacts.StackBuff">
						<buff href="RoboGuard1_HM_Defence.(BuffResource).xdb" />
						<delta type="gameMechanics.elements.calcers.FloatData">
							<value>-1</value>
						</delta>
					</Item>
				</impactsFromCaster>
			</impactsIn>
			<impactsOut>
				<impactsFromCaster>
					<Item type="gameMechanics.elements.impacts.StackBuff">
						<buff href="RoboGuard1_HM_Defence.(BuffResource).xdb" />
						<delta type="gameMechanics.elements.calcers.FloatData">
							<value>1</value>
						</delta>
					</Item>
				</impactsFromCaster>
			</impactsOut>
			<maxLength>80</maxLength>
			<reconnect>true</reconnect>
			<height>3</height>
			<width>3</width>
			<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
						<mobs>
							<Item href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/RoboGuard1.(MobWorld).xdb" />
						</mobs>
					</Item>
				</predicates>
			</filter>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
					<phantom href="RoboGuard2.(MobWorld).xdb" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
							<element>LIGHTNING</element>
							<damage>10</damage>
							<scaler type="gameMechanics.elements.scalers.MagicScaler" />
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="ChainRay.(ClientData).xdb" />
					<calcers>
						<addressEntries>
							<Item>
								<name>caster</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
							</Item>
							<Item>
								<name>target</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
							</Item>
						</addressEntries>
					</calcers>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ChainBuff2_HM.(BuffResource).xdb" />
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ChainBuff2_HM.(BuffResource).xdb" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.PostponedImpacts">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
													<mobs>
														<Item href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/RoboGuard1.(MobWorld).xdb" />
													</mobs>
												</Item>
												<Item type="gameMechanics.constructor.basicElements.PredicateNot">
													<predicate type="gameMechanics.elements.resources.ResourceBuff">
														<buff href="RoboGuard1_HM_Defence.(BuffResource).xdb" />
													</predicate>
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.ReturningImpact">
													<impacts>
														<Item type="gameMechanics.elements.impacts.BuffDetacher">
															<buff href="ChainBuff2_HM.(BuffResource).xdb" />
														</Item>
													</impacts>
												</Item>
											</impactsIf>
										</Item>
									</impacts>
									<spawnResource href="/Maps/FerrisRaid/SpawnTables/9_RoboGuards.(SpawnTable).xdb" />
								</Item>
							</impacts>
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>3000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
													<mobs>
														<Item href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/RoboGuard1.(MobWorld).xdb" />
													</mobs>
												</Item>
												<Item type="gameMechanics.constructor.basicElements.PredicateNot">
													<predicate type="gameMechanics.elements.resources.ResourceBuff">
														<buff href="RoboGuard1_HM_Defence.(BuffResource).xdb" />
													</predicate>
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.ReturningImpact">
													<impacts>
														<Item type="gameMechanics.elements.impacts.BuffDetacher">
															<buff href="ChainBuff2_HM.(BuffResource).xdb" />
														</Item>
													</impacts>
												</Item>
											</impactsIf>
										</Item>
									</impacts>
									<spawnResource href="/Maps/FerrisRaid/SpawnTables/9_RoboGuards.(SpawnTable).xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ChainBuff_HM.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ChainBuff2_HM.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ChainBuff_HM.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="ChainBuff2_HM.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<eventClasses>
				<Item>gameMechanics.elements.events.EventDeath</Item>
			</eventClasses>
			<impacts>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="ChainBuff2_HM.(BuffResource).xdb" />
				</Item>
			</impacts>
			<eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
