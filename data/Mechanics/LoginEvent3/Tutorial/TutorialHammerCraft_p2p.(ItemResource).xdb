<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739973367</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Crafting/Hammer02.(UISingleTexture).xdb" />
    <source>Crafted</source>
    <isQuestRelated>true</isQuestRelated>
    <canBeDeposited>false</canBeDeposited>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseOnItemAndTakeActions">
        <highlightPredicate type="gameMechanics.constructor.schemes.item.ItemPredicateOneOf">
            <items>
                <Item href="TutorialPiece.(ItemResource).xdb" />
                <Item href="TutorialPieceFort.(ItemResource).xdb" />
            </items>
        </highlightPredicate>
        <usages>
            <Item>
                <itemPredicate type="gameMechanics.constructor.schemes.item.ItemPredicateOneOf">
                    <items>
                        <Item href="TutorialPiece.(ItemResource).xdb" />
                    </items>
                </itemPredicate>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="TutorialComponent.(ItemResource).xdb" />
                        </item>
                        <count type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                            <value>6</value>
                        </count>
                        <binding>Transfer</binding>
                    </Item>
                    <Item type="itemService.elements.components.ItemTakeActionImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.RepeatedImpactStack">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                        <id href="C5_getcomponents.(QuestCountId).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                        <quest href="HighEndStart_p2p.(QuestResource).xdb" />
                                        <counterResource href="TutorialHammerCraft_p2p.(ItemResource).xdb" />
                                        <value>2</value>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                                        <quest href="HighEndStart_p2p.(QuestResource).xdb" />
                                        <counterResource href="TutorialHammerCraft_p2p.(ItemResource).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                        <quest href="HighEndStart_L_p2p.(QuestResource).xdb" />
                                        <counterResource href="TutorialHammerCraft_p2p.(ItemResource).xdb" />
                                        <value>2</value>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                                        <quest href="HighEndStart_L_p2p.(QuestResource).xdb" />
                                        <counterResource href="TutorialHammerCraft_p2p.(ItemResource).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </actions>
                <consumeUsedItem>1</consumeUsedItem>
                <consumeTargetItem>1</consumeTargetItem>
            </Item>
            <Item>
                <itemPredicate type="gameMechanics.constructor.schemes.item.ItemPredicateOneOf">
                    <items>
                        <Item href="TutorialPieceFort.(ItemResource).xdb" />
                    </items>
                </itemPredicate>
                <actions>
                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                        <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                            <item href="TutorialComponent.(ItemResource).xdb" />
                        </item>
                        <count type="itemService.elements.avatarstuffcalcer.StuffLinearCalcer">
                            <mul>1.5</mul>
                            <mulCalcer type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                                <value>6</value>
                            </mulCalcer>
                        </count>
                        <binding>Transfer</binding>
                    </Item>
                    <Item type="itemService.elements.components.ItemTakeActionImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.RepeatedImpactStack">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                        <id href="C5_getcomponents.(QuestCountId).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                        <quest href="HighEndStart_p2p.(QuestResource).xdb" />
                                        <counterResource href="TutorialHammerCraft_p2p.(ItemResource).xdb" />
                                        <value>2</value>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                                        <quest href="HighEndStart_p2p.(QuestResource).xdb" />
                                        <counterResource href="TutorialHammerCraft_p2p.(ItemResource).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                                        <quest href="HighEndStart_L_p2p.(QuestResource).xdb" />
                                        <counterResource href="TutorialHammerCraft_p2p.(ItemResource).xdb" />
                                        <value>2</value>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                                        <quest href="HighEndStart_L_p2p.(QuestResource).xdb" />
                                        <counterResource href="TutorialHammerCraft_p2p.(ItemResource).xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </actions>
                <consumeUsedItem>1</consumeUsedItem>
                <consumeTargetItem>1</consumeTargetItem>
            </Item>
        </usages>
        <predicates>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.constructor.basicElements.PredicateOr">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                            <quest href="HighEndStart_p2p.(QuestResource).xdb" />
                            <counterResource href="C5_getcomponents.(QuestCountId).xdb" />
                            <value>2</value>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                            <quest href="HighEndStart_L_p2p.(QuestResource).xdb" />
                            <counterResource href="C5_getcomponents.(QuestCountId).xdb" />
                            <value>2</value>
                        </Item>
                    </predicates>
                </predicate>
            </Item>
        </predicates>
        <useStack>true</useStack>
    </functionalPart>
    <stackLimit>2</stackLimit>
    <quality href="/Mechanics/ItemQualities/Legendary.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <ownershipLimit>2</ownershipLimit>
    <binding>BindOnPickup</binding>
    <name href="TutorialHammerCraft_p2p.(ItemResource).Name.txt" />
    <description href="TutorialHammerCraft_p2p.(ItemResource).Description.txt" />
    <canBeDroppedPredicate type="gameMechanics.constructor.basicElements.PredicateOr">
        <predicates>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="HighEndStart_p2p.(QuestResource).xdb" />
                <status>Finished</status>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="HighEndStart_L_p2p.(QuestResource).xdb" />
                <status>Finished</status>
            </Item>
        </predicates>
    </canBeDroppedPredicate>
</gameMechanics.constructor.schemes.item.ItemResource>