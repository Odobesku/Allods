							<predicate type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
						</Item>
					</predicates>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.Dodge" />
	</effects>
	<duration>5000</duration>
