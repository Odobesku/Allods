<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739920530</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
		<Item href="/Mechanics/Spells/Groups/SpeedBoosts.xdb" />
		<Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
		<Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
	</groups>
	<Name href="Charge.(SpellSingleTarget).Name.txt" />
	<Description href="Charge.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>WeaponScaler</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Warrior/WarriorCharge.(UISingleTexture).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>30</value>
	</range>
	<ranks>
		<Item href="Spell01.(SpellSingleTarget).xdb" />
		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<mechanics>
		<cooldown>
			<duration var="cd_duration" />
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.predicates.PredicateCanMove" />
			<Item type="gameMechanics.elements.predicates.PredicateUsesWeapon" />
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceMana">
				<mana>15</mana>
				<rawManaScaler type="gameMechanics.elements.scalers.LinearScaler">
					<multiplier>1.66667</multiplier>
				</rawManaScaler>
				<scaleByWeaponSpeed>true</scaleByWeaponSpeed>
				<manaType>
					<Item>Energy</Item>
				</manaType>
			</Item>
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
				<buff hrefvar="buff" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactAddCombatAdvantage">
				<value>10</value>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>