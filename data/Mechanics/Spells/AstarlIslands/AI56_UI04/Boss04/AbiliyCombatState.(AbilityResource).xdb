					<factor type="gameMechanics.elements.scalers.LinearScaler">
						<multiplier>0</multiplier>
					</factor>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.HealthTrigger">
			<healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
