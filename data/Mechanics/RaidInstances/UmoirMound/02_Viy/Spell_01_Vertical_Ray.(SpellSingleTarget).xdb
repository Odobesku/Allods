<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739865830</resourceId>
    </Header>
    <Name href="Spell_01_Vertical_Ray.(SpellSingleTarget).Name.txt" />
    <visualScripts href="ViyRay.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>4000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>11000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="StopSpawn.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                        <variableResource href="Boss_02_CastDirection.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                        <expectedValue type="gameMechanics.elements.calcers.FloatData">
                            <value>1</value>
                        </expectedValue>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="1LineMechanic.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                        <variableResource href="Boss_02_CastDirection.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                        <expectedValue type="gameMechanics.elements.calcers.FloatData">
                            <value>2</value>
                        </expectedValue>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="2LineMechanic.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                        <variableResource href="Boss_02_CastDirection.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                        <expectedValue type="gameMechanics.elements.calcers.FloatData">
                            <value>3</value>
                        </expectedValue>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="3LineMechanic.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
                        <variableResource href="Boss_02_CastDirection.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                        <expectedValue type="gameMechanics.elements.calcers.FloatData">
                            <value>4</value>
                        </expectedValue>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                        <impactsResource href="4LineMechanic.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                <spell href="Spell_02_Horizontal_Ray.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                <duration>2000</duration>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>