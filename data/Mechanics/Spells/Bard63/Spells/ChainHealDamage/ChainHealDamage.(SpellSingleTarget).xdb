<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>215400</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/BardMelody.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
    </groups>
    <element>DISEASE</element>
    <Name href="ChainHealDamage.(SpellSingleTarget).Name.txt" />
    <Description href="ChainHealDamage.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcerdmg" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>MagicScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>heal</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcerheal" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>HealScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>jump</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.LongToFloatCalcer">
                    <calcer type="constructor.elements.CalcerLongExternal">
                        <externalCalcer hrefvar="externalCalcerjump" />
                    </calcer>
                </mulCalcer>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/DoubleVirtue.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Bard/Virtue2.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration var="prepareDuration" />
    <isAggro>false</isAggro>
    <ranks>
        <Item href="ChainHealDamage01.(SpellSingleTarget).xdb" />
        <Item href="ChainHealDamage02.(SpellSingleTarget).xdb" />
        <Item href="ChainHealDamage03.(SpellSingleTarget).xdb" />
    </ranks>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
                <sub>1</sub>
            </Item>
        </casterResources>
        <channelingMechanics>
            <channelingBuff href="ChannelingBuff.(BuffResource).xdb" />
            <finishImpacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff hrefvar="buff" />
                </Item>
            </finishImpacts>
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.EffectsIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                        <ability href="/Mechanics/Spells/Bard63/Abilities/MelodyCastOnMove/MelodyCastOnMove01.(AbilityResource).xdb" />
                    </Item>
                </predicates>
                <effectsIf>
                    <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
                        <effectScaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                            <coeff>1</coeff>
                            <calcer type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer href="/Mechanics/Spells/Bard63/Abilities/MelodyCastOnMove/MelodySpeedModifier.(CalcerFloatResource).xdb" />
                            </calcer>
                        </effectScaler>
                    </Item>
                </effectsIf>
            </Item>
        </casterChannelingEffects>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>