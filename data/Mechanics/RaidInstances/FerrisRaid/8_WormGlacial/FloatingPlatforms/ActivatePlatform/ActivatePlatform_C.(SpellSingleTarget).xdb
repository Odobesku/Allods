<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>221643</resourceId>
    </Header>
    <Name href="ActivatePlatform_C.(SpellSingleTarget).Name.txt" />
    <image href="/Interface/Icons/Actions/AngarFlayButton.(UISingleTexture).xdb" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>0</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="ActivatedPlatform_C.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsToSpawnObjects">
                <spawn>
                    <scriptID>Platform_C</scriptID>
                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                </spawn>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>1</radius>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Rider_C.(BuffResource).xdb" />
                                <impactsOnAttach>
                                    <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                                        <predicates>
                                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                                <buff href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/PanelUser_C.(BuffResource).xdb" />
                                                            </Item>
                                                        </predicates>
                                                        <impactsIf>
                                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                <buff href="ActivatedPlatform_C.(BuffResource).xdb" />
                                                            </Item>
                                                        </impactsIf>
                                                    </Item>
                                                </impacts>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impactsOnAttach>
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                            <filters>
                                <Item type="gameMechanics.world.creature.AvatarFilter" />
                                <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceAnyBuff">
                                                <buffs>
                                                    <Item href="Rider_A.(BuffResource).xdb" />
                                                    <Item href="Rider_B.(BuffResource).xdb" />
                                                    <Item href="Rider_C.(BuffResource).xdb" />
                                                    <Item href="Rider_D.(BuffResource).xdb" />
                                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/PanelUser_A.(BuffResource).xdb" />
                                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/PanelUser_B.(BuffResource).xdb" />
                                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/PanelUser_C.(BuffResource).xdb" />
                                                    <Item href="/Mechanics/RaidInstances/FerrisRaid/8_WormGlacial/FloatingPlatforms/PanelUser_D.(BuffResource).xdb" />
                                                    <Item href="ActivatedPlatform_A.(BuffResource).xdb" />
                                                    <Item href="ActivatedPlatform_B.(BuffResource).xdb" />
                                                    <Item href="ActivatedPlatform_C.(BuffResource).xdb" />
                                                    <Item href="ActivatedPlatform_D.(BuffResource).xdb" />
                                                </buffs>
                                            </predicate>
                                        </Item>
                                    </predicates>
                                </Item>
                            </filters>
                        </filter>
                        <targetsLimit>1</targetsLimit>
                        <sorting type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
                            <order>Ascending</order>
                        </sorting>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>