<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<LocatorNameOnCaster />
			<LocatorOnCaster>Slot_Global</LocatorOnCaster>
			<FXOnCaster>/Spells/FX/Mobs/Kraken_RangedAttack.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<CastAnimation>rangedAttack</CastAnimation>
			<FxOnHands />
			<FXOnTargets>/Spells/FX/Mobs/Kraken_RangedAttackOnTarget.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<LocatorOnTargets>Slot_Global</LocatorOnTargets>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<advanced>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<scale>5</scale>
						<locator>Slot_Hand_L</locator>
						<locatorName>TenFront8_R_end</locatorName>
					</Item>
					<Item>
						<scale>5</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<advanced>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx hrefvar="FXOnCaster" />
								<lockScale>true</lockScale>
								<scale>1</scale>
								<locator var="LocatorOnCaster" />
								<locatorName var="LocatorNameOnCaster" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<delay>400</delay>
						</Item>
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
