<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <elements>
            <Item type="VisActionDelay">
                <time>1100</time>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>attack01</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
                <advanced>
                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                </advanced>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Spells/HowlingStrike_AOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <fixPoint>true</fixPoint>
                <scale>1.5</scale>
                <locator>Slot_Global</locator>
            </Item>
        </visualEffects>
    </launch>
</SpellVisScripts>