<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739874900</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Misc/Keys/Distorters.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <source>Quest</source>
    <position>1</position>
    <descVars>
        <Item>
            <name>sectorName</name>
            <text hrefvar="sectorName" />
        </Item>
        <Item>
            <name>tierName</name>
            <text hrefvar="tierName" />
        </Item>
        <Item>
            <name>tier2Name</name>
            <text hrefvar="tier2Name" />
        </Item>
        <Item>
            <name>maxMult</name>
            <value var="maxMult" />
        </Item>
        <Item>
            <name>boxName</name>
            <text hrefvar="boxName" />
        </Item>
        <Item>
            <name>lowBoxWarning</name>
            <text hrefvar="lowBoxWarning" />
        </Item>
    </descVars>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <functionalPart type="itemService.avatar.itemBag.UseOnItemAndTakeActions">
        <multipleUse>true</multipleUse>
        <highlightPredicate type="gameMechanics.elements.item.ItemPredicateAnd">
            <predicates>
                <Item type="gameMechanics.elements.item.ItemPredicateCategory">
                    <category href="/Mechanics/ItemCategories/HGAstralBox.(ItemCategoryTerminal).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
                </Item>
                <Item type="gameMechanics.elements.item.ItemPredicateLevel">
                    <range>
                        <min>60</min>
                        <max>60</max>
                    </range>
                </Item>
                <Item type="gameMechanics.elements.item.ItemPredicateQuality">
                    <quality hrefvar="boxQuality" />
                </Item>
            </predicates>
        </highlightPredicate>
        <usages>
            <Item>
                <itemPredicate type="gameMechanics.elements.item.ItemPredicateAnd">
                    <predicates>
                        <Item type="gameMechanics.elements.item.ItemPredicateCategory">
                            <category href="/Mechanics/ItemCategories/HGAstralBox.(ItemCategoryTerminal).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
                        </Item>
                        <Item type="gameMechanics.elements.item.ItemPredicateLevel">
                            <range>
                                <min>60</min>
                                <max>60</max>
                            </range>
                        </Item>
                        <Item type="gameMechanics.elements.item.ItemPredicateQuality">
                            <quality hrefvar="boxQuality" />
                        </Item>
                    </predicates>
                </itemPredicate>
                <actions>
                    <Item type="itemService.elements.components.ItemTakeActionImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                                <quest href="/World/Quests/HuntingGround1/HG_Start_3/TrainQuest03.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                                <counterResource href="/World/Quests/HuntingGround1/HG_Start_3/UseKey.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                            </Item>
                        </impacts>
                    </Item>
                </actions>
                <useActions>
                    <Item type="itemService.avatar.itemBag.OpenUseAction" />
                </useActions>
                <consumeUsedItem>1</consumeUsedItem>
                <consumeTargetItem>1</consumeTargetItem>
            </Item>
        </usages>
        <triggersGlobalCooldown>false</triggersGlobalCooldown>
    </functionalPart>
    <level>60</level>
    <requiredLevel>60</requiredLevel>
    <stackLimit>20</stackLimit>
    <quality hrefvar="quality" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
        <cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
            <money var="money" />
        </cost>
    </prices>
    <binding>BindOnPickup</binding>
    <lifeLengthCap>1209600000</lifeLengthCap>
    <name href="KeyPrototype.(ItemResource).Name.txt" />
    <description href="KeyPrototype.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/Ship/Misc.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
    <calcers>
        <Item>
            <name>mult</name>
            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                <value var="mult" />
            </calcer>
        </Item>
        <Item>
            <name>keyTier</name>
            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerData">
                <value var="keyTier" />
            </calcer>
        </Item>
    </calcers>
</gameMechanics.constructor.schemes.item.ItemResource>