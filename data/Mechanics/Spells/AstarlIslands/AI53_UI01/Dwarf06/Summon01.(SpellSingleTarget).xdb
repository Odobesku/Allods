<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739856165</resourceId>
    </Header>
    <visualScripts href="SummonVisScripts.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>10000</prepareDuration>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <stage>Start</stage>
            <duration>1000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                <level>0.5</level>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                    <base type="gameMechanics.map.destination.RelativePos" />
                    <offset>4</offset>
                </destination>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                        </impacts>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.world.creature.AvatarFilter" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="SummonData.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <object href="/Mechanics/Spells/AstarlIslands/AI53_UI01/Rabbit/AI53_Rabbit.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                <pool href="AddPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                    <base type="gameMechanics.map.destination.RelativePos" />
                    <offset>4</offset>
                </destination>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                        </impacts>
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.world.creature.AvatarFilter" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                <data href="SummonData.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <object href="/Mechanics/Spells/AstarlIslands/AI53_UI01/Rabbit/AI53_Rabbit.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                <pool href="AddPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>