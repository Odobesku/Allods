<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart />
	<wholeCasting />
	<precastType>PRECAST_DEFAULT</precastType>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attackBard</Item>
				</animations>
				<channel>CHANNEL_ACTIONBAR</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
					<animationKeysAction>
						<Item>
							<action type="CreatureEffectsAction">
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/HitShadBall.(VisObjectTemplate).xdb" />
										<effectAlias href="" />
										<fixPoint>true</fixPoint>
										<scale>0.7</scale>
										<locator>Slot_Global</locator>
										<offendTime />
										<offset y="-1.5" />
									</Item>
									<Item>
										<effectFx href="/Spells/FX/Spells/Bard_GuitarAoE_Wave.(VisObjectTemplate).xdb" />
										<effectAlias href="" />
										<fixPoint>true</fixPoint>
										<scale>2</scale>
										<locator>Slot_Global</locator>
										<offendTime />
										<offset y="-1.5" />
									</Item>
								</visualEffects>
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
