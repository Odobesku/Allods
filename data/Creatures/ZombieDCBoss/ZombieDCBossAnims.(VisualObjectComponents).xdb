<?xml version ="1.0" encoding="UTF-8" ?>
<VisualObjectComponents>
    <components>
        <Item type="AnimationFromParentComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <animationsReplacements>
                <Item>
                    <forAnimations>
                        <Item>idle</Item>
                        <Item>ready</Item>
                    </forAnimations>
                    <play>mountSitIdle</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>attack</Item>
                    </forAnimations>
                    <play>special01</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>attack01</Item>
                    </forAnimations>
                    <play>special02</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>hitCritical</Item>
                    </forAnimations>
                    <play>mountSitHit</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>idle01</Item>
                    </forAnimations>
                    <play>mountSitJump</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>run</Item>
                    </forAnimations>
                    <play>mountRideRun</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>walk</Item>
                        <Item>walkBackwards</Item>
                    </forAnimations>
                    <play>mountRideWalk</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>special</Item>
                    </forAnimations>
                    <play>mountSitSpecialJump</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>specialAttack</Item>
                    </forAnimations>
                    <play>special03</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>specialCast</Item>
                    </forAnimations>
                    <play>special04</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>readySpell</Item>
                    </forAnimations>
                    <play>special05</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>spellCastOmni</Item>
                    </forAnimations>
                    <play>special06</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>idle</Item>
                    </forAnimations>
                    <play>mountSitSit</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>death</Item>
                    </forAnimations>
                    <play>death01</play>
                </Item>
            </animationsReplacements>
            <ifAnimationNotExistsRun>idle</ifAnimationNotExistsRun>
            <skipBlendOptimization>false</skipBlendOptimization>
            <synchronizeAnimationPosition>false</synchronizeAnimationPosition>
        </Item>
    </components>
</VisualObjectComponents>
