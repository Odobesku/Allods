<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ArchitectDestroyer_ReadySpellAoe.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<scale>2</scale>
						<fadeInTime>250</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<offendTime />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/AOEAura_Electric_R10.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<fadeInTime>250</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<offendTime />
					</Item>
				</visualEffects>
				<restartOnVisCreatureChange>true</restartOnVisCreatureChange>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Mobs/ArchitectDestroyer_SpellCastAoe.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
