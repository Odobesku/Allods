<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
	<Header>
		<resourceId>739870172</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Itemmall/IMPsalter.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<source>Vendor</source>
	<showItemContextAction>Never</showItemContextAction>
	<forceShowQuality>true</forceShowQuality>
	<itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
	<functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
		<warningUseText href="/Items/BoxSpecialLoot/ShureToUse.txt" />
		<usages>
			<Item>
				<actions>
					<Item type="itemService.avatar.itemBag.GrantUnlockTakeAction">
						<unlock href="/Mechanics/Unlocks/ItemMall/ExtraDefenceEpic.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
					</Item>
				</actions>
				<consumeItems>1</consumeItems>
			</Item>
		</usages>
		<predicates>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateUnlock">
					<unlock href="/Mechanics/Unlocks/ItemMall/ExtraDefenceEpic.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
				</predicate>
			</Item>
		</predicates>
	</functionalPart>
	<stackLimit>1000</stackLimit>
	<quality href="/Mechanics/ItemQualities/Epic.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
	<prices type="gameMechanics.constructor.schemes.item.prices.AuctionItem">
		<cost type="gameMechanics.constructor.schemes.item.prices.DirectCost">
			<money>2</money>
		</cost>
	</prices>
	<itemMallType>ITEMMALLABLE</itemMallType>
	<name href="ExtraDefenceEpic.(ItemResource).Name.txt" />
	<description href="ExtraDefenceEpic.(ItemResource).Description.txt" />
	<category href="/Mechanics/ItemCategories/ItemMall.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemCategoryTerminal)" />
</gameMechanics.constructor.schemes.item.ItemResource>
