	</Header>
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="Ferris4_Mob_Tranzit.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactStopTalk" />
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<eventClasses>
				<Item>gameMechanics.world.mob.behaviour.aiEvents.GoneThroughPathEvent</Item>
			</eventClasses>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>3000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.GoThroughPath">
							<path>
								<Item>
									<scriptID>Ferris4_Mrak_Tranzit_02</scriptID>
									<map href="/Maps/Ferris4/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
								</Item>
								<Item>
									<scriptID>Ferris4_Mrak_03_1</scriptID>
									<map href="/Maps/Ferris4/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
								</Item>
							</path>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>15000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="Ferris4_Mrak_Tranzit.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				</Item>
			</impacts>
		</Item>
	</effects>
	<duration>600000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
