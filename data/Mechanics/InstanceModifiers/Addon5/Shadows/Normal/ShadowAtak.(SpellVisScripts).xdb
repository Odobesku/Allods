<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionLoopAction">
		<actionToLoop type="VisActionList">
			<elements>
				<Item type="CreatureAnimationAction">
					<animations>
						<Item>specialAttack</Item>
					</animations>
					<channel>CHANNEL_ABILITY</channel>
					<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
					<channelOverrideControllers>TOP_ONLY</channelOverrideControllers>
					<advanced>
						<speed>0.43</speed>
						<offendType>EVERYKEY_OFFEND</offendType>
						<eventPlaybackEnd>true</eventPlaybackEnd>
						<turnToTarget>BEFORE_ANIMATIONEND</turnToTarget>
					</advanced>
				</Item>
			</elements>
		</actionToLoop>
	</actionBarStart>
</SpellVisScripts>
