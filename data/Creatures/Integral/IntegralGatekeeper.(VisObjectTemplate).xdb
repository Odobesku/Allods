				<timeMin>5</timeMin>
				<skipLoading>true</skipLoading>
			</component>
			<controller href="" />
			<inheritParentAnimationIfHaveNoOwn>false</inheritParentAnimationIfHaveNoOwn>
			<stopForOtherAnimation>false</stopForOtherAnimation>
			<synchronizeAnimationPosition>false</synchronizeAnimationPosition>
			<updateOnlyByFeedBacks>false</updateOnlyByFeedBacks>
		</Item>
	</visObjComponents>
	<drawBehindCamera>false</drawBehindCamera>
	<softReplace>false</softReplace>
</VisObjectTemplate>