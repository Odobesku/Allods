	</Header>
	<name href="FortitudeDefSkills.(AbilityResource).Name.txt" />
	<description href="FortitudeDefSkills.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>heal</name>
			<value>600</value>
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>HealScaler</formula>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Mounts/ChargeRhino.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/War63/Abilities/FortitudeUpgradeBuff/FortitudeUpgradeBuff.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.SpellCastTrigger">
					<conditionalImpacts>
						<Item>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactRetriveDamageFromPoolBarrier">
									<damage type="gameMechanics.elements.calcers.FloatToLongCalcer">
										<calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
											<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
												<scalers>
													<Item type="gameMechanics.elements.scalers.HealScaler" />
													<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
														<mul>0.001</mul>
														<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
															<stat type="gameMechanics.elements.stat.SpecialStat">
																<stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
															</stat>
															<valueType>ShortTerm</valueType>
														</mulCalcer>
														<sum>1</sum>
													</Item>
												</scalers>
											</scaler>
											<value>600</value>
										</calcer>
									</damage>
								</Item>
							</impacts>
							<conditions>
								<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
									<spells>
										<Item href="/Mechanics/Spells/War63/Spells/Charge/Spell03.(SpellSingleTarget).xdb" />
										<Item href="/Mechanics/Spells/War63/Spells/ShieldBash/Spell03.(SpellSingleTarget).xdb" />
									</spells>
								</Item>
							</conditions>
						</Item>
					</conditionalImpacts>
				</Item>
			</effects>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
