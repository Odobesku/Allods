<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739846107</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Buff.(BuffResource).Name.txt" />
	<Description href="Buff.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Engineer/EngineerTurret.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Engineer/ArtilleryForm.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.DamageThreshold">
			<healthCalcer type="gameMechanics.elements.calcers.FloatData">
				<value>1</value>
			</healthCalcer>
			<healthScalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
				<mulCalcer type="gameMechanics.elements.calcers.CalcerMul">
					<calcers>
						<Item type="gameMechanics.elements.calcers.FullHealthCalcer" />
						<Item type="gameMechanics.elements.calcers.CalcerIf">
							<predicate type="gameMechanics.elements.predicates.PredicateHasSpell">
								<spell href="Spell03.(SpellSingleTarget).xdb" />
								<anyRank>false</anyRank>
							</predicate>
							<calcerIf type="gameMechanics.elements.calcers.FloatData">
								<value>0.4</value>
							</calcerIf>
							<calcerElse type="gameMechanics.elements.calcers.CalcerIf">
								<predicate type="gameMechanics.elements.predicates.PredicateHasSpell">
									<spell href="Spell02.(SpellSingleTarget).xdb" />
									<anyRank>false</anyRank>
								</predicate>
								<calcerIf type="gameMechanics.elements.calcers.FloatData">
									<value>0.3</value>
								</calcerIf>
								<calcerElse type="gameMechanics.elements.calcers.FloatData">
									<value>0.2</value>
								</calcerElse>
							</calcerElse>
						</Item>
						<Item type="gameMechanics.elements.calcers.AbilityRankCalcer">
							<ability href="/Mechanics/Spells/Engineer/Abilities/MantrapExtraFuel/Ability01.(AbilityResource).xdb" />
							<mul>0.1</mul>
							<sum>1</sum>
						</Item>
					</calcers>
				</mulCalcer>
			</healthScalerTarget>
			<regenCalcer type="gameMechanics.elements.calcers.FloatData">
				<value>1</value>
			</regenCalcer>
			<regenScalerTarget type="gameMechanics.elements.scalers.LinearScaler">
				<multiplier>0</multiplier>
			</regenScalerTarget>
			<outOfCombatPolicy>Nothing</outOfCombatPolicy>
			<priority>Multiplier</priority>
			<affectsPureDamage>true</affectsPureDamage>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.SpellRangeSetter">
			<spells>
				<Item href="/Mechanics/Spells/Engineer/AirStrike/Spell01.(SpellArea).xdb" />
				<Item href="/Mechanics/Spells/Engineer/Shots/Acid/Spell01.(SpellSingleTarget).xdb" />
				<Item href="/Mechanics/Spells/Engineer/Shots/Astral/Spell01.(SpellSingleTarget).xdb" />
				<Item href="/Mechanics/Spells/Engineer/Shots/Electricity/Spell01.(SpellSingleTarget).xdb" />
				<Item href="/Mechanics/Spells/Engineer/Shots/Fire/Spell01.(SpellSingleTarget).xdb" />
				<Item href="/Mechanics/Spells/Engineer/Drones/Spell01.(SpellSingleTarget).xdb" />
				<Item href="/Mechanics/Spells/Engineer/AntiMatter/Spell01.xdb" />
				<Item href="/Mechanics/Spells/Engineer/LaserShot/Spell01.(SpellSingleTarget).xdb" />
				<Item href="/Mechanics/Spells/Engineer/MiniTurrets/Spell01.xdb" />
				<Item href="/Mechanics/Spells/Engineer/MeleeBot/Spell01.(SpellArea).xdb" />
			</spells>
			<minBaseRange>0</minBaseRange>
			<newRange type="gameMechanics.elements.calcers.FloatData">
				<value>60</value>
			</newRange>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
			<groups>
				<Item href="/Mechanics/Spells/Groups/EngineerArtillerySpells.(ActionGroup).xdb" />
				<Item href="/Mechanics/Spells/Groups/FairySpells.xdb" />
				<Item href="/Mechanics/Spells/Groups/AlchemyPots.(ActionGroup).xdb" />
			</groups>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectAddContextActions">
			<actions>
				<Item href="AbandonSpell.(SpellSingleTarget).xdb" />
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
					<groups>
						<Item href="/Mechanics/Spells/Groups/Knockdowns.xdb" />
					</groups>
				</Item>
			</predicates>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
			<mark href="/Mechanics/Spells/Engineer/Shots/Fire/Engineer_FireShot.(MarkResource).xdb" />
			<instantiateOnUse>false</instantiateOnUse>
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="FireShot_Buff.(BuffResource).xdb" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
			<mark href="/Mechanics/Spells/Engineer/Shots/Acid/Engineer_AcidShot.(MarkResource).xdb" />
			<instantiateOnUse>false</instantiateOnUse>
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="AcidShot_Buff.(BuffResource).xdb" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
			<mark href="/Mechanics/Spells/Engineer/Shots/Electricity/Engineer_ElectroShot.(MarkResource).xdb" />
			<instantiateOnUse>false</instantiateOnUse>
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="ElectroShot_Buff.(BuffResource).xdb" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
			<mark href="/Mechanics/Spells/Engineer/Shots/Astral/Engineer_AstralShot.(MarkResource).xdb" />
			<instantiateOnUse>false</instantiateOnUse>
			<impacts>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="AstralShot_Buff.(BuffResource).xdb" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Exo1SkinAuto.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.clientCommands.ImpactRideMount">
							<mount href="/Mechanics/Mounts/6thGrade/Mounts/ExoMount01Base.(MountResource).xdb" />
							<skin href="/Mechanics/Mounts/Skins/ExoMounts/ExoMount01Base.(MountSkin).xdb" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Exo1SkinAutoRed.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.clientCommands.ImpactRideMount">
							<mount href="/Mechanics/Mounts/6thGrade/Mounts/ExoMount01Base.(MountResource).xdb" />
							<skin href="/Mechanics/Mounts/Skins/ExoMounts/ExoMount01Red.(MountSkin).xdb" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Exo1SkinAutoGreen.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.clientCommands.ImpactRideMount">
							<mount href="/Mechanics/Mounts/6thGrade/Mounts/ExoMount01Base.(MountResource).xdb" />
							<skin href="/Mechanics/Mounts/Skins/ExoMounts/ExoMount01Green.(MountSkin).xdb" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Exo1SkinAutoYellow.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.clientCommands.ImpactRideMount">
							<mount href="/Mechanics/Mounts/6thGrade/Mounts/ExoMount01Base.(MountResource).xdb" />
							<skin href="/Mechanics/Mounts/Skins/ExoMounts/IMExo.(MountSkin).xdb" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Exo1TempSkinAutoYellow.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.clientCommands.ImpactRideMount">
							<mount href="/Mechanics/Mounts/6thGrade/Mounts/IMExo.(MountResource).xdb" />
							<skin href="/Mechanics/Mounts/Skins/ExoMounts/IMExo.(MountSkin).xdb" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<duration>1000</duration>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<ranks>
		<Item href="Buff01.(BuffResource).xdb" />
		<Item href="Buff02.(BuffResource).xdb" />
		<Item href="Buff03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
