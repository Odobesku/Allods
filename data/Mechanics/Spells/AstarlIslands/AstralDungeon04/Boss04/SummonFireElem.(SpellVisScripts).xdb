<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellDirected</Item>
                </animations>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionList">
                        <play>Simultaneously</play>
                        <playWhile type="VisActionDelay">
                            <time>1000</time>
                        </playWhile>
                        <elements>
                            <Item type="CreatureEffectsAction">
                                <visActionID>globalfxgr</visActionID>
                                <visualEffects>
                                    <Item>
                                        <effectFx href="/Spells/FX/Spells/PierBossSpear_Fire.(VisObjectTemplate).xdb" />
                                        <scale>4</scale>
                                        <fadeInTime>500</fadeInTime>
                                        <fadeOutTime>1250</fadeOutTime>
                                        <locator>FROM_LOCATOR_NAME</locator>
                                        <locatorName>Slot_Special01</locatorName>
                                    </Item>
                                </visualEffects>
                            </Item>
                        </elements>
                    </Item>
                    <Item type="VisActionList">
                        <play>Simultaneously</play>
                        <playWhile type="VisActionDelay">
                            <time>1000</time>
                        </playWhile>
                        <elements>
                            <Item type="CreatureEffectsAction">
                                <visActionID>globalfxgr</visActionID>
                                <visualEffects>
                                    <Item>
                                        <effectFx href="/Spells/FX/Spells/PierBossSpear_Fire.(VisObjectTemplate).xdb" />
                                        <scale>5</scale>
                                        <fadeInTime>500</fadeInTime>
                                        <fadeOutTime>1250</fadeOutTime>
                                        <locator>FROM_LOCATOR_NAME</locator>
                                        <locatorName>Slot_Special01</locatorName>
                                    </Item>
                                </visualEffects>
                            </Item>
                        </elements>
                    </Item>
                    <Item type="VisActionList">
                        <play>Simultaneously</play>
                        <playWhile type="VisActionDelay">
                            <time>1000</time>
                        </playWhile>
                        <elements>
                            <Item type="CreatureEffectsAction">
                                <visActionID>globalfxgr</visActionID>
                                <visualEffects>
                                    <Item>
                                        <effectFx href="/Spells/FX/Spells/PierBossSpear_Fire.(VisObjectTemplate).xdb" />
                                        <scale>6</scale>
                                        <fadeInTime>500</fadeInTime>
                                        <fadeOutTime>1250</fadeOutTime>
                                        <locator>FROM_LOCATOR_NAME</locator>
                                        <locatorName>Slot_Special01</locatorName>
                                    </Item>
                                </visualEffects>
                            </Item>
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="VisActionDelay">
            <time>2000</time>
        </playWhile>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_ABILITY</channel>
                <channelOverrideMode>OVERRIDE_STOP</channelOverrideMode>
                <advanced>
                    <animationKeysAction>
                        <Item>
                            <action type="CreatureEffectsAction">
                                <visActionID>globalfxgr</visActionID>
                                <visualEffects>
                                    <Item>
                                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectFireWand_Cast.(VisObjectTemplate).xdb" />
                                        <fixPoint>true</fixPoint>
                                        <scale>5</scale>
                                        <fadeInTime>500</fadeInTime>
                                        <fadeOutTime>1250</fadeOutTime>
                                        <locator>FROM_LOCATOR_NAME</locator>
                                        <locatorName>Slot_Special01</locatorName>
                                        <offset z="0.5" />
                                    </Item>
                                </visualEffects>
                            </action>
                        </Item>
                    </animationKeysAction>
                </advanced>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>