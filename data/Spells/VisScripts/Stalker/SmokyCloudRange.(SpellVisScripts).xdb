<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/OmniNoWand.(SpellVisScripts).xdb" />
		<Variables>
			<PreCastAnimation />
			<CastAnimation>spellCastDirectedDispell</CastAnimation>
			<FXOnCaster />
			<PreCastFX />
			<FXWand>/Spells/FX/Spells/StalkerSmokyCloud_Hand63.(VisObjectTemplate).xdb</FXWand>
			<FixPointCaster>false</FixPointCaster>
		</Variables>
	</Header>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<advanced>
					<turnToTarget>BEFORE_ANIMATIONEND</turnToTarget>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item skiped="" />
							<Item>
								<locator>Slot_BodyFX</locator>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureHoldWeaponAction">
				<hold>WEAPON_NONE</hold>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
