<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739921228</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
    </groups>
    <element>ASTRAL</element>
    <Name href="Spell.(SpellSingleTarget).Name.txt" />
    <Description href="Spell.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>dur</name>
            <value var="dur" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Mage/ResistElements.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mage/ResistElements.(SpellVisScripts).xdb" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="Buff.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Buff.(BuffResource).xdb" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier var="dur" />
                        </durationScaler>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>