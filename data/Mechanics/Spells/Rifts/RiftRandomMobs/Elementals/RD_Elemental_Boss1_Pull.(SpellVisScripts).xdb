<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureVisActionStartThrow" />
                    <Item type="CreatureProjectileAction">
                        <projectileFx href="/Spells/FX/Spells/Engineer_AstralProjectile.(VisObjectTemplate).xdb" />
                        <explosionFx href="/Spells/FX/Spells/PsionicTelekineticThrowAbility.(VisObjectTemplate).xdb" />
                    </Item>
                </elements>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>