<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>739912468</resourceId>
    </Header>
    <name href="RoomChangeLayout.(Cue).Name.txt" />
    <text href="RoomChangeLayout.(Cue).Text.txt" />
    <conditions>
        <Item type="gameMechanics.elements.predicates.PredicateHasItemsCount">
            <items>
                <Item href="/ItemMall/Services/StrongholdReset/Layout2.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
            </items>
            <totalCount>1</totalCount>
            <checkDress>false</checkDress>
        </Item>
    </conditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactsToInterlocutor">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="itemService.avatar.stronghold.PredicateBossRoom" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="itemService.avatar.stronghold.ImpactRoomSpawnLayout">
                            <layout href="/Mechanics/Stronghold/SpawnLayouts/DungeonRoomSpawnLayout1.xdb#xpointer(/gameMechanics.world.stronghold.spawn.DungeonRoomSpawnLayout)" />
                            <paymentResource href="/ItemMall/Services/StrongholdReset/Layout2.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                    <data href="CantChangeBoss.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>