<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>225147</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.75</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ReactorBoss_F2.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.Aura">
            <affectGroup>Enemies</affectGroup>
            <radius>20</radius>
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="ReactorBoss_Projectile_drags.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                        <resource href="ReactorBoss_Projectile_FirePuddle_big.(ProjectileResource).xdb" />
                                    </projectileData>
                                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Umoir_Reactor_Boss_F3_atack.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="ReactorBoss_Burn_Big.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.constructor.basicElements.ImpactNull" />
                    </impactsElse>
                </Item>
            </impactsIn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Umoir_Reactor_Boss_lightining.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>UR_R_DoorEnter</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                            <visualState>2</visualState>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="ReactorFirstVisit.(MapVariableResource).xdb" />
                    <summand>1</summand>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Mechanics/Spells/TepPyramidBosses/Spy.(BuffResource).xdb" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactBunchesAround">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateProjectile" />
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="/Maps/UmoirRaid/SpawnTables/UmoirRaid/UR_Boss_Firebird.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="/Maps/UmoirRaid/SpawnTables/UmoirRaid/UR_Boss_Firebird_Item.(MobSpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>UR_R_DoorEnter</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                            <visualState>1</visualState>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsOnZoneAvatarsGeneric">
                    <zone href="/Maps/UmoirRaid/Zones/UmoirRaid/UmoirRaid.(ZoneResource).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ReactorBoss_Projectile_drags.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ReactorBoss_Burn_Big.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ReactorBoss_Projectile_Decal.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/Spells/TepPyramidBosses/Spy.(BuffResource).xdb" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.5</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ReactorBoss_F3_vis.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ReactorBoss_F2.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <affectGroup>Enemies</affectGroup>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="ReactorBoss_Projectile_drags.(MobWorld).xdb" />
                                                <Item href="ReactorBoss_Projectile.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impactsIf>
                                </Item>
                            </impacts>
                            <targetsLimit>3</targetsLimit>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.tools.SelectorShuffle" />
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ReactorBoss_Projectile_drags.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ReactorBoss_Burn_Big.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ReactorBoss_Projectile_Decal.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>UR_R_DoorEnter</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                            <visualState>1</visualState>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="Umoir_Reactor_Boss.(MapVariableResource).xdb" />
                    <summand>1</summand>
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="/Maps/UmoirRaid/SpawnTables/UmoirRaid/UR_Skrakan.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>Reactor_Chest</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb" />
                    </device>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
            <quality href="Reactor.(MobStatQuality).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Umoir_Reactor_Boss_lightining.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>