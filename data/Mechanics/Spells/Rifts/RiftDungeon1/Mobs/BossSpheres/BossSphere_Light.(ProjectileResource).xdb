<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739920349</resourceId>
    </Header>
    <visObject href="/Spells/FX/World/AC5_buf2.(VisObjectTemplate).xdb" />
    <altitude>1.4</altitude>
    <speed>0.002</speed>
    <lifeLengthCap>14000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.TickableEntityAura">
                    <affectGroup>All</affectGroup>
                    <radius>2</radius>
                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                        <filters>
                            <Item type="gameMechanics.world.creature.AvatarFilter" />
                            <Item type="gameMechanics.world.creature.AliveFilter" />
                        </filters>
                    </filter>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.DirectHeal">
                            <heal>1</heal>
                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                    <multiplier>0.3</multiplier>
                                </mulCalcer>
                            </scalerTarget>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="BossSphere_Light.(ClientData).xdb" />
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="BossSphere_Light_HoT.(BuffResource).xdb" />
                        </Item>
                    </impactsIn>
                    <holderImpactsIn>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </holderImpactsIn>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.EntityImpactEntitiesAround">
                            <radius>2</radius>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                            <resources>
                                                <Item href="BossSphere_dark.(ProjectileResource).xdb" />
                                            </resources>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>