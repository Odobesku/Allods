                                <Item href="/Mechanics/RaidInstances/FerrisRaid/Other/ArchitectDoor.(DoorResource).xdb" />
                            </deviceResources>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
                            <visualState>2</visualState>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ReturningImpact">
