<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>201684</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/FootballSpells.xdb" />
    </groups>
    <Name href="GoalkeeperStrike.(SpellCasterSelf)_Name.txt" />
    <image href="/Interface/Icons/Context/BlowOnTheBall.(UISingleTexture).xdb" />
    <aeMarker href="/Mechanics/Spells/AEMarks/AEMarkerFootball.(AEMarkerDecal).xdb" />
    <sysName>Agob_7</sysName>
    <nameTemplate href="GoalkeeperStrikeName.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <targetType>STTPoint</targetType>
    <mechanics>
        <cooldown>
            <duration>2000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="FootballGameplayV2/WaitBall_Buff.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="FootballGameplayV2/YourMoveBuff.(BuffResource).xdb" />
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                <data href="StrikeBallStrong.(ClientData).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="RedTeam.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>2.5</radius>
                                <affectHolder>false</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                                        <time>1500</time>
                                        <impactsOnLand>
                                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                <buff href="FootballGameplayV2/ForgetStickyAbility.(BuffResource).xdb" />
                                            </Item>
                                        </impactsOnLand>
                                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="FootballGameplayV2/FootballCannotBlockBall.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="RedTeam_hit.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Creatures/Slime/Instances/ArchipelagoEmpire2/SlimeBall.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                </filter>
                                <targetsLimit>1</targetsLimit>
                            </Item>
                        </impacts>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>2.5</radius>
                                <affectHolder>false</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                                        <time>1500</time>
                                        <impactsOnLand>
                                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                <buff href="FootballGameplayV2/ForgetStickyAbility.(BuffResource).xdb" />
                                            </Item>
                                        </impactsOnLand>
                                        <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="FootballGameplayV2/FootballCannotBlockBall.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="BlueTeam_hit.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                            <mobs>
                                                <Item href="/Creatures/Slime/Instances/ArchipelagoEmpire2/SlimeBall.(MobWorld).xdb" />
                                            </mobs>
                                        </Item>
                                    </predicates>
                                </filter>
                                <targetsLimit>1</targetsLimit>
                            </Item>
                        </impacts>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>