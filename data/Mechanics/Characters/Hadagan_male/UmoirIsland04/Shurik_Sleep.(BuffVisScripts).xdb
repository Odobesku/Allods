<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<playWhile type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/DruidDrowsingPotion_buff.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<fixPoint>true</fixPoint>
					<scale>0.5</scale>
					<locator>Slot_Global</locator>
				</Item>
			</visualEffects>
		</playWhile>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>sleep</Item>
				</animations>
			</Item>
		</elements>
	</action>
	<postAction type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>sleepUp</Item>
				</animations>
			</Item>
			<Item type="VisActionDelay">
				<time>1000</time>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>emoteDrink</Item>
						</animations>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/DrinkPotion_Bottle.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<locator>Slot_Hand_R</locator>
								<member>All_Members_WithoutMount</member>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</postAction>
</BuffVisScripts>
