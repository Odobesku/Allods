                                    </predicate>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="RD3_Add_EvilEye_Bubble.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.CasterLostWatcherGeneric">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="RD3_Add_EvilEye_BubbleRay.(BuffResource).xdb" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                </Item>
            </impacts>
