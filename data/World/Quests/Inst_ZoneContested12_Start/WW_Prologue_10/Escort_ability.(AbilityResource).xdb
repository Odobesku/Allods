<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739923459</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<eventClasses>
				<Item>gameMechanics.world.mob.behaviour.aiEvents.GoneThroughPathEvent</Item>
			</eventClasses>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.predicates.PredicateFaction">
													<faction href="/World/Factions/Empire.xdb" />
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
													<id href="Counter1.(QuestCountId).xdb" />
												</Item>
											</impactsIf>
											<impactsElse>
												<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
													<id href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_10_L/Counter1.(QuestCountId).xdb" />
												</Item>
											</impactsElse>
										</Item>
									</impacts>
								</Item>
							</impacts>
							<finishImpacts>
								<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
									<delay>1000</delay>
									<impacts>
										<Item type="gameMechanics.elements.impacts.Disintegrate" />
									</impacts>
								</Item>
							</finishImpacts>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.SpawnTableObjects">
					<table href="/Maps/Inst_ZoneContested12_Start/SpawnTables/WW_Prologue_10_Seeress.(SpawnTable).xdb" />
				</Item>
			</impacts>
			<eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
					<delay>2000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.Disintegrate" />
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
									<quest href="WW_Prologue_10.xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
									<quest href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_10_L/WW_Prologue_10_L.xdb" />
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Aura">
			<radius>30</radius>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ReturningImpact">
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_10_L/StopMovement.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsIn>
			<impactsOut>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_10_L/StopMovement.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsOut>
		</Item>
		<Item type="gameMechanics.elements.effects.Aura">
			<radius>8</radius>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ReturningImpact">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Mechanics/QuestSchemes/Maintenance/Speed.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsIn>
			<impactsOut>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ReturningImpact">
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="/Mechanics/QuestSchemes/Maintenance/Speed.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsOut>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
