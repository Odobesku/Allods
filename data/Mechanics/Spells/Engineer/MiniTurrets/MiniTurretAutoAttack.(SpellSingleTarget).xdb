                        <Item type="gameMechanics.elements.scalers.ScalerBuff">
                            <buff href="/Mechanics/Spells/Engineer/MeleeBot/SpellToMobDamageTransmission.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <multiplier>0.01</multiplier>
                            <summand>0</summand>
                        </Item>
                    </scalers>
                </scaler>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>30</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>