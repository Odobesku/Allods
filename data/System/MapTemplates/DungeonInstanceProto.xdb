<?xml version="1.0" encoding="UTF-8" ?>
<mapLoader.MapTemplate>
	<Header>
		<resourceId>372587553</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<hasPatches>true</hasPatches>
	<headParts>
		<parts>
			<Item type="gameMechanics.map.basicElements.MapSpecificEffects">
				<effects>
					<Item type="gameMechanics.elements.effects.EffectsIfTarget">
						<predicates>
							<Item type="gameMechanics.world.stronghold.spawn.PredicateDungeonDefender" />
						</predicates>
						<effectsIf>
							<Item type="gameMechanics.elements.effects.Switch">
								<impactsOn>
									<Item type="gameMechanics.elements.impacts.ImpactSetFaction">
										<faction hrefvar="beastFaction" />
									</Item>
								</impactsOn>
							</Item>
						</effectsIf>
					</Item>
					<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
						<group href="/Mechanics/Spells/Groups/MassTeleport.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
					</Item>
				</effects>
			</Item>
		</parts>
	</headParts>
	<cellParts>
		<parts>
			<Item type="gameMechanics.map.spawn.SummonPoolManager">
				<globalPool href="/System/GlobalSummonPools/SummonPoolLimitedInstance.xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
			</Item>
		</parts>
	</cellParts>
	<denyCells>true</denyCells>
	<mechanicsSettings>
		<requireExit>true</requireExit>
		<forDwellersOnly>true</forDwellersOnly>
		<autoNavigation>false</autoNavigation>
	</mechanicsSettings>
</mapLoader.MapTemplate>
