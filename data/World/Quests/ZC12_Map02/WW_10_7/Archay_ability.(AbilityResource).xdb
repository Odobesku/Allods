            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.Aura">
            <radius>70</radius>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
