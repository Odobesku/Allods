<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739920588</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
    </groups>
    <Name href="Spell0.(SpellArea).Name.txt" />
    <Description href="Spell0.(SpellArea).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="avgDamage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>WeaponScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Mounts/SpellsMounts/ScorpioStun.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Warrior/ThunderStrike.(SpellVisScripts).xdb" />
    <targetType>STTSelf</targetType>
    <ranks>
        <Item href="Spell01.(SpellArea).xdb" />
        <Item href="Spell02.(SpellArea).xdb" />
        <Item href="Spell03.(SpellArea).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>5</duration>
            <scaler type="gameMechanics.elements.scalers.WeaponSpeedScaler" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceCombatAdvantage">
                <minValue>55</minValue>
                <ability href="/Mechanics/Spells/War63/Abilities/CombatAdvantage/Ability.(AbilityResource).xdb" />
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalWeaponDamage">
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                                <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                            </scalers>
                        </scaler>
                        <avgDamage var="avgDamage" />
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>15</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>