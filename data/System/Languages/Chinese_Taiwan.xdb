<?xml version="1.0" encoding="UTF-8" ?>
<basement.server.lang.NameRules>
	<Header>
		<resourceId>185950224</resourceId>
	</Header>
	<name>tw</name>
	<lang>tw</lang>
	<country>Taiwan</country>
	<avatarNameRules>
		<matchUser>[A-Za-z]+</matchUser>
		<matchMaster>[A-Za-z0-9_ \-\[\]]+</matchMaster>
		<minLength>4</minLength>
		<maxLength>13</maxLength>
		<transformation>NoTransformation</transformation>
	</avatarNameRules>
	<shipNameRules>
		<matchUser>[A-Za-z]+(\-\d+)?</matchUser>
		<minLength>4</minLength>
		<maxLength>13</maxLength>
		<transformation>NoTransformation</transformation>
	</shipNameRules>
	<guildNameRules>
		<matchUser>[A-Za-z]+( |\-|\')?[A-Za-z]+</matchUser>
		<minLength>3</minLength>
		<maxLength>30</maxLength>
		<transformation>NoTransformation</transformation>
	</guildNameRules>
	<deniedWords href="deniedWords_Taiwan.txt" />
</basement.server.lang.NameRules>
