<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>220776</resourceId>
    </Header>
    <Name href="ArrhythmiaHM.(BuffResource).Name.txt" />
    <visScript href="Arrhythmia.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>100</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>6.75</radius>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                                            <damage>1</damage>
                                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                                    <buff href="ArrhythmiaHM_01.(BuffResource).xdb" />
                                                </mulCalcer>
                                            </scaler>
                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                    <multiplier>0.1</multiplier>
                                                </mulCalcer>
                                            </scalerTarget>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                        </predicates>
                                    </filter>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>2000</duration>
    <stackLimit>10</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>