<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739874613</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.SpellCastTrigger">
			<conditionalImpacts>
				<Item>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
								</moveType>
								<resource href="Spell_04.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
							</projectileData>
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Spell_04_stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
					<conditions>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="Spell_04.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
							</spells>
						</Item>
					</conditions>
				</Item>
			</conditionalImpacts>
			<stages>
				<Item>Start</Item>
			</stages>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactSetFaction">
							<faction href="/World/Factions/AllFriends.(Faction).xdb#xpointer(/gameMechanics.world.creature.Faction)" />
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Mechanics/Spells/AstarlIslands/AI62/Boss/AI62_Boss01/AI62_Izba_wait.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactSummon">
					<destination type="gameMechanics.map.destination.RelativePos" />
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
									<delay>1000</delay>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
											<time>2000</time>
											<impactsOnLand>
												<Item type="gameMechanics.elements.impacts.ImpactOverrideInterruptPos">
													<pos type="gameMechanics.map.destination.DestinationLocator">
														<locator>
															<scriptID>AI62_M_00</scriptID>
															<map href="/Maps/AstralIsle62/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
														</locator>
													</pos>
												</Item>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/Spells/AstarlIslands/AI62/Boss/AI62_Boss02/AI62_muzhik_Stun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
												</Item>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="/Mechanics/Spells/AstarlIslands/AI62/Boss/AI62_Boss02/AI62_muzhik_AntiTalk.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
												</Item>
											</impactsOnLand>
											<destination type="gameMechanics.map.destination.DestinationLocator">
												<locator>
													<scriptID>AI62_M_00</scriptID>
													<map href="/Maps/AstralIsle62/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
												</locator>
											</destination>
										</Item>
									</impacts>
								</Item>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="/Mechanics/Spells/AstarlIslands/AI62/Boss/AI62_Boss02/AI62_muzhik_AntiTalk.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
						</Item>
					</impacts>
					<object href="/Mechanics/Spells/AstarlIslands/AI62/Boss/AI62_Boss02/AI62_muzhik.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/Spells/AstarlIslands/AI62/Boss/AI62_Boss01/AI62_Izba_wait.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOn>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
