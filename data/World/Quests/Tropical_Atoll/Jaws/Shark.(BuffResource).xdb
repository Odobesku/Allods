<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739979077</resourceId>
	</Header>
	<Name href="Shark.(BuffResource).Name.txt" />
	<Description href="Shark.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Mining/FishHead.(UISingleTexture).xdb" />
	<visScript href="Shark.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactDismount" />
				<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
					<id href="Mask.(QuestCountId).xdb" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
							<quest href="Quest.(QuestResource).xdb" />
							<counterResource href="Kills.(QuestCountId).xdb" />
							<value>2</value>
						</Item>
					</predicates>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="Mask.(QuestCountId).xdb" />
							<value>-1</value>
							<targetAvatarOnly>true</targetAvatarOnly>
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="SharkDetach.(ClientData).xdb" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActionsExceptGroup">
			<groups>
				<Item href="/Mechanics/Spells/Groups/MountedSpells.xdb" />
				<Item href="/Mechanics/Spells/Groups/ActionBarChange.(ActionGroup).xdb" />
			</groups>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Jump</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.constructor.basicElements.EffectList">
			<effectsResource href="/Mechanics/GameRoot/Mount/HidePetMountAbility.(EffectListResource).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectGiveSpell">
			<spell href="Scare.(SpellSingleTarget).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.Aura">
			<affectGroup>Friends</affectGroup>
			<radius>5</radius>
			<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactAddContextAction">
					<action href="Escape.(SpellSingleTarget).xdb" />
					<period>5000</period>
				</Item>
			</impactsIn>
			<impactsOut>
				<Item type="gameMechanics.elements.impacts.ImpactRemoveContextAction">
					<action href="Escape.(SpellSingleTarget).xdb" />
				</Item>
			</impactsOut>
			<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromGroup">
							<groups>
								<Item href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
							</groups>
						</predicate>
					</Item>
					<Item type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Shark.(BuffResource).xdb" />
						</predicate>
					</Item>
				</predicates>
			</filter>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectHandleLeaveMission">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
							<quest href="Quest.(QuestResource).xdb" />
							<counterResource href="Kills.(QuestCountId).xdb" />
							<value>2</value>
						</Item>
					</predicates>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="Mask.(QuestCountId).xdb" />
							<value>-1</value>
							<targetAvatarOnly>true</targetAvatarOnly>
						</Item>
					</impactsElse>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectSwimTrigger">
			<impactsOnStopSwim>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="Shark.(BuffResource).xdb" />
				</Item>
			</impactsOnStopSwim>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Events/EventBuffs.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
