<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739850826</resourceId>
    </Header>
    <Name href="Buff_03_02.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/Insurance.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <nameTemplate href="Buff_03_02.(BuffResource).NameTemplate.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.PartiallyScaledMagicDamage">
                    <element>HOLY</element>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer href="LevelDiminishingUniversal.(CalcerFloatResource).xdb#xpointer(/constructor.elements.CalcerFloatResource)" />
                        </mulCalcer>
                    </scalerTarget>
                    <damage>14.214</damage>
                    <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                        <scalers>
                            <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.OverLevelPenaltyCalcer">
                                    <level>9</level>
                                    <exponent>1</exponent>
                                    <multiplier>0.03</multiplier>
                                </mulCalcer>
                            </Item>
                            <Item type="gameMechanics.elements.scalers.ScalerIf">
                                <condition type="gameMechanics.elements.predicates.PredicateManaCaster">
                                    <manaType>Mana</manaType>
                                </condition>
                                <scalerIf type="gameMechanics.elements.scalers.MagicScaler" />
                                <scalerElse type="gameMechanics.elements.scalers.SlotScaler">
                                    <slot>MAINHAND</slot>
                                </scalerElse>
                            </Item>
                            <Item type="gameMechanics.elements.scalers.OffensiveRunesScaler" />
                        </scalers>
                    </scaler>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>