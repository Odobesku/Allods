        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
        <Item href="/Mechanics/Spells/Groups/BardDissonance.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/BardChord.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
    </groups>
    <Name href="Dissonance.(SpellSingleTarget).Name.txt" />
    <Description href="Dissonance.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>WeaponScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/Dissonance.(UISingleTexture).xdb" />
