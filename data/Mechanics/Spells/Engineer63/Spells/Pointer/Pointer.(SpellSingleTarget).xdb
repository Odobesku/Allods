<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739932729</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
	</groups>
	<Name href="Pointer.(SpellSingleTarget).Name.txt" />
	<Description href="Pointer.(SpellSingleTarget).Description.txt" />
	<image href="/Interface/Icons/Misc/Itemmall/IMFireworkTarget.(UISingleTexture).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>45</value>
	</range>
	<isAggro>false</isAggro>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>3000</duration>
		</cooldown>
		<conditions>
			<Item type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
						<affectGroup>Enemies</affectGroup>
					</Item>
					<Item type="gameMechanics.elements.predicates.PredicateAffectGroup">
						<affectGroup>Raid</affectGroup>
					</Item>
				</predicates>
			</Item>
		</conditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIsolator">
				<impacts>
					<Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactsIf">
								<predicate type="gameMechanics.elements.predicates.PredicateIsAggroLeader" />
								<impactsElse>
									<Item type="gameMechanics.elements.impacts.ImpactResetActiveAction" />
								</impactsElse>
							</Item>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="PointOnAssistants.(BuffResource).xdb" />
							</Item>
						</impacts>
						<assistantResource href="/Mechanics/Spells/Engineer63/Spells/Turret/Turret.(AssistantResource).xdb" />
					</Item>
					<Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactsIf">
								<predicate type="gameMechanics.elements.predicates.PredicateIsAggroLeader" />
								<impactsElse>
									<Item type="gameMechanics.elements.impacts.ImpactResetActiveAction" />
								</impactsElse>
							</Item>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="PointOnAssistants.(BuffResource).xdb" />
							</Item>
						</impacts>
						<assistantResource href="/Mechanics/Spells/Engineer63/Spells/Turret/TurretDouble.(AssistantResource).xdb" />
					</Item>
				</impacts>
			</Item>
			<Item type="gameMechanics.elements.abilities.ImpactPsionicContact">
				<contactType>Normal</contactType>
				<duration>10000</duration>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactIsolator">
				<impacts>
					<Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactResetActiveAction" />
						</impacts>
						<assistantResource href="/Mechanics/Spells/Engineer63/Spells/Drill/Drill.(AssistantResource).xdb" />
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactsIf">
				<predicate type="gameMechanics.elements.predicates.PredicateAffectGroup">
					<affectGroup>Friends</affectGroup>
				</predicate>
				<impactsIf>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="PointOnFriend.(BuffResource).xdb" />
					</Item>
				</impactsIf>
				<impactsElse>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="PointOnTarget.(BuffResource).xdb" />
					</Item>
					<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
						<value>1</value>
					</Item>
				</impactsElse>
			</Item>
		</targetImpacts>
		<linkedAbility href="PointerContact.(AbilityResource).xdb" />
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
