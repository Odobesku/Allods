<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>356690956</resourceId>
	</Header>
	<Name href="Buff_Name.txt" />
	<Description href="Buff_Desc.txt" />
	<image href="/Interface/Icons/Mounts/ManaBikeSpeed.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Mount/ManaBike_Acceleration.(BuffVisScripts).xdb" />
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateMounted">
										<specificGroup href="/Mechanics/Mounts/Groups/ManaBikes.(MountGroupResource).xdb" />
									</Item>
									<Item type="gameMechanics.elements.predicates.PredicateMounted">
										<specificGroup href="/Mechanics/Mounts/Groups/ManaBikeTemp5Grade.(MountGroupResource).xdb" />
									</Item>
								</predicates>
							</predicate>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="TechAcceleration01.xdb" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="HasteStackTrigger.(BuffResource).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="HasteVisual.(BuffResource).xdb" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateMounted">
					<specificGroup href="/Mechanics/Mounts/Groups/ManaBikes.(MountGroupResource).xdb" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.EffectMountSpeedModifier">
					<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
						<coeff>0.13</coeff>
					</effectScaler>
				</Item>
				<Item type="gameMechanics.elements.effects.EffectStackChangeTrigger">
					<impactsOnIncrease>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
											<buff href="Acceleration01.xdb" />
											<range>
												<min>3</min>
												<max>4</max>
											</range>
										</Item>
										<Item type="gameMechanics.constructor.basicElements.PredicateNot">
											<predicate type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="HasteStackTrigger.(BuffResource).xdb" />
											</predicate>
										</Item>
										<Item type="gameMechanics.constructor.basicElements.PredicateNot">
											<predicate type="gameMechanics.elements.resources.ResourceBuff">
												<buff href="HasteVisual.(BuffResource).xdb" />
											</predicate>
										</Item>
									</predicates>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="HasteStackTrigger.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsOnIncrease>
					<impactsOnDecrease>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
									<predicates>
										<Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
											<buff href="Acceleration01.xdb" />
											<range>
												<max>2</max>
											</range>
										</Item>
									</predicates>
									<impacts>
										<Item type="gameMechanics.elements.impacts.BuffDetacher">
											<buff href="HasteStackTrigger.(BuffResource).xdb" />
										</Item>
										<Item type="gameMechanics.elements.impacts.BuffDetacher">
											<buff href="HasteVisual.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</impactsOnDecrease>
				</Item>
			</effectsIf>
			<effectsElse>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="HasteStackTrigger.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="HasteVisual.(BuffResource).xdb" />
						</Item>
					</impactsOn>
				</Item>
			</effectsElse>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectMountTrigger">
			<onBeforeDismount>
				<Item type="gameMechanics.elements.impacts.PostponedImpacts">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Acceleration01.xdb" />
						</Item>
					</impacts>
				</Item>
			</onBeforeDismount>
		</Item>
	</effects>
	<duration>6000</duration>
	<stackLimit>4</stackLimit>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
