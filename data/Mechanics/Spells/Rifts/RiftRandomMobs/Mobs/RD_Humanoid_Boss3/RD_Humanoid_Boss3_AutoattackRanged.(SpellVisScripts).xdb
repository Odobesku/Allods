<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureTurnToTargetAction" />
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>200</time>
                    </Item>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>spellCastDirected</Item>
                        </animations>
                        <channel>CHANNEL_ATTACK</channel>
                    </Item>
                </elements>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <elements>
            <Item type="CreatureVisActionStartThrow" />
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Spells/MageFireArrowAbility.(VisObjectTemplate).xdb" />
                <explosionFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb" />
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_Mouth</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </pointOnTarget>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>