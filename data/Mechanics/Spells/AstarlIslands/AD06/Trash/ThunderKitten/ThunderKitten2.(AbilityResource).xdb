<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739824892</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                    <ability href="ThunderKitten01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.AttachAbility">
                    <ability href="ThunderKitten01.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                    <value>9999</value>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                            <value>9999</value>
                        </Item>
                    </impacts>
                    <object href="/Creatures/CritterKitten/Instances/AstralDungeon06/Victimkitten.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>