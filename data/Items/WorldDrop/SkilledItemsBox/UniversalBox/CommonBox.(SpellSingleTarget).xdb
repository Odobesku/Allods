<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>501220</resourceId>
    </Header>
    <Name href="CommonBox.(SpellSingleTarget).Name.txt" />
    <Description href="CommonBox.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Prototypes/UseItem.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateActiveItemSlotType">
                <slotType>ItemBag</slotType>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceActiveItem" />
        </casterResources>
        <casterImpacts>
            <Item type="itemService.avatar.itemBag.ImpactGiveSkilledItem">
                <level type="gameMechanics.elements.calcers.CalcerActiveItemLevel" />
                <quality href="/Mechanics/ItemQualities/Uncommon.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>