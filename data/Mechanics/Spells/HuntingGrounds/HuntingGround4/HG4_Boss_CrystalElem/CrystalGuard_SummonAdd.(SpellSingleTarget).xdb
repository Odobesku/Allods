<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739877790</resourceId>
    </Header>
    <Name href="CrystalGuard_SummonAdd.(SpellSingleTarget).Name.txt" />
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>45000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                <selector type="gameMechanics.tools.SelectorSliceEqual">
                    <sourceSelector type="gameMechanics.tools.SelectorShuffle" />
                    <slicesCount>6</slicesCount>
                </selector>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
                <impacts>
                    <Item>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                        <destination type="gameMechanics.map.destination.RelativePos">
                                            <coord x="5" />
                                        </destination>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                <value>100000000</value>
                                            </Item>
                                        </impacts>
                                        <impactsFromTarget>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="Adds_Aura.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                        </impactsFromTarget>
                                        <object href="Crystal_Guards_Adds.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="Crystal_control.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>