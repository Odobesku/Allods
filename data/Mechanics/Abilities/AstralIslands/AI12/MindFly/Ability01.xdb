<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>237289</resourceId>
    </Header>
    <name href="Ability_Name.txt" />
    <image href="" />
    <effects>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.25</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                    <spell href="/Mechanics/Spells/AstarlIslands/AI12/MindFlyAura/Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>40</radius>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                    </impacts>
                    <filter type="gameMechanics.world.creature.MobFilter" />
                </Item>
            </onLeave>
        </Item>
    </effects>
    <majorEffect>-1</majorEffect>
    <level>1</level>
    <disableWhileDead>false</disableWhileDead>
    <saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>