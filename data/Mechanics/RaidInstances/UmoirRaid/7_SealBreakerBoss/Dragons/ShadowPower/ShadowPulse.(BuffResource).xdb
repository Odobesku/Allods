<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>225068</resourceId>
    </Header>
    <Name href="ShadowPulse.(BuffResource).Name.txt" />
    <Description href="ShadowPulse.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/CurseAstral.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Mobs/TepPyramid_Boss01_Curse.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <scale>1.5</scale>
            <locator>Slot_TopFX</locator>
        </Item>
    </visualEffects>
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>5</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>SHADOW</element>
                            <damage>200</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <perTargetScaling>Divide</perTargetScaling>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="/Spells/VisScripts/Bosses/DC_DemonBoss_03/AstralExplosion.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>4000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>