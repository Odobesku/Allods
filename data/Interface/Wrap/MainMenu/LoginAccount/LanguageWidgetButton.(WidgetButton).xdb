<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>LanguageWidgetButton</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <Size>55</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <Size>55</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>language_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>false</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag>value</TextTag>
    <Variants>
        <Item>
            <PushedOffset x="-2" y="2"/>
            <Reaction>language_pressed</Reaction>
            <ReactionRightClick>language_pressed</ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Wrap/MainMenu/LoginAccount/Language.txt"/>
                <LayerMain href="/Interface/Wrap/MainMenu/LoginAccount/ButtonLanguageDisabled.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateDisabled>
            <StateHighlighted>
                <FormatFileRef href="/Interface/Wrap/MainMenu/LoginAccount/Language.txt"/>
                <LayerMain href="/Interface/Wrap/MainMenu/LoginAccount/ButtonLanguageHighlighted.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Wrap/MainMenu/LoginAccount/Language.txt"/>
                <LayerMain href="/Interface/Wrap/MainMenu/LoginAccount/ButtonLanguageNormal.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed>
                <FormatFileRef href="/Interface/Wrap/MainMenu/LoginAccount/Language.txt"/>
                <LayerMain href="/Interface/Wrap/MainMenu/LoginAccount/ButtonLanguagePressed.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushed>
            <StatePushedHighlighted>
                <FormatFileRef href="/Interface/Wrap/MainMenu/LoginAccount/Language.txt"/>
                <LayerMain href="/Interface/Wrap/MainMenu/LoginAccount/ButtonLanguagePressedHighlighted.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StatePushedHighlighted>
            <TextFileRef href="/Interface/Wrap/MainMenu/LoginAccount/LanguageDef.txt"/>
            <reactionDblClick>language_pressed</reactionDblClick>
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
