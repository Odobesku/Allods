                <Item type="gameMechanics.elements.impacts.ImpactActiveSpellCancelCooldown" />
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="CooldownClearing.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
