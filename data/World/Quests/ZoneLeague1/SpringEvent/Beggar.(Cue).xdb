<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>318435</resourceId>
    </Header>
    <name href="Beggar.(Cue).Name.txt" />
    <text href="Beggar.(Cue).Text.txt" />
    <isSpecial>true</isSpecial>
    <conditions>
        <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
            <quest href="ReportL.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
            <status>Started</status>
        </Item>
        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
            <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                <quest href="ReportL.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <counterResource href="ReportCountL3.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                <value>1</value>
            </predicate>
        </Item>
    </conditions>
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
            <id href="ReportCountL3.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
            <currency href="/Mechanics/AlternativeCurrencies/Events/SpringCoupon.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
            <sumCalcer type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </sumCalcer>
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>