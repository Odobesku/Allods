<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>202024</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter />
            <onLeave>
                <Item type="gameMechanics.elements.impacts.DirectDamage">
                    <damage>1</damage>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>1</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.99</multiplier>
                        </mulCalcer>
                        <sum>0</sum>
                    </scalerTarget>
                </Item>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>IE1_Paladin02</scriptID>
                                <map href="/Maps/Inst_EmpireStart/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <onBehalfOfTarget>true</onBehalfOfTarget>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                    <value>100</value>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>