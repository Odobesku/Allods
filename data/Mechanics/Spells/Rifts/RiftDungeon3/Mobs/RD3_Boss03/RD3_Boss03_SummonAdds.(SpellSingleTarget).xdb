<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739925220</resourceId>
    </Header>
    <Name href="RD3_Boss03_SummonAdds.(SpellSingleTarget).Name.txt" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>300000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                <impact type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                        <modifier type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                            <radius type="gameMechanics.elements.calcers.FloatData">
                                                <value>6</value>
                                            </radius>
                                        </modifier>
                                    </Item>
                                </modifiers>
                            </destination>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                <Item type="gameMechanics.elements.impacts.AttachAbility">
                                    <ability href="/Mechanics/Spells/Rifts/Abilities/DisintegrateAdds.(AbilityResource).xdb" />
                                </Item>
                            </impacts>
                            <object href="RD3_Add_EvilEye.(MobWorld).xdb" />
                            <pool href="RD3_Boss03_SummonAdds.(SummonPool).xdb" />
                        </Item>
                    </impacts>
                </impact>
                <count type="gameMechanics.elements.calcers.FloatData">
                    <value>3</value>
                </count>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                <spell href="RD3_Boss03_AE.(SpellArea).xdb" />
                <duration>30000</duration>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>