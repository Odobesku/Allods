<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>readySpell</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="VisActionList">
                <play>InSequence</play>
                <elements>
                    <Item type="VisActionDelay">
                        <time>100</time>
                    </Item>
                    <Item type="VisActionList">
                        <elements>
                            <Item type="CreatureIndependentFxAction">
                                <visObject href="/Spells/FX/Spells/AOEAura_Red_R4.(VisObjectTemplate).xdb" />
                                <useCastPoint>true</useCastPoint>
                                <lifeTime>2</lifeTime>
                            </Item>
                            <Item type="CreatureIndependentFxAction">
                                <visObject href="/Spells/FX/Mobs/AI48_Boss_Ice_Attack_Fall_FX.(VisObjectTemplate).xdb" />
                                <useCastPoint>true</useCastPoint>
                                <lifeTime>3</lifeTime>
                            </Item>
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmni</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
            </Item>
            <Item type="CreatureIndependentFxAction">
                <visObject href="/Spells/FX/Mobs/AI48_Boss_Ice_Attack.(VisObjectTemplate).xdb" />
                <useCastPoint>true</useCastPoint>
                <scale>0.3</scale>
                <lifeTime>2</lifeTime>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>