<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpellOmni</Item>
				</animations>
				<advanced>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
			<Item type="CreatureLockRotationAction" />
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visActionID>precast_fx</visActionID>
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/WormGlacial_ReadySpell_GreaterAcid.(VisObjectTemplate).xdb" />
						<scale>3</scale>
						<fadeInTime>250</fadeInTime>
						<fadeOutTime>400</fadeOutTime>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<advanced>
					<turnToTarget>NO_TURN</turnToTarget>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>400</time>
					</Item>
					<Item type="VisActionList">
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Mobs/WormGlacial_Projectilel_AcidSpit.(VisObjectTemplate).xdb" />
								<explosionFx href="/Spells/FX/Mobs/WormGlacial_ProjectilelHitMedium_AcidSpit.(VisObjectTemplate).xdb" />
								<theGe>15</theGe>
								<pointOnCaster type="VisPointLocator">
									<locator>Slot_Mouth</locator>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator>Slot_Global</locator>
								</pointOnTarget>
							</Item>
							<Item type="VisActionStopAction">
								<stoppedActionID>precast_fx</stoppedActionID>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
