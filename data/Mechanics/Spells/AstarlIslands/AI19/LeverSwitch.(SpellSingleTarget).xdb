<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739888766</resourceId>
	</Header>
	<Name href="LeverSwitch.(SpellSingleTarget).Name.txt" />
	<Description href="LeverSwitch.(SpellSingleTarget).Description02.txt" />
	<image href="/Interface/Icons/Misc/Chests/KeyMithril.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualScripts href="/Items/InteractiveObjects/AstralDungeon06/Switch/HelpSwithSirenSound.(ExploitVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<isExploit>true</isExploit>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>5</value>
	</range>
	<prepareDuration>2000</prepareDuration>
	<targetType>STTCurrentTargetNotSelf</targetType>
	<iffPolicy>Everyone</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.map.variables.PredicateMapVariableEquals">
				<variableResource href="MapVariables/EarthBoss.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
				<expectedValue type="gameMechanics.elements.calcers.FloatData">
					<value>1</value>
				</expectedValue>
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
				<zone href="Traps/PoisonTrap.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
				<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
				<data href="LeverSwitch.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
				<spawn>
					<scriptID>PoisonSmoke</scriptID>
					<map href="/Maps/AstralIsle19/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
				</spawn>
				<impacts>
					<Item type="gameMechanics.elements.impacts.Disintegrate" />
				</impacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
				<device>
					<scriptID>LeverSwitch2</scriptID>
					<map href="/Maps/AstralIsle19/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
				</device>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.device.DeviceDie" />
			<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
				<delay>500</delay>
				<impacts>
					<Item type="gameMechanics.elements.impacts.Disintegrate" />
				</impacts>
			</Item>
		</targetImpacts>
	</mechanics>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
