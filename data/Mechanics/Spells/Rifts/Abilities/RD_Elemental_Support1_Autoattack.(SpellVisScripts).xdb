<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>ready</Item>
        </animations>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>attack01</Item>
                </animations>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureVisActionStartThrow" />
                    <Item type="CreatureProjectileAction">
                        <projectileFx href="/Spells/FX/Spells/SpringBossProjectile_AutoAtack.(VisObjectTemplate).xdb" />
                        <explosionFx href="/Spells/FX/Spells/HitWater01.(VisObjectTemplate).xdb" />
                        <pointOnCaster type="VisPointLocator">
                            <locator>Slot_FX</locator>
                        </pointOnCaster>
                        <pointOnTarget type="VisPointLocator">
                            <locator>Slot_BodyFX</locator>
                        </pointOnTarget>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>