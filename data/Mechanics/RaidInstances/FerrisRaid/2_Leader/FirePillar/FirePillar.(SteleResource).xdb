<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.SteleResource>
	<Header>
		<resourceId>739890303</resourceId>
	</Header>
	<persistentParts>
		<Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.map.destination.SelfPosDestination" />
								</moveType>
								<resource href="2mRedDecale.(ProjectileResource).xdb" />
							</projectileData>
						</Item>
					</impactsOn>
				</Item>
				<Item type="gameMechanics.elements.effects.EffectsDeferred">
					<delay>15000</delay>
					<effects>
						<Item type="gameMechanics.elements.effects.Switch">
							<impactsOn>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impactsOn>
						</Item>
					</effects>
				</Item>
				<Item type="gameMechanics.elements.effects.EffectsDeferred">
					<delay>2000</delay>
					<effects>
						<Item type="gameMechanics.elements.effects.ImpactsOverTime">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
									<spawn>
										<scriptID>2_ChieftainBoss</scriptID>
										<map href="/Maps/FerrisRaid/MapResource.xdb" />
									</spawn>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
											<impacts>
												<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
													<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
													<radius>2</radius>
													<impacts>
														<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
															<element>FIRE</element>
															<damage>4</damage>
															<scaler type="gameMechanics.elements.scalers.MagicScaler" />
														</Item>
													</impacts>
													<filter type="gameMechanics.world.creature.AvatarFilter" />
												</Item>
											</impacts>
										</Item>
									</impacts>
								</Item>
							</impacts>
							<tick>1000</tick>
						</Item>
					</effects>
				</Item>
				<Item type="gameMechanics.elements.effects.EffectsDeferred">
					<delay>5000</delay>
					<effects>
						<Item type="gameMechanics.elements.effects.ImpactsOverTime">
							<impacts>
								<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
									<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
									<radius>2</radius>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
											<predicates>
												<Item type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChieftainBoss/PerfectFreeze/PerfectFrozenBuff.(BuffResource).xdb" />
												</Item>
											</predicates>
											<impactsIf>
												<Item type="gameMechanics.elements.impacts.BuffDetacher">
													<buff href="/Mechanics/RaidInstances/FerrisRaid/2_Leader/ChieftainBoss/PerfectFreeze/PerfectFrozenBuff.(BuffResource).xdb" />
												</Item>
											</impactsIf>
										</Item>
									</impacts>
									<filter type="gameMechanics.world.creature.AvatarFilter" />
								</Item>
							</impacts>
							<tick>1000</tick>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</persistentParts>
	<name href="FirePillar.(SteleResource).Name.txt" />
	<visObj href="/Spells/FX/Mobs/FirePoleRed.(VisObjectTemplate).xdb" />
	<collisionObject>false</collisionObject>
	<interactiveObject>true</interactiveObject>
	<exploitingText href="FirePillar.(SteleResource).ExploitingText.txt" />
	<spell href="Spell_GrabFire.(SpellSingleTarget).xdb" />
</gameMechanics.world.device.SteleResource>
