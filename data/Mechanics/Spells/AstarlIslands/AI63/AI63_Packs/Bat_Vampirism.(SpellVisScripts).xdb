<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="CreatureAnimationAction">
        <use>USE_CURRENT_ATTACK</use>
    </launch>
    <playOnTargets>
        <specialAction type="CreatureEffectsAction">
            <visualEffects>
                <Item>
                    <effectFx href="/Spells/FX/Spells/HitLifetap.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    <locator>Slot_FX</locator>
                </Item>
            </visualEffects>
        </specialAction>
    </playOnTargets>
</SpellVisScripts>