<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739923234</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability0.(AbilityResource).Name.txt" />
	<description href="Ability0.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerExternal">
						<scalerResource href="/Mechanics/SpecialStats/ShieldsScaler.(ScalerResource).xdb" />
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Druid/StoneSkin.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/Heal/Buff01.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.SpellExtraImpacts">
					<casterImpacts>
						<Item type="gameMechanics.elements.impacts.ImpactIsolator">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
									<radius>40</radius>
									<affectPets>false</affectPets>
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff hrefvar="buff_Shield" />
										</Item>
									</impacts>
								</Item>
							</impacts>
						</Item>
					</casterImpacts>
					<destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
						<spells>
							<Item href="/Mechanics/Spells/Druid70/Spells/BarkSkin/Spell01.(SpellSingleTarget).xdb" />
						</spells>
					</destination>
				</Item>
				<Item type="gameMechanics.elements.effects.BuffExtraEffects">
					<buffs>
						<Item href="Buff01.(BuffResource).xdb" />
					</buffs>
					<effects>
						<Item type="gameMechanics.elements.effects.EffectIfOverTime">
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
									<spell href="/Mechanics/Spells/Druid70/Spells/BarkSkin/Spell01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
									<factor type="gameMechanics.elements.scalers.LinearScaler">
										<multiplier>0.93</multiplier>
									</factor>
								</Item>
							</impactsIf>
							<runImpactsOnEachTick>true</runImpactsOnEachTick>
							<tick type="gameMechanics.elements.calcers.FloatData">
								<value>1000</value>
							</tick>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
