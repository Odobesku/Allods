<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739843988</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
    </groups>
    <element>ASTRAL</element>
    <Name href="DisEmbodiment.(SpellSingleTarget).Name.txt" />
    <Description href="DisEmbodiment.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/StuckPlayer/StuckPlayer.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Mage/Sanctuary.(SpellVisScripts).xdb" />
    <prepareDuration>15000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateCreatureLevel">
                <minLevel type="gameMechanics.formulas.IntConstantValue">
                    <value>4</value>
                </minLevel>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="avatarPopulation.service.impl.matchMakingImpl.map.PredicateInstancedEventMember" />
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsIf">
                <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
                    <onMaster type="gameMechanics.world.ship.elements.PredicateHasBoundShip" />
                </predicate>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactTeleportToBoundShip" />
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactTeleportToSanctuary" />
                </impactsElse>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/GameRoot/AvatarStuckBuff.xdb" />
                        </predicate>
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="DisEmbodimentDebuff.(BuffResource).xdb" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                        <spell href="/Mechanics/Spells/Special/Hearthstone/Spell.xdb" />
                        <duration>1800000</duration>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>