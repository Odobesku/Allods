<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>259892291</resourceId>
    </Header>
    <element>FIRE</element>
    <Name href="CookAOE/SpellName.txt" />
    <visualScripts href="/Spells/VisScripts/Creatures/Draconid/Astral_Island_10/FireWall.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="CookAOE/SpellName.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>50</value>
    </range>
    <prepareDuration>1000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="CookFirewall/SwitchBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                        <projectileData>
                            <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                    <base type="gameMechanics.elements.calcers.DestinationSpellTargetPoint">
                                        <yawDelta type="constructor.basicElements.AngleDegrees" />
                                    </base>
                                    <offset>0</offset>
                                    <yaw type="constructor.basicElements.AngleDegrees" />
                                </destination>
                                <directed>false</directed>
                            </moveType>
                            <resource href="CookAOE/CookAOEProjectile.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                        </projectileData>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="CookFirewall/SwitchBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                        <projectileData>
                            <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                    <base type="gameMechanics.elements.calcers.DestinationSpellTargetPoint">
                                        <yawDelta type="constructor.basicElements.AngleDegrees">
                                            <value>90</value>
                                        </yawDelta>
                                    </base>
                                    <offset>2</offset>
                                    <yaw type="constructor.basicElements.AngleDegrees">
                                        <value>90</value>
                                    </yaw>
                                </destination>
                                <directed>false</directed>
                            </moveType>
                            <resource href="CookAOE/CookAOEProjectile.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                        </projectileData>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="CookFirewall/SwitchBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>