<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739978051</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="SupportPet.(AbilityResource).Name.txt" />
    <description href="SupportPet.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value>6</value>
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
        <Item>
            <name>dur</name>
            <value var="dur" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Necromancer/PetCommandAttack.chn.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsToPet">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
                            <impactsToTarget>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="SupportPet.(BuffResource).xdb" />
                                </Item>
                            </impactsToTarget>
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <targetImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                                <buff href="Proxy.(BuffResource).xdb" />
                            </predicate>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Mechanics/Spells/CommonBuffs/Disorient/Buff00.(BuffResource).xdb" />
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier var="dur" />
                                    </durationScaler>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="SupportPet.(BuffResource).xdb" />
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="Proxy.(BuffResource).xdb" />
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </targetImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                        <spells>
                            <Item href="/Mechanics/Spells/Druid70/Spells/Wasps/Spell01.(SpellSingleTarget).xdb" />
                        </spells>
                    </destination>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="SupportPet01.(AbilityResource).xdb" />
        <Item href="SupportPet02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>