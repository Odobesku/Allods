<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>193499</resourceId>
    </Header>
    <image href="/Interface/Icons/Equipment/Ships/LightGun.(UISingleTexture).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
            <impactsIn>
                <impactsFromCaster>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="AI38_Boss04Totem.(MobWorld).xdb" />
                                </mobs>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ImpactKill" />
                        </impactsIf>
                    </Item>
                </impactsFromCaster>
            </impactsIn>
            <minLength>1</minLength>
            <maxLength>85</maxLength>
            <reconnect>true</reconnect>
            <height>5</height>
            <width>1.5</width>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="AI38_LightLinkDamage.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
                    <impactsIn>
                        <impactsFromCaster>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                        </predicates>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="AI38_LightLinkDamage2.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impactsFromCaster>
                    </impactsIn>
                    <impactsOut>
                        <impactsFromCaster>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                        </predicates>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ImpactsFromPhantom">
                                        <phantom href="AI38_Boss04.(MobWorld).xdb" />
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                <buff href="AI38_LightLinkDamage2.(BuffResource).xdb" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impactsFromCaster>
                    </impactsOut>
                    <minLength>1</minLength>
                    <maxLength>85</maxLength>
                    <reconnect>true</reconnect>
                    <width>0.5</width>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>20000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/InstanceModifiers/Addon5/Astral_Modifiers.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>