<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visActionID>vispre</visActionID>
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Global</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectPoison.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special01</locatorName>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>625</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>vispre</stoppedActionID>
					</Item>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/NecromancerAcidBoltAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<theGe>20</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>FROM_LOCATOR_NAME</locator>
							<locatorName>Slot_Special01</locatorName>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_Global</locator>
						</pointOnTarget>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
