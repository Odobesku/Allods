<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>208784</resourceId>
    </Header>
    <Name href="RD_Elemental_Boss1_ChannelProjectiles.(BuffResource).Name.txt" />
    <Description href="RD_Elemental_Boss1_ChannelProjectiles.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/ResistanceAstral.(UISingleTexture).xdb" />
    <visScript href="RD_Elemental_Boss1_ChannelProjectiles.(BuffVisScripts).xdb" />
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                            <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                <range min="0" max="80" />
                                <withinRange>true</withinRange>
                                <minCandidatesCount>0</minCandidatesCount>
                                <targetCount>0</targetCount>
                            </selector>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                            <impacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                            <projectileData>
                                                <moveType type="gameMechanics.world.projectile.MoveTypeDestination">
                                                    <receiver>Target</receiver>
                                                    <to type="gameMechanics.elements.calcers.DestinationBehind">
                                                        <comfortRange>10</comfortRange>
                                                        <maxSteps>10</maxSteps>
                                                    </to>
                                                </moveType>
                                                <resource href="/Mechanics/Spells/Rifts/RiftRandomSpells/RD_Elemental_Boss1_Projectile1.(ProjectileResource).xdb" />
                                            </projectileData>
                                            <pool href="/Mechanics/Spells/Rifts/Abilities/RD_BossSummonPool.(SummonPool).xdb" />
                                            <isPersonalPool>true</isPersonalPool>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="RD_Elemental_Boss1_ChannelProjectiles.(ClientData).xdb" />
                </Item>
            </impacts>
            <tick>1500</tick>
            <initialDelay>2000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
                    <spell href="RD_Elemental_Boss1_Pull.(SpellArea).xdb" />
                    <duration>16000</duration>
                </Item>
                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                    <impactsResource href="RD_Elemental_Boss1_Decals.(ImpactListResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>All</affectGroup>
            <radius>4</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="RD_Elemental_Boss1_ProjectilesImmune.(BuffResource).xdb" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="RD_Elemental_Boss1_ProjectilesImmune.(BuffResource).xdb" />
                </Item>
            </impactsOut>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>