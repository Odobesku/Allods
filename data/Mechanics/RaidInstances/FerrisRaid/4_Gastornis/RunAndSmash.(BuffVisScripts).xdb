<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Champions_ReadySpell_HeavyThrowAOE.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>3</scale>
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
	<postAction type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Mobs/Gastornis_RunAndSmashEnd.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fixPoint>false</fixPoint>
				<lockScale>true</lockScale>
				<scale>1</scale>
				<locator>Slot_Global</locator>
			</Item>
		</visualEffects>
	</postAction>
</BuffVisScripts>
