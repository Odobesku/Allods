<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739967868</resourceId>
	</Header>
	<Name href="CarryongBody.(BuffResource).Name.txt" />
	<Description href="CarryongBody.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Equipment/Bag/ImpossiblyHighBurden.(UISingleTexture).xdb" />
	<visScript href="EmoteHoldIdle.(BuffVisScripts).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
			<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.3</coeff>
			</effectScaler>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectMountSpeedModifier">
			<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.3</coeff>
			</effectScaler>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
					<id href="Counter1.(QuestCountId).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactDismount" />
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
							<zone href="/Maps/ZC12_Map02/ScriptZones/WW_add_10_1_counter2.(ScriptZone).xdb" />
						</Item>
					</predicates>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="Counter1.(QuestCountId).xdb" />
							<value>-1</value>
						</Item>
					</impactsElse>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Jump</Item>
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
			<predicate type="gameMechanics.elements.predicates.PredicateIsMountAction" />
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
