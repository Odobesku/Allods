<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>220660</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Mobparts/EyeAnimal.(UISingleTexture).xdb" />
    <visScript href="Ferris_Cutscene_5.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>CutScene_Colossus_ferris_go</scriptID>
                            <map href="/Maps/Ferris4/MapResource.xdb" />
                        </locator>
                        <yaw type="constructor.basicElements.AngleDegrees">
                            <value>24</value>
                        </yaw>
                    </destination>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Ferris_Cutscene_2_ColossusAnimationID.(BuffResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactGoTo">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>CutScene_Colossus_ferris_go_1</scriptID>
                                    <map href="/Maps/Ferris4/MapResource.xdb" />
                                </locator>
                            </destination>
                        </Item>
                    </impacts>
                    <object href="/Creatures/Colossus/Colossus_CutScene.(MobWorld).xdb" />
                    <pool href="CutScenePool.(SummonPool).xdb" />
                    <isPersonalPool>true</isPersonalPool>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/World/Quests/Ferris_indoor/Ferris_3_4_2/Ferris_Portal_Sub7.(ClientData).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>6000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClientData">
                            <data href="/World/Quests/Ferris_indoor/Ferris_3_4_2/Ferris_Portal_Sub8.(ClientData).xdb" />
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Ferris_Cutscene_6ID.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>14000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>