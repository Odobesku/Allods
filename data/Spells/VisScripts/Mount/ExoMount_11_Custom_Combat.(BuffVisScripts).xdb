<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureShowHaloAction">
				<show>false</show>
				<topPriority>true</topPriority>
			</Item>
			<Item type="client.Replica.VisActionDelay">
				<time>500</time>
			</Item>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.CreatureRunVisActionResource">
						<resource href="/Mechanics/Spells/Mounts/Exo/ExoMount_11/ExoMount_11_Combat.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
					</Item>
				</elements>
				<play>Simultaneously</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>true</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
		</elements>
		<play>InSequence</play>
		<playWhile type="client.SLON.PredicateExoVisualAllowedAction">
			<checkType>ALL</checkType>
			<checkIsNotSet>false</checkIsNotSet>
		</playWhile>
		<preconditional>false</preconditional>
		<restartOnVisualChange>true</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<postAction type="client.Replica.CreatureRunVisActionResource">
		<resource href="/Mechanics/Spells/Mounts/Exo/ExoMount_CombatState_End.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	</postAction>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>