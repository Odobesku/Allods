<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739911971</resourceId>
	</Header>
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="AddBuffer_vis.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
					<calcers>
						<addressEntries>
							<Item>
								<name>caster</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
							</Item>
							<Item>
								<name>target</name>
								<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
							</Item>
						</addressEntries>
					</calcers>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="AddBuffer_vis.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</onLeave>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
