<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>196950</resourceId>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>hp</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                    <multiplier>0.04</multiplier>
                </mulCalcer>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Priest/PriestRegeneration.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.abilities.DelayedBarrier">
                    <toBarrier type="gameMechanics.elements.offendSlices.OffendSliceRange">
                        <lowerBorder type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.04</multiplier>
                        </lowerBorder>
                        <upperBorder type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.7</multiplier>
                        </upperBorder>
                    </toBarrier>
                    <barrierDelay>
                        <second>5</second>
                    </barrierDelay>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>