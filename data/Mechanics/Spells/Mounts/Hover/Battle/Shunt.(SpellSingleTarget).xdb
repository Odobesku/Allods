<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>2061</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Description href="/Mechanics/Spells/Mounts/Hover/Battle/Shunt.(SpellSingleTarget).Description.txt" />
    <Name href="/Mechanics/Spells/Mounts/Hover/Battle/Shunt.(SpellSingleTarget).Name.txt" />
    <defaultAction>-1</defaultAction>
    <element>ASTRAL</element>
    <iffPolicy>Friends</iffPolicy>
    <image href="/Interface/Icons/Mounts/SpellsMounts/AreaShuntAirMoto.(UISingleTexture).xdb#xpointer(/client.Widgets.UISingleTexture)" />
    <level>1</level>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMountFromGroupFeeded">
                <hideText>false</hideText>
            </Item>
            <Item type="gameMechanics.elements.predicates.PredicateMounted">
                <hideText>false</hideText>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <hideText>false</hideText>
                <predicate type="gameMechanics.elements.predicates.PredicateInZone">
                    <hideText>false</hideText>
                    <zone href="/Mechanics/Stronghold/PillageZone.xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <hideText>false</hideText>
                <buff href="/Mechanics/Spells/Mounts/Hover/Battle/Energize.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                <consumeStacks>5</consumeStacks>
                <anyRank>true</anyRank>
            </Item>
        </casterResources>
        <cooldown type="gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTargetSimpleCooldown">
            <duration>180000</duration>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>-0.06666</mul>
                <mulCalcer type="gameMechanics.elements.calcers.CalcerMountFromGroupMaxLevel">
                    <group href="/Mechanics/Mounts/Groups/Hovers.(MountGroupResource).xdb#xpointer(/gameMechanics.constructor.schemes.mount.MountGroupResource)" />
                </mulCalcer>
                <sum>1</sum>
            </scaler>
            <stage>Launch</stage>
        </cooldown>
    </mechanics>
    <prepareDuration>0</prepareDuration>
    <sysName></sysName>
    <targetType>STTSelf</targetType>
    <uiSpellBookPageType>SPELLBOOK_PAGE_HALO</uiSpellBookPageType>
    <visualScripts href="/Spells/VisScripts/Mount/MountAirMoto_Shunt.(SpellVisScripts).xdb#xpointer(/client.VisualConstructor.SpellVisScripts)" />
    <autoAppendToActionPanel>true</autoAppendToActionPanel>
    <ignoreGlobalCooldown>false</ignoreGlobalCooldown>
    <isExploit>false</isExploit>
    <isHiddenAction>false</isHiddenAction>
    <isWorkOnDead>false</isWorkOnDead>
    <launchWhenReady>false</launchWhenReady>
    <needInFront>true</needInFront>
    <replaceLowRanks>true</replaceLowRanks>
    <triggersGlobalCooldown>true</triggersGlobalCooldown>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>