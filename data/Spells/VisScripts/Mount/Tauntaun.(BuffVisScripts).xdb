								<offendTime />
								<offset y="-0.3" z="0.35" />
							</Item>
						</visualEffects>
						<restartOnVisCreatureChange>true</restartOnVisCreatureChange>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateVisualMountAction">
					<mountsList>
						<Item href="/Client/VisualMounts/Tauntaun/TauntaunNY.(VisualMount).xdb" />
					</mountsList>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
