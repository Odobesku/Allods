<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.rules.RuleResource>
	<Header>
		<resourceId>739869754</resourceId>
	</Header>
	<name href="ArenaOfDeath.(RuleResource).Name.txt" />
	<description href="ArenaOfDeath.(RuleResource).Description.txt" />
	<types>
		<Item>RULE_TYPE_SINGLE</Item>
	</types>
	<hideInactive>true</hideInactive>
	<timeTable href="ArenaOfDeath.(TimePeriodTable).xdb#xpointer(/timeperiod.TimePeriodTable)" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectsIf">
			<predicates>
				<Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
					<onMaster type="gameMechanics.elements.predicates.PredicateHasContentKey">
						<key href="/System/ContentKeys/Russia.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
					</onMaster>
				</Item>
				<Item type="gameMechanics.constructor.basicElements.BinaryPredicateWrapper">
					<onMaster type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.elements.predicates.PredicateHasContentKey">
							<key href="/System/ContentKeys/Horizon.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
						</predicate>
					</onMaster>
				</Item>
			</predicates>
			<effectsIf>
				<Item type="avatarPopulation.service.impl.matchMakingImpl.event.EffectInstancedEvent">
					<eventResource href="/Mechanics/InstancedEventResource/MM_Pvp_Arena/MM_Pvp_ArenaFair.(InstancedEventResource).xdb#xpointer(/avatarPopulation.service.impl.matchMakingImpl.scheme.InstancedEventResource)" />
				</Item>
			</effectsIf>
			<effectsElse>
				<Item type="avatarPopulation.service.impl.matchMakingImpl.event.EffectInstancedEvent">
					<eventResource href="/Mechanics/InstancedEventResource/MM_Pvp_Arena_Turkish/MM_Pvp_Arena_Turkish.(InstancedEventResource).xdb#xpointer(/avatarPopulation.service.impl.matchMakingImpl.scheme.InstancedEventResource)" />
				</Item>
			</effectsElse>
		</Item>
	</effects>
	<internal>true</internal>
</gameMechanics.world.rules.RuleResource>
