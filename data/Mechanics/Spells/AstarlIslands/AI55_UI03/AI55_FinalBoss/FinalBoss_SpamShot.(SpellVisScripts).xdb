<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Engineer/Electricity_Shots.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<GunGe>1</GunGe>
			<GunFXOnTarget>/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</GunFXOnTarget>
			<TurrFXOnTarget>/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</TurrFXOnTarget>
			<GunPrecastEffectOnTrunk>/Spells/FX/Spells/Engineer_BarrelShot_MainMini.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</GunPrecastEffectOnTrunk>
			<TurrLocatorNameOnTarget>Slot_FX</TurrLocatorNameOnTarget>
			<TurrFXProjectile>/Spells/FX/Spells/Engineer_ElectricityProjectile_Turr.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</TurrFXProjectile>
			<GunFXProjectile>/Spells/FX/Spells/Engineer_ElectricityProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</GunFXProjectile>
			<GunLocatorNameOnTarget>Slot_FX</GunLocatorNameOnTarget>
			<TurrGe>1</TurrGe>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
					</Item>
				</elements>
			</Item>
			<Item skiped="" />
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirectedEngineer</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>150</delay>
								<effectFx href="/Spells/FX/Spells/Engineer_BarrelShot_MainMini.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList" />
</SpellVisScripts>
