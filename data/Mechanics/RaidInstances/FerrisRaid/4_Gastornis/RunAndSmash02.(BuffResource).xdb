<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739902625</resourceId>
    </Header>
    <Name href="RunAndSmash02.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Mounts/ChargeGastorniks.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffects>
        <Item>
            <delay>200</delay>
            <effectFx href="/Spells/FX/Spells/AOEAura_Physical_Gastornis.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <lockScale>true</lockScale>
            <fadeInTime>300</fadeInTime>
            <fadeOutTime>300</fadeOutTime>
            <locator>Slot_Global</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisorient">
            <radius>100</radius>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.3</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>12</radius>
                    <affectGroup>Enemies</affectGroup>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                            <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                            <minDamage>12</minDamage>
                            <maxDamage>12</maxDamage>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </impacts>
            <tick>800</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllSpells" />
    </effects>
    <duration>10000</duration>
    <stackLimit>0</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>