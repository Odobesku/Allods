<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739931624</resourceId>
    </Header>
    <Name href="Boss01_Bombs.(SpellSingleTarget).Name.txt" />
    <visualScripts href="Boss01_Bombs.(SpellVisScripts).xdb" />
    <prepareDuration>3000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>8000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                    <range min="0" max="40" />
                    <withinRange>true</withinRange>
                    <minCandidatesCount>0</minCandidatesCount>
                    <targetCount>0</targetCount>
                </selector>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
                <impacts>
                    <Item>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                <destination type="gameMechanics.map.destination.RelativePos" />
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                        <value>1000</value>
                                    </Item>
                                </impacts>
                                <object href="DemonBoss01_Bomb.(MobWorld).xdb" />
                                <pool href="DemonBoss01_Bombs.(SummonPool).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                        <level>0.7</level>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.map.destination.DestinationModified">
                            <destination type="gameMechanics.map.destination.RelativePos" />
                            <modifiers>
                                <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                    <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                        <verticalRange min="0" max="0" />
                                        <horizontalRange min="0" max="12" />
                                    </modifier>
                                </Item>
                            </modifiers>
                        </destination>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                <value>1000</value>
                            </Item>
                        </impacts>
                        <object href="DemonBoss01_Bomb.(MobWorld).xdb" />
                        <pool href="DemonBoss01_Bombs.(SummonPool).xdb" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                                <level>0.4</level>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                                <impact type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.RelativePos" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="0" max="0" />
                                                    <horizontalRange min="0" max="12" />
                                                </modifier>
                                            </Item>
                                        </modifiers>
                                    </destination>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                            <value>1000</value>
                                        </Item>
                                    </impacts>
                                    <object href="DemonBoss01_Bomb.(MobWorld).xdb" />
                                    <pool href="DemonBoss01_Bombs.(SummonPool).xdb" />
                                </impact>
                                <count type="gameMechanics.elements.calcers.FloatData">
                                    <value>2</value>
                                </count>
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                                <impact type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.RelativePos" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="0" max="0" />
                                                    <horizontalRange min="0" max="12" />
                                                </modifier>
                                            </Item>
                                        </modifiers>
                                    </destination>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                            <value>1000</value>
                                        </Item>
                                    </impacts>
                                    <object href="DemonBoss01_Bomb.(MobWorld).xdb" />
                                    <pool href="DemonBoss01_Bombs.(SummonPool).xdb" />
                                </impact>
                                <count type="gameMechanics.elements.calcers.FloatData">
                                    <value>3</value>
                                </count>
                            </Item>
                        </impactsElse>
                    </Item>
                </impactsElse>
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/Rifts/Abilities/StopBuff.(BuffResource).xdb" />
