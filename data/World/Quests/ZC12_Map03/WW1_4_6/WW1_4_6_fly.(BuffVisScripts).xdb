<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.VisActionDelay">
				<time>500</time>
			</Item>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.CreatureMountVisAction">
						<visualMount href="/Client/VisualMounts/Gryphon/ZC12_MountGryphonArmored.(VisualMount).xdb#xpointer(/VisualMount)" />
						<restorePrevMount>false</restorePrevMount>
					</Item>
					<Item type="client.Replica.Sound2DAction">
						<actionType>Simple</actionType>
						<musicSourceMaxRadius>0</musicSourceMaxRadius>
						<sound>
							<name>Ambience/OutdoorAmbience/Zones/ZC6</name>
							<project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/FMODProject)" />
						</sound>
						<forcedSoundStop>true</forcedSoundStop>
						<onlyForMainAvatar>false</onlyForMainAvatar>
						<resetGlobalParamsOnStop>true</resetGlobalParamsOnStop>
					</Item>
				</elements>
				<play>Simultaneously</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
		</elements>
		<play>InSequence</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>