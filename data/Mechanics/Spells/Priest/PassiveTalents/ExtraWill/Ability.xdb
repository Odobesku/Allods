<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>90464322</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.Name.txt" />
    <description href="Ability.Description.txt" />
    <descVars>
        <Item>
            <name>multiplier</name>
            <value var="multiplier" />
        </Item>
        <Item>
            <name>dur2</name>
            <value var="dur2" />
        </Item>
        <Item>
            <name>value</name>
            <value var="value" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Paladin/PaladinCrusaderStrike.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Priest/Aspects/AspectOfControl/Buff01.xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
                    <mark href="/Mechanics/Spells/Marks/PriestFuriousStrikeOnHit.xdb" />
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Buff01.xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier var="multiplier" />
                            </durationScaler>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
                    <targetImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="Root_Immune.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Root.(BuffResource).xdb" />
                                    <impactsOnAttach>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Root_Immune.(BuffResource).xdb" />
                                        </Item>
                                    </impactsOnAttach>
                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier var="dur2" />
                                    </durationScaler>
                                </Item>
                            </impactsElse>
                        </Item>
                    </targetImpacts>
                    <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                        <spells>
                            <Item href="/Mechanics/Spells/Priest/HolyOrb/Spell01.xdb" />
                            <Item href="/Mechanics/Spells/Priest/ChainSmite/Spell01.xdb" />
                        </spells>
                    </destination>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <hideText>false</hideText>
                            <buff href="/Mechanics/Spells/Priest/Aspects/AspectOfControl/Buff01.xdb" />
                            <anyRank>true</anyRank>
                            <consumeStacks>0</consumeStacks>
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/Spells/Priest/Aspects/AspectOfControl/Buff01.xdb" />
                                    <anyRank>false</anyRank>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <rerunOnLoad>false</rerunOnLoad>
        </Item>
        <Item type="gameMechanics.elements.effects.SummandStat">
            <stat type="gameMechanics.elements.stat.InnateStat">
                <stat>Plain</stat>
            </stat>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                <multiplier>10</multiplier>
            </scaler>
        </Item>
    </effects>
    <majorEffect>-1</majorEffect>
    <level>1</level>
    <ranks>
        <Item href="Ability01.xdb" />
        <Item href="Ability02.xdb" />
        <Item href="Ability03.xdb" />
    </ranks>
    <disableWhileDead>false</disableWhileDead>
    <saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>