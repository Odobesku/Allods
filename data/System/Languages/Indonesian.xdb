<?xml version="1.0" encoding="UTF-8" ?>
<basement.server.lang.NameRules>
	<Header>
		<resourceId>212828160</resourceId>
	</Header>
	<name>id</name>
	<lang>id</lang>
	<country>ID</country>
	<avatarNameRules>
		<matchUser>\S+</matchUser>
		<matchMaster>\S+</matchMaster>
		<minLength>3</minLength>
		<maxLength>20</maxLength>
		<transformation>NoTransformation</transformation>
	</avatarNameRules>
	<shipNameRules>
		<matchUser>\S+</matchUser>
		<minLength>3</minLength>
		<maxLength>13</maxLength>
		<transformation>NoTransformation</transformation>
	</shipNameRules>
	<guildNameRules>
		<matchUser>\S+</matchUser>
		<minLength>3</minLength>
		<maxLength>30</maxLength>
		<transformation>NoTransformation</transformation>
	</guildNameRules>
	<deniedWords href="deniedWords_Indonesian.txt" />
</basement.server.lang.NameRules>
