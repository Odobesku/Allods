<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>199960</resourceId>
    </Header>
    <Name href="OilDebuff.(BuffResource)_Name.txt" />
    <Description href="OilDebuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/TepPlague.(UISingleTexture).xdb" />
    <visScript href="/Spells/BuffVisScripts/OilDebuff.(BuffVisScripts).xdb" />
    <nameTemplate href="OilDebuff.(BuffResource)_Name.txt.template" />
    <descTemplate href="OilDebuff.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>10</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.PureDamage">
                                    <damage>1</damage>
                                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                            <multiplier>0.15</multiplier>
                                        </mulCalcer>
                                    </scalerTarget>
                                    <offends>true</offends>
                                </Item>
                            </impacts>
                            <impactsOnNoTargets>
                                <Item type="gameMechanics.constructor.basicElements.ImpactNull" />
                            </impactsOnNoTargets>
                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                <filters>
                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                    <Item type="gameMechanics.world.creature.AliveFilter" />
                                </filters>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.PureDamage">
                    <damage>1</damage>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.1</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                    <offends>true</offends>
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>1000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateInZone">
                                    <zone href="/Maps/Inst_TepPyramid/Zones/Inst_TepPyramid/Inst_TepPyramid.(ZoneResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                            <delay>460000</delay>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                            </impacts>
                                        </Item>
                                    </impacts>
                                    <traceDown>true</traceDown>
                                    <object href="Oil.(SteleResource).xdb" />
                                    <pool href="Oil.(SummonPool).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </effects>
        </Item>
    </effects>
    <duration>10000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>