<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>DIE</mode>
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
				<channelOverrideScript />
				<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
			</Item>
		</elements>
	</wholeCasting>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements />
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
