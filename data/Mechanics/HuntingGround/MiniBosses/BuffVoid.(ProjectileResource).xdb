                            <buff href="AstralPower.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
