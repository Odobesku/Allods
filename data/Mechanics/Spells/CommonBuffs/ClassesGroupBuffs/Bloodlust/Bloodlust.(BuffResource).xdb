<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739919639</resourceId>
    </Header>
    <Name href="Bloodlust.(BuffResource).Name.txt" />
    <Description href="Bloodlust.(BuffResource).Description02.txt" />
    <image href="/Interface/Icons/CommonState/Buff_Bloodlust.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/ClassesGroupBuffs/Bloodlust.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.SummandStat">
                    <stat type="gameMechanics.elements.stat.InnateStat">
                        <stat>Lifesteal</stat>
                    </stat>
                    <value>350</value>
                    <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                            <stat type="gameMechanics.elements.stat.SpecialStat">
                                <stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
                            </stat>
                            <valueType>ShortTerm</valueType>
                        </mulCalcer>
                        <sum>1</sum>
                    </scaler>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>-0.35</coeff>
                        <calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
                                    </stat>
                                    <valueType>ShortTerm</valueType>
                                </mulCalcer>
                                <sum>1</sum>
                            </scaler>
                            <value>1</value>
                        </calcer>
                    </scaler>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/CommonBuffs02.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/CommonBuffs01.xdb" />
        <Item href="/Mechanics/Spells/Groups/CommonBuffBloodLust.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>