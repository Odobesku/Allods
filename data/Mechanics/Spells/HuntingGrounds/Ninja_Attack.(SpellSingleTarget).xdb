                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="Ninja_Invis.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
