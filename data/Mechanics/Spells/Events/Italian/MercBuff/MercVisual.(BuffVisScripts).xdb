<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionChangeVisObject">
                <newVisMob href="/Characters/HumMobs/Mercenaries/Witcher/Witcher_Italian.(VisualMob).xdb#xpointer(/VisualMob)" />
                <getDress>false</getDress>
            </Item>
            <Item type="CreatureChangeVisItemsAction">
                <items>
                    <Item>
                        <slot>SHIRT</slot>
                        <newItem href="/Items/VisualItems/Shirt/Leather_B_35ItalianShirt.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
                    </Item>
                    <Item>
                        <slot>HELM</slot>
                    </Item>
                    <Item>
                        <slot>ARMOR</slot>
                    </Item>
                    <Item>
                        <slot>PANTS</slot>
                    </Item>
                    <Item>
                        <slot>BOOTS</slot>
                    </Item>
                    <Item>
                        <slot>MANTLE</slot>
                    </Item>
                    <Item>
                        <slot>GLOVES</slot>
                    </Item>
                    <Item>
                        <slot>BRACERS</slot>
                    </Item>
                    <Item>
                        <slot>BELT</slot>
                    </Item>
                </items>
            </Item>
        </elements>
    </action>
</BuffVisScripts>