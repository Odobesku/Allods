<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="VisActionDelay">
            <time>3500</time>
        </playWhile>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_Precast.(VisObjectTemplate).xdb" />
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>250</fadeOutTime>
                        <locator>Slot_Global</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_PrecastHands.(VisObjectTemplate).xdb" />
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>500</fadeOutTime>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_PrecastHands.(VisObjectTemplate).xdb" />
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>500</fadeOutTime>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/Firebreath_Ready.(VisObjectTemplate).xdb" />
                        <scale>3</scale>
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>1000</fadeOutTime>
                        <locator>Slot_Global</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureLockRotationAction" />
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpellOmniGround</Item>
                </animations>
                <advanced>
                    <speed>1.5</speed>
                </advanced>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="VisActionDelay">
            <time>1500</time>
        </playWhile>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>500</delay>
                        <effectFx href="/Spells/FX/Mobs/CastSpell_FireBomb.(VisObjectTemplate).xdb" />
                        <scale>1.25</scale>
                        <fadeInTime>250</fadeInTime>
                        <fadeOutTime>250</fadeOutTime>
                        <locator>Slot_Global</locator>
                        <offendTime type="EffectOffendConstDelay">
                            <delay>100</delay>
                        </offendTime>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastOmniGround</Item>
                </animations>
                <advanced>
                    <speed>1.5</speed>
                </advanced>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>