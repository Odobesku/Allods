<?xml version ="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <precastType>PRECAST_DEFAULT</precastType>
    <wholeCasting type="VisActionList">
        <visActionID></visActionID>
        <elements>
            <Item type="VisActionDelay">
                <visActionID></visActionID>
                <time>100</time>
            </Item>
            <Item type="CreatureRotateToCastPointAction">
                <visActionID></visActionID>
                <immediateTurn>false</immediateTurn>
            </Item>
        </elements>
        <play>InSequence</play>
        <preconditional>false</preconditional>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </wholeCasting>
    <ownKillingParams>
        <probabilityNoOverkill>0.2</probabilityNoOverkill>
        <probabilityWithOverkill>1</probabilityWithOverkill>
    </ownKillingParams>
    <playOnTargets>
        <skipBloodFx>false</skipBloodFx>
        <skipHitAnimations>false</skipHitAnimations>
    </playOnTargets>
    <useOwnKillingParams>false</useOwnKillingParams>
</SpellVisScripts>
