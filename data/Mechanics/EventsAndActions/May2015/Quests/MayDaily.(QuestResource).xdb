<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.QuestResource>
	<Header>
		<resourceId>739918789</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="MayDaily.(QuestResource).Name.txt" />
	<goal href="MayDaily.(QuestResource).Goal.txt" />
	<startText href="MayDaily.(QuestResource).StartText02.txt" />
	<checkText href="MayDaily.(QuestResource).CheckText.txt" />
	<finishText href="MayDaily.(QuestResource).FinishText.txt" />
	<startImpacts>
		<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
			<buff hrefvar="ClassBuff" />
			<stacks type="gameMechanics.elements.calcers.FloatData">
				<value>10</value>
			</stacks>
		</Item>
	</startImpacts>
	<rewardImpacts>
		<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
			<id href="MayHorse.(QuestCountId).xdb" />
		</Item>
		<Item type="gameMechanics.elements.impacts.MassBuffDetacher">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
					<groups>
						<Item href="/Mechanics/EventsAndActions/May2015/ParadeGroup.(ActionGroup).xdb" />
					</groups>
				</Item>
			</predicates>
		</Item>
	</rewardImpacts>
	<abandonImpacts>
		<Item type="gameMechanics.elements.impacts.MassBuffDetacher">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
					<groups>
						<Item href="/Mechanics/EventsAndActions/May2015/ParadeGroup.(ActionGroup).xdb" />
					</groups>
				</Item>
			</predicates>
		</Item>
	</abandonImpacts>
	<startConditions>
		<Item type="gameMechanics.elements.predicates.PredicateFaction">
			<faction hrefvar="Faction" />
		</Item>
		<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
			<rule href="/Mechanics/EventsAndActions/May2015/MayMini.(RuleResource).xdb" />
		</Item>
	</startConditions>
	<counters>
		<Item type="gameMechanics.elements.quest.QuestCountSpecial">
			<customName href="MayDaily.(QuestResource).CustomName.txt" />
			<description href="MayDaily.(QuestResource).Description.txt" />
			<limit>10</limit>
			<id href="MayDaily.(QuestCountId).xdb" />
		</Item>
	</counters>
	<reward>
		<mandatoryItems>
			<Item>
				<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
					<item href="/Mechanics/EventsAndActions/May2015/ParadeTicket.(ItemResource).xdb" />
				</item>
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsRuleActive">
						<rule href="/Mechanics/EventsAndActions/May2015/ParadeFarm.(RuleResource).xdb" />
					</Item>
				</predicates>
				<number>1</number>
			</Item>
		</mandatoryItems>
	</reward>
	<repeatPolicy type="gameMechanics.constructor.schemes.quest.RepeatPolicyDelayed" />
	<canBeSkipped>false</canBeSkipped>
	<requiredLevel type="gameMechanics.formulas.IntConstantValue">
		<value>20</value>
	</requiredLevel>
	<level type="gameMechanics.formulas.IntConstantValue">
		<value>20</value>
	</level>
</gameMechanics.constructor.schemes.quest.QuestResource>
