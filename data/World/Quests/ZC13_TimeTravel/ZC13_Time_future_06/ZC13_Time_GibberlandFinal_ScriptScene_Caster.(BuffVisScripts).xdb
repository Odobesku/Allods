<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.SLON.IfAction">
    <condition type="client.SLON.IfCreatureVisCharacter">
      <visCharList>
        <Item href="/Creatures/Tikuani/ProphetessOld.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
      </visCharList>
      <checkIsInTheList>true</checkIsInTheList>
      <checkOnStartOnly>true</checkOnStartOnly>
    </condition>
    <elseAction type="client.SLON.IfAction">
      <condition type="client.SLON.IfCreatureVisCharacter">
        <visCharList>
          <Item href="/Creatures/Mirianna/Mirianna_CutScene.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
        </visCharList>
        <checkIsInTheList>true</checkIsInTheList>
        <checkOnStartOnly>true</checkOnStartOnly>
      </condition>
      <elseAction type="client.SLON.IfAction">
        <condition type="client.SLON.IfCreatureVisCharacter">
          <visCharList>
            <Item href="/Characters/Kania_female/KaniaFemale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            <Item href="/Characters/Elf_male/ElfMale.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
          </visCharList>
          <checkIsInTheList>true</checkIsInTheList>
          <checkOnStartOnly>true</checkOnStartOnly>
        </condition>
        <elseAction type="client.SLON.IfAction">
          <condition type="client.SLON.IfCreatureVisCharacter">
            <visCharList>
              <Item href="/Creatures/Colossus/ColossusScoutSculptor.(VisCharacterTemplate).xdb#xpointer(/client.VisualConstructor.VisCharacterTemplate)" />
            </visCharList>
            <checkIsInTheList>true</checkIsInTheList>
            <checkOnStartOnly>true</checkOnStartOnly>
          </condition>
          <onBreak>
            <breakEnabled>false</breakEnabled>
          </onBreak>
          <thenAction type="client.Replica.VisActionList">
            <elements>
              <Item type="client.Replica.CreatureAnimationAction">
                <advanced>
                  <autoHasten>
                    <mode>AUTOHASTEN_NONE</mode>
                    <timeToBeLeft>0</timeToBeLeft>
                  </autoHasten>
                  <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
                  <channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
                  <offendType>NO_OFFEND</offendType>
                  <speed>0</speed>
                  <turnToTarget>TURN_DEFAULT</turnToTarget>
                  <waitRealEvent>WAIT_DEFAULT</waitRealEvent>
                  <backgroundAfterFirstKey>false</backgroundAfterFirstKey>
                  <denyAutoHasten>false</denyAutoHasten>
                  <disableRandomFirstFrame>true</disableRandomFirstFrame>
                  <eventPlaybackEnd>false</eventPlaybackEnd>
                  <skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
                  <stopIfMoved>false</stopIfMoved>
                  <stopIfRotated>false</stopIfRotated>
                </advanced>
                <channel>CHANNEL_DEFAULT</channel>
                <channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
                <channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
                <mode>DIE</mode>
                <use>USE_ANIMATIONS</use>
                <dontFreezePrecast>false</dontFreezePrecast>
              </Item>
              <Item type="client.Replica.CreatureEffectsAction">
                <category>EFFECT_DEFAULT</category>
                <visualEffects>
                  <Item>
                    <delay>0</delay>
                    <effectAnimations>
                      <mode>DIE</mode>
                    </effectAnimations>
                    <effectFx href="/Spells/FX/Mobs/PortalBoss_ActiveImpulseBlue.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
                    <fadeInTime>0</fadeInTime>
                    <fadeOutTime>0</fadeOutTime>
                    <scale>1</scale>
                    <fixPoint>false</fixPoint>
                    <lockScale>false</lockScale>
                    <muteFxSounds>false</muteFxSounds>
                    <ignoreParentRotation>true</ignoreParentRotation>
                    <locator>Global</locator>
                    <member>Default_Member</member>
                    <offset x="0" y="0" z="0" />
                    <rotation x="0" y="0" z="0" w="0" />
                    <useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
                  </Item>
                </visualEffects>
                <dontFade>false</dontFade>
                <restartOnVisCreatureChange>false</restartOnVisCreatureChange>
                <stopOnDeath>false</stopOnDeath>
              </Item>
            </elements>
            <play>Simultaneously</play>
            <preconditional>false</preconditional>
            <restartOnVisualChange>false</restartOnVisualChange>
            <stopOnDeath>false</stopOnDeath>
            <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
          </thenAction>
        </elseAction>
        <onBreak>
          <breakEnabled>false</breakEnabled>
        </onBreak>
        <thenAction type="client.Replica.CreatureAnimationAction">
          <advanced>
            <autoHasten>
              <mode>AUTOHASTEN_NONE</mode>
              <timeToBeLeft>0</timeToBeLeft>
            </autoHasten>
            <changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
