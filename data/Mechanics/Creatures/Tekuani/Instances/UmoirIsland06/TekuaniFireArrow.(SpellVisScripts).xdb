		</Variables>
	</Header>
	<Description href="/Mechanics/Spells/Creatures/Tekuani/TekuaniLightningArrow.(SpellVisScripts).Description.txt" />
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
