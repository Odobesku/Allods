<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>220274</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="duration" />
        </Item>
        <Item>
            <name>var1</name>
            <value var="stress" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Psionic/Meditation.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <casterImpacts>
                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                            <variable href="/Mechanics/Spells/Psionic63/Abilities/StressResource/StressResource.(VariableResource).xdb" />
                            <summand var="stress" />
                            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>-1</multiplier>
                            </scaler>
                        </Item>
                    </impacts>
                </Item>
            </casterImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/Psionic63/Spells/Concentration/Spell01.(SpellSingleTarget).xdb" />
                </spells>
            </destination>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffDurationModifier">
            <buffs>
                <Item href="/Mechanics/Spells/Psionic63/Spells/Concentration/Buff01.(BuffResource).xdb" />
            </buffs>
            <summand type="gameMechanics.elements.calcers.LinearCalcer">
                <mul>1000</mul>
                <mulCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value var="duration" />
                </mulCalcer>
                <sum>0</sum>
            </summand>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>