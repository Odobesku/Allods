<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739825334</resourceId>
    </Header>
    <nameTemplate href="Boss_Gladiator_Chakram_Throw02.(BuffResource)_Name.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                    <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                    <minDamage>20</minDamage>
                    <maxDamage>20</maxDamage>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectJumpOnDetach">
            <jumps type="gameMechanics.elements.calcers.LongData">
                <value>15</value>
            </jumps>
            <buff href="Boss_Gladiator_Chakram_Throw02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.RandomAutotarget">
                <group>Enemies</group>
                <radius>12</radius>
            </autotarget>
            <onBehalfOfCaster>true</onBehalfOfCaster>
            <radius>10</radius>
            <inCasterRange>false</inCasterRange>
            <keepTrack>false</keepTrack>
            <renewingEffects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="Boss_Gladiator_Chain_Boomerang.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            <calcers>
                                <addressEntries>
                                    <Item>
                                        <name>caster</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    </Item>
                                    <Item>
                                        <name>target</name>
                                        <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                    </Item>
                                </addressEntries>
                            </calcers>
                        </Item>
                    </impactsOff>
                </Item>
            </renewingEffects>
        </Item>
    </effects>
    <duration>500</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <isForthright>true</isForthright>
</gameMechanics.constructor.schemes.buff.BuffResource>