        </Item>
        <Item type="gameMechanics.elements.effects.EffectGiveSpell">
            <spell href="LightSphereActionAOE.(SpellSingleTarget).xdb" />
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/AstralIslandSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/ActionBarChange.(ActionGroup).xdb" />
