<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.VisActionChangeVisObject">
        <newVisMob href="/Creatures/MarbleArcher/MarbleArcher_Scaled.(VisualMob).xdb#xpointer(/client.VisualConstructor.VisualMob)" />
        <getBody>true</getBody>
        <getDress>true</getDress>
      </Item>
      <Item type="client.Replica.CreatureReplaceAnimationsAction">
        <member>Default_Member</member>
        <onBottom>
          <animationsReplacements>
            <Item>
              <forAnimations>
                <Item>idle</Item>
              </forAnimations>
              <play>ready</play>
            </Item>
          </animationsReplacements>
          <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
        </onBottom>
        <onMount>
          <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
        </onMount>
        <onTop>
          <animationsReplacements>
            <Item>
              <forAnimations>
                <Item>idle</Item>
              </forAnimations>
              <play>ready</play>
            </Item>
          </animationsReplacements>
          <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
        </onTop>
        <replaceWhen>ReplaceAlways</replaceWhen>
        <restartOnVisualChange>false</restartOnVisualChange>
      </Item>
      <Item type="client.Replica.CreatureDisableSpecialIdlesAction" />
      <Item type="client.SLON.CreatureEnlargeFovAction">
        <actionTime>-1</actionTime>
        <fadeInTime>1</fadeInTime>
        <fadeOutTime>1</fadeOutTime>
        <fovCoefficient>0.35</fovCoefficient>
        <onlyIfOnMainAvatar>true</onlyIfOnMainAvatar>
      </Item>
      <Item type="client.SLON.CreatureRenameAction">
        <name href="/World/Quests/Airin/AO11EM_GreatGame01d/AO11EM_GreatGame01d_MarbleArcherForm.(BuffVisScripts).Name.txt" />
      </Item>
      <Item type="client.SLON.CreatureSetSwimHeightAction">
        <swimHeight>150</swimHeight>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>