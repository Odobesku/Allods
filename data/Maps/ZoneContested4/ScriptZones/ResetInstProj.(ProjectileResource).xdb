                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>AstralDemonWarriorFinalBoss</scriptID>
                                <map href="/Maps/ZoneContested4/mole_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <onBehalfOfTarget>true</onBehalfOfTarget>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
                            <delay>3000</delay>
                            <limit>1</limit>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                                    <device>
                                        <scriptID>QuestDemonicPortal</scriptID>
                                        <map href="/Maps/ZoneContested4/mole_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                    </device>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                                    <mob>
                                        <scriptID>AstralDemonWarriorFinalBoss</scriptID>
                                        <map href="/Maps/ZoneContested4/mole_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                    </mob>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                    <spawn>
                                        <scriptID>Terminator1OnMachine</scriptID>
                                        <map href="/Maps/ZoneContested4/mole_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                    </spawn>
                                    <onBehalfOfTarget>true</onBehalfOfTarget>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                </Item>
