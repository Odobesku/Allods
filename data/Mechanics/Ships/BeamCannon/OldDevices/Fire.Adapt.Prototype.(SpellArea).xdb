<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>243187</resourceId>
        <isPrototype>true</isPrototype>
        <Variables>
            <radius />
            <autoAimAngle>10</autoAimAngle>
            <damageType>ASTRAL</damageType>
            <multiplier>1</multiplier>
            <fireBeam>../FireBeam_ClientData.xdb#xpointer(/gameMechanics.world.device.cannon.AstralSpell)</fireBeam>
            <limit>3</limit>
            <safe>true</safe>
        </Variables>
    </Header>
    <groups>
        <Item href="/Mechanics/Ships/BeamCannon/BeamCannonSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Ships/BeamCannon/BeamCannonTargetSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="Fire.Adapt.Prototype.(SpellArea).Name.txt" />
    <Description href="Fire.Adapt.Prototype.(SpellArea).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/StalkerArrowOvercharged.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value var="radius" />
    </range>
    <prepareDuration>60000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>60000</duration>
            <group href="/Mechanics/Ships/BeamCannon/BeamCannonTargetSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.world.ship.elements.ResourceEnergy">
                <energy type="gameMechanics.elements.calcers.CalcerMul">
                    <calcers>
                        <Item type="gameMechanics.elements.calcers.CalcerExp">
                            <baseCalc type="gameMechanics.elements.calcers.CalcerMul">
                                <calcers>
                                    <Item type="gameMechanics.elements.calcers.CalcerExp">
                                        <base>1.33</base>
                                        <powCalc type="gameMechanics.elements.calcers.CalcerMin">
                                            <calcers>
                                                <Item type="gameMechanics.elements.calcers.FloatData">
                                                    <value>2</value>
                                                </Item>
                                                <Item type="gameMechanics.elements.calcers.CalcerMax">
                                                    <calcers>
                                                        <Item type="gameMechanics.elements.calcers.FloatData">
                                                            <value>0</value>
                                                        </Item>
                                                        <Item type="gameMechanics.elements.calcers.CalcerDiff">
                                                            <minuend type="gameMechanics.elements.calcers.AstralSectorTLCalcerFloat" />
                                                            <subtrahend type="gameMechanics.elements.calcers.OnItemCalcer">
                                                                <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerLevel" />
                                                                <source type="gameMechanics.elements.item.ItemPart" />
                                                            </subtrahend>
                                                        </Item>
                                                    </calcers>
                                                </Item>
                                            </calcers>
                                        </powCalc>
                                    </Item>
                                    <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                                        <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                            <name>base</name>
                                        </calcer>
                                        <source type="gameMechanics.elements.item.ItemPart" />
                                    </Item>
                                </calcers>
                            </baseCalc>
                            <powCalc type="gameMechanics.elements.calcers.FloatData">
                                <value>-1</value>
                            </powCalc>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.CalcerExp">
                                    <base>1.33</base>
                                    <powCalc type="gameMechanics.elements.calcers.CalcerMin">
                                        <calcers>
                                            <Item type="gameMechanics.elements.calcers.FloatData">
                                                <value>2</value>
                                            </Item>
                                            <Item type="gameMechanics.elements.calcers.CalcerMax">
                                                <calcers>
                                                    <Item type="gameMechanics.elements.calcers.FloatData">
                                                        <value>0</value>
                                                    </Item>
                                                    <Item type="gameMechanics.elements.calcers.CalcerDiff">
                                                        <minuend type="gameMechanics.elements.calcers.AstralSectorTLCalcerFloat" />
                                                        <subtrahend type="gameMechanics.elements.calcers.OnItemCalcer">
                                                            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerLevel" />
                                                            <source type="gameMechanics.elements.item.ItemPart" />
                                                        </subtrahend>
                                                    </Item>
                                                </calcers>
                                            </Item>
                                        </calcers>
                                    </powCalc>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                        <name>energy</name>
                                    </calcer>
                                    <source type="gameMechanics.elements.item.ItemPart" />
                                </Item>
                            </calcers>
                        </Item>
                    </calcers>
                </energy>
                <safe var="safe" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAstralMob" />
                    <Item type="gameMechanics.world.ship.elements.PredicateIsShip" />
                </predicates>
            </Item>
        </targetConditions>
        <channelingMechanics>
            <channelingBuff hrefvar="targetBuff" />
            <isForthright>true</isForthright>
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.Switch">
                <impactsOn>
                    <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                        <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceUser" />
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Ships/BeamCannon/FireUsageBuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Ships/BeamCannon/SelfTickBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsOn>
                <impactsOff>
                    <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                        <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderDeviceUser" />
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="/Mechanics/Ships/BeamCannon/FireUsageBuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.world.device.cannon.ImpactBeamCannonStop" />
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="/Mechanics/Ships/BeamCannon/SelfTickBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsOff>
            </Item>
            <Item type="gameMechanics.elements.effects.EffectsDeferredGeneric">
                <delay>0</delay>
                <effects>
                    <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
                        <impacts>
                            <Item type="gameMechanics.world.device.cannon.ImpactSendLaunchEvent">
                                <clientData hrefvar="fireBeam" />
                                <targetDestination type="gameMechanics.map.destination.DestinationModified">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                    <modifiers>
                                        <Item type="gameMechanics.map.destination.modifier.ModifierRelativePolar">
                                            <radius type="gameMechanics.elements.calcers.FloatData">
                                                <value var="radius" />
                                            </radius>
                                            <angle type="constructor.basicElements.AngleDegrees">
                                                <value var="angle" />
                                            </angle>
                                        </Item>
                                    </modifiers>
                                </targetDestination>
                            </Item>
                        </impacts>
                    </Item>
                </effects>
            </Item>
            <Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
                        <delay>0</delay>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="/Mechanics/Ships/BeamCannon/SelfTickBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.world.ship.elements.ImpactEnergyConsume">
                        <amount type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="gameMechanics.elements.calcers.CalcerExp">
                                            <base>1.33</base>
                                            <powCalc type="gameMechanics.elements.calcers.CalcerMin">
                                                <calcers>
                                                    <Item type="gameMechanics.elements.calcers.FloatData">
                                                        <value>2</value>
                                                    </Item>
                                                    <Item type="gameMechanics.elements.calcers.CalcerMax">
                                                        <calcers>
                                                            <Item type="gameMechanics.elements.calcers.FloatData">
                                                                <value>0</value>
                                                            </Item>
                                                            <Item type="gameMechanics.elements.calcers.CalcerDiff">
                                                                <minuend type="gameMechanics.elements.calcers.AstralSectorTLCalcerFloat" />
                                                                <subtrahend type="gameMechanics.elements.calcers.OnItemCalcer">
                                                                    <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerLevel" />
                                                                    <source type="gameMechanics.elements.item.ItemPart" />
                                                                </subtrahend>
                                                            </Item>
                                                        </calcers>
                                                    </Item>
                                                </calcers>
                                            </powCalc>
                                        </Item>
                                        <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                                            <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                                <name>energy</name>
                                            </calcer>
                                            <source type="gameMechanics.elements.item.ItemPart" />
                                        </Item>
                                    </calcers>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.CalcerExp">
                                    <baseCalc type="gameMechanics.elements.calcers.CalcerMul">
                                        <calcers>
                                            <Item type="gameMechanics.elements.calcers.CalcerExp">
                                                <base>1.33</base>
                                                <powCalc type="gameMechanics.elements.calcers.CalcerMin">
                                                    <calcers>
                                                        <Item type="gameMechanics.elements.calcers.FloatData">
                                                            <value>2</value>
                                                        </Item>
                                                        <Item type="gameMechanics.elements.calcers.CalcerMax">
                                                            <calcers>
                                                                <Item type="gameMechanics.elements.calcers.FloatData">
                                                                    <value>0</value>
                                                                </Item>
                                                                <Item type="gameMechanics.elements.calcers.CalcerDiff">
                                                                    <minuend type="gameMechanics.elements.calcers.AstralSectorTLCalcerFloat" />
                                                                    <subtrahend type="gameMechanics.elements.calcers.OnItemCalcer">
                                                                        <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerLevel" />
                                                                        <source type="gameMechanics.elements.item.ItemPart" />
                                                                    </subtrahend>
                                                                </Item>
                                                            </calcers>
                                                        </Item>
                                                    </calcers>
                                                </powCalc>
                                            </Item>
                                            <Item type="gameMechanics.elements.calcers.OnItemCalcer">
                                                <calcer type="gameMechanics.constructor.schemes.item.calcers.ItemCalcerByName">
                                                    <name>base</name>
                                                </calcer>
                                                <source type="gameMechanics.elements.item.ItemPart" />
                                            </Item>
                                        </calcers>
                                    </baseCalc>
                                    <powCalc type="gameMechanics.elements.calcers.CalcerSum">
                                        <summands>
                                            <Item type="gameMechanics.elements.calcers.CalcerMul">
                                                <calcers>
                                                    <Item type="gameMechanics.elements.calcers.FloatData">
                                                        <value var="multiplier" />
                                                    </Item>
                                                    <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                                        <buff href="/Mechanics/Ships/BeamCannon/SelfTickBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                    </Item>
                                                </calcers>
                                            </Item>
                                            <Item type="gameMechanics.elements.calcers.FloatData">
                                                <value>-1</value>
                                            </Item>
                                        </summands>
                                    </powCalc>
                                </Item>
                            </calcers>
                        </amount>
                        <onSuccess>
                            <Item type="gameMechanics.elements.impacts.ProbabilisticImpactGeneric">
                                <chanceCalcer type="gameMechanics.world.device.LinearMalfunctionCalcer">
                                    <value>0.5</value>
                                </chanceCalcer>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
                                        <delay>0</delay>
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ImpactChannelingStop" />
                                            <Item type="gameMechanics.world.device.ImpactSendCriticalMalfunction">
                                                <type>CMT_BeamTurnOff</type>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </onSuccess>
                        <safe var="safe" />
                        <onFail>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff href="/Mechanics/Ships/BeamCannon/SelfTickBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
                                <delay>0</delay>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactChannelingStop" />
                                    <Item type="gameMechanics.world.device.ImpactSendCriticalMalfunction">
                                        <type>CMT_BeamSafeTurnOff</type>
                                    </Item>
                                </impacts>
                            </Item>
                        </onFail>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.world.ship.elements.DeviceOnlineTrigger">
                <impactsOff>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
