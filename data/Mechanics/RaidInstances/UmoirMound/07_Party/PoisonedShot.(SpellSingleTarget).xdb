    <needLos>false</needLos>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>18000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="NairaMultishot.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="NairaJumps.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="NairaCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceAnyBuff">
                            <buffs>
                                <Item href="VoiceCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                <Item href="HeroResurrected.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </buffs>
                        </predicate>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                        <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                        <data href="/Mechanics/RaidInstances/UmoirMound/Voice/Heroes/Combat/Naira/00_Poison.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="Naira.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        </mobs>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="VoiceCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>16000</multiplier>
                                        </durationScaler>
                                    </Item>
                                </impactsIf>
                                <impactsElse>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="VoiceCooldown.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>8000</multiplier>
                                        </durationScaler>
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impacts>
                        <spawnResource href="/Maps/UmoirMound/SpawnTables/07_Party.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                    </Item>
                </impactsIf>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <impactsOnHitTarget>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="NairaDot.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsOnHitTarget>
                <scaler type="gameMechanics.elements.scalers.WeaponScaler">
                    <source>Ranged</source>
                </scaler>
