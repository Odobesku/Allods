<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.social.guild.base.GuildAbilityResource>
    <Header>
        <resourceId>739881283</resourceId>
        <isPrototype>true</isPrototype>
        <Prototype href="/Mechanics/Talents/GuildTalents/MetaUp_Discount/MetaUp_Discount.(GuildAbilityResource).xdb" />
    </Header>
    <descVars>
        <Item>
            <name>total</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                    <summands>
                        <Item type="gameMechanics.elements.calcers.GuildAbilityRankCalcer">
                            <ability href="MetaUp_Discount_High_01.(GuildAbilityResource).xdb" />
                            <mul>7</mul>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.GuildAbilityRankCalcer">
                            <ability href="MetaUp_Discount_Mid_01.(GuildAbilityResource).xdb" />
                            <mul>3</mul>
                        </Item>
                    </summands>
                </mulCalcer>
            </scaler>
        </Item>
        <Item>
            <name>value</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                            <summands>
                                <Item type="gameMechanics.elements.calcers.FloatData">
                                    <value>1</value>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="gameMechanics.elements.calcers.FloatData">
                                            <value>-1</value>
                                        </Item>
                                        <Item type="gameMechanics.elements.calcers.FloatData">
                                            <value var="multiplier" />
                                        </Item>
                                    </calcers>
                                </Item>
                            </summands>
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>FormulaPercent</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <groupName>disc</groupName>
    <groupQuality>1</groupQuality>
    <ranks>
        <Item href="MetaUp_Discount_Mid_01.(GuildAbilityResource).xdb" />
        <Item href="MetaUp_Discount_Mid_02.(GuildAbilityResource).xdb" />
    </ranks>
    <memberEffects>
        <Item>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectRateAvatarSpecific">
                    <rateResource href="MetaUpgradeDiscount.(RateResource).xdb" />
                    <rate var="multiplier" />
                </Item>
                <Item type="gameMechanics.elements.effects.EffectRateAvatarSpecific">
                    <rateResource href="Craft_Discount.(RateResource).xdb" />
                    <rate var="craftDiscount" />
                </Item>
            </effects>
            <ranks>
