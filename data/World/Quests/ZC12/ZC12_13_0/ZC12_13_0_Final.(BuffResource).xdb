<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>321196</resourceId>
    </Header>
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/Camera_CutScene.(VisObjectTemplate).xdb" />
        </Item>
    </visualEffects>
    <visScript href="ZC12_13_0_Final.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Rotate</Item>
                <Item>Jump</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                    <assistantResource href="ZC12_13_0_Assists.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                    <assistantResource href="ZC12_13_0_Assists2.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
                    <assistantResource href="ZC12_13_0_Assists3.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                    <destination type="gameMechanics.map.destination.DestinationLocator">
                        <locator>
                            <scriptID>ZC12_RI4_Exit</scriptID>
                            <map href="/Maps/ZC12_Map02/MapResource.xdb" />
                        </locator>
                    </destination>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactClientData">
                    <data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InvisibleInCutscenes.(Plane).xdb" />
                <action>DENY</action>
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Influence</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InvisibleInCutscenes.(Plane).xdb" />
                <action>DENY</action>
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Select</channel>
                <vector>Outgoing</vector>
                <direction>Incoming</direction>
                <plane href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InvisibleInCutscenes.(Plane).xdb" />
                <action>DENY</action>
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                    <resources>
                                        <Item href="ZC12_RI4_ArchitectSiege_projectile.(ProjectileResource).xdb" />
                                    </resources>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="ZC12_13_0_GasBombs.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="ZC12_13_0_Final1.(ClientData).xdb" />
                        </Item>
                    </impacts>
                    <assistantResource href="ZC12_13_0_Assists.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="ZC12_13_0_Final1.(ClientData).xdb" />
                        </Item>
                    </impacts>
                    <assistantResource href="ZC12_13_0_Assists2.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.world.avatar.assistants.ImpactsToAssistant">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactMobChat">
                            <msg href="ZC12_13_0_Final1.(TextMessage).xdb" />
                        </Item>
                    </impacts>
                    <assistantResource href="ZC12_13_0_Assists3.(AssistantResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ResetSpawnTable">
                    <table href="/Maps/ZC12_RiftInstance4/SpawnTables/ZC12_RI4_Enemies.(SpawnTable).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>8000</duration>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>