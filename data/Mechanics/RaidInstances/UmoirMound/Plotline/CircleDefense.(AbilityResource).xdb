<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739875592</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="CircleDefenders.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</onEnter>
			<onLeave>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="CircleDefenders.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="CircleDefenders.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
					<radius>16</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
							<value>10</value>
						</Item>
						<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
									<value>1</value>
								</Item>
							</impacts>
						</Item>
					</impacts>
					<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
								<mobs>
									<Item href="/Creatures/ZombieWarrior/Instances/UmoirMound/UmoirZombieWarrior.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									<Item href="/Creatures/ZombieWarrior/Instances/UmoirMound/UmoirZombieWarrior2.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
								</mobs>
							</Item>
						</predicates>
					</filter>
					<autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.ClosestAutotarget">
						<group>Enemies</group>
					</autotarget>
				</Item>
			</impacts>
			<initialDelay>1000</initialDelay>
		</Item>
		<Item type="gameMechanics.elements.effects.LifeGuard">
			<level>0.1</level>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
