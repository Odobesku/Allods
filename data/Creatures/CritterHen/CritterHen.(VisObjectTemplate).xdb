<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>0</fadeOutMS>
    <geometry href="/Creatures/CritterHen/CritterHen.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <replaceDistance>999999</replaceDistance>
    <replacement href="/Creatures/Placeholders/BeastSmall.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
    <scale>1</scale>
    <sound />
    <states>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/CritterHen/Animations/CritterHen.Attack.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound>
                <name>Creatures/CritterHen/death</name>
                <project href="/SFX/Creatures/Creatures_C.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
            </sound>
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/CritterHen/Animations/CritterHen.Death.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/CritterHen/Animations/CritterHen.Idle.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound>
                <name>Creatures/CritterHen/idle01</name>
                <project href="/SFX/Creatures/Creatures_C.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
            </sound>
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/CritterHen/Animations/CritterHen.Idle01.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound>
                <name>Creatures/CritterHen/idle02</name>
                <project href="/SFX/Creatures/Creatures_C.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
            </sound>
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/CritterHen/Animations/CritterHen.Idle02.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound>
                <name>Creatures/CritterHen/idle03</name>
                <project href="/SFX/Creatures/Creatures_C.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
            </sound>
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/CritterHen/Animations/CritterHen.Idle03.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/CritterHen/Animations/CritterHen.Ready.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/CritterHen/Animations/CritterHen.Run.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Creatures/CritterHen/Animations/CritterHen.Walk.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
            <isNecessaryAnim>false</isNecessaryAnim>
        </Item>
    </states>
    <visObjComponents>
        <Item type="AnimationFromParentComponent">
            <VisualObjectComponentID></VisualObjectComponentID>
            <animationsReplacements>
                <Item>
                    <forAnimations>
                        <Item>idle02</Item>
                    </forAnimations>
                    <play>walk</play>
                </Item>
            </animationsReplacements>
            <ifAnimationNotExistsRun>idle</ifAnimationNotExistsRun>
            <skipBlendOptimization>false</skipBlendOptimization>
            <synchronizeAnimationPosition>false</synchronizeAnimationPosition>
        </Item>
    </visObjComponents>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>true</softReplace>
