<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739919642</resourceId>
	</Header>
	<Name href="Power.(BuffResource).Name.txt" />
	<Description href="Power.(BuffResource).Description02.txt" />
	<image href="/Interface/Icons/CommonState/Buff_Cunning.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/ClassesGroupBuffs/Power.(BuffVisScripts).xdb" />
	<sysUIScriptName>Proc_PanelA01_NoStack</sysUIScriptName>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
					<group href="/Mechanics/Spells/Groups/CommonBuffs03.(ActionGroup).xdb" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsIfTarget">
			<predicates>
				<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.EffectStatModifier">
					<statSelector type="gameMechanics.elements.stat.SelectStatByValue">
						<selector>MaxStat</selector>
						<statResources>
							<Item type="gameMechanics.elements.stat.SpecialStat">
								<stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.stat.SpecialStat">
								<stat href="/Mechanics/SpecialStats/CritChance.(SpecialStatResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.stat.SpecialStat">
								<stat href="/Mechanics/SpecialStats/DoubleHitChance.(SpecialStatResource).xdb" />
							</Item>
							<Item type="gameMechanics.elements.stat.SpecialStat">
								<stat href="/Mechanics/SpecialStats/ColldownDecreaser.(SpecialStatResource).xdb" />
							</Item>
						</statResources>
					</statSelector>
					<value type="gameMechanics.constructor.basicElements.ScalerCalcer">
						<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
							<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
								<stat type="gameMechanics.elements.stat.SpecialStat">
									<stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
								</stat>
								<valueType>ShortTerm</valueType>
							</mulCalcer>
							<sum>1</sum>
						</scaler>
						<value>350</value>
					</value>
				</Item>
			</effectsIf>
			<effectsElse>
				<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
					<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
						<coeff>0.35</coeff>
						<calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
							<scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
								<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
									<stat type="gameMechanics.elements.stat.SpecialStat">
										<stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
									</stat>
									<valueType>ShortTerm</valueType>
								</mulCalcer>
								<sum>1</sum>
							</scaler>
							<value>1</value>
						</calcer>
					</scaler>
				</Item>
			</effectsElse>
		</Item>
	</effects>
	<duration>1000</duration>
	<isStackable>false</isStackable>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/Magics.xdb" />
		<Item href="/Mechanics/Spells/Groups/CommonBuffs01.xdb" />
		<Item href="/Mechanics/Spells/Groups/CommonBuffs03.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
