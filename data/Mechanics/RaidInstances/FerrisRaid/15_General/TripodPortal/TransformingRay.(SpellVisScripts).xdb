<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Mobs/TripodPortal_TransformingRay_Head.(VisObjectTemplate).xdb" />
						<fxLength>20</fxLength>
						<startPoint type="VisPointLocator">
							<shift x="0.15" y="0" z="0.2" />
							<locator>FROM_LOCATOR_NAME</locator>
							<locatorName>Stone_L</locatorName>
						</startPoint>
						<endPoint type="VisPointLocator">
							<shift y="0.1" />
							<locator>Slot_FX</locator>
							<member>Assaulter</member>
						</endPoint>
						<multyTargetMode>Umbrella</multyTargetMode>
					</Item>
					<Item type="CreatureEffectsOnTarget">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/TripodPortal_TransformingRay_Target.(VisObjectTemplate).xdb" />
								<scale>1.2</scale>
								<fadeInTime>500</fadeInTime>
								<fadeOutTime>0</fadeOutTime>
								<locator>Slot_Global</locator>
							</Item>
						</visualEffects>
					</Item>
					<Item type="CreatureAnimationAction">
						<mode>LOOP</mode>
						<animations>
							<Item>readySpellDirected</Item>
						</animations>
					</Item>
					<Item type="CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Mobs/TripodPortal_TransformingRay_Head.(VisObjectTemplate).xdb" />
						<fxLength>20</fxLength>
						<startPoint type="VisPointLocator">
							<shift x="-0.15" z="0.2" />
							<locator>FROM_LOCATOR_NAME</locator>
							<locatorName>Stone_R</locatorName>
						</startPoint>
						<alternativeStartPoint />
						<endPoint type="VisPointLocator">
							<shift y="0.1" />
							<locator>Slot_FX</locator>
							<member>Assaulter</member>
						</endPoint>
						<alternativeEndPoint />
						<offendTime />
						<multyTargetMode>Umbrella</multyTargetMode>
						<secondaryTargetParams>
							<channelingFx href="" />
							<offendTime />
						</secondaryTargetParams>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
</SpellVisScripts>
