<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739932994</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="DrillStuff.(BuffResource).Name.txt" />
    <Description href="DrillStuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Engineer/EngineerTurret.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                            <ability href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/FallingDevices01.(AbilityResource).xdb" />
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
                            <spell href="DrillChannel.(SpellSingleTarget).xdb" />
                            <factor type="gameMechanics.elements.scalers.TrivialScaler" />
                            <sum type="gameMechanics.elements.calcers.LongData">
                                <value>3500</value>
                            </sum>
                            <canStartCooldown>true</canStartCooldown>
                        </Item>
                    </impacts>
                    <elseImpacts>
                        <Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
                            <spell href="DrillChannel.(SpellSingleTarget).xdb" />
                            <factor type="gameMechanics.elements.scalers.TrivialScaler" />
                            <sum type="gameMechanics.elements.calcers.LongData">
                                <value>1500</value>
                            </sum>
                            <canStartCooldown>true</canStartCooldown>
                        </Item>
                    </elseImpacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="DrillLifetime.(BuffResource).xdb" />
                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                <coeff>1</coeff>
                <calcer type="gameMechanics.elements.calcers.CalcerSum">
                    <summands>
                        <Item type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </Item>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value>-1</value>
                        </Item>
                    </summands>
                </calcer>
            </scaler>
            <group href="/Mechanics/Spells/Groups/AssistantSpells.(ActionGroup).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <affectsPureHeal>true</affectsPureHeal>
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-1</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
            <predicate type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
            </predicate>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffDurationModifier">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Power/Power.(BuffResource).xdb" />
            </buffs>
            <multiplier type="constructor.elements.CalcerFloatExternal">
                <externalCalcer hrefvar="externalCalcerBuffTime" />
            </multiplier>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.MultiplyStat">
            <stat type="gameMechanics.elements.stat.StatFullHealth" />
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.LinearCalcer">
                    <mul>0</mul>
                    <sum var="sum" />
                </mulCalcer>
            </scaler>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="DrillStuff01.(BuffResource).xdb" />
        <Item href="DrillStuff02.(BuffResource).xdb" />
        <Item href="DrillStuff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/EngineerAttackDevices.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>