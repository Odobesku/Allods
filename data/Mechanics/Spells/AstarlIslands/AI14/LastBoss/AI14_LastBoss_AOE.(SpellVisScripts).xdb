<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="CreatureEffectsAction">
			<visualEffects>
				<Item>
					<effectFx href="/Spells/FX/Spells/ReadySpellDirect02Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<scale>5</scale>
				</Item>
				<Item>
					<effectFx href="/Spells/FX/Spells/MageTeleportAbility_Loop.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<fixPoint>true</fixPoint>
					<scale>3</scale>
				</Item>
			</visualEffects>
		</playWhile>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>specialAttack</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Mobs/Yeti_AOEFear.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<scale>3</scale>
			</Item>
			<Item>
				<effectFx href="/Spells/FX/Spells/MageTeleportAbility_End.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<fixPoint>true</fixPoint>
				<scale>3</scale>
			</Item>
		</visualEffects>
	</launch>
</SpellVisScripts>
