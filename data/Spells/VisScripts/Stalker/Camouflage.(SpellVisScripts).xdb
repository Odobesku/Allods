<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<precastType>PRECAST_LAUNCH</precastType>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>battleRoarInstant</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
				</advanced>
			</Item>
			<Item type="CreatureIndependentFxAction">
				<visObject href="/Spells/FX/Spells/StalkerCamouflageAbility.(VisObjectTemplate).xdb" />
				<isRelative>true</isRelative>
				<lifeTime>3</lifeTime>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
