<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739912769</resourceId>
    </Header>
    <Name href="ChargedAvatar_Stable.(BuffResource).Name.txt" />
    <Description href="ChargedAvatar_Stable.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/MoonSphere.(UISingleTexture).xdb" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/AOEAura_Arch_R8m.(VisObjectTemplate).xdb" />
            <locator>Slot_Global</locator>
            <offset z="-0.66" />
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                </moveType>
                                <resource href="Explosion.(ProjectileResource).xdb" />
                            </projectileData>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>7</radius>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                            <spawn>
                                                <scriptID>14_SoldierBoss</scriptID>
                                                <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                            </spawn>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.DirectDamage">
                                                            <damage>1</damage>
                                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                                            </scalerTarget>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                                    <time>1000</time>
                                    <distance>12</distance>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.DirectDamage">
                    <damage>1</damage>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.8</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Mechanics/RaidInstances/DisableEscapes.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>1</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>