<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states />
	<defaultVisAction type="DeviceVisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="/World/Quests/Ferris02/Ferris_2_1/Flag_IceBarrier_Visible.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptStart />
				<visScriptLoop type="DeviceVisActionList">
					<elements>
						<Item type="DeviceAnimationAction">
							<mode>LOOP</mode>
							<channelId>1</channelId>
							<animations>
								<Item>idle</Item>
							</animations>
						</Item>
						<Item type="Sound3DActionDevice">
							<sound>
								<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
								<name>spells/FX/World/Ferris_IceBarrier</name>
							</sound>
						</Item>
					</elements>
				</visScriptLoop>
			</Item>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="/World/Quests/Ferris02/Ferris_2_1/Flag_IceBarrier_Broken.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptStart />
				<visScriptLoop type="DeviceVisActionList">
					<play>Simultaneously</play>
					<elements>
						<Item type="DeviceVisActionChangeModel">
							<visObj href="/World/Generic/Caves/Models/ZC10_IceCave/ZC10_Ice_Barrier.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<collision href="/World/Generic/Caves/Models/ZC10_IceCave/ZC10_Ice_Barrier_AI_off.(Collision).xdb#xpointer(/Collision)" />
						</Item>
						<Item type="DeviceAnimationAction">
							<mode>LOOP</mode>
							<channelId>1</channelId>
							<animations>
								<Item>dead</Item>
							</animations>
						</Item>
						<Item type="DeviceVisEffectsAction">
							<visualEffects>
								<Item>
									<effectFx href="/Spells/FX/World/Ferris_IceBarrier_Dead_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								</Item>
							</visualEffects>
						</Item>
						<Item type="Sound3DActionDevice">
							<sound>
								<project href="/SFX/World/World.(FMODProject).xdb#xpointer(/FMODProject)" />
								<name>World/Zones/Ferris/Ferris_IceBarrier</name>
							</sound>
						</Item>
					</elements>
				</visScriptLoop>
				<visScriptEnd />
			</Item>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="/World/Quests/Ferris02/Ferris_2_1/Flag_IceBarrier_Waves.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptStart type="DeviceVisEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/World/Ferris_IceBarrier_Waves_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						</Item>
					</visualEffects>
				</visScriptStart>
				<visScriptLoop />
				<visScriptEnd />
			</Item>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="/World/Quests/Ferris02/Ferris_2_1/Flag_IceBarrier_Destruction.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptStart type="DeviceAnimationAction">
					<animations>
						<Item>special</Item>
					</animations>
				</visScriptStart>
			</Item>
		</elements>
	</defaultVisAction>
</DeviceVisScripts>
