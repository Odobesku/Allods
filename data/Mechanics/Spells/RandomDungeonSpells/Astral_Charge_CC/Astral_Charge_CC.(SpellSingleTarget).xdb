<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>213266</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/ProceduralDungeon/Groups/Astra.(ActionGroupElement).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroupElement)" />
    </groups>
    <element>ASTRAL</element>
    <Name href="Astral_Charge_CC.(SpellSingleTarget).Name.txt" />
    <visualScripts href="/Spells/VisScripts/Stalker/ShadowStep.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>50</value>
    </range>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>6000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCanMove" />
            <Item type="gameMechanics.elements.predicates.PredicateHasPath">
                <destination type="gameMechanics.elements.calcers.DestinationSpellTargetThrust">
                    <maxDist>1</maxDist>
                </destination>
                <maxLength>65</maxLength>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                        <destination type="gameMechanics.map.destination.RelativeRotatePos">
                            <base type="gameMechanics.elements.calcers.DestinationSpellTargetThrust">
                                <maxDist>1</maxDist>
                            </base>
                            <offset>0</offset>
                            <yaw type="constructor.basicElements.AngleRadians" />
                            <turn>ToTarget</turn>
                        </destination>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateIsMob" />
                        </predicates>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <minDamage>20</minDamage>
                        <maxDamage>23</maxDamage>
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>