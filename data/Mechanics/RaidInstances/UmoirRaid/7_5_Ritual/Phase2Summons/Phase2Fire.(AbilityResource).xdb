<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>225301</resourceId>
    </Header>
    <visualScript type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
                <channel>CHANNEL_KNOCKDOWN</channel>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>4</scale>
                        <locator>Slot_Hand_L</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>4</scale>
                        <locator>Slot_Hand_R</locator>
                    </Item>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/FireElementalEarthQuakeAura.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>1.1</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAbility">
            <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Ritualist.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="FireDead.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/RaidInstances/UmoirRaid/Voice/VoiceNotice.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                            <elseImpacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="/Mechanics/RaidInstances/UmoirRaid/Voice/VoiceNotice.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                    <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                        <multiplier>7</multiplier>
                                                    </durationScaler>
                                                </Item>
                                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                                    <data href="/Mechanics/RaidInstances/UmoirRaid/Voice/Ritual7.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </elseImpacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <spawnResource href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Ritual.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.5</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="RegenVisual.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
            <quality href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Ritual.(MobStatQuality).xdb#xpointer(/gameMechanics.world.mob.MobStatQuality)" />
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>