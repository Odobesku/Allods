<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.device.UsableDeviceResource>
	<Header>
		<resourceId>739967871</resourceId>
	</Header>
	<parts>
		<Item type="DeviceRotationPart" />
		<Item type="RotationAnimationPart">
			<yawBones>
				<Item>
					<bone>Base</bone>
				</Item>
			</yawBones>
			<pitchBones>
				<Item>
					<bone>Gun</bone>
				</Item>
			</pitchBones>
		</Item>
		<Item type="ProjectileHolderPart" />
		<Item type="InteractionAnimationPart">
			<interactionStartAction type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>useStandingStart</Item>
					<Item>useStandingLoop</Item>
				</animations>
			</interactionStartAction>
			<interactionEndAction type="CreatureAnimationAction">
				<animations>
					<Item>useStandingEnd</Item>
				</animations>
			</interactionEndAction>
		</Item>
		<Item type="DeathHandler">
			<useParentState>true</useParentState>
			<deathScript type="DeviceVisActionList">
				<elements>
					<Item type="DeviceColorAction">
						<colorValue>-1</colorValue>
					</Item>
					<Item type="DeviceVisActionChangeModel">
						<priority>5</priority>
					</Item>
				</elements>
			</deathScript>
		</Item>
		<Item type="UsableDeviceClientPart">
			<type>USDEV_CANNON_AVATAR_CONTROLLED</type>
		</Item>
	</parts>
	<persistentParts>
		<Item type="gameMechanics.world.device.parts.ClientRotetable">
			<yawRange type="constructor.basicElements.AngleDegrees">
				<value>90</value>
			</yawRange>
			<pitchRange type="constructor.basicElements.AngleDegrees">
				<value>50</value>
			</pitchRange>
		</Item>
		<Item type="gameMechanics.elements.bunchparts.BunchPartAttachEffects">
			<effects>
				<Item type="gameMechanics.world.ship.elements.DeviceUseTrigger">
					<deviceImpactsOnFinishUse>
						<Item type="gameMechanics.world.device.impacts.ImpactResetDeviceTurn" />
					</deviceImpactsOnFinishUse>
				</Item>
				<Item type="gameMechanics.world.device.parts.ImpactsOnUserGeneric">
					<userImpactsOnStartUse>
						<Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
							<addresseeFinder type="gameMechanics.world.device.AddresseeFinderUsingDevice" />
							<impacts>
								<Item type="gameMechanics.elements.bunchImpacts.ImpactCopyIFF" />
							</impacts>
						</Item>
					</userImpactsOnStartUse>
				</Item>
				<Item type="gameMechanics.elements.effects.AddVisibilityRule">
					<visibilityRule>
						<channel>Select</channel>
						<vector>Incoming</vector>
						<direction>Outgoing</direction>
						<plane href="/World/Quests/ZC12/WW_6_14/WW_6_14_mob.(Plane).xdb" />
					</visibilityRule>
				</Item>
				<Item type="gameMechanics.elements.effects.AddVisibilityRule">
					<visibilityRule>
						<channel>Select</channel>
						<vector>Outgoing</vector>
						<direction>Incoming</direction>
						<plane href="/World/Quests/ZC12/WW_6_14/WW_6_14_mob.(Plane).xdb" />
					</visibilityRule>
				</Item>
				<Item type="gameMechanics.elements.effects.AddVisibilityRule">
					<visibilityRule>
						<channel>Influence</channel>
						<vector>Incoming</vector>
						<direction>Outgoing</direction>
						<plane href="/World/Quests/ZC12/WW_6_14/WW_6_14_mob.(Plane).xdb" />
					</visibilityRule>
				</Item>
				<Item type="gameMechanics.elements.effects.AddVisibilityRule">
					<visibilityRule>
						<channel>Influence</channel>
						<vector>Outgoing</vector>
						<direction>Incoming</direction>
						<plane href="/World/Quests/ZC12/WW_6_14/WW_6_14_mob.(Plane).xdb" />
					</visibilityRule>
				</Item>
				<Item type="gameMechanics.elements.effects.AddPlane">
					<plane href="/World/Quests/ZC12/WW_6_14/WW_6_14_cannon.(Plane).xdb" />
				</Item>
				<Item type="gameMechanics.world.device.parts.ImpactsOnUserGeneric">
					<userImpactsOnStartUse>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/World/Quests/ZC12/WW_6_14/WW_6_14_cannon_plane.(BuffResource).xdb" />
						</Item>
					</userImpactsOnStartUse>
					<userImpactsOnFinishUse>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="/World/Quests/ZC12/WW_6_14/WW_6_14_cannon_plane.(BuffResource).xdb" />
						</Item>
					</userImpactsOnFinishUse>
				</Item>
			</effects>
		</Item>
	</persistentParts>
	<name href="WW_6_14_Device_01.(UsableDeviceResource).Name.txt" />
	<visObj href="/Ships/Components/Cannon_01/Cannon_01.(VisObjectTemplate).xdb" />
	<collision href="/Ships/Components/Cannon_01/Cannon_01.(Collision).xdb" />
	<collisionObject>true</collisionObject>
	<exploitingText href="WW_6_14_Device_01.(UsableDeviceResource).ExploitingText.txt" />
	<spell href="WW_6_14_Device.(SpellSingleTarget).xdb" />
	<viewSight>
		<isBinding>true</isBinding>
		<hasCrosshair>true</hasCrosshair>
		<position y="1.5" z="3" />
	</viewSight>
	<deviceSpells>
		<Item href="WW_6_14_Device_Spell.(SpellArea).xdb" />
	</deviceSpells>
</gameMechanics.world.device.UsableDeviceResource>
