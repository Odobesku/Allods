                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>readySpell</Item>
                </animations>
            </Item>
        </elements>
    </wholeCasting>
    <precastType>PRECAST_DEFAULT</precastType>
    <charged />
</SpellVisScripts>