<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
	<Header>
		<resourceId>739916922</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="/Characters/Hadagan_female/Instances/Ferris03/Ferris4_Q_NPC_02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInZone">
							<zone href="/Maps/Ferris4/Zones/Ferris4_03.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
							<destination type="gameMechanics.map.destination.RelativePos" />
							<assistantResource href="/World/Quests/Ferris4/Ferris_4_2_2/Ferris4_Zimina.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
							<mobResource href="/Characters/Hadagan_female/Instances/Ferris4/Ferris4_Zimina_Final_Assistant.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
					<assistantResource href="/World/Quests/Ferris4/Ferris_4_2_2/Ferris4_Zimina.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
							<zone href="/Maps/Ferris4/ScriptZones/Ferris_4_4_4.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="/Characters/Hadagan_female/Instances/Ferris03/Ferris4_Q_NPC_02.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID>Ferris4_inst_Door_03</scriptID>
						<map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb#xpointer(/mapLoader.MapResource)" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.device.DoorSwitch">
							<switchType>Open</switchType>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
					<quest href="Ferris_4_5_2.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
			<impactsOnEnter>
				<Item type="gameMechanics.world.avatar.assistants.ImpactSummonAssistant">
					<destination type="gameMechanics.map.destination.RelativePos" />
					<assistantResource href="/World/Quests/Ferris4/Ferris_4_2_2/Ferris4_Zimina.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
					<mobResource href="/Characters/Hadagan_female/Instances/Ferris4/Ferris4_Zimina_Final_Assistant.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
				</Item>
			</impactsOnEnter>
			<impactsOnLeave>
				<Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
					<assistantResource href="/World/Quests/Ferris4/Ferris_4_2_2/Ferris4_Zimina.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
				</Item>
			</impactsOnLeave>
			<timeout>900000</timeout>
			<activeZone href="/Maps/Ferris4/Zones/Ferris4_03.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
			<checkTopLevelZonesOnly>false</checkTopLevelZonesOnly>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
					<quest href="Ferris_4_5_2.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
