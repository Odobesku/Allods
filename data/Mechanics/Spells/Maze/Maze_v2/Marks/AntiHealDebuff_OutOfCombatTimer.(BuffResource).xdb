<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739973250</resourceId>
    </Header>
    <Name href="AntiHealDebuff.(BuffResource).Name.txt" />
    <Description href="AntiHealDebuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffMartyr01.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.15</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="AntiHealDebuff_OutOfCombatTimer2.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="AntiHealDebuff.(BuffResource).xdb" />
                            <impactsOnAttach>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="AntiHealDebuff_OutOfCombatTimer.(BuffResource).xdb" />
                                </Item>
                            </impactsOnAttach>
                            <stacks type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                <buff href="AntiHealDebuff_OutOfCombatTimer.(BuffResource).xdb" />
                            </stacks>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
        </Item>
    </effects>
    <duration>1</duration>
    <stackLimit>7</stackLimit>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/Wounds.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>