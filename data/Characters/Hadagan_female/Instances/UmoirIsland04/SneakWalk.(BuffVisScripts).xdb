<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="CreatureReplaceAnimationsAction">
		<onTop>
			<animationsReplacements>
				<Item>
					<play>sneak</play>
					<forAnimations>
						<Item>walk</Item>
						<Item>run</Item>
					</forAnimations>
				</Item>
				<Item>
					<play>idleSneak</play>
					<forAnimations>
						<Item>idle</Item>
						<Item>idle01</Item>
						<Item>idle02</Item>
						<Item>idle03</Item>
					</forAnimations>
				</Item>
			</animationsReplacements>
		</onTop>
		<onBottom>
			<animationsReplacements>
				<Item>
					<play>sneak</play>
					<forAnimations>
						<Item>walk</Item>
						<Item>run</Item>
					</forAnimations>
				</Item>
				<Item>
					<play>idleSneak</play>
					<forAnimations>
						<Item>idle</Item>
						<Item>idle01</Item>
						<Item>idle02</Item>
						<Item>idle03</Item>
					</forAnimations>
				</Item>
			</animationsReplacements>
		</onBottom>
	</action>
</BuffVisScripts>
