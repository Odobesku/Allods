<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>200078</resourceId>
    </Header>
    <Name href="testSpell02_01.(SpellSingleTarget).Name.txt" />
    <visualScripts href="testSpell02-1.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="testSpell02_01.(SpellSingleTarget).Name.txt" />
    <descTemplate href="testSpell02_01.(SpellSingleTarget).Description.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>4000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>5</radius>
                <affectGroup>Enemies</affectGroup>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="Creature_02_Ability_01_Buff_01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </predicate>
                            </Item>
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>ACID</element>
                                <damage>7</damage>
                                <impactsOnHitTarget>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="Boss03_Creature02_Poison.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impactsOnHitTarget>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>ACID</element>
                                <damage>3</damage>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                        </impactsElse>
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>30</speed>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>