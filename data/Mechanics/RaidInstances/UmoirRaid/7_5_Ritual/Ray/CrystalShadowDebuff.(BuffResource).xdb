<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739869421</resourceId>
    </Header>
    <Name href="CrystalShadowDebuff.(BuffResource).Name.txt" />
    <Description href="CrystalShadowDebuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffURShadowFire.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>1.5</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>65</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                    <projectileData>
                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                            <destination type="gameMechanics.map.destination.DestinationModified">
                                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                <modifiers>
                                                    <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                        <verticalRange min="1" max="1" />
                                                        <horizontalRange min="0" max="0" />
                                                    </Item>
                                                    <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                                                </modifiers>
                                            </destination>
                                        </moveType>
                                        <resource href="/Mechanics/RaidInstances/UmoirRaid/7_5_Ritual/Crystal/CrystalShadowPool.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                                    </projectileData>
                                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                                <filters>
                                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                                    <Item type="gameMechanics.world.creature.AliveFilter" />
                                </filters>
                            </filter>
                            <targetsLimit>5</targetsLimit>
                            <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.PriorityAutotarget">
                                <priorityPredicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateRemote">
                                        <range>5</range>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </priorityPredicates>
                                <autotarget type="gameMechanics.constructor.schemes.spell.multiTarget.RandomAutotarget">
                                    <group>Enemies</group>
                                </autotarget>
                            </autotarget>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>5000</tick>
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>