<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739925452</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability00.(AbilityResource).Name.txt" />
	<description href="Ability00.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var1</name>
			<value var="damage" />
			<scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
				<formula>MagicScaler</formula>
			</scaler>
		</Item>
		<Item>
			<name>cd</name>
			<value var="cd" />
		</Item>
		<Item>
			<name>dur</name>
			<value var="dur" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Psionic/Pulse.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/CC/Buff01.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.SpellsModifier">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
							<spells>
								<Item href="/Mechanics/Spells/Psionic63/Spells/Impulse/Spell01.(SpellSingleTarget).xdb" />
							</spells>
						</Item>
					</predicates>
					<modifiers>
						<Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
							<effects>
								<Item type="gameMechanics.elements.effects.BuffExtraEffects">
									<buffs>
										<Item href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
									</buffs>
									<effects>
										<Item type="gameMechanics.elements.effects.Switch">
											<impactsOff>
												<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
													<element>PHYSICAL</element>
													<damage var="damage" />
													<scaler type="gameMechanics.elements.scalers.MagicScaler" />
												</Item>
												<Item type="gameMechanics.elements.impacts.PostponedImpacts">
													<impacts>
														<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
															<time>1000</time>
															<impactsOnLand>
																<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																	<buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
																	<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
																		<multiplier var="dur" />
																	</durationScaler>
																</Item>
															</impactsOnLand>
															<destination type="gameMechanics.map.destination.SelfPosDestination" />
														</Item>
													</impacts>
												</Item>
											</impactsOff>
										</Item>
									</effects>
								</Item>
							</effects>
							<onBehalfOfHolder>true</onBehalfOfHolder>
						</Item>
					</modifiers>
				</Item>
				<Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
					<spell href="/Mechanics/Spells/Psionic63/Spells/Impulse/Spell01.(SpellSingleTarget).xdb" />
					<factor var="cd" />
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
