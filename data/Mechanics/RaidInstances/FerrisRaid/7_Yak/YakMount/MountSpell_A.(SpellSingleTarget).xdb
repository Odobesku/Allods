<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>220818</resourceId>
    </Header>
    <Name href="MountSpell_A.(SpellSingleTarget).Name.txt" />
    <isExploit>true</isExploit>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>4</value>
    </range>
    <needLos>false</needLos>
    <needInFront>false</needInFront>
    <mechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="RiderStackableDebuff.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                        <data href="Warning.(ClientData).xdb" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="MountRider_A.(BuffResource).xdb" />
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="RiderStackableDebuff.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                                <time>900</time>
                                <distance>12</distance>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactEntitiesAround">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                        <resources>
                                            <Item href="MountStele_A.(SteleResource).xdb" />
                                        </resources>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                </impactsIf>
                            </Item>
                        </impacts>
                    </Item>
                </elseImpacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>