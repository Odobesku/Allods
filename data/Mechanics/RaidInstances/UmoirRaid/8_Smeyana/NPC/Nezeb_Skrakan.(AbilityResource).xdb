<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>225875</resourceId>
    </Header>
    <visualScript type="VisActionList">
        <elements>
            <Item type="VisActionDelay">
                <time>3000</time>
            </Item>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <elements>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>emoteSpeech</Item>
                        </animations>
                    </Item>
                </elements>
            </Item>
        </elements>
    </visualScript>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="Nezeb_Raid.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>1000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>150</radius>
                                    <affectHolder>false</affectHolder>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                            <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                            <data href="/Mechanics/RaidInstances/UmoirRaid/Voice/NS1.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.5</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.ImmunityToHarmfulSpells" />
        <Item type="gameMechanics.elements.effects.EffectNoAggro" />
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>