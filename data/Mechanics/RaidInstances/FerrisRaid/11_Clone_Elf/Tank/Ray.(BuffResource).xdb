<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739906487</resourceId>
    </Header>
    <Name href="Ray.(BuffResource).Name.txt" />
    <Description href="Ray.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffURFireRay.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpin">
            <rotation type="gameMechanics.elements.calcers.AngleCalcerRelative">
                <delta type="constructor.basicElements.AngleDegrees">
                    <value>360</value>
                </delta>
            </rotation>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>1500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectRay">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>FIRE</element>
                                    <damage>50</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <length>60</length>
                    <width>2.5</width>
                    <affectGroup>Enemies</affectGroup>
                </Item>
            </effects>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
    <groups>
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>