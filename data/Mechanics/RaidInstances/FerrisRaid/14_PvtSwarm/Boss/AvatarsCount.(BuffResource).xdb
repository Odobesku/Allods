<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221774</resourceId>
    </Header>
    <image href="/Interface/Icons/Spells/Halo/AvatarForm.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateAggrolistCanSelect">
                            <selector type="gameMechanics.tools.SelectorParticular">
                                <index>0</index>
                            </selector>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </filter>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                            <selector type="gameMechanics.tools.SelectorShuffle" />
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                </predicates>
                            </filter>
                            <impacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                                                    <spawn>
                                                        <scriptID>14_SoldierBoss</scriptID>
                                                        <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                    </spawn>
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="AvatarsCount.(BuffResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                            <value>1</value>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllAggro" />
                    </impactsElse>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <stackLimit>64</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
</gameMechanics.constructor.schemes.buff.BuffResource>