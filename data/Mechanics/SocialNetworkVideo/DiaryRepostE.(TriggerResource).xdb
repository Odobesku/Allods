<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>251744</resourceId>
    </Header>
    <effects>
        <Item type="socialNetworks.effects.SocialNetworksTrigger">
            <socialNetworks>
                <Item href="/Client/Social/Facebook.(SocialNetworkDescription).xdb" />
                <Item href="/Client/Social/MyWorld.(SocialNetworkDescription).xdb" />
                <Item href="/Client/Social/Twitter.(SocialNetworkDescription).xdb" />
                <Item href="/Client/Social/VKontakte.(SocialNetworkDescription).xdb" />
