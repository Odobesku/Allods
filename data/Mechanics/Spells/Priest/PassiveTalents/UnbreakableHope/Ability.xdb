<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>90036355</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<image href="/Interface/Icons/Spells/Paladin/PaladinBlessedShield.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<nameTemplate href="Ability_Name.txt.template" />
	<descTemplate href="Ability_Desc.txt.template" />
	<effects>
		<Item type="gameMechanics.elements.effects.HealthTrigger">
			<healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
				<multiplier>0.5</multiplier>
			</healthOn>
			<healthOff type="gameMechanics.elements.calcers.FullHealthCalcer">
				<multiplier>0.5</multiplier>
			</healthOff>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectsIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceAnyBuff">
							<buffs>
								<Item href="/Mechanics/Spells/Priest/Aspects/AspectOfMight/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								<Item href="/Mechanics/Spells/Priest/Aspects/AspectOfControl/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							</buffs>
						</Item>
					</predicates>
					<effectsIf>
						<Item type="gameMechanics.elements.effects.IncomingHealModifier">
							<priority>Multiplier</priority>
							<scaler type="gameMechanics.elements.scalers.ExponentialEffectScaler">
								<base var="factor" />
							</scaler>
						</Item>
					</effectsIf>
				</Item>
			</effects>
		</Item>
	</effects>
	<majorEffect>-1</majorEffect>
	<level>1</level>
	<ranks>
		<Item href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Ability02.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
		<Item href="Ability03.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
	</ranks>
	<disableWhileDead>false</disableWhileDead>
	<saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>
