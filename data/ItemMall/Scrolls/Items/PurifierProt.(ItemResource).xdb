                                    <quality hrefvar="quality2"/>
                                </Item>
                                <Item type="gameMechanics.elements.item.ItemPredicateQuality">
                                    <quality hrefvar="quality3"/>
                                </Item>
                                <Item type="gameMechanics.elements.item.ItemPredicateQuality">
                                    <quality hrefvar="quality4"/>
                                </Item>
