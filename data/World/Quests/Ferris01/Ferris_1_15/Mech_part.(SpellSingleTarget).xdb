<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>313510</resourceId>
    </Header>
    <visualScripts href="/Spells/VisScripts/Exploits/UseStanding.(ExploitVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <isExploit>true</isExploit>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>5</value>
    </range>
    <prepareDuration>3000</prepareDuration>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Everyone</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                <quest href="Ferris_1_15.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                <status>Started</status>
            </Item>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                    <quest href="Ferris_1_15.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                    <counterResource href="Counter1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="Counter1.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.device.DeviceDie" />
        </targetImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>