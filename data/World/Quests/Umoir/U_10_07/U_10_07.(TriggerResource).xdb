<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
	<Header>
		<resourceId>739848531</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectZoneEnterLeaveChecker">
			<impactsOnLeave>
				<Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
					<assistantResource href="U_10_07_Escort.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="U_10_07_Escort.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</impactsOnLeave>
			<timeout>900000</timeout>
			<activeZone href="/Maps/IllusionWorld/Zones/ZC6_IllusionWorld_10.(ZoneResource).xdb#xpointer(/gameMechanics.map.zone.ZoneResource)" />
			<checkTopLevelZonesOnly>false</checkTopLevelZonesOnly>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
					<quest href="U_10_07.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
					<assistantResource href="U_10_07_Escort.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="U_10_07_Escort.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
							<zone href="/Maps/Umoir/ScriptZones/U_10_04.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="U_10_07_QuestGiver.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.QuestCounterTrigger">
			<quest href="/World/Quests/Umoir/U_4_04/U_4_04.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
			<counterId href="/World/Quests/Umoir/U_4_04/CountId_4.xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
			<condition type="constructor.elements.LongEquals">
				<value>1</value>
			</condition>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
							<quest href="U_10_07.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
							<status>Completed</status>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.world.avatar.assistants.ImpactDismissAssistant">
							<assistantResource href="U_10_07_Escort.(AssistantResource).xdb#xpointer(/gameMechanics.world.avatar.assistants.AssistantResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="U_10_07_Escort.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsIf>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
					<quest href="U_10_07.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
