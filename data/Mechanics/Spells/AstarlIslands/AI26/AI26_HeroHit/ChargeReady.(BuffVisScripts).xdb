<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>ready1HSpear</Item>
                </animations>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AI26_ChargeTarget.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    </Item>
                </visualEffects>
            </Item>
            <Item type="Sound3DAction">
                <sound>
                    <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
                    <name>spells/Wand/HolyWandPreCast</name>
                </sound>
            </Item>
        </elements>
    </action>
</BuffVisScripts>