<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<states>
		<Item>
			<action type="DeviceVisActionList">
				<elements>
					<Item type="DeviceVisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="DeviceAnimationAction">
								<visActionID>AAA</visActionID>
								<mode>LOOP</mode>
								<animations>
									<Item>specialIdleStart</Item>
									<Item>specialIdle</Item>
								</animations>
							</Item>
							<Item type="DeviceVisActionList">
								<elements>
									<Item type="DeviceVisActionDelay">
										<time>15000</time>
									</Item>
									<Item type="DeviceVisActionChangeModel">
										<visObj href="/World/Dungeons/FerrisRaid/Models/Carrier_Arena_Stella.(VisObjectTemplate).xdb" />
									</Item>
									<Item type="EntityVisActionStopAction">
										<stoppedActionID>AAA</stoppedActionID>
									</Item>
								</elements>
							</Item>
						</elements>
					</Item>
					<Item type="DeviceAnimationAction">
						<mode>CLAMP</mode>
						<animations>
							<Item>specialIdleEnd</Item>
						</animations>
					</Item>
				</elements>
			</action>
		</Item>
	</states>
	<defaultVisAction type="DeviceVisActionList">
		<elements>
			<Item type="DeviceVisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="DeviceAnimationAction">
						<visActionID>AAA</visActionID>
						<mode>LOOP</mode>
						<animations>
							<Item>specialIdleStart</Item>
							<Item>specialIdle</Item>
						</animations>
					</Item>
					<Item type="DeviceVisActionList">
						<elements>
							<Item type="DeviceVisActionDelay">
								<time>15000</time>
							</Item>
							<Item type="DeviceVisActionChangeModel">
								<visObj href="/World/Dungeons/FerrisRaid/Models/Carrier_Arena_Stella.(VisObjectTemplate).xdb" />
							</Item>
							<Item type="EntityVisActionStopAction">
								<stoppedActionID>AAA</stoppedActionID>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="DeviceAnimationAction">
				<mode>CLAMP</mode>
				<animations>
					<Item>specialIdleEnd</Item>
				</animations>
			</Item>
		</elements>
	</defaultVisAction>
</DeviceVisScripts>
