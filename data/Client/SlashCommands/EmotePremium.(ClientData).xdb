<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.world.ClientData>
	<Header>
		<resourceId>740021173</resourceId>
	</Header>
	<customData type="client.Replica.UIEmoteData">
		<animation type="client.Replica.CreatureVisActionData">
			<action type="client.Replica.VisActionList">
				<elements>
					<Item type="client.SLON.CreatureSetFlagAction">
						<flagName>Flag_Emote</flagName>
						<timeOut>-1</timeOut>
						<isSet>true</isSet>
						<onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
					</Item>
					<Item type="client.Replica.VisActionList">
						<elements>
							<Item type="client.Replica.VisActionList">
								<elements>
									<Item type="client.Replica.CreatureHideMountVisAction">
										<forceHideAnyMounts>false</forceHideAnyMounts>
									</Item>
								</elements>
								<play>InSequence</play>
								<playWhile type="client.Replica.VisActionList">
									<elements>
										<Item type="client.Replica.Sound3DAction">
											<alias href="/Client/CreatureSoundAliases/emoteTriumph.(AliasSound3d).xdb#xpointer(/AliasSound3d)" />
											<locator>FROM_LOCATOR_NAME</locator>
											<sound>
												<creationRadius>-1</creationRadius>
											</sound>
											<forcedSoundStop>false</forcedSoundStop>
											<onlyForMainAvatar>false</onlyForMainAvatar>
										</Item>
										<Item type="client.SLON.CreatureDisableSpecialShuffleAction" />
										<Item type="client.Replica.VisActionList">
											<elements>
												<Item type="client.Replica.CreatureChangeVisItemsAction">
													<items>
														<Item>
															<slot>MAINHAND</slot>
														</Item>
														<Item>
															<slot>CLOAK</slot>
														</Item>
														<Item>
															<slot>LIFESTYLEBACK</slot>
														</Item>
														<Item>
															<slot>OFFHAND</slot>
														</Item>
													</items>
													<isGfxCondition>false</isGfxCondition>
													<leaveWeapons>false</leaveWeapons>
													<notForDolls>false</notForDolls>
													<removeAllItems>false</removeAllItems>
												</Item>
											</elements>
											<play>Simultaneously</play>
											<playWhile type="client.SLON.PredicateCreatureVisCharacterAction">
												<visCharList>
													<Item href="/Characters/Undead_male/UndeadMale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
													<Item href="/Characters/Undead_female/UndeadFemale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
												</visCharList>
												<checkIsInTheList>true</checkIsInTheList>
												<checkOnStartOnly>true</checkOnStartOnly>
											</playWhile>
											<preconditional>true</preconditional>
											<restartOnVisualChange>false</restartOnVisualChange>
											<stopOnDeath>false</stopOnDeath>
											<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
										</Item>
									</elements>
									<play>Simultaneously</play>
									<playWhile type="client.Replica.CreatureAnimationAction">
										<advanced>
											<autoHasten>
												<mode>AUTOHASTEN_NONE</mode>
												<timeToBeLeft>0</timeToBeLeft>
											</autoHasten>
											<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
											<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
											<offendType>NO_OFFEND</offendType>
											<speed>0</speed>
											<turnToTarget>BEFORE_ANIMATIONEND</turnToTarget>
											<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
											<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
											<denyAutoHasten>false</denyAutoHasten>
											<disableRandomFirstFrame>true</disableRandomFirstFrame>
											<eventPlaybackEnd>false</eventPlaybackEnd>
											<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
											<stopIfMoved>true</stopIfMoved>
											<stopIfRotated>false</stopIfRotated>
										</advanced>
										<animations>
											<Item>emotePremium</Item>
										</animations>
										<channel>CHANNEL_EMOTE</channel>
										<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
										<channelOverrideMode>OVERRIDE_STOP</channelOverrideMode>
										<mode>LOOP</mode>
										<use>USE_ANIMATIONS</use>
										<dontFreezePrecast>false</dontFreezePrecast>
									</playWhile>
									<preconditional>false</preconditional>
									<restartOnVisualChange>false</restartOnVisualChange>
									<stopOnDeath>false</stopOnDeath>
									<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
								</playWhile>
								<preconditional>true</preconditional>
								<restartOnVisualChange>false</restartOnVisualChange>
								<stopOnDeath>false</stopOnDeath>
								<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
							</Item>
						</elements>
						<play>InSequence</play>
						<playWhile type="client.SLON.PredicateCreatureFlagAction">
							<flagName>Flag_MountNeeded</flagName>
							<checkIsSet>false</checkIsSet>
							<checkOnMainAvatar>false</checkOnMainAvatar>
						</playWhile>
						<preconditional>false</preconditional>
						<restartOnVisualChange>false</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
					</Item>
					<Item type="client.SLON.CreatureSetFlagAction">
						<flagName>Flag_Emote</flagName>
						<timeOut>0.5</timeOut>
						<isSet>true</isSet>
						<onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
					</Item>
				</elements>
				<play>InSequence</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</action>
			<channel>CHANNEL_EMOTE</channel>
		</animation>
		<image href="/Interface/Icons/Special/Emotions/Throne.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
		<textNoTarget href="EmotePremium.(ClientData).TextTarget.txt" />
