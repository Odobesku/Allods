<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Projectile.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXProjectile>/Spells/FX/Spells/MageIceArrowAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectile>
			<CastAnimation>spellCastDirected</CastAnimation>
			<FXOnCaster>/Spells/FX/Spells/ReadySpellDirectIceWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<LocatorNameOnCaster />
			<FXProjectileHit>/Spells/FX/Spells/HitIce.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXProjectileHit>
			<PreCastFX />
			<FXWand />
			<LocatorOnCaster>Slot_Hand_L</LocatorOnCaster>
		</Variables>
	</Header>
	<wholeCasting type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectIceWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<locator var="LocatorOnCaster" />
							</Item>
							<Item skiped="" />
						</visualEffects>
					</Item>
					<Item skiped="" />
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
