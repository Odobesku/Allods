<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>201065</resourceId>
    </Header>
    <Name href="Spell01.(SpellArea)_Name.txt" />
    <Description href="Spell01.(SpellArea)_Desc.txt" />
    <visualScripts href="EP_MeteorFireball.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="SpellName.txt" />
    <descTemplate href="SpellDesc.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>60</value>
    </range>
    <element>FIRE</element>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics type="gameMechanics.constructor.schemes.spell.SpellMechanics">
        <cooldown>
            <duration>2000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                <level>0.5</level>
            </Item>
        </casterConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
                        <time>1300</time>
                        <destination type="gameMechanics.map.destination.DestinationModified">
                            <destination type="gameMechanics.map.destination.RelativePos" />
                            <modifiers>
                                <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                    <radius type="gameMechanics.elements.calcers.FloatData">
                                        <value>5</value>
                                    </radius>
                                </Item>
                            </modifiers>
                        </destination>
                    </Item>
                </impactsIf>
            </Item>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>FIRE</element>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                <damage>47</damage>
            </Item>
        </targetImpacts>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
    </mechanics>
    <speed>10</speed>
    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
    <radius>6</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>