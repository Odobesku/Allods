<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739933370</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceHealTrigger.xdb" />
    </groups>
    <element>SHADOW</element>
    <Name href="Spell0_Name.txt" />
    <Description href="Spell0_Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="heal" />
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>1.5</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.HealthInferiorityCalcer" />
                        <sum>1</sum>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>HealScaler</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Necromancer/CriticalCure.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Necromancer/CriticalCure.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <ability href="/Mechanics/Spells/Necromancer70/Abilities/BloodDrops/Ability0.(AbilityResource).xdb" />
                <variable href="/Mechanics/Spells/Necromancer70/Abilities/BloodDrops/BloodPool.(VariableResource).xdb" />
                <sub var="sub" />
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactHeal">
                        <heal var="heal" />
                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mul>1.5</mul>
                            <mulCalcer type="gameMechanics.elements.calcers.HealthInferiorityCalcer" />
                            <sum>1</sum>
                        </scalerTarget>
                        <scalerCaster type="gameMechanics.elements.scalers.HealScaler" />
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>