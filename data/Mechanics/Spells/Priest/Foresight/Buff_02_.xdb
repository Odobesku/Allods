		</Item>
	</visualEffects>
	<nameTemplate href="Buff_02__Name.txt.template" />
	<descTemplate href="Buff_02__Desc.txt.template" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDamageTrigger">
			<damageType>Damage</damageType>
			<predicates>
				<Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
			</predicates>
			<impacts>
				<casterToTarget>
					<Item type="gameMechanics.elements.impacts.PostponedImpacts">
						<impacts>
							<Item type="gameMechanics.elements.impacts.StackBuff">
								<buff hrefvar="buff" />
