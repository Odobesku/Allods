		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFailQuest">
					<quest href="Ferris_3_2_5.xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
