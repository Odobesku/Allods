<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739948871</resourceId>
    </Header>
    <Name href="/Mechanics/Spells/AstarlIslands/AI71/RollingBarrels/BarrelMob.(MobWorld).Name.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/MountBarrelDusty.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectMoveTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.elements.predicates.PredicateBuffDurationGreater">
                        <buff href="BarrelMoving.(BuffResource).xdb" />
                        <duration>1000</duration>
                    </predicate>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactIncrementBuffDuration">
                            <buff href="BarrelMoving.(BuffResource).xdb" />
                            <delta type="gameMechanics.elements.calcers.FloatData">
                                <value>500</value>
                            </delta>
                        </Item>
                    </impactsElse>
                </Item>
            </impacts>
            <moveTypes>
                <Item>Step</Item>
            </moveTypes>
            <distDelta>0</distDelta>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                        <resource href="BarrelExplosion.(ProjectileResource).xdb" />
                    </projectileData>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>250</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>2000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>