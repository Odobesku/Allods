<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>213092</resourceId>
    </Header>
    <Name href="BurningFoots.(BuffResource).Name.txt" />
    <Description href="BurningFoots.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/ElementalDoT.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/BurningFootsFX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <scale>2</scale>
            <fadeInTime>500</fadeInTime>
            <fadeOutTime>500</fadeOutTime>
        </Item>
    </visualEffects>
    <nameTemplate href="BurningFoots.(BuffResource).Name.txt" />
    <descTemplate href="BurningFoots.(BuffResource).Description.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <tickLength>1000</tickLength>
                <damagePerTick>15</damagePerTick>
                <modifier type="gameMechanics.elements.effects.TickerModifierWalk">
                    <multiplier>-0.9</multiplier>
                </modifier>
            </parameters>
            <element>ASTRAL</element>
            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsConditional">
                    <conditions>
                        <Item type="gameMechanics.elements.conditions.PredicatesCondition">
                            <casterPredicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </casterPredicates>
                        </Item>
                    </conditions>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactSummonGeneric">
                            <destination type="gameMechanics.elements.calcers.DestinationBehind">
                                <comfortRange>1</comfortRange>
                                <maxSteps>1</maxSteps>
                            </destination>
                            <pool href="StelleSummon.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                            <object href="ShieldStelle.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <duration>5000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>