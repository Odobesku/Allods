<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739924979</resourceId>
    </Header>
    <Name href="Detector_spell.(SpellSingleTarget).Name.txt" />
    <Description href="Detector_spell.(SpellSingleTarget).Description.txt" />
    <visualScripts href="/Spells/VisScripts/Items/Gadget.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>25</value>
    </range>
    <prepareDuration>2500</prepareDuration>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
                    <quest href="WW_start_7.xdb" />
                    <counterResource href="/Items/QuestItems/ZC12/Metal_WW_start_7/Metal_WW_start_7.(ItemResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                <mobs>
                    <Item href="/Characters/Undead_male/Instances/ZC12/WW_start_7_Cultist.(MobWorld).xdb" />
                </mobs>
            </Item>
        </targetConditions>
        <conditions>
            <Item type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                    <buff href="Checked.(BuffResource).xdb" />
                </predicate>
            </Item>
        </conditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
                            <Item href="/Characters/Undead_male/Instances/ZC12/WW_start_7_Cultist.(MobWorld).xdb" />
                        </mobs>
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                            <value>0.8</value>
                        </chanceCalcer>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactMobMorph">
                                <newMobWorld href="/Characters/Undead_male/Instances/ZC12/WW_start_7_Cultist_loot.(MobWorld).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                <data href="Metal_detected.(ClientData).xdb" />
                            </Item>
                        </impacts>
                        <impactsLose>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                <data href="Wrong_mob.(ClientData).xdb" />
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="Checked.(BuffResource).xdb" />
                            </Item>
                        </impactsLose>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                        <data href="Wrong_mob.(ClientData).xdb" />
                    </Item>
                </impactsElse>
            </Item>
            <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                    <value>0.7</value>
                </chanceCalcer>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ForceAggro" />
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>