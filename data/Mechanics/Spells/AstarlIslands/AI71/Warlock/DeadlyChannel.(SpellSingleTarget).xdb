<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739935310</resourceId>
    </Header>
    <Name href="DeadlyChannel.(SpellSingleTarget).Name.txt" />
    <visualScripts href="DeadlyChannel.(SpellVisScripts).xdb" />
    <prepareDuration>8000</prepareDuration>
    <needLos>false</needLos>
    <isAggro>false</isAggro>
    <replaceLowRanks>false</replaceLowRanks>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <channelingMechanics>
            <channelingBuff href="DeadlyChannelBuff.(BuffResource).xdb" />
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.EffectDisableAbility">
                <ability href="/Mechanics/Abilities/Creatures/CCImmunities/Ability.xdb" />
            </Item>
            <Item type="gameMechanics.elements.effects.BuffInterceptor">
                <impactsOnAttach>
                    <Item type="gameMechanics.elements.impacts.ImpactChannelingStop" />
                    <Item type="gameMechanics.elements.impacts.ImpactResetActiveAction" />
                </impactsOnAttach>
                <forceAttachBuff>false</forceAttachBuff>
                <predicates>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                        <groups>
                            <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                            <Item href="/Mechanics/Spells/Groups/Knockdowns.xdb" />
                            <Item href="/Mechanics/Spells/Groups/Fears.xdb" />
                            <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                            <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
                            <Item href="/Mechanics/Spells/Groups/Blinds.xdb" />
                            <Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
                            <Item href="/Mechanics/Spells/Groups/Silence.xdb" />
                            <Item href="/Mechanics/Spells/Groups/Disarms.xdb" />
                            <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
                            <Item href="/Mechanics/Spells/Groups/CommonDebuffs.(ActionGroup).xdb" />
                        </groups>
                    </Item>
                </predicates>
            </Item>
        </casterChannelingEffects>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>