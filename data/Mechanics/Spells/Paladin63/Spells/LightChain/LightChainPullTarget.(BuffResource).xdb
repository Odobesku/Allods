<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>206815</resourceId>
    </Header>
    <Name href="LightChain.(BuffResource).Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectPull">
            <puller type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <speedFactor type="gameMechanics.elements.calcers.FloatData">
                <value>8</value>
            </speedFactor>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LightChainPullTarget.(BuffResource).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>HOLY</element>
                            <damage>36</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EventTrigger">
            <eventClasses>
                <Item>gameMechanics.elements.events.EventDeath</Item>
            </eventClasses>
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="LightChainPullTarget.(BuffResource).xdb" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                </Item>
            </impacts>
            <eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
        </Item>
    </effects>
    <duration>1000</duration>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>