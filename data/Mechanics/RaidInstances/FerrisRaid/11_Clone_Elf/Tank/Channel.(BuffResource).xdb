<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739903684</resourceId>
	</Header>
	<Name href="Channel.(BuffResource).Name.txt" />
	<Description href="Channel.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Buffs/BuffURFireRay.(UISingleTexture).xdb" />
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Spells/OpFirework_TargetSkull.(VisObjectTemplate).xdb" />
			<scale>1.2</scale>
			<locator>Slot_TopFX</locator>
		</Item>
	</visualEffects>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
					<element>FIRE</element>
					<damage>25</damage>
					<scaler type="gameMechanics.elements.scalers.MagicScaler" />
				</Item>
			</impacts>
			<tick>1000</tick>
			<initialDelay>1000</initialDelay>
		</Item>
		<Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
			<impactsIn>
				<impactsFromCaster>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
									</Item>
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								</predicates>
							</Item>
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="Channel_Damage.(BuffResource).xdb" />
								</predicate>
							</Item>
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="Channel.(BuffResource).xdb" />
								</predicate>
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff href="Channel_Damage.(BuffResource).xdb" />
							</Item>
						</impactsIf>
					</Item>
				</impactsFromCaster>
			</impactsIn>
			<impactsOut>
				<impactsFromCaster>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="Channel_Damage.(BuffResource).xdb" />
									</Item>
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								</predicates>
							</Item>
							<Item type="gameMechanics.constructor.basicElements.PredicateNot">
								<predicate type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="Channel.(BuffResource).xdb" />
								</predicate>
							</Item>
						</predicates>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.BuffDetacher">
								<buff href="Channel_Damage.(BuffResource).xdb" />
							</Item>
						</impactsIf>
					</Item>
				</impactsFromCaster>
			</impactsOut>
			<minLength>1</minLength>
			<maxLength>85</maxLength>
			<reconnect>true</reconnect>
			<width>0.5</width>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
							<spell href="Channel.(SpellSingleTarget).xdb" />
							<duration>30000</duration>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<isStackable>false</isStackable>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
	<isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>
