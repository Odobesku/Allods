<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>226145</resourceId>
    </Header>
    <Name href="Link.(BuffResource).Name.txt" />
    <Description href="Link.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffURConnectionLine.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
            <impactsIn type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine$ImpactsPack">
                <impactsFromCaster>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>HOLY</element>
                        <damage>27</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="InsideLink.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsFromCaster>
            </impactsIn>
            <impactsOut type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine$ImpactsPack">
                <impactsFromCaster>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="InsideLink.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsFromCaster>
            </impactsOut>
            <holderImpactsOnBreak>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="BrokenLink.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Visual.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </holderImpactsOnBreak>
            <holderImpactsOnReconnect>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="BrokenLink.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Visual.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </holderImpactsOnReconnect>
            <maxLength>45</maxLength>
            <reconnect>true</reconnect>
            <height>10</height>
            <width>3</width>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>Friends</affectGroup>
            <radius>40</radius>
            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                        <mobs>
