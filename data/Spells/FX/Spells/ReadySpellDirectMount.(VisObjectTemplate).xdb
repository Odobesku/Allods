<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound/>
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>100</fadeInMS>
    <fadeOutMS>200</fadeOutMS>
    <particle href="/Spells/FX/Spells/ReadySpellDirectMount.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)"/>
    <scale>1</scale>
    <sound>
        <name>spells/Wand/HolyWandPreCast</name>
        <project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)"/>
    </sound>
    <drawBehindCamera>false</drawBehindCamera>
    <softReplace>false</softReplace>
</VisObjectTemplate>
