<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>207927</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Damage.(BuffResource).Name.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestPurify.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.MagicDoT">
                <parameters>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </scalerTarget>
                    <scaleOnTick>true</scaleOnTick>
                    <tickLength>1000</tickLength>
                    <damagePerTick>1</damagePerTick>
                    <impactsPerTick>
                        <Item type="gameMechanics.elements.impacts.MarkedImpact">
                            <mark href="/Mechanics/Spells/Mage63/Abilities/LightningBallsAstralAoE/Mark.(MarkResource).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="/Mechanics/Spells/Mage63/Abilities/LightningBallsAstralAoE/AoEMark.(MarkResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsPerTick>
                    <affectedByDoubleAttack>true</affectedByDoubleAttack>
                </parameters>
                <element>LIGHTNING</element>
                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
            </effect>
            <ticksCount>4</ticksCount>
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Damage01.(BuffResource).xdb" />
        <Item href="Damage02.(BuffResource).xdb" />
        <Item href="Damage03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>false</isClientReplicated>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/LightningSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>