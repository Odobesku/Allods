<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureColorAction">
				<colorFactor x="1" y="1" z="1" w="2" />
				<colorValue>-933785946</colorValue>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/EyeBlue.(VisObjectTemplate).xdb" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Eye_R</locatorName>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/EyeBlue.(VisObjectTemplate).xdb" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Eye_L</locatorName>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/GhostSmokeCommon.(VisObjectTemplate).xdb" />
						<scale>1.7</scale>
						<locator>Slot_FX</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/GhostSmokeCommon.(VisObjectTemplate).xdb" />
						<scale>1.3</scale>
						<locator>Slot_Head</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureSetTransparencyAction">
				<transparency>0.7</transparency>
			</Item>
			<Item type="VisActionChangeVisObject">
				<newVisMob href="/Creatures/Eagle/Eagle.(VisualMob).xdb" />
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>8000</time>
					</Item>
					<Item type="CreatureCutSceneAction" />
					<Item type="CreatureMusicParamAction">
						<parameter href="Priden_Fly_Music.(SoundParameter).xdb" />
						<creatureParameter type="CutSceneParameter" />
					</Item>
					<Item type="Sound2DAction">
						<sound>
							<project href="/SFX/Music/Music.(FMODProject).xdb" />
							<name>Music/ZonesMusic/Priden_Fly</name>
						</sound>
						<actionType>Music</actionType>
						<resetGlobalParamsOnStop>false</resetGlobalParamsOnStop>
						<onlyForMainAvatar>true</onlyForMainAvatar>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
	<postAction type="Sound2DAction">
		<actionType>Music</actionType>
	</postAction>
</BuffVisScripts>
