<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>186524</resourceId>
    </Header>
    <Name href="DemonDead.(BuffResource).Name.txt" />
    <Description href="DemonDead.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Modifiers/AstralRage.(UISingleTexture).xdb" />
    <visScript href="Enrage.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.25</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.25</factor>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="AcidBoltRes.(BuffResource).xdb" />
                    <scalerTarget type="gameMechanics.elements.scalers.RandomScaler">
                        <range>
                            <min>3</min>
                            <max>5</max>
                        </range>
                    </scalerTarget>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/Characters/Hadagan_male/AstralDungeon04/AD04.(SummonPool).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Characters/Hadagan_male/Instances/AstralDungeon04/Boss02/CreepingDemon.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="DisableMovement.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>