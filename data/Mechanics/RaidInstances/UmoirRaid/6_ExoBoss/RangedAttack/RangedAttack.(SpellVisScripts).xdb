<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>600</time>
					</Item>
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Mobs/ExoShiftBoss_PulseProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnTarget>
						<offendTime type="EffectOffendType" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
