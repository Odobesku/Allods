<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
    <Header>
        <resourceId>129308</resourceId>
    </Header>
    <name href="BuyRelic.(Cue).Name.txt" />
    <impacts>
        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <hideText>false</hideText>
                    <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                        <unlock href="/Mechanics/Unlocks/SecondaryDressUnlock.xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                    </predicate>
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.elements.impacts.ImpactGrantUnlock">
                    <unlock href="/Mechanics/Unlocks/SecondaryDressUnlock.xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                </Item>
            </impactsIf>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactShowVendorTable">
            <vendorTable href="BuyRelic.(VendorTable).xdb" />
        </Item>
    </impacts>
</gameMechanics.world.mob.interaction.Cue>