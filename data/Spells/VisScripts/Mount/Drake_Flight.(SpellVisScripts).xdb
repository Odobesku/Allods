<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2000</time>
		</playWhile>
		<elements>
			<Item type="CreatureSetFlagAction">
				<flagName>Flag_MountNeeded</flagName>
				<timeOut>0.5</timeOut>
			</Item>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Flag_Emote</flagName>
				</playWhile>
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/MountDrake_FlightTrail_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>1</scale>
								<locator>FROM_LOCATOR_NAME</locator>
								<member>Mount</member>
								<locatorName>HandWing_R</locatorName>
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/MountDrake_FlightTrail_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<locator>FROM_LOCATOR_NAME</locator>
								<member>Mount</member>
								<locatorName>HandWing_L</locatorName>
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
