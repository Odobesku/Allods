<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>197025</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="TankDPS.(AbilityResource).Name.txt" />
    <description href="TankDPS.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value var="dmg" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Equipment/Dagger/DaggerShiv.(UISingleTexture).xdb" />
    <effects>
        <!-- <Item type="gameMechanics.elements.effects.BuffExtraEffects"> -->
        <!-- <buffs> -->
        <!-- <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff03.(BuffResource).xdb" /> -->
        <!-- </buffs> -->
        <!-- <effects> -->
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff var="dmg" />
            </scaler>
            <group href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                    <group href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <!-- <Item type="gameMechanics.elements.effects.ThreatMultiplier"> -->
                        <!-- <factor type="gameMechanics.elements.calcers.FloatData"> -->
                        <!-- <value var="agr" /> -->
                        <!-- </factor> -->
                        <!-- </Item> -->
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
        <!-- </effects> -->
        <!-- </Item> -->
    </effects>
    <ranks>
        <Item href="TankDPS01.(AbilityResource).xdb" />
        <Item href="TankDPS02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>