<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>222172</resourceId>
    </Header>
    <Name href="ChainSpell.(SpellSingleTarget).Name.txt" />
    <visualScripts href="ChainSpell.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>50</value>
    </range>
    <prepareDuration>1000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </predicate>
                    </Item>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                <ability href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuards_HM_Abilities2.(AbilityResource).xdb" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/ChainsCount.(BuffResource).xdb" />
                        <stacks type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                            <buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/ChainsCount.(BuffResource).xdb" />
                        </stacks>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="ChainBuff_HM.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/RaidInstances/FerrisRaid/9_RoboGuards/RoboGuard1/ChainsCount.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="ChainBuff.(BuffResource).xdb" />
                    </Item>
                </elseImpacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>