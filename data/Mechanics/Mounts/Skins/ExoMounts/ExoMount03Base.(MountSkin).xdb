<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.mount.MountSkin>
    <Header>
        <resourceId>900000005</resourceId>
    </Header>
    <Name href="ExoMount03Base.(MountSkin).Name.txt" />
    <Description href="ExoMount03Base.(MountSkin).Description.txt" />
    <SourceDescription href="ExoMount03Base.(MountSkin).SourceDescription.txt" />
    <image href="/Interface/Icons/Mounts/MountExoskeletV3.(UISingleTexture).xdb" />
    <visualMount href="/Client/VisualMounts/Exoskeleton/Exoskeleton03Base.(VisualMount).xdb" />
    <visualScript type="VisActionList">
        <playWhile type="PredicateExoVisualAllowedAction" />
        <preconditional>true</preconditional>
        <elements>
            <Item type="CreatureChangeVisItemsAction">
                <items>
                    <Item>
                        <slot>EARRING2</slot>
                        <newItem href="/Items/VisualItems/Cloak/Bag_Plate_E_78ExoskeletonV3Base.(VisualItem).xdb" />
                    </Item>
                </items>
                <isGfxCondition>false</isGfxCondition>
                <leaveWeapons>true</leaveWeapons>
                <notForDolls>true</notForDolls>
                <removeAllItems>false</removeAllItems>
            </Item>
        </elements>
        <play>Simultaneously</play>
        <restartOnVisualChange>false</restartOnVisualChange>
        <stopOnDeath>false</stopOnDeath>
        <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
    </visualScript>
    <p2p>false</p2p>
    <unlock href="ExoMount03Base.(UnlockResource).xdb" />
</gameMechanics.constructor.schemes.mount.MountSkin>