<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739887797</resourceId>
	</Header>
	<Name href="HG06_Boss_TermiteBoss_Summon.(SpellSingleTarget).Name.txt" />
	<image href="/Interface/Icons/Spells/Necromancer/PetModeAggressive.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualScripts href="/Spells/VisScripts/Creatures/SpecialAttack.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<mechanics>
		<cooldown>
			<duration>32000</duration>
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.RepeatedImpact">
				<impact type="gameMechanics.elements.impacts.ImpactAggrolistMember">
					<selector type="gameMechanics.tools.SelectorRandomNotLess">
						<minIndex>1</minIndex>
					</selector>
					<filter type="gameMechanics.world.creature.AvatarFilter" />
					<impacts>
						<Item>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactSummon">
									<destination type="gameMechanics.map.destination.DestinationModified">
										<destination type="gameMechanics.map.destination.SelfPosDestination" />
										<modifiers>
											<Item type="gameMechanics.map.destination.modifier.ModifierTrail">
												<modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
													<verticalRange min="3" max="8" />
													<horizontalRange min="3" max="8" />
												</modifier>
											</Item>
										</modifiers>
									</destination>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
										<Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
									</impacts>
									<impactsFromTarget>
										<Item type="gameMechanics.elements.impacts.ForceAggro" />
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="HG06_Boss_TermiteBoss_SummonAddTaunt.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										</Item>
									</impactsFromTarget>
									<object href="HG06_Boss_TermiteBoss_SummonAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
									<pool href="HG06_Boss_TermiteBoss_SummonAdd.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
									<isPersonalPool>true</isPersonalPool>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</impact>
				<count type="gameMechanics.elements.calcers.FloatData">
					<value>3</value>
				</count>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
