<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart />
	<wholeCasting type="VisActionList">
		<visActionID>pre</visActionID>
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastOmniWand</Item>
				</animations>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/WarriorTaunt_Caster.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>2</scale>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>1000</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>pre</stoppedActionID>
					</Item>
				</elements>
				<stopOnDeath>false</stopOnDeath>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
