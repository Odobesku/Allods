<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>400</delay>
						<effectFx href="/Spells/FX/Mobs/Yeti_AOEFear.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<scale>3</scale>
						<member>Mount</member>
						<offset z="0.3" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
</SpellVisScripts>
