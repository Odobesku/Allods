            </Item>
            <Item type="gameMechanics.elements.impacts.DirectHeal">
                <heal>1</heal>
                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="gameMechanics.elements.calcers.LinearCalcer">
                        <mul var="mul" />
                        <mulCalcer type="gameMechanics.elements.calcers.FairyHealCalcer" />
                        <sum>0</sum>
                    </mulCalcer>
                </scalerTarget>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAddFairyExperience">
                <experience var="experience" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Fairies/AbilityUseBuff.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <affectGroup>Group</affectGroup>
                <affectHolder>false</affectHolder>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
                        <currency href="/Mechanics/AlternativeCurrencies/Myrrh.xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                        <sumCalcer type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.CalcerIf">
                                    <predicate type="gameMechanics.elements.predicates.PredicateUnlock">
                                        <unlock href="/Mechanics/Unlocks/VeteranRewards/VeteranRankMaster.xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
                                    </predicate>
                                    <calcerIf type="gameMechanics.elements.calcers.FloatData">
                                        <value>0.7</value>
                                    </calcerIf>
                                    <calcerElse type="gameMechanics.elements.calcers.FloatData">
                                        <value>1</value>
                                    </calcerElse>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.CalcerIf">
                                    <predicate type="gameMechanics.constructor.basicElements.PredicateAnd">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                                                <key href="/System/ContentKeys/WeakFactionMyrrhBonus.(ContentKey).xdb#xpointer(/basement.contentkey.ContentKey)" />
                                            </Item>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                                <predicates>
                                                    <Item type="gameMechanics.elements.predicates.PredicateWeakFaction" />
                                                    <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                                        <buff href="/Mechanics/Spells/ItemSpells/ChangeFaction/BuffWeakFaction.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                        <range>
                                                            <min>1</min>
                                                            <max>1</max>
                                                        </range>
                                                    </Item>
                                                </predicates>
                                            </Item>
                                        </predicates>
                                    </predicate>
                                    <calcerIf type="gameMechanics.constructor.basicElements.FloatZero" />
                                    <calcerElse type="gameMechanics.elements.calcers.FairySpellCostCalcer">
                                        <mul var="mul02" />
                                    </calcerElse>
                                </Item>
                            </calcers>
                        </sumCalcer>
                    </Item>
                </impacts>
                <filter type="gameMechanics.world.creature.AvatarFilter" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateHasSpell">
                        <spell href="Spell03.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
