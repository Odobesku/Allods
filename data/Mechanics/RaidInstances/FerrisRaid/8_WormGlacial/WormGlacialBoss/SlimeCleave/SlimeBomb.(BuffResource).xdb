<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739893724</resourceId>
    </Header>
    <Name href="SlimeBomb.(BuffResource).Name.txt" />
    <Description href="SlimeBomb.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BlueWorm.(UISingleTexture).xdb" />
    <visScript href="SlimeBomb.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>15</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ACID</element>
                            <damage>30</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                        </moveType>
                        <resource href="SlimePuddle.(ProjectileResource).xdb" />
                    </projectileData>
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactKill" />
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.55</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.WeaponSpeedMultiplier">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.55</coeff>
            </scaler>
        </Item>
    </effects>
    <duration>30000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>