<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureCutSceneAction" />
            <Item type="CreatureMusicParamAction">
                <parameter href="ToadMusic.(SoundParameter).xdb" />
                <creatureParameter type="CutSceneParameter" />
                <value>1</value>
            </Item>
            <Item type="Sound3DAction">
                <sound>
                    <project href="" />
                    <name />
                </sound>
            </Item>
        </elements>
    </action>
    <postAction />
</BuffVisScripts>