<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<playWhile />
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>EnchantPoison</flagName>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="PredicateCreatureFlagAction">
							<flagName>PoisonBallsAbility</flagName>
						</playWhile>
						<preconditional>true</preconditional>
						<elements>
							<Item type="CreatureSetFlagAction">
								<flagName>PoisonBalls</flagName>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>instantSpellCastDirected</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
					<eventPlaybackEnd>true</eventPlaybackEnd>
					<waitRealEvent>WAIT_FROMFIRSTKEY</waitRealEvent>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>PoisonBalls</flagName>
					<checkIsSet>false</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="VisActionList">
						<playWhile />
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Spells/StalkerBallsOfSteelAbilityp_ProjectTail.(VisObjectTemplate).xdb" />
								<explosionFx href="/Spells/FX/Spells/StalkerBallsOfSteelAbility_Hit.(VisObjectTemplate).xdb" />
								<theGe>7</theGe>
								<pointOnCaster type="VisPointLocator">
									<locator>Global</locator>
								</pointOnCaster>
								<pointOnTarget type="VisPointLocator">
									<locator>Global</locator>
								</pointOnTarget>
								<offendTime type="EffectOffendConstDelay" />
								<optionalSpeed>0</optionalSpeed>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>PoisonBalls</flagName>
					<checkIsSet>true</checkIsSet>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="VisActionList">
						<playWhile />
						<elements>
							<Item type="CreatureVisActionStartThrow" />
							<Item type="CreatureProjectileAction">
								<projectileFx href="/Spells/FX/Spells/StalkerBallsOfSteelAbilityp_ProjectTail.(VisObjectTemplate).xdb" />
								<explosionFx href="/Spells/FX/Spells/Stalker70_PoisonEnchantBalls.(VisObjectTemplate).xdb" />
								<theGe>7</theGe>
								<pointOnCaster type="VisPointLocator" />
								<pointOnTarget type="VisPointLocator" />
								<offendTime type="EffectOffendConstDelay" />
								<optionalSpeed>0</optionalSpeed>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureSetFlagAction">
				<flagName>PoisonBalls</flagName>
				<isSet>false</isSet>
			</Item>
		</elements>
	</launch>
	<charged />
</SpellVisScripts>
