<?xml version="1.0" encoding="UTF-8"?>
<VisualMountClass>
    <animationSettings>
        <complexAnimations>
            <Item>
                <animation>whirlwind</animation>
                <playOnMount>idle</playOnMount>
                <playOnRiderBottom>mountStoveIdle</playOnRiderBottom>
                <playOnRiderTop>mountStoveIdle</playOnRiderTop>
            </Item>
            <Item>
                <animation>loot</animation>
                <playOnMount>idle</playOnMount>
