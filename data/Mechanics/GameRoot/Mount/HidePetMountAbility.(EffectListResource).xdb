<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.EffectListResource>
	<Header>
		<resourceId>739891497</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Select</channel>
				<vector>Incoming</vector>
				<direction>Outgoing</direction>
				<plane href="PetMountPlane.xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
			</visibilityRule>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsToPet">
			<effects>
				<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
					<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
						<coeff>1</coeff>
					</effectScaler>
				</Item>
				<Item type="gameMechanics.elements.effects.AddPlane">
					<plane href="PetMountPlane.xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
				</Item>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="PetTransparency.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							<stacks type="gameMechanics.elements.calcers.FloatData">
								<value>1</value>
							</stacks>
						</Item>
					</impactsOn>
					<impactsOff>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="PetTransparency.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impactsOff>
				</Item>
			</effects>
		</Item>
	</effects>
</gameMechanics.constructor.basicElements.EffectListResource>
