<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureSetTransparencyAction">
				<visActionID>transparency</visActionID>
				<transparency>0</transparency>
			</Item>
			<Item type="VisActionDelay">
				<time>2000</time>
			</Item>
			<Item type="VisActionStopAction">
				<stoppedActionID>transparency</stoppedActionID>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>resurrection</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
						<advanced>
							<speed>0.8</speed>
						</advanced>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/SummonUndead.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
