<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739864646</resourceId>
	</Header>
	<Name href="IsleKick.(BuffResource).Name.txt" />
	<Description href="IsleKick.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Special/Cues/IconTeleport.(UISingleTexture).xdb" />
	<nameTemplate href="IsleKick.(BuffResource)_Name.txt.template" />
	<descTemplate href="IsleKick.(BuffResource)_Desc.txt.template" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ZoneDistributor">
						<zone type="gameMechanics.elements.calcers.ZoneDistributor$OwnZone" />
						<faction type="gameMechanics.elements.calcers.ZoneDistributor$AnyFaction" />
					</distributor>
					<data href="IsleKickWarning.(ClientData).xdb" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>9000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.resources.ResourceBuff">
									<buff href="/Items/InteractiveObjects/UmoirIsland03/TravelSphereBuff.(BuffResource).xdb" />
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="/Items/InteractiveObjects/UmoirIsland03/TravelSphereBuff.(BuffResource).xdb" />
								</Item>
							</impactsIf>
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateOr">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateInZone">
									<zone href="/Maps/UmoirIsland03/Zones/UmoirIsland03/UmoirIsland03.(ZoneResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.predicates.PredicateInZone">
									<zone href="/Maps/UmoirIsland03/Zones/UmoirIsland03_Instance/UmoirIsland03_Instance.(ZoneResource).xdb" />
								</Item>
							</predicates>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactTeleport">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>U_V_gorod</scriptID>
									<map href="/Maps/Umoir/City_MapResource.xdb" />
								</locator>
							</destination>
						</Item>
					</impactsIf>
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Jump</Item>
				<Item>Rotate</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.Hover" />
	</effects>
	<duration>10000</duration>
	<isStackable>false</isStackable>
	<isHelpful>false</isHelpful>
	<canBeSaved>true</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
