<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739934848</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="R7_PhysPsyker_Add_BossDeathTrigger.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.RelativePos" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTrail">
                                                <modifier type="gameMechanics.map.destination.modifier.SpreadModifier">
                                                    <verticalRange min="0" max="0" />
                                                    <horizontalRange min="20" max="35" />
                                                </modifier>
                                            </Item>
                                        </modifiers>
                                    </destination>
                                    <object href="R7_PhysPsyker_Add_HM.(MobWorld).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                            <value>1</value>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <spawnResource href="R7_PsykerBoss_HM.(SpawnTable).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                                            <value>1</value>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <spawnResource href="R7_PsykerBoss.(SpawnTable).xdb" />
                </Item>
            </onEnter>
            <effects>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>90</radius>
                            <affectGroup>Friends</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="R7_InfPsyker_Pulse_HM.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="R7_InfPsyker_Pulse.(ClientData).xdb" />
                                    <calcers>
                                        <addressEntries>
                                            <Item>
                                                <name>caster</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                            </Item>
                                            <Item>
                                                <name>target</name>
                                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                                            </Item>
                                        </addressEntries>
                                    </calcers>
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="R7_InfPsyker_Pulse_HM.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                    <tick>5000</tick>
                </Item>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <tick>1000</tick>
                    <affectGroup>All</affectGroup>
                    <radius>10</radius>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                    <impactsIn>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="R7_Psyker_Aura_Check.(BuffResource).xdb" />
                        </Item>
                    </impactsIn>
                    <impactsOut>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="R7_Psyker_Aura_Check.(BuffResource).xdb" />
                        </Item>
                    </impactsOut>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Inf_Plane.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>