            <hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
            <isPortraitEnabled>true</isPortraitEnabled>
            <lockScale>false</lockScale>
            <scaleFromGlobal>false</scaleFromGlobal>
            <skipSound>false</skipSound>
        </Item>
        <Item type="AttachedVisObjectComponent">
            <offset x="0" y="0" z="0" />
            <priority>0</priority>
            <rotation x="0" y="0" z="0" w="1" />
            <scale>1</scale>
            <visObject href="/Spells/FX/Mobs/KrakenAdd_Projectile_FX.(VisObjectTemplate).xdb#xpointer(/client.Scene.VisObjectTemplate)" />
            <hideWithParentWhenNotAttached>false</hideWithParentWhenNotAttached>
            <isPortraitEnabled>true</isPortraitEnabled>
            <lockScale>false</lockScale>
