    </Header>
    <Name href="DevouringSouls.(SpellArea).Name.txt" />
    <visualScripts href="DevouringSouls.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="DevouringSouls.(SpellArea).Name.txt" />
    <prepareDuration>10000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>40000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                </predicates>
            </Item>
        </targetConditions>
        <channelingMechanics>
            <channelingBuff href="SoulCatch.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            <isForthright>true</isForthright>
        </channelingMechanics>
        <casterChannelingEffects>
            <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="InnerRage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impacts>
                <initialDelay>1000</initialDelay>
            </Item>
        </casterChannelingEffects>
    </mechanics>
    <shapeCenterPosition>Caster</shapeCenterPosition>
    <radius>50</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>