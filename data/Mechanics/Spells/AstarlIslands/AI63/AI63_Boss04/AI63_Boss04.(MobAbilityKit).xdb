<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.MobAbilityKit>
	<Header>
		<resourceId>739911855</resourceId>
	</Header>
	<spellEntries>
		<Item>
			<spell href="Boss04_MorphingChannel.(SpellSingleTarget).xdb" />
			<targetSelector>
				<sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByDistance">
					<order>Ascending</order>
				</sortTargets>
				<helpfulRadius>40</helpfulRadius>
				<moveToDestination>true</moveToDestination>
				<targetConditionChecks>
					<Item>
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
								<mobs>
									<Item href="CrowAdd.(MobWorld).xdb" />
								</mobs>
							</Item>
						</predicates>
					</Item>
				</targetConditionChecks>
			</targetSelector>
			<cooldowns>
				<min>5000</min>
				<max>5000</max>
			</cooldowns>
		</Item>
		<Item>
			<spell href="Boss04_CrowNuke.(SpellSingleTarget).xdb" />
			<targetSelector>
				<sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort">
					<avatarsFirst>true</avatarsFirst>
				</sortTargets>
				<targetConditionChecks>
					<Item>
						<predicates>
							<Item type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="CrowAdd_Kill.(BuffResource).xdb" />
							</Item>
						</predicates>
					</Item>
				</targetConditionChecks>
			</targetSelector>
		</Item>
		<Item>
			<spell href="Boss04_kitten.(SpellSingleTarget).xdb" />
			<targetSelector>
				<sortTargets type="gameMechanics.elements.targetSelector.sorts.SortByAggro">
					<startFrom>1</startFrom>
					<shuffle>true</shuffle>
				</sortTargets>
				<moveToDestination>true</moveToDestination>
				<targetConditionChecks>
					<Item>
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
						</predicates>
					</Item>
				</targetConditionChecks>
			</targetSelector>
			<cooldowns>
				<min>10000</min>
				<max>10000</max>
			</cooldowns>
		</Item>
		<Item>
			<spell href="Boss04_Spam.(SpellSingleTarget).xdb" />
			<targetSelector>
				<sortTargets type="gameMechanics.elements.targetSelector.sorts.RandomSort" />
				<targetConditionChecks>
					<Item>
						<predicates>
							<Item type="gameMechanics.constructor.basicElements.PredicateOr">
								<predicates>
									<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
									<Item type="gameMechanics.elements.resources.ResourceBuff">
										<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
									</Item>
								</predicates>
							</Item>
						</predicates>
					</Item>
				</targetConditionChecks>
			</targetSelector>
		</Item>
	</spellEntries>
	<abilities>
		<Item href="AI63_Boss04_abilities.(AbilityResource).xdb" />
	</abilities>
</gameMechanics.world.mob.MobAbilityKit>
