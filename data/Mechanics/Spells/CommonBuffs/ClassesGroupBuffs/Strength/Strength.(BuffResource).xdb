<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>200368</resourceId>
    </Header>
    <Name href="Strength.(BuffResource).Name.txt" />
    <Description href="Strength.(BuffResource).Description02.txt" />
    <image href="/Interface/Icons/CommonState/Buff_Might.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/ClassesGroupBuffs/Strength.(BuffVisScripts).xdb" />
    <sysUIScriptName>Proc_PanelA01_NoStack</sysUIScriptName>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Groups/CommonBuffs03.(ActionGroup).xdb" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <casterFactor type="gameMechanics.constructor.basicElements.ScalerCalcer">
                        <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                            <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                <stat type="gameMechanics.elements.stat.SpecialStat">
                                    <stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
                                </stat>
                                <valueType>ShortTerm</valueType>
                            </mulCalcer>
                            <sum>1</sum>
                        </scaler>
                        <value>1.2</value>
                    </casterFactor>
                    <scaler type="gameMechanics.constructor.basicElements.TrivialEffectScaler" />
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsToPet">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                            <casterFactor type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                        <stat type="gameMechanics.elements.stat.SpecialStat">
                                            <stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
                                        </stat>
                                        <valueType>ShortTerm</valueType>
                                    </mulCalcer>
                                    <sum>1</sum>
                                </scaler>
                                <value>1.2</value>
                            </casterFactor>
                            <scaler type="gameMechanics.constructor.basicElements.TrivialEffectScaler" />
                        </Item>
                    </effects>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectsToAllAssistants">
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/ClassAssistant/ClassAssistant.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <effectsIf>
                                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                    <casterFactor type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                        <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                                <stat type="gameMechanics.elements.stat.SpecialStat">
                                                    <stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
                                                </stat>
                                                <valueType>ShortTerm</valueType>
                                            </mulCalcer>
                                            <sum>1</sum>
                                        </scaler>
                                        <value>1.2</value>
                                    </casterFactor>
                                    <scaler type="gameMechanics.constructor.basicElements.TrivialEffectScaler" />
                                </Item>
                            </effectsIf>
                        </Item>
                    </effects>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>0.35</coeff>
                        <calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
                                    </stat>
                                    <valueType>ShortTerm</valueType>
                                </mulCalcer>
                                <sum>1</sum>
                            </scaler>
                            <value>1</value>
                        </calcer>
                    </scaler>
                </Item>
            </effectsElse>
        </Item>
    </effects>
    <duration>1000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/CommonBuffs01.xdb" />
        <Item href="/Mechanics/Spells/Groups/CommonBuffs03.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>