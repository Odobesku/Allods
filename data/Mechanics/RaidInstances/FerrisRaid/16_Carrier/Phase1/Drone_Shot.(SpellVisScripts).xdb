<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>1200</time>
				</playWhile>
				<elements>
					<Item type="CreatureVisObjectComponentsAction">
						<visObjComponents>
							<Item type="AttachedVisObjectComponent">
								<visObject href="/Spells/FX/Mobs/ReadySpell_Drone_Shot.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<scale>0.39</scale>
								<offset y="-0.55" />
								<locatorName>Slot_Special01</locatorName>
							</Item>
						</visObjComponents>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>run</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<speed>2</speed>
				</advanced>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>knockdownEnd</Item>
				</animations>
				<channelOverrideScript />
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="VisActionList">
						<playWhile type="VisActionDelay">
							<time>350</time>
						</playWhile>
						<elements>
							<Item type="CreatureChannelDirectAction">
								<channelingFx href="/Spells/FX/Mobs/Channell_Drone_Shot.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<fxLength>20</fxLength>
								<startPoint type="VisPointLocator">
									<shift x="0.15" z="0.2" />
									<locator>Slot_FX</locator>
									<locatorName>Stone_L</locatorName>
								</startPoint>
								<alternativeStartPoint />
								<endPoint type="VisPointLocator">
									<shift y="0.1" />
									<locator>Slot_FX</locator>
									<member>Assaulter</member>
								</endPoint>
								<alternativeEndPoint />
								<fadeOutTime>400</fadeOutTime>
								<offendTime />
								<multyTargetMode>Umbrella</multyTargetMode>
								<secondaryTargetParams>
									<channelingFx href="" />
									<offendTime />
								</secondaryTargetParams>
							</Item>
						</elements>
					</Item>
					<Item type="CreatureEffectsOnTarget">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/PortalBoss_Discharge_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<scale>1.2</scale>
								<fadeInTime>500</fadeInTime>
								<locator>Slot_FX</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
