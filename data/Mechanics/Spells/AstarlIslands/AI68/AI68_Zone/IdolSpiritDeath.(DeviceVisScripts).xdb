<DeviceVisScripts>
    <states>
        <Item>
            <action type="DeviceAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>idle</Item>
                </animations>
            </action>
        </Item>
        <Item>
            <action type="DeviceAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>run</Item>
                </animations>
            </action>
        </Item>
        <Item>
            <action type="DeviceAnimationAction">
                <mode>DIE</mode>
                <animations>
                    <Item>special</Item>
                </animations>
            </action>
        </Item>
    </states>
</DeviceVisScripts>