<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>ready</Item>
                </animations>
            </Item>
            <Item type="CreatureSetTransparencyAction">
                <transparency>0.5</transparency>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/AOEAura_Fire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <lockScale>true</lockScale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </action>
    <postAction type="CreatureAnimationAction">
        <animations>
            <Item>specialCast</Item>
        </animations>
    </postAction>
</BuffVisScripts>