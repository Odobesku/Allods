                                    <buff href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss02/RD_Humanoid_Boss1_ReflectStacks.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="RD_Humanoid_Boss3_BigAE_Shield.(BuffResource).xdb" />
                                            </predicate>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>FIRE</element>
                                            <scalerTarget type="gameMechanics.elements.scalers.ScalerBuff">
