					<quest href="/World/Quests/HuntingGround1/HG1_Post/HG1_Post.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
					<status>Started</status>
				</Item>
			</predicates>
			<impactsIf>
