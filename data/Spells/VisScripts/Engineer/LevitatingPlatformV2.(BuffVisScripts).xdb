<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="AttachedVisObjectComponent">
						<visObject href="/Creatures/EngineerGadgets/EngineerPlatform/EngineerPlatform.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<offset z="-2.7" />
						<locatorName>Slot_Global</locatorName>
						<lockScale>true</lockScale>
					</Item>
				</visObjComponents>
			</Item>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readyEngineer</Item>
				</animations>
				<channel>CHANNEL_DEFAULT</channel>
				<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
