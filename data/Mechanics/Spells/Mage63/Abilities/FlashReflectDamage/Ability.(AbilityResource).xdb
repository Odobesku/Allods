<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739922206</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.(AbilityResource).Name.txt" />
    <description href="Ability.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>perc</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
        <Item>
            <name>stat</name>
            <value var="stat" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Special/Talents/Mage/MagicMirrorF.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Mage63/Abilities/Flash/Buff.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
                    <impacts>
                        <targetToOffender>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/Spells/Mage63/Spells/Barriers/Buff.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.PureDamage">
                                        <damage>1</damage>
                                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                            <scalers>
                                                <Item type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier var="value" />
                                                </Item>
                                            </scalers>
                                        </scaler>
                                        <scalerTarget type="gameMechanics.elements.scalers.TrivialScaler" />
                                    </Item>
                                </impacts>
                            </Item>
                        </targetToOffender>
                    </impacts>
                    <scaleImpactsByDamage>true</scaleImpactsByDamage>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/Mage63/Abilities/Flash/Buff.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.SummandStat">
                    <stat type="gameMechanics.elements.stat.SpecialStat">
                        <stat href="/Mechanics/SpecialStats/BuffPower.(SpecialStatResource).xdb" />
                    </stat>
                    <value var="stat" />
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>