    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>28000</duration>
        </cooldown>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceAnyBuff">
                        <buffs>
