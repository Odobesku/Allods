<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739964224</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Crafting/Gold.(UISingleTexture).xdb" />
    <source>Vendor</source>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb" />
    <functionalPart type="itemService.avatar.itemBag.UseItemAndTakeActions">
        <usages>
            <Item>
                <actions>
                    <Item type="itemService.avatar.itemBag.RepeatStackTakeAction">
                        <actions>
                            <Item type="itemService.avatar.itemBag.IfTakeAction">
                                <predicate type="itemService.mail.predicates.PredicateAltCurrencyGE">
                                    <currency href="/Mechanics/AlternativeCurrencies/Realgar.(AlternativeCurrency).xdb" />
                                    <value>60</value>
                                </predicate>
                                <actions>
                                    <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                                        <item type="gameMechanics.constructor.schemes.item.BoundItemProvider">
                                            <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                                                <item href="ShiningFragment_70.(ItemResource).xdb" />
                                            </item>
                                        </item>
                                        <count type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                                            <value>100</value>
                                        </count>
                                        <modifiers>
                                            <Item type="itemService.avatar.itemBag.ReplaceRemoveTimeModifier" />
                                        </modifiers>
                                    </Item>
                                </actions>
                                <elseActions>
                                    <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                                        <currency href="/Mechanics/AlternativeCurrencies/Realgar.(AlternativeCurrency).xdb" />
                                    </Item>
                                </elseActions>
                            </Item>
                        </actions>
                    </Item>
                </actions>
                <consumeItems>100</consumeItems>
            </Item>
        </usages>
        <triggersGlobalCooldown>false</triggersGlobalCooldown>
        <useStack>true</useStack>
        <stackLimit type="itemService.elements.avatarstuffcalcer.StuffCalcerSum">
            <calcers>
                <Item type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                    <value>60</value>
                </Item>
                <Item type="itemService.elements.avatarstuffcalcer.StuffCalcerMul">
                    <calcers>
                        <Item type="itemService.elements.avatarstuffcalcer.StuffCalcerLongData">
                            <value>-1</value>
                        </Item>
                        <Item type="itemService.elements.avatarstuffcalcer.StuffCalcerAlternativeCurrency">
                            <currency href="/Mechanics/AlternativeCurrencies/Realgar.(AlternativeCurrency).xdb" />
                        </Item>
                    </calcers>
                </Item>
            </calcers>
        </stackLimit>
    </functionalPart>
    <level>70</level>
    <requiredLevel>10</requiredLevel>
    <stackLimit>3000</stackLimit>
    <quality href="/Mechanics/ItemQualities/Rare.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.AltCurrenciesItem">
        <currencies>
            <Item>
                <currency href="/Mechanics/AlternativeCurrencies/Realgar.(AlternativeCurrency).xdb" />
            </Item>
        </currencies>
    </prices>
    <binding>BindOnPickup</binding>
    <lifeLengthCap>86400000</lifeLengthCap>
    <name href="ShiningFragment_70.(ItemResource).Name.txt" />
    <description href="ShiningFragment_70.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/ItemMall.xdb" />
</gameMechanics.constructor.schemes.item.ItemResource>