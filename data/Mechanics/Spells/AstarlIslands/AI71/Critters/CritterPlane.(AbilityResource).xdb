<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739935123</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.Enlarge">
			<factor>0.75</factor>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="CritterPlane.(Plane).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectNoAggro" />
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>All</affectGroup>
			<radius>4</radius>
			<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
					<Item type="gameMechanics.elements.predicates.PredicateCreature" />
				</predicates>
			</filter>
			<holderImpactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="Fear.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsElse>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Fear.(BuffResource).xdb" />
						</Item>
					</impactsElse>
				</Item>
			</holderImpactsIn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectSpeedModifier">
			<effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.5</coeff>
			</effectScaler>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
