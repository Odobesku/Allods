<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<defaultVisAction type="DeviceVisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="Pride_Cinema_state2.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptStart />
				<visScriptLoop type="DeviceAnimationAction">
					<mode>LOOP</mode>
					<animations>
						<Item>special</Item>
					</animations>
				</visScriptLoop>
				<visScriptEnd />
			</Item>
			<Item type="DeviceIfFlagVisAction">
				<visualFlag href="Pride_Cinema_state3.(VisualFlag).xdb#xpointer(/VisualFlag)" />
				<visScriptStart />
				<visScriptLoop type="DeviceAnimationAction">
					<mode>LOOP</mode>
					<animations>
						<Item>death</Item>
					</animations>
				</visScriptLoop>
				<visScriptEnd />
			</Item>
		</elements>
	</defaultVisAction>
</DeviceVisScripts>
