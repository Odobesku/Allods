<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>320270</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHealthLower">
                    <level>0.16</level>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                            <radius>60</radius>
                                            <affectPets>false</affectPets>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                                    <id href="CountId_1.xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value>0.6</value>
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                    <data href="TekuaniFear.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.HealthTrigger">
                    <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                        <multiplier>0.15</multiplier>
                    </healthOn>
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                            <radius>60</radius>
                                            <affectPets>false</affectPets>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                                    <id href="CountId_1.xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                            <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                <value>0.6</value>
                            </chanceCalcer>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                    <data href="TekuaniFear.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effectsElse>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>