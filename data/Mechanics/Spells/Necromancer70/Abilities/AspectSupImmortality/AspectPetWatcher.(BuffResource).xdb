<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>198619</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.abilities.DieHardObserver">
            <dieHardBuff href="BuffDieHard.(BuffResource).xdb" />
            <onBehalfOfHolder>true</onBehalfOfHolder>
            <impactsOnAttach>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/Spells/Necromancer70/Spells/OtherSide/Buff.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/Necromancer70/Spells/OtherSide/Buff.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer hrefvar="buff_duration" />
                                </mulCalcer>
                            </durationScaler>
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
