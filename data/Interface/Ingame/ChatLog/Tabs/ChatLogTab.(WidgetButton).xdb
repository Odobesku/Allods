<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <BackLayer href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabBack.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
    <Children>
        <Item href="/Interface/Ingame/ChatLog/Tabs/ChatLogTab.(WidgetPanel).xdb#xpointer(/client.Widgets.WidgetPanel)"/>
    </Children>
    <Name>Tab</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Size>96</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Size>24</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>tab_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>false</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>false</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_BOTTOM</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="1"/>
            <Reaction>tab_pressed</Reaction>
            <ReactionRightClick>tab_rmb_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ChatLog/Tabs/ChatLogTab.txt"/>
                <LayerMain href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabToggled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabLabel.txt"/>
            <reactionDblClick>tab_dbl_pressed</reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="0" y="1"/>
            <Reaction>tab_pressed</Reaction>
            <ReactionRightClick>tab_rmb_pressed</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabToggled.txt"/>
                <LayerMain href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabToggled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabToggled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ChatLog/Tabs/ChatLogTabLabel.txt"/>
            <reactionDblClick>tab_dbl_pressed</reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
