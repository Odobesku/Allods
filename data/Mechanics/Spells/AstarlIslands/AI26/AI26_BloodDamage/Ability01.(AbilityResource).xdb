											<predicates>
												<Item type="gameMechanics.elements.resources.ResourceBuff">
													<buff href="/Mechanics/Spells/AstarlIslands/AI26/SackKD.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
