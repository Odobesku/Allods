<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/MountGolem_Shield.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<scale>2.5</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_FX</locator>
						<offset z="-0.5" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
