<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>222005</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                            <ability href="RoboGuards_HM_Abilities1.(AbilityResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactForgetAbility">
                            <ability href="RoboGuards_HM_Abilities1.(AbilityResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="RoboGuard1/BombsCount.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="RoboGuard1/RoboGuard1.(MobWorld).xdb" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="RoboGuard2/RoboGuard1_HM_Defence.(BuffResource).xdb" />
                                    <stacks type="gameMechanics.elements.calcers.FloatData">
                                        <value>3</value>
                                    </stacks>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                            <mobs>
                                <Item href="RoboGuard1/RoboGuard1.(MobWorld).xdb" />
                            </mobs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="RoboGuard2/DamageAura_HM.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="RoboGuard1/ChainsCount.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>