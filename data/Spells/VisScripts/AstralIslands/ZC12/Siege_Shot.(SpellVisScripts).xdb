<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>ready</Item>
				</animations>
				<channelOverrideScript />
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/ReadySpellDirect03DownLightning.(VisObjectTemplate).xdb" />
				<scale>2</scale>
				<fadeOutTime>300</fadeOutTime>
				<locator>Slot_Global</locator>
				<offendTime />
			</Item>
		</visualEffects>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirected</Item>
				</animations>
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>InSequence</play>
				<elements>
					<Item type="VisActionDelay">
						<time>300</time>
					</Item>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Engineer_ElectricityProjectile.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Spells/HitLightning.(VisObjectTemplate).xdb" />
						<pointOnCaster type="VisPointLocator">
							<shift z="1" />
							<locator>Slot_BodyFX</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnTarget>
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/PortalBoss_Discharge_Hit.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Spine1</locatorName>
						<offset z="0.5" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
