<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>310618</resourceId>
    </Header>
    <visScript href="Vision.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Outgoing</vector>
                <direction>Self</direction>
                <plane href="Fight_plane.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.AddVisibilityRule">
            <visibilityRule>
                <channel>Visibility</channel>
                <vector>Incoming</vector>
                <direction>Self</direction>
                <plane href="Fight_plane.(Plane).xdb" />
            </visibilityRule>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDoesNotAggro" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                    <id href="Counter2.(QuestCountId).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="Fight_plane.(Plane).xdb" />
        </Item>
    </effects>
    <duration>15000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>