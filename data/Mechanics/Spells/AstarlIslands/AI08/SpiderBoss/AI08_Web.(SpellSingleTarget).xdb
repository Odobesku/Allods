<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739870248</resourceId>
    </Header>
    <Name href="AI08_Web.(SpellSingleTarget).Name.txt" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                <projectileData>
                    <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                    <resource href="AI08_Web.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                </projectileData>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <affectHolder>false</affectHolder>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactSummon">
                        <destination type="gameMechanics.map.destination.DestinationModified">
                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                            <modifiers>
                                <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                    <verticalRange min="0" max="0" />
                                    <horizontalRange min="3" max="3" />
                                </Item>
                            </modifiers>
                        </destination>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                            <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                        </impacts>
                        <object href="AI08_Spider_Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                        <pool href="AI08_Add_Death.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    </Item>
                </impacts>
                <targetsLimit>3</targetsLimit>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>