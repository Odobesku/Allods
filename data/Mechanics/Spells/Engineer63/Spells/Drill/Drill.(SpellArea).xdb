                                                    <Item type="gameMechanics.elements.calcers.CalcerIf">
                                                        <predicate type="gameMechanics.elements.predicates.PredicateHasAbility">
                                                            <ability href="/Mechanics/Spells/Engineer63/Abilities/FallingDevices/FallingDevices01.(AbilityResource).xdb" />
                                                        </predicate>
                                                        <calcerIf type="gameMechanics.elements.calcers.FloatData">
                                                            <value>2.5</value>
                                                        </calcerIf>
                                                        <calcerElse type="gameMechanics.elements.calcers.FloatData">
                                                            <value>0.5</value>
                                                        </calcerElse>
                                                    </Item>
                                                </summands>
                                            </mulCalcer>
                                        </durationScaler>
                                        <stacks type="gameMechanics.elements.calcers.CalcerMax">
                                            <calcers>
                                                <Item type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                                    <dressSlot>AMMO</dressSlot>
                                                </Item>
                                                <Item type="gameMechanics.elements.calcers.FloatData">
                                                    <value>1</value>
                                                </Item>
                                            </calcers>
                                        </stacks>
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                        <delay>100</delay>
                                        <impacts>
                                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                <buff href="DrillLifetime.(BuffResource).xdb" />
                                                <durationScaler type="gameMechanics.elements.scalers.BuffTicksScaler">
                                                    <buff href="DrillStuff01.(BuffResource).xdb" />
                                                    <tickLength>1000</tickLength>
                                                </durationScaler>
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
