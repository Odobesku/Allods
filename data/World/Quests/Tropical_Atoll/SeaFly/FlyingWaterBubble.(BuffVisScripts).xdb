<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>fly</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
				<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
				<channelOverrideControllers>TOP_AND_BOTTOM</channelOverrideControllers>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/World/WaterBubble.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.5</scale>
						<locator>Slot_BodyFX</locator>
						<member>Group</member>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
