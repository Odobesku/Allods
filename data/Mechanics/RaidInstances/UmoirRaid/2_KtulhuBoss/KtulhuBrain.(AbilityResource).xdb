<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>225483</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.map.variables.MapVariableTriggerGeneric">
            <variableResource href="TeleportOn.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
            <impacts>
                <Item type="gameMechanics.map.variables.ImpactIfMapVariable">
                    <variable href="TeleportOn.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <predicates>
                        <Item type="gameMechanics.map.variables.PredicateMapVariableEqualsGeneric">
                            <variableResource href="TeleportOn.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                            <expectedValue type="gameMechanics.elements.calcers.FloatData">
                                <value>2</value>
                            </expectedValue>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>Ship</scriptID>
                                <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <onBehalfOfTarget>true</onBehalfOfTarget>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactDevicesAround">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                                    <resources>
                                                        <Item href="Boarding.(UsableDeviceResource).xdb#xpointer(/gameMechanics.world.device.UsableDeviceResource)" />
                                                    </resources>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                    <buff href="CannonOffline.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                                    <radius>160</radius>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>Ktulhu</scriptID>
                                <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                            </spawn>
                            <onBehalfOfTarget>true</onBehalfOfTarget>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                    <selector type="gameMechanics.tools.SelectorShuffle" />
                                    <impacts>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                    <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                                                    <data href="Phase2.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID>2R</scriptID>
                                    <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                </locator>
                            </destination>
                            <object href="Sphere.(SteleResource).xdb#xpointer(/gameMechanics.world.device.SteleResource)" />
                            <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Phase1Summon.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Phase2Summon.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.HealthTrigger">
            <healthOn type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.99</multiplier>
            </healthOn>
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="BrainAOE.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.map.variables.ImpactMapVariableSummand">
                    <variable href="KtulhuBoss.(MapVariableResource).xdb#xpointer(/gameMechanics.map.variables.MapVariableResource)" />
                    <summand>1</summand>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>Ship</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <onBehalfOfTarget>true</onBehalfOfTarget>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>Ktulhu</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </spawn>
                    <onBehalfOfTarget>true</onBehalfOfTarget>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactDevicesAround">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                    <resources>
                                        <Item href="Boarding.(UsableDeviceResource).xdb#xpointer(/gameMechanics.world.device.UsableDeviceResource)" />
                                    </resources>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="CannonOffline.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                    <radius>160</radius>
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="KtulhuFakeNPC.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="Scene/SceneDeath.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>1000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                                    <group href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                                </Item>
                                                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                                    <impactsResource href="WinCutscene.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                                            <group href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Scene/Death2.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                            <spawnResource href="Scene/SceneDeath.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>1</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                                    </impacts>
                                    <spawnResource href="KtulhuBoss.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                    <mob>
                        <scriptID>KtulhuChest</scriptID>
                        <map href="/Maps/UmoirRaid/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </mob>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectMobStatQuality">
            <quality href="Ktulhu.(MobStatQuality).xdb#xpointer(/gameMechanics.world.mob.MobStatQuality)" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Phase1Summon.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="BrainImmun.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                    <table href="KtulhuBoss.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactLogAvatarStats">
                                            <resource href="KtulhuBrain.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>