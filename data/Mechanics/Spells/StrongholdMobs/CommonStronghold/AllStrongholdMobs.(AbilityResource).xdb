<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739902418</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.SummandStat">
			<stat type="gameMechanics.elements.stat.InnateStat">
				<stat>Vitality</stat>
			</stat>
			<value>25</value>
			<scaler type="gameMechanics.elements.scalers.LinearScaler">
				<multiplier>10</multiplier>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.SummandStat">
			<stat type="gameMechanics.elements.stat.InnateStat">
				<stat>Plain</stat>
			</stat>
			<value>25</value>
			<scaler type="gameMechanics.elements.scalers.LinearScaler">
				<multiplier>10</multiplier>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateGreater">
									<lhs type="gameMechanics.elements.calcers.BuffStackCountCalcer">
										<buff href="RoomRuneLevel.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
										<forAllRanks>true</forAllRanks>
									</lhs>
									<rhs type="gameMechanics.elements.calcers.FloatData">
										<value>0</value>
									</rhs>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactSetStackCount">
									<buff href="RoomRuneLevel.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									<stackCount>1</stackCount>
									<stackCalcer type="gameMechanics.elements.calcers.FloatToLongCalcer">
										<calcer type="gameMechanics.world.stronghold.elements.DungeonRoomRuneLevelCalcer" />
									</stackCalcer>
								</Item>
							</impactsIf>
							<impactsElse>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="RoomRuneLevel.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
									<stacks type="gameMechanics.world.stronghold.elements.DungeonRoomRuneLevelCalcer" />
								</Item>
							</impactsElse>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>5000</tick>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
