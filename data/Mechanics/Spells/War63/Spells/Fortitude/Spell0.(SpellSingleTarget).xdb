<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739920586</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
	</groups>
	<Name href="Spell0.(SpellSingleTarget).Name.txt" />
	<Description href="Spell0.(SpellSingleTarget).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="gameMechanics.elements.calcers.LongToFloatCalcer">
							<calcer type="constructor.elements.CalcerLongExternal">
								<externalCalcer hrefvar="externalCalcer" />
							</calcer>
						</mulCalcer>
					</Item>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>HealScaler</formula>
					</Item>
				</scalers>
			</scaler>
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Bard/AcousticBarrier.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Warrior/AdrenalineRush.(SpellVisScripts).xdb" />
	<targetType>STTSelf</targetType>
	<ranks>
		<Item href="Spell01.(SpellSingleTarget).xdb" />
		<Item href="Spell02.(SpellSingleTarget).xdb" />
		<Item href="Spell03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration var="cd_duration" />
		</cooldown>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateGreaterLong">
						<lhs type="gameMechanics.elements.calcers.CalcerDamagePoolBarrier" />
						<rhs type="gameMechanics.elements.calcers.LongData">
							<value>0</value>
						</rhs>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
						<impacts>
							<Item type="gameMechanics.elements.impacts.ImpactRetriveDamageFromPoolBarrier">
								<damage type="gameMechanics.elements.calcers.CalcerLongIf">
									<predicate type="gameMechanics.elements.predicates.PredicateHasAbility">
										<ability href="/Mechanics/Spells/War63/Abilities/FortitudeUpgrade/Ability01.(AbilityResource).xdb" />
									</predicate>
									<calcerIf type="gameMechanics.elements.calcers.CalcerLongMulFloat">
										<calcerLong type="constructor.elements.CalcerLongExternal">
											<externalCalcer hrefvar="externalCalcer" />
										</calcerLong>
										<calcerFloat type="gameMechanics.elements.calcers.CalcerMul">
											<calcers>
												<Item type="gameMechanics.elements.calcers.AbilityRankCalcer">
													<ability href="/Mechanics/Spells/War63/Abilities/FortitudeUpgrade/Ability01.(AbilityResource).xdb" />
													<mul>0.166</mul>
													<sum>1</sum>
												</Item>
												<Item type="gameMechanics.constructor.basicElements.ScalerCalcer">
													<scaler type="gameMechanics.elements.scalers.HealScaler" />
													<value>1</value>
												</Item>
											</calcers>
										</calcerFloat>
									</calcerIf>
									<calcerElse type="gameMechanics.elements.calcers.CalcerLongMulFloat">
										<calcerLong type="constructor.elements.CalcerLongExternal">
											<externalCalcer hrefvar="externalCalcer" />
										</calcerLong>
										<calcerFloat type="gameMechanics.constructor.basicElements.ScalerCalcer">
											<scaler type="gameMechanics.elements.scalers.HealScaler" />
											<value>1</value>
										</calcerFloat>
									</calcerElse>
								</damage>
							</Item>
						</impacts>
					</Item>
				</impactsIf>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
