    <visualScripts href="R7_Invansion_AutoAttack.(SpellVisScripts).xdb" />
    <prepareDuration>5000</prepareDuration>
    <needLos>false</needLos>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="R7_3th_Phase.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <channelingMechanics>
            <channelingBuff href="R7_Invansion_AutoAttack.(BuffResource).xdb" />
            <finishImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                    <affectPets>false</affectPets>
                    <excludeCaster>true</excludeCaster>
                    <excludeTarget>true</excludeTarget>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="R7_Mark.(BuffResource).xdb" />
                                    <consumeStacks>1</consumeStacks>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>SHADOW</element>
                                    <damage>35</damage>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </finishImpacts>
        </channelingMechanics>
    </mechanics>
    <speed>500</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>