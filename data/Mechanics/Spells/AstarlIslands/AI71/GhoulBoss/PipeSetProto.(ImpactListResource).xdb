<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
	<Header>
		<resourceId>739963955</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<impacts>
		<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID var="SwitchOn_1" />
						<map href="/Maps/AstralIsle71/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
							<visualState>1</visualState>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID var="SwitchOn_2" />
						<map href="/Maps/AstralIsle71/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
							<visualState>1</visualState>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID var="SwitchOn_3" />
						<map href="/Maps/AstralIsle71/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
							<visualState>1</visualState>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
					<spawn>
						<scriptID var="SwitchOff" />
						<map href="/Maps/AstralIsle71/MapResource.xdb" />
					</spawn>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>250</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactSetVisualState">
									<visualState>2</visualState>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.resources.ResourceBuff">
							<buff href="BombSummonActivated.(BuffResource).xdb" />
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
							<projectileData>
								<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
									<destination type="gameMechanics.map.destination.DestinationLocator">
										<locator>
											<scriptID var="BombLoc" />
											<map href="/Maps/AstralIsle71/MapResource.xdb" />
										</locator>
									</destination>
								</moveType>
								<resource href="PlagueBombStart.(ProjectileResource).xdb" />
							</projectileData>
							<pool href="/Mechanics/Spells/AstarlIslands/AI71/Common/AI71Pool.(SummonPool).xdb" />
						</Item>
					</impactsIf>
					<impactsElse>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="BombSummonActivated.(BuffResource).xdb" />
						</Item>
					</impactsElse>
				</Item>
			</impacts>
		</Item>
	</impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>
