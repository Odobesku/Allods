<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirect01Up.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>3400</time>
					</Item>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastOmni</Item>
						</animations>
						<channelOverrideMode>OVERRIDE_IGNORE</channelOverrideMode>
						<advanced>
							<speed>0.75</speed>
						</advanced>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureTurnToMainAvatarAction" />
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Spells/PsionicPyrokinesisUpgrade.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>0.75</scale>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<stopOnDeath>false</stopOnDeath>
	</launch>
</SpellVisScripts>
