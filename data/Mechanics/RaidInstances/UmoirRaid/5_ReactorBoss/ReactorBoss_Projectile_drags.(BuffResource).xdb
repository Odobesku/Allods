<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>225154</resourceId>
    </Header>
    <Name href="ReactorBoss_Projectile_drags.(BuffResource).Name.txt" />
    <Description href="ReactorBoss_Projectile_drags.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestAspectControl.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="ReactorBoss_Projectile_drags.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Groups/EngineerLevitatingPlatformSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="/Mechanics/Spells/Groups/EngineerLevitatingSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInScriptZone">
                            <zone href="/Maps/UmoirRaid/ScriptZones/ReactorBoss_Kill_Zone.(ScriptZone).xdb#xpointer(/gameMechanics.map.scriptZone.ScriptZone)" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ForceAggro" />
                                    </impacts>
                                    <object href="ReactorBoss_Projectile.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactMobMorph">
                                    <newMobWorld href="ReactorBoss_Projectile.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ForceAggro" />
                            </impacts>
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectPull">
            <puller type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <speedFactor type="gameMechanics.elements.calcers.FloatData">
                <value>5</value>
            </speedFactor>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>-0.5</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.AbonentLostWatcher">
            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ReactorBoss_Projectile_drags.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ReactorBoss_Projectile_drags.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="ReactorBoss_Projectile_drags.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    <calcers>
                        <addressEntries>
                            <Item>
                                <name>target</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                            </Item>
                            <Item>
                                <name>caster</name>
                                <finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                            </Item>
                        </addressEntries>
                    </calcers>
                </Item>
            </impacts>
            <tick>1200</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Jump</Item>
            </actions>
        </Item>
    </effects>
    <duration>200000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>