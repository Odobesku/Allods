<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739951434</resourceId>
	</Header>
	<visualScript type="CreatureEffectsAction">
		<visualEffects>
			<Item>
				<effectFx href="/Spells/FX/Spells/General_Mage_02.(VisObjectTemplate).xdb" />
				<fadeInTime>1000</fadeInTime>
				<fadeOutTime>1000</fadeOutTime>
				<member>Group</member>
				<locatorName>Slot_BodyFX</locatorName>
			</Item>
		</visualEffects>
		<stopOnDeath>true</stopOnDeath>
	</visualScript>
	<effects>
		<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
			<scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
				<coeff>-0.8</coeff>
			</scaler>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="WW_12_1_eskort.(Plane).xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.Aura">
			<radius>20</radius>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
							<mobs>
								<Item href="/Creatures/ColossusAssasin/Instances/ZC12_Map02/ZC12_ColossusAssasin_69.(MobWorld).xdb" />
							</mobs>
						</Item>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="WW_12_1_wait.(BuffResource).xdb" />
							</predicate>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="WW_12_1_eskort.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferred">
							<delay>1000</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ForceAggro" />
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsIn>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onLeave>
				<Item type="gameMechanics.elements.impacts.ImpactSetHealthToFull" />
			</onLeave>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
