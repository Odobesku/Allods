<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739963977</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateFaction">
                                            <faction href="/World/Factions/Empire.xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                            <id href="Counter2.(QuestCountId).xdb" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                            <id href="/World/Quests/Inst_ZoneContested12_Start/WW_Prologue_4_L/Counter2.(QuestCountId).xdb" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>8</radius>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Characters/Kania_male/Instances/ZC12/WW_Prologue_4_DemonHunter1.(MobWorld).xdb" />
                                        <Item href="/Characters/Kania_male/Instances/ZC12/WW_Prologue_4_DemonHunter2.(MobWorld).xdb" />
                                        <Item href="/Characters/Kania_male/Instances/ZC12/WW_Prologue_4_DemonHunter3.(MobWorld).xdb" />
                                        <Item href="/Characters/Kania_male/Instances/ZC12/WW_Prologue_4_DemonHunter4.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/World/Quests/Ferris01/Ferris_1_2/Fight_Mrak_Visual.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.world.creature.MobFilter" />
