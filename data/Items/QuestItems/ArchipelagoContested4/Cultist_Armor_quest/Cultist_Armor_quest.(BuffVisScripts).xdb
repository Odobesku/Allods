<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/DisguiseCommon.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_BodyFX</locator>
						<member>Group</member>
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>300</time>
					</Item>
					<Item type="CreatureChangeVisItemsAction">
						<items>
							<Item>
								<slot>ARMOR</slot>
								<newItem href="/Items/VisualItems/Armor/Cloth_E_19CultistMageArmor.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
							</Item>
							<Item>
								<slot>BOOTS</slot>
								<newItem href="/Items/VisualItems/Boots/Cloth_E_19CultistMageBoots.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
							</Item>
							<Item>
								<slot>GLOVES</slot>
								<newItem href="/Items/VisualItems/Gloves/Cloth_E_19CultistMageGloves.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
							</Item>
							<Item>
								<slot>LIFESTYLESUIT</slot>
							</Item>
						</items>
					</Item>
				</elements>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
