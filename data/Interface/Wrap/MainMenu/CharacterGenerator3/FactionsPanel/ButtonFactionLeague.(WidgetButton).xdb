<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Children>
        <Item href="/Interface/Wrap/MainMenu/CharacterGenerator3/FactionsPanel/LeagueFX/PanelFX.(WidgetPanel).xdb#xpointer(/client.Widgets.WidgetPanel)"/>
    </Children>
    <Name>Button</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_LOW</Align>
            <HighPos>25</HighPos>
            <Size>625</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <Pos>-14</Pos>
            <Size>914</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>300</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <pickMask href="/Interface/Wrap/MainMenu/CharacterGenerator3/FactionsPanel/LeaguePickmask.(UISingleTexture).xdb#xpointer(/client.Widgets.UISingleTexture)"/>
    <reactionOnPointing>choose_league_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>false</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_DEFAULT</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag></TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Wrap/MainMenu/CharacterGenerator3/FactionsPanel/LeagueHighlight.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            <PushedOffset x="0" y="0"/>
            <Reaction>choose_league</Reaction>
            <ReactionRightClick>choose_league</ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal/>
            <StatePushed/>
            <StatePushedHighlighted/>
            <reactionDblClick>choose_league_dbl</reactionDblClick>
            <soundPress href="/Interface/Wrap/MainMenu/CharacterGenerator3/FactionsPanel/ButtonLeagueSound.(UIWidgetSound).xdb#xpointer(/client.UIState.UIWidgetSound)"/>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <PushedOffset x="0" y="0"/>
            <Reaction></Reaction>
            <ReactionRightClick></ReactionRightClick>
            <StateDisabled/>
            <StateHighlighted/>
            <StateNormal>
                <LayerMain href="/Interface/Wrap/MainMenu/CharacterGenerator3/FactionsPanel/LeagueSelected.(WidgetLayerSimpleTexture).xdb#xpointer(/client.Widgets.WidgetLayerSimpleTexture)"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <reactionDblClick>choose_league_dbl</reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>false</useDefaultSounds>
</WidgetButton>
