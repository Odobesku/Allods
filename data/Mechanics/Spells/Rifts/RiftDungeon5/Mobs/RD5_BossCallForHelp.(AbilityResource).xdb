<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739948426</resourceId>
	</Header>
	<effects>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.elements.impacts.ImpactMobChat">
					<msg href="RD5_BossCallForHelp_Shout.(TextMessage).xdb" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
									<predicates>
										<Item type="gameMechanics.constructor.basicElements.PredicateNot">
											<predicate type="gameMechanics.elements.predicates.PredicateMobWorld">
												<mobs>
													<Item href="RD5_PatrolMob.(MobWorld).xdb" />
												</mobs>
											</predicate>
										</Item>
									</predicates>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="/Mechanics/Spells/Rifts/Abilities/CombatDetectBuff.(BuffResource).xdb" />
										</Item>
									</impactsIf>
								</Item>
							</impacts>
							<filter type="gameMechanics.constructor.basicElements.FilterAnd">
								<filters>
									<Item type="gameMechanics.world.creature.MobFilter" />
									<Item type="gameMechanics.constructor.basicElements.FilterPredicates">
										<predicates>
											<Item type="gameMechanics.elements.predicates.PredicateFaction">
												<faction href="/World/Factions/Wild.xdb" />
											</Item>
										</predicates>
									</Item>
								</filters>
							</filter>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="/Maps/RiftDungeon5/Scenarios/RD5_BossCallForHelp.(BuffResource).xdb" />
				</Item>
			</onEnter>
			<onLeave>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Maps/RiftDungeon5/Scenarios/RD5_BossCallForHelp.(BuffResource).xdb" />
				</Item>
			</onLeave>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Maps/RiftDungeon5/Scenarios/RD5_BossCallForHelp.(BuffResource).xdb" />
				</Item>
			</impactsOn>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
