<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/Direct.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<FXOnCaster>/Spells/FX/World/GlowBlueComplex.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnCaster>
			<FXWand>/Spells/FX/World/GlowBlueComplex.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXWand>
			<FixPointCaster>true</FixPointCaster>
			<LocatorOnCaster>Slot_Hand_L</LocatorOnCaster>
			<FXOnTargets>/Spells/FX/Spells/HealPuddle.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FXOnTargets>
			<LocatorOnTargets>Slot_Global</LocatorOnTargets>
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedWand</Item>
				</animations>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/World/GlowBlueComplex.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_L</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/World/GlowBlueComplex.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch />
	<charged />
	<playOnTargets>
		<specialAction type="VisActionList">
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/HealPuddle.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<locator var="LocatorOnTargets" />
						</Item>
					</visualEffects>
				</Item>
				<Item skiped="" />
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
