<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739980624</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/RangedAttacks.xdb" />
    </groups>
    <element>ACID</element>
    <Name href="AoEDispell.(SpellSingleTarget).Name.txt" />
    <Description href="AoEDispell.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>MagicScaler</formula>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Debuff.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Engineer/AcidDispell.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <ranks>
        <Item href="AoEDispell01.(SpellSingleTarget).xdb" />
        <Item href="AoEDispell02.(SpellSingleTarget).xdb" />
        <Item href="AoEDispell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.resources.ResourceBuff">
                <buff href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>15</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>ACID</element>
                                <damage>1</damage>
                                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                    <scalers>
                                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                <externalCalcer hrefvar="externalCalcer" />
                                            </mulCalcer>
                                        </Item>
                                    </scalers>
                                </scaler>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.DispelMagic">
                                <magics href="/Mechanics/Spells/Groups/Magics.xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                <mark href="AoEDispellOnTarget.(MarkResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                <data href="AoEDispellVisual.(ClientData).xdb" />
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>30</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>