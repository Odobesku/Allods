    <image href="/Interface/Icons/Misc/Itemmall/IMEpic.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <itemMallDescription href="UniversalUpgraderUncommon60.(ItemResource).ItemMallDescription.txt" />
    <source>FixedDrop</source>
    <descVars>
        <Item>
            <name>varfull</name>
            <text href="UniversalUpgrader60forIM.(ItemResource).Text.txt" />
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                    <rule href="/Mechanics/Rules/FullUniversalUpgrader60.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                </condition>
            </scaler>
        </Item>
        <Item>
            <name>var</name>
            <text href="UniversalUpgrader60forIM.(ItemResource).Text02.txt" />
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                        <rule href="/Mechanics/Rules/FullUniversalUpgrader60.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                    </predicate>
                </condition>
            </scaler>
        </Item>
        <Item>
            <name>uvarfull</name>
            <text href="UniversalUpgrader60forIM.(ItemResource).Text03.txt" />
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                    <rule href="/Mechanics/Rules/FullUniversalUpgrader60.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                </condition>
            </scaler>
        </Item>
        <Item>
            <name>uvar</name>
            <text href="UniversalUpgrader60forIM.(ItemResource).Text04.txt" />
            <scaler type="gameMechanics.elements.scalers.IfTextModifier">
                <condition type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateIsRuleActive">
                        <rule href="/Mechanics/Rules/FullUniversalUpgrader60.(RuleResource).xdb#xpointer(/gameMechanics.world.rules.RuleResource)" />
                    </predicate>
                </condition>
            </scaler>
        </Item>
    </descVars>
    <forceShowQuality>true</forceShowQuality>
    <itemClass href="/Mechanics/ItemClasses/Other.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemClass)" />
    <functionalPart type="itemService.avatar.itemBag.ItemTakeActions">
        <actions>
            <Item type="itemService.avatar.itemBag.GiveItemTakeAction">
                <item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
                    <item href="UniversalUpgraderUncommon60.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
                </item>
                <binding>Transfer</binding>
                <hideChatNotification>true</hideChatNotification>
            </Item>
            <Item type="itemService.avatar.itemBag.GiveAltCurrencyTakeAction">
                <currency href="/Mechanics/AlternativeCurrencies/Astral/Addon5IMUnlock.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                <multiplier>4</multiplier>
            </Item>
        </actions>
        <occupiesSlot>true</occupiesSlot>
    </functionalPart>
    <requiredLevel>10</requiredLevel>
    <stackLimit>100</stackLimit>
    <quality href="/Mechanics/ItemQualities/Legendary.xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemQuality)" />
    <prices type="gameMechanics.constructor.schemes.item.prices.TradableItem">
