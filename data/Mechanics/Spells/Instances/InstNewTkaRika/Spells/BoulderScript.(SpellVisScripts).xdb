<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastDirected</Item>
						</animations>
						<advanced>
							<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
							<offendType>EVERYKEY_OFFEND</offendType>
						</advanced>
					</Item>
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Spells/Lesavka_StoneProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="/Spells/FX/Spells/MagicHitLesavka.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<theGe>3</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_BodyFX</locator>
						</pointOnTarget>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<playWhile />
				<elements>
					<Item type="VisActionDelay">
						<time>350</time>
					</Item>
					<Item type="CreatureEffectsAction">
						<visActionID>hnd01</visActionID>
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/ReadySpellDirectLightningWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<fadeInTime>800</fadeInTime>
								<fadeOutTime>200</fadeOutTime>
								<locator>Slot_Hand_R</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
					<Item type="VisActionDelay">
						<time>850</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>hnd01</stoppedActionID>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
