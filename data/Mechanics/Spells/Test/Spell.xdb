<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/Magics.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/FireSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroupElement)" />
		<Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
		<Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
	<element>FIRE</element>
	<image href="/Interface/Icons/Spells/Mage/FireTrap.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<visualScripts href="/Mechanics/Spells/Mage63/Abilities/FireStar/FireStar.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<level>1</level>
	<prepareDuration>0</prepareDuration>
	<immutablePrepareDuration>false</immutablePrepareDuration>
	<needLos>true</needLos>
	<targetType>STTCurrentTarget</targetType>
	<isAggro>true</isAggro>
	<replaceLowRanks>true</replaceLowRanks>
	<isWorkOnDead>false</isWorkOnDead>
	<ranks>
		<Item href="Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
		<Item href="Spell02.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
		<Item href="Spell03.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<triggersGlobalCooldown>true</triggersGlobalCooldown>
	<ignoreGlobalCooldown>false</ignoreGlobalCooldown>
	<launchWhenReady>false</launchWhenReady>
	<needInFront>true</needInFront>
	<mechanics>
		<cooldown>
			<stage>Launch</stage>
			<duration>1500</duration>
			<group href="" />
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<hideText>false</hideText>
				<buff href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				<anyRank>true</anyRank>
				<consumeStacks>0</consumeStacks>
			</Item>
		</casterConditions>
		<casterResources>
			<Item type="gameMechanics.elements.resources.ResourceIf">
				<hideText>false</hideText>
				<predicates>
					<Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
						<hideText>false</hideText>
						<spell hrefvar="spell" />
						<anyRank>true</anyRank>
					</Item>
				</predicates>
				<resourceIf type="gameMechanics.constructor.basicElements.ResourceUniversal">
					<hideText>false</hideText>
				</resourceIf>
				<resourceElse type="gameMechanics.elements.resources.ResourceVariable">
					<hideText>false</hideText>
					<ability href="" />
					<variable href="/Mechanics/Spells/Mage63/Abilities/ElementalPower/FireVar.(VariableResource).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.VariableResource)" />
					<sub>2</sub>
				</resourceElse>
			</Item>
		</casterResources>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
						<hideText>false</hideText>
						<spell hrefvar="spe_1" />
						<anyRank>true</anyRank>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
						<spell hrefvar="spe_2" />
					</Item>
				</impactsIf>
				<impactsElse>
					<Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellActivate">
						<spell hrefvar="spe_3" />
						<effects>
							<Item type="gameMechanics.elements.effects.EffectsDeferred">
								<delay>10000</delay>
								<delayExtensionMax>0</delayExtensionMax>
								<effects>
									<Item type="gameMechanics.elements.effects.Switch">
										<impactsOn>
											<Item type="gameMechanics.constructor.schemes.spell.spellstate.ImpactSpellDeactivate">
												<spell hrefvar="spe_4" />
											</Item>
										</impactsOn>
										<rerunOnLoad>false</rerunOnLoad>
									</Item>
								</effects>
							</Item>
							<Item type="gameMechanics.elements.effects.Switch">
								<impactsOff>
									<Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
										<spell href="/Mechanics/Spells/Mage63/Abilities/FireStar/FireStar01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
										<duration>45000</duration>
									</Item>
								</impactsOff>
								<rerunOnLoad>false</rerunOnLoad>
							</Item>
						</effects>
					</Item>
				</impactsElse>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
				<predicates>
					<Item type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
						<hideText>false</hideText>
						<spell hrefvar="spe_5" />
						<anyRank>true</anyRank>
					</Item>
				</predicates>
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactsIf">
						<predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
							<hideText>false</hideText>
							<buff href="/Mechanics/Spells/Mage63/Abilities/FireStar/FireStar.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							<anyRank>true</anyRank>
						</predicate>
						<impactsIf>
							<Item type="gameMechanics.elements.impacts.BuffDetacher">
								<buff href="/Mechanics/Spells/Mage63/Abilities/FireStar/FireStar.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								<casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
								<anyRank>true</anyRank>
								<allowOverrideCaster>false</allowOverrideCaster>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
								<radius>15</radius>
								<affectGroup>Enemies</affectGroup>
								<affectHolder>true</affectHolder>
								<impacts>
									<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
										<impacts>
											<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
												<element>FIRE</element>
												<threatMultiplier>1</threatMultiplier>
												<forceAE>true</forceAE>
												<offends>true</offends>
												<damage var="damage" />
												<impactsOnHitTarget>
													<Item type="gameMechanics.elements.impacts.RandomImpact">
														<entries>
															<Item>
																<chance>1</chance>
															</Item>
															<Item>
																<impacts>
																	<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																		<buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Cowardice/Cowardice.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
																		<allowOverrideCaster>false</allowOverrideCaster>
																		<durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
																			<mul>1</mul>
																			<mulCalcer type="gameMechanics.elements.calcers.SpellRankCalcer">
																				<spell href="/Mechanics/Spells/Mage63/Abilities/FireStar/FireStar01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
																				<mul>0.5</mul>
																				<sum>0</sum>
																			</mulCalcer>
																			<sum>0</sum>
																		</durationScaler>
																	</Item>
																</impacts>
																<chance>1</chance>
															</Item>
															<Item>
																<impacts>
																	<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																		<buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Vulnerability/Vulnerability.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
																		<allowOverrideCaster>false</allowOverrideCaster>
																		<durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
																			<mul>1</mul>
																			<mulCalcer type="gameMechanics.elements.calcers.SpellRankCalcer">
																				<spell href="/Mechanics/Spells/Mage63/Abilities/FireStar/FireStar01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
																				<mul>0.5</mul>
																				<sum>0</sum>
																			</mulCalcer>
																			<sum>0</sum>
																		</durationScaler>
																	</Item>
																</impacts>
																<chance>1</chance>
															</Item>
														</entries>
													</Item>
												</impactsOnHitTarget>
											</Item>
										</impacts>
										<groupRepeaters>false</groupRepeaters>
									</Item>
								</impacts>
								<filter type="gameMechanics.world.creature.AliveFilter">
									<alowImmortal>true</alowImmortal>
								</filter>
								<targetsLimit>0</targetsLimit>
								<minTargetsCount>0</minTargetsCount>
								<perTargetScaling>Copy</perTargetScaling>
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactClientData">
								<data href="/Mechanics/Spells/Mage63/Abilities/FireStar/FireStarHit.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
							</Item>
						</impactsIf>
					</Item>
					<Item type="gameMechanics.elements.impacts.ReturningImpact">
						<impacts>
							<Item type="gameMechanics.elements.impacts.PureHeal">
								<heal var="heal" />
								<threatMultiplier>1</threatMultiplier>
								<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
									<mul>1</mul>
									<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
										<multiplier>1</multiplier>
									</mulCalcer>
									<sum>0</sum>
								</scalerTarget>
							</Item>
						</impacts>
					</Item>
				</impacts>
				<elseImpacts>
					<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
						<buff href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						<allowOverrideCaster>false</allowOverrideCaster>
						<durationScaler type="gameMechanics.elements.scalers.LinearScaler">
							<multiplier var="multiplier" />
						</durationScaler>
					</Item>
				</elseImpacts>
			</Item>
		</targetImpacts>
		<linkedAbility href="/Mechanics/Spells/Mage63/Abilities/FireStar/FireStar.(AbilityResource).xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
	</mechanics>
	<speed>0</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
