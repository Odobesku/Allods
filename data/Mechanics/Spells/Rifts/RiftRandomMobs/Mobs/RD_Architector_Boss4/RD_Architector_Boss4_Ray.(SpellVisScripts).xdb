<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>channelCastDirected</Item>
                </animations>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Mobs/MountTank_Channel.(VisObjectTemplate).xdb" />
                <fxLength>20</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>Slot_Mouth</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </endPoint>
                <velocity>40</velocity>
            </Item>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Mobs/MountOrcTkarika_Head_Lightning.(VisObjectTemplate).xdb" />
                        <scale>4</scale>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </actionBarStart>
</SpellVisScripts>