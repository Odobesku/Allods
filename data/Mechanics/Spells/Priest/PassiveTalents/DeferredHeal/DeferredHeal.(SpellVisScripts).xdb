<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>instantSpellCastOmniWand</Item>
                </animations>
                <channel>CHANNEL_ABILITY</channel>
                <advanced>
                    <backgroundAfterFirstKey>true</backgroundAfterFirstKey>
                    <changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
                    <channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
                </advanced>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/ReadySpellDirectHolyWand_Cast.(VisObjectTemplate).xdb" />
                        <locator>Wand_Slot_FX</locator>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>