<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>214685</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.IncomingHealModifier">
            <priority>Multiplier</priority>
            <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                <coeff>1</coeff>
                <calcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer hrefvar="externalCalcer" />
                </calcer>
            </scaler>
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateOffenderIsCaster" />
            </predicates>
        </Item>
    </effects>
    <duration>3000</duration>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>