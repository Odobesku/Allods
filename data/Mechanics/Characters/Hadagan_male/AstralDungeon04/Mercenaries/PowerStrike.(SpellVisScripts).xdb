<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>battleRoarInstant</Item>
					<Item>ready2HL</Item>
				</animations>
				<advanced>
					<speed>1.25</speed>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>2000</time>
				</playWhile>
				<elements>
					<Item type="CreatureLockRotationAction" />
				</elements>
			</Item>
			<Item type="CreatureEnchantWeaponAction">
				<enchant href="/Spells/FX/InterfaceFX/MeleeRed.(EnchantTemplate).xdb" />
			</Item>
			<Item type="CreatureTrailAction">
				<lengthMSec>4000</lengthMSec>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Spells/PocketSpellFire01.(VisObjectTemplate).xdb" />
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
						<locator>Slot_Hand_R</locator>
						<offset y="-0.5" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/WarriorCrueltyAbility.(VisObjectTemplate).xdb" />
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
			<Item type="CreatureHoldWeaponAction" />
			<Item type="CreatureLockRotationAction" />
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>specialAttack2HL</Item>
				</animations>
				<advanced>
					<animationKeysAction>
						<Item>
							<action type="VisActionList">
								<play>Simultaneously</play>
								<elements>
									<Item type="CreatureEffectsAction">
										<visualEffects>
											<Item>
												<fadeInTime>500</fadeInTime>
												<fadeOutTime>500</fadeOutTime>
												<locator>Slot_Hand_R</locator>
												<offendTime type="EffectOffendConstDelay" />
											</Item>
										</visualEffects>
									</Item>
								</elements>
							</action>
						</Item>
					</animationKeysAction>
				</advanced>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
