		<mountLocators>
			<Item>Slot_FX</Item>
			<Item>Slot_Global</Item>
			<Item>Global</Item>
		</mountLocators>
	</fxSettings>
	<hiddenDressSlots>
		<Item>CLOAK</Item>
	</hiddenDressSlots>
	<jumpSettings>
		<jumpMinVelocity>6</jumpMinVelocity>
		<specialJump href="SpecialJump.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
		<specialJumpPause>4100</specialJumpPause>
		<useJump>RUN_FORWARD</useJump>
	</jumpSettings>
	<levelChangedScript href="/Spells/VisScripts/Commands/LevelUp_Mount.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<pitchParameters>
		<maxPitch>20</maxPitch>
		<minStepDeltaT>150</minStepDeltaT>
		<minStepDeltaTMainAvatar>20</minStepDeltaTMainAvatar>
		<minTurnRadius>8</minTurnRadius>
		<minVelocity>6</minVelocity>
		<minVelocityPitch>1</minVelocityPitch>
		<pitchMaxVelocity>40</pitchMaxVelocity>
		<topVelocity>15</topVelocity>
		<topVelocityPitch>15</topVelocityPitch>
	</pitchParameters>
	<reinsSettings>
		<disablingAnimations href="Horse/DisableReins.(CharacterAnimationsGroup).xdb#xpointer(/CharacterAnimationsGroup)" />
		<handBone>Slot_Hand_L</handBone>
		<handBone01>Slot_Hand_L</handBone01>
		<member>Assaulter</member>
		<reinsBone>Slot_Reins</reinsBone>
		<reinsBone01>Slot_Reins</reinsBone01>
		<use>true</use>
	</reinsSettings>
	<riderOrientation>Yaw_FromMountSlot</riderOrientation>
	<sitAnimation>mountRideSit</sitAnimation>
	<skinChangedScript href="/Spells/VisScripts/Commands/ChangeSkin.(CreatureVisActionResource).xdb#xpointer(/CreatureVisActionResource)" />
	<summonVisualScript href="/Spells/VisScripts/Mount/SummonCommonHorse.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<nonDismountable>false</nonDismountable>
	<useRiderSpineTurn>true</useRiderSpineTurn>
