<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739879241</resourceId>
	</Header>
	<Name href="Heal_spell.(SpellSingleTarget).Name.txt" />
	<visualScripts href="/Spells/VisScripts/Priest/Forehealing.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<prepareDuration>2000</prepareDuration>
	<iffPolicy>Friends</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>10000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="HealRule_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</predicate>
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
				<mobs>
					<Item href="SnowWarchief.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
				</mobs>
			</Item>
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.DirectHeal">
				<heal>1</heal>
				<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
					<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
						<multiplier>0.1</multiplier>
					</mulCalcer>
				</scalerTarget>
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
