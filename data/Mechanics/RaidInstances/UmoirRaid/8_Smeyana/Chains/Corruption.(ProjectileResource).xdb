<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739874064</resourceId>
    </Header>
    <name href="Corruption.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Mobs/SarnAngelUmoir_DarkProjectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <speed>0.004</speed>
    <lifeLengthCap>40000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <affectGroup>All</affectGroup>
            <radius>3</radius>
            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                <filters>
                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                    <Item type="gameMechanics.world.creature.AliveFilter" />
                </filters>
            </filter>
            <blinking>true</blinking>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="CorruptionStackKiller.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.PureDamage">
                    <damage>1</damage>
                    <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.15</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
            </impactsIn>
            <holderImpactsIn>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </holderImpactsIn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>