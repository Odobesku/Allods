    <image href="/Interface/Ingame/Lottery/Textures/Numerals/Num2.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                    <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                        <range min="0" max="1" />
                        <withinRange>false</withinRange>
                        <minCandidatesCount>1</minCandidatesCount>
                        <targetCount>1</targetCount>
                    </selector>
                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                        <filters>
                            <Item type="gameMechanics.world.creature.AvatarFilter" />
                            <Item type="gameMechanics.world.creature.AliveFilter" />
                            <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="YakBoss/LightningSphere/LightningSphereTarget.(BuffResource).xdb" />
                                        </predicate>
                                    </Item>
                                </predicates>
                            </Item>
                        </filters>
                    </filter>
                    <impacts>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                            <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                                <base type="gameMechanics.map.destination.SelfPosDestination" />
                                                <offset>8</offset>
                                            </destination>
                                            <impacts>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="YakBoss/PursuitingSphere/ForcedAggro.(BuffResource).xdb" />
                                                </Item>
                                            </impacts>
                                            <traceDown>true</traceDown>
                                            <object href="PursuitingSphere/PursuitingSphere.(MobWorld).xdb" />
                                            <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>12000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOnStrike">
            <impactsToTarget>
