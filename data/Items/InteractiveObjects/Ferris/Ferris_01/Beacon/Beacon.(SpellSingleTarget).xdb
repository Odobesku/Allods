<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739882403</resourceId>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
	</groups>
	<visualScripts href="/Items/InteractiveObjects/Templates/Gather.(ExploitVisScripts).xdb#xpointer(/SpellVisScripts)" />
	<isExploit>true</isExploit>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>5</value>
	</range>
	<prepareDuration>3000</prepareDuration>
	<targetType>STTCurrentTargetNotSelf</targetType>
	<isAggro>false</isAggro>
	<iffPolicy>Everyone</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateQuestCounterNotLess">
					<quest href="/World/Quests/Ferris01/Ferris_1_2/Ferris_1_2.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
					<counterResource href="/Items/QuestItems/Ferris/Ferris01/Beacon/Beacon.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
				</predicate>
			</Item>
			<Item type="gameMechanics.elements.predicates.PredicateCanTake">
				<item href="/Items/QuestItems/Ferris/Ferris01/Beacon/Beacon.(ItemResource).xdb#xpointer(/gameMechanics.constructor.schemes.item.ItemResource)" />
			</Item>
		</casterConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.device.DeviceOpenLootBag" />
			<Item type="gameMechanics.elements.device.DeviceDie" />
		</targetImpacts>
	</mechanics>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
