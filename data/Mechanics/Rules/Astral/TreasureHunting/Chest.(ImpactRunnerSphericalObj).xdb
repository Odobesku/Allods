<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.astralTeleports.ImpactRunnerSphericalObj>
    <Header>
        <resourceId>282492952</resourceId>
    </Header>
    <parts>
        <Item type="VisEntityVisualizer">
            <visObj href="/Spells/FX/Ships/AstralAnomalyChestSarnFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <scale>15</scale>
        </Item>
        <Item type="AstralHubObjectPart">
            <name href="Chest_Name.txt" />
            <description href="Chest_Desc.txt" />
            <image href="/Interface/Ingame/ContextAstralMap/AstralHubMark/Wreckage.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
        </Item>
        <Item type="PositionSynchronizer" />
    </parts>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectAstralPerimeterCollision">
            <radius>50</radius>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                    <buff href="BuffChestOnShip.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    <range>
                                        <max>4</max>
                                    </range>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="BuffChestOnShip.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                    <impactsResource href="ChestRespawnInSector.(ImpactListGenericResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impactsIn>
            <impactsOnSelfIn>
                <Item type="gameMechanics.world.bigAstral.ImpactStopObjectSpawn" />
            </impactsOnSelfIn>
        </Item>
    </effects>
</gameMechanics.world.astralTeleports.ImpactRunnerSphericalObj>