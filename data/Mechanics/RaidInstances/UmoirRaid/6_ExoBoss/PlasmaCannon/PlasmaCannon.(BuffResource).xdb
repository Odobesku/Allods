<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>225686</resourceId>
    </Header>
    <Name href="PlasmaCannon.(BuffResource).Name.txt" />
    <Description href="PlasmaCannon.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffURConnectionLine.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.SpreadModifier">
                                        <verticalRange min="1" max="1" />
                                        <horizontalRange min="0" max="0" />
                                    </Item>
                                    <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                                </modifiers>
                            </destination>
                        </moveType>
                        <resource href="PlasmaPool.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                </Item>
            </impacts>
            <tick>1000</tick>
            <initialDelay>1000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="PlasmaScaler.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="PlasmaCannon.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine">
                    <impactsIn type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine$ImpactsPack">
                        <impactsFromCaster>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                        <element>HOLY</element>
                                        <damage>10</damage>
                                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                            <scalers>
                                                <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                    <mul>0.5</mul>
                                                    <mulCalcer type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                                        <buff href="PlasmaScaler.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                        <forAllRanks>true</forAllRanks>
                                                    </mulCalcer>
                                                    <sum>1</sum>
                                                </Item>
                                            </scalers>
                                        </scaler>
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="PlasmaRay.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impactsFromCaster>
                    </impactsIn>
                    <impactsOut type="gameMechanics.elements.effects.triggerLine.EffectTriggerLine$ImpactsPack">
                        <impactsFromCaster>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                        <buff href="PlasmaRay.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impactsFromCaster>
                    </impactsOut>
                    <maxLength>130</maxLength>
                    <reconnect>true</reconnect>
                    <height>8</height>
                    <width>3</width>
                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                </Item>
            </effects>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/RaidInstances/UmoirRaid/UmoirRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>