<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/MageAstralAegis_Buff.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>2</scale>
                        <locator>Slot_FX</locator>
                    </Item>
                </visualEffects>
            </Item>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <delay>2500</delay>
                        <effectFx href="/Spells/FX/Spells/EvilEye_PhysicalImmunity.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <scale>2</scale>
                        <fadeInTime>500</fadeInTime>
                        <locator>Slot_FX</locator>
                        <useVisObjectSettings>FROM_TARGET</useVisObjectSettings>
                    </Item>
                </visualEffects>
            </Item>
        </elements>
        <stopOnDeath>true</stopOnDeath>
        <stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
    </action>
    <postAction type="CreatureEffectsAction">
        <visualEffects>
            <Item>
                <effectFx href="/Spells/FX/Spells/MageAstralAegis_BuffOff.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <scale>2</scale>
                <locator>Slot_FX</locator>
            </Item>
        </visualEffects>
        <stopOnDeath>true</stopOnDeath>
    </postAction>
</BuffVisScripts>