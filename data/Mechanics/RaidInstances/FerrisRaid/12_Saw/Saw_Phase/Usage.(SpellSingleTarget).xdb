<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>223071</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <contextActionInfo>
        <contextName href="Obj_Wardrobe.(SpellSingleTarget).ContextName.txt" />
        <contextDescription href="Obj_Wardrobe.(SpellSingleTarget).ContextDescription.txt" />
        <contextImage href="" />
    </contextActionInfo>
    <groups>
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/Events/EventSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="Obj_Wardrobe.(SpellSingleTarget).ContextName.txt" />
    <Description href="Obj_Wardrobe.(SpellSingleTarget).ContextDescription.txt" />
    <visualScripts href="/Spells/VisScripts/Common/Use.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>3</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <needLos>false</needLos>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff hrefvar="buff" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff hrefvar="buff" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Phase_Counter.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <impactsOnAttach>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                        <buff href="Phase_Counter.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <range>
                                            <min>1</min>
                                            <max>4</max>
                                        </range>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.basicElements.ImpactList">
                                        <impactsResource href="Right.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                                    </Item>
                                </impactsIf>
                            </Item>
                        </impactsOnAttach>
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.TargetDistributor" />
                        <data href="Wrong.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStunNoCC.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>5</multiplier>
                        </durationScaler>
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>