<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739925362</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="WrathGainShield.(AbilityResource).Name.txt" />
    <description href="WrathGainShield.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>heal</name>
            <value var="heal" />
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>370</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                            <summands>
                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                            <element>EPHYSICAL</element>
                                        </stat>
                                    </value>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                            <element>ENATURE</element>
                                        </stat>
                                    </value>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                            <element>EDIVINE</element>
                                        </stat>
                                    </value>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                            <element>EELEMENTAL</element>
                                        </stat>
                                    </value>
                                </Item>
                            </summands>
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                </scalers>
            </scaler>
        </Item>
        <Item>
            <name>dmg</name>
            <value var="dmg" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Warrior/WarriorShieldBlock.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
                    <mark href="/Mechanics/Spells/Paladin63/Spells/Wrath/WrathSelfMark.(MarkResource).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.effects.ImpactHealDamageThreshold">
                            <heal var="heal" />
                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mul>370</mul>
                                        <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                                            <summands>
                                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                                            <element>EPHYSICAL</element>
                                                        </stat>
                                                    </value>
                                                </Item>
                                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                                            <element>ENATURE</element>
                                                        </stat>
                                                    </value>
                                                </Item>
                                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                                            <element>EDIVINE</element>
                                                        </stat>
                                                    </value>
                                                </Item>
                                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                                    <value type="gameMechanics.elements.calcers.StatCalcer">
                                                        <stat type="gameMechanics.elements.stat.StatResistance">
                                                            <element>EELEMENTAL</element>
                                                        </stat>
                                                    </value>
                                                </Item>
                                            </summands>
                                        </mulCalcer>
                                    </Item>
                                </scalers>
                            </scaler>
                            <resource href="/Mechanics/Spells/CommonEffects/CommonClass_Full_Threshold.(DamageThresholdResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.effects.SpellsModifier">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Mechanics/Spells/Paladin63/Spells/Wrath/Wrath01.(SpellSingleTarget).xdb" />
                                <Item href="/Mechanics/Spells/Paladin63/Spells/WrathUpgrade/WrathUpgrade01.(SpellSingleTarget).xdb" />
                            </spells>
                        </Item>
                    </predicates>
                    <modifiers>
                        <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                            <effects>
                                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                                        <coeff var="dmg" />
                                    </scaler>
                                </Item>
                            </effects>
                            <onBehalfOfHolder>true</onBehalfOfHolder>
                        </Item>
                    </modifiers>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="WrathGainShield01.(AbilityResource).xdb" />
        <Item href="WrathGainShield02.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>