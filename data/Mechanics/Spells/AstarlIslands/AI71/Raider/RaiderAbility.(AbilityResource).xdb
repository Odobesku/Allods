<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739935045</resourceId>
    </Header>
    <name href="RaiderAbility.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.RandomImpactGeneric">
                    <entries>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="0_HadaganMale.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <chance>100</chance>
                        </Item>
                        <Item>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="1_KaniaMale.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <chance>100</chance>
                        </Item>
                    </entries>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectsDeferred">
                    <delay>3000</delay>
                    <delayExtensionMax>3000</delayExtensionMax>
                    <effects>
                        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                    <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                        <range min="0" max="1" />
                                        <withinRange>false</withinRange>
                                        <minCandidatesCount>1</minCandidatesCount>
                                        <targetCount>1</targetCount>
                                    </selector>
                                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                        <predicates>
                                            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                                <predicates>
                                                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                                    </Item>
                                                </predicates>
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                        </predicates>
                                    </filter>
                                    <impacts>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                                    <projectileData>
                                                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                                                        <resource href="Dynamite.(ProjectileResource).xdb" />
                                                                    </projectileData>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <tick>10000</tick>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Mechanics/Spells/AstarlIslands/AI71/Common/RestrictRotationAndMovement.(BuffResource).xdb" />
                        </Item>
