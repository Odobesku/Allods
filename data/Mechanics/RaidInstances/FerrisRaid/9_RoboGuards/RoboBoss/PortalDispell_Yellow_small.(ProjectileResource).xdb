<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>222070</resourceId>
    </Header>
    <name href="PortalDispell_Yellow_small.(ProjectileResource).Name.txt" />
    <visObject href="Portal_yellow_small.(VisObjectTemplate).xdb" />
    <altitude>-0.02</altitude>
    <lifeLengthCap>5000</lifeLengthCap>
    <impactsOnDeath>
        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
            <radius>3</radius>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="PortalDispell_Permission.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="PortalKiller_Permission.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="PortalShield_Permission.(BuffResource).xdb" />
                            </predicate>
                        </Item>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="TeleportUp.(ClientData).xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsToSummonPoolGeneric">
                                    <pool href="PortalSpecial.(SummonPool).xdb" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
                                                    <resources>
                                                        <Item href="PortalDispell_yellow.(SteleResource).xdb" />
                                                        <Item href="PortalChain_Yellow.(SteleResource).xdb" />
                                                    </resources>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpactGeneric">
                                                    <impacts>
                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                            <buff href="PortalDispell_Permission.(BuffResource).xdb" />
                                                        </Item>
                                                        <Item type="gameMechanics.elements.impacts.ImpactTeleport">
                                                            <destination type="gameMechanics.map.destination.DestinationLocatorSpread">
                                                                <locator>
                                                                    <scriptID>FR_9_PS</scriptID>
                                                                    <map href="/Maps/FerrisRaid/MapResource.xdb" />
                                                                </locator>
                                                                <horizontalSpread>3</horizontalSpread>
                                                            </destination>
                                                            <finishImpacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                                                    <data href="TeleportEnd.(ClientData).xdb" />
                                                                </Item>
                                                            </finishImpacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <impactsOnNoTargets>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impactsOnNoTargets>
            <finishImpacts>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </finishImpacts>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
        </Item>
    </impactsOnDeath>
    <effects>
        <Item type="gameMechanics.elements.effects.TickableEntityAura">
            <affectGroup>All</affectGroup>
            <radius>3</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="InPortal.(BuffResource).xdb" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="InPortal.(BuffResource).xdb" />
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>4000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactSummonGeneric">
                                    <destination type="gameMechanics.map.destination.DestinationModified">
                                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                        <modifiers>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierTraceDown" />
                                        </modifiers>
                                    </destination>
                                    <object href="Portal_yellow_small_death.(ProjectileResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>