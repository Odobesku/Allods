<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739913401</resourceId>
	</Header>
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectInstantiating">
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
							<time>500</time>
							<impactsOnLand>
								<Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
									<spawn>
										<scriptID>15_GeneralBoss</scriptID>
										<map href="/Maps/FerrisRaid/MapResource.xdb" />
									</spawn>
									<impacts>
										<Item type="gameMechanics.elements.impacts.StackBuff">
											<buff href="SpheresDownCount.(BuffResource).xdb" />
											<delta type="gameMechanics.elements.calcers.FloatData">
												<value>-1</value>
											</delta>
										</Item>
									</impacts>
								</Item>
							</impactsOnLand>
							<destination type="gameMechanics.map.destination.RelativeRotatePos">
								<base type="gameMechanics.map.destination.DestinationLocator">
									<locator>
										<scriptID>FR15_Center</scriptID>
										<map href="/Maps/FerrisRaid/MapResource.xdb" />
									</locator>
								</base>
								<offset>4</offset>
							</destination>
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="MovingIgnore.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="DisableMovement.(BuffResource).xdb" />
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
