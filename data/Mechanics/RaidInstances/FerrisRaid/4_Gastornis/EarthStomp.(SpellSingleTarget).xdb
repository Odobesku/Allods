<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>222602</resourceId>
    </Header>
    <Name href="EarthStomp.(SpellSingleTarget).Name.txt" />
    <visualScripts href="EarthStomp.(SpellVisScripts).xdb" />
    <prepareDuration>2500</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>17999</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                        </predicate>
                    </Item>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="GastornisP2.(BuffResource).xdb" />
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                <selector type="gameMechanics.tools.SelectorShuffle" />
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                    </predicates>
                </filter>
                <impacts>
                    <Item>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                                <predicates>
                                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                    </Item>
                                </predicates>
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStunNoCC.xdb" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>4</multiplier>
                                        </durationScaler>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                        <minDamage>10</minDamage>
                                        <maxDamage>14</maxDamage>
                                    </Item>
                                </impacts>
                                <elseImpacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BufffKnockDownNoCC.xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                                        <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                                        <minDamage>9</minDamage>
                                        <maxDamage>13</maxDamage>
                                    </Item>
                                </elseImpacts>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>