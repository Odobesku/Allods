<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <elements>
            <Item type="WeatherCreatureVisAction">
                <params>
                    <skyMesh href="/World/Sky/AI52_BossFight.(SkyMesh).xdb#xpointer(/SkyMesh)" />
                    <light>
                        <FogStart>0</FogStart>
                        <FogEnd>270</FogEnd>
                        <SunLightYaw>180</SunLightYaw>
                        <SunLightPitch>45</SunLightPitch>
                        <AmbientColor>-6181930</AmbientColor>
                        <SelfIllumColor>-1774114</SelfIllumColor>
                        <animatedDiffuseColor href="/Maps/AstralIsle52/ZoneLights/AI52_Hills_Diffuse.(AnimatedLight).xdb#xpointer(/AnimatedLight)" />
                        <DiffuseColor>-14208456</DiffuseColor>
                        <PointLightColor>-2294322</PointLightColor>
                        <FogColor>-16644594</FogColor>
                        <SpecularColor>4149952</SpecularColor>
                        <ContourColor>-8296297</ContourColor>
                        <SpecularWaterColor>2443600</SpecularWaterColor>
                        <WaterGradientStart>-16579313</WaterGradientStart>
                        <WaterGradientEnd>-16709618</WaterGradientEnd>
                        <TerrainSpecularColor>-15658480</TerrainSpecularColor>
                        <TerrainContourColor>-16643826</TerrainContourColor>
                        <TerrainContourPower>7</TerrainContourPower>
                        <desaturation>0.9</desaturation>
                    </light>
                    <postEffectParams href="AI52_BossFight.(PostEffectParams).xdb#xpointer(/PostEffectParams)" />
                    <priority>MEDIUM</priority>
                    <fadeTime>3</fadeTime>
                    <hasLight>true</hasLight>
                </params>
            </Item>
            <Item type="PostEffectVisAction">
                <userPostEffect href="BossFight.(UserPostEffect).xdb#xpointer(/UserPostEffect)" />
            </Item>
            <Item type="Sound2DAction">
                <sound>
                    <project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/FMODProject)" />
                    <name>Ambience/OutdoorAmbience/Zones/AI52_GhostWorld</name>
                </sound>
                <forcedSoundStop>true</forcedSoundStop>
                <actionType>AmbientOutdoor</actionType>
                <reverbPreset>
                    <project href="/SFX/Ambience/Ambience.(FMODProject).xdb#xpointer(/FMODProject)" />
                    <name>ghost</name>
                </reverbPreset>
            </Item>
            <Item type="Sound2DAction">
                <forcedSoundStop>true</forcedSoundStop>
                <actionType>GlobalParams</actionType>
                <musicSourceParameters>
                    <Item>
                        <parameter href="AI52_GhostWorld_volume.(SoundParameter).xdb#xpointer(/SoundParameter)" />
                        <value>0.9</value>
                    </Item>
                </musicSourceParameters>
            </Item>
            <Item type="Sound2DAction">
                <sound>
                    <project href="/SFX/World/World.(FMODProject).xdb#xpointer(/FMODProject)" />
                    <name>World/Zones/AI52/Necromancer_Whisper</name>
