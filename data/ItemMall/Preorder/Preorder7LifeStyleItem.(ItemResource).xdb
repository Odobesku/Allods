<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.item.ItemResource>
    <Header>
        <resourceId>739949620</resourceId>
    </Header>
    <actionGroupsBonuses />
    <image href="/Interface/Icons/Misc/Food/FoodPet01.(UISingleTexture).xdb" />
    <statuses />
    <source>Vendor</source>
    <dressSet />
    <descVars />
    <extraDescParts />
    <lifestyleCollection href="/Client/GMUIHelper/Lifestyle/ItemMall/Pets.(LifestyleCollection).xdb" />
    <lifestylePredicates />
    <slot>LIFESTYLEPET</slot>
    <itemClass href="/Mechanics/ItemClasses/LifeStyle.xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMounted">
                                    <specificGroup href="/Mechanics/Mounts/Groups/ExoMounts.(MountGroupResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateMounted" />
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.MassBuffDetacher">
                            <predicates>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                                    <groups>
                                        <Item href="/Mechanics/Spells/Groups/ClientPet.(ActionGroup).xdb" />
                                    </groups>
                                </Item>
                            </predicates>
                            <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
                            <impactsOnHolder />
                            <impactsOnBuffCaster />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="/Items/VisualItems/Pet/ClientPet01.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Items/VisualItems/Pet/ClientPetWatcher01.(BuffResource).xdb" />
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Items/VisualItems/Pet/ClientPet01.(BuffResource).xdb" />
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.BuffInterceptor">
            <impactsOnAttach>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="/Items/VisualItems/Pet/ClientPet01.(BuffResource).xdb" />
                </Item>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="/Items/VisualItems/Pet/ClientPetWatcher01.(BuffResource).xdb" />
                    <impactsOnAttach />
                    <impactsOnFail />
                </Item>
            </impactsOnAttach>
            <impactsOnDetach>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="/Items/VisualItems/Pet/ClientPetWatcher01.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="/Items/VisualItems/Pet/ClientPet01.(BuffResource).xdb" />
                            <impactsOnAttach />
                            <impactsOnFail />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="/Items/VisualItems/Pet/ClientPetWatcher01.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                    <impactsElse />
                </Item>
            </impactsOnDetach>
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffEquals">
                    <buff href="/Mechanics/GameRoot/Mount/MountBuff.xdb" />
                </Item>
            </predicates>
        </Item>
    </effects>
    <level>4</level>
    <requiredLevel>4</requiredLevel>
    <quality href="/Mechanics/ItemQualities/Rare.xdb" />
    <prices type="gameMechanics.constructor.schemes.item.prices.UntradableItem" />
    <binding>BindOnPickup</binding>
    <itemMallType>ITEMMALLABLE</itemMallType>
    <name href="/ItemMall/Preorder/Preorder7BuffItem.(ItemResource).Name.txt" />
    <description href="/ItemMall/Preorder/Preorder7BuffItem.(ItemResource).Description.txt" />
    <category href="/Mechanics/ItemCategories/Consumables/Other.xdb" />
    <calcers />
    <names />
</gameMechanics.constructor.schemes.item.ItemResource>