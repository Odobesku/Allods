<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739859225</resourceId>
	</Header>
	<visObject href="/Spells/FX/Spells/HealPuddle.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<lifeLengthCap>12000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
					<radius>4</radius>
					<affectGroup>Enemies</affectGroup>
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="PiratePoison.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="PirateHit01.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
					<projectileData>
						<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
							<destination type="gameMechanics.map.destination.RelativePos">
								<coord y="1" />
							</destination>
						</moveType>
						<resource href="PirateGood_Mark.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
					</projectileData>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EntityImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.EntityImpactEntitiesAround">
					<radius>4</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
									<resources>
										<Item href="PirateProjectillePoison.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
									</resources>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
