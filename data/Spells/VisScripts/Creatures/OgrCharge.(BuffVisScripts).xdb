<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureReplaceAnimationsAction">
				<onTop>
					<animationsReplacements>
						<Item>
							<play>runCharge</play>
							<forAnimations>
								<Item>run</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onTop>
				<onBottom>
					<animationsReplacements>
						<Item>
							<play>runCharge</play>
							<forAnimations>
								<Item>run</Item>
							</forAnimations>
						</Item>
					</animationsReplacements>
				</onBottom>
				<member>Mount</member>
				<slots />
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/MountOrc_RunChargeFakeDust.(VisObjectTemplate).xdb" />
						<scale>1.2</scale>
						<member>Mount</member>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/OrgeCannonMountHasteTrail.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<locator>Slot_FX</locator>
						<member>Mount</member>
						<offendTime />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/PaladinBladeofJusticeAbility_StartSmoke.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<fixPoint>true</fixPoint>
						<member>Mount</member>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</action>
</BuffVisScripts>
