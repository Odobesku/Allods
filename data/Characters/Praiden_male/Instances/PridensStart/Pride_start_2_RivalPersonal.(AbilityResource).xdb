<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>85138</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="/World/Quests/Inst_PridensStart/Pride_start_2/Pride_start_2_RivalPersonalPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>5000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>10000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impactsIf>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>