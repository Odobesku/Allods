<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739950398</resourceId>
	</Header>
	<Name href="CarrierIsCarrying3.(BuffResource).Name.txt" />
	<Description href="CarrierIsCarrying3.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Misc/Event/HoldingStone.(UISingleTexture).xdb" />
	<visScript href="Carrying_stone.(BuffVisScripts).xdb" />
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.EventTrigger">
			<eventClasses>
				<Item>gameMechanics.world.mob.behaviour.aiEvents.GoneThroughPathEvent</Item>
			</eventClasses>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
							<id href="Counter6.(QuestCountId).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="CrabVis.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.Disintegrate" />
			</impacts>
			<eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
		</Item>
		<Item type="gameMechanics.elements.effects.TickableAura">
			<affectGroup>All</affectGroup>
			<radius>30</radius>
			<filter type="gameMechanics.world.creature.AvatarFilter" />
			<conditions>
				<Item type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
					<predicate type="gameMechanics.elements.predicates.PredicateNotMaster" />
				</Item>
			</conditions>
			<holderImpactsIn>
				<Item type="gameMechanics.elements.impacts.BuffDetacher">
					<buff href="StopMovement.(BuffResource).xdb" />
				</Item>
			</holderImpactsIn>
			<holderImpactsOut>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="StopMovement.(BuffResource).xdb" />
				</Item>
			</holderImpactsOut>
		</Item>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
					<predicates>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="StopMovement.(BuffResource).xdb" />
							</predicate>
						</Item>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="Motivation.(BuffResource).xdb" />
							</predicate>
						</Item>
						<Item type="gameMechanics.constructor.basicElements.PredicateNot">
							<predicate type="gameMechanics.elements.resources.ResourceBuff">
								<buff href="Tired.(BuffResource).xdb" />
							</predicate>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
							<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
								<value>0.4</value>
							</chanceCalcer>
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Tired.(BuffResource).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
									<data href="CrabTired.(ClientData).xdb" />
								</Item>
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impacts>
			<tick>5000</tick>
			<initialDelay>5000</initialDelay>
		</Item>
		<Item type="gameMechanics.elements.effects.AddPlane">
			<plane href="Crab.(Plane).xdb" />
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
