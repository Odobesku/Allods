                                    <affectGroup>Friends</affectGroup>
                                    <affectHolder>false</affectHolder>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                                    <mobs>
                                                        <Item href="/Creatures/Snake/Cobra/Instances/AstralIsle19/ZemCobraSummon.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                        <Item href="/Creatures/Snake/Cobra/Instances/AstralIsle19/MegaCobra.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                                    </mobs>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
