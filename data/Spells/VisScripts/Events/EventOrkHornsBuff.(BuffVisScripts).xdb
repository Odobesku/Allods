						<visObject href="/Spells/FX/Mobs/LoreOrc_Pipe.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.8</scale>
						<locatorName>RightFoot</locatorName>
					</Item>
