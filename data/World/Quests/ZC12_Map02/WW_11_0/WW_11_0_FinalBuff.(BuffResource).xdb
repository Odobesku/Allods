<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739952314</resourceId>
	</Header>
	<visualEffects>
		<Item>
			<effectFx href="/Spells/FX/Spells/Camera_CutScene.(VisObjectTemplate).xdb" />
		</Item>
	</visualEffects>
	<visScript href="WW_11_0_FinalBuff.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.EffectDisableAct">
			<actions>
				<Item>Move</Item>
				<Item>Rotate</Item>
				<Item>Jump</Item>
			</actions>
			<rooted>true</rooted>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceActive.(ClientData).xdb" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ImpactTeleport">
					<destination type="gameMechanics.map.destination.DestinationLocator">
						<locator>
							<scriptID>ZC12_RI8_Exit</scriptID>
							<map href="/Maps/ZC12_Map02/MapResource.xdb" />
						</locator>
					</destination>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientData">
					<data href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InterfaceDeactive.(ClientData).xdb" />
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Visibility</channel>
				<vector>Outgoing</vector>
				<direction>Incoming</direction>
				<plane href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InvisibleInCutscenes.(Plane).xdb" />
				<action>DENY</action>
			</visibilityRule>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Influence</channel>
				<vector>Outgoing</vector>
				<direction>Incoming</direction>
				<plane href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InvisibleInCutscenes.(Plane).xdb" />
				<action>DENY</action>
			</visibilityRule>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Select</channel>
				<vector>Outgoing</vector>
				<direction>Incoming</direction>
				<plane href="/Mechanics/RaidInstances/FerrisRaid/CutScene/InvisibleInCutscenes.(Plane).xdb" />
				<action>DENY</action>
			</visibilityRule>
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
			</predicates>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateMobWorld">
									<mobs>
										<Item href="/Characters/Praiden_female/Instances/ZC12_Map02/ZC12_RI8_LoonIgnorant.(MobWorld).xdb" />
									</mobs>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.PostponedImpacts">
									<impacts>
										<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
											<buff href="WW_11_0_LoonCutscene.(BuffResource).xdb" />
										</Item>
									</impacts>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<spawnResource href="/Maps/ZC12_RiftInstance8/SpawnTables/ZC12_RI8_NPCs3.(SpawnTable).xdb" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>4000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
									<distributor type="gameMechanics.elements.calcers.CasterDistributor" />
									<data href="WW_11_0_Bomb_Explosion.(ClientData).xdb" />
								</Item>
								<Item type="gameMechanics.elements.impacts.PostponedImpacts">
									<impacts>
										<Item type="gameMechanics.elements.impacts.ImpactKill" />
									</impacts>
								</Item>
							</impacts>
							<spawnResource href="/Maps/ZC12_RiftInstance8/SpawnTables/ZC12_RI8_Architect_Quarry.(SpawnTable).xdb" />
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
	</effects>
	<duration>10000</duration>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<groups>
		<Item href="/Mechanics/Spells/Groups/CutScene.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/QuestSpells.xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>