<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739869781</resourceId>
    </Header>
    <Name href="Spell02_Channel.(BuffResource).Name.txt" />
    <Description href="Spell02_Channel.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/WingBuffet.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="WingBeatBuff.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                    <radius>60</radius>
                                    <affectGroup>Enemies</affectGroup>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>SHADOW</element>
                                            <damage>3</damage>
                                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mul>0.5</mul>
                                                <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                                                    <summands>
                                                        <Item type="gameMechanics.elements.calcers.FloatData">
                                                            <value>12</value>
                                                        </Item>
                                                        <Item type="gameMechanics.elements.calcers.CalcerMul">
                                                            <calcers>
                                                                <Item type="gameMechanics.elements.calcers.FloatData">
                                                                    <value>-0.8125</value>
                                                                </Item>
                                                                <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                                                    <buff href="AvatarsAround.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                                </Item>
                                                            </calcers>
                                                        </Item>
                                                    </summands>
                                                </mulCalcer>
                                                <additionalMultiplier>
                                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                </additionalMultiplier>
                                            </scaler>
                                        </Item>
                                    </impacts>
                                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>543</tick>
            <initialDelay>750</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <tick>1000</tick>
            <affectGroup>All</affectGroup>
            <radius>45</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="CountedBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="CountedBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
            <holderImpactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="AvatarsAround.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </holderImpactsIn>
            <holderImpactsOut>
                <Item type="gameMechanics.elements.impacts.StackBuff">
                    <buff href="AvatarsAround.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    <delta type="gameMechanics.elements.calcers.FloatData">
                        <value>-1</value>
                    </delta>
                </Item>
            </holderImpactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.constructor.basicElements.ImpactList">
                    <impactsResource href="/Mechanics/RaidInstances/UmoirMound/06_Gamayun/ResetCooldowns.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                            <buff href="/Mechanics/RaidInstances/UmoirMound/06_Gamayun/Buff_Counter.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                            <range>
                                <min>4</min>
                                <max>4</max>
                            </range>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="CastSpellOnce.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactClearSpellCooldown">
                            <spell href="/Mechanics/RaidInstances/UmoirMound/06_Gamayun/Spell03/Spell03.(SpellArea).xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <duration>10240</duration>
    <stackLimit>5</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>