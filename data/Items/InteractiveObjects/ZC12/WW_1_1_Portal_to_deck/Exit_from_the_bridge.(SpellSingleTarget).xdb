<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739930943</resourceId>
	</Header>
	<isExploit>true</isExploit>
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>5</value>
	</range>
	<targetType>STTCurrentTargetNotSelf</targetType>
	<iffPolicy>Everyone</iffPolicy>
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<ignoreGlobalCooldown>true</ignoreGlobalCooldown>
	<launchWhenReady>true</launchWhenReady>
	<needInFront>false</needInFront>
	<mechanics>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
						<quest href="/World/Quests/ZC12/WW_1_3/WW_1_3.xdb" />
					</Item>
					<Item type="gameMechanics.constructor.basicElements.PredicateNot">
						<predicate type="gameMechanics.elements.predicates.PredicateQuestStatus">
							<quest href="/World/Quests/ZC12/WW_1_3/WW_1_3.xdb" />
							<status>Failed</status>
						</predicate>
					</Item>
				</predicates>
				<impactsIf>
					<Item type="gameMechanics.elements.impacts.ImpactTeleport">
						<destination type="gameMechanics.map.destination.DestinationLocator">
							<locator>
								<scriptID>ZC12_Eclipse_dock</scriptID>
								<map href="/Maps/Inst_ZoneContested12_Start/Astral_MapResource.(MapResource).xdb" />
							</locator>
						</destination>
						<finishImpacts>
							<Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
								<id href="/World/Quests/ZC12/WW_1_3/Counter1.(QuestCountId).xdb" />
							</Item>
						</finishImpacts>
					</Item>
				</impactsIf>
				<impactsElse>
					<Item type="gameMechanics.elements.impacts.ImpactTeleport">
						<destination type="gameMechanics.map.destination.DestinationLocator">
							<locator>
								<scriptID>ZC12_Eclipse_main_deck</scriptID>
								<map href="/Maps/Inst_ZoneContested12_Start/Astral_MapResource.(MapResource).xdb" />
							</locator>
						</destination>
					</Item>
				</impactsElse>
			</Item>
		</casterImpacts>
	</mechanics>
	<canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>