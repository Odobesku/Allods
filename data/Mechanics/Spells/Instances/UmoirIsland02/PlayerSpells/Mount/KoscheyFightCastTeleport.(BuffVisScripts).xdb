<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="VisActionList">
        <playWhile type="CreatureAnimationAction">
            <mode>LOOP</mode>
            <animations>
                <Item>readySpell</Item>
            </animations>
        </playWhile>
        <elements>
            <Item type="CreatureEffectsAction">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/HitDemonBlast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </action>
</BuffVisScripts>