					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/PsionicMindShieldAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<locator>Slot_Global</locator>
					</Item>
				</visualEffects>
			</Item>
