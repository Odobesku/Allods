<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739933610</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="SupportBeaconBuff.(AbilityResource).Name.txt" />
    <description href="SupportBeaconBuff.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="multiplier" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Stun.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
                    <mark href="BeaconTeleportTarget.(MarkResource).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <conditions>
                                <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                    <buff href="BeaconTPTrigger.(BuffResource).xdb" />
                                    <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                </Item>
                            </conditions>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                                    <predicate type="gameMechanics.elements.predicates.PredicateAffectGroup">
                                        <affectGroup>Friends</affectGroup>
                                    </predicate>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.MassBuffDetacher">
                                            <predicates>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                                                    <groups>
                                                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                                                        <Item href="/Mechanics/Spells/Groups/DRMesmerize.xdb" />
                                                    </groups>
                                                </Item>
                                            </predicates>
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/CommonBuffs/Stun/BuffStun.xdb" />
                                            <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                                <multiplier var="multiplier" />
                                            </durationScaler>
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                            <targetsLimit>1</targetsLimit>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.effects.BuffExtraEffects">
                    <buffs>
                        <Item href="/Mechanics/Spells/Engineer63/Spells/Beacon/BeaconStuff.(BuffResource).xdb" />
                    </buffs>
                    <effects>
                        <Item type="gameMechanics.elements.effects.Switch">
                            <impactsOn>
                                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/Spells/Engineer63/Spells/Titan/TitanInvisPlane.(BuffResource).xdb" />
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                                    <delay>2000</delay>
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                                            <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                                    <impacts>
                                                                        <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                                                            <addresseeFinder type="gameMechanics.elements.abilities.FinderPsionicContactAddress">
                                                                                <contactType>Normal</contactType>
                                                                            </addresseeFinder>
                                                                            <impacts>
                                                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                                    <buff href="BeaconTPTrigger.(BuffResource).xdb" />
                                                                                </Item>
                                                                            </impacts>
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsIf>
                                            <impactsElse>
                                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                                    <addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderMaster" />
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                                            <impacts>
                                                                <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                                                                    <addresseeFinder type="gameMechanics.elements.abilities.FinderPsionicContactAddress">
                                                                        <contactType>Normal</contactType>
                                                                    </addresseeFinder>
                                                                    <impacts>
                                                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                                            <buff href="BeaconTPTrigger.(BuffResource).xdb" />
                                                                        </Item>
                                                                    </impacts>
                                                                </Item>
                                                            </impacts>
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impactsElse>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsOn>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="SupportBeaconBuff01.(AbilityResource).xdb" />
        <Item href="SupportBeaconBuff02.(AbilityResource).xdb" />
        <Item href="SupportBeaconBuff03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>