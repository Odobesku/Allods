<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>226209</resourceId>
    </Header>
    <Name href="Buff01.(BuffResource).Name.txt" />
    <Description href="Buff01.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Ships/RestoreShield.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>2</coeff>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.ImpactHeal">
                        <heal>2</heal>
                        <scalerCaster type="gameMechanics.elements.scalers.TrivialScaler" />
                    </Item>
                </casterToTarget>
            </impacts>
            <scaleImpactsByDamage>true</scaleImpactsByDamage>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>