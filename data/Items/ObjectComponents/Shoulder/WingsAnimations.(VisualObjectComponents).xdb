<?xml version ="1.0" encoding="UTF-8" ?>
<VisualObjectComponents>
    <components>
        <Item type="AnimationFromParentComponent">
            <animationsReplacements>
                <Item>
                    <forAnimations>
                        <Item>jumpEnd</Item>
                        <Item>mountBikeJumpEnd</Item>
                    </forAnimations>
                    <play>jumpEnd</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>mountRideJumpStart</Item>
                        <Item>jumpStart</Item>
                        <Item>mountSitJumpStart</Item>
                        <Item>mountSitJumpStart01</Item>
                        <Item>mountSitJumpStart02</Item>
                        <Item>mountRideJumpStart01</Item>
                        <Item>mountRideJumpStart02</Item>
                        <Item>mountBikeJumpStart</Item>
                        <Item>mountBikeJumpStart01</Item>
                        <Item>mountBikeJumpStart02</Item>
                    </forAnimations>
                    <play>jumpStart</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>fall</Item>
                        <Item>overturn</Item>
                        <Item>jump</Item>
                        <Item>mountRideJump</Item>
                        <Item>mountRideJump01</Item>
                        <Item>mountRideJump02</Item>
                        <Item>mountBikeJump</Item>
                        <Item>mountBikeJump01</Item>
                        <Item>mountBikeJump02</Item>
                        <Item>mountSitJump</Item>
                        <Item>mountSitJump01</Item>
                        <Item>mountSitJump02</Item>
                    </forAnimations>
                    <play>jump</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>jumpLandRun</Item>
                        <Item>mountBikeJumpLandRun</Item>
                        <Item>mountBikeJumpLandRun01</Item>
                        <Item>mountBikeJumpLandRun02</Item>
                        <Item>mountRideJumpLandRun</Item>
                        <Item>mountRideJumpLandRun01</Item>
                        <Item>mountRideJumpLandRun02</Item>
                        <Item>mountSitJumpLandRun</Item>
                        <Item>mountSitJumpLandRun01</Item>
                        <Item>mountSitJumpLandRun02</Item>
                    </forAnimations>
                    <play>jumpLandRun</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>mountRideRun</Item>
                        <Item>run</Item>
                        <Item>mountBikeRun</Item>
                        <Item>mountBikeRun01</Item>
                        <Item>mountBikeRun02</Item>
                        <Item>mountRideRun01</Item>
                        <Item>mountRideRun02</Item>
                        <Item>mountSitRun</Item>
                        <Item>mountSitRun01</Item>
                        <Item>mountSitRun02</Item>
                        <Item>run01</Item>
                        <Item>run02</Item>
                        <Item>run1H</Item>
                        <Item>run1H01</Item>
                        <Item>run1H02</Item>
                        <Item>run2H</Item>
                        <Item>run2HL</Item>
                        <Item>runBow</Item>
                        <Item>runCharge</Item>
                        <Item>runCharge01</Item>
                        <Item>runCharge02</Item>
                        <Item>runFast</Item>
                        <Item>runSpellCharged</Item>
                        <Item>runSpellChargedWand</Item>
                    </forAnimations>
                    <play>run</play>
                </Item>
                <Item>
                    <forAnimations>
                        <Item>mountRideWalkBackwards</Item>
                        <Item>mountRideWalkBackwards01</Item>
                        <Item>mountRideWalkBackwards02</Item>
                        <Item>mountBikeWalkBackwards</Item>
                        <Item>mountBikeWalkBackwards01</Item>
                        <Item>mountBikeWalkBackwards02</Item>
                        <Item>mountSitWalkBackwards</Item>
                        <Item>mountSitWalkBackwards01</Item>
                        <Item>mountSitWalkBackwards02</Item>
                        <Item>walkBackwards</Item>
                    </forAnimations>
                    <play>walkBackwards</play>
                </Item>
            </animationsReplacements>
            <controller href="/Characters/Upper.(AnimationController).xdb#xpointer(/client.Scene3D.AnimationController)"/>
            <ifAnimationNotExistsRun>idle</ifAnimationNotExistsRun>
            <skipBlendOptimization>false</skipBlendOptimization>
            <synchronizeAnimationPosition>false</synchronizeAnimationPosition>
        </Item>
    </components>
</VisualObjectComponents>
