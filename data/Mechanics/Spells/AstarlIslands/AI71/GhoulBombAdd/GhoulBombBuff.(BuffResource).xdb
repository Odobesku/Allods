<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739935317</resourceId>
    </Header>
    <Name href="GhoulBombBuff.(BuffResource).Name.txt" />
    <Description href="GhoulBombBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Necromancer/SummonZombie.(UISingleTexture).xdb" />
    <visScript href="GhoulBombBuff.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>4500</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.TickableAura">
                    <affectGroup>All</affectGroup>
                    <radius>3</radius>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                    </filter>
                    <holderImpactsIn>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                            <projectileData>
                                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                </moveType>
                                                <resource href="GhoulExplosion.(ProjectileResource).xdb" />
                                            </projectileData>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="GhoulBombBuff.(BuffResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </holderImpactsIn>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="GhoulBombBuff.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>