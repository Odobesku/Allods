<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739861634</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                    <quality href="/Mechanics/MobQualities/BossFake.xdb#xpointer(/gameMechanics.world.mob.MobQuality)" />
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                        <quality href="/Mechanics/MobQualities/BossAdd.xdb#xpointer(/gameMechanics.world.mob.MobQuality)" />
                    </predicate>
                </Item>
            </predicates>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.EffectTaggerReward">
                    <impactsToAllTaggers>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                    <id href="/World/Quests/HuntingGround1/HG1_CommonGem/Count01.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                    <id href="/World/Quests/HuntingGround1/HG1_RareGem/Count01.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                    <id href="/World/Quests/HuntingGround1/HG1_RareGemHard/Count01.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impactsToAllTaggers>
                </Item>
            </effectsElse>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>