<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
    <action type="CreatureChangeVisItemsAction">
        <removeAllItems>true</removeAllItems>
        <leaveWeapons>true</leaveWeapons>
        <items>
            <Item>
                <slot>HELM</slot>
                <newItem href="/Items/VisualItems/Helm/Helm_Cloth_B_74PlagueDoctor.(VisualItem).xdb" />
            </Item>
            <Item>
                <slot>MANTLE</slot>
                <newItem href="/Items/VisualItems/Mantle/Shoulder_Cloth_B_74PlagueDoctor.(VisualItem).xdb" />
            </Item>
            <Item>
                <slot>CLOAK</slot>
                <newItem href="/Items/VisualItems/Cloak/Bag_Cloth_B_74PlagueDoctor.(VisualItem).xdb" />
            </Item>
            <Item>
                <slot>ARMOR</slot>
                <newItem href="/Items/VisualItems/Shirt/Cloth_B_74PlagueDoctorShirt.(VisualItem).xdb" />
            </Item>
        </items>
    </action>
</BuffVisScripts>