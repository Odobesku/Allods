            <Item>
                <animation>emoteHoldStart</animation>
                <playOnMount>idle</playOnMount>
                <playOnRiderBottom>mountStoveIdle</playOnRiderBottom>
                <playOnRiderTop>emoteHoldStart</playOnRiderTop>
            </Item>
            <Item>
                <animation>emoteHoldRun</animation>
                <playOnMount>run</playOnMount>
                <playOnRiderBottom>mountStoveRun</playOnRiderBottom>
                <playOnRiderTop>emoteHoldRun</playOnRiderTop>
