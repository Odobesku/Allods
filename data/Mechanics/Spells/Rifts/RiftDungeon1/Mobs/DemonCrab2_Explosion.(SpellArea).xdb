<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>739921082</resourceId>
    </Header>
    <Name href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/DemonCrab2_Explosion.(SpellArea).Name.txt" />
    <visualScripts href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/DemonCrab2_Explosion.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>3</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>5000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                <radius>5</radius>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                        </predicates>
                        <impactsIf>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>FIRE</element>
                                <damage>1</damage>
                                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                    <scalers>
                                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
                                            </mulCalcer>
                                        </Item>
                                    </scalers>
                                </scaler>
                            </Item>
                        </impactsIf>
                        <impactsElse>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                        <mobs>
                                            <Item href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss03/DemonBoss03.(MobWorld).xdb" />
                                        </mobs>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss03/Boss03_ExplosionStun.(BuffResource).xdb" />
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                        <element>FIRE</element>
                                        <damage>3</damage>
                                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                            <scalers>
                                                <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                        <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/EscapableDamageCommon.(CalcerFloatResource).xdb" />
                                                    </mulCalcer>
                                                </Item>
                                            </scalers>
                                        </scaler>
                                    </Item>
                                </impactsIf>
                                <impactsElse>
                                    <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                </impactsElse>
                            </Item>
                        </impactsElse>
                    </Item>
                </impacts>
                <finishImpacts>
                    <Item type="gameMechanics.elements.impacts.ImpactKill" />
                </finishImpacts>
                <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/DemonCrab1.(MobWorld).xdb" />
                                        <Item href="/Mechanics/Spells/Rifts/RiftDungeon1/Mobs/Boss03/DemonBoss03.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                </filter>
            </Item>
        </casterImpacts>
    </mechanics>
    <radius>0</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>