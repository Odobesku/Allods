<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739951857</resourceId>
    </Header>
    <name href="OmniChannelBuff.(BuffResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.AddPlane">
            <plane href="DarkSpherePlane.(Plane).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactActivateAggro" />
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                </Item>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceAnyBuff">
                                    <buffs>
                                        <Item href="ActiveSphere.(BuffResource).xdb" />
                                        <Item href="PursuitingSphere.(BuffResource).xdb" />
                                    </buffs>
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="ActiveSphere.(BuffResource).xdb" />
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                    <tick>1000</tick>
                </Item>
                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>1.75</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                            <element>ASTRAL</element>
                                                            <damage>12</damage>
                                                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                            <spawnResource href="/Maps/AstralDungeon04/SpawnTables/FinalBoss.(SpawnTable).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                                <predicates>
                                    <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                        </predicates>
                                    </Item>
                                    <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                                    <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/Spells/AstarlIslands/AstralDungeon04/Boss05/LightSphereBuff.(BuffResource).xdb" />
                                        </predicate>
                                    </Item>
                                </predicates>
                            </filter>
                        </Item>
                    </impacts>
                    <tick>500</tick>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>100</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.DamageZeroSuppressor" />
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectNoAggroChecks" />
        <Item type="gameMechanics.elements.effects.EffectAggroListMembers">
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="PursuitingSphere.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.constructor.basicElements.ImpactNull" />
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="SummonSphere.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>