    <image href="/Interface/Icons/Misc/Quest/HotEmber.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="LoreBSHotCoal.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <effects>
