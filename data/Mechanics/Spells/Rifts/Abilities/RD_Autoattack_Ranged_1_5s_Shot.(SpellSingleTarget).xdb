<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739940064</resourceId>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Rifts/RiftSpellGroups/RiftAutoattack.(ActionGroup).xdb" />
    </groups>
    <element>LIGHTNING</element>
    <Name href="RD_Autoattack_Ranged_1_5s_Shot.(SpellSingleTarget).Name.txt" />
    <visualScripts href="RD_Autoattack_Ranged_1_5s_Shot.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>30</value>
    </range>
    <prepareDuration>1500</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                    <scalers>
                        <Item type="gameMechanics.elements.scalers.WeaponScaler" />
                        <Item type="gameMechanics.elements.scalers.ScalerIf">
                            <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                <quality href="/Mechanics/MobQualities/Elite.xdb" />
                            </condition>
                            <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/InescapableDamage_1_5secondPhys.(CalcerFloatResource).xdb" />
                                </mulCalcer>
                            </scalerIf>
                            <scalerElse type="gameMechanics.elements.scalers.ScalerIf">
                                <condition type="gameMechanics.elements.predicates.PredicateMobQualityLessThan">
                                    <quality href="/Mechanics/MobQualities/Boss.xdb" />
                                </condition>
                                <scalerIf type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/InescapableDamage_1_5secondPhys_Elite.(CalcerFloatResource).xdb" />
                                    </mulCalcer>
                                </scalerIf>
                                <scalerElse type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer href="/Mechanics/Spells/Rifts/ExternalCalcers/InescapableDamage_1_5secondPhys_Boss.(CalcerFloatResource).xdb" />
                                    </mulCalcer>
                                </scalerElse>
                            </scalerElse>
                        </Item>
                    </scalers>
                </scaler>
                <minDamage>1</minDamage>
                <maxDamage>1</maxDamage>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>20</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>