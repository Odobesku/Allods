<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>219145</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.Name.txt" />
    <description href="Ability.Description.txt" />
    <descVars>
        <Item>
            <name>tar</name>
            <value var="tar" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/ChampionsSpells/ChampionsVeil.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <casterPreImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>4</radius>
                    <affectGroup>Raid</affectGroup>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAvatarJump">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.ModifierIfCheckPath">
                                        <pathChecker type="space.pathfinding.pathChecker.PathLenghtLimited">
                                            <maxLength>70</maxLength>
                                        </pathChecker>
                                        <modifierElse type="gameMechanics.map.destination.modifier.ModifierTrailFrom">
                                            <from type="gameMechanics.elements.calcers.DestinationSpellTargetPoint" />
                                        </modifierElse>
                                    </Item>
                                </modifiers>
                            </destination>
                            <speed>30</speed>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="PartyJump_Count.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                        <filters>
                            <Item type="gameMechanics.world.creature.AvatarFilter" />
                            <Item type="gameMechanics.world.creature.AliveFilter" />
                        </filters>
                    </filter>
                    <targetsLimit var="targetsLimit" />
                </Item>
            </casterPreImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/WarriorV3/HowlingStrike/Spell01.xdb#xpointer(/gameMechanics.constructor.schemes.spell.area.SpellArea)" />
                </spells>
            </destination>
        </Item>
    </effects>
    <majorEffect>-1</majorEffect>
    <level>1</level>
    <ranks>
        <Item href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability02.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability03.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
    <disableWhileDead>false</disableWhileDead>
    <saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>