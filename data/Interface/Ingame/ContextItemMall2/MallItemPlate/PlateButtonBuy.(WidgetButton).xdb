<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <BackLayer href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
    <Name>Buy</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>10</HighPos>
            <Size>96</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>11</HighPos>
            <Size>34</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>10000</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing>mall_buy_over</reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>true</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>true</wrapText>
    </TextStyle>
    <TextTag>value</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="-1" y="2"/>
            <Reaction>mall_buy_pressed</Reaction>
            <ReactionRightClick>mall_buy_pressed</ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyNormalDisabled.txt"/>
                <LayerMain href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyDisabled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateDisabled>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyNormal.txt"/>
                <LayerMain href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyPressed.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyValue.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyDisabledHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="-1" y="2"/>
            <Reaction>mall_buy_pressed</Reaction>
            <ReactionRightClick>mall_buy_pressed</ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyDisabledDisabled.txt"/>
                <LayerMain href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyDisabledDisabled.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateDisabled>
            <StateHighlighted/>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyDisabled.txt"/>
                <LayerMain href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyDisabledNormal.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyDisabledPressed.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            </StatePushed>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextItemMall2/MallItemPlate/PlateButtonBuyValue.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
