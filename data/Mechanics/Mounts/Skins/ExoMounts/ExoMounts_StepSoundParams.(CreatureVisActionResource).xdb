								<stopOnDeath>false</stopOnDeath>
								<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
							</Item>
						</elements>
						<play>Simultaneously</play>
						<playWhile type="client.SLON.PredicateVisualMountAction">
							<mountsList>
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton02Base.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton02Top.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton02Trial.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton02Architect.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton02Raid.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton02CompendiumWinter.(VisualMount).xdb#xpointer(/VisualMount)" />
							</mountsList>
							<checkIsInTheList>true</checkIsInTheList>
							<checkOnStartOnly>false</checkOnStartOnly>
						</playWhile>
						<preconditional>false</preconditional>
						<restartOnVisualChange>true</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
					</Item>
					<Item type="client.Replica.VisActionList">
						<elements>
							<Item type="client.Replica.VisActionList">
								<elements>
									<Item type="client.SLON.CreatureStepSoundParamAction">
										<param>
											<parameter href="ExoFootsteps.(SoundParameter).xdb#xpointer(/SoundParameter)" />
											<value>0.3</value>
										</param>
										<onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
									</Item>
								</elements>
								<play>Simultaneously</play>
								<preconditional>false</preconditional>
								<restartOnVisualChange>true</restartOnVisualChange>
								<stopOnDeath>false</stopOnDeath>
								<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
							</Item>
						</elements>
						<play>Simultaneously</play>
						<playWhile type="client.SLON.PredicateVisualMountAction">
							<mountsList>
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton01Red.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton01Green.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton01Yellow.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/ExoskeletonRobot/ExoskeletonRobot.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/ExoskeletonRobot/ExoskeletonRobotTop.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/ExoskeletonRobot/ExoskeletonRobotTemp.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/ExoskeletonRobot/ExoskeletonRobotBlack.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/ExoskeletonRobot/Exoskeleton9Base.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/ExoskeletonRobot/Exoskeleton9Top.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/ExoskeletonRobot/Exoskeleton9Temp.(VisualMount).xdb#xpointer(/VisualMount)" />
							</mountsList>
							<checkIsInTheList>true</checkIsInTheList>
							<checkOnStartOnly>false</checkOnStartOnly>
						</playWhile>
						<preconditional>false</preconditional>
						<restartOnVisualChange>true</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
					</Item>
					<Item type="client.Replica.VisActionList">
						<play>Simultaneously</play>
						<playWhile type="client.SLON.PredicateVisualMountAction">
							<mountsList>
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton06Base.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton06TopTop.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton06PVE.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton06Top.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton06Temp.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton06Raid.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton07Base.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton07Top.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton07Temp.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton07White.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton07Crimson.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton07Green.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton10Inventor.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton10InventorRed.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/Exoskeleton10InventorCorrupted.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/ExoMount_11_Base.(VisualMount).xdb#xpointer(/VisualMount)" />
								<Item href="/Client/VisualMounts/Exoskeleton/ExoMount_11_Top.(VisualMount).xdb#xpointer(/VisualMount)" />
							</mountsList>
							<checkIsInTheList>true</checkIsInTheList>
							<checkOnStartOnly>false</checkOnStartOnly>
						</playWhile>
						<preconditional>false</preconditional>
						<restartOnVisualChange>true</restartOnVisualChange>
						<stopOnDeath>false</stopOnDeath>
						<stopWhileWhenElementsEnded>false</stopWhileWhenElementsEnded>
					</Item>
				</elements>
				<play>Simultaneously</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>true</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
