<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>193875</resourceId>
    </Header>
    <Name href="AI14RageStele.(SpellSingleTarget).Name.txt" />
    <Description href="AI14RageStele.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/TheImpactHammer.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <isExploit>true</isExploit>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>5</value>
    </range>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Everyone</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                <spawn>
                    <scriptID>LastBoss</scriptID>
                    <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                </spawn>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="AI14_PrepareChecker.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ForceAggro" />
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                        <data href="AngrySound.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                <data href="RockFall.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                <delay>700</delay>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactKill" />
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>