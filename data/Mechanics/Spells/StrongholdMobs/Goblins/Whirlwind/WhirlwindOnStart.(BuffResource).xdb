<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>196379</resourceId>
    </Header>
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/ReadySpellDirect01Down.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
        </Item>
    </visualEffects>
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                            <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                            <data href="WhirlwindOnStart.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                        </Item>
                    </impactsOn>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                            <selector type="gameMechanics.tools.SelectorRandomNotLess">
                                <minIndex>0</minIndex>
                            </selector>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                            <impacts>
                                <Item>
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactStartSpell">
                                                    <spell href="Whirlwind.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                                                </Item>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="MoveToTarget.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectDisableAct">
                    <actions>
                        <Item>Move</Item>
                        <Item>Jump</Item>
                        <Item>Rotate</Item>
                    </actions>
                </Item>
                <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
                    <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                </Item>
                <Item type="gameMechanics.elements.effects.DisableSpellsPredicate">
                    <predicate type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                        <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                    </predicate>
                </Item>
                <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateGenericOr">
                            <predicates>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                                    <groups>
                                        <Item href="/Mechanics/Spells/Groups/DRMesmerize.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                    </groups>
                                </Item>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                                    <groups>
                                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                                    </groups>
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.Enlarge">
            <factor>1.5</factor>
        </Item>
    </effects>
    <duration>2000</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>