                        <destination type="gameMechanics.map.destination.SelfPosDestination" />
                    </moveType>
                    <resource href="BowlTarget.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                </projectileData>
                <pool href="LastPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
