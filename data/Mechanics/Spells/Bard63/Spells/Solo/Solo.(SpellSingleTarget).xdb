<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739936379</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/InsuranceTrigger.xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/BardPerfomance.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/MagicAttacks.xdb" />
    </groups>
    <Name href="Solo.(SpellSingleTarget).Name.txt" />
    <Description href="Solo.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>WeaponScaler</formula>
            </scaler>
        </Item>
        <Item>
            <name>var1</name>
            <value>1</value>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer hrefvar="externalCalcer" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                        <formula>FormulaPercent</formula>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Bard/VampireChord.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Bard/Solo.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>40</value>
    </range>
    <prepareDuration>0</prepareDuration>
    <ranks>
        <Item href="Solo01.(SpellSingleTarget).xdb" />
        <Item href="Solo02.(SpellSingleTarget).xdb" />
        <Item href="Solo03.(SpellSingleTarget).xdb" />
    </ranks>
    <modifiers>
        <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
            <effects>
                <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                    <scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
                        <coeff>1</coeff>
                        <calcer type="gameMechanics.constructor.basicElements.ScalerCalcer">
                            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mul>0.002</mul>
                                <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                    <stat type="gameMechanics.elements.stat.SpecialStat">
                                        <stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
                                    </stat>
                                    <valueType>ShortTerm</valueType>
                                </mulCalcer>
                                <sum>0.5</sum>
                            </scaler>
                            <value>1</value>
                        </calcer>
                    </scaler>
                </Item>
            </effects>
            <onBehalfOfHolder>true</onBehalfOfHolder>
        </Item>
    </modifiers>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Bard63/Abilities/DriveResource/Drive.(VariableResource).xdb" />
                <sub>3</sub>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.MarkedImpact">
                <mark href="/Mechanics/Spells/Bard63/Spells/Party/SoloPartyHitOnCaster.(MarkResource).xdb" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff hrefvar="buff" />
                <stacks type="gameMechanics.elements.calcers.FloatData">
                    <value>3</value>
                </stacks>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                                <Item type="gameMechanics.elements.scalers.WeaponDpsScaler" />
                            </scalers>
                        </scaler>
                        <minDamage var="value" />
                        <maxDamage var="value" />
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>