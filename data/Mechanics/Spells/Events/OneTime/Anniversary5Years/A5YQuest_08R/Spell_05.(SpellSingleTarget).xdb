<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>209918</resourceId>
    </Header>
    <Name href="Spell_05.(SpellSingleTarget).Name.txt" />
    <Description href="Spell_05.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Misc/Itemmall/Chest09.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <isExploit>true</isExploit>
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>5</value>
    </range>
    <prepareDuration>1500</prepareDuration>
    <targetType>STTCurrentTargetNotSelf</targetType>
    <iffPolicy>Everyone</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                        <quest href="/World/Quests/LoreEvents/Anniversary5Years/Stage_08/Anniversary5Years_08_L.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                    </Item>
                    <Item type="gameMechanics.elements.predicates.PredicateQuestStatus">
                        <quest href="/World/Quests/LoreEvents/Anniversary5Years/Stage_08/Anniversary5Years_08_E.(QuestResource).xdb#xpointer(/gameMechanics.constructor.schemes.quest.QuestResource)" />
                    </Item>
                </predicates>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <hideText>true</hideText>
                        <buff href="CheckKill.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                        <id href="/World/Quests/LoreEvents/Anniversary5Years/Stage_08/Anniversary5Years_08.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                                <affectPets>false</affectPets>
                                <excludeCaster>true</excludeCaster>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                        <predicates>
                                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                <hideText>true</hideText>
                                                <buff href="CheckKill.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                        </predicates>
                                        <impactsIf>
                                            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                                <id href="/World/Quests/LoreEvents/Anniversary5Years/Stage_08/Anniversary5Years_08.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
                                            </Item>
                                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                <buff href="CheckKill.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                            </Item>
                                        </impactsIf>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.BuffDetacher">
                        <buff href="CheckKill.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsIf>
                <impactsElse>
                    <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                        <distributor type="gameMechanics.elements.calcers.GroupDistributor" />
                        <data href="A5_08_Warning.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                    </Item>
                </impactsElse>
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <hideText>true</hideText>
                        <buff href="CheckKill.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.Disintegrate" />
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <canStartNotBeeingInSpellbook>true</canStartNotBeeingInSpellbook>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>