<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>188443</resourceId>
    </Header>
    <name href="PlagueBomb.(ProjectileResource).Name.txt" />
    <visObject href="SafeBomb.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>9000</lifeLengthCap>
    <corpseDuration>500</corpseDuration>
    <impactsOnDeath>
        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
            <projectileData>
                <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                <resource href="PlagueBombActivated.(ProjectileResource).xdb" />
            </projectileData>
        </Item>
    </impactsOnDeath>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.TickableEntityAura">
                    <affectGroup>All</affectGroup>
                    <radius>1.5</radius>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                            <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                        </predicates>
                    </filter>
                    <impactsIn>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>ACID</element>
                            <scalerTarget type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                <buff href="VulnerableToPlague.(BuffResource).xdb" />
                                <anyRank>true</anyRank>
                                <onlyFromMaster>false</onlyFromMaster>
                                <mul>1</mul>
                                <sum>1</sum>
                            </scalerTarget>
                            <damage>60</damage>
                            <impactsOnHitTarget>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="VulnerableToPlague.(BuffResource).xdb" />
                                    <stacks type="gameMechanics.elements.calcers.FloatData">
                                        <value>3</value>
                                    </stacks>
                                </Item>
                            </impactsOnHitTarget>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impactsIn>
                    <holderImpactsIn>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                <resource href="PlagueBombDeactivated.(ProjectileResource).xdb" />
                            </projectileData>
                        </Item>
                    </holderImpactsIn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>