	<image href="/Interface/Icons/Mounts/MountExoskeletV9.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<stallVisualMount href="/Client/VisualMounts/ExoskeletonRobot/Exoskeleton9Base_Stall.(VisualMount).xdb#xpointer(/VisualMount)" />
	<unlock href="ExoMount09Base.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
	<visualMount href="/Client/VisualMounts/ExoskeletonRobot/Exoskeleton9Base.(VisualMount).xdb#xpointer(/VisualMount)" />
	<visualScript type="client.Replica.VisActionList">
		<elements>
			<Item type="client.SLON.IfAction">
				<condition type="client.SLON.IfExoVisualAllowed">
					<checkType>ALL</checkType>
					<checkIsNotSet>false</checkIsNotSet>
				</condition>
				<elseAction type="client.Replica.VisActionList">
					<elements>
						<Item type="client.Replica.CreatureHideMountVisAction">
							<forceHideAnyMounts>true</forceHideAnyMounts>
						</Item>
					</elements>
					<play>Simultaneously</play>
					<preconditional>false</preconditional>
					<restartOnVisualChange>false</restartOnVisualChange>
					<stopOnDeath>false</stopOnDeath>
					<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
				</elseAction>
				<onBreak>
					<breakEnabled>false</breakEnabled>
				</onBreak>
				<thenAction type="client.Replica.VisActionList">
					<elements>
						<Item type="client.SLON.IfAction">
							<condition type="client.SLON.IfCreatureFlag">
								<flagName>DemonForm</flagName>
								<checkIsSet>true</checkIsSet>
								<checkOnMainAvatar>true</checkOnMainAvatar>
							</condition>
							<elseAction type="client.Replica.VisActionList">
								<elements>
									<Item type="client.Replica.CreatureChangeVisItemsAction">
										<items>
											<Item>
												<newItem href="/Items/VisualItems/Mantle/MountExo8_HideBody.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
												<slot>EARRING2</slot>
											</Item>
										</items>
										<isGfxCondition>false</isGfxCondition>
										<leaveWeapons>true</leaveWeapons>
										<notForDolls>true</notForDolls>
										<removeAllItems>false</removeAllItems>
									</Item>
									<Item type="client.Replica.VisActionDelay">
										<time>200</time>
									</Item>
									<Item type="client.Replica.CreatureMountVisAction">
										<visualMount href="/Client/VisualMounts/ExoskeletonRobot/Exoskeleton9Base.(VisualMount).xdb#xpointer(/VisualMount)" />
										<restorePrevMount>false</restorePrevMount>
									</Item>
									<Item type="client.Replica.CreatureChangeVisItemsAction">
										<items>
											<Item>
												<slot>CLOAK</slot>
											</Item>
											<Item>
												<slot>TABARD</slot>
											</Item>
											<Item>
												<slot>LIFESTYLEBACK</slot>
											</Item>
										</items>
										<isGfxCondition>false</isGfxCondition>
										<leaveWeapons>false</leaveWeapons>
										<notForDolls>false</notForDolls>
										<removeAllItems>false</removeAllItems>
									</Item>
								</elements>
								<play>InSequence</play>
								<preconditional>false</preconditional>
								<restartOnVisualChange>false</restartOnVisualChange>
								<stopOnDeath>false</stopOnDeath>
								<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
							</elseAction>
							<onBreak>
								<breakAction type="client.Replica.VisActionList">
									<elements>
										<Item type="client.Replica.CreatureChangeVisItemsAction">
											<items>
												<Item>
													<newItem href="/Items/VisualItems/Mantle/MountExo8_HideBody.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
													<slot>EARRING2</slot>
												</Item>
											</items>
											<isGfxCondition>false</isGfxCondition>
											<leaveWeapons>true</leaveWeapons>
											<notForDolls>true</notForDolls>
											<removeAllItems>false</removeAllItems>
										</Item>
										<Item type="client.Replica.VisActionDelay">
											<time>200</time>
										</Item>
										<Item type="client.Replica.CreatureMountVisAction">
											<visualMount href="/Client/VisualMounts/ExoskeletonRobot/Exoskeleton9Base.(VisualMount).xdb#xpointer(/VisualMount)" />
											<restorePrevMount>false</restorePrevMount>
										</Item>
										<Item type="client.Replica.CreatureChangeVisItemsAction">
											<items>
												<Item>
													<slot>CLOAK</slot>
												</Item>
												<Item>
													<slot>TABARD</slot>
												</Item>
												<Item>
													<slot>LIFESTYLEBACK</slot>
												</Item>
											</items>
											<isGfxCondition>false</isGfxCondition>
											<leaveWeapons>false</leaveWeapons>
											<notForDolls>false</notForDolls>
											<removeAllItems>false</removeAllItems>
										</Item>
									</elements>
									<play>InSequence</play>
									<preconditional>false</preconditional>
									<restartOnVisualChange>false</restartOnVisualChange>
									<stopOnDeath>false</stopOnDeath>
									<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
								</breakAction>
								<breakEnabled>false</breakEnabled>
							</onBreak>
							<thenAction type="client.Replica.VisActionList">
								<elements>
									<Item type="client.Replica.CreatureHideMountVisAction">
										<forceHideAnyMounts>true</forceHideAnyMounts>
									</Item>
								</elements>
								<play>Simultaneously</play>
								<preconditional>false</preconditional>
								<restartOnVisualChange>false</restartOnVisualChange>
								<stopOnDeath>false</stopOnDeath>
								<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
							</thenAction>
						</Item>
					</elements>
					<play>Simultaneously</play>
					<playWhile type="client.SLON.PredicateExoVisualAllowedAction">
						<checkType>ALL</checkType>
						<checkIsNotSet>false</checkIsNotSet>
					</playWhile>
					<preconditional>true</preconditional>
					<restartOnVisualChange>false</restartOnVisualChange>
					<stopOnDeath>false</stopOnDeath>
					<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
				</thenAction>
			</Item>
			<Item type="client.SLON.CreatureSetFlagAction">
				<flagName>GreatExo</flagName>
				<timeOut>-1</timeOut>
				<isSet>true</isSet>
				<onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
