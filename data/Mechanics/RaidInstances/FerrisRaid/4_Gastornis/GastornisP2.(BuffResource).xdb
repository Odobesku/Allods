<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>222577</resourceId>
    </Header>
    <image href="/Interface/Icons/Misc/Buffs/BuffMagicBallRed.(UISingleTexture).xdb" />
    <visScript href="GastornisP2.(BuffVisScripts).xdb" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectDisableAction">
                    <action href="Peck.(SpellSingleTarget).xdb" />
                </Item>
                <Item type="gameMechanics.elements.effects.ScalerOutputDamageChannel">
                    <element>PHYSICAL</element>
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>0.75</coeff>
                    </scaler>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
                    <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>1</coeff>
                    </effectScaler>
                </Item>
                <Item type="gameMechanics.elements.effects.WeaponSpeedMultiplier">
                    <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                        <coeff>2</coeff>
                    </scaler>
                </Item>
                <Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
                    <spell href="Peck.(SpellSingleTarget).xdb" />
                    <factor>0.7</factor>
                </Item>
            </effectsElse>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAction">
            <action href="PreyHM.(SpellSingleTarget).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAction">
            <action href="KickHM.(SpellSingleTarget).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAction">
            <action href="Summon.(SpellSingleTarget).xdb" />
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>