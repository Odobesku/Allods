    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <tickLength>1000</tickLength>
                <damagePerTick>1</damagePerTick>
                <affectedByDoubleAttack>true</affectedByDoubleAttack>
            </parameters>
            <element>FIRE</element>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                    <Item type="gameMechanics.elements.scalers.WeaponDpsScaler">
                        <source>Ranged</source>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerIf">
                            <predicate type="gameMechanics.elements.predicates.PredicateHasSpell">
                                <spell href="/Mechanics/Spells/Stalker63/Spells/EnchantFire/Spell03.(SpellSingleTarget).xdb" />
                                <anyRank>false</anyRank>
                            </predicate>
                            <calcerIf type="constructor.elements.CalcerFloatExternal">
                                <externalCalcer href="/Mechanics/Spells/Stalker63/Spells/EnchantFire/CalcerDamageDirect03.(CalcerFloatResource).xdb" />
                            </calcerIf>
                            <calcerElse type="gameMechanics.elements.calcers.CalcerIf">
                                <predicate type="gameMechanics.elements.predicates.PredicateHasSpell">
                                    <spell href="/Mechanics/Spells/Stalker63/Spells/EnchantFire/Spell02.(SpellSingleTarget).xdb" />
                                    <anyRank>false</anyRank>
                                </predicate>
                                <calcerIf type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="/Mechanics/Spells/Stalker63/Spells/EnchantFire/CalcerDamageDirect02.(CalcerFloatResource).xdb" />
                                </calcerIf>
                                <calcerElse type="constructor.elements.CalcerFloatExternal">
                                    <externalCalcer href="/Mechanics/Spells/Stalker63/Spells/EnchantFire/CalcerDamageDirect01.(CalcerFloatResource).xdb" />
                                </calcerElse>
                            </calcerElse>
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.AbilityRankCalcer">
                            <ability href="Ability02.(AbilityResource).xdb" />
                            <mul>0.14</mul>
                        </mulCalcer>
