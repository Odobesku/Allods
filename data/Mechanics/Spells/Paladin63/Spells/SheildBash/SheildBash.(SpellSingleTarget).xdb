    <ranks>
        <Item href="SheildBash01.(SpellSingleTarget).xdb" />
        <Item href="SheildBash02.(SpellSingleTarget).xdb" />
        <Item href="SheildBash03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration var="duration" />
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.elements.predicates.PredicateShieldEquipped" />
        </casterConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceVariable">
                <variable href="/Mechanics/Spells/Paladin63/Abilities/Canons/PurityCanon.(VariableResource).xdb" />
                <sub>1</sub>
            </Item>
        </casterResources>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.CreateImpactsUnderEffects">
                        <effects>
                            <Item type="gameMechanics.elements.effects.ThreatMultiplier">
                                <factor type="gameMechanics.elements.calcers.CalcerMul">
                                    <calcers>
                                        <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                            <value type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                                <scaler type="gameMechanics.elements.scalers.PowerDPSScaler" />
                                                <value>1</value>
                                            </value>
                                        </Item>
                                        <Item type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                            <scaler type="gameMechanics.elements.scalers.ShieldScaler" />
                                            <value>1</value>
                                        </Item>
                                    </calcers>
                                </factor>
                            </Item>
                        </effects>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                                <value>200</value>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </targetImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>