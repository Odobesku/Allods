<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>310196</resourceId>
    </Header>
    <needVisualize>false</needVisualize>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>1</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectForceMove">
            <destinations>
                <Item type="gameMechanics.map.destination.DestinationLocator">
                    <locator>
                        <scriptID>UI03DungeonExit</scriptID>
                        <map href="/Maps/UmoirIsland03/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                    </locator>
                    <yaw type="constructor.basicElements.AngleDegrees">
                        <value>80</value>
                    </yaw>
                </Item>
            </destinations>
            <impactsOnArrived>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="OpeningDoor.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="MoveToDoor.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOnArrived>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                    <data href="StartOpeningWarn.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>