<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>196807</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability00.(AbilityResource).Name.txt" />
    <description href="Ability00.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>RangedWeaponScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Potions/BalsamTouchElements04.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectInstantiating">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectMarkedImpacts">
                    <mark href="/Mechanics/Spells/Stalker63/Spells/ExplosiveShot/FireExplosion.(MarkResource).xdb" />
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                                    <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateOr">
                                        <predicates>
                                            <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                                <buff href="/Mechanics/Spells/Stalker63/Spells/EnchantPoison/PoisonNormal01.(BuffResource).xdb" />
                                                <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                            </Item>
                                            <Item type="gameMechanics.elements.predicates.PredicateHasBuffFromAddressee">
                                                <buff href="/Mechanics/Spells/Stalker63/Spells/EnchantPoison/PoisonStrong01.(BuffResource).xdb" />
                                                <from type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                            </Item>
                                        </predicates>
                                    </predicate>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                            <element>FIRE</element>
                                            <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                <mulCalcer type="gameMechanics.elements.calcers.CalcerSum">
                                                    <summands>
                                                        <Item type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                                            <scaler type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                                                <buff href="/Mechanics/Spells/Stalker63/Spells/EnchantPoison/PoisonNormal01.(BuffResource).xdb" />
                                                                <anyRank>true</anyRank>
                                                                <onlyFromMaster>true</onlyFromMaster>
                                                                <mul>1</mul>
                                                            </scaler>
                                                            <value>1</value>
                                                        </Item>
                                                        <Item type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                                            <scaler type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                                                <buff href="/Mechanics/Spells/Stalker63/Spells/EnchantPoison/PoisonStrong01.(BuffResource).xdb" />
                                                                <anyRank>true</anyRank>
                                                                <onlyFromMaster>true</onlyFromMaster>
                                                                <mul>1</mul>
                                                            </scaler>
                                                            <value>1</value>
                                                        </Item>
                                                    </summands>
                                                </mulCalcer>
                                            </scalerTarget>
                                            <damage var="damage" />
                                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                <scalers>
                                                    <Item type="gameMechanics.elements.scalers.PowerDPSScaler" />
                                                    <Item type="gameMechanics.elements.scalers.WeaponDpsScaler">
                                                        <source>Ranged</source>
                                                    </Item>
                                                </scalers>
                                            </scaler>
                                        </Item>
                                    </impactsIf>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>