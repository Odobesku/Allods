<?xml version="1.0" encoding="UTF-8" ?>
<VisObjectTemplate>
    <defaultState>
        <sound />
        <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
        <playSoundOnKeys>true</playSoundOnKeys>
        <isNecessaryAnim>false</isNecessaryAnim>
    </defaultState>
    <fadeInMS>0</fadeInMS>
    <fadeOutMS>0</fadeOutMS>
    <geometry href="/Spells/FX/World/DemonicPortal.(Geometry).xdb#xpointer(/client.Scene3D.Geometry)" />
    <particle href="/Spells/FX/World/DemonicPortal.(ParticleAnimation).xdb#xpointer(/client.Animation.ParticleAnimation)" />
    <scale>0.2</scale>
    <sound>
        <name>World/Magic/Portal/DemonicPortal</name>
        <project href="/SFX/World/World.(FMODProject).xdb#xpointer(/client.Sound.FMODProject)" />
    </sound>
    <states>
        <Item>
            <sound />
            <allowMultipleSoundInstances>false</allowMultipleSoundInstances>
            <playSoundOnKeys>true</playSoundOnKeys>
            <animation href="/Spells/FX/World/DemonicPortal.(SkeletalAnimation).xdb#xpointer(/client.Scene3D.SkeletalAnimation)" />
