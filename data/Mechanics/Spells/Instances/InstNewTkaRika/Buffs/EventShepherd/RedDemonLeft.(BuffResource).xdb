<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>195219</resourceId>
    </Header>
    <Name href="RedDemonLeft.(BuffResource).Name.txt" />
    <Description href="RedDemonLeft.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Crafting/LeatherHGUnicOffence.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="/Maps/Inst_TkaRika/SpawnTables/Inst_TkaRika/EventShepherd_RedCircle.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>500</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.SpawnTableObjects">
                            <table href="/Maps/Inst_TkaRika/SpawnTables/Inst_TkaRika/EventShepherd_RedCircle.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>12000</tick>
            <initialDelay>12250</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactStopSpawn">
                    <table href="/Maps/Inst_TkaRika/SpawnTables/Inst_TkaRika/EventShepherd_RedCircle.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="MinorEnrage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                    <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Mobs/DemonDogRed.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Mobs/DemonDogGreen.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                    <Item href="/Mechanics/Spells/Instances/InstNewTkaRika/Mobs/DemonDogBlue.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                </mobs>
                            </Item>
                        </predicates>
                    </filter>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>