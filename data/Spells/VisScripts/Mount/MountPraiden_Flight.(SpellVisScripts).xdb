<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile type="VisActionDelay">
			<time>2000</time>
		</playWhile>
		<elements>
			<Item type="CreatureSetFlagAction">
				<flagName>Flag_MountNeeded</flagName>
				<timeOut>0.5</timeOut>
			</Item>
			<Item type="VisActionList">
				<playWhile type="PredicateCreatureFlagAction">
					<flagName>Flag_Emote</flagName>
				</playWhile>
				<elements>
					<Item type="VisActionDelay">
						<time>500</time>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="CreatureReplaceAnimationsAction">
						<onTop>
							<animationsReplacements>
								<Item>
									<play>specialAttack</play>
									<forAnimations>
										<Item>jump</Item>
									</forAnimations>
								</Item>
							</animationsReplacements>
						</onTop>
						<onBottom>
							<animationsReplacements>
								<Item>
									<play>specialAttack</play>
									<forAnimations>
										<Item>jump</Item>
									</forAnimations>
								</Item>
							</animationsReplacements>
						</onBottom>
						<member>Mount</member>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Spells/MountDrake_FlightTrail_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<locator>Slot_Hand_L</locator>
								<member>Mount</member>
								<locatorName>HandWing_R</locatorName>
								<offendTime />
							</Item>
							<Item>
								<effectFx href="/Spells/FX/Spells/MountDrake_FlightTrail_FX.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
								<effectAlias href="" />
								<locator>Slot_Hand_R</locator>
								<member>Mount</member>
								<locatorName>HandWing_L</locatorName>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
					<Item type="Sound3DAction">
						<sound>
							<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
							<name>spells/Mount/MountCarpetPlane/WindOfHaste</name>
						</sound>
					</Item>
					<Item type="Sound3DAction">
						<sound>
							<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
							<name>spells/Mount/MountWyvernFlightStart</name>
						</sound>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
