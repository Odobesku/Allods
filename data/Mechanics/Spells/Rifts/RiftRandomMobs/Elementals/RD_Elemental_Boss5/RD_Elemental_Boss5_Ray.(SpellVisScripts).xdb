<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <mode>LOOP</mode>
                <animations>
                    <Item>walk</Item>
                </animations>
                <channel>CHANNEL_ATTACK</channel>
            </Item>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Mobs/Cyclop_Channel_Eye.(VisObjectTemplate).xdb" />
                <fxLength>30</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>FROM_LOCATOR_NAME</locator>
                    <locatorName>Slot_Special01</locatorName>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </endPoint>
                <velocity>40</velocity>
            </Item>
        </elements>
    </actionBarStart>
</SpellVisScripts>