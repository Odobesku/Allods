                <playOnMount>spellCastOmni</playOnMount>
                <playOnRiderBottom>mountBikeJumpEnd</playOnRiderBottom>
                <playOnRiderTop>mountBikeJumpEnd</playOnRiderTop>
            </Item>
            <Item>
                <animation>walk</animation>
                <playOnMount>walk</playOnMount>
                <playOnRiderBottom>mountBikeWalk</playOnRiderBottom>
