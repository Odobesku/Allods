<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>339202061</resourceId>
	</Header>
	<visualScript type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/World/AC9_Generator_Charge_StageBuilding_Center.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<scale>0.6</scale>
						<locator>Slot_FX</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<stopOnDeath>true</stopOnDeath>
	</visualScript>
	<effects>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.StackBuffGeneric">
							<buff href="ColumnActivateTrigger.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
							<delta type="gameMechanics.elements.calcers.FloatData">
								<value>1</value>
							</delta>
							<attachIfNotExist>true</attachIfNotExist>
						</Item>
					</impacts>
					<spawnResource href="/Maps/Inst_TepPyramid/SpawnTables/Inst_TepPyramid/Column.(SpawnTable).xdb#xpointer(/gameMechanics.map.spawn.SpawnTable)" />
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
					<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
					<data href="DeathVisual.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
				</Item>
			</impacts>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Visibility</channel>
				<vector>Incoming</vector>
				<direction>Incoming</direction>
				<plane href="ColumnPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
			</visibilityRule>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Influence</channel>
				<vector>Incoming</vector>
				<direction>Incoming</direction>
				<plane href="ColumnPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
			</visibilityRule>
		</Item>
		<Item type="gameMechanics.elements.effects.AddVisibilityRule">
			<visibilityRule>
				<channel>Select</channel>
				<vector>Incoming</vector>
				<direction>Incoming</direction>
				<plane href="ColumnPlane.(Plane).xdb#xpointer(/gameMechanics.world.visibility.Plane)" />
			</visibilityRule>
		</Item>
		<Item type="gameMechanics.elements.effects.CombatStateTrigger">
			<onEnter>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="/Mechanics/Spells/TepPyramidBosses/Boss_04/AddDisableSummon.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
				<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
					<buff href="Charged.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</Item>
			</onEnter>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectPowerMultiplier">
			<multiplier type="gameMechanics.elements.calcers.FloatData">
				<value>0.6</value>
			</multiplier>
		</Item>
		<Item type="gameMechanics.elements.effects.Enlarge">
			<factor>1.2</factor>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
