<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureVisCharacterAction">
					<visCharList>
						<Item href="/Characters/Kania_male/KaniaMale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
						<Item href="/Characters/Kania_female/KaniaFemale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
					</visCharList>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureMountVisAction">
						<visualMount href="/Client/VisualMounts/EngineerTurret/EngineerTurret.(VisualMount).xdb#xpointer(/VisualMount)" />
					</Item>
					<Item type="CreatureSetFlagAction">
						<flagName>Artillery</flagName>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateCreatureVisCharacterAction">
					<visCharList>
						<Item href="/Characters/Hadagan_male/HadaganMale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
						<Item href="/Characters/Hadagan_female/HadaganFemale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
					</visCharList>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureMountVisAction">
						<visualMount href="/Client/VisualMounts/EngineerTurret/EngineerTurretHadagan.(VisualMount).xdb#xpointer(/VisualMount)" />
					</Item>
					<Item type="CreatureSetFlagAction">
						<flagName>Artillery</flagName>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureLockRotationAction" />
		</elements>
	</action>
	<postAction type="CreatureSetFlagAction">
		<flagName>Artillery</flagName>
		<isSet>false</isSet>
	</postAction>
</BuffVisScripts>
