<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739850205</resourceId>
	</Header>
	<name href="HealSphere.(ProjectileResource).Name.txt" />
	<visObject href="/Spells/FX/Spells/AstralComet2_Projectile.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<altitude>2</altitude>
	<speed>0.02</speed>
	<lifeLengthCap>20000</lifeLengthCap>
	<effects>
		<Item type="gameMechanics.elements.effects.StaticEntityAura">
			<radius>1.5</radius>
			<impactsIn>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactHeal">
									<heal>1</heal>
									<scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
										<mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
											<multiplier>0.1</multiplier>
										</mulCalcer>
									</scalerTarget>
								</Item>
								<Item type="gameMechanics.elements.impacts.IncrementManaBase">
									<manaType>Mana</manaType>
									<factor>1</factor>
									<factorMul type="gameMechanics.elements.calcers.LinearCalcer">
										<mul>0.2</mul>
										<sum>0</sum>
									</factorMul>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
				</Item>
				<Item type="gameMechanics.elements.impacts.ImpactIfTargetGeneric">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.elements.impacts.ReturningImpactsGeneric">
							<impacts>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impacts>
						</Item>
					</impactsIf>
				</Item>
			</impactsIn>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
