<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739885796</resourceId>
	</Header>
	<Name href="Target.(BuffResource).Name.txt" />
	<Description href="Target.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Equipment/Ships/ComplexTarget.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="Taunt.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.ReturningImpact">
					<impacts>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="Taunt.(BuffResource).xdb" />
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/Shroud.xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/Escapes.xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
			<group href="/Mechanics/Spells/Groups/TeleportationSpells.xdb" />
		</Item>
		<Item type="gameMechanics.elements.effects.ImmunityToBuffs">
			<predicates>
				<Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
					<groups>
						<Item href="/Mechanics/Spells/Groups/Shroud.xdb" />
						<Item href="/Mechanics/Spells/Groups/Escapes.xdb" />
					</groups>
				</Item>
			</predicates>
		</Item>
	</effects>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
	<ignoreLevelDelta>true</ignoreLevelDelta>
	<groups>
		<Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
		<Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
