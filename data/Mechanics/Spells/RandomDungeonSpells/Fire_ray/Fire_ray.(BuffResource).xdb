<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>213259</resourceId>
    </Header>
    <Name href="Fire_ray.(BuffResource).Name.txt" />
    <Description href="Fire_ray.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Buffs/BuffURFireRay.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectRay">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                            <element>FIRE</element>
                            <damage>15</damage>
                            <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                        </Item>
                    </impactsIf>
                </Item>
            </impacts>
            <width>2</width>
            <affectGroup>Enemies</affectGroup>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpin">
            <rotation type="gameMechanics.elements.calcers.AngleCalcerRelative">
                <delta type="constructor.basicElements.AngleDegrees">
                    <value>360</value>
                </delta>
            </rotation>
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>