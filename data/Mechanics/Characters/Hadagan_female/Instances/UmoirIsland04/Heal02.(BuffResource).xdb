<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>240044</resourceId>
    </Header>
    <Name href="Heal02.(BuffResource).Name.txt" />
    <Description href="Heal02.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestRegeneration.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualEffects>
        <Item>
            <effectFx href="/Spells/FX/Spells/HOTGood.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
            <locator>Slot_FX</locator>
        </Item>
    </visualEffects>
    <effects>
        <Item type="gameMechanics.elements.common.HealOverTime">
            <healPerTick type="gameMechanics.elements.calcers.FullHealthCalcer">
                <multiplier>0.3</multiplier>
            </healPerTick>
            <scaler type="gameMechanics.elements.scalers.TrivialScaler" />
