<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>readySpellDirected</PreCastAnimation>
			<CastAnimation>spellCastDirected01</CastAnimation>
			<FXOnTargets />
		</Variables>
	</Header>
	<actionBarStart type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="AttachedVisObjectComponent">
						<visObject href="/Spells/FX/Mobs/Demon_ReadySpell_AstralFlurry.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.3</scale>
						<offset y="-0.4" z="0.3" />
						<locatorName>Slot_FX</locatorName>
					</Item>
				</visObjComponents>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectAstralWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>0.6</scale>
						<fadeInTime>300</fadeInTime>
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectAstralWand.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<effectAlias href="" />
						<scale>0.6</scale>
						<fadeInTime>300</fadeInTime>
						<locator>Slot_Hand_R</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsOnTarget">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Demon_ReadyTarget.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>500</fadeInTime>
						<fadeOutTime>250</fadeOutTime>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Demon_TargetMark.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<lockScale>true</lockScale>
						<scale>1.55</scale>
						<fadeInTime>300</fadeInTime>
						<fadeOutTime>300</fadeOutTime>
						<locator>Slot_TopFX</locator>
						<offset z="2.1" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>6000</time>
					</Item>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<elements>
							<Item type="CreatureEffectsAction">
								<visActionID>DEMHANDR</visActionID>
								<visualEffects>
									<Item>
										<effectFx href="/Spells/FX/Spells/ReadySpellDirectCurseWand_Cast.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
										<effectAlias href="" />
										<scale>0.6</scale>
										<fadeInTime>250</fadeInTime>
										<fadeOutTime>250</fadeOutTime>
										<locator>Slot_Hand_R</locator>
										<offendTime />
									</Item>
								</visualEffects>
							</Item>
							<Item type="VisActionList">
								<elements>
									<Item type="VisActionDelay">
										<time>250</time>
									</Item>
									<Item type="VisActionStopAction">
										<stoppedActionID>DEMHANDS</stoppedActionID>
									</Item>
								</elements>
							</Item>
							<Item type="VisActionList">
								<playWhile />
								<elements>
									<Item type="VisActionDelay">
										<time>666</time>
									</Item>
									<Item type="VisActionStopAction">
										<stoppedActionID>DEMHANDR</stoppedActionID>
									</Item>
								</elements>
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item skiped="" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Mobs/Demon_Projectile_AstralFlurry.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<explosionFx href="/Spells/FX/Mobs/Morok_AddCaster_Hit.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<theGe>12</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>Slot_Hand_R</locator>
						</pointOnCaster>
						<pointOnTarget type="VisPointLocator">
							<locator>Slot_FX</locator>
						</pointOnTarget>
						<offendTime type="EffectOffendConstDelay" />
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
