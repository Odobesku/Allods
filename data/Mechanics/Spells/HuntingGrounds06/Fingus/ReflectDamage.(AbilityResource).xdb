<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739886740</resourceId>
    </Header>
    <name href="ReflectDamage.(AbilityResource).Name.txt" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <impacts>
                <targetToOffender>
                    <Item type="gameMechanics.elements.impacts.PureDamage">
                        <damage>1</damage>
                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                            <scalers>
                                <Item type="gameMechanics.elements.scalers.LinearScaler">
                                    <multiplier>0.03</multiplier>
                                </Item>
                            </scalers>
                        </scaler>
                        <scalerTarget type="gameMechanics.elements.scalers.TrivialScaler" />
                    </Item>
                </targetToOffender>
            </impacts>
            <scaleImpactsByDamage>true</scaleImpactsByDamage>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ReflectDamageInformBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ReflectDamageInformBuff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOff>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>