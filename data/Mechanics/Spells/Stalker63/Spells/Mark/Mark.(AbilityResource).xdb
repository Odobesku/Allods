<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739975741</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Mark.(AbilityResource).Name.txt" />
    <description href="Mark.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value>1</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="constructor.elements.CalcerFloatExternal">
                    <externalCalcer hrefvar="externalCalcer" />
                </mulCalcer>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Misc/Itemmall/IMFireworkTarget.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff hrefvar="buff" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <tick>20000</tick>
                            <factor type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mul>-0.001</mul>
                                    <mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
                                        <stat type="gameMechanics.elements.stat.SpecialStat">
                                            <stat href="/Mechanics/SpecialStats/ColldownDecreaser.(SpecialStatResource).xdb" />
                                        </stat>
                                        <valueType>ShortTerm</valueType>
                                    </mulCalcer>
                                    <sum>1</sum>
                                </scaler>
                                <value>1</value>
                            </factor>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Mark01.(AbilityResource).xdb" />
        <Item href="Mark02.(AbilityResource).xdb" />
        <Item href="Mark03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>