<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.mob.interaction.Cue>
	<Header>
		<resourceId>739872712</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="ExchangePrototype.(Cue).Name.txt" />
	<text href="ExchangePrototype.(Cue).Text.txt" />
	<conditions>
		<Item type="gameMechanics.elements.resources.ResourceItem">
			<item hrefvar="keyItem" />
		</Item>
	</conditions>
	<additionalConditions>
		<Item type="gameMechanics.elements.resources.ResourceAltCurrency">
			<currency href="/Mechanics/AlternativeCurrencies/AstralTicket.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
			<count>1</count>
		</Item>
		<Item type="gameMechanics.elements.resources.ResourceItem">
			<item hrefvar="sandItem" />
			<number var="sandCount" />
		</Item>
		<Item type="gameMechanics.elements.resources.ResourceItem">
			<item hrefvar="keyItem" />
			<number>4</number>
		</Item>
	</additionalConditions>
	<impacts>
		<Item type="gameMechanics.elements.impacts.ImpactConsumeResources">
			<resources>
				<Item type="gameMechanics.elements.resources.ResourceItem">
					<item hrefvar="keyItem" />
					<number>4</number>
				</Item>
			</resources>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactConsumeResources">
			<resources>
				<Item type="gameMechanics.elements.resources.ResourceItem">
					<item hrefvar="sandItem" />
					<number var="sandCount" />
				</Item>
			</resources>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactConsumeResources">
			<resources>
				<Item type="gameMechanics.elements.resources.ResourceAltCurrency">
					<currency href="/Mechanics/AlternativeCurrencies/AstralTicket.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
					<count>1</count>
				</Item>
			</resources>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactAddAltCurrency">
			<currency hrefvar="currency" />
			<sumCalcer type="gameMechanics.elements.calcers.FloatData">
				<value var="giveSandCount" />
			</sumCalcer>
		</Item>
		<Item type="gameMechanics.elements.impacts.ImpactGiveItem">
			<item type="gameMechanics.constructor.schemes.item.SimpleItemProvider">
				<item hrefvar="itemUnlock" />
			</item>
			<count var="giveUnlock" />
		</Item>
	</impacts>
	<nextCues>
