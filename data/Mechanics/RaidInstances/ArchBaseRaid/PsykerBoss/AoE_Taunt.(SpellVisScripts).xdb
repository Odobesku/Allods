<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readySpell</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/ArchitectDestroyer_ReadySpellAoe.(VisObjectTemplate).xdb" />
						<scale>2</scale>
						<fadeInTime>250</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Spells/AOEAura_Electric_R10.(VisObjectTemplate).xdb" />
						<fadeInTime>250</fadeInTime>
						<fadeOutTime>500</fadeOutTime>
					</Item>
				</visualEffects>
				<restartOnVisCreatureChange>true</restartOnVisCreatureChange>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>