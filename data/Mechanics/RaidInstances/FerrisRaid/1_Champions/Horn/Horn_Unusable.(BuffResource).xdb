<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739889566</resourceId>
	</Header>
	<needVisualize>false</needVisualize>
	<effects>
		<Item type="gameMechanics.world.ship.elements.effects.EffectDeviceShutdown" />
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
					<projectileData>
						<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
							<destination type="gameMechanics.map.destination.DestinationLocator">
								<locator>
									<scriptID>1_horn_fx</scriptID>
									<map href="/Maps/FerrisRaid/MapResource.xdb" />
								</locator>
							</destination>
						</moveType>
						<resource href="Horn_Visual.(ProjectileResource).xdb" />
					</projectileData>
					<pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
				</Item>
			</impactsOn>
			<impactsOff>
				<Item type="gameMechanics.elements.impacts.EntityImpactEntitiesAround">
					<radius>3</radius>
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateRespawnableResource">
									<resources>
										<Item href="Horn_Visual.(ProjectileResource).xdb" />
									</resources>
								</Item>
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.Disintegrate" />
							</impactsIf>
						</Item>
					</impacts>
				</Item>
			</impactsOff>
		</Item>
	</effects>
	<isStackable>false</isStackable>
	<isHelpful>false</isHelpful>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
