<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
	<Header>
		<resourceId>739886233</resourceId>
	</Header>
	<name href="Ice_Chaos.(ProjectileResource).Name.txt" />
	<visObject href="Ice_Chaos_Vis.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
	<altitude>0.01</altitude>
	<lifeLengthCap>8000</lifeLengthCap>
	<impactsOnDeath>
		<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
			<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
				<value>0.05</value>
			</chanceCalcer>
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactSummon">
					<destination type="gameMechanics.map.destination.SelfPosDestination" />
					<object href="/Mechanics/Spells/HuntingGrounds5/Yeti/SB1_YetiBoss_SummonAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
					<pool href="Pool_daily.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
					<isPersonalPool>true</isPersonalPool>
				</Item>
			</impacts>
		</Item>
	</impactsOnDeath>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
					<delay>7000</delay>
					<impacts>
						<Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
							<shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
							<radius>8</radius>
							<affectGroup>Enemies</affectGroup>
							<impacts>
								<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
									<element>COLD</element>
									<damage>200</damage>
								</Item>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="Ice_Chaos_buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
							<filter type="gameMechanics.world.creature.AvatarFilter" />
						</Item>
					</impacts>
				</Item>
			</impactsOn>
		</Item>
	</effects>
</gameMechanics.world.projectile.ProjectileResource>
