<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<playWhile />
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
				</advanced>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile />
				<elements>
					<Item type="VisActionList">
						<play>Simultaneously</play>
						<playWhile type="VisActionDelay">
							<time>1500</time>
						</playWhile>
						<elements>
							<Item type="VisActionList">
								<playWhile type="PredicateCreatureVisCharacterAction">
									<visCharList>
										<Item href="/Characters/Kania_male/KaniaMale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
										<Item href="/Characters/Kania_female/KaniaFemale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
									</visCharList>
								</playWhile>
								<preconditional>true</preconditional>
								<elements>
									<Item type="CreatureEffectsAction">
										<visualEffects>
											<Item>
												<effectFx href="/Spells/FX/Spells/Engeneer_Mantrap_RunMain.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
												<effectAlias href="" />
												<fixPoint>true</fixPoint>
												<locator>Slot_Global</locator>
												<offendTime />
											</Item>
										</visualEffects>
									</Item>
								</elements>
							</Item>
							<Item type="VisActionList">
								<playWhile type="PredicateCreatureVisCharacterAction">
									<visCharList>
										<Item href="/Characters/Hadagan_male/HadaganMale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
										<Item href="/Characters/Hadagan_female/HadaganFemale.(VisCharacterTemplate).xdb#xpointer(/VisCharacterTemplate)" />
									</visCharList>
								</playWhile>
								<preconditional>true</preconditional>
								<elements>
									<Item type="CreatureEffectsAction">
										<visualEffects>
											<Item>
												<effectFx href="/Spells/FX/Spells/EngeneerHadagan_Mantrap_RunMain.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
												<effectAlias href="" />
												<fixPoint>true</fixPoint>
												<locator>Slot_Global</locator>
												<offendTime />
											</Item>
										</visualEffects>
									</Item>
								</elements>
							</Item>
							<Item type="Sound3DAction">
								<sound>
									<project href="/SFX/Creatures/Creatures_E.(FMODProject).xdb#xpointer(/FMODProject)" />
									<name>Creatures/Engineer/EngineerDrill/EngineerDrill02</name>
								</sound>
								<alias href="" />
							</Item>
						</elements>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
