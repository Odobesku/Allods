<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739932298</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<Name href="Buff00.(BuffResource).Name.txt" />
	<Description href="Buff00.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Stalker/StalkerRecoilJump.(UISingleTexture).xdb" />
	<visScript href="/Spells/VisScripts/Stalker/Stance.(BuffVisScripts).xdb" />
	<interfaceHighPriority>true</interfaceHighPriority>
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOverTime">
			<impacts>
				<Item type="gameMechanics.elements.impacts.StackBuff">
					<buff href="Buff01.(BuffResource).xdb" />
					<resetTimer>false</resetTimer>
					<delta type="gameMechanics.elements.calcers.FloatData">
						<value>1</value>
					</delta>
				</Item>
			</impacts>
			<tick>1000</tick>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsIfCaster">
			<predicates>
				<Item type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="/Mechanics/Spells/CommonBuffs/Aspects/DD/Buff01.(BuffResource).xdb" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
					<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
						<coeff>0.01</coeff>
						<calcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="calcerDmgOut" />
						</calcer>
					</scaler>
				</Item>
			</effectsIf>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsIfCaster">
			<predicates>
				<Item type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
				</Item>
			</predicates>
			<effectsIf>
				<Item type="gameMechanics.elements.effects.ScalerAllInputDamage">
					<scaler type="gameMechanics.elements.scalers.MultLinearEffectScaler">
						<coeff>-0.01</coeff>
						<calcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="calcerDmgIn" />
						</calcer>
					</scaler>
				</Item>
			</effectsIf>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectDisableAction">
			<action href="/Mechanics/Spells/Stalker63/Spells/Strafe/Spell01.(SpellSingleTarget).xdb" />
		</Item>
	</effects>
	<duration>1000</duration>
	<stackLimit>10</stackLimit>
	<isHelpful>false</isHelpful>
	<ranks>
		<Item href="Buff01.(BuffResource).xdb" />
		<Item href="Buff02.(BuffResource).xdb" />
		<Item href="Buff03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
