<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<mode>LOOP</mode>
		<animations>
			<Item>readySpellDirected</Item>
			<Item>channelCastDirected</Item>
		</animations>
		<channel>CHANNEL_DEATH</channel>
		<advanced>
			<speed>2</speed>
		</advanced>
	</actionBarStart>
	<launch type="VisActionList">
		<visActionID>coreflame</visActionID>
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>channelCastDirected</Item>
				</animations>
				<channel>CHANNEL_DEATH</channel>
				<advanced>
					<speed>1.4</speed>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visActionID>flames</visActionID>
				<visualEffects>
					<Item>
						<delay>100</delay>
						<effectFx href="/Spells/FX/Spells/FlamethrowerHenchman_Flame_01.(VisObjectTemplate).xdb" />
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special01</locatorName>
						<offendTime type="EffectOffendConstDelay" />
					</Item>
					<Item>
						<delay>100</delay>
						<effectFx href="/Spells/FX/Spells/FlamethrowerHenchman_Flame_01_AT_Fire.(VisObjectTemplate).xdb" />
						<scale>0.9</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special01</locatorName>
					</Item>
					<Item>
						<delay>100</delay>
						<effectFx href="/Spells/FX/Mobs/DragonUR_FireStart_01.(VisObjectTemplate).xdb" />
						<lockScale>true</lockScale>
						<scale>0.5</scale>
						<locator>Slot_Global</locator>
						<offset y="3.5" />
					</Item>
				</visualEffects>
			</Item>
			<Item type="VisActionList">
				<visActionID>coreflame</visActionID>
				<elements>
					<Item type="VisActionDelay">
						<time>1750</time>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>flames</stoppedActionID>
					</Item>
					<Item type="VisActionStopAction">
						<stoppedActionID>cleavelock</stoppedActionID>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureLockRotationAction">
				<visActionID>cleavelock</visActionID>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
