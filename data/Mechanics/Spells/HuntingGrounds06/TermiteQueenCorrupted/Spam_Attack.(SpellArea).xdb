<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>199137</resourceId>
    </Header>
    <Name href="Spam_Attack.(SpellArea).Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>50</value>
    </range>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>2000</duration>
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledPhysicalDamage">
                <impactsOnHitTarget>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff href="Spam_Attack_Slow_Buff.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </impactsOnHitTarget>
                <scaler type="gameMechanics.elements.scalers.WeaponScaler" />
                <minDamage>16</minDamage>
                <maxDamage>20</maxDamage>
            </Item>
        </targetImpacts>
    </mechanics>
    <shape type="gameMechanics.constructor.schemes.spell.area.Cone">
        <angle type="constructor.basicElements.AngleDegrees">
            <value>40</value>
        </angle>
    </shape>
    <radius>40</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>