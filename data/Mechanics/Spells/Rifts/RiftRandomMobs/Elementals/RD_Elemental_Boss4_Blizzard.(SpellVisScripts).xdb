<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>readySpell</Item>
        </animations>
        <channel>CHANNEL_ATTACK</channel>
    </actionBarStart>
    <wholeCasting type="CreatureLockRotationAction" />
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureAnimationAction">
                        <animations>
                            <Item>spellCastOmni</Item>
                        </animations>
                    </Item>
                    <Item type="CreatureVisActionStartThrow" />
                </elements>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="CreatureLockRotationAction">
                        <visActionID>LockRotation</visActionID>
                    </Item>
                    <Item type="VisActionDelay">
                        <time>600</time>
                    </Item>
                    <Item type="VisActionStopAction">
                        <stoppedActionID>LockRotation</stoppedActionID>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>