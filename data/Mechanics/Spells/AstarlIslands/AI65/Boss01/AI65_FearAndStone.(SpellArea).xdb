<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
    <Header>
        <resourceId>191106</resourceId>
    </Header>
    <Name href="AI65_FearAndStone.(SpellArea).Name.txt" />
    <visualScripts href="AI65_FearAndStone.(SpellVisScripts).xdb" />
    <prepareDuration>1000</prepareDuration>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>18000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="AI65_GlobalBossCD.(BuffResource).xdb" />
                </predicate>
            </Item>
        </casterConditions>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                    </Item>
                </predicates>
            </Item>
        </targetConditions>
        <casterImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="AI65_GlobalBossCD.(BuffResource).xdb" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff href="AI65_Fear.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impactsIf>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>1500</delay>
                        <impacts>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="AI65_FearForNoBrainMerc.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impactsIf>
            </Item>
        </targetImpacts>
    </mechanics>
    <radius>75</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>