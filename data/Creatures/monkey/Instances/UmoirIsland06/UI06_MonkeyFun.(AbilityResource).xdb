<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>115144</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDisableActionsGroup">
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>15</radius>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="UI06_MonkeyStop.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </predicates>
                                            <impactsElse>
                                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                                    <buff href="UI06_MonkeyFear.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                                </Item>
                                            </impactsElse>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectSpeedModifier">
            <effectScaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.7</coeff>
            </effectScaler>
        </Item>
        <Item type="gameMechanics.elements.effects.LifeGuard">
            <level>1</level>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToSpellFromGroup">
            <groups>
                <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
            </groups>
        </Item>
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.basicElements.PredicateGenericNot">
                    <predicate type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                        <groups>
                            <Item href="/Mechanics/Spells/Groups/QuestSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                        </groups>
                    </predicate>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectIfOverTime">
            <predicates>
                <Item type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="UI06_MonkeyFear.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </predicates>
            <impactsIf>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="UI06_MonkeyStop.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIf>
            <runImpactsOnEachTick>true</runImpactsOnEachTick>
            <tick type="gameMechanics.elements.calcers.FloatData">
                <value>11000</value>
            </tick>
        </Item>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>All</affectGroup>
            <radius>30</radius>
            <filter type="gameMechanics.world.creature.AvatarFilter" />
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.ReturningImpact">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllAggro" />
                    </impacts>
                </Item>
            </impactsOut>
        </Item>
    </effects>
    <disableWhileDead>true</disableWhileDead>
</gameMechanics.constructor.schemes.ability.AbilityResource>