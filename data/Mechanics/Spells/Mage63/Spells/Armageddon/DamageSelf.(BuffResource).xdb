<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>208031</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="DamageSelf.(BuffResource).Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.ImpactsOverTime">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                                <radius>20</radius>
                                <affectGroup>Enemies</affectGroup>
                                <affectHolder>false</affectHolder>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                                    <value>0.666</value>
                                                </chanceCalcer>
                                                <impacts>
                                                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
                                                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                                            <value>0.5</value>
                                                        </chanceCalcer>
                                                        <impacts>
                                                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                                <element>LIGHTNING</element>
                                                                <forceAE>true</forceAE>
                                                                <damage>1</damage>
                                                                <impactsOnHitTarget>
                                                                    <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                                                        <data href="LightningVisual.(ClientData).xdb" />
                                                                    </Item>
                                                                </impactsOnHitTarget>
                                                                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                                    <scalers>
                                                                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                            <mul>0.1</mul>
                                                                            <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                                                                <dressSlot>AMMO</dressSlot>
                                                                            </mulCalcer>
                                                                            <sum>1</sum>
                                                                        </Item>
                                                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                                <externalCalcer href="CalcerDamage.(CalcerFloatResource).xdb" />
                                                                            </mulCalcer>
                                                                        </Item>
                                                                        <Item type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                                                            <buff href="DmgCalc.(BuffResource).xdb" />
                                                                            <anyRank>true</anyRank>
                                                                            <onlyFromMaster>false</onlyFromMaster>
                                                                            <mul>1</mul>
                                                                            <sum>1</sum>
                                                                        </Item>
                                                                    </scalers>
                                                                </scaler>
                                                            </Item>
                                                        </impacts>
                                                        <impactsLose>
                                                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                                <element>COLD</element>
                                                                <forceAE>true</forceAE>
                                                                <damage>1</damage>
                                                                <impactsOnHitTarget>
                                                                    <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                                                        <data href="ColdVisual.(ClientData).xdb" />
                                                                    </Item>
                                                                </impactsOnHitTarget>
                                                                <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                                    <scalers>
                                                                        <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                            <mul>0.1</mul>
                                                                            <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                                                                <dressSlot>AMMO</dressSlot>
                                                                            </mulCalcer>
                                                                            <sum>1</sum>
                                                                        </Item>
                                                                        <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                            <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                                <externalCalcer href="CalcerDamage.(CalcerFloatResource).xdb" />
                                                                            </mulCalcer>
                                                                        </Item>
                                                                        <Item type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                                                            <buff href="DmgCalc.(BuffResource).xdb" />
                                                                            <anyRank>true</anyRank>
                                                                            <onlyFromMaster>false</onlyFromMaster>
                                                                            <mul>1</mul>
                                                                            <sum>1</sum>
                                                                        </Item>
                                                                    </scalers>
                                                                </scaler>
                                                            </Item>
                                                        </impactsLose>
                                                    </Item>
                                                </impacts>
                                                <impactsLose>
                                                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                                        <element>FIRE</element>
                                                        <forceAE>true</forceAE>
                                                        <damage>1</damage>
                                                        <impactsOnHitTarget>
                                                            <Item type="gameMechanics.elements.impacts.ImpactClientData">
                                                                <data href="FireVisual.(ClientData).xdb" />
                                                            </Item>
                                                        </impactsOnHitTarget>
                                                        <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                                            <scalers>
                                                                <Item type="gameMechanics.elements.scalers.MagicScaler" />
                                                                <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                    <mul>0.1</mul>
                                                                    <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                                                                        <dressSlot>AMMO</dressSlot>
                                                                    </mulCalcer>
                                                                    <sum>1</sum>
                                                                </Item>
                                                                <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                                                        <externalCalcer href="CalcerDamage.(CalcerFloatResource).xdb" />
                                                                    </mulCalcer>
                                                                </Item>
                                                                <Item type="gameMechanics.elements.scalers.TargetBuffStackCountScaler">
                                                                    <buff href="DmgCalc.(BuffResource).xdb" />
                                                                    <anyRank>true</anyRank>
                                                                    <onlyFromMaster>false</onlyFromMaster>
                                                                    <mul>1</mul>
                                                                    <sum>1</sum>
                                                                </Item>
                                                            </scalers>
                                                        </scaler>
                                                    </Item>
                                                </impactsLose>
                                            </Item>
                                        </impacts>
                                        <groupRepeaters>true</groupRepeaters>
                                    </Item>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier>0.25</multiplier>
                                        </durationScaler>
                                    </Item>
                                </impacts>
                            </Item>
                            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                <buff href="DmgCalc.(BuffResource).xdb" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
                <tick>1000</tick>
            </effect>
            <ticksCount var="ticksCount" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ForceDetach.(BuffResource).xdb" />
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <isStackable>false</isStackable>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Damage01.(BuffResource).xdb" />
        <Item href="Damage02.(BuffResource).xdb" />
        <Item href="Damage03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>