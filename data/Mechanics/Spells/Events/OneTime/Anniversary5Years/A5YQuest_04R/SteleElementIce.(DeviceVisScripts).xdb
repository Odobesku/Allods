<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
	<defaultVisAction type="DeviceIfFlagVisAction">
		<visualFlag href="Ice.(VisualFlag).xdb#xpointer(/VisualFlag)" />
		<visScriptStart />
		<visScriptLoop type="DeviceVisEffectsAction">
			<visualEffects>
				<Item>
					<locatorName>Slot_Special01</locatorName>
					<effectFx href="/Spells/FX/World/SteleElementIce_Top.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
					<fadeInTime>400</fadeInTime>
					<fadeOutTime>400</fadeOutTime>
				</Item>
			</visualEffects>
		</visScriptLoop>
		<visScriptEnd />
	</defaultVisAction>
</DeviceVisScripts>
