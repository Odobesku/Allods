<?xml version="1.0" encoding="UTF-8"?>
<gameMechanics.constructor.schemes.mount.MountSkin>
	<Header>
		<resourceId>740033145</resourceId>
	</Header>
	<Description href="ExoMount05Premium.(MountSkin).Description.txt" />
	<Name href="ExoMount05Premium.(MountSkin).Name.txt" />
	<SourceDescription href="/Mechanics/Premium/Items/ItemProto.(ItemResource).Name.txt" />
	<image href="/Interface/Icons/Mounts/MountExoskeletV5Premium.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
	<unlock href="ExoMount05Premium.(UnlockResource).xdb#xpointer(/gameMechanics.constructor.schemes.unlock.UnlockResource)" />
	<visualMount href="/Client/VisualMounts/Exoskeleton/Exoskeleton05Premium.(VisualMount).xdb#xpointer(/VisualMount)" />
	<visualScript type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureChangeVisItemsAction">
				<items>
					<Item>
						<newItem href="/Items/VisualItems/Armor/Plate_E_85Exo5Premium.(VisualItem).xdb#xpointer(/gameMechanics.constructor.schemes.item.VisualItem)" />
						<slot>EARRING2</slot>
					</Item>
				</items>
				<isGfxCondition>false</isGfxCondition>
				<leaveWeapons>true</leaveWeapons>
				<notForDolls>true</notForDolls>
				<removeAllItems>false</removeAllItems>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<playWhile type="client.SLON.PredicateExoVisualAllowedAction">
			<checkType>ALL</checkType>
			<checkIsNotSet>false</checkIsNotSet>
		</playWhile>
		<preconditional>true</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</visualScript>
	<p2p>true</p2p>
</gameMechanics.constructor.schemes.mount.MountSkin>