<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Variables>
			<CastAnimationWand>spellCastOmniWand</CastAnimationWand>
			<Wand_CastFX />
			<CastAnimation_NoWand>spellCastOmni</CastAnimation_NoWand>
			<CastFX />
		</Variables>
	</Header>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateAvatarClassAction">
					<classes>
						<Item href="/Mechanics/Classes/Mage.xdb" />
						<Item href="/Mechanics/Classes/Necromancer.xdb" />
						<Item href="/Mechanics/Classes/Priest.xdb" />
						<Item href="/Mechanics/Classes/Druid.xdb" />
					</classes>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item var="CastAnimationWand" />
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<channelOverrideScript />
						<advanced>
							<offendType>ONEOFFEND_ONETARGET</offendType>
						</advanced>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>350</delay>
								<effectFx hrefvar="Wand_CastFX" />
								<effectAlias href="" />
								<fixPoint>false</fixPoint>
								<locator>Wand_Slot_FX</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateAvatarClassAction">
					<classes>
						<Item href="/Mechanics/Classes/Bard.xdb" />
						<Item href="/Mechanics/Classes/Engineer.xdb" />
						<Item href="/Mechanics/Classes/Paladin.xdb" />
						<Item href="/Mechanics/Classes/Psionic.xdb" />
						<Item href="/Mechanics/Classes/Stalker.xdb" />
						<Item href="/Mechanics/Classes/Warrior.xdb" />
					</classes>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item var="CastAnimation_NoWand" />
						</animations>
						<channel>CHANNEL_ABILITY</channel>
						<channelOverrideScript />
						<advanced>
							<offendType>ONEOFFEND_ONETARGET</offendType>
						</advanced>
					</Item>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<delay>350</delay>
								<effectFx hrefvar="CastFX" />
								<effectAlias href="" />
								<fixPoint>true</fixPoint>
								<locator>Slot_Hand_L</locator>
								<offendTime />
							</Item>
						</visualEffects>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
