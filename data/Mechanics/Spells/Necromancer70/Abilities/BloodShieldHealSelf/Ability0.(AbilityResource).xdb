<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739933309</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="heal" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercent</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Necromancer/NecromancerBloodpact.chn.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffExtraEffects">
            <buffs>
                <Item href="/Mechanics/Spells/CommonBuffs/Aspects/Heal/Buff01.(BuffResource).xdb" />
            </buffs>
            <effects>
                <Item type="gameMechanics.elements.effects.BuffExtraEffects">
                    <buffs>
                        <Item href="/Mechanics/Spells/Necromancer70/Spells/BloodShield/Buff001.xdb" />
                    </buffs>
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectsIf">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateNotMaster" />
                            </predicates>
                            <effectsIf>
                                <Item type="gameMechanics.elements.effects.IncomingHealScaledImpacts">
                                    <affectsPureHeal>true</affectsPureHeal>
                                    <scaler type="gameMechanics.constructor.basicElements.TrivialEffectScaler" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                                                    <impacts>
                                                        <Item type="gameMechanics.elements.impacts.PureHeal">
                                                            <heal var="heal" />
                                                        </Item>
                                                    </impacts>
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.offender.PredicateOffenderIsCaster" />
                                    </predicates>
                                    <addressee type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                </Item>
                            </effectsIf>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
    <ranks>
        <Item href="Ability001.xdb" />
        <Item href="Ability002.xdb" />
        <Item href="Ability003.xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>