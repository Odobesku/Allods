<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
    <Name>ButtonLogout</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_BOTH</Align>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_LOW</Align>
            <Pos>180</Pos>
            <Size>28</Size>
            <Sizing>WIDGET_SIZING_DEFAULT</Sizing>
        </Y>
        <QuantumScale>false</QuantumScale>
    </Placement>
    <Priority>0</Priority>
    <TabOrder>0</TabOrder>
    <fade>1</fade>
    <forceReactionOnPointing></forceReactionOnPointing>
    <reactionOnPointing></reactionOnPointing>
    <reactionWheelDown></reactionWheelDown>
    <reactionWheelUp></reactionWheelUp>
    <Enabled>true</Enabled>
    <IgnoreDblClick>true</IgnoreDblClick>
    <PickChildrenOnly>false</PickChildrenOnly>
    <TransparentInput>false</TransparentInput>
    <Visible>true</Visible>
    <clipContent>true</clipContent>
    <forceWheel>false</forceWheel>
    <isProtected>false</isProtected>
    <TextStyle>
        <Align>ALIGNY_MIDDLE</Align>
        <blendEffect>BLEND_EFFECT_ALPHABLND</blendEffect>
        <ellipsis>true</ellipsis>
        <multiline>false</multiline>
        <showClippedLine>false</showClippedLine>
        <showClippedSymbol>false</showClippedSymbol>
        <wrapText>false</wrapText>
    </TextStyle>
    <TextTag>button_label</TextTag>
    <Variants>
        <Item>
            <LayerHighlight href="/Interface/Ingame/ContextMenu/MenuButtonHighlight.(WidgetLayerTiledTexture).xdb#xpointer(/client.Widgets.WidgetLayerTiledTexture)"/>
            <PushedOffset x="-2" y="1"/>
            <Reaction>menu_logout</Reaction>
            <ReactionRightClick>menu_logout</ReactionRightClick>
            <StateDisabled>
                <FormatFileRef href="/Interface/Ingame/ContextMenu/MenuButtonDisabled.txt"/>
            </StateDisabled>
            <StateHighlighted>
                <FormatFileRef href="/Interface/Ingame/ContextMenu/MenuButtonHighlighted.txt"/>
            </StateHighlighted>
            <StateNormal>
                <FormatFileRef href="/Interface/Ingame/ContextMenu/MenuButtonNormal.txt"/>
            </StateNormal>
            <StatePushed/>
            <StatePushedHighlighted/>
            <TextFileRef href="/Interface/Ingame/ContextMenu/ButtonLogout.txt"/>
            <reactionDblClick></reactionDblClick>
            <ReactionOnUp>true</ReactionOnUp>
        </Item>
    </Variants>
    <useDefaultSounds>true</useDefaultSounds>
</WidgetButton>
