<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Jaga_BallHitRecently_Blue.(VisObjectTemplate).xdb" />
						<fixPoint>true</fixPoint>
						<lockScale>true</lockScale>
						<scale>1.25</scale>
						<fadeInTime>1000</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<locator>Slot_Global</locator>
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Jaga_Blue_BallInside.(VisObjectTemplate).xdb" />
						<fadeInTime>1000</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<locator>Slot_Hand_L</locator>
						<offset z="-0.25" />
					</Item>
					<Item>
						<effectFx href="/Spells/FX/Mobs/Jaga_Blue_BallInside.(VisObjectTemplate).xdb" />
						<fadeInTime>1000</fadeInTime>
						<fadeOutTime>1000</fadeOutTime>
						<locator>Slot_Hand_R</locator>
						<offset z="-0.25" />
