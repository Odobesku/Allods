<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739964026</resourceId>
    </Header>
    <Name href="Projectile.(ProjectileResource).Name.txt" />
    <needVisualize>false</needVisualize>
    <needVisualizeDuration>false</needVisualizeDuration>
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <damagePerTick>0.25</damagePerTick>
                <affectOnStartTick>true</affectOnStartTick>
                <affectedByDoubleAttack>true</affectedByDoubleAttack>
            </parameters>
            <element>FIRE</element>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                            <externalCalcer href="Calcer.(CalcerFloatResource).xdb" />
                        </mulCalcer>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                </scalers>
            </scaler>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.buff.BuffResource>