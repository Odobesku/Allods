				</visualEffects>
			</Item>
			<Item type="CreatureParalyzeAction" />
			<Item type="ProceduralEffectVisAction">
				<proceduralEffect href="/Spells/FX/InterfaceFX/Ice.(ProceduralEffect).xdb#xpointer(/ProceduralEffect)" />
