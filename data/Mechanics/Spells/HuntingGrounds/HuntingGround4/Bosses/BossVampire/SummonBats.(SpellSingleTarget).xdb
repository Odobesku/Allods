<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739870829</resourceId>
    </Header>
    <Name href="SummonBats.(SpellSingleTarget).Name.txt" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>1</value>
    </range>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>60000</duration>
        </cooldown>
        <casterConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                    <buff href="VampireTransform.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </predicate>
            </Item>
        </casterConditions>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                <impact type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactSummon">
                            <destination type="gameMechanics.map.destination.DestinationModified">
                                <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                <modifiers>
                                    <Item type="gameMechanics.map.destination.modifier.ModifierSelectReachable">
                                        <alternatives>
                                            <Item type="gameMechanics.map.destination.modifier.ModifierRelativeRandomDir">
                                                <radius type="gameMechanics.elements.calcers.FloatData">
                                                    <value>7</value>
                                                </radius>
                                            </Item>
                                        </alternatives>
                                    </Item>
                                </modifiers>
                            </destination>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                <Item type="gameMechanics.elements.impacts.ImpactSetAllAggro" />
                            </impacts>
                            <object href="/Creatures/Bat/Instances/HuntingGround4/BatAdd.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                            <pool href="AddPool.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                            <isPersonalPool>true</isPersonalPool>
                        </Item>
                    </impacts>
                </impact>
                <count type="gameMechanics.elements.calcers.FloatData">
                    <value>5</value>
                </count>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>