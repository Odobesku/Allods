<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.rules.RuleResource>
    <Header>
        <resourceId>230857</resourceId>
    </Header>
    <name href="AstralArena.(RuleResource).Name.txt" />
    <description href="AstralArena.(RuleResource).Description.txt" />
    <timeTable href="AstralArena.(TimePeriodTable).xdb" />
    <effects>
        <Item type="gameMechanics.world.bigAstral.elements.EffectEnableSpawnTable">
            <mapResource href="/Mechanics/Astral/Sectors/NewbieAstral/Hadagan/StaticHubs/Hadagan/MapResource.xdb" />
            <spawnResource href="/Mechanics/Astral/Sectors/Dynamic/AstralArena/Entrance/Wormhole.(SpawnTable).xdb" />
            <forceDespawn>true</forceDespawn>
        </Item>
        <Item type="gameMechanics.world.bigAstral.elements.EffectEnableSpawnTable">
            <mapResource href="/Mechanics/Astral/Sectors/NewbieAstral/Kania/StaticHubs/Kania/MapResource.xdb" />
            <spawnResource href="/Mechanics/Astral/Sectors/Dynamic/AstralArena/Entrance/Wormhole.(SpawnTable).xdb" />
            <forceDespawn>true</forceDespawn>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                            <lhs type="gameMechanics.elements.calcers.LongData">
                                <value>4</value>
                            </lhs>
                            <rhs type="itemService.serverVariables.CalcerServerVariable">
                                <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                            </rhs>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.world.bigAstral.elements.ImpactActivateSector">
                            <sectors>
                                <Item>
                                    <mapVisible>false</mapVisible>
                                    <astrolabeVisible>false</astrolabeVisible>
                                    <astralTier href="/Mechanics/Astral/Addons/Addon07/SeasonTier4.(TierLevel).xdb" />
                                    <avatarTier href="/Mechanics/Astral/Addons/Addon07/DifficultyTier2.(TierDifficulty).xdb" />
                                    <avatarLevel>1</avatarLevel>
                                    <resource href="/Mechanics/Astral/Sectors/Dynamic/AstralArena/Sector.(AstralSectorResource).xdb" />
                                </Item>
                            </sectors>
                            <addonResource href="/Mechanics/Astral/Addons/Addon07/AstralAddon.(AstralAddonResource).xdb" />
                        </Item>
                    </impactsIf>
                    <impactsElse>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                    <lhs type="gameMechanics.elements.calcers.LongData">
                                        <value>3</value>
                                    </lhs>
                                    <rhs type="itemService.serverVariables.CalcerServerVariable">
                                        <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                                    </rhs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.world.bigAstral.elements.ImpactActivateSector">
                                    <sectors>
                                        <Item>
                                            <mapVisible>false</mapVisible>
                                            <astrolabeVisible>false</astrolabeVisible>
                                            <astralTier href="/Mechanics/Astral/Addons/Addon07/SeasonTier3.(TierLevel).xdb" />
                                            <avatarTier href="/Mechanics/Astral/Addons/Addon07/DifficultyTier2.(TierDifficulty).xdb" />
                                            <avatarLevel>1</avatarLevel>
                                            <resource href="/Mechanics/Astral/Sectors/Dynamic/AstralArena/Sector.(AstralSectorResource).xdb" />
                                        </Item>
                                    </sectors>
                                    <addonResource href="/Mechanics/Astral/Addons/Addon07/AstralAddon.(AstralAddonResource).xdb" />
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.predicates.PredicateEqualsLong">
                                            <lhs type="gameMechanics.elements.calcers.LongData">
                                                <value>2</value>
                                            </lhs>
                                            <rhs type="itemService.serverVariables.CalcerServerVariable">
                                                <variableResource href="/Mechanics/Rules/HighEnd7/Seasons_v7.(ServerVariableResource).xdb" />
                                            </rhs>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.world.bigAstral.elements.ImpactActivateSector">
                                            <sectors>
                                                <Item>
                                                    <mapVisible>false</mapVisible>
                                                    <astrolabeVisible>false</astrolabeVisible>
                                                    <astralTier href="/Mechanics/Astral/Addons/Addon07/SeasonTier2.(TierLevel).xdb" />
                                                    <avatarTier href="/Mechanics/Astral/Addons/Addon07/DifficultyTier2.(TierDifficulty).xdb" />
                                                    <avatarLevel>1</avatarLevel>
                                                    <resource href="/Mechanics/Astral/Sectors/Dynamic/AstralArena/Sector.(AstralSectorResource).xdb" />
                                                </Item>
                                            </sectors>
                                            <addonResource href="/Mechanics/Astral/Addons/Addon07/AstralAddon.(AstralAddonResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.world.bigAstral.elements.ImpactActivateSector">
                                            <sectors>
                                                <Item>
                                                    <mapVisible>false</mapVisible>
                                                    <astrolabeVisible>false</astrolabeVisible>
                                                    <astralTier href="/Mechanics/Astral/Addons/Addon07/SeasonTier1.(TierLevel).xdb" />
                                                    <avatarTier href="/Mechanics/Astral/Addons/Addon07/DifficultyTier2.(TierDifficulty).xdb" />
                                                    <avatarLevel>1</avatarLevel>
                                                    <resource href="/Mechanics/Astral/Sectors/Dynamic/AstralArena/Sector.(AstralSectorResource).xdb" />
                                                </Item>
                                            </sectors>
                                            <addonResource href="/Mechanics/Astral/Addons/Addon07/AstralAddon.(AstralAddonResource).xdb" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impactsElse>
                </Item>
            </impactsOn>
        </Item>
    </effects>
    <finishImpacts>
        <Item type="gameMechanics.world.bigAstral.elements.ImpactDeactivateSector">
            <resource href="/Mechanics/Astral/Sectors/Dynamic/AstralArena/Sector.(AstralSectorResource).xdb" />
        </Item>
    </finishImpacts>
    <internal>true</internal>
    <canBeDisabled>true</canBeDisabled>
</gameMechanics.world.rules.RuleResource>