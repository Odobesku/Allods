<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739940318</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<visScript href="/Spells/VisScripts/Bard/ElegyUpgrade_Buff.(BuffVisScripts).xdb" />
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
			<effect type="gameMechanics.elements.effects.ImpactsOverTime">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
						<predicates>
							<Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
								<buff hrefvar="buff" />
								<range>
									<min>4</min>
									<max>4</max>
								</range>
							</Item>
						</predicates>
						<impactsElse>
							<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
								<buff hrefvar="buff" />
								<resetTimer>false</resetTimer>
							</Item>
						</impactsElse>
					</Item>
					<Item type="gameMechanics.elements.impacts.MarkedImpact">
						<mark href="HardRockOnTargetTick.(MarkResource).xdb" />
					</Item>
				</impacts>
				<tick>1000</tick>
			</effect>
			<ticksCount>4</ticksCount>
		</Item>
	</effects>
	<isStackable>false</isStackable>
	<isHelpful>false</isHelpful>
	<isMultiple>true</isMultiple>
	<ranks>
		<Item href="BuffAttacher01.(BuffResource).xdb" />
		<Item href="BuffAttacher02.(BuffResource).xdb" />
		<Item href="BuffAttacher03.(BuffResource).xdb" />
	</ranks>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
