<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>739952565</resourceId>
    </Header>
    <lifeLengthCap>25000</lifeLengthCap>
    <plane href="ProjectilePlane.(Plane).xdb" />
    <impactsOnDeath>
        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
            <impacts>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ProjectileBuff.(BuffResource).xdb" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                </Item>
            </impacts>
        </Item>
    </impactsOnDeath>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ProjectileBuff.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </impactsOnStart>
    <effects>
        <Item type="gameMechanics.elements.effects.BuffAura">
            <affectGroup>All</affectGroup>
            <radius>30</radius>
            <buff href="Architect_spy_vis.(BuffResource).xdb" />
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>