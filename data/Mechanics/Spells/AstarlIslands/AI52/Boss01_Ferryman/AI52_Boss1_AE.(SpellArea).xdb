<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.area.SpellArea>
	<Header>
		<resourceId>739825654</resourceId>
	</Header>
	<element>FIRE</element>
	<Name href="AI52_Boss1_AE.(SpellArea).Name.txt" />
	<nameTemplate href="AI52_Boss1_AE.(SpellArea)_Name.txt.template" />
	<triggersGlobalCooldown>false</triggersGlobalCooldown>
	<mechanics>
		<cooldown>
			<duration>4000</duration>
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.constructor.basicElements.PredicateNot">
				<predicate type="gameMechanics.elements.resources.ResourceBuff">
					<buff href="AI52_Boss1_rage.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
				</predicate>
			</Item>
		</casterConditions>
		<targetConditions>
			<Item type="gameMechanics.elements.predicates.PredicateCreature" />
			<Item type="gameMechanics.constructor.basicElements.PredicateOr">
				<predicates>
					<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
					</Item>
				</predicates>
			</Item>
		</targetConditions>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
				<projectileData>
					<moveType type="gameMechanics.world.projectile.MoveTypeIdle">
						<destination type="gameMechanics.map.destination.RelativePos" />
					</moveType>
					<resource href="AI52_Boss1_Projectile01.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
				</projectileData>
			</Item>
		</targetImpacts>
	</mechanics>
	<maxTargets>1</maxTargets>
	<shapeCenterPosition>Caster</shapeCenterPosition>
	<radius>85</radius>
</gameMechanics.constructor.schemes.spell.area.SpellArea>
