<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
  <action type="client.Replica.VisActionList">
    <elements>
      <Item type="client.Replica.CreatureSetTransparencyAction">
        <fadeMult>1</fadeMult>
        <priority>1</priority>
        <transparency>0.599999964</transparency>
      </Item>
      <Item type="client.Replica.PostEffectVisAction">
        <userPostEffect href="/Spells/FX/InterfaceFX/Chost.(UserPostEffect).xdb#xpointer(/client.VisualConstructor.UserPostEffect)" />
      </Item>
      <Item type="client.Replica.CreatureReplaceAnimationsAction">
        <member>Default_Member</member>
        <onBottom>
          <animationsReplacements>
            <Item>
              <forAnimations>
                <Item>idle</Item>
                <Item>idle01</Item>
                <Item>idle02</Item>
                <Item>idle03</Item>
                <Item>walk</Item>
                <Item>run</Item>
              </forAnimations>
              <play>fly</play>
            </Item>
          </animationsReplacements>
          <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
        </onBottom>
        <onMount>
          <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
        </onMount>
        <onTop>
          <animationsReplacements>
            <Item>
              <forAnimations>
                <Item>idle</Item>
                <Item>idle01</Item>
                <Item>idle02</Item>
                <Item>idle03</Item>
                <Item>walk</Item>
                <Item>run</Item>
              </forAnimations>
              <play>fly</play>
            </Item>
          </animationsReplacements>
          <skipAnimationIfNoReplacement>false</skipAnimationIfNoReplacement>
        </onTop>
        <replaceWhen>ReplaceAlways</replaceWhen>
        <restartOnVisualChange>false</restartOnVisualChange>
      </Item>
    </elements>
    <play>Simultaneously</play>
    <preconditional>false</preconditional>
    <restartOnVisualChange>false</restartOnVisualChange>
    <stopOnDeath>false</stopOnDeath>
    <stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
  </action>
  <restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>