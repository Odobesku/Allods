<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureStepSoundParamAction">
				<param>
					<parameter href="ExoFootsteps.(SoundParameter).xdb#xpointer(/SoundParameter)" />
					<value>0.3</value>
				</param>
				<onlyIfOnMainAvatar>false</onlyIfOnMainAvatar>
			</Item>
		</elements>
		<restartOnVisualChange>false</restartOnVisualChange>
	</action>
</BuffVisScripts>
