            <component type="DelayComponent">
                <VisualObjectComponentID></VisualObjectComponentID>
                <component type="StopVisObjectComponents">
                    <VisualObjectComponentID></VisualObjectComponentID>
                    <stopedComponentIDs>
                        <Item>PortalGuard_Death</Item>
                    </stopedComponentIDs>
