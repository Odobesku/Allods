<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>readySpellDirected</Item>
        </animations>
        <channel>CHANNEL_DEATH</channel>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
            </Item>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <elements>
                    <Item type="CreatureEffectsAction">
                        <visualEffects>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/FlamethrowerHenchman_Flame_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <scale>0.5</scale>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Special01</locatorName>
                            </Item>
                            <Item>
                                <effectFx href="/Spells/FX/Spells/FlamethrowerHenchman_Flame_01_AT_Fire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                                <scale>0.45</scale>
                                <locator>FROM_LOCATOR_NAME</locator>
                                <locatorName>Slot_Special01</locatorName>
                            </Item>
                        </visualEffects>
                    </Item>
                </elements>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>