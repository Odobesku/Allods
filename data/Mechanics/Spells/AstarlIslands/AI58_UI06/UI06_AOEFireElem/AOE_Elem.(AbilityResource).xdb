<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739848710</resourceId>
	</Header>
	<name href="AOE_Elem.(AbilityResource).Name.txt" />
	<effects>
		<Item type="gameMechanics.elements.effects.ImpactsOnStrike">
			<impactsToTarget>
				<Item type="gameMechanics.elements.impacts.ProbabilisticImpact">
					<chanceCalcer type="gameMechanics.elements.calcers.FloatData">
						<value>0.2</value>
					</chanceCalcer>
					<impacts>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="AOE_Elem_burn.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
						</Item>
					</impacts>
				</Item>
			</impactsToTarget>
		</Item>
		<Item type="gameMechanics.elements.effects.DeathTrigger">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
							<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
							<data href="AOE_Elem_Burst.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
						</Item>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
									<radius>6</radius>
									<affectGroup>Enemies</affectGroup>
									<impacts>
										<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
											<element>FIRE</element>
											<damage>30</damage>
										</Item>
									</impacts>
									<filter type="gameMechanics.constructor.basicElements.FilterPredicates">
										<predicates>
											<Item type="gameMechanics.constructor.basicElements.PredicateOr">
												<predicates>
													<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
													<Item type="gameMechanics.elements.resources.ResourceBuff">
														<buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
													</Item>
												</predicates>
											</Item>
										</predicates>
									</filter>
								</Item>
							</impacts>
						</Item>
					</impacts>
				</Item>
			</impacts>
		</Item>
	</effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>
