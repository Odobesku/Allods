<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>206361</resourceId>
    </Header>
    <name href="CanonsAbility.(AbilityResource).Name.txt" />
    <description href="CanonsAbility.(AbilityResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Paladin/Canon_Of_Light.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectVariable">
            <resource href="LightCanon.(VariableResource).xdb" />
            <impactsOnChange>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateVariableEquals">
                                        <resource href="LightCanon.(VariableResource).xdb" />
                                        <value>1</value>
                                    </predicate>
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableReset">
                            <variable href="LightCanon.(VariableResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOnChange>
            <impactsOnInc>
                <Item type="gameMechanics.elements.impacts.RepeatedImpactScale">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="CanonGained.(MarkResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnInc>
            <impactsOnDec>
                <Item type="gameMechanics.elements.impacts.RepeatedImpactScale">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="CanonSpent.(MarkResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnDec>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectVariable">
            <resource href="PurityCanon.(VariableResource).xdb" />
            <impactsOnChange>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                            <predicates>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                </Item>
                                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                    <predicate type="gameMechanics.elements.predicates.PredicateVariableEquals">
                                        <resource href="PurityCanon.(VariableResource).xdb" />
                                        <value>1</value>
                                    </predicate>
                                </Item>
                            </predicates>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.ImpactVariableReset">
                            <variable href="PurityCanon.(VariableResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOnChange>
            <impactsOnInc>
                <Item type="gameMechanics.elements.impacts.RepeatedImpactScale">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="CanonGained.(MarkResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnInc>
            <impactsOnDec>
                <Item type="gameMechanics.elements.impacts.RepeatedImpactScale">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.MarkedImpact">
                                    <mark href="CanonSpent.(MarkResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOnDec>
        </Item>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                            <delay>5000</delay>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableReset">
                                            <variable href="PurityCanon.(VariableResource).xdb" />
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactVariableReset">
                                            <variable href="LightCanon.(VariableResource).xdb" />
                                        </Item>
                                    </impactsIf>
                                </Item>
                                <Item type="gameMechanics.elements.effects.ImpactDamageDamageThreshold">
                                    <damage>1</damage>
                                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                    </scalerTarget>
                                    <resource href="/Mechanics/Spells/CommonEffects/CommonClass_Full_Threshold.(DamageThresholdResource).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
            <effects>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                    <ability href="/Mechanics/Spells/Paladin63/Abilities/CanonsFastRegen/CanonsFastRegenAbility.(AbilityResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <effectsIf>
                                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateVariableLessThan">
                                                    <resource href="LightCanon.(VariableResource).xdb" />
                                                    <value>3</value>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                                    <variable href="LightCanon.(VariableResource).xdb" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateVariableLessThan">
                                                    <resource href="PurityCanon.(VariableResource).xdb" />
                                                    <value>3</value>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                                    <variable href="PurityCanon.(VariableResource).xdb" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                    <tick>8000</tick>
                                    <initialDelay>8000</initialDelay>
                                </Item>
                            </effectsIf>
                            <effectsElse>
                                <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateVariableLessThan">
                                                    <resource href="LightCanon.(VariableResource).xdb" />
                                                    <value>3</value>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                                    <variable href="LightCanon.(VariableResource).xdb" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                            <predicates>
                                                <Item type="gameMechanics.elements.predicates.PredicateVariableLessThan">
                                                    <resource href="PurityCanon.(VariableResource).xdb" />
                                                    <value>3</value>
                                                </Item>
                                            </predicates>
                                            <impactsIf>
                                                <Item type="gameMechanics.elements.impacts.ImpactVariableSummand">
                                                    <variable href="PurityCanon.(VariableResource).xdb" />
                                                </Item>
                                            </impactsIf>
                                        </Item>
                                    </impacts>
                                    <tick>10000</tick>
                                    <initialDelay>10000</initialDelay>
                                </Item>
                            </effectsElse>
                        </Item>
                        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
                            <impacts>
                                <Item type="gameMechanics.elements.effects.ImpactDamageDamageThreshold">
                                    <damage>1</damage>
                                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mul>0.1</mul>
                                        <mulCalcer type="gameMechanics.elements.effects.DamageThresholdHealthCalcer">
                                            <resource href="/Mechanics/Spells/CommonEffects/CommonClass_Full_Threshold.(DamageThresholdResource).xdb" />
                                        </mulCalcer>
                                    </scalerTarget>
                                    <resource href="/Mechanics/Spells/CommonEffects/CommonClass_Full_Threshold.(DamageThresholdResource).xdb" />
                                </Item>
                            </impacts>
                            <initialDelay>5000</initialDelay>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <effects>
                <Item type="gameMechanics.elements.effects.EffectInstantiating">
                    <effects>
                        <Item type="gameMechanics.elements.effects.DamageThreshold">
                            <healthCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                            <beseHealthScaler type="gameMechanics.elements.scalers.LinearScaler">
                                <multiplier>0</multiplier>
                            </beseHealthScaler>
                            <outOfCombatPolicy>Nothing</outOfCombatPolicy>
                            <resource href="/Mechanics/Spells/CommonEffects/CommonClass_Full_Threshold.(DamageThresholdResource).xdb" />
                            <damageType>Damage</damageType>
                        </Item>
                    </effects>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.ability.AbilityResource>