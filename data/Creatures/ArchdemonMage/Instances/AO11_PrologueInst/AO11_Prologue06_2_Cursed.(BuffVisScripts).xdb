<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.VisActionList">
				<elements>
					<Item type="client.Replica.VisActionChangeVisObject">
						<newVisMob href="/Creatures/FireElemental/TalosShadowElemental.(VisualMob).xdb#xpointer(/VisualMob)" />
						<getBody>true</getBody>
						<getDress>true</getDress>
					</Item>
					<Item type="client.Replica.CreatureAnimationAction">
						<advanced>
							<autoHasten>
								<mode>AUTOHASTEN_NONE</mode>
								<timeToBeLeft>0</timeToBeLeft>
							</autoHasten>
							<changeChannelAfterFirstKey>NOT_CHANGE</changeChannelAfterFirstKey>
							<channelAfterFirstKey>CHANNEL_RETURNING</channelAfterFirstKey>
							<offendType>NO_OFFEND</offendType>
							<speed>0</speed>
							<turnToTarget>TURN_DEFAULT</turnToTarget>
							<waitRealEvent>WAIT_DEFAULT</waitRealEvent>
							<backgroundAfterFirstKey>false</backgroundAfterFirstKey>
							<denyAutoHasten>false</denyAutoHasten>
							<disableRandomFirstFrame>true</disableRandomFirstFrame>
							<eventPlaybackEnd>false</eventPlaybackEnd>
							<skipIfFixedIdleAnimation>false</skipIfFixedIdleAnimation>
							<stopIfMoved>false</stopIfMoved>
							<stopIfRotated>false</stopIfRotated>
						</advanced>
						<animations>
							<Item>specialCast</Item>
						</animations>
						<channel>CHANNEL_KNOCKDOWN</channel>
						<channelOverrideControllers>DEFAULT_CONTROLLERS</channelOverrideControllers>
						<channelOverrideMode>OVERRIDE_DEFAULT</channelOverrideMode>
						<mode>DIE</mode>
						<use>USE_ANIMATIONS</use>
						<dontFreezePrecast>false</dontFreezePrecast>
					</Item>
					<Item type="client.Replica.Sound3DAction">
						<alias href="" />
						<locator>FROM_LOCATOR_NAME</locator>
						<sound>
							<creationRadius>-1</creationRadius>
							<name>Creatures/FireElemental/rangedAttack</name>
							<project href="/SFX/Creatures/Creatures_F.(FMODProject).xdb#xpointer(/FMODProject)" />
						</sound>
						<forcedSoundStop>false</forcedSoundStop>
						<onlyForMainAvatar>false</onlyForMainAvatar>
					</Item>
				</elements>
				<play>InSequence</play>
				<preconditional>false</preconditional>
				<restartOnVisualChange>false</restartOnVisualChange>
				<stopOnDeath>false</stopOnDeath>
				<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
			</Item>
			<Item type="client.Replica.CreatureEffectsAction">
				<category>EFFECT_DEFAULT</category>
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectAlias href="" />
						<effectAnimations>
							<mode>DIE</mode>
						</effectAnimations>
						<effectFx href="/Spells/FX/Spells/8_0_Raid_Kiros_Dark_Projectile_Cast_Slot.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<fadeInTime>0</fadeInTime>
						<fadeOutTime>0</fadeOutTime>
						<scale>1</scale>
						<fixPoint>false</fixPoint>
						<lockScale>false</lockScale>
						<muteFxSounds>false</muteFxSounds>
						<ignoreParentRotation>false</ignoreParentRotation>
						<ignoreProcedureFxScale>false</ignoreProcedureFxScale>
						<locator>Slot_FX</locator>
						<member>Default_Member</member>
						<offset x="0" y="0" z="0" />
						<rotation x="0" y="0" z="0" />
						<useVisObjectSettings>FROM_CASTER</useVisObjectSettings>
					</Item>
				</visualEffects>
				<dontFade>true</dontFade>
				<restartOnVisCreatureChange>true</restartOnVisCreatureChange>
				<stopOnDeath>false</stopOnDeath>
			</Item>
			<Item type="client.SLON.CreatureRenameAction">
				<name href="AO11_Prologue06_2_Cursed.(BuffVisScripts).Name.txt" />
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>