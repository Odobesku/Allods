<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>223221</resourceId>
    </Header>
    <name href="IceFall.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/FerrisRaid_IceSpike_Dynamic.(VisObjectTemplate).xdb" />
    <altitude>0</altitude>
    <lifeLengthCap>6000</lifeLengthCap>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.EntityImpactsDeferred">
                    <delay>4000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
                            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
                            <radius>4</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                    <element>COLD</element>
                                    <damage>50</damage>
                                    <impactsOnHitTarget>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BufffKnockDownNoCC.xdb" />
                                            <durationScaler type="gameMechanics.elements.scalers.ScalerIf">
                                                <condition type="gameMechanics.elements.resources.ResourceBuff">
                                                    <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                                                </condition>
                                                <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier>3</multiplier>
                                                </scalerIf>
                                                <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
                                                    <multiplier>1.5</multiplier>
                                                </scalerElse>
                                            </durationScaler>
                                        </Item>
                                    </impactsOnHitTarget>
                                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AvatarFilter" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>