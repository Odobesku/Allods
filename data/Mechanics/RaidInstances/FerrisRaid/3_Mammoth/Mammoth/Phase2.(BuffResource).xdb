<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>223222</resourceId>
    </Header>
    <Name href="Phase2.(BuffResource).Name.txt" />
    <Description href="Phase2.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/VacuumingLife.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.offender.PredicateOffenderIsCaster" />
                </Item>
            </predicates>
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.DirectHeal">
                        <heal>1</heal>
                    </Item>
                </casterToTarget>
            </impacts>
            <scaleImpactsByDamage>true</scaleImpactsByDamage>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.DirectDamage">
                    <damage>1</damage>
                    <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                            <multiplier>0.00194</multiplier>
                        </mulCalcer>
                    </scalerTarget>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="RiverPull/RiverPull.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.ImpactAggrolistMember">
                                    <selector type="gameMechanics.elements.calcers.RangeSelectorResource">
                                        <range min="0" max="1" />
                                        <withinRange>false</withinRange>
                                        <minCandidatesCount>1</minCandidatesCount>
                                        <targetCount>1</targetCount>
                                    </selector>
                                    <filter type="gameMechanics.world.creature.AvatarFilter" />
                                    <impacts>
                                        <Item>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                                                    <projectileData>
                                                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                                            <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                                        </moveType>
                                                        <resource href="IceFall.(ProjectileResource).xdb" />
                                                    </projectileData>
                                                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                                                </Item>
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impactsElse>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>7000</tick>
            <initialDelay>8000</initialDelay>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAction">
            <action href="RiverPull/RiverPull.(SpellSingleTarget).xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.RandomConditionalImpact">
                            <entries>
                                <Item>
                                    <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Traps/Traps_Buff_1.(BuffResource).xdb" />
                                        </predicate>
                                    </predicate>
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Traps/Traps_Buff_1.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item>
                                    <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Traps/Traps_Buff_2.(BuffResource).xdb" />
                                        </predicate>
                                    </predicate>
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Traps/Traps_Buff_2.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                                <Item>
                                    <predicate type="gameMechanics.constructor.basicElements.PredicateNot">
                                        <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Traps/Traps_Buff_3.(BuffResource).xdb" />
                                        </predicate>
                                    </predicate>
                                    <impacts>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="/Mechanics/RaidInstances/FerrisRaid/3_Mammoth/Traps/Traps_Buff_3.(BuffResource).xdb" />
                                        </Item>
                                    </impacts>
                                </Item>
                            </entries>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0.5</coeff>
            </scaler>
            <group href="/Mechanics/Spells/Groups/AutoAttackShared.xdb" />
        </Item>
    </effects>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>