<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739935276</resourceId>
	</Header>
	<Name href="SpinFire.(BuffResource).Name.txt" />
	<Description href="SpinFire.(BuffResource).Description.txt" />
	<image href="/Interface/Icons/Spells/Mage/MageFireInstability.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactSetCooldownFlat">
					<spell href="FireCleave.(SpellArea).xdb" />
					<duration>
						<second>5</second>
					</duration>
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>1500</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectRay">
					<impacts>
						<Item type="gameMechanics.elements.impacts.ImpactIfTarget">
							<predicates>
								<Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
								<Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
							</predicates>
							<impactsIf>
								<Item type="gameMechanics.elements.impacts.ImpactsIf">
									<predicate type="gameMechanics.elements.predicates.PredicateDistance">
										<range min="0.5" max="85" />
									</predicate>
									<impactsIf>
										<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
											<element>FIRE</element>
											<damage>30</damage>
											<scaler type="gameMechanics.elements.scalers.MagicScaler" />
										</Item>
									</impactsIf>
								</Item>
							</impactsIf>
						</Item>
					</impacts>
					<length>85</length>
					<width>1.5</width>
					<height>1.5</height>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>500</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.EffectSpin">
					<rotation type="constructor.basicElements.AngleCalcerStatic">
						<angle type="constructor.basicElements.AngleDegrees">
							<value>150</value>
						</angle>
					</rotation>
					<startDirection type="gameMechanics.elements.calcers.AngleCalcerRelative">
						<delta type="constructor.basicElements.AngleDegrees">
							<value>175</value>
						</delta>
					</startDirection>
				</Item>
			</effects>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<isMultiple>true</isMultiple>
	<canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
