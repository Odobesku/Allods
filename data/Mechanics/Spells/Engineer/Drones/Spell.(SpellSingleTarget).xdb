<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>219587</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/MountedSpells.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/EngineerArtillerySpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DragonRelic6.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <element>LIGHTNING</element>
    <Name href="Spell.(SpellSingleTarget).Name.txt" />
    <Description href="Spell.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>dmg</name>
            <value var="damage" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>MagicScaler</formula>
            </scaler>
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Engineer/EngineerDrone.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="/Spells/VisScripts/Engineer/Throw_Drone.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>25</value>
    </range>
    <prepareDuration>500</prepareDuration>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
        <Item href="Spell02.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
        <Item href="Spell03.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
    </ranks>
    <iffPolicy>Enemies</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <mechanics>
        <cooldown>
            <duration>15000</duration>
            <group href="/Mechanics/Spells/Groups/EngineerMechSpells.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        </cooldown>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateCreature" />
        </targetConditions>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Engineer/ArtilleryForm/Buff01.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.elements.resources.ResourceMana">
                    <mana>0</mana>
                </resourceIf>
                <resourceElse type="gameMechanics.elements.resources.ResourceMana">
                    <mana>10</mana>
                    <manaType>
                        <Item>Energy</Item>
                    </manaType>
                </resourceElse>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.constructor.basicElements.ImpactList">
                <impactsResource href="/Mechanics/Spells/Engineer/EngineerDismount.(ImpactListResource).xdb#xpointer(/gameMechanics.constructor.basicElements.ImpactListResource)" />
            </Item>
        </casterImpacts>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateFaction">
                        <faction href="/World/Factions/League.xdb#xpointer(/gameMechanics.world.creature.Faction)" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff hrefvar="buff" />
                        <stacks type="gameMechanics.elements.calcers.FloatData">
                            <value>120</value>
                        </stacks>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                        <buff hrefvar="buff2" />
                        <stacks type="gameMechanics.elements.calcers.FloatData">
                            <value>120</value>
                        </stacks>
                    </Item>
                </elseImpacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>30</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>