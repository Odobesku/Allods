<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="CreatureAnimationAction">
		<animations>
			<Item>specialIdle</Item>
		</animations>
	</wholeCasting>
	<actionBarComplite type="VisActionList">
		<playWhile type="CreatureAnimationAction">
			<animations>
				<Item>spellCastDirected01</Item>
			</animations>
		</playWhile>
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Mobs/GT_7Boss_TeleportExplosion_HandFlash.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
						<scale>1.5</scale>
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special01</locatorName>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarComplite>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/Engineer_Cannon.ProjectileFire_01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<explosionFx href="/Spells/FX/Spells/HitFire.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
				<pointOnCaster type="VisPointLocator">
					<locator>FROM_LOCATOR_NAME</locator>
					<locatorName>Slot_Special01</locatorName>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_BodyFX</locator>
				</pointOnTarget>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
