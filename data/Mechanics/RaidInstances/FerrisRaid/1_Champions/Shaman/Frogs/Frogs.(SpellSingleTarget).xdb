<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739885821</resourceId>
    </Header>
    <Name href="Frogs.(SpellSingleTarget).Name.txt" />
    <visualScripts href="Frogs.(SpellVisScripts).xdb" />
    <range type="gameMechanics.elements.calcers.FloatData">
        <value>85</value>
    </range>
    <prepareDuration>2000</prepareDuration>
    <needLos>false</needLos>
    <iffPolicy>Enemies</iffPolicy>
    <mechanics>
        <targetConditions>
            <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                <predicates>
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/RaidInstances/IsHM.(BuffResource).xdb" />
                    </Item>
                </predicates>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>4</radius>
                        <affectGroup>Enemies</affectGroup>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                                <element>POISON</element>
                                <damage>11</damage>
                                <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.world.creature.AvatarFilter" />
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                <buff href="Frog_Counter.(BuffResource).xdb" />
                                <range>
                                    <min>3</min>
                                    <max>3</max>
                                </range>
                            </Item>
                        </predicates>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.RepeatedImpact">
                                <impact type="gameMechanics.elements.impacts.ImpactSummon">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                                            <delay>7000</delay>
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactKill" />
                                            </impacts>
                                        </Item>
                                    </impacts>
                                    <impactsFromTarget>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Taunt.(BuffResource).xdb" />
                                        </Item>
                                    </impactsFromTarget>
                                    <traceDown>true</traceDown>
                                    <object href="Frog.(MobWorld).xdb" />
                                    <pool href="/Mechanics/RaidInstances/UmoirRaid/1_PierBoss/ClearingPool.(SummonPool).xdb" />
                                </impact>
                                <count type="gameMechanics.elements.calcers.FloatData">
                                    <value>4</value>
                                </count>
                            </Item>
                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                                        <impacts>
                                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                                <buff href="Frog_Counter.(BuffResource).xdb" />
                                            </Item>
                                        </impacts>
                                    </Item>
                                </impacts>
                            </Item>
                        </impacts>
                        <elseImpacts>
                            <Item type="gameMechanics.elements.impacts.ReturningImpact">
                                <impacts>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="Frog_Counter.(BuffResource).xdb" />
                                    </Item>
                                </impacts>
                            </Item>
                        </elseImpacts>
                    </Item>
                </impacts>
                <elseImpacts>
                    <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                        <element>POISON</element>
                        <damage>15</damage>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </Item>
                </elseImpacts>
            </Item>
        </targetImpacts>
    </mechanics>
    <speed>25</speed>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>