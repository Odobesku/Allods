<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastOmni</Item>
				</animations>
				<advanced>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectIceWand_Cast.(VisObjectTemplate).xdb" />
						<fadeOutTime>200</fadeOutTime>
						<locator>Slot_Hand_L</locator>
					</Item>
					<Item>
						<delay>500</delay>
						<effectFx href="/Spells/FX/Spells/ReadySpellDirectIceWand_Cast.(VisObjectTemplate).xdb" />
						<fadeOutTime>200</fadeOutTime>
						<locator>Slot_Hand_R</locator>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/PierBoss_FatalityFire_AOE_FatalityWind.(VisObjectTemplate).xdb" />
							<fixPoint>true</fixPoint>
							<lockScale>true</lockScale>
							<scale>0.4</scale>
							<locator>Slot_Global</locator>
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
