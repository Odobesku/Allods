<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739918015</resourceId>
    </Header>
    <Name href="MercsForFree.(BuffResource).Name.txt" />
    <Description href="MercsForFree.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Junk/CoinsGold.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.world.ship.elements.EffectMapChanged">
            <executeOnAttach>true</executeOnAttach>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                            <predicates>
                                <Item type="gameMechanics.world.ship.elements.PredicateInAstralHub" />
                                <Item type="gameMechanics.map.instance.astralIsland.PredicateOnAstralIsland" />
