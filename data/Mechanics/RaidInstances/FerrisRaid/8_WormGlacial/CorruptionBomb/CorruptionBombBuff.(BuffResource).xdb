<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221686</resourceId>
    </Header>
    <Name href="CorruptionBombBuff.(BuffResource).Name.txt" />
    <Description href="CorruptionBombBuff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Equipment/Ships/AstralComponentTL2/Offhand_Orb_D_03Purple.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
                <Item type="gameMechanics.elements.predicates.offender.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.offender.PredicateIsAE" />
                </Item>
            </predicates>
            <impacts>
                <targetToOffender>
                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                                <time>600</time>
                                <distance>10</distance>
                            </Item>
                        </impacts>
                    </Item>
                </targetToOffender>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.DisableLocalEvade" />
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.ImmunityToBuffs">
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.PredicateBuffHarmful" />
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactActivateAggro" />
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ContextActionBuff.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectNoAggro" />
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Move</Item>
            </actions>
        </Item>
    </effects>
    <duration>12000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>