<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>739931636</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
    </groups>
    <element>FIRE</element>
    <Name href="Spell00.(SpellSingleTarget).Name.txt" />
    <Description href="Spell00.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Spells/Stalker/StalkerArrowIncendiary.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Stalker/EnchantFire.(SpellVisScripts).xdb" />
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="Spell01.(SpellSingleTarget).xdb" />
        <Item href="Spell02.(SpellSingleTarget).xdb" />
        <Item href="Spell03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <ignoreGlobalCooldown>true</ignoreGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration var="cooldown" />
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.constructor.basicElements.PredicateAnd">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateHasAbility">
                                <ability href="/Mechanics/Spells/Stalker63/Abilities/AspectTankCheaperEnchants/Ability00.(AbilityResource).xdb" />
                            </Item>
                            <Item type="gameMechanics.elements.resources.ResourceBuff">
                                <buff href="/Mechanics/Spells/CommonBuffs/Aspects/Tank/Buff01.(BuffResource).xdb" />
                            </Item>
                        </predicates>
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.elements.resources.ResourceVariable">
                    <variable href="/Mechanics/Spells/Stalker63/Abilities/MaterielResource/MaterielResource.(VariableResource).xdb" />
                    <sub>5</sub>
                </resourceIf>
                <resourceElse type="gameMechanics.elements.resources.ResourceVariable">
                    <variable href="/Mechanics/Spells/Stalker63/Abilities/MaterielResource/MaterielResource.(VariableResource).xdb" />
                    <sub>6</sub>
                </resourceElse>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="EnchantFire01.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="/Mechanics/Spells/Stalker63/Spells/EnchantPoison/EnchantPoison01.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="/Mechanics/Spells/Stalker63/Spells/EnchantCold/EnchantCold01.(BuffResource).xdb" />
            </Item>
            <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                <buff hrefvar="buff" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>