		<playSoundOnKeys>true</playSoundOnKeys>
		<animation href="" />
		<isNecessaryAnim>false</isNecessaryAnim>
	</defaultState>
	<fadeInMS>0</fadeInMS>
	<fadeOutMS>0</fadeOutMS>
	<geometry href="AcidPuddle_Root.(Geometry).xdb#xpointer(/Geometry)" />
	<particle href="" />
	<questHighlight href="" />
	<replaceDistance>-1</replaceDistance>
	<replacement href="" />
