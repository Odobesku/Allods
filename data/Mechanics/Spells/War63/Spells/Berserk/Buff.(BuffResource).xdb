<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739920763</resourceId>
    </Header>
    <Name href="Buff.(BuffResource).Name.txt" />
    <Description href="Buff.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Warrior/MotivatedAggression.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Warrior/Berserk.(BuffVisScripts).xdb" />
    <interfaceHighPriority>true</interfaceHighPriority>
    <effects>
        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
            <scaler type="gameMechanics.elements.scalers.LinearEffectScaler">
                <coeff>0</coeff>
            </scaler>
            <group href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
            <targetFactor type="gameMechanics.elements.calcers.CalcerIf">
                <predicate type="gameMechanics.elements.predicates.PredicateGreater">
                    <lhs type="gameMechanics.elements.calcers.HealthInferiorityCalcer" />
                    <rhs type="gameMechanics.elements.calcers.FloatData">
                        <value>0</value>
                    </rhs>
                </predicate>
                <calcerIf type="gameMechanics.elements.calcers.CalcerSum">
                    <summands>
                        <Item type="gameMechanics.elements.calcers.CalcerMul">
                            <calcers>
                                <Item type="gameMechanics.elements.calcers.CalcerSum">
                                    <summands>
                                        <Item type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                        <Item type="gameMechanics.elements.calcers.HealthCalcer">
                                            <multiplier>-1</multiplier>
                                        </Item>
                                    </summands>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.InverseCalcer">
                                    <value type="gameMechanics.elements.calcers.FullHealthCalcer">
                                        <multiplier>0.1</multiplier>
                                    </value>
                                </Item>
                                <Item type="gameMechanics.elements.calcers.FloatData">
                                    <value>0.05</value>
                                </Item>
                            </calcers>
                        </Item>
                        <Item type="gameMechanics.elements.calcers.FloatData">
                            <value>1</value>
                        </Item>
                    </summands>
                </calcerIf>
                <calcerElse type="gameMechanics.elements.calcers.FloatData">
                    <value>1</value>
                </calcerElse>
            </targetFactor>
        </Item>
        <Item type="gameMechanics.elements.effects.SummandStat">
            <stat type="gameMechanics.elements.stat.SpecialStat">
                <stat href="/Mechanics/SpecialStats/Lifesteal.(SpecialStatResource).xdb" />
            </stat>
            <value>500</value>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mulCalcer type="gameMechanics.elements.calcers.HealthInferiorityCalcer" />
            </scaler>
        </Item>
    </effects>
    <duration>1</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>