    </range>
    <prepareDuration>1900</prepareDuration>
    <immutablePrepareDuration>true</immutablePrepareDuration>
    <targetType>STTPoint</targetType>
    <iffPolicy>Enemies</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <targetConditions>
            <Item type="gameMechanics.constructor.basicElements.PredicateOr">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    <Item type="gameMechanics.elements.resources.ResourceBuff">
                        <buff href="/Mechanics/Spells/Mercenaries/Controls/MercUnderControl.(BuffResource).xdb" />
                    </Item>
                </predicates>
            </Item>
        </targetConditions>
        <targetImpacts>
            <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                <element>LIGHTNING</element>
                <threatMultiplier>0</threatMultiplier>
                <damage>75</damage>
                <impactsOnHitTarget>
                    <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                        <predicates>
                            <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                                <predicate type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/Spells/CommonBuffs/KnockDown/BuffKnockDown.xdb" />
                                </predicate>
                            </Item>
                        </predicates>
                        <impactsIf>
