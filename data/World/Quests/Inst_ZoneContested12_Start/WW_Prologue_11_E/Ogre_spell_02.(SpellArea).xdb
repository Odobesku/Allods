            <Item type="gameMechanics.elements.impacts.ImpactActivateAggro">
                <value>500</value>
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactAstralKick">
                <time>500</time>
                <impactsOnLand>
                    <Item type="gameMechanics.elements.impacts.ProbabilisticImpactBinary">
                        <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                            <value>0.5</value>
                        </chanceCalcer>
                        <impactsSuccess>
                            <Item type="gameMechanics.elements.impacts.ProbabilisticImpactBinary">
                                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                    <value>0.5</value>
                                </chanceCalcer>
                                <impactsSuccess>
                                    <Item type="gameMechanics.elements.impacts.DirectDamage">
                                        <damage>1</damage>
                                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                <multiplier>0.6</multiplier>
                                            </mulCalcer>
                                        </scalerTarget>
                                    </Item>
                                </impactsSuccess>
                                <impactsFailure>
                                    <Item type="gameMechanics.elements.impacts.DirectDamage">
                                        <damage>1</damage>
                                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                <multiplier>0.45</multiplier>
                                            </mulCalcer>
                                        </scalerTarget>
                                    </Item>
                                </impactsFailure>
                            </Item>
                        </impactsSuccess>
                        <impactsFailure>
                            <Item type="gameMechanics.elements.impacts.ProbabilisticImpactBinary">
                                <chanceCalcer type="gameMechanics.elements.calcers.FloatData">
                                    <value>0.5</value>
                                </chanceCalcer>
                                <impactsSuccess>
                                    <Item type="gameMechanics.elements.impacts.DirectDamage">
                                        <damage>1</damage>
                                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer" />
                                        </scalerTarget>
                                    </Item>
                                </impactsSuccess>
                                <impactsFailure>
                                    <Item type="gameMechanics.elements.impacts.DirectDamage">
                                        <damage>1</damage>
                                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                <multiplier>0.5</multiplier>
                                            </mulCalcer>
                                        </scalerTarget>
                                    </Item>
                                </impactsFailure>
