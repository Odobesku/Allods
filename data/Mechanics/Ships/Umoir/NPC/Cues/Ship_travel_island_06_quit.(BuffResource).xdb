<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739852573</resourceId>
	</Header>
	<needVisualize>false</needVisualize>
	<needVisualizeDuration>false</needVisualizeDuration>
	<effects>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactIfCasterGeneric">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateOnAddressee">
							<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderInterlocutor" />
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.world.bigAstral.PredicateTripLocked">
										<mapResource href="/Maps/Umoir/Port_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
										<tour href="/Maps/Umoir/GlobalObjects/Tours/U_AI_Umoir_Tour.(Tour).xdb#xpointer(/gameMechanics.map.tour.Tour)" />
									</predicate>
								</Item>
							</predicates>
						</Item>
					</predicates>
					<impactsElse>
						<Item type="gameMechanics.elements.impacts.ImpactsDeferredGeneric">
							<delay>0</delay>
							<impacts>
								<Item type="gameMechanics.elements.impacts.BuffDetacher">
									<buff href="Ship_travel_island_06_quit.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
								</Item>
							</impacts>
						</Item>
					</impactsElse>
				</Item>
				<Item type="gameMechanics.world.ship.elements.ImpactGoByTour">
					<tour href="/Maps/UmoirIsland06/GlobalObjects/Tours/TourOUT.(Tour).xdb#xpointer(/gameMechanics.map.tour.Tour)" />
				</Item>
			</impactsOn>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
			<impacts>
				<Item type="gameMechanics.elements.impacts.ImpactIfCasterGeneric">
					<predicates>
						<Item type="gameMechanics.elements.predicates.PredicateOnAddressee">
							<addresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderInterlocutor" />
							<predicates>
								<Item type="gameMechanics.constructor.basicElements.PredicateNot">
									<predicate type="gameMechanics.world.bigAstral.PredicateTripLocked">
										<mapResource href="/Maps/Umoir/Port_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
										<tour href="/Maps/Umoir/GlobalObjects/Tours/U_AI_Umoir_Tour.(Tour).xdb#xpointer(/gameMechanics.map.tour.Tour)" />
									</predicate>
								</Item>
							</predicates>
						</Item>
					</predicates>
					<impactsIf>
						<Item type="gameMechanics.world.ship.elements.ImpactShipEnter">
							<destination href="/Maps/Umoir/Port_MapResource.xdb#xpointer(/mapLoader.MapResource)" />
							<success>
								<Item type="gameMechanics.world.ship.elements.ImpactGoByTour">
									<tour href="/Maps/Umoir/GlobalObjects/Tours/U_AI_Umoir_Tour.(Tour).xdb#xpointer(/gameMechanics.map.tour.Tour)" />
								</Item>
							</success>
						</Item>
					</impactsIf>
				</Item>
			</impacts>
		</Item>
	</effects>
	<duration>15000</duration>
	<isHelpful>false</isHelpful>
	<canBeSaved>true</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>
