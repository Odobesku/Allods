<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>201409</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <image href="/Interface/Icons/Spells/Halo/HealthResumption.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visScript href="/Spells/VisScripts/Fairy/Meditation.(BuffVisScripts).xdb#xpointer(/BuffVisScripts)" />
    <nameTemplate href="Buff_Name.txt.template" />
    <descTemplate href="Buff_Desc.txt.template" />
    <effects>
        <Item type="gameMechanics.elements.effects.EffectsIfCaster">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateManaCaster">
                    <manaType>Mana</manaType>
                </Item>
            </predicates>
            <effectsIf>
                <Item type="gameMechanics.elements.effects.EffectsIfTarget">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.elements.predicates.PredicateInCombat" />
                        </Item>
                    </predicates>
                    <effectsIf>
                        <Item type="gameMechanics.elements.effects.QuadraticHealthRefill" />
                        <Item type="gameMechanics.elements.effects.QuadraticManaRefill">
                            <manaType>Mana</manaType>
                        </Item>
                    </effectsIf>
                    <effectsElse>
                        <Item type="gameMechanics.elements.effects.EffectModifyManaRegen">
                            <manaType>Mana</manaType>
                            <multiplier type="gameMechanics.elements.calcers.FloatData">
                                <value var="value" />
                            </multiplier>
                        </Item>
                    </effectsElse>
                </Item>
            </effectsIf>
            <effectsElse>
                <Item type="gameMechanics.elements.effects.QuadraticHealthRefill" />
            </effectsElse>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff hrefvar="buff" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff hrefvar="bu_1" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Rotate</Item>
            </actions>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDamageTrigger">
            <eventsSource type="gameMechanics.elements.addresseeFinders.AddresseeFinderPet" />
            <predicates>
                <Item type="gameMechanics.elements.predicates.offender.PredicateIsForthright" />
            </predicates>
            <impacts>
                <casterToTarget>
                    <Item type="gameMechanics.elements.impacts.ImpactsToPet">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                <buff hrefvar="bu_2" />
                            </Item>
                        </impacts>
                    </Item>
                </casterToTarget>
            </impacts>
        </Item>
    </effects>
    <duration>0</duration>
    <isStackable>false</isStackable>
    <stackLimit>1</stackLimit>
    <isGradual>false</isGradual>
    <isHelpful>true</isHelpful>
    <isDetachableOnWill>true</isDetachableOnWill>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff02.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
        <Item href="Buff03.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <isClientReplicated>true</isClientReplicated>
    <groups>
        <Item href="HealthResumption.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/DisableActions.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>