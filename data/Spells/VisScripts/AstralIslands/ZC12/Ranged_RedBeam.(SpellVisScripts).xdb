<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="VisActionDelay">
					<time>800</time>
				</playWhile>
				<elements>
					<Item type="CreatureAnimationAction">
						<animations>
							<Item>spellCastDirected</Item>
						</animations>
						<channelOverrideScript />
						<advanced>
							<offendType>ONEOFFEND_ONETARGET</offendType>
							<eventPlaybackEnd>true</eventPlaybackEnd>
						</advanced>
					</Item>
					<Item type="CreatureChannelDirectAction">
						<channelingFx href="/Spells/FX/Mobs/ArchitectBossCaster_SuffocateChannel.(VisObjectTemplate).xdb" />
						<fxLength>20</fxLength>
						<startPoint type="VisPointLocator">
							<shift z="-0.8" />
							<locator>Slot_Head</locator>
						</startPoint>
						<alternativeStartPoint />
						<endPoint type="VisPointLocator">
							<locator>Slot_BodyFX</locator>
						</endPoint>
						<alternativeEndPoint type="VisPointLocator" />
						<fadeInTime>200</fadeInTime>
						<fadeOutTime>200</fadeOutTime>
						<offendTime type="EffectOffendConstDelay" />
						<secondaryTargetParams>
							<channelingFx href="" />
							<offendTime />
						</secondaryTargetParams>
					</Item>
				</elements>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<delay>0</delay>
						<effectFx href="/Spells/FX/Mobs/PortalBoss_Discharge_Hit.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<locator>Slot_Head</locator>
						<locatorName>Spine</locatorName>
						<offendTime />
						<offset z="-0.8" />
					</Item>
				</visualEffects>
			</Item>
		</elements>
		<stopOnDeath>false</stopOnDeath>
	</launch>
	<playOnTargets>
		<specialAction type="VisActionList">
			<play>Simultaneously</play>
			<playWhile type="VisActionDelay">
				<time>2000</time>
			</playWhile>
			<elements>
				<Item type="CreatureEffectsAction">
					<visualEffects>
						<Item>
							<effectFx href="/Spells/FX/Spells/Hit_Architect.(VisObjectTemplate).xdb" />
							<effectAlias href="" />
							<scale>1.1</scale>
							<locator>Slot_BodyFX</locator>
							<offendTime />
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</specialAction>
	</playOnTargets>
</SpellVisScripts>
