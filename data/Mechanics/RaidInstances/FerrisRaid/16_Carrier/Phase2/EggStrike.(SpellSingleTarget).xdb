<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739917512</resourceId>
	</Header>
	<Name href="EggStrike.(SpellSingleTarget).Name.txt" />
	<visualScripts href="EggStrike.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>0</value>
	</range>
	<prepareDuration>5000</prepareDuration>
	<needLos>false</needLos>
	<targetType>STTSelf</targetType>
	<isAggro>false</isAggro>
	<replaceLowRanks>false</replaceLowRanks>
	<iffPolicy>Friends</iffPolicy>
	<mechanics>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
				<predicates>
					<Item type="gameMechanics.elements.resources.ResourceBuff">
						<buff href="/Mechanics/RaidInstances/FerrisRaid/16_Carrier/NoTargeting.(BuffResource).xdb" />
					</Item>
				</predicates>
				<elseImpacts>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<radius>40</radius>
						<affectGroup>Enemies</affectGroup>
						<affectHolder>false</affectHolder>
						<impacts>
							<Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
								<element>LIGHTNING</element>
								<damage>10</damage>
								<scaler type="gameMechanics.elements.scalers.MagicScaler" />
							</Item>
							<Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
								<distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
								<data href="EggStrike_Lightning.(ClientData).xdb" />
								<calcers>
									<addressEntries>
										<Item>
											<name>caster</name>
											<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
										</Item>
										<Item>
											<name>target</name>
											<finder type="gameMechanics.elements.addresseeFinders.AddresseeFinderSelf" />
										</Item>
									</addressEntries>
								</calcers>
							</Item>
						</impacts>
						<filter type="gameMechanics.constructor.basicElements.FilterAnd">
							<filters>
								<Item type="gameMechanics.world.creature.AvatarFilter" />
								<Item type="gameMechanics.world.creature.AliveFilter" />
							</filters>
						</filter>
						<targetsLimit>2</targetsLimit>
					</Item>
				</elseImpacts>
			</Item>
		</casterImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
