															<time>1500</time>
															<destination type="gameMechanics.map.destination.DestinationLocatorSpread">
																<locator>
																	<scriptID>Roll1</scriptID>
																	<map href="/Maps/AstralIsle71/MapResource.xdb" />
																</locator>
																<horizontalSpread>2.5</horizontalSpread>
															</destination>
														</Item>
														<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
															<buff href="JumpProtection.(BuffResource).xdb" />
														</Item>
													</impacts>
													<elseImpacts>
														<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
															<predicates>
																<Item type="gameMechanics.elements.resources.ResourceBuff">
																	<buff href="BarrelRoute2.(BuffResource).xdb" />
																</Item>
															</predicates>
															<impacts>
																<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
																	<time>1500</time>
																	<destination type="gameMechanics.map.destination.DestinationLocatorSpread">
																		<locator>
																			<scriptID>Roll2</scriptID>
																			<map href="/Maps/AstralIsle71/MapResource.xdb" />
																		</locator>
																		<horizontalSpread>2.5</horizontalSpread>
																	</destination>
																</Item>
																<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																	<buff href="JumpProtection.(BuffResource).xdb" />
																</Item>
															</impacts>
															<elseImpacts>
																<Item type="gameMechanics.elements.impacts.ImpactIfCaster">
																	<predicates>
																		<Item type="gameMechanics.elements.resources.ResourceBuff">
																			<buff href="BarrelRoute3.(BuffResource).xdb" />
																		</Item>
																	</predicates>
																	<impacts>
																		<Item type="gameMechanics.elements.impacts.ImpactAstralKickToPoint">
																			<time>1500</time>
																			<destination type="gameMechanics.map.destination.DestinationLocatorSpread">
																				<locator>
																					<scriptID>Roll3</scriptID>
																					<map href="/Maps/AstralIsle71/MapResource.xdb" />
																				</locator>
																				<horizontalSpread>2.5</horizontalSpread>
																			</destination>
																		</Item>
																		<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
																			<buff href="JumpProtection.(BuffResource).xdb" />
																		</Item>
																	</impacts>
																</Item>
															</elseImpacts>
														</Item>
													</elseImpacts>
												</Item>
											</impacts>
										</Item>
									</impactsOnHitTarget>
									<scaler type="gameMechanics.elements.scalers.MagicScaler" />
								</Item>
							</impacts>
							<finishImpacts>
