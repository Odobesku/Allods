<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>214668</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Spell0.(SpellSingleTarget).Name.txt" />
    <Description href="Buff0.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Priest/PriestRegeneration.chn.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Druid/Druid70_HealingTouch.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactHeal">
                            <heal>1</heal>
                            <scalerTarget type="gameMechanics.elements.scalers.SumBuffsStackScaler">
                                <buffs>
                                    <Item href="Buff01.(BuffResource).xdb" />
                                    <Item href="Buff02.(BuffResource).xdb" />
                                    <Item href="Buff03.(BuffResource).xdb" />
                                </buffs>
                            </scalerTarget>
                            <scalerCaster type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                            <externalCalcer hrefvar="externalCalcer" />
                                        </mulCalcer>
                                    </Item>
                                    <Item type="gameMechanics.elements.scalers.HealScaler" />
                                </scalers>
                            </scalerCaster>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                    <buff href="Buff01.(BuffResource).xdb" />
                                    <range>
                                        <max>5</max>
                                    </range>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="Buff01.(BuffResource).xdb" />
                                    <resetTimer>false</resetTimer>
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>1</value>
                                    </delta>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
    </effects>
    <duration>6000</duration>
    <stackLimit>6</stackLimit>
    <isHelpful>true</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>