<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.EffectListResource>
    <Header>
        <resourceId>739910151</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectGuildTrigger">
            <impactsOnLeave>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="GuildSpellSeasonReward.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOnLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>2000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.AltCurrencyTrigger">
                    <currency href="/Mechanics/Rules/Seasons/GuildSeason_GuildReward.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                    <condition type="constructor.elements.LongGreaterOrEquals">
                        <value>1</value>
                    </condition>
                    <impacts>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="GuildSpellSeasonReward.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impacts>
                    <compareType>ValueEveryTime</compareType>
                </Item>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceAltCurrency">
                                            <currency href="/Mechanics/Rules/Seasons/GuildSeason_GuildReward.(AlternativeCurrency).xdb#xpointer(/gameMechanics.constructor.schemes.item.AlternativeCurrency)" />
                                            <count>1</count>
                                        </Item>
                                    </predicates>
                                    <impactsIf>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="GuildSpellSeasonReward.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsIf>
                                    <impactsElse>
                                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                            <buff href="GuildSpellSeasonReward.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                        </Item>
                    </impactsOn>
                    <impactsOff>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="GuildSpellSeasonReward.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                        </Item>
                    </impactsOff>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.constructor.basicElements.EffectListResource>