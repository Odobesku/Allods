<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>206822</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
        <Item href="/Mechanics/Spells/Groups/AmmoSpells.(ActionGroup).xdb" />
    </groups>
    <element>HOLY</element>
    <Name href="GroupBuff.(SpellSingleTarget).Name.txt" />
    <Description href="GroupBuff.(SpellSingleTarget).Description.txt" />
    <descVars>
        <Item>
            <name>var0</name>
            <value var="multiplier" />
        </Item>
        <Item>
            <name>hp</name>
            <value var="hp" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Paladin/PaladinCounteractDicease.(UISingleTexture).xdb" />
    <visualScripts href="/Spells/VisScripts/Paladin/GroupBuff.(SpellVisScripts).xdb" />
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <ranks>
        <Item href="GroupBuff01.(SpellSingleTarget).xdb" />
        <Item href="GroupBuff02.(SpellSingleTarget).xdb" />
        <Item href="GroupBuff03.(SpellSingleTarget).xdb" />
    </ranks>
    <iffPolicy>Friends</iffPolicy>
    <launchWhenReady>true</launchWhenReady>
    <needInFront>false</needInFront>
    <mechanics>
        <cooldown>
            <duration>1</duration>
            <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                <mul>-15000</mul>
                <mulCalcer type="gameMechanics.elements.calcers.ItemQualityCalcer">
                    <dressSlot>AMMO</dressSlot>
                </mulCalcer>
                <sum>240000</sum>
            </scaler>
        </cooldown>
        <casterResources>
            <Item type="gameMechanics.elements.resources.ResourceIf">
                <predicates>
                    <Item type="gameMechanics.elements.predicates.PredicateEquipped">
                        <dressType>AMMO</dressType>
                        <itemClass href="/Mechanics/ItemClasses/Other_InfiniteTeardrop.(ItemClass).xdb" />
                    </Item>
                </predicates>
                <resourceIf type="gameMechanics.elements.resources.ResourceVariable">
                    <hideText>true</hideText>
                    <variable href="/Mechanics/Spells/Paladin63/Abilities/Canons/LightCanon.(VariableResource).xdb" />
                    <sub>0</sub>
                </resourceIf>
                <resourceElse type="gameMechanics.elements.resources.ResourceDressItem">
                    <slot>AMMO</slot>
                    <count>3</count>
                </resourceElse>
            </Item>
        </casterResources>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactsToGroupMembers">
                        <radius>40</radius>
                        <affectPets>true</affectPets>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                <predicates>
                                    <Item type="gameMechanics.elements.predicates.PredicateHealthHigher">
                                        <level>0.9</level>
                                    </Item>
                                </predicates>
                                <impactsIf>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Power/Power.(BuffResource).xdb" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier var="multiplier" />
                                        </durationScaler>
                                    </Item>
                                </impactsIf>
                                <impactsElse>
                                    <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                        <buff href="/Mechanics/Spells/CommonBuffs/ClassesGroupBuffs/Defence/Defence.(BuffResource).xdb" />
                                        <durationScaler type="gameMechanics.elements.scalers.LinearScaler">
                                            <multiplier var="multiplier" />
                                        </durationScaler>
                                    </Item>
                                    <Item type="gameMechanics.elements.impacts.PureHeal">
                                        <heal>1</heal>
                                        <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                            <mul>0.01</mul>
                                            <mulCalcer type="gameMechanics.elements.calcers.FullHealthCalcer">
                                                <multiplier var="hp" />
                                            </mulCalcer>
                                        </scalerTarget>
                                    </Item>
                                </impactsElse>
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
    <isAE>true</isAE>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>