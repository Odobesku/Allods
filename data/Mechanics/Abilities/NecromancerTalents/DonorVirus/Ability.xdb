<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>237702</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability.Name.txt" />
    <description href="Ability.Description.txt" />
    <descVars>
        <Item>
            <name>multiplier</name>
            <value var="multiplier" />
            <scaler type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
                <formula>FormulaPercentAbsMinus1</formula>
            </scaler>
        </Item>
        <Item>
            <name>value</name>
            <value var="value" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Druid/DruidPetGetItUpgrade.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.SummandStat">
            <stat type="gameMechanics.elements.stat.InnateStat">
                <stat>Lifesteal</stat>
            </stat>
            <value var="value" />
            <scaler type="gameMechanics.elements.scalers.LinearScaler">
                <multiplier>10</multiplier>
            </scaler>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellsModifier">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
                    <group href="/Mechanics/Spells/Groups/NecromancerLifeTap.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
                </Item>
            </predicates>
            <modifiers>
                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                    <effects>
                        <Item type="gameMechanics.elements.effects.SummandStat">
                            <stat type="gameMechanics.elements.stat.InnateStat">
                                <stat>Lifesteal</stat>
                            </stat>
                            <value>1</value>
                            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                                <scalers>
                                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                        <mul var="multiplier" />
                                        <mulCalcer type="gameMechanics.elements.calcers.StatCalcer">
                                            <stat type="gameMechanics.elements.stat.InnateStat">
                                                <stat>Lifesteal</stat>
                                            </stat>
                                        </mulCalcer>
                                    </Item>
                                    <scaler type="gameMechanics.elements.scalers.LinearScaler">
                                        <multiplier>10</multiplier>
                                    </scaler>
                                </scalers>
                            </scaler>
                        </Item>
                    </effects>
                    <onBehalfOfHolder>true</onBehalfOfHolder>
                </Item>
            </modifiers>
        </Item>
    </effects>
    <majorEffect>-1</majorEffect>
    <level>1</level>
    <ranks>
        <Item href="Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability02.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
        <Item href="Ability03.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
    </ranks>
    <disableWhileDead>false</disableWhileDead>
    <saveState>false</saveState>
</gameMechanics.constructor.schemes.ability.AbilityResource>