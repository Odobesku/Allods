            <LocatorOnCaster>Slot_Global</LocatorOnCaster>
            <FxOnHands>/Spells/FX/Spells/HitFire_Staff01.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
