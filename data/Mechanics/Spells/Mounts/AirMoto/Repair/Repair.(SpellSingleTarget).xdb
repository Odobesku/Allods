<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>204174</resourceId>
    </Header>
    <contextActionInfo>
        <priority>3</priority>
    </contextActionInfo>
    <groups>
        <Item href="/Mechanics/Spells/Groups/MountedBuffs.xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
        <Item href="/Mechanics/Spells/Groups/TwoSeaterMount.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
    <Name href="Repair.(SpellSingleTarget).Name.txt" />
    <Description href="Repair.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/RepairAirMoto.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <visualScripts href="Repair.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>600000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.SendImpactsToAddressee">
                <addresseeFinder type="gameMechanics.world.avatar.bearing.AddresseeFinderBearer" />
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ReturningInstantiatingImpact">
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
                                <spell href="Repair.(SpellSingleTarget).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                                <factor type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mul>-0.05</mul>
                                    <mulCalcer type="gameMechanics.elements.calcers.MountLevelCalcer">
                                        <mount href="/Mechanics/Mounts/7thGrade/Mounts/AirMotoBase.(MountResource).xdb#xpointer(/gameMechanics.constructor.schemes.mount.MountResource)" />
                                    </mulCalcer>
                                    <sum>1</sum>
                                </factor>
                                <canStartCooldown>true</canStartCooldown>
                            </Item>
                        </impacts>
                    </Item>
                    <Item type="gameMechanics.elements.impacts.ImpactIsolator">
                        <impacts>
                            <Item type="gameMechanics.elements.effects.ImpactHealDamageThreshold">
                                <heal>1</heal>
                                <scalerTarget type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                    <mul>0.5</mul>
                                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                                        <externalCalcer href="/Mechanics/GameRoot/Mount/MountHealthCalcer.(CalcerFloatResource).xdb#xpointer(/constructor.elements.CalcerFloatResource)" />
                                    </mulCalcer>
                                </scalerTarget>
                                <resource href="/Mechanics/GameRoot/Mount/MountDamageThreshold.xdb#xpointer(/gameMechanics.elements.effects.DamageThresholdResource)" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>