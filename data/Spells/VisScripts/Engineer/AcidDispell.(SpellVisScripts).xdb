<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>channelCastDirectedEngineer</Item>
				</animations>
				<channel>CHANNEL_ABILITY</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx href="/Spells/FX/Spells/Engineer63_ReadySpell_AcidDispell.(VisObjectTemplate).xdb" />
						<effectAlias href="" />
						<scale>0.7</scale>
						<locator>Slot_Hand_R</locator>
						<offendTime />
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</actionBarStart>
	<wholeCasting />
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<playWhile />
		<preconditional>true</preconditional>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedEngineer</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
				<channelOverrideScript />
				<advanced>
					<backgroundAfterFirstKey>true</backgroundAfterFirstKey>
					<changeChannelAfterFirstKey>CHANGE</changeChannelAfterFirstKey>
					<channelAfterFirstKey>CHANNEL_ATTACK</channelAfterFirstKey>
					<offendType>ONEOFFEND_ONETARGET</offendType>
				</advanced>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/Engineer_PoisonProjectile.(VisObjectTemplate).xdb" />
				<explosionFx href="/Spells/FX/Spells/HitPoison.(VisObjectTemplate).xdb" />
				<theGe>1</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Hand_L</locator>
				</pointOnCaster>
				<pointOnTarget type="VisPointLocator">
					<locator>Slot_FX</locator>
				</pointOnTarget>
				<offendTime type="EffectOffendConstDelay" />
			</Item>
			<Item type="CreatureVisObjectComponentsAction">
				<visObjComponents>
					<Item type="AttachedVisObjectComponent">
						<visObject href="/Spells/FX/Spells/Engineer_RailGunChannel_TrunkAcid.(VisObjectTemplate).xdb" />
						<scale>0.6</scale>
						<offset y="0.6" />
						<locatorName>Slot_Hand_L</locatorName>
					</Item>
				</visObjComponents>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
