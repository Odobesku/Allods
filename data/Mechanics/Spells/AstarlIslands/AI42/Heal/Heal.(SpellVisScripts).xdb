<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <playWhile type="CreatureAnimationAction">
            <mode>LOOP</mode>
            <animations>
                <Item>readySpell</Item>
            </animations>
        </playWhile>
        <elements>
            <Item type="CreatureChannelDirectAction">
                <channelingFx href="/Spells/FX/Spells/BattleStation_RainbowRay.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <fxLength>14</fxLength>
                <startPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </startPoint>
                <endPoint type="VisPointLocator">
                    <locator>Slot_FX</locator>
                </endPoint>
            </Item>
        </elements>
    </wholeCasting>
    <precastType>PRECAST_NONE</precastType>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>spellCastDirected</Item>
                </animations>
                <advanced>
                    <offendType>ONEOFFEND_ONETARGET</offendType>
                </advanced>
            </Item>
            <Item type="CreatureEffectsOnTarget">
                <visualEffects>
                    <Item>
                        <effectFx href="/Spells/FX/Spells/PriestMendWoundsAbility.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                        <offendTime type="EffectOffendConstDelay" />
                    </Item>
                </visualEffects>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>