<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<wholeCasting type="VisActionLoopAction">
		<actionToLoop type="VisActionList">
			<play>Simultaneously</play>
			<playWhile type="VisActionDelay">
				<time>1000</time>
			</playWhile>
			<elements>
				<Item type="CreatureAnimationAction">
					<animations>
						<Item>attack</Item>
					</animations>
					<advanced>
						<offendType>ONEOFFEND_ONETARGET</offendType>
					</advanced>
				</Item>
				<Item type="CreatureChannelDirectAction">
					<channelingFx href="/Spells/FX/Spells/Engineer_RailGun_ChannelPoison.(VisObjectTemplate).xdb" />
					<fxLength>20</fxLength>
					<startPoint type="VisPointLocator">
						<locator>FROM_LOCATOR_NAME</locator>
						<locatorName>Slot_Special01</locatorName>
					</startPoint>
					<alternativeStartPoint />
					<endPoint type="VisPointLocator">
						<locator>Slot_FX</locator>
					</endPoint>
					<alternativeEndPoint />
					<offendTime />
					<secondaryTargetParams>
						<offendTime />
					</secondaryTargetParams>
				</Item>
				<Item type="CreatureEffectsOnTarget">
					<visualEffects>
						<Item>
							<delay>100</delay>
							<effectFx href="/Spells/FX/Spells/Engineer_HitPoison.(VisObjectTemplate).xdb" />
							<fixPoint>true</fixPoint>
							<lockScale>true</lockScale>
							<locator>Slot_FX</locator>
						</Item>
					</visualEffects>
				</Item>
			</elements>
		</actionToLoop>
		<totalTime>1000</totalTime>
		<repeat>10</repeat>
	</wholeCasting>
	<playOnTargets>
		<specialAction />
	</playOnTargets>
</SpellVisScripts>
