<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>739904247</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                    <delay>2000</delay>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="RoboGuard1/RoboGuard1.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                    <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                                    <data href="ClientData_voice/RoboGuards_EnterCombat.(ClientData).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
