	<forceShowQuality>false</forceShowQuality>
	<ignoreDressSlotLevel>false</ignoreDressSlotLevel>
	<isHideLifestyleWhileNotEquipped>false</isHideLifestyleWhileNotEquipped>
	<isProbe>false</isProbe>
	<isQuestRelated>false</isQuestRelated>
	<needCheckPredicates>true</needCheckPredicates>
