<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>249541</resourceId>
    </Header>
    <Name href="Addspam.(SpellSingleTarget).Name.txt" />
    <visualScripts href="AddSpam.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
    <nameTemplate href="Addspam.(SpellSingleTarget).Name.txt" />
    <prepareDuration>2000</prepareDuration>
    <targetType>STTSelf</targetType>
    <iffPolicy>Friends</iffPolicy>
    <triggersGlobalCooldown>false</triggersGlobalCooldown>
    <mechanics>
        <cooldown>
            <duration>35000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                        <radius>60</radius>
                        <affectGroup>Enemies</affectGroup>
                        <affectHolder>false</affectHolder>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactSummon">
                                <destination type="gameMechanics.map.destination.RelativeRotatePos">
                                    <base type="gameMechanics.map.destination.SelfPosDestination" />
                                    <offset>4</offset>
                                </destination>
                                <impacts>
                                    <Item type="gameMechanics.elements.impacts.ImpactCopyAggroList" />
                                </impacts>
                                <object href="Add.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                <pool href="DemonLiar.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                            </Item>
                        </impacts>
                        <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                            <filters>
                                <Item type="gameMechanics.world.creature.AliveFilter" />
                                <Item type="gameMechanics.world.creature.AvatarFilter" />
                            </filters>
                        </filter>
                        <targetsLimit>6</targetsLimit>
                    </Item>
                </impacts>
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>