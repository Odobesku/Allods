<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
	<Header>
		<resourceId>739931349</resourceId>
	</Header>
	<image href="/Interface/Icons/Misc/Itemmall/PortalsDesc.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.EffectAddContextActions">
			<actions>
				<Item href="Proec_Player_Teleport.(SpellSingleTarget).xdb" />
			</actions>
		</Item>
		<Item type="gameMechanics.elements.effects.EffectsDeferred">
			<delay>15000</delay>
			<effects>
				<Item type="gameMechanics.elements.effects.Switch">
					<impactsOn>
						<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
							<buff href="TeleportActionBuff.(BuffResource).xdb" />
						</Item>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="TeleportCooldown.(BuffResource).xdb" />
						</Item>
					</impactsOn>
				</Item>
			</effects>
		</Item>
		<Item type="gameMechanics.elements.effects.Switch">
			<impactsOn>
				<Item type="gameMechanics.elements.impacts.ImpactSpellCooldown">
					<spell href="Proec_Player_Teleport.(SpellSingleTarget).xdb" />
					<duration>15000</duration>
				</Item>
			</impactsOn>
		</Item>
	</effects>
	<isHelpful>true</isHelpful>
	<isDetachableOnWill>true</isDetachableOnWill>
	<canBeSaved>false</canBeSaved>
	<isClientReplicated>false</isClientReplicated>
	<groups>
		<Item href="/Mechanics/Spells/Groups/MapLocalBuffs.xdb" />
		<Item href="/Mechanics/Spells/Groups/FerrisRaid.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/FerrisRaid_Hacking.(ActionGroup).xdb" />
	</groups>
</gameMechanics.constructor.schemes.buff.BuffResource>
