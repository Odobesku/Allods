<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <mode>LOOP</mode>
        <animations>
            <Item>channelCastDirected</Item>
        </animations>
        <channel>CHANNEL_KNOCKDOWN</channel>
    </actionBarStart>
    <wholeCasting type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <playWhile type="VisActionDelay">
                    <time>4000</time>
                </playWhile>
                <elements>
                    <Item type="CreatureTurnToTargetAction" />
                </elements>
            </Item>
            <Item type="VisActionList">
                <play>Simultaneously</play>
                <playWhile type="VisActionDelay">
                    <time>3550</time>
                </playWhile>
                <elements>
                    <Item type="CreatureChannelDirectAction">
                        <channelingFx href="/Spells/FX/Spells/BattleStation_FireRay.(VisObjectTemplate).xdb" />
                        <fxLength>14</fxLength>
                        <startPoint type="VisPointLocator">
                            <locator>Slot_Hand_R</locator>
                        </startPoint>
                        <endPoint type="VisPointLocator">
                            <locator>Slot_FX</locator>
                        </endPoint>
                    </Item>
                </elements>
            </Item>
            <Item type="VisActionList">
                <elements>
                    <Item type="VisActionDelay">
                        <time>2750</time>
                    </Item>
                    <Item type="VisActionList">
                        <play>Simultaneously</play>
                        <playWhile type="VisActionDelay">
                            <time>1000</time>
                        </playWhile>
                        <elements>
                            <Item type="CreatureLockRotationAction" />
                        </elements>
                    </Item>
                </elements>
            </Item>
        </elements>
    </wholeCasting>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Spells/MageFireballAbilityBig.(VisObjectTemplate).xdb" />
                <explosionFx href="/Mechanics/Characters/Undead_male/AstralIsle50/HitFireball_small.(VisObjectTemplate).xdb" />
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_Hand_R</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_BodyFX</locator>
                </pointOnTarget>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>