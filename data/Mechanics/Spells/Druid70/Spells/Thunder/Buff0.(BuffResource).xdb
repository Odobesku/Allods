<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>214176</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <Name href="Spell0.(SpellSingleTarget).Name.txt" />
    <Description href="Buff0.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidCallLightning.(UISingleTexture).xdb" />
    <visScript href="/Spells/VisScripts/Druid/Thunder.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.constructor.basicElements.CountingEffectOverTime">
            <effect type="gameMechanics.elements.effects.MagicDoT">
                <parameters>
                    <tickLength>1000</tickLength>
                    <damagePerTick>1</damagePerTick>
                    <impactsPerTick>
                        <Item type="gameMechanics.elements.impacts.DoubleAttackIsolator">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="/Mechanics/Spells/Druid70/Abilities/LightningRod/Buff01.(BuffResource).xdb" />
                                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.MarkedImpact">
                            <mark href="/Mechanics/Spells/Druid70/Abilities/TornadoThunderProlongWasp/StormWasps.(MarkResource).xdb" />
                        </Item>
                    </impactsPerTick>
                    <affectedByDoubleAttack>true</affectedByDoubleAttack>
                </parameters>
                <element>LIGHTNING</element>
                <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                    <mulCalcer type="constructor.elements.CalcerFloatExternal">
                        <externalCalcer hrefvar="externalCalcer" />
                    </mulCalcer>
                    <additionalMultiplier>
                        <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                    </additionalMultiplier>
                </scaler>
            </effect>
            <ticksCount>2</ticksCount>
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactsIf">
                    <predicate type="gameMechanics.constructor.basicElements.BinaryPredicateNot">
                        <predicate type="gameMechanics.elements.predicates.PredicateHasBuffFromMaster">
                            <buff href="/Mechanics/Spells/Druid70/Spells/ThunderUpgrade/Dot.(BuffResource).xdb" />
                        </predicate>
                    </predicate>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Dot.(BuffResource).xdb" />
                            <durationScaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                <mulCalcer type="gameMechanics.elements.calcers.SpellRankCalcer">
                                    <spell href="Spell03.(SpellSingleTarget).xdb" />
                                    <mul>2</mul>
                                    <sum>4</sum>
                                </mulCalcer>
                            </durationScaler>
                        </Item>
                    </impactsIf>
                </Item>
            </impactsOff>
        </Item>
    </effects>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <ranks>
        <Item href="Buff01.(BuffResource).xdb" />
        <Item href="Buff02.(BuffResource).xdb" />
        <Item href="Buff03.(BuffResource).xdb" />
    </ranks>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/Magics.xdb" />
        <Item href="/Mechanics/Spells/Groups/DamageOverTime.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>