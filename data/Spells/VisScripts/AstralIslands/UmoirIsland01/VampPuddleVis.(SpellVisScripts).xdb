<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
	<Header>
		<Prototype href="/Spells/VisScripts/Prototypes/MobDirect.(SpellVisScripts).xdb#xpointer(/SpellVisScripts)" />
		<Variables>
			<PreCastAnimation>readySpellDirected</PreCastAnimation>
			<FxOnHands>/Spells/FX/Weapon/WeaponEnchantMeleeRed.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)</FxOnHands>
			<FXOnCaster />
		</Variables>
	</Header>
	<actionBarStart />
	<wholeCasting type="VisActionList">
		<elements>
			<Item type="CreatureEffectsAction">
				<visualEffects>
					<Item>
						<effectFx hrefvar="FxOnHands" />
						<scale>2</scale>
					</Item>
					<Item>
						<scale>2</scale>
					</Item>
				</visualEffects>
			</Item>
		</elements>
	</wholeCasting>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item skiped="" />
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx hrefvar="FXOnCaster" />
							</Item>
						</visualEffects>
					</Item>
					<Item skiped="" />
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
