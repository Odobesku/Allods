<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>193844</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff hrefvar="buff" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                    <projectileData>
                        <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                            <destination type="gameMechanics.map.destination.DestinationLocator">
                                <locator>
                                    <scriptID var="scriptID" />
                                    <map href="/Maps/AstralIsle14/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                                </locator>
                                <yaw type="constructor.basicElements.AngleDegrees" />
                            </destination>
                            <directed>false</directed>
                        </moveType>
                        <resource href="FireGorn.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                    </projectileData>
                    <pool href="SP.(SummonPool).xdb#xpointer(/gameMechanics.map.spawn.SummonPool)" />
                </Item>
            </impacts>
        </Item>
    </effects>
    <duration>700</duration>
    <isHelpful>false</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="AI14_Buffs.(ActionGroup).xdb#xpointer(/gameMechanics.constructor.basicInterfaces.ActionGroup)" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>