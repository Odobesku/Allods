                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                                    <spells>
                                        <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonSkeleton/SkeletonHit01.(SpellSingleTarget).xdb" />
                                        <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonSkeleton/SkeletonHit02.(SpellSingleTarget).xdb" />
                                        <Item href="/Mechanics/Spells/Necromancer70/Spells/SummonSkeleton/SkeletonHit03.(SpellSingleTarget).xdb" />
                                    </spells>
                                </Item>
                            </predicates>
                            <modifiers>
                                <Item type="gameMechanics.elements.spell.SpellEnvelopeModifier">
                                    <effects>
                                        <Item type="gameMechanics.elements.effects.ScalerAllOutputDamage">
                                            <casterFactor type="gameMechanics.constructor.basicElements.ScalerCalcer">
                                                <scaler type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                                                    <mul>0.001</mul>
