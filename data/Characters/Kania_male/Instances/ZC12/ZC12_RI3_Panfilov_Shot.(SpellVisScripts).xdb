<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<mode>LOOP</mode>
				<animations>
					<Item>readyEngineer</Item>
				</animations>
				<channel>CHANNEL_ATTACK</channel>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="VisActionDelay">
						<time>0</time>
					</Item>
					<Item type="CreatureRotateToCastPointAction" />
				</elements>
			</Item>
		</elements>
	</actionBarStart>
	<launch type="VisActionList">
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>spellCastDirectedEngineer</Item>
				</animations>
				<channel>CHANNEL_KNOCKDOWN</channel>
			</Item>
			<Item type="CreatureVisActionStartThrow" />
			<Item type="CreatureProjectileAction">
				<projectileFx href="/Spells/FX/Spells/Engineer_ElectricityProjectile_Turr.(VisObjectTemplate).xdb" />
				<explosionFx href="/Spells/FX/Mobs/TurretNihil_ProjectileHit.(VisObjectTemplate).xdb" />
				<theGe>3</theGe>
				<pointOnCaster type="VisPointLocator">
					<locator>Slot_Hand_L</locator>
					<member>Caster</member>
				</pointOnCaster>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>
