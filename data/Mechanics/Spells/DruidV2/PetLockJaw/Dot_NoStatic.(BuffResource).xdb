<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>199588</resourceId>
    </Header>
    <Name href="Dot_NoStatic.(BuffResource).Name.txt" />
    <Description href="Dot_NoStatic.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Spells/Druid/DruidPetLockJaw.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <effects>
        <Item type="gameMechanics.elements.effects.MagicDoT">
            <parameters>
                <tickLength>3000</tickLength>
                <damagePerTick>1</damagePerTick>
            </parameters>
            <element>POISON</element>
            <scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
                <scalers>
                    <Item type="gameMechanics.elements.scalers.MagicScaler" />
                    <Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
                        <mul>0.01</mul>
                        <mulCalcer type="gameMechanics.elements.calcers.CalcerPetMaster">
                            <calcer type="gameMechanics.elements.calcers.CalcerMul">
                                <calcers>
                                    <Item type="gameMechanics.elements.calcers.BuffStackCountCalcer">
                                        <buff href="/Mechanics/Spells/DruidV2/BuffStatic/Buff01.xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                                        <forAllRanks>true</forAllRanks>
                                    </Item>
                                    <Item type="gameMechanics.elements.calcers.AbilityRankCalcer">
                                        <ability href="/Mechanics/Abilities/DruidTalentsV2/Survival/Ability01.xdb#xpointer(/gameMechanics.constructor.schemes.ability.AbilityResource)" />
                                        <mul>1</mul>
                                    </Item>
                                </calcers>
                            </calcer>
                        </mulCalcer>
                        <sum>1</sum>
                    </Item>
                    <Item type="gameMechanics.elements.scalers.ScalerIf">
                        <condition type="gameMechanics.elements.predicates.PredicateHasSpell">
                            <spell href="Spell02.xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
                        </condition>
                        <scalerIf type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>59.0679</multiplier>
                        </scalerIf>
                        <scalerElse type="gameMechanics.elements.scalers.LinearScaler">
                            <multiplier>43.9263</multiplier>
                        </scalerElse>
                    </Item>
                </scalers>
            </scaler>
        </Item>
    </effects>
    <duration>6100</duration>
    <isStackable>false</isStackable>
    <isHelpful>false</isHelpful>
    <isMultiple>true</isMultiple>
    <canBeSaved>false</canBeSaved>
</gameMechanics.constructor.schemes.buff.BuffResource>