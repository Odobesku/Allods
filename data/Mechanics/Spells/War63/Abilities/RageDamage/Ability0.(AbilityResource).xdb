<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
	<Header>
		<resourceId>739921565</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<name href="Ability0.(AbilityResource).Name.txt" />
	<description href="Ability0.(AbilityResource).Description.txt" />
	<descVars>
		<Item>
			<name>var0</name>
			<value>1</value>
			<scaler type="gameMechanics.constructor.basicElements.ScalerMultiple">
				<scalers>
					<Item type="gameMechanics.elements.scalers.ScalerDescriptionFormula">
						<formula>FormulaPercent</formula>
					</Item>
					<Item type="gameMechanics.elements.scalers.LinearMultiplierScaler">
						<mulCalcer type="constructor.elements.CalcerFloatExternal">
							<externalCalcer hrefvar="externalCalcer" />
						</mulCalcer>
					</Item>
				</scalers>
			</scaler>
		</Item>
		<Item>
			<name>time</name>
			<value var="time" />
		</Item>
	</descVars>
	<image href="/Interface/Icons/Spells/Warrior/WarriorBlessedSwordUpgrade.(UISingleTexture).xdb" />
	<effects>
		<Item type="gameMechanics.elements.effects.BuffExtraEffects">
			<buffs>
				<Item href="/Mechanics/Spells/CommonBuffs/Aspects/DD/Buff01.(BuffResource).xdb" />
			</buffs>
			<effects>
				<Item type="gameMechanics.elements.effects.BuffExtraEffects">
					<buffs>
						<Item href="/Mechanics/Spells/War63/Spells/Rage/Buff01.(BuffResource).xdb" />
					</buffs>
					<effects>
						<Item type="gameMechanics.elements.effects.Switch">
							<impactsOff>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff hrefvar="buff" />
								</Item>
							</impactsOff>
						</Item>
					</effects>
				</Item>
				<Item type="gameMechanics.elements.effects.CombatStateTrigger">
					<onEnter>
						<Item type="gameMechanics.elements.impacts.ImpactInstantiating">
							<impacts>
								<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
									<buff href="CD.(BuffResource).xdb" />
								</Item>
							</impacts>
						</Item>
					</onEnter>
					<onLeave>
						<Item type="gameMechanics.elements.impacts.BuffDetacher">
							<buff href="CD.(BuffResource).xdb" />
						</Item>
					</onLeave>
					<effects>
						<Item type="gameMechanics.elements.effects.EffectInstantiating">
							<effects>
								<Item type="gameMechanics.elements.effects.SpellCastTrigger">
									<conditionalImpacts>
										<Item>
											<impacts>
												<Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
													<buff href="CD.(BuffResource).xdb" />
												</Item>
											</impacts>
											<conditions>
												<Item type="gameMechanics.elements.predicates.PredicateSpellInGroup">
													<group href="/Mechanics/Spells/Groups/MeleeAttacks.xdb" />
												</Item>
											</conditions>
										</Item>
									</conditionalImpacts>
								</Item>
							</effects>
						</Item>
					</effects>
				</Item>
			</effects>
		</Item>
	</effects>
	<ranks>
		<Item href="Ability01.(AbilityResource).xdb" />
		<Item href="Ability02.(AbilityResource).xdb" />
		<Item href="Ability03.(AbilityResource).xdb" />
	</ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>
