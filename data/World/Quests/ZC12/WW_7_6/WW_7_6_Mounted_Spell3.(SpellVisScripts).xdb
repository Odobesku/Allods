<?xml version="1.0" encoding="UTF-8"?>
<SpellVisScripts>
	<actionBarStart type="CreatureAnimationAction">
		<animations>
			<Item>ready</Item>
		</animations>
	</actionBarStart>
	<launch type="VisActionList">
		<play>Simultaneously</play>
		<elements>
			<Item type="CreatureAnimationAction">
				<animations>
					<Item>attack</Item>
				</animations>
			</Item>
			<Item type="VisActionList">
				<elements>
					<Item type="CreatureVisActionStartThrow" />
					<Item type="CreatureProjectileAction">
						<projectileFx href="/Spells/FX/Ships/CannonProjectile01.(VisObjectTemplate).xdb" />
						<explosionFx href="/Spells/FX/Spells/HitFireballBig.(VisObjectTemplate).xdb" />
						<theGe>6</theGe>
						<pointOnCaster type="VisPointLocator">
							<locator>FROM_LOCATOR_NAME</locator>
							<member>Mount</member>
							<locatorName>Slot_Special01</locatorName>
						</pointOnCaster>
					</Item>
				</elements>
			</Item>
		</elements>
	</launch>
</SpellVisScripts>