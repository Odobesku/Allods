													<spell href="/Mechanics/Ships/Engine/Remote/Speed1.(SpellCasterSelf).xdb#xpointer(/gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget)" />
												</Item>
											</predicates>
