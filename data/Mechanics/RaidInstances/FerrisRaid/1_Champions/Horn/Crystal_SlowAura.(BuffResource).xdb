<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>221267</resourceId>
    </Header>
    <Name href="Crystal_SlowAura.(BuffResource).Name.txt" />
    <Description href="Crystal_SlowAura.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Misc/Unlocks/SnowCoveredIsland.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.TickableAura">
            <affectGroup>All</affectGroup>
            <radius>8</radius>
            <filter type="gameMechanics.constructor.basicElements.FilterAnd">
                <filters>
                    <Item type="gameMechanics.world.creature.AliveFilter" />
                    <Item type="gameMechanics.constructor.basicElements.FilterNot">
                        <filter type="gameMechanics.constructor.basicElements.FilterPredicates">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                    <mobs>
                                        <Item href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Melee/Champion_Melee.(MobWorld).xdb" />
                                        <Item href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Range/Champion_Range.(MobWorld).xdb" />
                                    </mobs>
                                </Item>
                            </predicates>
                        </filter>
                    </Item>
                    <Item type="gameMechanics.world.creature.CreatureFilter" />
                </filters>
            </filter>
            <blinking>true</blinking>
            <onBehalfOfHolder>true</onBehalfOfHolder>
            <impactsIn>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                            <buff href="Shaman_SlowImmune.(BuffResource).xdb" />
                            <range>
                                <max>14</max>
                            </range>
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                            <buff href="Crystal_Slow.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="Crystal_Slow.(BuffResource).xdb" />
                    <casterAddresseeFinder type="gameMechanics.elements.addresseeFinders.AddresseeFinderCaster" />
                </Item>
            </impactsOut>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                    <radius>8</radius>
                    <affectHolder>false</affectHolder>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.resources.ResourceBuff">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Shaman/GhostWalk/GhostWalk_HM.(BuffResource).xdb" />
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="/Mechanics/RaidInstances/FerrisRaid/1_Champions/Shaman/GhostWalk/GhostWalk_HM.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
                <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Crystal_SlowAura.(BuffResource).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectOnBuffTimeout">
            <impacts>
                <Item type="gameMechanics.elements.impacts.Disintegrate" />
            </impacts>
        </Item>
    </effects>
    <duration>20000</duration>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/Spells/Groups/RemovesNot.xdb" />
        <Item href="/Mechanics/Spells/Groups/EvadeProtectedBuffs.xdb" />
        <Item href="/Mechanics/Spells/Groups/DeathSafeBuff.xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>