<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
    <Header>
        <resourceId>313482</resourceId>
    </Header>
    <Name href="QuestionOfDanger.(SpellSingleTarget).Name.txt" />
    <Description href="QuestionOfDanger.(SpellSingleTarget).Description.txt" />
    <image href="/Interface/Icons/Special/Emotions/Danger.(UISingleTexture).xdb#xpointer(/UISingleTexture)" />
    <targetType>STTSelf</targetType>
    <isAggro>false</isAggro>
    <iffPolicy>Friends</iffPolicy>
    <mechanics>
        <cooldown>
            <duration>10000</duration>
        </cooldown>
        <casterImpacts>
            <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                <id href="Counter3.(QuestCountId).xdb#xpointer(/gameMechanics.elements.quest.QuestCountId)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                <spawn>
                    <scriptID>hmyk_quest</scriptID>
                    <map href="/Maps/Ferris/MapResource.xdb#xpointer(/mapLoader.MapResource)" />
                </spawn>
                <impacts>
                    <Item type="gameMechanics.elements.impacts.ImpactsDeferred">
                        <delay>2500</delay>
                        <impacts>
                            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                                <distributor type="gameMechanics.elements.calcers.CasterDistributor" />
                                <data href="Counter3.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
                            </Item>
                        </impacts>
                    </Item>
                </impacts>
            </Item>
            <Item type="gameMechanics.elements.impacts.BuffDetacher">
                <buff href="Emote3.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
            </Item>
            <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
                <distributor type="gameMechanics.elements.calcers.ObjectsAroundDistributor" />
                <data href="Danger.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
            </Item>
        </casterImpacts>
    </mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>