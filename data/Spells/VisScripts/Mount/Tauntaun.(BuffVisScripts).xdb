<?xml version="1.0" encoding="UTF-8" ?>
<BuffVisScripts>
	<action type="VisActionList">
		<play>Simultaneously</play>
		<preconditional>true</preconditional>
		<elements>
			<Item type="VisActionList">
				<play>Simultaneously</play>
				<playWhile type="PredicateVisualMountAction">
					<mountsList>
						<Item href="/Client/VisualMounts/Tauntaun/TauntaunDark.(VisualMount).xdb" />
						<Item href="/Client/VisualMounts/Tauntaun/TauntaunStandart.(VisualMount).xdb" />
					</mountsList>
				</playWhile>
				<preconditional>true</preconditional>
				<elements>
					<Item type="CreatureEffectsAction">
						<visualEffects>
							<Item>
								<effectFx href="/Spells/FX/Mobs/MountTauntaun_Shield_Start.(VisObjectTemplate).xdb" />
