<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.buff.BuffResource>
    <Header>
        <resourceId>739906546</resourceId>
    </Header>
    <Name href="ChannelDifficulty.(BuffResource).Name.txt" />
    <Description href="ChannelDifficulty.(BuffResource).Description.txt" />
    <image href="/Interface/Icons/Mounts/SpellsMounts/WingBuffet.(UISingleTexture).xdb" />
    <visScript href="NestChannel.(BuffVisScripts).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.BuffInterceptor">
            <impactsOnAttach>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateBuffStackCountRange">
                                    <buff href="ChannelDifficulty.(BuffResource).xdb" />
                                    <range>
                                        <min>1</min>
                                        <max>1</max>
                                    </range>
                                </Item>
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ChannelResource.(BuffResource).xdb" />
                                </Item>
                                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                                    <buff href="ChannelDifficulty.(BuffResource).xdb" />
                                </Item>
                            </impactsIf>
                            <impactsElse>
                                <Item type="gameMechanics.elements.impacts.StackBuff">
                                    <buff href="ChannelDifficulty.(BuffResource).xdb" />
                                    <resetTimer>false</resetTimer>
                                    <delta type="gameMechanics.elements.calcers.FloatData">
                                        <value>-1</value>
                                    </delta>
                                </Item>
                            </impactsElse>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/Knockdowns.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/Fears.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/Blinds.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/Stuns.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/Silence.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/Disarms.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
                        </Item>
                    </impacts>
                </Item>
            </impactsOnAttach>
            <forceAttachBuff>false</forceAttachBuff>
            <repelChanceCalcer type="gameMechanics.elements.calcers.FloatData">
                <value>1</value>
            </repelChanceCalcer>
            <predicates>
                <Item type="gameMechanics.constructor.schemes.buff.BuffInGroup">
                    <groups>
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Knockdowns.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Fears.xdb" />
                        <Item href="/Mechanics/Spells/Groups/MovementImpairingSpells.xdb" />
                        <Item href="/Mechanics/Spells/Groups/CrowdControlSpells.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Blinds.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Stuns.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Silence.xdb" />
                        <Item href="/Mechanics/Spells/Groups/Disarms.xdb" />
                        <Item href="/Mechanics/Spells/Groups/CrowdControlBuffs_IgnoreWill.(ActionGroup).xdb" />
                    </groups>
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAct">
            <actions>
                <Item>Move</Item>
                <Item>Jump</Item>
                <Item>Rotate</Item>
                <Item>ExternalMove</Item>
                <Item>Rooted</Item>
            </actions>
            <rooted>true</rooted>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectDisableAllActions" />
        <Item type="gameMechanics.elements.effects.EffectDisableAbility">
            <ability href="/Mechanics/Abilities/Bosses/ActivityTracker/Ability01.xdb" />
        </Item>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ChannelResource.(BuffResource).xdb" />
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle">
                                    <destination type="gameMechanics.map.destination.SelfPosDestination" />
                                </moveType>
                                <resource href="FinalExplosion.(ProjectileResource).xdb" />
                            </projectileData>
                        </Item>
                    </impacts>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.ImpactsOverTime">
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ExplosionPower.(BuffResource).xdb" />
                </Item>
            </impacts>
            <tick>1000</tick>
        </Item>
    </effects>
    <duration>13000</duration>
    <stackLimit>3</stackLimit>
    <isHelpful>true</isHelpful>
    <canBeSaved>false</canBeSaved>
    <groups>
        <Item href="/Mechanics/RaidInstances/Phase1.(ActionGroup).xdb" />
    </groups>
</gameMechanics.constructor.schemes.buff.BuffResource>