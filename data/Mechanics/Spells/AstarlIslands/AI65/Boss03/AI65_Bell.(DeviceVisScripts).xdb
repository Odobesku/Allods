<?xml version="1.0" encoding="UTF-8" ?>
<DeviceVisScripts>
    <states>
        <Item>
            <action type="DeviceVisActionList">
                <elements>
                    <Item type="DeviceAnimationAction">
                        <mode>LOOP</mode>
                        <animations>
                            <Item>special</Item>
                        </animations>
                    </Item>
                </elements>
            </action>
            <prevState>1</prevState>
        </Item>
        <Item>
            <action type="DeviceVisActionList">
                <elements>
                    <Item type="DeviceAnimationAction">
                        <mode>CLAMP</mode>
                        <animations>
                            <Item>idle</Item>
                        </animations>
                    </Item>
                </elements>
            </action>
        </Item>
    </states>
</DeviceVisScripts>