<?xml version="1.0" encoding="UTF-8" ?>
<avatarPopulation.service.impl.matchMakingImpl.eventType.mWar.MWarLadderEventType>
    <Header>
        <resourceId>242470</resourceId>
    </Header>
    <name href="MegaWarRaidMW5.(InstancedEventResource).Name.txt" />
    <description href="MegaWarRaidMW5.(InstancedEventResource).Description.txt" />
    <isHighPriority>true</isHighPriority>
    <minAvatarLevel type="gameMechanics.formulas.MaxLevelConstant" />
    <startTime href="/Mechanics/InstancedEventResource/MW_01/PTS_Raid.(TimeTable).xdb" />
    <levelsPartition>
        <entries>
            <Item>
                <minLevel type="gameMechanics.formulas.MaxLevelConstant" />
            </Item>
        </entries>
    </levelsPartition>
    <minAvatarsCount>0</minAvatarsCount>
    <leaderOnly>true</leaderOnly>
    <capacity>12</capacity>
    <keepGroupAfterFinish>true</keepGroupAfterFinish>
    <immediatelyStartFactor>0.1</immediatelyStartFactor>
    <unionType>Raid</unionType>
    <exclusive>true</exclusive>
    <joinConditions>
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/Empire.xdb" />
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateFaction">
                    <faction href="/World/Factions/League.xdb" />
                </Item>
            </predicates>
        </Item>
        <Item type="gameMechanics.elements.predicates.PredicateInRaid" />
        <Item type="gameMechanics.elements.predicates.PredicateGroupHasNoOfflineMembers" />
        <Item type="gameMechanics.constructor.basicElements.PredicateOr">
            <predicates>
                <Item type="gameMechanics.elements.predicates.PredicateHasContentKey">
                    <key href="/System/ContentKeys/ArenaRateTest.(ContentKey).xdb" />
                </Item>
                <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                    <predicate type="gameMechanics.elements.predicates.PredicateGroupSizeGE">
                        <size>13</size>
                    </predicate>
                </Item>
                <Item type="gameMechanics.elements.predicates.PredicateGroupSizeGE">
                    <size>10</size>
                </Item>
            </predicates>
        </Item>
    </joinConditions>
    <inviteTimeout>
        <second>30</second>
    </inviteTimeout>
    <delayedInvite>true</delayedInvite>
    <maps>
        <Item href="BattleEventMapMechanics.xdb" />
    </maps>
    <increaseVisitsOnFreeWin>true</increaseVisitsOnFreeWin>
    <acceptStage>Queue</acceptStage>
    <defendersMark href="/Mechanics/MegaWar/Marks/Blue.(BattlegroundPlayerSpawnPlace).xdb" />
    <attackersMark href="/Mechanics/MegaWar/Marks/Red.(BattlegroundPlayerSpawnPlace).xdb" />
    <teamScore href="MegaWarRaid_01.(BattleEventAchievementResource).xdb" />
    <shortListMaxDistance>2</shortListMaxDistance>
    <maxSameClassesCount>1</maxSameClassesCount>
    <ratingBattle>false</ratingBattle>
</avatarPopulation.service.impl.matchMakingImpl.eventType.mWar.MWarLadderEventType>