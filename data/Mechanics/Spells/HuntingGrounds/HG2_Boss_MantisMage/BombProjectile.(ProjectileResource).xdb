<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.world.projectile.ProjectileResource>
    <Header>
        <resourceId>213045</resourceId>
    </Header>
    <name href="BombProjectile.(ProjectileResource).Name.txt" />
    <visObject href="/Spells/FX/Spells/Green_projectile_Plume.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
    <lifeLengthCap>8000</lifeLengthCap>
    <impactsOnStart>
        <Item type="gameMechanics.elements.impacts.EntityImpactCreaturesAround">
            <shape type="gameMechanics.constructor.schemes.spell.area.Sphere" />
            <radius>10</radius>
            <affectGroup>Enemies</affectGroup>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ScaledMagicDamage">
                    <element>ACID</element>
                    <damage>30</damage>
                    <scaler type="gameMechanics.elements.scalers.MagicScaler" />
                </Item>
            </impacts>
            <filter type="gameMechanics.constructor.basicElements.FilterOr">
                <filters>
                    <Item type="gameMechanics.world.creature.AvatarFilter">
                        <withPet>true</withPet>
                    </Item>
                </filters>
            </filter>
        </Item>
    </impactsOnStart>
    <effects>
        <Item type="gameMechanics.elements.effects.Aura">
            <checkAffectGroupAgainst>Caster</checkAffectGroupAgainst>
            <radius>10</radius>
            <impactsIn>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="ExplosionWarn.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsIn>
            <impactsOut>
                <Item type="gameMechanics.elements.impacts.BuffDetacher">
                    <buff href="ExplosionWarn.(BuffResource).xdb#xpointer(/gameMechanics.constructor.schemes.buff.BuffResource)" />
                </Item>
            </impactsOut>
            <filter type="gameMechanics.constructor.basicElements.FilterOr">
                <filters>
                    <Item type="gameMechanics.world.creature.AvatarFilter" />
                    <Item type="gameMechanics.constructor.basicElements.FilterPredicates">
                        <predicates>
                            <Item type="gameMechanics.elements.predicates.PredicateMobWorld">
                                <mobs>
                                    <Item href="/Creatures/MantisMage/Instances/HuntingGround2/HG2_Boss.(MobWorld).xdb#xpointer(/gameMechanics.world.mob.MobWorld)" />
                                </mobs>
                            </Item>
                        </predicates>
                    </Item>
                </filters>
            </filter>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectsDeferred">
            <delay>7000</delay>
            <effects>
                <Item type="gameMechanics.elements.effects.Switch">
                    <impactsOn>
                        <Item type="gameMechanics.elements.impacts.ImpactLaunchProjectile">
                            <projectileData>
                                <moveType type="gameMechanics.world.projectile.MoveTypeIdle" />
                                <resource href="BombExplosion.(ProjectileResource).xdb#xpointer(/gameMechanics.world.projectile.ProjectileResource)" />
                            </projectileData>
                        </Item>
                    </impactsOn>
                </Item>
            </effects>
        </Item>
    </effects>
</gameMechanics.world.projectile.ProjectileResource>