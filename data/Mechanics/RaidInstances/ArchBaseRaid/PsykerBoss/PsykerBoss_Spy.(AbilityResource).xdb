<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>224386</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.CombatStateTrigger">
            <onEnter>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactMapVariableClearSave" />
                                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnMap">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                                            <impacts>
                                                <Item type="gameMechanics.elements.impacts.ImpactMapVariableAddSave" />
                                            </impacts>
                                        </Item>
                                    </impacts>
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                </Item>
            </onEnter>
            <onLeave>
                <Item type="gameMechanics.elements.impacts.ImpactInstantiating">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                            <predicates>
                                <Item type="gameMechanics.elements.predicates.PredicateIsAlive" />
                            </predicates>
                            <impactsIf>
                                <Item type="gameMechanics.elements.impacts.ImpactsToMapHead">
                                    <impacts>
                                        <Item type="gameMechanics.elements.impacts.ImpactMapVariableClearSave" />
                                    </impacts>
                                </Item>
                            </impactsIf>
                        </Item>
                    </impacts>
                </Item>
            </onLeave>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactScriptZoneSetDisabled">
                    <zone href="Arena_Blue.(ScriptZone).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactAllAvatarsOnCell">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                            <group href="/Mechanics/RaidInstances/ArchBaseRaid/SiegeBoss/R7_ArchBase_Raid.(ActionGroup).xdb" />
                        </Item>
                    </impacts>
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateIsAvatar" />
                    </predicates>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                    <spawnResource href="R7_Psyker_NeutralAdd.(SpawnTable).xdb" />
