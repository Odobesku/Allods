<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.basicElements.ImpactListResource>
    <Header>
        <resourceId>230846</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <impacts>
        <Item type="gameMechanics.world.bigAstral.elements.ImpactsOnSectors">
            <selector type="gameMechanics.world.bigAstral.elements.StaticSectorSelector">
                <sector hrefvar="sector" />
            </selector>
            <impacts>
                <Item type="gameMechanics.world.bigAstral.activities.ImpactAddActivity">
                    <activities>
                        <Item href="Chest.(AstralActivity).xdb#xpointer(/gameMechanics.world.bigAstral.activities.AstralActivity)" />
                    </activities>
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.impacts.ImpactClientDataParams">
            <distributor type="gameMechanics.elements.calcers.AstralSectorDistributor">
                <sector type="gameMechanics.world.bigAstral.elements.StaticSectorSelector">
                    <sector hrefvar="sector" />
                </sector>
                <faction type="gameMechanics.elements.calcers.ZoneDistributor$AnyFaction" />
            </distributor>
            <data href="ChestRespawned.(ClientData).xdb#xpointer(/gameMechanics.world.ClientData)" />
        </Item>
    </impacts>
</gameMechanics.constructor.basicElements.ImpactListResource>