<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>739917154</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.Switch">
            <impactsOn>
                <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                    <spawn>
                        <scriptID>Ferris4_final_portall</scriptID>
                        <map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb" />
                    </spawn>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.Disintegrate" />
                    </impacts>
                </Item>
            </impactsOn>
            <impactsOff>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Ferris_4_6_1_Buff.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Ferris_4_6_1_Buff.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Ferris_4_6_1_Fade.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Ferris_4_6_1_Fade.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Ferris_4_6_1_Cutscene.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Ferris_4_6_1_Cutscene.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                            <buff href="Ferris_4_6_1_ColossusScout.(BuffResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.BuffDetacher">
                            <buff href="Ferris_4_6_1_ColossusScout.(BuffResource).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                    <predicates>
                        <Item type="gameMechanics.elements.predicates.PredicateInZone">
                            <zone href="/Maps/Ferris4/Zones/Ferris4_03.(ZoneResource).xdb" />
                        </Item>
                    </predicates>
                    <impactsIf>
                        <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                            <mob>
                                <scriptID>Ferris4_Zimina_06_spawn_fin</scriptID>
                                <map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb" />
                            </mob>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                            <mob>
                                <scriptID>Ferris4_Gerbert_02_Spawn_fin</scriptID>
                                <map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb" />
                            </mob>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>Ferris4_inst_Door_04</scriptID>
                                <map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.device.DoorSwitch">
                                    <switchType>Open</switchType>
                                </Item>
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.SpawnSingleMob">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIfTarget">
                                    <predicates>
                                        <Item type="gameMechanics.elements.resources.ResourceBuff">
                                            <buff href="Ferris4_Architect_Friend.(BuffResource).xdb" />
                                        </Item>
                                    </predicates>
                                    <impactsElse>
                                        <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                            <buff href="Ferris4_Architect_Friend.(BuffResource).xdb" />
                                        </Item>
                                    </impactsElse>
                                </Item>
                            </impacts>
                            <mob>
                                <scriptID>Ferris4_Architect_Friend_Mob</scriptID>
                                <map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb" />
                            </mob>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactsToSingleSpawn">
                            <spawn>
                                <scriptID>Ferris4_Boss_CutScene</scriptID>
                                <map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb" />
                            </spawn>
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                        </Item>
                        <Item type="gameMechanics.elements.impacts.ImpactFindSpawnTable">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.Disintegrate" />
                            </impacts>
                            <spawnResource href="/Maps/Ferris4/SpawnTables/Ferris4/Ferris4_ArchitectBot_Inst.(SpawnTable).xdb" />
                        </Item>
                    </impactsIf>
                </Item>
                <Item type="gameMechanics.elements.impacts.ImpactRemoveAllBuffsFromGroup">
                    <group href="Ferris_4_6_1.(ActionGroup).xdb" />
                </Item>
                <Item type="gameMechanics.elements.impacts.SpawnSingleDevice">
                    <device>
                        <scriptID>Ferris4_final_portall</scriptID>
                        <map href="/Maps/Ferris4/inst_MapResource.(MapResource).xdb" />
                    </device>
                </Item>
            </impactsOff>
        </Item>
        <Item type="gameMechanics.elements.effects.EffectHandleEnterMission">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                    <quest href="Ferris_4_6_1.xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.DeathTrigger">
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFailQuest">
                    <quest href="Ferris_4_6_1.xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="Ferris_4_6_1.xdb" />
            <counterId href="/Creatures/ArchitectBot/Instances/Ferris4/Ferris4_ArchitectBot_inst.(MobWorld).xdb" />
            <condition type="constructor.elements.LongEquals">
                <value>4</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                    <buff href="Ferris_4_6_1_ColossusScout_Pull_02.(BuffResource).xdb" />
                </Item>
            </impacts>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>