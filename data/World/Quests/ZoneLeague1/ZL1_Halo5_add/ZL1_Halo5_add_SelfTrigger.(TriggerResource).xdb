<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.quest.trigger.TriggerResource>
    <Header>
        <resourceId>318555</resourceId>
    </Header>
    <effects>
        <Item type="gameMechanics.elements.effects.QuestCounterTrigger">
            <quest href="ZL1_Halo5_add.(QuestResource).xdb" />
            <counterId href="/Items/BoxSpecialLoot/Halo/HolySymbol.xdb" />
            <condition type="constructor.elements.LongEquals">
                <value>100</value>
            </condition>
            <impacts>
                <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                    <quest href="ZL1_Halo5_add.(QuestResource).xdb" />
                    <counterResource href="/ItemMall/Rares/Chests/HaloBox.xdb" />
                </Item>
            </impacts>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCastTrigger">
            <conditionalImpacts>
                <Item>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactFreezeQuestCounter">
                            <quest href="ZL1_Halo5_add.(QuestResource).xdb" />
                            <counterResource href="/Items/BoxSpecialLoot/Halo/HolySymbol.xdb" />
                        </Item>
                        <Item type="gameMechanics.elements.impacts.PostponedImpacts">
                            <impacts>
                                <Item type="gameMechanics.elements.impacts.ImpactIncreaseQuestCount">
                                    <id href="CountId_1.(QuestCountId).xdb" />
                                </Item>
                            </impacts>
                        </Item>
                    </impacts>
                    <conditions>
                        <Item type="gameMechanics.elements.predicates.PredicateSpellEquals">
                            <spells>
                                <Item href="/Items/BoxSpecialLoot/Halo/HolySymbolCast.(SpellCasterSelf).xdb" />
                            </spells>
                        </Item>
                    </conditions>
                </Item>
            </conditionalImpacts>
            <stages>
                <Item>Launch</Item>
            </stages>
        </Item>
    </effects>
</gameMechanics.constructor.schemes.quest.trigger.TriggerResource>