<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.CreatureVisActionPlayOnUsedDevice">
				<action type="client.Replica.DeviceVisEffectsAction">
					<visualEffects>
						<Item>
							<delay>0</delay>
							<effectFx href="Events/LotteryEvent_WinnerSparks.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
							<fadeInTime>0</fadeInTime>
							<fadeOutTime>0</fadeOutTime>
							<locatorName>Slot_Global</locatorName>
							<scale>1</scale>
							<fixPoint>false</fixPoint>
							<lockScale>false</lockScale>
						</Item>
					</visualEffects>
				</action>
				<isBackgroundAlways>false</isBackgroundAlways>
				<stopIfUsedObjectChanged>false</stopIfUsedObjectChanged>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>