<?xml version="1.0" encoding="UTF-8" ?>
<SpellVisScripts>
    <actionBarStart type="CreatureAnimationAction">
        <animations>
            <Item>readySpell</Item>
        </animations>
    </actionBarStart>
    <launch type="VisActionList">
        <play>Simultaneously</play>
        <elements>
            <Item type="CreatureProjectileAction">
                <projectileFx href="/Spells/FX/Spells/NecromancerAcidBoltAbilityBig.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <explosionFx href="/Spells/FX/Spells/ThrowBottlePoison_Hit_Small.(VisObjectTemplate).xdb#xpointer(/VisObjectTemplate)" />
                <theGe>6</theGe>
                <pointOnCaster type="VisPointLocator">
                    <locator>Slot_Mouth</locator>
                </pointOnCaster>
                <pointOnTarget type="VisPointLocator">
                    <locator>Slot_Global</locator>
                </pointOnTarget>
            </Item>
            <Item type="CreatureAnimationAction">
                <animations>
                    <Item>specialCast</Item>
                </animations>
            </Item>
        </elements>
    </launch>
</SpellVisScripts>