<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
	<Header>
		<resourceId>739980636</resourceId>
		<isPrototype>true</isPrototype>
	</Header>
	<groups>
		<Item href="/Mechanics/Spells/Groups/VoiceSpells.xdb" />
		<Item href="/Mechanics/Spells/Groups/PlayerClassSpells.(ActionGroup).xdb" />
		<Item href="/Mechanics/Spells/Groups/BardMelody.(ActionGroup).xdb" />
	</groups>
	<Name href="ConsumeMagicAoE.(SpellSingleTarget).Name.txt" />
	<Description href="ConsumeMagicAoE.(SpellSingleTarget).Description.txt" />
	<image href="/Interface/Icons/Spells/Bard/ExtraEnergyOnDispel.(UISingleTexture).xdb" />
	<visualScripts href="/Spells/VisScripts/Bard/Lure.(SpellVisScripts).xdb" />
	<range type="gameMechanics.elements.calcers.FloatData">
		<value>40</value>
	</range>
	<prepareDuration var="prepareDuration" />
	<ranks>
		<Item href="ConsumeMagicAoE01.(SpellSingleTarget).xdb" />
		<Item href="ConsumeMagicAoE02.(SpellSingleTarget).xdb" />
		<Item href="ConsumeMagicAoE03.(SpellSingleTarget).xdb" />
	</ranks>
	<iffPolicy>Enemies</iffPolicy>
	<launchWhenReady>true</launchWhenReady>
	<mechanics>
		<cooldown>
			<duration var="duration" />
		</cooldown>
		<casterConditions>
			<Item type="gameMechanics.elements.resources.ResourceBuff">
				<buff href="/Mechanics/Spells/CommonBuffs/Aspects/Support/Buff01.(BuffResource).xdb" />
			</Item>
		</casterConditions>
		<casterImpacts>
			<Item type="gameMechanics.elements.impacts.PostponedImpacts">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactModifySpellCooldown">
						<spell href="ConsumeMagicAoE01.(SpellSingleTarget).xdb" />
						<factor type="gameMechanics.elements.scalers.LinearMultiplierScaler">
							<mul>-0.001</mul>
							<mulCalcer type="gameMechanics.elements.calcers.CalcerStatValue">
								<stat type="gameMechanics.elements.stat.SpecialStat">
									<stat href="/Mechanics/SpecialStats/CritPower.(SpecialStatResource).xdb" />
								</stat>
								<valueType>ShortTerm</valueType>
							</mulCalcer>
							<sum>1</sum>
						</factor>
					</Item>
				</impacts>
			</Item>
		</casterImpacts>
		<targetImpacts>
			<Item type="gameMechanics.elements.impacts.DoubleAttackRepeater">
				<impacts>
					<Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
						<radius>15</radius>
						<affectGroup>Enemies</affectGroup>
						<impacts>
							<Item type="gameMechanics.elements.impacts.DispelMagic">
								<magics href="/Mechanics/Spells/Groups/Magics.xdb" />
								<impactsOnDispel>
									<Item type="gameMechanics.elements.impacts.ReturningImpact">
										<impacts>
											<Item type="gameMechanics.elements.impacts.MarkedImpact">
												<mark href="/Mechanics/Spells/Bard63/Spells/ConsumeMagic/ConsumeMagicOnCaster.(MarkResource).xdb" />
											</Item>
										</impacts>
									</Item>
									<Item type="gameMechanics.elements.impacts.MarkedImpact">
										<mark href="/Mechanics/Spells/Bard63/Spells/ConsumeMagic/ConsumeMagicOnTarget.(MarkResource).xdb" />
									</Item>
								</impactsOnDispel>
							</Item>
							<Item type="gameMechanics.elements.impacts.PostponedImpacts">
								<impacts>
									<Item type="gameMechanics.elements.impacts.MarkedImpact">
										<mark href="/Mechanics/Spells/Bard63/Spells/ConsumeMagic/ConsumeMagicOnTargetBeforeDispell.(MarkResource).xdb" />
									</Item>
								</impacts>
							</Item>
						</impacts>
					</Item>
				</impacts>
			</Item>
			<Item type="gameMechanics.elements.impacts.ImpactClientData">
				<data href="AoEDispellVisual.(ClientData).xdb" />
			</Item>
		</targetImpacts>
	</mechanics>
</gameMechanics.constructor.schemes.spell.singleTarget.SpellSingleTarget>
