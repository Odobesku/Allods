<?xml version="1.0" encoding="UTF-8" ?>
<gameMechanics.constructor.schemes.ability.AbilityResource>
    <Header>
        <resourceId>214707</resourceId>
        <isPrototype>true</isPrototype>
    </Header>
    <name href="Ability0.(AbilityResource).Name.txt" />
    <description href="Ability0.(AbilityResource).Description.txt" />
    <descVars>
        <Item>
            <name>cd</name>
            <value var="cd" />
        </Item>
    </descVars>
    <image href="/Interface/Icons/Spells/Druid/DruidTornado.(UISingleTexture).xdb" />
    <effects>
        <Item type="gameMechanics.elements.effects.SpellExtraImpacts">
            <targetImpacts>
                <Item type="gameMechanics.elements.impacts.ImpactIfCaster">
                    <predicates>
                        <Item type="gameMechanics.constructor.basicElements.PredicateNot">
                            <predicate type="gameMechanics.constructor.schemes.spell.spellstate.PredicateSpellActiveState">
                                <spell href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisable.(SpellSingleTarget).xdb" />
                            </predicate>
                        </Item>
                    </predicates>
                    <impacts>
                        <Item type="gameMechanics.elements.impacts.ImpactCreaturesAround">
                            <radius>15</radius>
                            <affectGroup>Enemies</affectGroup>
                            <affectHolder>false</affectHolder>
                            <impacts>
                                <Item type="gameMechanics.constructor.schemes.buff.BuffAttacher">
                                    <buff href="Pull.(BuffResource).xdb" />
                                </Item>
                            </impacts>
                            <filter type="gameMechanics.world.creature.AliveFilter" />
                        </Item>
                    </impacts>
                </Item>
            </targetImpacts>
            <destination type="gameMechanics.elements.effects.SpellExtraImpacts$DestinationSpells">
                <spells>
                    <Item href="/Mechanics/Spells/Druid70/Spells/Cyclon/Spell01.(SpellSingleTarget).xdb" />
                </spells>
            </destination>
        </Item>
        <Item type="gameMechanics.elements.effects.AbilityUnlockerEffect">
            <abilities>
                <Item href="/Mechanics/Spells/CommonSpells/AoEDisable/AoEDisableAbility.(AbilityResource).xdb" />
            </abilities>
        </Item>
        <Item type="gameMechanics.elements.effects.SpellCooldownMultiplier">
            <spell href="/Mechanics/Spells/Druid70/Spells/Cyclon/Spell01.(SpellSingleTarget).xdb" />
            <factor var="factor" />
        </Item>
    </effects>
    <ranks>
        <Item href="Ability01.(AbilityResource).xdb" />
        <Item href="Ability02.(AbilityResource).xdb" />
        <Item href="Ability03.(AbilityResource).xdb" />
    </ranks>
</gameMechanics.constructor.schemes.ability.AbilityResource>