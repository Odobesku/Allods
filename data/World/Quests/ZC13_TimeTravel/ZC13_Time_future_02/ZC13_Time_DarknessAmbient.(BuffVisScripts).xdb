<?xml version="1.0" encoding="UTF-8"?>
<BuffVisScripts>
	<action type="client.Replica.VisActionList">
		<elements>
			<Item type="client.Replica.PostEffectVisAction">
				<userPostEffect href="/Spells/FX/InterfaceFX/ZC13_Time.(UserPostEffect).xdb#xpointer(/UserPostEffect)" />
			</Item>
			<Item type="client.SLON.WeatherCreatureVisAction">
				<params>
					<ambientSoundImpact>Nothing</ambientSoundImpact>
					<fadeTime>3</fadeTime>
					<light>
						<AmbientColor>-14010812</AmbientColor>
						<AmbientFactor>0.5</AmbientFactor>
						<ContourColor>-8224126</ContourColor>
						<DiffuseColor>-9431020</DiffuseColor>
						<FadeEnd>800</FadeEnd>
						<FadeStart>500</FadeStart>
						<FogColor>-15920360</FogColor>
						<FogEnd>500</FogEnd>
						<FogStart>-10</FogStart>
						<GrassContourColorMultiplier>-1</GrassContourColorMultiplier>
						<PointLightColor>-10145510</PointLightColor>
						<SelfIllumColor>-12184320</SelfIllumColor>
						<SpecularColor>-8618884</SpecularColor>
						<SpecularWaterColor>-13624810</SpecularWaterColor>
						<SunLightPitch>45</SunLightPitch>
						<SunLightYaw>25</SunLightYaw>
						<TerrainContourColor>-13952230</TerrainContourColor>
						<TerrainContourPower>4</TerrainContourPower>
						<TerrainSpecularColor>-9274221</TerrainSpecularColor>
						<WaterGradientEnd>-12820328</WaterGradientEnd>
						<WaterGradientStart>-15847854</WaterGradientStart>
						<desaturation>0</desaturation>
						<minAmbientOcclusionValue>0</minAmbientOcclusionValue>
						<objectsLightmapBias>0.0125</objectsLightmapBias>
						<terrainLightmapBias>0.01</terrainLightmapBias>
					</light>
					<postEffectParams href="/Maps/ZC13_TimeTravel/ZoneLights/ZC13_TimeTravel_GibberlandDarknesPostEffect.(PostEffectParams).xdb#xpointer(/PostEffectParams)" />
					<posteffectFogSettings>
						<brightness>1</brightness>
						<color>-1</color>
						<colorUp>-1</colorUp>
						<densityDown>0</densityDown>
						<densityUp>0</densityUp>
						<distanceSettings>
							<falloff>0.5</falloff>
							<maxDistance>400</maxDistance>
							<minDistance>0</minDistance>
						</distanceSettings>
						<heightSettingsDown>
							<falloff>0.5</falloff>
							<maxHeight>50</maxHeight>
							<minHeight>-50</minHeight>
						</heightSettingsDown>
						<heightSettingsUp>
							<falloff>0.5</falloff>
							<maxHeight>50</maxHeight>
							<minHeight>-50</minHeight>
						</heightSettingsUp>
						<sunSettings>
							<brightness>0.2</brightness>
						</sunSettings>
						<use>false</use>
					</posteffectFogSettings>
					<priority>HIGH</priority>
					<skyMesh href="/World/Sky/ZC13_Evening.(SkyMesh).xdb#xpointer(/SkyMesh)" />
					<hasLight>false</hasLight>
					<playInBuildings>false</playInBuildings>
				</params>
			</Item>
			<Item type="client.Replica.Sound3DAction">
				<locator>FROM_LOCATOR_NAME</locator>
				<sound>
					<creationRadius>-1</creationRadius>
					<name>spells/World/UI05/Whisper</name>
					<project href="/SFX/Spells/Sounds.(FMODProject).xdb#xpointer(/FMODProject)" />
				</sound>
				<forcedSoundStop>false</forcedSoundStop>
				<onlyForMainAvatar>false</onlyForMainAvatar>
			</Item>
		</elements>
		<play>Simultaneously</play>
		<preconditional>false</preconditional>
		<restartOnVisualChange>false</restartOnVisualChange>
		<stopOnDeath>false</stopOnDeath>
		<stopWhileWhenElementsEnded>true</stopWhileWhenElementsEnded>
	</action>
	<restartOnIncStackCount>false</restartOnIncStackCount>
</BuffVisScripts>